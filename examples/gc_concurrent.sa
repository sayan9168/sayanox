// Concurrent GC: background pthread sweeps while mutator allocates
hold _ = gc_start()
hold s = "start"
hold i = 0
while i < 40 {
  hold s = concat(s, "x")
  hold i = i + 1
  when i % 10 == 0 {
    hold _ = gc_step()
  }
}
hold before = gc_info()
show before
hold s = "done"
hold _ = release(s)
hold _ = gc()
hold after = gc_info()
show after
show "concurrent-ok"
