// Sayanox beginner tour

show "Hello from Sayanox!"

make double(n) {
    give n * 2
}

hold x = 42
show double(x)

when x > 10 {
    show "Big number"
} otherwise {
    show "Small number"
}

hold i = 1
while i <= 5 {
    show i
    i = i + 1
}

hold nums = [10, 20, 30, 40]
show nums[0]
show nums[2]
push(nums, 50)
show list_len(nums)

make struct Point {
    x, y
}

hold p = Point { x: 5, y: 15 }
show p.x
show p.y

hold result = double(21)
show result
