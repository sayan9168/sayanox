// Sayanox v0.3 - Arrays, Structs, While, Functions
show "Hello from Sayanox v0.3!"

// Functions
make double(n) {
    give n * 2
}

hold x = 42
show double(x)

// Conditionals
when x > 10 {
    show "Big number"
} otherwise {
    show "Small number"
}

// While loop
hold i = 1
while i <= 5 {
    show i
    hold i = i + 1
}

// Arrays
hold nums = [10, 20, 30, 40]
show nums[0]
show nums[2]

// Structs
make struct Point {
    x, y
}

hold p = Point { x: 5, y: 15 }
show p.x
show p.y

hold result = double(21)
show result
