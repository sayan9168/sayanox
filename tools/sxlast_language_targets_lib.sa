make xl_name(index: num) -> str {
  when index == 0 { give "test-generics" }
  when index == 1 { give "test-native-num" }
  when index == 2 { give "test-generic-structs" }
  when index == 3 { give "test-stage2" }
  when index == 4 { give "test-for-str" }
  when index == 5 { give "test-full-language-expr" }
  give ""
}
make xl_count() -> num { give 6 }
make xl_known(name: str) -> num {
  hold i = 0
  while i < xl_count() {
    when string_eq(name, xl_name(i)) == 1 { give 1 }
    i = i + 1
  }
  give 0
}
