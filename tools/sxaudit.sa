// Sayanox-owned byte-count/line-count/SHA-256 auditor. The maintained native
// bootstrap anchor is bootstrap/sxc_native.bin; its explicit trust input is
// pinned separately from compiler sources and the generated native entry.
// Hashes/self-reproduction detect drift, not a malicious trusting-trust seed.
// This is not independent diverse reconstruction or a full-language proof.
// Usage: ./tools/sxaudit <file>; accepts binary files via read_bytes.

use "../stdlib/crypto.sa"

make audit_fail(code: num, msg: str) -> num {
  hold w = write_file("/dev/stderr", concat(concat("sxaudit: ", msg), "\n"))
  hold stop = exit(code)
  give 0
}

make count_nl(xs: list) -> num {
  hold n = len(xs)
  hold i = 0
  hold c = 0
  while i < n {
    when xs[i] == 10 {
      c = c + 1
    }
    i = i + 1
  }
  give c
}

make run() -> num {
  when arg_count() < 2 {
    hold usage = audit_fail(2, "usage: sxaudit <file>")
  }
  hold path = arg(1)
  hold xs = []
  hold n = read_bytes(path, xs)
  when n < 0 {
    hold noread = audit_fail(1, concat("cannot read ", path))
  }
  when n == 0 {
    hold empty = audit_fail(1, concat("refusing to audit an empty file: ", path))
  }
  hold lines = count_nl(xs)
  hold digest = cx_sha256_list(xs)
  show concat("file ", path)
  show concat("bytes ", numstr(n))
  show concat("lines ", numstr(lines))
  show concat("sha256 ", digest)
  give 0
}

hold rc = run()
