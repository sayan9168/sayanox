// Exact stdout contracts for the framed JSON-RPC probes.
make rt_lsp_probe(name: str) -> num {
  hold dir = gl_ensure_dir("selfhost/seed_tests")
  when string_eq(name, "test-lsp") == 1 {
    give gl_assert_out("./tools/sxlsp_probe probe ./tools/sayanox_lsp selfhost/seed_tests/lsp-probe", "initialize\nserverInfo\nrename capability\ndiag unknown-statement\ndiag unterminated-string\ndiag unbalanced-braces\ndiag unresolved-use\nsymbol function\nsymbol variable\ncompletion builtin\ncompletion literal preserved\nhover builtin\ndefinition\ndiagnostics cleared on change\nsecond document symbols\nclosed document answers empty\nclosed document not served from another buffer\nfifth document evicts the oldest\nnewest document still served\nreferences include the declaration\nreferences honour includeDeclaration:false\nreferences span the open documents\nreferences at a non-word answer empty\nworkspace symbol matches a query\nworkspace symbol with an empty query spans documents\nformatting answers one whole-buffer edit\nformatting indents a comment inside a block\nformatting indents a nested block by four spaces\nformatting strips trailing whitespace\nformatting leaves a formatted document alone\nrename edits the declaration\nrename carries the new name\nrename spans the open documents\nsignature help labels the declaration\nsignature help lists the parameters\nsignature help counts the argument\ncode action offers formatting\ncode action is empty when already formatted", "selfhost/seed_tests/lsp-probe.stdout")
  }
  when string_eq(name, "test-lsp-robust") == 1 {
    give gl_assert_out("./tools/sxlsp_probe robust ./tools/sayanox_lsp", "unknown request -32601\nserver keeps serving after error\nunknown notification ignored\ngarbage body -32700\nno method -32600\njunk header skipped\ntruncated frame ends cleanly\nstring id echoed on a result\nstring id with an escaped quote echoed on an error\nnegative id echoed\nnull id echoed", "selfhost/seed_tests/lsp-probe.stdout")
  }
  give fail(2, "unknown LSP probe")
}
