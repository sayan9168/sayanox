// Sayanox source formatter.
//
// Two modes:
//
//   sxfmt [INPUT [OUTPUT]]                 brace/whitespace formatter (legacy)
//   sxfmt --syntax|--check INPUT [OUTPUT]  token/structure-aware formatter
//
// The legacy mode is unchanged: it preserves tokens and comments, normalizes
// indentation from braces to two spaces, strips trailing whitespace and ensures
// a final newline; braces inside strings and // comments do not affect
// indentation.
//
// The syntax mode scans the whole file as tokens (tools/sxfmt_syntax_lib.sa):
// indentation follows every bracket kind, closers must match and the file must
// be balanced, strings and comments are copied byte for byte, horizontal
// whitespace is normalized, and malformed source is refused with a line
// diagnostic instead of being rewritten. `--check` writes nothing and exits 1
// when the file is not already canonical, so a caller can gate formatting.

use "tools/sxfmt_syntax_lib.sa"

make fmt_usage() -> num {
  hold w = write_file("/dev/stderr", "usage: sxfmt [--syntax|--check] INPUT [OUTPUT]\n")
  hold e = exit(2)
  give 0
}

make fmt_first_difference(left: str, right: str) -> num {
  hold n = len(left)
  when len(right) < n {
    n = len(right)
  }
  hold i = 0
  while i < n {
    when sx_index(left, i) != sx_index(right, i) {
      give i
    }
    i = i + 1
  }
  give n
}

make fmt_line_of(text: str, offset: num) -> num {
  hold line = 1
  hold i = 0
  while i < offset && i < len(text) {
    when sx_index(text, i) == 10 {
      line = line + 1
    }
    i = i + 1
  }
  give line
}

hold argn = arg_count()
hold mode = 0
hold check = 0
hold scan = 1
hold flags_done = 0
while scan < argn && flags_done == 0 {
  hold flag = arg(scan)
  when len(flag) > 0 && sx_index(flag, 0) == 45 {
    when string_eq(flag, "--syntax") == 1 {
      mode = 1
    } otherwise {
      when string_eq(flag, "--check") == 1 {
        mode = 1
        check = 1
      } otherwise {
        hold bad = fmt_usage()
      }
    }
    scan = scan + 1
  } otherwise {
    flags_done = 1
  }
}

hold input_path = "examples/hello.sa"
when argn > scan {
  input_path = arg(scan)
}
hold output_path = input_path
when argn > scan + 1 {
  output_path = arg(scan + 1)
}
when check == 1 && argn > scan + 1 {
  hold stray = fmt_usage()
}
when mode == 1 {
  hold source = read_file(input_path)
  hold result = sf_format(source)
  when sf_ok(result) == 0 {
    hold message = concat(concat("sxfmt: ", input_path), concat(": ", sf_error(result)))
    hold w = write_file("/dev/stderr", concat(message, "\n"))
    hold e = exit(2)
  }
  hold formatted = sf_text(result)
  when check == 1 {
    when string_eq(formatted, source) == 1 {
      hold ok = exit(0)
    }
    hold at_off = fmt_first_difference(source, formatted)
    hold at_line = fmt_line_of(source, at_off)
    hold message2 = concat(concat("sxfmt: ", input_path), concat(": not formatted, first difference on line ", concat(sf_istr(at_line), "\n")))
    hold w2 = write_file("/dev/stderr", message2)
    hold e2 = exit(1)
  }
  hold wrote = write_file(output_path, formatted)
  when wrote != 1 {
    hold message3 = concat(concat("sxfmt: cannot write ", output_path), "\n")
    hold w3 = write_file("/dev/stderr", message3)
    hold e3 = exit(2)
  }
  hold done = exit(0)
}

hold source = read_file(input_path)
hold source_len = len(source)
when source_len > 0 {
  when sx_idx(source, source_len - 1) != 10 {
    hold source = concat(source, "\n")
  }
}
hold source_len = len(source)
hold pos = 0
hold depth = 0
hold result = ""
hold line = ""

while pos < source_len {
  hold c = sx_index(source, pos)
  when c == 10 {
    hold line_len = len(line)

    // Find the first non-whitespace byte.
    hold left = 0
    hold trimming = 1
    while trimming == 1 {
      when left < line_len {
        hold t = sx_index(line, left)
        when t == 32 || t == 9 || t == 13 {
          hold left = left + 1
        } otherwise {
          hold trimming = 0
        }
      } otherwise {
        hold trimming = 0
      }
    }

    // Find the last non-whitespace byte.
    hold right = line_len
    hold trimming = 1
    while trimming == 1 {
      when right > left {
        hold t = sx_index(line, right - 1)
        when t == 32 || t == 9 || t == 13 {
          hold right = right - 1
        } otherwise {
          hold trimming = 0
        }
      } otherwise {
        hold trimming = 0
      }
    }

    hold text = ""
    hold copy_pos = left
    while copy_pos < right {
      hold text = concat(text, chr(sx_index(line, copy_pos)))
      hold copy_pos = copy_pos + 1
    }
    hold text_len = len(text)

    // A line that starts with one or more closing braces is indented at the
    // depth those braces return to. Spaces between leading braces are allowed.
    hold close_prefix = 0
    hold lead_pos = 0
    hold lead_scan = 1
    while lead_scan == 1 {
      when lead_pos < text_len {
        hold t = sx_index(text, lead_pos)
        when t == 125 {
          hold close_prefix = close_prefix + 1
          hold lead_pos = lead_pos + 1
        } otherwise {
          when t == 32 || t == 9 {
            hold lead_pos = lead_pos + 1
          } otherwise {
            hold lead_scan = 0
          }
        }
      } otherwise {
        hold lead_scan = 0
      }
    }

    // Count braces while ignoring quoted strings and // comments.
    hold open_count = 0
    hold close_count = 0
    hold in_quote = 0
    hold escaped = 0
    hold in_comment = 0
    hold scan_pos = 0
    while scan_pos < line_len {
      hold sc = sx_index(line, scan_pos)
      when in_comment == 1 {
        hold scan_pos = scan_pos + 1
      } otherwise {
        when in_quote == 1 {
          when escaped == 1 {
            hold escaped = 0
          } otherwise {
            when sc == 92 {
              hold escaped = 1
            } otherwise {
              when sc == 34 {
                hold in_quote = 0
              }
            }
          }
        } otherwise {
          when sc == 34 {
            hold in_quote = 1
          } otherwise {
            when sc == 47 && scan_pos + 1 < line_len {
              when sx_idx(line, scan_pos + 1) == 47 {
                hold in_comment = 1
              }
            } otherwise {
              when sc == 123 {
                hold open_count = open_count + 1
              }
              when sc == 125 {
                hold close_count = close_count + 1
              }
            }
          }
        }
        hold scan_pos = scan_pos + 1
      }
    }

    // Blank lines stay blank. Nonblank lines receive two spaces per level.
    when text_len > 0 {
      hold line_depth = depth - close_prefix
      when line_depth < 0 {
        hold line_depth = 0
      }
      hold indent = ""
      hold indent_pos = 0
      while indent_pos < line_depth {
        hold indent = concat(indent, "  ")
        hold indent_pos = indent_pos + 1
      }
      hold result = concat(result, indent)
      hold result = concat(result, text)
    }
    hold result = concat(result, "\n")

    hold depth = depth + open_count - close_count
    when depth < 0 {
      hold depth = 0
    }
    hold line = ""
  } otherwise {
    hold line = concat(line, chr(c))
  }
  hold pos = pos + 1
}

hold written = write_file(output_path, result)
when written == 0 {
  show "sxfmt: failed to write output"
}
