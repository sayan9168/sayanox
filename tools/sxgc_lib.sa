// tools/sxgc_lib.sa -- shared Sayanox x86-64 mark & sweep collector
// (6 routines, 1,209 bytes). Used by tools/sxgc.sa, tools/sxemit.sa,
// and selfhost/native_aot.sa.

make gc_pushall(st: list) -> list {
  st = push_r(st, 3)
  st = push_r(st, 1)
  st = push_r(st, 2)
  st = push_r(st, 6)
  st = push_r(st, 7)
  st = push_r(st, 8)
  st = push_r(st, 9)
  st = push_r(st, 10)
  st = push_r(st, 11)
  st = push_r(st, 12)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  give st
}

make gc_popall(st: list) -> list {
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 12)
  st = pop_r(st, 11)
  st = pop_r(st, 10)
  st = pop_r(st, 9)
  st = pop_r(st, 8)
  st = pop_r(st, 7)
  st = pop_r(st, 6)
  st = pop_r(st, 2)
  st = pop_r(st, 1)
  st = pop_r(st, 3)
  give st
}

make emit_gc_all(st: list) -> list {
  hold neg1 = 0 - 1
  hold magic_hi = 1516993677
  hold magic_lo = 2651789867

  // ---- r_findblock (B_FINDBLOCK = 26) ----
  hold Lnext = L_new(st)
  hold Lchk = L_new(st)
  hold Lno = L_new(st)
  hold Lout = L_new(st)
  st = set_builtin(st, 26)
  st = gc_pushall(st)
  st = mv_r64m(st, 8, 12, neg1, 0, 40)
  st = J_mp(st, Lchk)
  st = L_bind(st, Lnext)
  st = mv_r64m(st, 8, 8, neg1, 0, 0)
  st = L_bind(st, Lchk)
  st = test_rr(st, 8, 8)
  st = J_cc(st, 4, Lno)
  st = lea_rm(st, 9, 8, neg1, 0, 32)
  st = bin_rr(st, 57, 7, 9)
  st = J_cc(st, 2, Lnext)
  st = mv_r64m(st, 10, 8, neg1, 0, 16)
  st = bin_rr(st, 57, 7, 10)
  st = J_cc(st, 3, Lnext)
  st = lea_rm(st, 0, 7, neg1, 0, 0 - 32)
  st = bin_rr(st, 57, 0, 9)
  st = J_cc(st, 2, Lnext)
  st = mv_r64m(st, 11, 0, neg1, 0, 0)
  st = mov_imm64(st, 9, 1)
  st = test_rr(st, 11, 9)
  st = J_cc(st, 5, Lnext)
  st = mov_imm64(st, 9, 14)
  st = test_rr(st, 11, 9)
  st = J_cc(st, 5, Lnext)
  st = mov_imm64_hl(st, 9, magic_hi, magic_lo)
  st = mv_r64m(st, 10, 0, neg1, 0, 8)
  st = bin_rr(st, 57, 10, 9)
  st = J_cc(st, 5, Lnext)
  st = mv_r64m(st, 9, 8, neg1, 0, 16)
  st = mv_rr(st, 10, 0)
  st = bin_rr(st, 1, 10, 11)
  st = bin_rr(st, 57, 10, 9)
  st = J_cc(st, 7, Lnext)
  st = J_mp(st, Lout)
  st = L_bind(st, Lno)
  st = xor_rr(st, 0, 0)
  st = L_bind(st, Lout)
  st = gc_popall(st)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_mark (B_MARK = 27) ----
  hold Lret = L_new(st)
  hold Lbody = L_new(st)
  hold Lcond = L_new(st)
  hold Lnotlist = L_new(st)
  st = set_builtin(st, 27)
  st = gc_pushall(st)
  st = callb(st, 26)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lret)
  st = mv_r64m(st, 11, 0, neg1, 0, 16)
  st = test_rr(st, 11, 11)
  st = J_cc(st, 5, Lret)
  st = mov_imm64(st, 11, 1)
  st = mv_m64(st, 0, neg1, 0, 16, 11)
  st = mv_r64m(st, 11, 0, neg1, 0, 24)
  st = bin_imm8(st, 7, 11, 1)
  st = J_cc(st, 5, Lnotlist)
  st = mv_r64m(st, 7, 0, neg1, 0, 40)
  st = test_rr(st, 7, 7)
  st = J_cc(st, 4, Lret)
  st = callb(st, 27)
  st = J_mp(st, Lret)
  st = L_bind(st, Lnotlist)
  st = bin_imm8(st, 7, 11, 2)
  st = J_cc(st, 5, Lret)
  st = mv_r64m(st, 9, 0, neg1, 0, 0)
  st = shr_imm(st, 9, 3)
  st = bin_imm8(st, 5, 9, 4)
  st = lea_rm(st, 13, 0, neg1, 0, 32)
  st = J_mp(st, Lcond)
  st = L_bind(st, Lbody)
  st = mv_r64m(st, 7, 13, neg1, 0, 0)
  st = callb(st, 27)
  st = bin_imm8(st, 0, 13, 8)
  st = L_bind(st, Lcond)
  st = test_rr(st, 9, 9)
  st = J_cc(st, 4, Lret)
  st = incdec_r(st, 0, 9)
  st = J_mp(st, Lbody)
  st = L_bind(st, Lret)
  st = gc_popall(st)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_gc (B_GC = 23) ----
  hold Lrdone = L_new(st)
  hold Lrloop = L_new(st)
  hold Lrnext = L_new(st)
  hold Lsdone = L_new(st)
  hold Lsloop = L_new(st)
  hold Lsnext = L_new(st)
  hold Lchunk = L_new(st)
  hold Lcdone = L_new(st)
  hold Lblk = L_new(st)
  hold Lbdone = L_new(st)
  hold Lbnext = L_new(st)
  hold Ldead = L_new(st)
  hold Lfreerun = L_new(st)
  hold Lnewrun = L_new(st)
  hold Lp2chunk = L_new(st)
  hold Lp2done = L_new(st)
  hold Lp2loop = L_new(st)
  hold Lp2next = L_new(st)
  hold Lp2cdone = L_new(st)
  hold Lp2used = L_new(st)
  hold Lp2first = L_new(st)
  hold Lp2link = L_new(st)
  hold Lkeep = L_new(st)
  hold Lrchunk = L_new(st)
  hold Lrcdone = L_new(st)
  hold Lrcnext = L_new(st)
  hold Lrckeep = L_new(st)
  st = set_builtin(st, 23)
  st = gc_pushall(st)
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 96, 0)
  st = mv_m64(st, 12, neg1, 0, 64, 0)

  // 1. precise roots
  st = lea_rm(st, 13, 12, neg1, 0, 144)
  st = L_bind(st, Lrloop)
  st = mv_r64m(st, 7, 13, neg1, 0, 0)
  st = test_rr(st, 7, 7)
  st = J_cc(st, 4, Lrdone)
  st = bin_rr(st, 1, 7, 12)
  st = mv_r64m(st, 7, 7, neg1, 0, 0)
  st = callb(st, 27)
  st = bin_imm8(st, 0, 13, 8)
  st = J_mp(st, Lrloop)
  st = L_bind(st, Lrdone)

  // 2. conservative stack roots
  st = mv_r64m(st, 13, 12, neg1, 0, 104)
  st = mv_rr(st, 14, 4)
  st = L_bind(st, Lsloop)
  st = bin_rr(st, 57, 14, 13)
  st = J_cc(st, 3, Lsdone)
  st = mv_r64m(st, 7, 14, neg1, 0, 0)
  st = callb(st, 27)
  st = bin_imm8(st, 0, 14, 8)
  st = J_mp(st, Lsloop)
  st = L_bind(st, Lsdone)

  // 3a. sweep
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 0)
  st = mv_r64m(st, 15, 12, neg1, 0, 40)
  st = L_bind(st, Lchunk)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 4, Lcdone)
  st = lea_rm(st, 3, 15, neg1, 0, 32)
  st = mv_r64m(st, 6, 15, neg1, 0, 16)
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 0)
  st = J_mp(st, Lblk)
  st = L_bind(st, Lbnext)
  st = bin_rr(st, 1, 3, 10)
  st = L_bind(st, Lblk)
  st = bin_rr(st, 57, 3, 6)
  st = J_cc(st, 3, Lbdone)
  st = mv_r64m(st, 9, 3, neg1, 0, 0)
  st = mv_rr(st, 10, 9)
  st = bin_imm32(st, 4, 10, 0 - 2)
  st = mov_imm64_hl(st, 0, magic_hi, magic_lo)
  st = mv_r64m(st, 2, 3, neg1, 0, 8)
  st = bin_rr(st, 57, 2, 0)
  st = J_cc(st, 5, Lfreerun)
  st = mv_r64m(st, 0, 3, neg1, 0, 16)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Ldead)
  st = mv_r64m(st, 0, 12, neg1, 0, 64)
  st = bin_rr(st, 1, 0, 10)
  st = mv_m64(st, 12, neg1, 0, 64, 0)
  st = mov_imm64(st, 2, 0)
  st = mv_m64(st, 3, neg1, 0, 16, 2)
  st = mv_m64(st, 12, neg1, 0, 112, 2)
  st = J_mp(st, Lbnext)
  st = L_bind(st, Ldead)
  st = mv_r64m(st, 2, 12, neg1, 0, 96)
  st = bin_rr(st, 1, 2, 10)
  st = mv_m64(st, 12, neg1, 0, 96, 2)
  st = L_bind(st, Lfreerun)
  st = mv_r64m(st, 2, 12, neg1, 0, 112)
  st = test_rr(st, 2, 2)
  st = J_cc(st, 4, Lnewrun)
  st = mv_r64m(st, 0, 2, neg1, 0, 0)
  st = bin_rr(st, 1, 0, 10)
  st = mv_m64(st, 2, neg1, 0, 0, 0)
  st = J_mp(st, Lbnext)
  st = L_bind(st, Lnewrun)
  st = mv_rr(st, 0, 10)
  st = bin_imm8(st, 1, 0, 1)
  st = mv_m64(st, 3, neg1, 0, 0, 0)
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 3, neg1, 0, 8, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 3)
  st = J_mp(st, Lbnext)
  st = L_bind(st, Lbdone)
  st = mv_r64m(st, 15, 15, neg1, 0, 0)
  st = J_mp(st, Lchunk)
  st = L_bind(st, Lcdone)

  // 3a2. munmap empty chunks
  st = xor_rr(st, 8, 8)
  st = mv_r64m(st, 15, 12, neg1, 0, 40)
  st = L_bind(st, Lrchunk)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 4, Lrcdone)
  st = mv_r64m(st, 9, 15, neg1, 0, 0)
  st = mv_r64m(st, 10, 12, neg1, 0, 48)
  st = bin_rr(st, 57, 15, 10)
  st = J_cc(st, 4, Lrckeep)
  st = lea_rm(st, 0, 15, neg1, 0, 32)
  st = mv_r64m(st, 2, 0, neg1, 0, 0)
  st = mov_imm64(st, 1, 1)
  st = test_rr(st, 2, 1)
  st = J_cc(st, 4, Lrckeep)
  st = mv_rr(st, 6, 2)
  st = bin_imm32(st, 4, 6, 0 - 2)
  st = mv_rr(st, 1, 0)
  st = bin_rr(st, 1, 1, 6)
  st = mv_r64m(st, 3, 15, neg1, 0, 16)
  st = bin_rr(st, 57, 1, 3)
  st = J_cc(st, 5, Lrckeep)
  st = test_rr(st, 8, 8)
  hold jzh = here_local(st)
  st = jcc_rel32(st, 4, 0)
  st = mv_m64(st, 8, neg1, 0, 0, 9)
  hold jmpu = here_local(st)
  st = jmp_rel32(st, 0)
  st = erel32(st, jzh, here_local(st))
  st = mv_m64(st, 12, neg1, 0, 40, 9)
  st = erel32j(st, jmpu, here_local(st))
  st = mv_r64m(st, 6, 15, neg1, 0, 8)
  st = mv_rr(st, 7, 15)
  st = mov_imm64(st, 0, 11)
  st = syscall_inst(st)
  st = J_mp(st, Lrcnext)
  st = L_bind(st, Lrckeep)
  st = mv_rr(st, 8, 15)
  st = L_bind(st, Lrcnext)
  st = mv_rr(st, 15, 9)
  st = J_mp(st, Lrchunk)
  st = L_bind(st, Lrcdone)

  // 3b. rebuild free list
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 56, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 0)
  st = mv_r64m(st, 15, 12, neg1, 0, 40)
  st = L_bind(st, Lp2chunk)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 4, Lp2done)
  st = lea_rm(st, 3, 15, neg1, 0, 32)
  st = mv_r64m(st, 6, 15, neg1, 0, 16)
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 0)
  st = J_mp(st, Lp2loop)
  st = L_bind(st, Lp2next)
  st = bin_rr(st, 1, 3, 10)
  st = L_bind(st, Lp2loop)
  st = bin_rr(st, 57, 3, 6)
  st = J_cc(st, 3, Lp2cdone)
  st = mv_r64m(st, 9, 3, neg1, 0, 0)
  st = mv_rr(st, 10, 9)
  st = bin_imm32(st, 4, 10, 0 - 2)
  st = mov_imm64(st, 11, 1)
  st = test_rr(st, 9, 11)
  st = J_cc(st, 4, Lp2used)
  st = mv_r64m(st, 2, 12, neg1, 0, 112)
  st = test_rr(st, 2, 2)
  st = J_cc(st, 4, Lp2first)
  st = mv_m64(st, 2, neg1, 0, 16, 3)
  st = J_mp(st, Lp2link)
  st = L_bind(st, Lp2first)
  st = mv_m64(st, 12, neg1, 0, 56, 3)
  st = L_bind(st, Lp2link)
  st = mov_imm64(st, 2, 0)
  st = mv_m64(st, 3, neg1, 0, 16, 2)
  st = mv_m64(st, 12, neg1, 0, 112, 3)
  st = J_mp(st, Lp2next)
  st = L_bind(st, Lp2used)
  st = mov_imm64(st, 2, 0)
  st = mv_m64(st, 12, neg1, 0, 112, 2)
  st = J_mp(st, Lp2next)
  st = L_bind(st, Lp2cdone)
  st = mv_r64m(st, 15, 15, neg1, 0, 0)
  st = J_mp(st, Lp2chunk)
  st = L_bind(st, Lp2done)

  // 4. bookkeeping
  st = mv_r64m(st, 0, 12, neg1, 0, 88)
  st = incdec_r(st, 1, 0)
  st = mv_m64(st, 12, neg1, 0, 88, 0)
  st = mov_imm64(st, 0, 0)
  st = mv_m64(st, 12, neg1, 0, 72, 0)
  st = mv_r64m(st, 0, 12, neg1, 0, 64)
  st = shl_imm(st, 0, 1)
  st = mov_imm64(st, 2, 65536)
  st = bin_rr(st, 57, 0, 2)
  st = J_cc(st, 15, Lkeep)
  st = mv_rr(st, 0, 2)
  st = L_bind(st, Lkeep)
  st = mv_m64(st, 12, neg1, 0, 80, 0)
  st = mv_r64m(st, 0, 12, neg1, 0, 96)
  st = gc_popall(st)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_gccheck (B_GCCHECK = 28) ----
  st = set_builtin(st, 28)
  st = push_r(st, 0)
  st = push_r(st, 7)
  st = mv_r64m(st, 0, 12, neg1, 0, 72)
  st = mv_r64m(st, 7, 12, neg1, 0, 80)
  st = bin_rr(st, 57, 7, 0)
  hold jg = here_local(st)
  st = jcc_rel32(st, 15, 0)
  st = callb(st, 23)
  st = erel32(st, jg, here_local(st))
  st = pop_r(st, 7)
  st = pop_r(st, 0)
  st = ret_inst(st)

  // ---- r_gc_live (B_GC_LIVE = 24), r_gc_runs (B_GC_RUNS = 25) ----
  st = set_builtin(st, 24)
  st = mv_r64m(st, 0, 12, neg1, 0, 64)
  st = ret_inst(st)
  st = set_builtin(st, 25)
  st = mv_r64m(st, 0, 12, neg1, 0, 88)
  st = ret_inst(st)
  give st
}
