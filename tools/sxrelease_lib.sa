// Release orchestration belongs to Sayanox. git archive and gh are leaf host
// boundaries; tags, acceptance, integrity checks, evidence and argv are owned
// here. Never publish until the complete original CI chain succeeds.
make rl_tag() -> str {
  hold tag = getenv("RELEASE_TAG")
  when len(tag) < 2 || sx_index(tag, 0) != 118 { hold e = fail(2, "RELEASE_TAG must start with v and contain a version") }
  hold i = 1
  while i < len(tag) {
    hold c = sx_index(tag, i)
    hold ok = c >= 48 && c <= 57
    when c >= 65 && c <= 90 { ok = 1 }
    when c >= 97 && c <= 122 { ok = 1 }
    when c == 45 || c == 46 || c == 95 { ok = 1 }
    when ok == 0 { hold e = fail(2, "unsafe character in RELEASE_TAG") }
    i = i + 1
  }
  give tag
}
make rl_digest(path: str) -> str {
  hold command = concat("./tools/sxaudit ", sh_quote(path))
  hold log = "selfhost/seed_tests/release-audit.out"
  hold capture = pg_capture(command, log)
  hold text = read_file(log)
  hold at = pg_find(text, "\nsha256 ")
  when at < 0 { hold e = fail(1, "missing Sayanox SHA-256 audit record") }
  hold digest = gl_slice(text, at + 8, at + 72)
  when len(digest) != 64 { hold e = fail(1, "short Sayanox SHA-256 audit record") }
  hold i = 0
  while i < len(digest) {
    hold c = sx_index(digest, i)
    when (c < 48 || c > 57) && (c < 97 || c > 102) { hold e = fail(1, "invalid Sayanox SHA-256 audit record") }
    i = i + 1
  }
  give digest
}
make cmd_release_plan() -> num {
  hold tag = rl_tag()
  show concat("Release tag: ", tag)
  show "Required: complete migration -> doctor -> workflow shape -> true-selfhost -> gen3 -> native-test"
  show "Required: clean tracked tree, native entry/source pins, equal gen3/gen4 C, no forbidden bootstrap invocation"
  show "Required: checkout HEAD, GITHUB_SHA and any existing tag all name the same tested commit"
  show concat("Source archive: dist/sayanox-", concat(tag, "-src.tar.gz"))
  show "Archive input: the resolved tested commit id, never the symbolic HEAD"
  show "Evidence: dist/fixed-point.sha256, dist/gen3.c, dist/gen4.c, dist/BUILD_INFO.md"
  show "Plan only: no archive, tag or release was created"
  give 0
}

// Resolve the tested commit and enforce the publication identity contract.
// Returns the tested commit id, or fails: an unresolvable HEAD, a checkout that
// differs from the dispatched commit, a tag that already names another commit,
// or an unreadable remote all stop a release before anything is packaged.
// `remote_log` receives the authoritative `git ls-remote` listing so callers
// can report the tag without a second network query.
make rl_identity_gate(tag: str, remote_log: str) -> str {
  hold work = ensure_dir_p("selfhost/seed_tests")
  when work != 1 { hold e = fail(1, "cannot create release identity workspace") }
  hold tested = rl_commit_at("HEAD", "selfhost/seed_tests/release-identity.head")
  hold head_problem = rl_identity_problem(tested, "", "")
  when len(head_problem) > 0 { hold e = fail(1, concat("release identity: ", head_problem)) }
  hold query = rl_remote_tag_query(tag, remote_log)
  when query != 0 { hold e = fail(1, concat("cannot read remote tag state for ", tag)) }
  hold existing = rl_remote_tag_commit(tag, read_file(remote_log))
  hold identity = rl_identity_problem(tested, getenv("GITHUB_SHA"), existing)
  when len(identity) > 0 { hold e = fail(1, concat("release identity: ", identity)) }
  give tested
}

make cmd_release() -> num {
  hold tag = rl_tag()
  // Never turn an unported hard gate into a smaller successful release gate.
  hold acceptance = cmd_ci()
  hold rebuilt_entry = cmd_verify_entry()
  when len(getenv("GITHUB_PATH")) > 0 { hold guards = cmd_ci_guard_check() }
  hold clean = target_run("git diff --quiet HEAD --", "release tracked sources must match HEAD")
  when files_byte_equal("selfhost/gen3.c", "selfhost/gen4.c") != 1 { hold e = fail(1, "release fixed-point evidence differs") }
  hold required = bt_require_file("selfhost/gen3.c")
  hold cfiles = "selfhost/seed_tests/release-cfiles.out"
  hold tracked = pg_capture("git ls-files '*.c' '*.h'", cfiles)
  when len(read_file(cfiles)) != 0 { hold e = fail(1, "tracked C/header source in all-Sayanox release") }
  hold dir = ensure_dir_p("dist")
  when dir != 1 { hold e = fail(1, "cannot create release output directory") }
  // Identity before packaging: the tag, the checkout and the dispatched commit
  // must all name the commit acceptance just passed.
  hold remote_log = "selfhost/seed_tests/release-identity.remote"
  hold tested = rl_identity_gate(tag, remote_log)
  hold existing = rl_remote_tag_commit(tag, read_file(remote_log))
  hold tag_exists = 0
  when len(existing) > 0 { tag_exists = 1 }
  show concat("Tested commit: ", tested)
  when tag_exists == 1 { show concat("Existing tag commit: ", existing) } otherwise { show "Existing tag commit: none; the tag will be created at the tested commit" }
  hold auditor = target_native_tool("sxaudit")
  hold gen2 = rl_digest("selfhost/gen2.c")
  hold gen3 = rl_digest("selfhost/gen3.c")
  hold gen4 = rl_digest("selfhost/gen4.c")
  hold sums = concat(gen2, "  selfhost/gen2.c\n")
  sums = concat(sums, concat(gen3, "  selfhost/gen3.c\n"))
  sums = concat(sums, concat(gen4, "  selfhost/gen4.c\n"))
  hold sumfile = gl_must_write("dist/fixed-point.sha256", sums)
  hold copy3 = pg_copy("selfhost/gen3.c", "dist/gen3.c")
  hold copy4 = pg_copy("selfhost/gen4.c", "dist/gen4.c")
  // The archive is cut from the tested commit id, not from the moving HEAD.
  hold pack = target_run(rl_archive_command(tag, tested), "release source archive")
  hold notes = rl_build_info(tag, tested, tag_exists, sums)
  hold info = gl_must_write("dist/BUILD_INFO.md", notes)
  // No token is read, stored, printed or interpolated; gh inherits its own
  // authentication environment from the workflow's existing GitHub grant.
  hold tag_event = 0
  when string_eq(getenv("GITHUB_EVENT_NAME"), "push") == 1 { tag_event = 1 }
  hold publish = target_run(rl_publish_command(tag, tested, tag_exists, tag_event), "publish gated GitHub release")
  // A release that published a different commit than the one accepted is a
  // failure, not a warning: a moved tag is detected by re-reading the remote.
  hold requery = rl_remote_tag_query(tag, remote_log)
  when requery != 0 { hold e = fail(1, concat("cannot re-read the published tag ", tag)) }
  hold observed = rl_remote_tag_commit(tag, read_file(remote_log))
  hold moved = rl_published_problem(tag, tested, observed)
  when len(moved) > 0 { hold e = fail(1, concat("release identity: ", moved)) }
  show concat("[OK] released ", concat(tag, concat(" at tested commit ", tested)))
  give 0
}

// Check-only identity audit: runs the same resolution and decisions as the
// publishing path without packaging, tagging or calling gh. `./sx release`
// calls it in-line; this entry point exists so the identity contract can be
// executed against a controlled git/gh environment.
make cmd_release_identity() -> num {
  hold tag = rl_tag()
  hold remote_log = "selfhost/seed_tests/release-identity.remote"
  hold tested = rl_identity_gate(tag, remote_log)
  hold existing = rl_remote_tag_commit(tag, read_file(remote_log))
  hold tag_exists = 0
  when len(existing) > 0 { tag_exists = 1 }
  hold event = 0
  when string_eq(getenv("GITHUB_EVENT_NAME"), "push") == 1 { event = 1 }
  show concat("Release tag: ", tag)
  show concat("Tested commit: ", tested)
  when len(getenv("GITHUB_SHA")) > 0 { show concat("Dispatched commit: ", getenv("GITHUB_SHA")) }
  when tag_exists == 1 { show concat("Existing tag commit: ", existing) } otherwise { show "Existing tag commit: none; the tag would be created at the tested commit" }
  show concat("Archive command: ", rl_archive_command(tag, tested))
  show concat("Publish command: ", rl_publish_command(tag, tested, tag_exists, event))
  show "[OK] release identity: checkout, dispatch and tag agree on the tested commit"
  give 0
}
