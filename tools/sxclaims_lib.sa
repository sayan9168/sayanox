// A full claim is earned by the independently pinned published-language v1
// inventory, executable closure, paired invalid cases, and negative controls.
make cmd_full_contract(built: list) -> num {
  when len(getenv("INTERPOLATION_COMPILERS")) > 0 || len(getenv("STRUCT_FUNCTION_COMPILERS")) > 0 || len(getenv("GENERIC_LITERAL_COMPILERS")) > 0 || len(getenv("SXSUITE_COMPILERS")) > 0 {
    give target_run("INTERPOLATION_COMPILERS= STRUCT_FUNCTION_COMPILERS= GENERIC_LITERAL_COMPILERS= SXSUITE_COMPILERS= SXSUITE_REQUIRE_GEN3=1 ./sx target true-selfhost-full", "full profile with compiler selectors cleared")
  }
  hold tool = target_native_tool("sxfull")
  hold verified = target_run("./tools/sxfull verify", "reviewed published-language contract and integrity")
  hold minimum = ag_minimum(built)
  hold fixed = ag_gen3(built)
  hold gates = ag_targets(read_file("selfhost/seed_tests/full-contract-targets"), built)
  hold suite = target_native_tool("sxsuite")
  hold ready = target_run("SXSUITE_REQUIRE_GEN3=1 ./tools/sxsuite full_lang_ready", "all v1 closure/context programs")
  hold evidence = target_run("./tools/sxfull check-evidence selfhost/seed_tests/sxsuite/full_lang_ready/evidence.tsv", "complete gen2/gen3 O0/O2 execution ledger")
  hold signatures = target_run("./tools/sxfull builtin-matrix selfhost/seed_tests/full-contract-builtins", "every public builtin: valid counterpart, every incompatible argument kind and arity")
  hold runtime = target_run("./tools/sxfull runtime-boundaries selfhost/seed_tests/full-contract-runtime", "checked numeric and failed HTTP boundaries")
  hold controls = target_run("./tools/sxfull negative-controls selfhost/seed_tests/full-contract-controls selfhost/seed_tests/sxsuite/full_lang_ready/evidence.tsv", "independent omission and corruption controls")
  hold final_pins = target_run("./tools/sxfull verify", "recheck reviewed sources and oracles after execution")
  show "=== TRUE-SELFHOST-FULL-V1-OK ==="
  give 0
}

make cmd_all_sayanox() -> num {
  show "=== ALL-SAYANOX: maintained source + explicit native binary trust input ==="
  hold dir = gl_ensure_dir("selfhost/seed_tests")
  hold inventory = "selfhost/seed_tests/all-sayanox-tracked.out"
  hold tracked = pg_capture("git ls-files '*.c' '*.h' '*.sh' '*.sa'", inventory)
  hold names = read_file(inventory)
  hold counts = [0, 0, 0]
  hold pos = 0
  while pos < len(names) {
    hold start = pos
    while pos < len(names) && sx_index(names, pos) != 10 { pos = pos + 1 }
    hold path = gl_slice(names, start, pos)
    pos = pos + 1
    when path_kind(path) != 0 {
      when ends_with(path, ".c") == 1 || ends_with(path, ".h") == 1 { counts[0] = counts[0] + 1 }
      when ends_with(path, ".sh") == 1 { counts[1] = counts[1] + 1 }
      when ends_with(path, ".sa") == 1 { counts[2] = counts[2] + 1 }
    }
  }
  show concat("  maintained tracked C/H files: ", istr(counts[0]))
  show concat("  tracked shell scripts: ", istr(counts[1]))
  show concat("  tracked Sayanox sources: ", istr(counts[2]))
  show concat("  build-driver entry-source lines (tools/sxbuild.sa): ", istr(count_lines_in_file("tools/sxbuild.sa")))
  when counts[0] != 0 || counts[1] != 0 || path_kind("Makefile") != 0 || path_kind("selfhost/seed/sxc_seed_min.c") != 0 {
    give fail(1, "maintained C/header, shell script or Makefile remains; refusing an all-in-Sayanox claim")
  }
  hold inputs = bt_verify_seed()
  hold native = bt_native_bootstrap()
  hold entry = cmd_verify_entry()
  show "[OK] all maintained implementation source is Sayanox"
  show "  explicit trusted binary: bootstrap/sxc_native.bin; hashes and self-reproduction are not an independent trust proof"
  show "  generated C compatibility output/tests and necessary external host tools remain supported"
  show "  this inventory/bootstrap audit is not a full-language conformance claim or a replacement for CI"
  give 0
}
