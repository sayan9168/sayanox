hold vstruct = verify_six_way(dir, "struct_num", "selfhost/native32_tests/struct_num.sa", "selfhost/native32_tests/golden/struct_num.arm64.elf", "selfhost/native32_tests/golden/struct_num.riscv64.elf")
hold vstruct_oracle = assert_files_eq("selfhost/native32_tests/struct_num.want", concat(dir, "/struct_num.seed.out"), "numeric struct independent oracle")
hold vstruct_string = verify_six_way(dir, "struct_string", "selfhost/native32_tests/struct_string.sa", "selfhost/native32_tests/golden/struct_string.arm64.elf", "selfhost/native32_tests/golden/struct_string.riscv64.elf")
hold vstruct_string_oracle = assert_files_eq("selfhost/native32_tests/struct_string.want", concat(dir, "/struct_string.seed.out"), "string struct independent oracle")
hold vrec = verify_six_way(dir, "recursion", "selfhost/native32_tests/recursion.sa", "selfhost/native32_tests/golden/recursion.arm64.elf", "selfhost/native32_tests/golden/recursion.riscv64.elf")
hold vstrfn = verify_six_way(dir, "strfn", "selfhost/native32_tests/strfn.sa", "selfhost/native32_tests/golden/strfn.arm64.elf", "selfhost/native32_tests/golden/strfn.riscv64.elf")
hold vstrrec = verify_six_way(dir, "strrec", "selfhost/native32_tests/strrec.sa", "selfhost/native32_tests/golden/strrec.arm64.elf", "selfhost/native32_tests/golden/strrec.riscv64.elf")
hold vstrarity = verify_six_way(dir, "strarity", "selfhost/native32_tests/strarity.sa", "selfhost/native32_tests/golden/strarity.arm64.elf", "selfhost/native32_tests/golden/strarity.riscv64.elf")
hold vcap = test_fn_depth_cap(dir)
hold vstruct_depth = test_list_index_fault(dir, "struct_mutation_depth_cap")
hold vstruct_string_depth = test_list_index_fault(dir, "struct_string_depth_cap")
hold vstruct_string_oob_high = test_list_index_fault(dir, "struct_string_index_oob_high")
hold vstruct_string_oob_low = test_list_index_fault(dir, "struct_string_index_oob_low")
hold vh = test_concat_heap_limit(dir)
hold vix = test_string_index_bounds(dir)
hold vixhi = test_list_index_fault(dir, "list_index_oob_high")
hold vixlo = test_list_index_fault(dir, "list_index_oob_low")
hold vsethi = test_list_index_fault(dir, "list_set_oob_high")
hold vsetlo = test_list_index_fault(dir, "list_set_oob_low")
hold vgrow_cap = test_list_index_fault(dir, "list_grow_capacity")
hold vgrow_oob = test_list_index_fault(dir, "list_grow_oob")
hold vgrow_oob_low = test_list_index_fault(dir, "list_grow_oob_low")
hold vgrow_set_oob = test_list_index_fault(dir, "list_grow_set_oob")

hold deep_sa = concat(dir, "/isa_deep.sa")
hold wd = write_deep_fixture(deep_sa)
hold v4 = verify_six_way(dir, "isa_deep", deep_sa, "", "")

// Generated from the case tables that were adjudicated against Linux-on-ARM
// emulation (see docs/gate-logs/2026-11-23-arm64-isa-coverage.md): every image
// is a run of single-instruction probes that leave their own pass/fail bit in
// w20 and exit with the number of mismatching checks, so 0 is the only good
// status. Each probe seeds the registers it reads, so no case can mask another.

