// tools/sxisaexec_test.sa -- Pure-Sayanox multi-ISA execution proof harness
// verifying 6-way byte-for-byte execution parity across integer and static-string fixtures:
//   (1) seed_min + C, (2) gen2 + C, (3) native_aot (x86-64 ELF64),
//   (4) sxc_native / sxirexec (Portable IR VM) / i386 ELF32,
//   (5) AArch64 ELF64 (including reviewed tracked goldens) via sxisaexec, and
//   (6) RISC-V RV64IM ELF64 via sxisaexec,
// plus scalar IEEE-754 AArch64/RV64F/D arithmetic, Linux openat/read/write/
// close file syscalls, and negative fault/container/permission/step-budget checks.

make fail_t(msg: str) -> num {
  show concat("[FAIL] sxisaexec_test: ", msg)
  hold w = write_file("/dev/stderr", concat(concat("[FAIL] sxisaexec_test: ", msg), "\n"))
  hold s = exit(1)
  give 0
}

make istr(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold n = v
  when n < 0 {
    neg = 1
    n = 0 - n
  }
  hold out = ""
  while n > 0 {
    hold d = n % 10
    out = concat(chr(48 + d), out)
    n = (n - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make sh_q(s: str) -> str {
  hold sq = chr(39)
  hold bs = chr(92)
  hold out = sq
  hold n = len(s)
  hold i = 0
  while i < n {
    hold c = sx_index(s, i)
    when c == 39 {
      out = concat(out, concat(sq, concat(bs, concat(sq, sq))))
    } otherwise {
      out = concat(out, chr(c))
    }
    i = i + 1
  }
  give concat(out, sq)
}

make cc_bin() -> str {
  hold c = getenv("CC")
  when len(c) > 0 {
    give c
  }
  give "cc"
}

make assert_eq_num(got: num, want: num, label: str) -> num {
  when got != want {
    hold f = fail_t(concat(label, concat(": got ", concat(istr(got), concat(", want ", istr(want))))))
  }
  give 0
}

make assert_files_eq(a: str, b: str, label: str) -> num {
  hold ba = []
  hold bb = []
  hold na = read_bytes(a, ba)
  hold nb = read_bytes(b, bb)
  when na < 0 || nb < 0 {
    hold f0 = fail_t(concat(label, ": unreadable output file"))
  }
  when na != nb {
    hold f1 = fail_t(concat(label, concat(": byte length ", concat(istr(na), concat(" vs ", istr(nb))))))
  }
  hold i = 0
  while i < na {
    hold xa = ba[i]
    hold xb = bb[i]
    when xa != xb {
      hold f2 = fail_t(concat(label, concat(": mismatch at byte ", istr(i))))
    }
    i = i + 1
  }
  give 0
}

make write_deep_fixture(path: str) -> num {
  hold q = chr(34)
  hold nl = chr(10)
  hold bs = chr(92)
  hold lb = chr(123)
  hold rb = chr(125)
  hold s = ""
  s = concat(s, concat("// Multi-ISA arithmetic, relational, and nested loop/branch stress fixture", nl))
  s = concat(s, concat("hold a = (0 - 32767) * 65536 - 65535", nl))
  s = concat(s, concat("hold b = (0 - 15070) * 65536 - 29137", nl))
  s = concat(s, concat("show 0 - 999999", nl))
  s = concat(s, concat("show 999 * (0 - 999)", nl))
  s = concat(s, concat("show (0 - 17) % 5", nl))
  s = concat(s, concat("show 17 % 5", nl))
  s = concat(s, concat("show 997 * 991", nl))
  s = concat(s, concat("show (0 - 997) * 991", nl))
  s = concat(s, concat("show (a < b)", nl))
  s = concat(s, concat("show (a <= a)", nl))
  s = concat(s, concat("show (b > a)", nl))
  s = concat(s, concat("show (0 >= a)", nl))
  s = concat(s, concat("show (42 == 42)", nl))
  s = concat(s, concat("show (42 != 43)", nl))
  // Iterative GCD(1071, 462) == 21 and Collatz steps from 27 == 111
  s = concat(s, concat("hold x = 1071", nl))
  s = concat(s, concat("hold y = 462", nl))
  s = concat(s, concat("while y != 0 ", concat(lb, nl)))
  s = concat(s, concat("  hold t = x % y", nl))
  s = concat(s, concat("  x = y", nl))
  s = concat(s, concat("  y = t", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show x", nl))
  // Nested when/otherwise accumulator
  s = concat(s, concat("hold i = 0", nl))
  s = concat(s, concat("hold acc = 0", nl))
  s = concat(s, concat("while i < 25 ", concat(lb, nl)))
  s = concat(s, concat("  when i % 3 == 0 ", concat(lb, nl)))
  s = concat(s, concat("    acc = acc + i * 2", nl))
  s = concat(s, concat("  ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("    when i % 2 == 0 ", concat(lb, nl)))
  s = concat(s, concat("      acc = acc - i", nl))
  s = concat(s, concat("    ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("      acc = acc + 7", nl))
  s = concat(s, concat("    ", concat(rb, nl)))
  s = concat(s, concat("  ", concat(rb, nl)))
  s = concat(s, concat("  i = i + 1", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show acc", nl))
  s = concat(s, concat("show ", concat(q, concat("isa-ok", concat(bs, concat("tDONE", q))))))
  s = concat(s, nl)
  when write_file(path, s) != 1 {
    hold fw = fail_t("cannot write deep fixture")
  }
  give 0
}

// The legacy reference grammar rejects spaced calls and a literal len inside
// an index. Keep those native-only forms intact and execute them separately;
// compare with the canonical shared fixture AND its independent byte oracle.
make verify_native_literal_forms(dir: str) -> num {
  hold probe_sa = concat(dir, "/literal-probe.sa")
  hold probe_elf = concat(dir, "/literal-probe.elf")
  when write_file(probe_sa, "show 1\n") != 1 { hold f = fail_t("literal i386 probe write") }
  when run_command(concat("./tools/native32 ", concat(sh_q(probe_sa), concat(" ", concat(sh_q(probe_elf), " i386"))))) != 0 { hold f = fail_t("literal i386 probe compile") }
  hold i386_available = run_command(concat("chmod +x ", concat(sh_q(probe_elf), concat(" && ", concat(sh_q(probe_elf), " >/dev/null 2>&1")))))
  hold i = 0
  while i < 3 {
    hold arch = "i386"
    when i == 1 { arch = "arm64" }
    when i == 2 { arch = "riscv64" }
    hold elf = concat(dir, concat("/literal-forms-", concat(arch, ".elf")))
    hold out = concat(elf, ".out")
    when run_command(concat("./tools/native32 selfhost/native32_tests/len_literals.sa ", concat(sh_q(elf), concat(" ", arch)))) != 0 { hold f = fail_t(concat("literal native forms compile: ", arch)) }
    hold cmd = concat("./tools/sxisaexec --arch ", concat(arch, concat(" --out ", concat(sh_q(out), concat(" ", sh_q(elf))))))
    when i == 0 { cmd = concat("chmod +x ", concat(sh_q(elf), concat(" && ", concat(sh_q(elf), concat(" > ", sh_q(out)))))) }
    when i > 0 || i386_available == 0 {
      when run_command(cmd) != 0 { hold f = fail_t(concat("literal native forms execution: ", arch)) }
      hold equal = assert_files_eq("selfhost/native32_tests/len_literals.want", out, concat("literal native-only forms oracle: ", arch))
      equal = assert_files_eq(concat(dir, "/len_literals.seed.out"), out, concat("literal native-only vs canonical reference: ", arch))
    } otherwise { show "[SKIP] kernel cannot execute i386 native-only forms; image compiled and cross-ISA execution remains mandatory" }
    i = i + 1
  }
  show "[ok] literal native-only spacing/index forms match shared reference and independent oracle"
  give 0
}

// Numeric len expressions containing commas and escaped quotes are accepted
// by native32 and the full native compiler, but rejected by the seed grammar.
make verify_native_only_list(dir: str, name: str) -> num {
  hold source = concat("selfhost/native32_tests/", concat(name, ".sa"))
  hold want = concat("selfhost/native32_tests/", concat(name, ".want"))
  hold i = 0
  while i < 3 {
    hold arch = "i386"
    when i == 1 { arch = "arm64" }
    when i == 2 { arch = "riscv64" }
    hold elf = concat(dir, concat(concat("/", name), concat("-", concat(arch, ".elf"))))
    hold out = concat(elf, ".out")
    when run_command(concat("./tools/native32 ", concat(sh_q(source), concat(" ", concat(sh_q(elf), concat(" ", arch)))))) != 0 { hold f = fail_t(concat("list string expression compile: ", arch)) }
    hold cmd = concat("./tools/sxisaexec --arch ", concat(arch, concat(" --out ", concat(sh_q(out), concat(" ", sh_q(elf))))))
    when i == 0 { cmd = concat("chmod +x ", concat(sh_q(elf), concat(" && ", concat(sh_q(elf), concat(" > ", sh_q(out)))))) }
    // The earlier native literal probe establishes whether the host runs i386.
    hold can_i386 = run_command(concat(sh_q(concat(dir, "/literal-probe.elf")), " >/dev/null 2>&1"))
    when i > 0 || can_i386 == 0 {
      when run_command(cmd) != 0 { hold f = fail_t(concat("list string expression execution: ", arch)) }
      hold equal = assert_files_eq(want, out, concat("list string expression oracle: ", arch))
    } otherwise { show "[SKIP] kernel cannot execute i386 list string expressions" }
    i = i + 1
  }
  give 0
}

// Both C-output compilers accept these cases unlike native_aot.
make verify_two_reference(dir: str, name: str) -> num {
  hold source = concat("selfhost/native32_tests/", concat(name, ".sa"))
  hold want = concat("selfhost/native32_tests/", concat(name, ".want"))
  hold seedc = concat(dir, "/negative.seed.c")
  hold g2c = concat(dir, "/negative.gen2.c")
  hold exe = concat(dir, "/negative.ref")
  hold out = concat(dir, "/negative.ref.out")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(source), concat(" > ", sh_q(seedc))))) != 0 { hold f = fail_t("negative list seed compilation") }
  when run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", sh_q(seedc)))))) != 0 { hold f = fail_t("negative list seed C build") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("negative list seed execution") }
  hold a = assert_files_eq(want, out, "negative list seed oracle")
  when run_command(concat("./selfhost/gen2 ", concat(sh_q(source), concat(" ", sh_q(g2c))))) != 0 { hold f = fail_t("negative list gen2 compilation") }
  when run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", sh_q(g2c)))))) != 0 { hold f = fail_t("negative list gen2 C build") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("negative list gen2 execution") }
  give assert_files_eq(want, out, "negative list gen2 oracle")
}

// Seed-only reference for forms the other shared profiles do not all accept.
make verify_struct_extra_seed(dir: str, name: str) -> num {
  hold source = concat("selfhost/native32_tests/", concat(name, ".sa"))
  hold cfile = concat(dir, "/struct-extra.seed.c")
  hold exe = concat(dir, "/struct-extra.seed")
  hold out = concat(dir, "/struct-extra.seed.out")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(source), concat(" > ", sh_q(cfile))))) != 0 { hold f = fail_t("struct extra seed emit") }
  when run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", sh_q(cfile)))))) != 0 { hold f = fail_t("struct extra seed C build") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("struct extra seed execution") }
  give assert_files_eq(concat("selfhost/native32_tests/", concat(name, ".want")), out, "struct extra seed oracle")
}

// String-field indexing must match the independent byte oracle in all lanes.
make verify_struct_string_index_refs(dir: str) -> num {
  hold source = "selfhost/native32_tests/struct_string_index.sa"
  hold want = "selfhost/native32_tests/struct_string_index.want"
  hold out = concat(dir, "/struct-index.out")
  hold cfile = concat(dir, "/struct-index.c")
  hold exe = concat(dir, "/struct-index.exe")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(source), concat(" > ", sh_q(cfile))))) != 0 { hold f = fail_t("struct string index seed emit") }
  when run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", sh_q(cfile)))))) != 0 { hold f = fail_t("struct string index seed C") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("struct string index seed run") }
  hold seed = assert_files_eq(want, out, "seed field index oracle")
  when run_command(concat("./selfhost/gen2 ", concat(sh_q(source), concat(" ", sh_q(cfile))))) != 0 { hold f = fail_t("struct string index gen2 emit") }
  when run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", sh_q(cfile)))))) != 0 { hold f = fail_t("struct string index gen2 C") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("struct string index gen2 run") }
  hold gen2 = assert_files_eq(want, out, "gen2 field index oracle")
  when run_command(concat("./selfhost/native_aot ", concat(sh_q(source), concat(" ", sh_q(exe))))) != 0 { hold f = fail_t("struct string index native emit") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("struct string index native run") }
  hold native = assert_files_eq(want, out, "struct string index x86 oracle")
  when run_command(concat("./tools/sxirexec compile-and-run ", concat(sh_q(source), concat(" ", concat(sh_q(concat(dir, "/struct-index-ir")), concat(" > ", sh_q(out))))))) != 0 { hold f = fail_t("struct string index IR run") }
  give assert_files_eq(want, out, "struct string index IR oracle")
}

// Reject invalid struct expressions, including C-output lanes whose generated
// #error is reported by the C compiler rather than the emitter.
make verify_struct_expr_refusals(dir: str, folder: str, names: str, expected: num) -> num {
  hold p = 0
  hold count = 0
  while p < len(names) {
    hold name = ""
    while p < len(names) && sx_index(names, p) != 10 {
      name = concat(name, chr(sx_index(names, p)))
      p = p + 1
    }
    p = p + 1
    hold source = concat(folder, concat("/", concat(name, ".sa")))
    hold err = concat(dir, "/index-refusal.err")
    hold cfile = concat(dir, "/index-refusal.c")
    hold exe = concat(dir, "/index-refusal.elf")
    hold seed = run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(source), concat(" >", concat(sh_q(cfile), concat(" 2>", sh_q(err)))))))
    hold sr = assert_eq_num(seed, 1, concat(name, " seed refusal"))
    when len(read_file(err)) == 0 { hold f = fail_t("missing seed index diagnostic") }
    hold gen = run_command(concat("./selfhost/gen2 ", concat(sh_q(source), concat(" ", concat(sh_q(cfile), concat(" >", concat(sh_q(err), " 2>&1")))))))
    hold cstatus = run_command(concat(cc_bin(), concat(" -std=gnu11 -o ", concat(sh_q(exe), concat(" ", concat(sh_q(cfile), " >/dev/null 2>&1"))))))
    when cstatus == 0 { hold f = fail_t(concat(name, " gen2 accepted invalid index")) }
    hold i = 0
    while i < 2 {
      hold compiler = "./selfhost/native_aot "
      when i == 1 { compiler = "./tools/sxc_native " }
      hold status = run_command(concat(compiler, concat(sh_q(source), concat(" ", concat(sh_q(exe), concat(" >", concat(sh_q(err), " 2>&1")))))))
      hold refused = assert_eq_num(status, 1, concat(name, " native refusal"))
      when len(read_file(err)) == 0 { hold f = fail_t("missing native index diagnostic") }
      i = i + 1
    }
    count = count + 1
  }
  give assert_eq_num(count, expected, "struct expression refusal count")
}

// The full native compiler supports positive indexed assignment, unlike the
// bounded native_aot profile. Run it against the same independent oracle.
make verify_list_set_full_native(dir: str, name: str) -> num {
  hold source = concat("selfhost/native32_tests/", concat(name, ".sa"))
  hold want = concat("selfhost/native32_tests/", concat(name, ".want"))
  hold exe = concat(dir, concat("/", concat(name, ".full.elf")))
  hold out = concat(exe, ".out")
  when run_command(concat("./bootstrap/sxc_native.bin ", concat(sh_q(source), concat(" ", sh_q(exe))))) != 0 { hold f = fail_t("full native list write compilation") }
  when run_command(concat(sh_q(exe), concat(" > ", sh_q(out)))) != 0 { hold f = fail_t("full native list write execution") }
  give assert_files_eq(want, out, "full native list write oracle")
}

// Refusals for the new x86-64 numeric-field store, tested on both profiles.
make verify_struct_store_refusals(dir: str) -> num {
  hold names = "unknown_field\nnon_struct\nwrong_value_type\nmalformed_target\nnested_target\nparameter_target\n"
  hold p = 0
  hold count = 0
  while p < len(names) {
    hold name = ""
    while p < len(names) && sx_index(names, p) != 10 {
      name = concat(name, chr(sx_index(names, p)))
      p = p + 1
    }
    p = p + 1
    hold source = concat("selfhost/native32_tests/struct_mutation_refuse/", concat(name, ".sa"))
    hold i = 0
    while i < 2 {
      hold compiler = "./selfhost/native_aot "
      when i == 1 { compiler = "./tools/sxc_native " }
      hold err = concat(dir, "/struct-refusal.err")
      hold cmd = concat(compiler, concat(sh_q(source), concat(" ", concat(sh_q(concat(dir, "/struct-refusal.elf")), concat(" >", concat(sh_q(err), " 2>&1"))))))
      hold status = run_command(cmd)
      hold refused = assert_eq_num(status, 1, concat("struct store refusal: ", name))
      when len(read_file(err)) == 0 { hold f = fail_t(concat("struct store refusal lacks diagnostic: ", name)) }
      i = i + 1
    }
    count = count + 1
  }
  give assert_eq_num(count, 6, "struct store refusal count")
}

make verify_six_way(dir: str, name: str, sa_path: str, golden_arm64: str, golden_riscv64: str) -> num {
  hold cc = cc_bin()
  hold stem = concat(dir, concat("/", name))
  hold ref_out = concat(stem, ".seed.out")

  // 1. seed_min + cc
  hold seed_c = concat(stem, ".seed.c")
  hold seed_exe = concat(stem, ".seed")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(sa_path), concat(" > ", sh_q(seed_c))))) != 0 {
    hold fs1 = fail_t(concat(name, ": seed_min failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -o ", concat(sh_q(seed_exe), concat(" ", sh_q(seed_c)))))) != 0 {
    hold fs2 = fail_t(concat(name, ": seed cc failed"))
  }
  when run_command(concat(sh_q(seed_exe), concat(" > ", sh_q(ref_out)))) != 0 {
    hold fs3 = fail_t(concat(name, ": seed binary failed"))
  }

  // 2. gen2 + cc
  hold g2_c = concat(stem, ".gen2.c")
  hold g2_exe = concat(stem, ".gen2")
  hold g2_out = concat(stem, ".gen2.out")
  when run_command(concat("./selfhost/gen2 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(g2_c), " >/dev/null"))))) != 0 {
    hold fg1 = fail_t(concat(name, ": gen2 failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -Wno-implicit-function-declaration -o ", concat(sh_q(g2_exe), concat(" ", sh_q(g2_c)))))) != 0 {
    hold fg2 = fail_t(concat(name, ": gen2 cc failed"))
  }
  when run_command(concat(sh_q(g2_exe), concat(" > ", sh_q(g2_out)))) != 0 {
    hold fg3 = fail_t(concat(name, ": gen2 binary failed"))
  }
  hold cg = assert_files_eq(ref_out, g2_out, concat(name, " seed vs gen2"))

  // 3. native_aot (x86-64 ELF64) + SX_EMIT_LOG -> emit_to_ir -> sxirexec (Portable IR VM!)
  hold x64_exe = concat(stem, ".x86_64.elf")
  hold x64_out = concat(stem, ".x86_64.out")
  hold elog = concat(stem, ".emit.log")
  hold ir_f = concat(stem, ".ir")
  hold ir_out = concat(stem, ".ir.out")
  when run_command(concat("SX_EMIT_LOG=", concat(sh_q(elog), concat(" ./selfhost/native_aot ", concat(sh_q(sa_path), concat(" ", sh_q(x64_exe))))))) != 0 {
    hold fx1 = fail_t(concat(name, ": native_aot failed"))
  }
  when run_command(concat(sh_q(x64_exe), concat(" > ", sh_q(x64_out)))) != 0 {
    hold fx2 = fail_t(concat(name, ": x86_64 binary failed"))
  }
  hold cx = assert_files_eq(ref_out, x64_out, concat(name, " seed vs x86_64 native_aot"))

  // 4. Portable IR VM (sxirexec) + sxc_native + i386 (when host runs IA32)
  when arg_count() > 2 && string_eq(arg(2), "--require-i386") == 1 && (string_eq(name, "struct_mutation") == 1 || string_eq(name, "struct_mutation_scope") == 1 || string_eq(name, "struct_string") == 1) {
    when path_kind("./tools/sxirexec") != 1 || path_kind("./tools/sxc_native") != 1 {
      hold fm = fail_t("struct mutation gate requires IR VM and full native compiler")
    }
  }
  when path_kind("./tools/sxirexec") == 1 {
    hold ir_wd = concat(stem, "_ir_wd")
    when run_command(concat("./tools/sxirexec compile-and-run ", concat(sh_q(sa_path), concat(" ", concat(sh_q(ir_wd), concat(" > ", sh_q(ir_out))))))) != 0 {
      hold fi2 = fail_t(concat(name, ": sxirexec failed"))
    }
    hold cir = assert_files_eq(ref_out, ir_out, concat(name, " seed vs Portable IR VM"))
  }
  when path_kind("./tools/sxc_native") == 1 {
    hold fn_exe = concat(stem, ".sxc_native.elf")
    hold fn_out = concat(stem, ".sxc_native.out")
    when run_command(concat("./tools/sxc_native ", concat(sh_q(sa_path), concat(" ", sh_q(fn_exe))))) != 0 {
      hold fsn1 = fail_t(concat(name, ": sxc_native failed"))
    }
    when run_command(concat(sh_q(fn_exe), concat(" > ", sh_q(fn_out)))) != 0 {
      hold fsn2 = fail_t(concat(name, ": sxc_native binary failed"))
    }
    hold csn = assert_files_eq(ref_out, fn_out, concat(name, " seed vs sxc_native"))
  }
  hold i386_elf = concat(stem, ".i386.elf")
  hold i386_out = concat(stem, ".i386.out")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(i386_elf), " i386"))))) != 0 {
    hold f32 = fail_t(concat(name, ": native32 i386 failed"))
  }
  hold i386_status = run_command(concat("chmod +x ", concat(sh_q(i386_elf), concat(" && ", concat(sh_q(i386_elf), concat(" > ", concat(sh_q(i386_out), " 2>/dev/null")))))))
  when i386_status == 0 {
    hold c32 = assert_files_eq(ref_out, i386_out, concat(name, " seed vs i386 ELF32"))
  } otherwise {
    when arg_count() > 2 && string_eq(arg(2), "--require-i386") == 1 && (string_eq(name, "struct_mutation") == 1 || string_eq(name, "struct_mutation_scope") == 1 || string_eq(name, "struct_string") == 1) {
      hold f32run = fail_t(concat(name, ": i386 execution required by struct mutation gate"))
    }
  }

  // 5. AArch64 ELF64 via native32 arm64 AND tracked golden (when provided) executed by sxisaexec!
  hold a64_elf = concat(stem, ".arm64.elf")
  hold a64_out = concat(stem, ".arm64.out")
  hold a64_stat = concat(stem, ".arm64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(a64_elf), " arm64"))))) != 0 {
    hold fa1 = fail_t(concat(name, ": native32 arm64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(a64_out), concat(" --stats ", concat(sh_q(a64_stat), concat(" ", sh_q(a64_elf))))))) != 0 {
    hold fa2 = fail_t(concat(name, ": sxisaexec arm64 failed"))
  }
  hold ca64 = assert_files_eq(ref_out, a64_out, concat(name, " seed vs AArch64 sxisaexec"))

  when len(golden_arm64) > 0 {
    hold g_out = concat(stem, ".golden_arm64.out")
    when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(g_out), concat(" ", sh_q(golden_arm64))))) != 0 {
      hold fgld = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_arm64)))
    }
    hold cgld = assert_files_eq(ref_out, g_out, concat(name, " seed vs tracked golden arm64.elf"))
  }

  // 6. RISC-V RV64IM ELF64 via native32 riscv64 executed by sxisaexec!
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold rv_out = concat(stem, ".riscv64.out")
  hold rv_stat = concat(stem, ".riscv64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(rv_elf), " riscv64"))))) != 0 {
    hold frv1 = fail_t(concat(name, ": native32 riscv64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(rv_out), concat(" --stats ", concat(sh_q(rv_stat), concat(" ", sh_q(rv_elf))))))) != 0 {
    hold frv2 = fail_t(concat(name, ": sxisaexec riscv64 failed"))
  }
  hold crv = assert_files_eq(ref_out, rv_out, concat(name, " seed vs RV64IM sxisaexec"))

  when len(golden_riscv64) > 0 {
    hold gr_out = concat(stem, ".golden_riscv64.out")
    when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(gr_out), concat(" ", sh_q(golden_riscv64))))) != 0 {
      hold fgldr = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_riscv64)))
    }
    hold cgldr = assert_files_eq(ref_out, gr_out, concat(name, " seed vs tracked golden riscv64.elf"))
  }

  show concat("[ok] 6-way execution parity verified on ", concat(name, " (seed == gen2 == x86-64 == IR-VM == AArch64 == RV64IM)"))
  give 0
}

// Small ELF64 builder used by the syscall integration test below.
make text_has(hay: str, needle: str) -> num {
  hold nh = len(hay)
  hold nn = len(needle)
  when nn == 0 {
    give 1
  }
  when nn > nh {
    give 0
  }
  hold i = 0
  while i + nn <= nh {
    hold j = 0
    hold same = 1
    while j < nn && same == 1 {
      when sx_index(hay, i + j) != sx_index(needle, j) {
        same = 0
      }
      j = j + 1
    }
    when same == 1 {
      give 1
    }
    i = i + 1
  }
  give 0
}

make test_concat_heap_limit(dir: str) -> num {
  hold stem = concat(dir, "/concat_heap")
  hold arm_elf = concat(stem, ".arm64.elf")
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold arm_stats = concat(stem, ".arm64.stats")
  hold rv_stats = concat(stem, ".riscv64.stats")
  hold arm_out = concat(stem, ".arm64.out")
  hold rv_out = concat(stem, ".riscv64.out")
  when run_command(concat("./tools/native32 selfhost/native32_tests/heap_exhaust.sa ", concat(sh_q(arm_elf), " arm64"))) != 0 {
    hold f1 = fail_t("native32 could not emit the AArch64 concat heap-limit fixture")
  }
  when run_command(concat("./tools/native32 selfhost/native32_tests/heap_exhaust.sa ", concat(sh_q(rv_elf), " riscv64"))) != 0 {
    hold f2 = fail_t("native32 could not emit the RV64 concat heap-limit fixture")
  }
  hold arm_cmd = concat("./tools/sxisaexec --arch arm64 --out ", sh_q(arm_out))
  arm_cmd = concat(arm_cmd, concat(" --stats ", sh_q(arm_stats)))
  arm_cmd = concat(arm_cmd, concat(" ", sh_q(arm_elf)))
  hold arm_rc = run_command(arm_cmd)
  when arm_rc != 1 {
    hold f3 = fail_t(concat("AArch64 concat heap exhaustion returned ", istr(arm_rc)))
  }
  hold arm_s = read_file(arm_stats)
  when text_has(arm_s, "arch=arm64 ") == 0 || text_has(arm_s, "exit=1") == 0 {
    hold f4 = fail_t("AArch64 concat heap exhaustion did not record exit=1")
  }
  when len(read_file(arm_out)) != 0 {
    hold f5 = fail_t("AArch64 concat heap-limit fixture reached its unreachable output")
  }
  hold rv_cmd = concat("./tools/sxisaexec --arch riscv64 --out ", sh_q(rv_out))
  rv_cmd = concat(rv_cmd, concat(" --stats ", sh_q(rv_stats)))
  rv_cmd = concat(rv_cmd, concat(" ", sh_q(rv_elf)))
  hold rv_rc = run_command(rv_cmd)
  when rv_rc != 1 {
    hold f6 = fail_t(concat("RV64 concat heap exhaustion returned ", istr(rv_rc)))
  }
  hold rv_s = read_file(rv_stats)
  when text_has(rv_s, "arch=riscv64 ") == 0 || text_has(rv_s, "exit=1") == 0 {
    hold f7 = fail_t("RV64 concat heap exhaustion did not record exit=1")
  }
  when len(read_file(rv_out)) != 0 {
    hold f8 = fail_t("RV64 concat heap-limit fixture reached its unreachable output")
  }
  show "[ok] concat heap exhaustion is bounded and exits 1 on AArch64 and RV64"
  give 0
}

make test_string_index_bounds(dir: str) -> num {
  hold stem = concat(dir, "/string_index_oob")
  hold arm_elf = concat(stem, ".arm64.elf")
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold arm_stats = concat(stem, ".arm64.stats")
  hold rv_stats = concat(stem, ".riscv64.stats")
  hold arm_out = concat(stem, ".arm64.out")
  hold rv_out = concat(stem, ".riscv64.out")
  when run_command(concat("./tools/native32 selfhost/native32_tests/string_index_oob.sa ", concat(sh_q(arm_elf), " arm64"))) != 0 {
    hold f1 = fail_t("native32 could not emit AArch64 string index bounds fixture")
  }
  when run_command(concat("./tools/native32 selfhost/native32_tests/string_index_oob.sa ", concat(sh_q(rv_elf), " riscv64"))) != 0 {
    hold f2 = fail_t("native32 could not emit RV64 string index bounds fixture")
  }
  hold arm_cmd = concat("./tools/sxisaexec --arch arm64 --out ", sh_q(arm_out))
  arm_cmd = concat(arm_cmd, concat(" --stats ", sh_q(arm_stats)))
  arm_cmd = concat(arm_cmd, concat(" ", sh_q(arm_elf)))
  hold arm_rc = run_command(arm_cmd)
  when arm_rc != 1 {
    hold f3 = fail_t(concat("AArch64 out-of-range string index returned ", istr(arm_rc)))
  }
  hold arm_s = read_file(arm_stats)
  when text_has(arm_s, "arch=arm64 ") == 0 || text_has(arm_s, "exit=1") == 0 || len(read_file(arm_out)) != 0 {
    hold f4 = fail_t("AArch64 out-of-range string index did not fail closed")
  }
  hold rv_cmd = concat("./tools/sxisaexec --arch riscv64 --out ", sh_q(rv_out))
  rv_cmd = concat(rv_cmd, concat(" --stats ", sh_q(rv_stats)))
  rv_cmd = concat(rv_cmd, concat(" ", sh_q(rv_elf)))
