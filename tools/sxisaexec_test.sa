  hold data = []
  data = t_zeros(data, 640)
  give t_elf64(code, data, 183)
}

make test_arm64_isa_coverage(dir: str) -> num {
  hold e_shift = concat(dir, "/isa_shift.arm64.elf")
  hold s_shift = concat(dir, "/isa_shift.arm64.stats")
  hold e_csel = concat(dir, "/isa_csel.arm64.elf")
  hold s_csel = concat(dir, "/isa_csel.arm64.stats")
  hold e_mul = concat(dir, "/isa_mul.arm64.elf")
  hold s_mul = concat(dir, "/isa_mul.arm64.stats")
  hold e_mem = concat(dir, "/isa_mem.arm64.elf")
  hold s_mem = concat(dir, "/isa_mem.arm64.stats")
  hold e_div = concat(dir, "/isa_div.arm64.elf")
  hold s_div = concat(dir, "/isa_div.arm64.stats")
  hold e_fp = concat(dir, "/isa_fp.arm64.elf")
  hold s_fp = concat(dir, "/isa_fp.arm64.stats")
  hold e_ctrl = concat(dir, "/isa_ctrl.arm64.elf")
  hold s_ctrl = concat(dir, "/isa_ctrl.arm64.stats")
  hold e_mulh = concat(dir, "/isa_mulh.arm64.elf")
  hold s_mulh = concat(dir, "/isa_mulh.arm64.stats")
  hold e_rvmul = concat(dir, "/isa_rvmul.riscv64.elf")
  hold s_rvmul = concat(dir, "/isa_rvmul.riscv64.stats")
  when write_bytes(e_shift, t_arm_isa_shift_elf()) != 1 {
    hold fshift = fail_t("cannot write the shift AArch64 fixture")
  }
  when write_bytes(e_csel, t_arm_isa_csel_elf()) != 1 {
    hold fcsel = fail_t("cannot write the csel AArch64 fixture")
  }
  when write_bytes(e_mul, t_arm_isa_mul_elf()) != 1 {
    hold fmul = fail_t("cannot write the mul AArch64 fixture")
  }
  when write_bytes(e_div, t_arm_isa_div_elf()) != 1 {
    hold fdiv = fail_t("cannot write the divide AArch64 fixture")
  }
  when write_bytes(e_mem, t_arm_isa_mem_elf()) != 1 {
    hold fmem = fail_t("cannot write the mem AArch64 fixture")
  }
  when write_bytes(e_fp, t_arm_isa_fp_elf()) != 1 {
    hold ffp = fail_t("cannot write the fp AArch64 fixture")
  }
  when write_bytes(e_ctrl, t_arm_isa_ctrl_elf()) != 1 {
    hold fctrl = fail_t("cannot write the ctrl AArch64 fixture")
  }
  when write_bytes(e_mulh, tb_arm_mulh_elf()) != 1 {
    hold fmulh = fail_t("cannot write the SMULH/UMULH AArch64 fixture")
  }
  when write_bytes(e_rvmul, tb_rv_mul_elf()) != 1 {
    hold frvmul = fail_t("cannot write the RV64 M-extension fixture")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_shift), concat(" ", sh_q(e_shift))))) != 0 {
    hold gshift = fail_t("AArch64 shift probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_csel), concat(" ", sh_q(e_csel))))) != 0 {
    hold gcsel = fail_t("AArch64 csel probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_mul), concat(" ", sh_q(e_mul))))) != 0 {
    hold gmul = fail_t("AArch64 mul probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_mem), concat(" ", sh_q(e_mem))))) != 0 {
    hold gmem = fail_t("AArch64 mem probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_div), concat(" ", sh_q(e_div))))) != 0 {
    hold gdiv = fail_t("AArch64 divide probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_fp), concat(" ", sh_q(e_fp))))) != 0 {
    hold gfp = fail_t("AArch64 fp probes did not all match")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_ctrl), concat(" ", sh_q(e_ctrl))))) != 0 {
    hold gctrl = fail_t("AArch64 ctrl probes did not all match")
  }
  // A non-zero status is the number of rows the multiply probe disagreed on, so
  // the failure says which row rather than only that one did.
  hold mulh_rc = run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(s_mulh), concat(" ", sh_q(e_mulh)))))
  when mulh_rc != 0 {
    hold gmulh = fail_t(concat("SMULH/UMULH rows disagreed: ", istr(mulh_rc)))
  }
  hold rvmul_rc = run_command(concat("./tools/sxisaexec --arch riscv64 --stats ", concat(sh_q(s_rvmul), concat(" ", sh_q(e_rvmul)))))
  when rvmul_rc != 0 {
    hold grvmul = fail_t(concat("RV64 M-extension rows disagreed: ", istr(rvmul_rc)))
  }
  show "[ok] AArch64 bit field, CSEL, multiply, divide, load/store, scalar FP and branch probes match their expectations"
  give 0
}

make verify_sayanox_next_isas(dir: str) -> num {
  hold source = "selfhost/sayanox_next_parity_test.sa"
  hold want = "selfhost/sayanox_next_parity.want"
  hold can_i386 = run_command(concat(sh_q(concat(dir, "/literal-probe.elf")), " >/dev/null 2>&1"))
  hold i = 0
  while i < 3 {
    hold arch = "i386"
    when i == 1 { arch = "arm64" }
    when i == 2 { arch = "riscv64" }
    hold elf = concat(dir, concat("/sayanox_next-", concat(arch, ".elf")))
    hold out = concat(elf, ".out")
    when run_command(concat("./tools/native32 ", concat(sh_q(source), concat(" ", concat(sh_q(elf), concat(" ", arch)))))) != 0 {
      hold f1 = fail_t(concat("sayanox_next native32 compile: ", arch))
    }
    hold cmd = concat("./tools/sxisaexec --arch ", concat(arch, concat(" --out ", concat(sh_q(out), concat(" ", sh_q(elf))))))
    when i == 0 {
      cmd = concat("chmod +x ", concat(sh_q(elf), concat(" && ", concat(sh_q(elf), concat(" > ", sh_q(out))))))
    }
    when i > 0 || can_i386 == 0 {
      when run_command(cmd) != 0 {
        hold f2 = fail_t(concat("sayanox_next execution: ", arch))
      }
      hold eq = assert_files_eq(want, out, concat("sayanox_next multi-ISA oracle: ", arch))
    }
    i = i + 1
  }
  show "[ok] sayanox_next 4-construct parity verified across i386, arm64, and riscv64"
  give 0
}

hold vn = test_negative_faults(dir)
hold vf = test_file_syscalls(dir)
hold vfp = test_fp_arithmetic(dir)
hold visa = test_arm64_isa_coverage(dir)
hold vsxnext = verify_sayanox_next_isas(dir)
show "SXISAEXEC-PARITY-OK"
