// tools/sxisaexec_test.sa -- Pure-Sayanox multi-ISA execution proof harness
// verifying 6-way byte-for-byte execution parity across:
//   (1) seed_min + C, (2) gen2 + C, (3) native_aot (x86-64 ELF64),
//   (4) sxc_native / sxirexec (Portable IR VM) / i386 ELF32,
//   (5) AArch64 ELF64 (including reviewed tracked goldens) via sxisaexec, and
//   (6) RISC-V RV64IM ELF64 via sxisaexec,
// plus negative fault/container/permission/step-budget safety checks.

make fail_t(msg: str) -> num {
  show concat("[FAIL] sxisaexec_test: ", msg)
  hold w = write_file("/dev/stderr", concat(concat("[FAIL] sxisaexec_test: ", msg), "\n"))
  hold s = exit(1)
  give 0
}

make istr(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold n = v
  when n < 0 {
    neg = 1
    n = 0 - n
  }
  hold out = ""
  while n > 0 {
    hold d = n % 10
    out = concat(chr(48 + d), out)
    n = (n - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make sh_q(s: str) -> str {
  hold sq = chr(39)
  hold bs = chr(92)
  hold out = sq
  hold n = len(s)
  hold i = 0
  while i < n {
    hold c = sx_index(s, i)
    when c == 39 {
      out = concat(out, concat(sq, concat(bs, concat(sq, sq))))
    } otherwise {
      out = concat(out, chr(c))
    }
    i = i + 1
  }
  give concat(out, sq)
}

make cc_bin() -> str {
  hold c = getenv("CC")
  when len(c) > 0 {
    give c
  }
  give "cc"
}

make assert_eq_num(got: num, want: num, label: str) -> num {
  when got != want {
    hold f = fail_t(concat(label, concat(": got ", concat(istr(got), concat(", want ", istr(want))))))
  }
  give 0
}

make assert_files_eq(a: str, b: str, label: str) -> num {
  hold ba = []
  hold bb = []
  hold na = read_bytes(a, ba)
  hold nb = read_bytes(b, bb)
  when na < 0 || nb < 0 {
    hold f0 = fail_t(concat(label, ": unreadable output file"))
  }
  when na != nb {
    hold f1 = fail_t(concat(label, concat(": byte length ", concat(istr(na), concat(" vs ", istr(nb))))))
  }
  hold i = 0
  while i < na {
    hold xa = ba[i]
    hold xb = bb[i]
    when xa != xb {
      hold f2 = fail_t(concat(label, concat(": mismatch at byte ", istr(i))))
    }
    i = i + 1
  }
  give 0
}

make write_deep_fixture(path: str) -> num {
  hold q = chr(34)
  hold nl = chr(10)
  hold bs = chr(92)
  hold lb = chr(123)
  hold rb = chr(125)
  hold s = ""
  s = concat(s, concat("// Multi-ISA arithmetic, relational, and nested loop/branch stress fixture", nl))
  s = concat(s, concat("hold a = (0 - 32767) * 65536 - 65535", nl))
  s = concat(s, concat("hold b = (0 - 15070) * 65536 - 29137", nl))
  s = concat(s, concat("show 0 - 999999", nl))
  s = concat(s, concat("show 999 * (0 - 999)", nl))
  s = concat(s, concat("show (0 - 17) % 5", nl))
  s = concat(s, concat("show 17 % 5", nl))
  s = concat(s, concat("show 997 * 991", nl))
  s = concat(s, concat("show (0 - 997) * 991", nl))
  s = concat(s, concat("show (a < b)", nl))
  s = concat(s, concat("show (a <= a)", nl))
  s = concat(s, concat("show (b > a)", nl))
  s = concat(s, concat("show (0 >= a)", nl))
  s = concat(s, concat("show (42 == 42)", nl))
  s = concat(s, concat("show (42 != 43)", nl))
  // Iterative GCD(1071, 462) == 21 and Collatz steps from 27 == 111
  s = concat(s, concat("hold x = 1071", nl))
  s = concat(s, concat("hold y = 462", nl))
  s = concat(s, concat("while y != 0 ", concat(lb, nl)))
  s = concat(s, concat("  hold t = x % y", nl))
  s = concat(s, concat("  x = y", nl))
  s = concat(s, concat("  y = t", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show x", nl))
  // Nested when/otherwise accumulator
  s = concat(s, concat("hold i = 0", nl))
  s = concat(s, concat("hold acc = 0", nl))
  s = concat(s, concat("while i < 25 ", concat(lb, nl)))
  s = concat(s, concat("  when i % 3 == 0 ", concat(lb, nl)))
  s = concat(s, concat("    acc = acc + i * 2", nl))
  s = concat(s, concat("  ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("    when i % 2 == 0 ", concat(lb, nl)))
  s = concat(s, concat("      acc = acc - i", nl))
  s = concat(s, concat("    ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("      acc = acc + 7", nl))
  s = concat(s, concat("    ", concat(rb, nl)))
  s = concat(s, concat("  ", concat(rb, nl)))
  s = concat(s, concat("  i = i + 1", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show acc", nl))
  s = concat(s, concat("show ", concat(q, concat("isa-ok", concat(bs, concat("tDONE", q))))))
  s = concat(s, nl)
  when write_file(path, s) != 1 {
    hold fw = fail_t("cannot write deep fixture")
  }
  give 0
}

make verify_six_way(dir: str, name: str, sa_path: str, golden_arm64: str, golden_riscv64: str) -> num {
  hold cc = cc_bin()
  hold stem = concat(dir, concat("/", name))
  hold ref_out = concat(stem, ".seed.out")

  // 1. seed_min + cc
  hold seed_c = concat(stem, ".seed.c")
  hold seed_exe = concat(stem, ".seed")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(sa_path), concat(" > ", sh_q(seed_c))))) != 0 {
    hold fs1 = fail_t(concat(name, ": seed_min failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -o ", concat(sh_q(seed_exe), concat(" ", sh_q(seed_c)))))) != 0 {
    hold fs2 = fail_t(concat(name, ": seed cc failed"))
  }
  when run_command(concat(sh_q(seed_exe), concat(" > ", sh_q(ref_out)))) != 0 {
    hold fs3 = fail_t(concat(name, ": seed binary failed"))
  }

  // 2. gen2 + cc
  hold g2_c = concat(stem, ".gen2.c")
  hold g2_exe = concat(stem, ".gen2")
  hold g2_out = concat(stem, ".gen2.out")
  when run_command(concat("./selfhost/gen2 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(g2_c), " >/dev/null"))))) != 0 {
    hold fg1 = fail_t(concat(name, ": gen2 failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -Wno-implicit-function-declaration -o ", concat(sh_q(g2_exe), concat(" ", sh_q(g2_c)))))) != 0 {
    hold fg2 = fail_t(concat(name, ": gen2 cc failed"))
  }
  when run_command(concat(sh_q(g2_exe), concat(" > ", sh_q(g2_out)))) != 0 {
    hold fg3 = fail_t(concat(name, ": gen2 binary failed"))
  }
  hold cg = assert_files_eq(ref_out, g2_out, concat(name, " seed vs gen2"))

  // 3. native_aot (x86-64 ELF64) + SX_EMIT_LOG -> emit_to_ir -> sxirexec (Portable IR VM!)
  hold x64_exe = concat(stem, ".x86_64.elf")
  hold x64_out = concat(stem, ".x86_64.out")
  hold elog = concat(stem, ".emit.log")
  hold ir_f = concat(stem, ".ir")
  hold ir_out = concat(stem, ".ir.out")
  when run_command(concat("SX_EMIT_LOG=", concat(sh_q(elog), concat(" ./selfhost/native_aot ", concat(sh_q(sa_path), concat(" ", sh_q(x64_exe))))))) != 0 {
    hold fx1 = fail_t(concat(name, ": native_aot failed"))
  }
  when run_command(concat(sh_q(x64_exe), concat(" > ", sh_q(x64_out)))) != 0 {
    hold fx2 = fail_t(concat(name, ": x86_64 binary failed"))
  }
  hold cx = assert_files_eq(ref_out, x64_out, concat(name, " seed vs x86_64 native_aot"))

  // 4. Portable IR VM (sxirexec) + sxc_native + i386 (when host runs IA32)
  when path_kind("./tools/sxirexec") == 1 {
    hold ir_wd = concat(stem, "_ir_wd")
    when run_command(concat("./tools/sxirexec compile-and-run ", concat(sh_q(sa_path), concat(" ", concat(sh_q(ir_wd), concat(" > ", sh_q(ir_out))))))) != 0 {
      hold fi2 = fail_t(concat(name, ": sxirexec failed"))
    }
    hold cir = assert_files_eq(ref_out, ir_out, concat(name, " seed vs Portable IR VM"))
  }
  when path_kind("./tools/sxc_native") == 1 {
    hold fn_exe = concat(stem, ".sxc_native.elf")
    hold fn_out = concat(stem, ".sxc_native.out")
    when run_command(concat("./tools/sxc_native ", concat(sh_q(sa_path), concat(" ", sh_q(fn_exe))))) != 0 {
      hold fsn1 = fail_t(concat(name, ": sxc_native failed"))
    }
    when run_command(concat(sh_q(fn_exe), concat(" > ", sh_q(fn_out)))) != 0 {
      hold fsn2 = fail_t(concat(name, ": sxc_native binary failed"))
    }
    hold csn = assert_files_eq(ref_out, fn_out, concat(name, " seed vs sxc_native"))
  }
  hold i386_elf = concat(stem, ".i386.elf")
  hold i386_out = concat(stem, ".i386.out")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(i386_elf), " i386"))))) != 0 {
    hold f32 = fail_t(concat(name, ": native32 i386 failed"))
  }
  when run_command(concat("chmod +x ", concat(sh_q(i386_elf), concat(" && ", concat(sh_q(i386_elf), concat(" > ", concat(sh_q(i386_out), " 2>/dev/null"))))))) == 0 {
    hold c32 = assert_files_eq(ref_out, i386_out, concat(name, " seed vs i386 ELF32"))
  }

  // 5. AArch64 ELF64 via native32 arm64 AND tracked golden (when provided) executed by sxisaexec!
  hold a64_elf = concat(stem, ".arm64.elf")
  hold a64_out = concat(stem, ".arm64.out")
  hold a64_stat = concat(stem, ".arm64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(a64_elf), " arm64"))))) != 0 {
    hold fa1 = fail_t(concat(name, ": native32 arm64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(a64_out), concat(" --stats ", concat(sh_q(a64_stat), concat(" ", sh_q(a64_elf))))))) != 0 {
    hold fa2 = fail_t(concat(name, ": sxisaexec arm64 failed"))
  }
  hold ca64 = assert_files_eq(ref_out, a64_out, concat(name, " seed vs AArch64 sxisaexec"))

  when len(golden_arm64) > 0 {
    hold g_out = concat(stem, ".golden_arm64.out")
    when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(g_out), concat(" ", sh_q(golden_arm64))))) != 0 {
      hold fgld = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_arm64)))
    }
    hold cgld = assert_files_eq(ref_out, g_out, concat(name, " seed vs tracked golden arm64.elf"))
  }

  // 6. RISC-V RV64IM ELF64 via native32 riscv64 executed by sxisaexec!
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold rv_out = concat(stem, ".riscv64.out")
  hold rv_stat = concat(stem, ".riscv64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(rv_elf), " riscv64"))))) != 0 {
    hold frv1 = fail_t(concat(name, ": native32 riscv64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(rv_out), concat(" --stats ", concat(sh_q(rv_stat), concat(" ", sh_q(rv_elf))))))) != 0 {
    hold frv2 = fail_t(concat(name, ": sxisaexec riscv64 failed"))
  }
  hold crv = assert_files_eq(ref_out, rv_out, concat(name, " seed vs RV64IM sxisaexec"))

  when len(golden_riscv64) > 0 {
    hold gr_out = concat(stem, ".golden_riscv64.out")
    when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(gr_out), concat(" ", sh_q(golden_riscv64))))) != 0 {
      hold fgldr = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_riscv64)))
    }
    hold cgldr = assert_files_eq(ref_out, gr_out, concat(name, " seed vs tracked golden riscv64.elf"))
  }

  show concat("[ok] 6-way execution parity verified on ", concat(name, " (seed == gen2 == x86-64 == IR-VM == AArch64 == RV64IM)"))
  give 0
}

make test_negative_faults(dir: str) -> num {
  // Usage / flag errors -> exit 2
  hold r_noarg = run_command("./tools/sxisaexec >/dev/null 2>&1")
  hold c0 = assert_eq_num(r_noarg, 2, "sxisaexec missing args")
  hold r_badarch = run_command("./tools/sxisaexec --arch mips64 foo >/dev/null 2>&1")
  hold c1 = assert_eq_num(r_badarch, 2, "sxisaexec unknown --arch")

  // Reject ELF32 (i386) and x86-64 ELF64 (EM_X86_64 = 62) -> exit 1
  hold r_elf32 = run_command(concat("./tools/sxisaexec ", concat(sh_q(concat(dir, "/expr.i386.elf")), " >/dev/null 2>&1")))
  hold c2 = assert_eq_num(r_elf32, 1, "reject ELFCLASS32")
  hold r_x64 = run_command(concat("./tools/sxisaexec ", concat(sh_q(concat(dir, "/expr.x86_64.elf")), " >/dev/null 2>&1")))
  hold c3 = assert_eq_num(r_x64, 1, "reject EM_X86_64")

  // Reject arch mismatch (--arch arm64 on riscv64 ELF and vice versa) -> exit 1
  hold r_mm1 = run_command(concat("./tools/sxisaexec --arch arm64 ", concat(sh_q(concat(dir, "/expr.riscv64.elf")), " >/dev/null 2>&1")))
  hold c4 = assert_eq_num(r_mm1, 1, "reject riscv64 under --arch arm64")
  hold r_mm2 = run_command(concat("./tools/sxisaexec --arch riscv64 ", concat(sh_q(concat(dir, "/expr.arm64.elf")), " >/dev/null 2>&1")))
  hold c5 = assert_eq_num(r_mm2, 1, "reject arm64 under --arch riscv64")

  // Step budget fault on both arm64 and riscv64 -> exit 1
  hold r_st1 = run_command(concat("./tools/sxisaexec --max-steps 5 ", concat(sh_q(concat(dir, "/expr.arm64.elf")), " >/dev/null 2>&1")))
  hold c6 = assert_eq_num(r_st1, 1, "arm64 step-budget fault")
  hold r_st2 = run_command(concat("./tools/sxisaexec --max-steps 5 ", concat(sh_q(concat(dir, "/expr.riscv64.elf")), " >/dev/null 2>&1")))
  hold c7 = assert_eq_num(r_st2, 1, "riscv64 step-budget fault")

  // Illegal opcode fault (patch 0xFFFFFFFF at e_entry offset in file) -> exit 1
  hold ba = []
  hold na = read_bytes(concat(dir, "/expr.arm64.elf"), ba)
  hold entry_a = ba[24] + ba[25] * 256 + ba[26] * 65536 + ba[27] * 16777216
  hold foff_a = entry_a - 4194304
  ba[foff_a] = 255
  ba[foff_a + 1] = 255
  ba[foff_a + 2] = 255
  ba[foff_a + 3] = 255
  hold bad_a = concat(dir, "/bad_opcode.arm64.elf")
  when write_bytes(bad_a, ba) != 1 {
    hold fw1 = fail_t("write bad_opcode.arm64.elf")
  }
  hold r_illa = run_command(concat("./tools/sxisaexec ", concat(sh_q(bad_a), " >/dev/null 2>&1")))
  hold c8 = assert_eq_num(r_illa, 1, "arm64 illegal instruction fault")

  hold br = []
  hold nr = read_bytes(concat(dir, "/expr.riscv64.elf"), br)
  hold entry_r = br[24] + br[25] * 256 + br[26] * 65536 + br[27] * 16777216
  hold foff_r = entry_r - 4194304
  br[foff_r] = 255
  br[foff_r + 1] = 255
  br[foff_r + 2] = 255
  br[foff_r + 3] = 255
  hold bad_r = concat(dir, "/bad_opcode.riscv64.elf")
  when write_bytes(bad_r, br) != 1 {
    hold fw2 = fail_t("write bad_opcode.riscv64.elf")
  }
  hold r_illr = run_command(concat("./tools/sxisaexec ", concat(sh_q(bad_r), " >/dev/null 2>&1")))
  hold c9 = assert_eq_num(r_illr, 1, "riscv64 illegal instruction fault")

  show "[ok] sxisaexec safety & negative controls verified (bad magic/class/machine, arch mismatch, step budget, illegal opcode)"
  give 0
}

hold dir = "selfhost/seed_tests/isa_exec"
when run_command(concat("rm -rf ", concat(sh_q(dir), concat(" && mkdir -p ", sh_q(dir))))) != 0 {
  hold fd = fail_t("cannot create isa_exec workdir")
}

// Execute all 3 tracked native32 fixtures (including tracked arm64 + riscv64 goldens!) + deep multi-ISA fixture
hold v1 = verify_six_way(dir, "expr", "selfhost/native32_tests/expr.sa", "selfhost/native32_tests/golden/expr.arm64.elf", "selfhost/native32_tests/golden/expr.riscv64.elf")
hold v2 = verify_six_way(dir, "flow", "selfhost/native32_tests/flow.sa", "selfhost/native32_tests/golden/flow.arm64.elf", "selfhost/native32_tests/golden/flow.riscv64.elf")
hold v3 = verify_six_way(dir, "text", "selfhost/native32_tests/text.sa", "selfhost/native32_tests/golden/text.arm64.elf", "selfhost/native32_tests/golden/text.riscv64.elf")

hold deep_sa = concat(dir, "/isa_deep.sa")
hold wd = write_deep_fixture(deep_sa)
hold v4 = verify_six_way(dir, "isa_deep", deep_sa, "", "")

hold vn = test_negative_faults(dir)
show "SXISAEXEC-PARITY-OK"
