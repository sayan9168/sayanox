// tools/sxisaexec_test.sa -- Pure-Sayanox multi-ISA execution proof harness
// verifying 6-way byte-for-byte execution parity across integer and static-string fixtures:
//   (1) seed_min + C, (2) gen2 + C, (3) native_aot (x86-64 ELF64),
//   (4) sxc_native / sxirexec (Portable IR VM) / i386 ELF32,
//   (5) AArch64 ELF64 (including reviewed tracked goldens) via sxisaexec, and
//   (6) RISC-V RV64IM ELF64 via sxisaexec,
// plus scalar IEEE-754 AArch64/RV64F/D arithmetic, Linux openat/read/write/
// close file syscalls, and negative fault/container/permission/step-budget checks.

make fail_t(msg: str) -> num {
  show concat("[FAIL] sxisaexec_test: ", msg)
  hold w = write_file("/dev/stderr", concat(concat("[FAIL] sxisaexec_test: ", msg), "\n"))
  hold s = exit(1)
  give 0
}

make istr(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold n = v
  when n < 0 {
    neg = 1
    n = 0 - n
  }
  hold out = ""
  while n > 0 {
    hold d = n % 10
    out = concat(chr(48 + d), out)
    n = (n - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make sh_q(s: str) -> str {
  hold sq = chr(39)
  hold bs = chr(92)
  hold out = sq
  hold n = len(s)
  hold i = 0
  while i < n {
    hold c = sx_index(s, i)
    when c == 39 {
      out = concat(out, concat(sq, concat(bs, concat(sq, sq))))
    } otherwise {
      out = concat(out, chr(c))
    }
    i = i + 1
  }
  give concat(out, sq)
}

make cc_bin() -> str {
  hold c = getenv("CC")
  when len(c) > 0 {
    give c
  }
  give "cc"
}

make assert_eq_num(got: num, want: num, label: str) -> num {
  when got != want {
    hold f = fail_t(concat(label, concat(": got ", concat(istr(got), concat(", want ", istr(want))))))
  }
  give 0
}

make assert_files_eq(a: str, b: str, label: str) -> num {
  hold ba = []
  hold bb = []
  hold na = read_bytes(a, ba)
  hold nb = read_bytes(b, bb)
  when na < 0 || nb < 0 {
    hold f0 = fail_t(concat(label, ": unreadable output file"))
  }
  when na != nb {
    hold f1 = fail_t(concat(label, concat(": byte length ", concat(istr(na), concat(" vs ", istr(nb))))))
  }
  hold i = 0
  while i < na {
    hold xa = ba[i]
    hold xb = bb[i]
    when xa != xb {
      hold f2 = fail_t(concat(label, concat(": mismatch at byte ", istr(i))))
    }
    i = i + 1
  }
  give 0
}

make write_deep_fixture(path: str) -> num {
  hold q = chr(34)
  hold nl = chr(10)
  hold bs = chr(92)
  hold lb = chr(123)
  hold rb = chr(125)
  hold s = ""
  s = concat(s, concat("// Multi-ISA arithmetic, relational, and nested loop/branch stress fixture", nl))
  s = concat(s, concat("hold a = (0 - 32767) * 65536 - 65535", nl))
  s = concat(s, concat("hold b = (0 - 15070) * 65536 - 29137", nl))
  s = concat(s, concat("show 0 - 999999", nl))
  s = concat(s, concat("show 999 * (0 - 999)", nl))
  s = concat(s, concat("show (0 - 17) % 5", nl))
  s = concat(s, concat("show 17 % 5", nl))
  s = concat(s, concat("show 997 * 991", nl))
  s = concat(s, concat("show (0 - 997) * 991", nl))
  s = concat(s, concat("show (a < b)", nl))
  s = concat(s, concat("show (a <= a)", nl))
  s = concat(s, concat("show (b > a)", nl))
  s = concat(s, concat("show (0 >= a)", nl))
  s = concat(s, concat("show (42 == 42)", nl))
  s = concat(s, concat("show (42 != 43)", nl))
  // Iterative GCD(1071, 462) == 21 and Collatz steps from 27 == 111
  s = concat(s, concat("hold x = 1071", nl))
  s = concat(s, concat("hold y = 462", nl))
  s = concat(s, concat("while y != 0 ", concat(lb, nl)))
  s = concat(s, concat("  hold t = x % y", nl))
  s = concat(s, concat("  x = y", nl))
  s = concat(s, concat("  y = t", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show x", nl))
  // Nested when/otherwise accumulator
  s = concat(s, concat("hold i = 0", nl))
  s = concat(s, concat("hold acc = 0", nl))
  s = concat(s, concat("while i < 25 ", concat(lb, nl)))
  s = concat(s, concat("  when i % 3 == 0 ", concat(lb, nl)))
  s = concat(s, concat("    acc = acc + i * 2", nl))
  s = concat(s, concat("  ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("    when i % 2 == 0 ", concat(lb, nl)))
  s = concat(s, concat("      acc = acc - i", nl))
  s = concat(s, concat("    ", concat(rb, concat(" otherwise ", concat(lb, nl)))))
  s = concat(s, concat("      acc = acc + 7", nl))
  s = concat(s, concat("    ", concat(rb, nl)))
  s = concat(s, concat("  ", concat(rb, nl)))
  s = concat(s, concat("  i = i + 1", nl))
  s = concat(s, concat(rb, nl))
  s = concat(s, concat("show acc", nl))
  s = concat(s, concat("show ", concat(q, concat("isa-ok", concat(bs, concat("tDONE", q))))))
  s = concat(s, nl)
  when write_file(path, s) != 1 {
    hold fw = fail_t("cannot write deep fixture")
  }
  give 0
}

make verify_six_way(dir: str, name: str, sa_path: str, golden_arm64: str, golden_riscv64: str) -> num {
  hold cc = cc_bin()
  hold stem = concat(dir, concat("/", name))
  hold ref_out = concat(stem, ".seed.out")

  // 1. seed_min + cc
  hold seed_c = concat(stem, ".seed.c")
  hold seed_exe = concat(stem, ".seed")
  when run_command(concat("./selfhost/seed/sxc_seed_min ", concat(sh_q(sa_path), concat(" > ", sh_q(seed_c))))) != 0 {
    hold fs1 = fail_t(concat(name, ": seed_min failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -o ", concat(sh_q(seed_exe), concat(" ", sh_q(seed_c)))))) != 0 {
    hold fs2 = fail_t(concat(name, ": seed cc failed"))
  }
  when run_command(concat(sh_q(seed_exe), concat(" > ", sh_q(ref_out)))) != 0 {
    hold fs3 = fail_t(concat(name, ": seed binary failed"))
  }

  // 2. gen2 + cc
  hold g2_c = concat(stem, ".gen2.c")
  hold g2_exe = concat(stem, ".gen2")
  hold g2_out = concat(stem, ".gen2.out")
  when run_command(concat("./selfhost/gen2 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(g2_c), " >/dev/null"))))) != 0 {
    hold fg1 = fail_t(concat(name, ": gen2 failed"))
  }
  when run_command(concat(cc, concat(" -std=gnu99 -O2 -Wno-implicit-function-declaration -o ", concat(sh_q(g2_exe), concat(" ", sh_q(g2_c)))))) != 0 {
    hold fg2 = fail_t(concat(name, ": gen2 cc failed"))
  }
  when run_command(concat(sh_q(g2_exe), concat(" > ", sh_q(g2_out)))) != 0 {
    hold fg3 = fail_t(concat(name, ": gen2 binary failed"))
  }
  hold cg = assert_files_eq(ref_out, g2_out, concat(name, " seed vs gen2"))

  // 3. native_aot (x86-64 ELF64) + SX_EMIT_LOG -> emit_to_ir -> sxirexec (Portable IR VM!)
  hold x64_exe = concat(stem, ".x86_64.elf")
  hold x64_out = concat(stem, ".x86_64.out")
  hold elog = concat(stem, ".emit.log")
  hold ir_f = concat(stem, ".ir")
  hold ir_out = concat(stem, ".ir.out")
  when run_command(concat("SX_EMIT_LOG=", concat(sh_q(elog), concat(" ./selfhost/native_aot ", concat(sh_q(sa_path), concat(" ", sh_q(x64_exe))))))) != 0 {
    hold fx1 = fail_t(concat(name, ": native_aot failed"))
  }
  when run_command(concat(sh_q(x64_exe), concat(" > ", sh_q(x64_out)))) != 0 {
    hold fx2 = fail_t(concat(name, ": x86_64 binary failed"))
  }
  hold cx = assert_files_eq(ref_out, x64_out, concat(name, " seed vs x86_64 native_aot"))

  // 4. Portable IR VM (sxirexec) + sxc_native + i386 (when host runs IA32)
  when path_kind("./tools/sxirexec") == 1 {
    hold ir_wd = concat(stem, "_ir_wd")
    when run_command(concat("./tools/sxirexec compile-and-run ", concat(sh_q(sa_path), concat(" ", concat(sh_q(ir_wd), concat(" > ", sh_q(ir_out))))))) != 0 {
      hold fi2 = fail_t(concat(name, ": sxirexec failed"))
    }
    hold cir = assert_files_eq(ref_out, ir_out, concat(name, " seed vs Portable IR VM"))
  }
  when path_kind("./tools/sxc_native") == 1 {
    hold fn_exe = concat(stem, ".sxc_native.elf")
    hold fn_out = concat(stem, ".sxc_native.out")
    when run_command(concat("./tools/sxc_native ", concat(sh_q(sa_path), concat(" ", sh_q(fn_exe))))) != 0 {
      hold fsn1 = fail_t(concat(name, ": sxc_native failed"))
    }
    when run_command(concat(sh_q(fn_exe), concat(" > ", sh_q(fn_out)))) != 0 {
      hold fsn2 = fail_t(concat(name, ": sxc_native binary failed"))
    }
    hold csn = assert_files_eq(ref_out, fn_out, concat(name, " seed vs sxc_native"))
  }
  hold i386_elf = concat(stem, ".i386.elf")
  hold i386_out = concat(stem, ".i386.out")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(i386_elf), " i386"))))) != 0 {
    hold f32 = fail_t(concat(name, ": native32 i386 failed"))
  }
  when run_command(concat("chmod +x ", concat(sh_q(i386_elf), concat(" && ", concat(sh_q(i386_elf), concat(" > ", concat(sh_q(i386_out), " 2>/dev/null"))))))) == 0 {
    hold c32 = assert_files_eq(ref_out, i386_out, concat(name, " seed vs i386 ELF32"))
  }

  // 5. AArch64 ELF64 via native32 arm64 AND tracked golden (when provided) executed by sxisaexec!
  hold a64_elf = concat(stem, ".arm64.elf")
  hold a64_out = concat(stem, ".arm64.out")
  hold a64_stat = concat(stem, ".arm64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(a64_elf), " arm64"))))) != 0 {
    hold fa1 = fail_t(concat(name, ": native32 arm64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(a64_out), concat(" --stats ", concat(sh_q(a64_stat), concat(" ", sh_q(a64_elf))))))) != 0 {
    hold fa2 = fail_t(concat(name, ": sxisaexec arm64 failed"))
  }
  hold ca64 = assert_files_eq(ref_out, a64_out, concat(name, " seed vs AArch64 sxisaexec"))

  when len(golden_arm64) > 0 {
    hold g_out = concat(stem, ".golden_arm64.out")
    when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(g_out), concat(" ", sh_q(golden_arm64))))) != 0 {
      hold fgld = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_arm64)))
    }
    hold cgld = assert_files_eq(ref_out, g_out, concat(name, " seed vs tracked golden arm64.elf"))
  }

  // 6. RISC-V RV64IM ELF64 via native32 riscv64 executed by sxisaexec!
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold rv_out = concat(stem, ".riscv64.out")
  hold rv_stat = concat(stem, ".riscv64.stats")
  when run_command(concat("./tools/native32 ", concat(sh_q(sa_path), concat(" ", concat(sh_q(rv_elf), " riscv64"))))) != 0 {
    hold frv1 = fail_t(concat(name, ": native32 riscv64 failed"))
  }
  when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(rv_out), concat(" --stats ", concat(sh_q(rv_stat), concat(" ", sh_q(rv_elf))))))) != 0 {
    hold frv2 = fail_t(concat(name, ": sxisaexec riscv64 failed"))
  }
  hold crv = assert_files_eq(ref_out, rv_out, concat(name, " seed vs RV64IM sxisaexec"))

  when len(golden_riscv64) > 0 {
    hold gr_out = concat(stem, ".golden_riscv64.out")
    when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(gr_out), concat(" ", sh_q(golden_riscv64))))) != 0 {
      hold fgldr = fail_t(concat(name, concat(": sxisaexec failed on tracked golden ", golden_riscv64)))
    }
    hold cgldr = assert_files_eq(ref_out, gr_out, concat(name, " seed vs tracked golden riscv64.elf"))
  }

  show concat("[ok] 6-way execution parity verified on ", concat(name, " (seed == gen2 == x86-64 == IR-VM == AArch64 == RV64IM)"))
  give 0
}

// Small ELF64 builder used by the syscall integration test below.
make text_has(hay: str, needle: str) -> num {
  hold nh = len(hay)
  hold nn = len(needle)
  when nn == 0 {
    give 1
  }
  when nn > nh {
    give 0
  }
  hold i = 0
  while i + nn <= nh {
    hold j = 0
    hold same = 1
    while j < nn && same == 1 {
      when sx_index(hay, i + j) != sx_index(needle, j) {
        same = 0
      }
      j = j + 1
    }
    when same == 1 {
      give 1
    }
    i = i + 1
  }
  give 0
}

make test_concat_heap_limit(dir: str) -> num {
  hold stem = concat(dir, "/concat_heap")
  hold arm_elf = concat(stem, ".arm64.elf")
  hold rv_elf = concat(stem, ".riscv64.elf")
  hold arm_stats = concat(stem, ".arm64.stats")
  hold rv_stats = concat(stem, ".riscv64.stats")
  hold arm_out = concat(stem, ".arm64.out")
  hold rv_out = concat(stem, ".riscv64.out")
  when run_command(concat("./tools/native32 selfhost/native32_tests/heap_exhaust.sa ", concat(sh_q(arm_elf), " arm64"))) != 0 {
    hold f1 = fail_t("native32 could not emit the AArch64 concat heap-limit fixture")
  }
  when run_command(concat("./tools/native32 selfhost/native32_tests/heap_exhaust.sa ", concat(sh_q(rv_elf), " riscv64"))) != 0 {
    hold f2 = fail_t("native32 could not emit the RV64 concat heap-limit fixture")
  }
  hold arm_cmd = concat("./tools/sxisaexec --arch arm64 --out ", sh_q(arm_out))
  arm_cmd = concat(arm_cmd, concat(" --stats ", sh_q(arm_stats)))
  arm_cmd = concat(arm_cmd, concat(" ", sh_q(arm_elf)))
  hold arm_rc = run_command(arm_cmd)
  when arm_rc != 1 {
    hold f3 = fail_t(concat("AArch64 concat heap exhaustion returned ", istr(arm_rc)))
  }
  hold arm_s = read_file(arm_stats)
  when text_has(arm_s, "arch=arm64 ") == 0 || text_has(arm_s, "exit=1") == 0 {
    hold f4 = fail_t("AArch64 concat heap exhaustion did not record exit=1")
  }
  when len(read_file(arm_out)) != 0 {
    hold f5 = fail_t("AArch64 concat heap-limit fixture reached its unreachable output")
  }
  hold rv_cmd = concat("./tools/sxisaexec --arch riscv64 --out ", sh_q(rv_out))
  rv_cmd = concat(rv_cmd, concat(" --stats ", sh_q(rv_stats)))
  rv_cmd = concat(rv_cmd, concat(" ", sh_q(rv_elf)))
  hold rv_rc = run_command(rv_cmd)
  when rv_rc != 1 {
    hold f6 = fail_t(concat("RV64 concat heap exhaustion returned ", istr(rv_rc)))
  }
  hold rv_s = read_file(rv_stats)
  when text_has(rv_s, "arch=riscv64 ") == 0 || text_has(rv_s, "exit=1") == 0 {
    hold f7 = fail_t("RV64 concat heap exhaustion did not record exit=1")
  }
  when len(read_file(rv_out)) != 0 {
    hold f8 = fail_t("RV64 concat heap-limit fixture reached its unreachable output")
  }
  show "[ok] concat heap exhaustion is bounded and exits 1 on AArch64 and RV64"
  give 0
}

make t_put_u16(bs: list, v: num) -> list {
  bs = push(bs, bit_and(v, 255))
  bs = push(bs, bit_and(shr(v, 8), 255))
  give bs
}

make t_put_u32(bs: list, v: num) -> list {
  bs = t_put_u16(bs, bit_and(v, 65535))
  bs = t_put_u16(bs, bit_and(shr(v, 16), 65535))
  give bs
}

make t_put_u64(bs: list, v: num) -> list {
  bs = t_put_u32(bs, bit_and(v, 4294967295))
  bs = t_put_u32(bs, shr(v, 32))
  give bs
}

make t_zeros(bs: list, n: num) -> list {
  hold i = 0
  while i < n {
    bs = push(bs, 0)
    i = i + 1
  }
  give bs
}

make t_word(bs: list, w: num) -> list {
  bs = t_put_u32(bs, w)
  give bs
}

make t_arm_mov32(bs: list, rd: num, v: num) -> list {
  hold lo = bit_and(v, 65535)
  hold hi = bit_and(shr(v, 16), 65535)
  bs = t_word(bs, 3531603968 + lo * 32 + rd) // MOVZ Xd,#lo
  when hi != 0 {
    bs = t_word(bs, 4070572032 + hi * 32 + rd) // MOVK Xd,#hi,LSL#16
  }
  give bs
}

make t_arm_sysfile(path1: str, path2: str, count: num) -> list {
  hold code = []
  hold path1_addr = 4198400
  hold path2_addr = 4198528
  hold buf_addr = 4198656
  // openat(AT_FDCWD, input, O_RDONLY, 0)
  code = t_arm_mov32(code, 0, 65436)
  code = t_arm_mov32(code, 1, path1_addr)
  code = t_arm_mov32(code, 2, 0)
  code = t_arm_mov32(code, 8, 56)
  code = t_word(code, 3556769793)
  // read(fd=3, buffer, count)
  code = t_arm_mov32(code, 1, buf_addr)
  code = t_arm_mov32(code, 2, count)
  code = t_arm_mov32(code, 8, 63)
  code = t_word(code, 3556769793)
  // close(3)
  code = t_arm_mov32(code, 0, 3)
  code = t_arm_mov32(code, 8, 57)
  code = t_word(code, 3556769793)
  // openat(AT_FDCWD, output, O_WRONLY|O_CREAT|O_TRUNC, 0644)
  code = t_arm_mov32(code, 0, 65436)
  code = t_arm_mov32(code, 1, path2_addr)
  code = t_arm_mov32(code, 2, 577)
  code = t_arm_mov32(code, 3, 420)
  code = t_arm_mov32(code, 8, 56)
  code = t_word(code, 3556769793)
  // write(3, buffer, count), close(3), exit(0)
  code = t_arm_mov32(code, 0, 3)
  code = t_arm_mov32(code, 1, buf_addr)
  code = t_arm_mov32(code, 2, count)
  code = t_arm_mov32(code, 8, 64)
  code = t_word(code, 3556769793)
  code = t_arm_mov32(code, 0, 3)
  code = t_arm_mov32(code, 8, 57)
  code = t_word(code, 3556769793)
  code = t_arm_mov32(code, 0, 0)
  code = t_arm_mov32(code, 8, 93)
  code = t_word(code, 3556769793)

  hold data = []
  hold i = 0
  while i < len(path1) {
    data = push(data, sx_index(path1, i))
    i = i + 1
  }
  data = push(data, 0)
  data = t_zeros(data, path2_addr - path1_addr - len(path1) - 1)
  i = 0
  while i < len(path2) {
    data = push(data, sx_index(path2, i))
    i = i + 1
  }
  data = push(data, 0)
  data = t_zeros(data, buf_addr - path2_addr - len(path2) - 1)
  data = t_zeros(data, count + 16)

  hold img = []
  img = push(img, 127)
  img = push(img, 69)
  img = push(img, 76)
  img = push(img, 70)
  img = push(img, 2)
  img = push(img, 1)
  img = push(img, 1)
  img = push(img, 0)
  img = t_zeros(img, 8)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, 183)
  img = t_put_u32(img, 1)
  img = t_put_u64(img, 4194304 + 176)
  img = t_put_u64(img, 64)
  img = t_put_u64(img, 0)
  img = t_put_u32(img, 0)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 56)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 0)
  img = t_put_u16(img, 0)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 5)
  img = t_put_u64(img, 0)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 4096)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 6)
  img = t_put_u64(img, 4096)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, 4096)
  hold j = 0
  while j < len(code) {
    img = push(img, code[j])
    j = j + 1
  }
  img = t_zeros(img, 4096 - (176 + len(code)))
  j = 0
  while j < len(data) {
    img = push(img, data[j])
    j = j + 1
  }
  give img
}

make rv_li32_test(code: list, rd: num, v: num) -> list {
  hold u = v
  when u < 0 {
    u = u + 4294967296
  }
  hold b11 = bit_and(shr(u, 11), 1)
  hold hi20 = bit_and(shr(u + b11 * 4096, 12), 1048575)
  hold lo12 = bit_and(u, 4095)
  hold w0 = shl(hi20, 12) + shl(rd, 7) + 55
  hold w1 = shl(lo12, 20) + shl(rd, 15) + shl(rd, 7) + 27
  when bit_and(hi20, 524288) != 0 {
    w0 = 2147483648 + shl(bit_and(hi20, 524287), 12) + shl(rd, 7) + 55
  }
  when bit_and(lo12, 2048) != 0 {
    w1 = 2147483648 + shl(bit_and(lo12, 2047), 20) + shl(rd, 15) + shl(rd, 7) + 27
  }
  code = t_word(code, w0)
  code = t_word(code, w1)
  give code
}

make rv_i_test(imm: num, rs1: num, f3: num, rd: num, op: num) -> num {
  hold v = imm
  when v < 0 {
    v = v + 4096
  }
  give shl(bit_and(v, 4095), 20) + shl(rs1, 15) + shl(f3, 12) + shl(rd, 7) + op
}

make t_elf64(code: list, data: list, em: num) -> list {
  hold img = []
  img = push(img, 127)
  img = push(img, 69)
  img = push(img, 76)
  img = push(img, 70)
  img = push(img, 2)
  img = push(img, 1)
  img = push(img, 1)
  img = push(img, 0)
  img = t_zeros(img, 8)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, em)
  img = t_put_u32(img, 1)
  img = t_put_u64(img, 4194304 + 176)
  img = t_put_u64(img, 64)
  img = t_put_u64(img, 0)
  img = t_put_u32(img, 0)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 56)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 0)
  img = t_put_u16(img, 0)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 5)
  img = t_put_u64(img, 0)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 4096)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 6)
  img = t_put_u64(img, 4096)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, 4096)
  hold i = 0
  while i < len(code) {
    img = push(img, code[i])
    i = i + 1
  }
  img = t_zeros(img, 4096 - (176 + len(code)))
  i = 0
  while i < len(data) {
    img = push(img, data[i])
    i = i + 1
  }
  give img
}

make t_arm_fp_elf() -> list {
  hold code = []
  code = t_arm_mov32(code, 5, 4198400)
  code = t_word(code, 4248830113) // LDR D1,[X5]
  code = t_word(code, 4248831138) // LDR D2,[X5,#8]
  code = t_word(code, 509749283) // FADD D3,D1,D2
  code = t_word(code, 511180896) // FCVTZS W0,D3
  code = t_arm_mov32(code, 8, 93)
  code = t_word(code, 3556769793)
  hold data = []
  data = t_put_u64(data, 4609434218613702656)
  data = t_put_u64(data, 4612248968380809216)
  give t_elf64(code, data, 183)
}

make t_arm_f_elf() -> list {
  hold code = []
  code = t_arm_mov32(code, 5, 4198400)
  code = t_word(code, 3175088289) // LDR S1,[X5]
  code = t_word(code, 3175089314) // LDR S2,[X5,#4]
  code = t_word(code, 505554979) // FADD S3,S1,S2
  code = t_word(code, 506986592) // FCVTZS W0,S3
  code = t_arm_mov32(code, 8, 93)
  code = t_word(code, 3556769793)
  hold data = []
  data = t_put_u32(data, 1069547520)
  data = t_put_u32(data, 1074790400)
  give t_elf64(code, data, 183)
}

make t_rv_fp_elf() -> list {
  hold code = []
  code = rv_li32_test(code, 5, 4198400)
  code = t_word(code, rv_i_test(0, 5, 3, 1, 7))
  code = t_word(code, rv_i_test(8, 5, 3, 2, 7))
  code = t_word(code, shl(1, 25) + shl(2, 20) + shl(1, 15) + shl(3, 7) + 83)
  code = t_word(code, shl(97, 25) + shl(3, 15) + shl(1, 12) + shl(10, 7) + 83)
  code = rv_li32_test(code, 17, 93)
  code = t_word(code, 115)
  hold data = []
  data = t_put_u64(data, 4609434218613702656)
  data = t_put_u64(data, 4612248968380809216)
  give t_elf64(code, data, 243)
}

make t_rv_f_elf() -> list {
  hold code = []
  code = rv_li32_test(code, 5, 4198400)
  code = t_word(code, rv_i_test(16, 5, 2, 4, 7))
  code = t_word(code, rv_i_test(20, 5, 2, 5, 7))
  code = t_word(code, shl(5, 20) + shl(4, 15) + shl(6, 7) + 83) // FADD.S
  code = t_word(code, shl(96, 25) + shl(6, 15) + shl(1, 12) + shl(10, 7) + 83) // FCVT.W.S
  code = rv_li32_test(code, 17, 93)
  code = t_word(code, 115)
  hold data = []
  data = t_put_u64(data, 4609434218613702656)
  data = t_put_u64(data, 4612248968380809216)
  data = t_put_u32(data, 1069547520)
  data = t_put_u32(data, 1074790400)
  give t_elf64(code, data, 243)
}

make test_fp_arithmetic(dir: str) -> num {
  hold aelf = concat(dir, "/fp.arm64.elf")
  hold aself = concat(dir, "/fp32.arm64.elf")
  hold relf = concat(dir, "/fp.riscv64.elf")
  hold rfelf = concat(dir, "/fp32.riscv64.elf")
  hold astat = concat(dir, "/fp.arm64.stats")
  hold asstat = concat(dir, "/fp32.arm64.stats")
  hold rstat = concat(dir, "/fp.riscv64.stats")
  hold rfstat = concat(dir, "/fp32.riscv64.stats")
  hold a = t_arm_fp_elf()
  hold as = t_arm_f_elf()
  hold r = t_rv_fp_elf()
  hold rf = t_rv_f_elf()
  when write_bytes(aelf, a) != 1 || write_bytes(aself, as) != 1 || write_bytes(relf, r) != 1 || write_bytes(rfelf, rf) != 1 {
    hold f0 = fail_t("cannot write IEEE-754 ELF fixtures")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(astat), concat(" ", sh_q(aelf))))) != 3 {
    hold f1 = fail_t("AArch64 double add + float-to-int returned unexpected exit status")
  }
  when text_has(read_file(astat), "exit=3") != 1 {
    hold f2 = fail_t("AArch64 double arithmetic result was not 3")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --stats ", concat(sh_q(asstat), concat(" ", sh_q(aself))))) != 3 {
    hold f2a = fail_t("AArch64 single add + float-to-int returned unexpected exit status")
  }
  when text_has(read_file(asstat), "exit=3") != 1 {
    hold f2b = fail_t("AArch64 single arithmetic result was not 3")
  }
  when run_command(concat("./tools/sxisaexec --arch riscv64 --stats ", concat(sh_q(rstat), concat(" ", sh_q(relf))))) != 3 {
    hold f3 = fail_t("RV64D double add + float-to-int returned unexpected exit status")
  }
  when text_has(read_file(rstat), "exit=3") != 1 {
    hold f4 = fail_t("RV64D double arithmetic result was not 3")
  }
  when run_command(concat("./tools/sxisaexec --arch riscv64 --stats ", concat(sh_q(rfstat), concat(" ", sh_q(rfelf))))) != 3 {
    hold f5 = fail_t("RV64F single add + float-to-int returned unexpected exit status")
  }
  when text_has(read_file(rfstat), "exit=3") != 1 {
    hold f6 = fail_t("RV64F single arithmetic result was not 3")
  }
  show "[ok] IEEE-754 S/D arithmetic + integer conversion executed on AArch64 and RV64 F/D subset"
  give 0
}

make t_rv_sysfile(path1: str, path2: str, count: num) -> list {
  hold code = []
  hold path1_addr = 4198400
  hold path2_addr = 4198528
  hold buf_addr = 4198656
  code = rv_li32_test(code, 10, 0 - 100)
  code = rv_li32_test(code, 11, path1_addr)
  code = rv_li32_test(code, 12, 0)
  code = rv_li32_test(code, 17, 56)
  code = t_word(code, 115)
  code = rv_li32_test(code, 11, buf_addr)
  code = rv_li32_test(code, 12, count)
  code = rv_li32_test(code, 17, 63)
  code = t_word(code, 115)
  code = rv_li32_test(code, 10, 3)
  code = rv_li32_test(code, 17, 57)
  code = t_word(code, 115)
  code = rv_li32_test(code, 10, 0 - 100)
  code = rv_li32_test(code, 11, path2_addr)
  code = rv_li32_test(code, 12, 577)
  code = rv_li32_test(code, 13, 420)
  code = rv_li32_test(code, 17, 56)
  code = t_word(code, 115)
  code = rv_li32_test(code, 10, 3)
  code = rv_li32_test(code, 11, buf_addr)
  code = rv_li32_test(code, 12, count)
  code = rv_li32_test(code, 17, 64)
  code = t_word(code, 115)
  code = rv_li32_test(code, 10, 3)
  code = rv_li32_test(code, 17, 57)
  code = t_word(code, 115)
  code = rv_li32_test(code, 10, 0)
  code = rv_li32_test(code, 17, 93)
  code = t_word(code, 115)

  hold data = []
  hold i = 0
  while i < len(path1) {
    data = push(data, sx_index(path1, i))
    i = i + 1
  }
  data = push(data, 0)
  data = t_zeros(data, path2_addr - path1_addr - len(path1) - 1)
  i = 0
  while i < len(path2) {
    data = push(data, sx_index(path2, i))
    i = i + 1
  }
  data = push(data, 0)
  data = t_zeros(data, buf_addr - path2_addr - len(path2) - 1)
  data = t_zeros(data, count + 16)

  hold img = []
  img = push(img, 127)
  img = push(img, 69)
  img = push(img, 76)
  img = push(img, 70)
  img = push(img, 2)
  img = push(img, 1)
  img = push(img, 1)
  img = push(img, 0)
  img = t_zeros(img, 8)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, 243)
  img = t_put_u32(img, 1)
  img = t_put_u64(img, 4194304 + 176)
  img = t_put_u64(img, 64)
  img = t_put_u64(img, 0)
  img = t_put_u32(img, 0)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 56)
  img = t_put_u16(img, 2)
  img = t_put_u16(img, 64)
  img = t_put_u16(img, 0)
  img = t_put_u16(img, 0)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 5)
  img = t_put_u64(img, 0)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 4194304)
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 176 + len(code))
  img = t_put_u64(img, 4096)
  img = t_put_u32(img, 1)
  img = t_put_u32(img, 6)
  img = t_put_u64(img, 4096)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, 4198400)
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, len(data))
  img = t_put_u64(img, 4096)
  hold j = 0
  while j < len(code) {
    img = push(img, code[j])
    j = j + 1
  }
  img = t_zeros(img, 4096 - (176 + len(code)))
  j = 0
  while j < len(data) {
    img = push(img, data[j])
    j = j + 1
  }
  give img
}

make test_file_syscalls(dir: str) -> num {
  hold nl = chr(10)
  hold root = path_real(dir)
  hold source = concat(root, "/sxisaexec-file-input.txt")
  hold target = concat(root, "/sxisaexec-file-output.txt")
  hold payload = concat("cross-ISA-file-io", nl)
  hold want = concat(dir, "/sxisaexec-file-want.txt")
  hold want_stdout = concat(dir, "/sxisaexec-file-stdout-want.txt")
  when write_file(source, payload) != 1 || write_file(want, payload) != 1 || write_bytes(want_stdout, []) != 1 {
    hold f0 = fail_t("cannot prepare file syscall input/expected output")
  }
  hold rm_old = remove_path(target)
  hold a_path = concat(dir, "/fileio.arm64.elf")
  hold r_path = concat(dir, "/fileio.riscv64.elf")
  hold a_bytes = t_arm_sysfile(source, target, len(payload))
  hold r_bytes = t_rv_sysfile(source, target, len(payload))
  when write_bytes(a_path, a_bytes) != 1 || write_bytes(r_path, r_bytes) != 1 {
    hold f1 = fail_t("cannot write ELF64 file-syscall fixtures")
  }
  when run_command(concat("./tools/sxisaexec --arch arm64 --out ", concat(sh_q(concat(dir, "/fileio.arm64.stdout")), concat(" ", sh_q(a_path))))) != 0 {
    hold f2 = fail_t("AArch64 openat/read/close/write fixture failed")
  }
  hold ca = assert_files_eq(want_stdout, concat(dir, "/fileio.arm64.stdout"), "AArch64 stdout stays empty for redirected file I/O")
  when string_eq(read_file(target), payload) != 1 {
    hold f3 = fail_t("AArch64 openat/write/close did not update the host output file")
  }
  hold rm1 = remove_path(target)
  when run_command(concat("./tools/sxisaexec --arch riscv64 --out ", concat(sh_q(concat(dir, "/fileio.riscv64.stdout")), concat(" ", sh_q(r_path))))) != 0 {
    hold f4 = fail_t("RV64 openat/read/close/write fixture failed")
  }
  hold cr = assert_files_eq(want_stdout, concat(dir, "/fileio.riscv64.stdout"), "RV64 stdout stays empty for redirected file I/O")
  when string_eq(read_file(target), payload) != 1 {
    hold f5 = fail_t("RV64 openat/write/close did not update the host output file")
  }
  show "[ok] AArch64 + RV64 syscalls: openat/read/write/close and file bytes match"
  give 0
}

make test_negative_faults(dir: str) -> num {
  // Usage / flag errors -> exit 2
  hold r_noarg = run_command("./tools/sxisaexec >/dev/null 2>&1")
  hold c0 = assert_eq_num(r_noarg, 2, "sxisaexec missing args")
  hold r_badarch = run_command("./tools/sxisaexec --arch mips64 foo >/dev/null 2>&1")
  hold c1 = assert_eq_num(r_badarch, 2, "sxisaexec unknown --arch")

  // Reject ELF32 (i386) and x86-64 ELF64 (EM_X86_64 = 62) -> exit 1
  hold r_elf32 = run_command(concat("./tools/sxisaexec ", concat(sh_q(concat(dir, "/expr.i386.elf")), " >/dev/null 2>&1")))
  hold c2 = assert_eq_num(r_elf32, 1, "reject ELFCLASS32")
  hold r_x64 = run_command(concat("./tools/sxisaexec ", concat(sh_q(concat(dir, "/expr.x86_64.elf")), " >/dev/null 2>&1")))
  hold c3 = assert_eq_num(r_x64, 1, "reject EM_X86_64")

  // Reject arch mismatch (--arch arm64 on riscv64 ELF and vice versa) -> exit 1
  hold r_mm1 = run_command(concat("./tools/sxisaexec --arch arm64 ", concat(sh_q(concat(dir, "/expr.riscv64.elf")), " >/dev/null 2>&1")))
  hold c4 = assert_eq_num(r_mm1, 1, "reject riscv64 under --arch arm64")
  hold r_mm2 = run_command(concat("./tools/sxisaexec --arch riscv64 ", concat(sh_q(concat(dir, "/expr.arm64.elf")), " >/dev/null 2>&1")))
  hold c5 = assert_eq_num(r_mm2, 1, "reject arm64 under --arch riscv64")

  // Step budget fault on both arm64 and riscv64 -> exit 1
  hold r_st1 = run_command(concat("./tools/sxisaexec --max-steps 5 ", concat(sh_q(concat(dir, "/expr.arm64.elf")), " >/dev/null 2>&1")))
  hold c6 = assert_eq_num(r_st1, 1, "arm64 step-budget fault")
  hold r_st2 = run_command(concat("./tools/sxisaexec --max-steps 5 ", concat(sh_q(concat(dir, "/expr.riscv64.elf")), " >/dev/null 2>&1")))
  hold c7 = assert_eq_num(r_st2, 1, "riscv64 step-budget fault")

  // Illegal opcode fault (patch 0xFFFFFFFF at e_entry offset in file) -> exit 1
  hold ba = []
  hold na = read_bytes(concat(dir, "/expr.arm64.elf"), ba)
  hold entry_a = ba[24] + ba[25] * 256 + ba[26] * 65536 + ba[27] * 16777216
  hold foff_a = entry_a - 4194304
  ba[foff_a] = 255
  ba[foff_a + 1] = 255
  ba[foff_a + 2] = 255
  ba[foff_a + 3] = 255
  hold bad_a = concat(dir, "/bad_opcode.arm64.elf")
  when write_bytes(bad_a, ba) != 1 {
    hold fw1 = fail_t("write bad_opcode.arm64.elf")
  }
  hold r_illa = run_command(concat("./tools/sxisaexec ", concat(sh_q(bad_a), " >/dev/null 2>&1")))
  hold c8 = assert_eq_num(r_illa, 1, "arm64 illegal instruction fault")

  hold br = []
  hold nr = read_bytes(concat(dir, "/expr.riscv64.elf"), br)
  hold entry_r = br[24] + br[25] * 256 + br[26] * 65536 + br[27] * 16777216
  hold foff_r = entry_r - 4194304
  br[foff_r] = 255
  br[foff_r + 1] = 255
  br[foff_r + 2] = 255
  br[foff_r + 3] = 255
  hold bad_r = concat(dir, "/bad_opcode.riscv64.elf")
  when write_bytes(bad_r, br) != 1 {
    hold fw2 = fail_t("write bad_opcode.riscv64.elf")
  }
  hold r_illr = run_command(concat("./tools/sxisaexec ", concat(sh_q(bad_r), " >/dev/null 2>&1")))
  hold c9 = assert_eq_num(r_illr, 1, "riscv64 illegal instruction fault")

  show "[ok] sxisaexec safety & negative controls verified (bad magic/class/machine, arch mismatch, step budget, illegal opcode)"
  give 0
}

hold dir = "selfhost/seed_tests/isa_exec"
when run_command(concat("rm -rf ", concat(sh_q(dir), concat(" && mkdir -p ", sh_q(dir))))) != 0 {
  hold fd = fail_t("cannot create isa_exec workdir")
}

// Execute all 3 tracked native32 fixtures (including tracked arm64 + riscv64 goldens!) + deep multi-ISA fixture
hold v1 = verify_six_way(dir, "expr", "selfhost/native32_tests/expr.sa", "selfhost/native32_tests/golden/expr.arm64.elf", "selfhost/native32_tests/golden/expr.riscv64.elf")
hold v2 = verify_six_way(dir, "flow", "selfhost/native32_tests/flow.sa", "selfhost/native32_tests/golden/flow.arm64.elf", "selfhost/native32_tests/golden/flow.riscv64.elf")
hold v3 = verify_six_way(dir, "text", "selfhost/native32_tests/text.sa", "selfhost/native32_tests/golden/text.arm64.elf", "selfhost/native32_tests/golden/text.riscv64.elf")
hold vstr = verify_six_way(dir, "strings", "selfhost/native32_tests/strings.sa", "", "")
hold vh = test_concat_heap_limit(dir)

hold deep_sa = concat(dir, "/isa_deep.sa")
hold wd = write_deep_fixture(deep_sa)
hold v4 = verify_six_way(dir, "isa_deep", deep_sa, "", "")

hold vn = test_negative_faults(dir)
hold vf = test_file_syscalls(dir)
hold vfp = test_fp_arithmetic(dir)
show "SXISAEXEC-PARITY-OK"
