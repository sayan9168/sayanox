// Stdlib and IR acceptance gates, with Sayanox loops and byte comparisons.
use "tools/sxport_lib.sa"

make ep_known(name: str) -> num {
  when string_eq(name, "test-stdlib-next") == 1 || string_eq(name, "test-stdlib-csv") == 1 || string_eq(name, "test-stdlib-extended") == 1 || string_eq(name, "test-ir-exec") == 1 { give 1 }
  when string_eq(name, "test-stdlib-store") == 1 { give 1 }
  give 0
}

make ep_compile(kind: num, source: str, bin: str) -> num {
  when kind < 2 {
    hold c = concat(bin, ".c")
    hold emitted = pg_emit(kind, source, c, 0)
    // -lm follows the C input so both as-needed and traditional linkers work.
    hold cmd = concat(sh_quote(cc_cmd()), " -std=gnu11 -O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types -o ")
    cmd = concat(cmd, concat(sh_quote(bin), " "))
    cmd = concat(cmd, concat(sh_quote(c), " -lm"))
    give target_run(cmd, concat("compile ", source))
  }
  hold compiler = "./selfhost/native_aot"
  when kind == 3 { compiler = sxc_native_bin() }
  hold cmd = concat(sh_quote(compiler), " ")
  cmd = concat(cmd, concat(sh_quote(source), " "))
  give target_run(concat(cmd, sh_quote(bin)), concat("compile ", source))
}

make ep_has_line(file: str, line: str) -> num {
  hold text = read_file(file)
  hold i = 0
  while i < len(text) {
    hold start = i
    while i < len(text) && sx_index(text, i) != 10 { i = i + 1 }
    when string_eq(gl_slice(text, start, i), line) == 1 { give 0 }
    i = i + 1
  }
  give gl_fail(concat(file, concat(": missing exact line: ", line)))
}

make ep_snippet(source: str, want: str, base: str) -> num {
  hold sa = concat(base, ".sa")
  hold w = gl_must_write(sa, source)
  hold kind = 0
  while kind < 2 {
    hold bin = concat(base, gl_istr(kind))
    hold compile = ep_compile(kind, sa, bin)
    hold output = gl_assert_out(sh_quote(bin), want, concat(bin, ".out"))
    kind = kind + 1
  }
  give 0
}

make ep_next() -> num {
  hold dir = "selfhost/seed_tests/stdlib_next"
  hold created = gl_ensure_dir(dir)
  hold index = 0
  while index < 5 {
    hold module = "url"
    when index == 1 { module = "datetime" }
    when index == 2 { module = "hash" }
    when index == 3 { module = "text" }
    when index == 4 { module = "json_boundary" }
    hold source = concat(concat("selfhost/stdlib_", module), "_test.sa")
    hold oracle = concat(concat("selfhost/stdlib_", module), ".want")
    hold expected = bt_require_file(oracle)
    hold base = concat(concat(dir, "/"), module)
    hold kind = 0
    while kind < 3 {
      hold bin = concat(base, gl_istr(kind))
      hold c = ep_compile(kind, source, bin)
      hold r = pg_capture(sh_quote(bin), concat(bin, ".out"))
      hold a = gl_assert_files_eq(concat(bin, ".out"), oracle, concat(module, " independently computed oracle"))
      kind = kind + 1
    }
    index = index + 1
  }
  hold a = ep_snippet("use \"stdlib/url.sa\"\nshow surl_encode(\"a b\")\n", "a%20b", concat(dir, "/alone_url"))
  hold b = ep_snippet("use \"stdlib/datetime.sa\"\nshow dt_format(2024, 2, 29)\n", "2024-02-29", concat(dir, "/alone_dt"))
  hold c = ep_snippet("use \"stdlib/hash.sa\"\nshow sh_istr(sh_adler32(\"Wikipedia\"))\n", "300286872", concat(dir, "/alone_hash"))
  hold d = ep_snippet("use \"stdlib/csv.sa\"\nuse \"stdlib/url.sa\"\nuse \"stdlib/datetime.sa\"\nuse \"stdlib/hash.sa\"\nshow surl_encode(\"a b\")\nshow dt_format(2024, 2, 29)\nshow sh_sum_bytes(\"ab\")\nshow csv_count(csv_parse_row(\"x,y\"))\n", "a%20b\n2024-02-29\n195\n2", concat(dir, "/all"))

  // vNext portable stdlib: explicit results, persistent deque, lexical Windows
  // paths, and the repaired exact-decimal negative controls. These run on the
  // same three backends as the existing next-generation stdlib oracles.
  hold vnext_src = "selfhost/stdlib_vnext_test.sa"
  hold vnext_want = "selfhost/stdlib_vnext.want"
  hold vnext_present = bt_require_file(vnext_want)
  hold vkind = 0
  while vkind < 3 {
    hold vbin = concat(concat(dir, "/vnext"), gl_istr(vkind))
    hold vc = ep_compile(vkind, vnext_src, vbin)
    hold vr = pg_capture(sh_quote(vbin), concat(vbin, ".out"))
    hold va = gl_assert_files_eq(concat(vbin, ".out"), vnext_want, "stdlib vNext portable oracle")
    vkind = vkind + 1
  }
  hold dec_src = "selfhost/full_language_tests/decimal_negative_controls.sa"
  hold dec_want = "selfhost/full_language_tests/decimal_negative_controls.want"
  hold dec_present = bt_require_file(dec_want)
  hold dkind = 0
  while dkind < 3 {
    hold dbin = concat(concat(dir, "/decimal_controls"), gl_istr(dkind))
    hold dc = ep_compile(dkind, dec_src, dbin)
    hold dr = pg_capture(sh_quote(dbin), concat(dbin, ".out"))
    hold da = gl_assert_files_eq(concat(dbin, ".out"), dec_want, "decimal negative controls")
    dkind = dkind + 1
  }

  // Mature decimal surface: abs/sign/predicates/min/max/trunc/floor/ceil/mod/
  // pow/to_fixed, checked against an independent Python-Fraction oracle on the
  // same three backends. 201 exact checks plus the closing sentinel.
  hold dm_src = "selfhost/stdlib_decimal_mature_test.sa"
  hold dm_want = "selfhost/stdlib_decimal_mature.want"
  hold dm_present = bt_require_file(dm_want)
  hold mkind = 0
  while mkind < 3 {
    hold mbin = concat(concat(dir, "/decimal_mature"), gl_istr(mkind))
    hold mc = ep_compile(mkind, dm_src, mbin)
    hold mr = pg_capture(sh_quote(mbin), concat(mbin, ".out"))
    hold ma = gl_assert_files_eq(concat(mbin, ".out"), dm_want, "mature decimal independent oracle")
    mkind = mkind + 1
  }

  // Condition precedence regression: comparison mixed with and/or, user calls
  // and inline len() as operands. The vNext notes recorded a miscompile here
  // that does not reproduce on this tree; this pins the correct behaviour so a
  // future change cannot silently reintroduce it. 21 checks plus a sentinel.
  hold cp_src = "selfhost/stdlib_condition_precedence_test.sa"
  hold cp_want = "selfhost/stdlib_condition_precedence.want"
  hold cp_present = bt_require_file(cp_want)
  hold pkind = 0
  while pkind < 3 {
    hold pbin = concat(concat(dir, "/cond_precedence"), gl_istr(pkind))
    hold pc = ep_compile(pkind, cp_src, pbin)
    hold pr = pg_capture(sh_quote(pbin), concat(pbin, ".out"))
    hold pa = gl_assert_files_eq(concat(pbin, ".out"), cp_want, "condition precedence oracle")
    pkind = pkind + 1
  }

  // CSV dialects: the same RFC 4180 quoting rules with an explicit delimiter
  // byte (comma/TAB/semicolon/pipe), checked against Python's own csv module
  // on the same three backends. 473 checks plus the closing sentinel.
  hold cd_src = "selfhost/stdlib_csv_dialect_test.sa"
  hold cd_want = "selfhost/stdlib_csv_dialect.want"
  hold cd_present = bt_require_file(cd_want)
  hold ckind = 0
  while ckind < 3 {
    hold cbin = concat(concat(dir, "/csv_dialect"), gl_istr(ckind))
    hold cc = ep_compile(ckind, cd_src, cbin)
    hold cr = pg_capture(sh_quote(cbin), concat(cbin, ".out"))
    hold ca = gl_assert_files_eq(concat(cbin, ".out"), cd_want, "CSV dialect independent oracle")
    ckind = ckind + 1
  }

  // Library pack: collections, graph, checked integer math, text metrics/wrap,
  // base32, IPv4/CIDR/hostname validation, templates and exact money helpers.
  // The independent Python oracle is split by module group so each fixture stays
  // inside the bounded native_aot variable/patch limits. Every group runs on the
  // same three backends as the other portable stdlib oracles.
  hold lp_index = 0
  while lp_index < 9 {
    hold lp_name = "set"
    when lp_index == 1 { lp_name = "heap" }
    when lp_index == 2 { lp_name = "graph" }
    when lp_index == 3 { lp_name = "intmath" }
    when lp_index == 4 { lp_name = "text" }
    when lp_index == 5 { lp_name = "base32" }
    when lp_index == 6 { lp_name = "net" }
    when lp_index == 7 { lp_name = "template" }
    when lp_index == 8 { lp_name = "money" }
    hold lp_src = concat(concat("selfhost/stdlib_library_pack_", lp_name), "_test.sa")
    hold lp_want = concat(concat("selfhost/stdlib_library_pack_", lp_name), ".want")
    hold lp_present = bt_require_file(lp_want)
    hold lp_kind = 0
    while lp_kind < 3 {
      hold lp_bin = concat(concat(concat(concat(dir, "/library_pack_"), lp_name), "_"), gl_istr(lp_kind))
      hold lp_c = ep_compile(lp_kind, lp_src, lp_bin)
      hold lp_r = pg_capture(sh_quote(lp_bin), concat(lp_bin, ".out"))
      hold lp_a = gl_assert_files_eq(concat(lp_bin, ".out"), lp_want, concat(concat("library pack ", lp_name), " independent oracle"))
      lp_kind = lp_kind + 1
    }
    lp_index = lp_index + 1
  }

  // Unicode layer: strict RFC 3629 codec and code-point-aware text. The frozen
  // oracle came from Python's UTF-8 codec (maximal-subpart replacement) and the
  // Unicode White_Space set, so the expectations are independent of this code.
  hold un_index = 0
  while un_index < 2 {
    hold un_name = "utf8"
    when un_index == 1 { un_name = "utext" }
    hold un_src = concat(concat("selfhost/stdlib_", un_name), "_test.sa")
    hold un_want = concat(concat("selfhost/stdlib_", un_name), ".want")
    hold un_present = bt_require_file(un_want)
    hold un_kind = 0
    while un_kind < 3 {
      hold un_bin = concat(concat(concat(concat(dir, "/unicode_"), un_name), "_"), gl_istr(un_kind))
      hold un_c = ep_compile(un_kind, un_src, un_bin)
      hold un_r = pg_capture(sh_quote(un_bin), concat(un_bin, ".out"))
      hold un_a = gl_assert_files_eq(concat(un_bin, ".out"), un_want, concat(concat("unicode ", un_name), " independent oracle"))
      un_kind = un_kind + 1
    }
    un_index = un_index + 1
  }

  // Unicode depth: terminal display width and UAX #29 extended grapheme
  // clusters. These two oracles are large by design -- uwidth sweeps all 1114112
  // code points and ugraph runs the 766 official Unicode 17.0.0
  // GraphemeBreakTest.txt cases plus a whole-range property sweep -- so they
  // exceed the bounded native_aot profile's 64 slots. They run on seed-min, gen2
  // and the full native compiler; the compact companion below covers the same
  // rule set on native_aot as well, so no backend is blind to these modules.
  hold ud_index = 0
  while ud_index < 2 {
    hold ud_name = "uwidth"
    when ud_index == 1 { ud_name = "ugraph" }
    hold ud_src = concat(concat("selfhost/stdlib_", ud_name), "_test.sa")
    hold ud_want = concat(concat("selfhost/stdlib_", ud_name), ".want")
    hold ud_present = bt_require_file(ud_want)
    hold ud_kind = 0
    while ud_kind < 4 {
      when ud_kind != 2 {
        hold ud_bin = concat(concat(concat(concat(dir, "/udepth_"), ud_name), "_"), gl_istr(ud_kind))
        hold ud_c = ep_compile(ud_kind, ud_src, ud_bin)
        hold ud_r = pg_capture(sh_quote(ud_bin), concat(ud_bin, ".out"))
        hold ud_a = gl_assert_files_eq(concat(ud_bin, ".out"), ud_want, concat(concat("unicode depth ", ud_name), " independent oracle"))
      }
      ud_kind = ud_kind + 1
    }
    ud_index = ud_index + 1
  }

  // Canonical normalization: the depth fixture replays all 20034 official
  // NormalizationTest rows read at run time from selfhost/stdlib_unorm_cases.txt
  // and adds an API layer from the independent Python reference. It is too big
  // for native_aot, so kind 2 is skipped here and covered by the compact
  // companion below; gen1_min (kind 3) is a C backend and runs the depth
  // fixture like the other two.
  hold un_src = "selfhost/stdlib_unorm_test.sa"
  hold un_want = "selfhost/stdlib_unorm.want"
  hold un_present = bt_require_file(un_want)
  hold un_data = bt_require_file("selfhost/stdlib_unorm_cases.txt")
  hold un_kind = 0
  while un_kind < 4 {
    when un_kind != 2 {
      hold un_bin = concat(concat(dir, "/unorm_depth_"), gl_istr(un_kind))
      hold un_c = ep_compile(un_kind, un_src, un_bin)
      hold un_r = pg_capture(sh_quote(un_bin), concat(un_bin, ".out"))
      hold un_a = gl_assert_files_eq(concat(un_bin, ".out"), un_want, "canonical normalization depth oracle")
      when un_kind > 0 {
        hold un_p = gl_assert_files_eq(concat(dir, "/unorm_depth_0.out"), concat(un_bin, ".out"), "canonical normalization backend parity")
      }
    }
    un_kind = un_kind + 1
  }
  hold un_uc_src = "selfhost/stdlib_unorm_compact_test.sa"
  hold un_uc_want = "selfhost/stdlib_unorm_compact.want"
  hold un_uc_present = bt_require_file(un_uc_want)
  hold un_uc_kind = 0
  while un_uc_kind < 4 {
    hold un_uc_bin = concat(concat(dir, "/unorm_compact_"), gl_istr(un_uc_kind))
    hold un_uc_c = ep_compile(un_uc_kind, un_uc_src, un_uc_bin)
    hold un_uc_r = pg_capture(sh_quote(un_uc_bin), concat(un_uc_bin, ".out"))
    hold un_uc_a = gl_assert_files_eq(concat(un_uc_bin, ".out"), un_uc_want, "canonical normalization compact four-backend oracle")
    un_uc_kind = un_uc_kind + 1
  }

  // Streaming CSV: the same document at 1, 2, 3, 5, 7, 13, 64 and whole-byte
  // chunks must produce identical rows, against rows from Python's own csv
  // module over the same bytes. The depth fixture also pins the boundaries
  // (quoted CRLF across chunks, unterminated quote, stray quote, the 64 KiB
  // record cap, invalid delimiter) and the writer round trip. The 65 KB cap
  // record keeps it out of native_aot's bounded profile, so kind 2 is skipped
  // here and covered by the compact companion below.
  hold cs_src = "selfhost/stdlib_csv_stream_test.sa"
  hold cs_want = "selfhost/stdlib_csv_stream.want"
  hold cs_present = bt_require_file(cs_want)
  hold cs_kind = 0
  while cs_kind < 4 {
    when cs_kind != 2 {
      hold cs_bin = concat(concat(dir, "/csv_stream_"), gl_istr(cs_kind))
      hold cs_c = ep_compile(cs_kind, cs_src, cs_bin)
      hold cs_r = pg_capture(sh_quote(cs_bin), concat(cs_bin, ".out"))
      hold cs_p = gl_assert_files_eq(concat(cs_bin, ".out"), cs_want, "streaming CSV depth oracle")
      when cs_kind > 0 {
        hold cs_q = gl_assert_files_eq(concat(dir, "/csv_stream_0.out"), concat(cs_bin, ".out"), "streaming CSV backend parity")
      }
    }
    cs_kind = cs_kind + 1
  }
  hold cs_uc_src = "selfhost/stdlib_csv_stream_compact_test.sa"
  hold cs_uc_want = "selfhost/stdlib_csv_stream_compact.want"
  hold cs_uc_present = bt_require_file(cs_uc_want)
  hold cs_uc_kind = 0
  while cs_uc_kind < 4 {
    hold cs_uc_bin = concat(concat(dir, "/csv_stream_compact_"), gl_istr(cs_uc_kind))
    hold cs_uc_c = ep_compile(cs_uc_kind, cs_uc_src, cs_uc_bin)
    hold cs_uc_r = pg_capture(sh_quote(cs_uc_bin), concat(cs_uc_bin, ".out"))
    hold cs_uc_p = gl_assert_files_eq(concat(cs_uc_bin, ".out"), cs_uc_want, "streaming CSV compact four-backend oracle")
    cs_uc_kind = cs_uc_kind + 1
  }

  // Compatibility forms: the same 20034 official rows, now through NFKC and
  // NFKD, split into two payloads read at run time. The depth fixture is too
  // big for native_aot, so kind 2 is skipped here and covered by the compact
  // companion below; seed-min, gen2 and gen1_min run it.
  hold nk_src = "selfhost/stdlib_nfkc_test.sa"
  hold nk_want = "selfhost/stdlib_nfkc.want"
  hold nk_present = bt_require_file(nk_want)
  hold nk_a = bt_require_file("selfhost/stdlib_nfkc_cases_a.txt")
  hold nk_b = bt_require_file("selfhost/stdlib_nfkc_cases_b.txt")
  hold nk_kind = 0
  while nk_kind < 4 {
    when nk_kind != 2 {
      hold nk_bin = concat(concat(dir, "/nfkc_depth_"), gl_istr(nk_kind))
      hold nk_c = ep_compile(nk_kind, nk_src, nk_bin)
      hold nk_r = pg_capture(sh_quote(nk_bin), concat(nk_bin, ".out"))
      hold nk_p = gl_assert_files_eq(concat(nk_bin, ".out"), nk_want, "compatibility normalization depth oracle")
      when nk_kind > 0 {
        hold nk_q = gl_assert_files_eq(concat(dir, "/nfkc_depth_0.out"), concat(nk_bin, ".out"), "compatibility normalization backend parity")
      }
    }
    nk_kind = nk_kind + 1
  }
  hold nk_uc_src = "selfhost/stdlib_nfkc_compact_test.sa"
  hold nk_uc_want = "selfhost/stdlib_nfkc_compact.want"
  hold nk_uc_present = bt_require_file(nk_uc_want)
  hold nk_uc_kind = 0
  while nk_uc_kind < 4 {
    hold nk_uc_bin = concat(concat(dir, "/nfkc_compact_"), gl_istr(nk_uc_kind))
    hold nk_uc_c = ep_compile(nk_uc_kind, nk_uc_src, nk_uc_bin)
    hold nk_uc_r = pg_capture(sh_quote(nk_uc_bin), concat(nk_uc_bin, ".out"))
    hold nk_uc_p = gl_assert_files_eq(concat(nk_uc_bin, ".out"), nk_uc_want, "compatibility normalization compact four-backend oracle")
    nk_uc_kind = nk_uc_kind + 1
  }

  // Case conversion: the depth fixture replays one row per simple-casing group,
  // per full fold and per SpecialCasing direction from the independent Python
  // reference, plus the properties and the folding invariants. Like uwidth and
  // ugraph it exceeds the bounded native_aot profile, so kind 2 is skipped here
  // and covered by the compact companion below; seed-min, gen2 and gen1_min all
  // run it. The fixture is generator-shaped for seed-min: every list literal is
  // built from plain numeric names, and 0x literals are written in decimal.
  hold kc_src = "selfhost/stdlib_ucase_test.sa"
  hold kc_want = "selfhost/stdlib_ucase.want"
  hold kc_present = bt_require_file(kc_want)
  hold kc_kind = 0
  while kc_kind < 4 {
    when kc_kind != 2 {
      hold kc_bin = concat(concat(dir, "/ucase_depth_"), gl_istr(kc_kind))
      hold kc_c = ep_compile(kc_kind, kc_src, kc_bin)
      hold kc_r = pg_capture(sh_quote(kc_bin), concat(kc_bin, ".out"))
      hold kc_a = gl_assert_files_eq(concat(kc_bin, ".out"), kc_want, "case conversion depth oracle")
      when kc_kind > 0 {
        hold kc_p = gl_assert_files_eq(concat(dir, "/ucase_depth_0.out"), concat(kc_bin, ".out"), "case conversion backend parity")
      }
    }
    kc_kind = kc_kind + 1
  }
  hold kc_uc_src = "selfhost/stdlib_ucase_compact_test.sa"
  hold kc_uc_want = "selfhost/stdlib_ucase_compact.want"
  hold kc_uc_present = bt_require_file(kc_uc_want)
  hold kc_uc_kind = 0
  while kc_uc_kind < 4 {
    hold kc_uc_bin = concat(concat(dir, "/ucase_compact_"), gl_istr(kc_uc_kind))
    hold kc_uc_c = ep_compile(kc_uc_kind, kc_uc_src, kc_uc_bin)
    hold kc_uc_r = pg_capture(sh_quote(kc_uc_bin), concat(kc_uc_bin, ".out"))
    hold kc_uc_a = gl_assert_files_eq(concat(kc_uc_bin, ".out"), kc_uc_want, "case conversion compact four-backend oracle")
    kc_uc_kind = kc_uc_kind + 1
  }

  // Bounded-backend companion: same rules, small enough for native_aot, and it
  // runs on all four backends so the profiles are compared against one oracle.
  hold uc_src = "selfhost/stdlib_unicode_compact_test.sa"
  hold uc_want = "selfhost/stdlib_unicode_compact.want"
  hold uc_present = bt_require_file(uc_want)
  hold uc_kind = 0
  while uc_kind < 4 {
    hold uc_bin = concat(concat(dir, "/unicode_compact_"), gl_istr(uc_kind))
    hold uc_c = ep_compile(uc_kind, uc_src, uc_bin)
    hold uc_r = pg_capture(sh_quote(uc_bin), concat(uc_bin, ".out"))
    hold uc_a = gl_assert_files_eq(concat(uc_bin, ".out"), uc_want, "unicode compact four-backend oracle")
    uc_kind = uc_kind + 1
  }

  // Filesystem/process helpers need the fuller runtime. The bounded native_aot
  // and seed-min profiles are intentionally excluded; gen2 and the full native
  // compiler must agree. The worker is a Sayanox program compiled by this gate.
  hold worker = concat(dir, "/worker")
  hold wc = ep_compile(1, "selfhost/stdlib_vnext_worker.sa", worker)
  hold io_src = "selfhost/stdlib_vnext_io_test.sa"
  hold io_want = "selfhost/stdlib_vnext_io.want"
  hold io_present = bt_require_file(io_want)
  hold ik = 1
  while ik < 4 {
    when ik == 1 or ik == 3 {
      hold ibin = concat(concat(dir, "/io"), gl_istr(ik))
      hold ic = ep_compile(ik, io_src, ibin)
      hold ir = pg_capture(sh_quote(ibin), concat(ibin, ".out"))
      hold ia = gl_assert_files_eq(concat(ibin, ".out"), io_want, "stdlib vNext filesystem/process oracle")
    }
    ik = ik + 1
  }
  give 0
}

make ep_extended() -> num {
  hold dir = "selfhost/seed_tests/stdlib_ext"
  hold clean = gl_clean_dir(dir)
  hold kind = 0
  while kind < 4 {
    hold bin = concat(concat(dir, "/program"), gl_istr(kind))
    hold c = ep_compile(kind, "selfhost/stdlib_extended_test.sa", bin)
    hold run = pg_capture(sh_quote(bin), concat(bin, ".out"))
    kind = kind + 1
  }
  hold vm = concat(dir, "/vm")
  hold cmd = concat("./tools/sxirexec compile-and-run selfhost/stdlib_extended_test.sa ", sh_quote(vm))
  hold run = pg_capture(cmd, concat(dir, "/vm.out"))
  hold reference = concat(dir, "/program0.out")
  kind = 1
  while kind < 4 {
    hold out = concat(concat(concat(dir, "/program"), gl_istr(kind)), ".out")
    hold a = gl_assert_files_eq(reference, out, "stdlib extended backend parity")
    kind = kind + 1
  }
  hold a = gl_assert_files_eq(reference, concat(dir, "/vm.out"), "stdlib extended IR VM parity")
  give ep_has_line(reference, "stdlib-extended-ok")
}

make ep_ir() -> num {
  hold dir = "selfhost/seed_tests/irexec_gate"
  hold created = gl_ensure_dir(dir)
  hold i = 0
  while i < 4 {
    hold stem = "native_ir_log_test"
    when i == 1 { stem = "stdlib_growth_test" }
    when i == 2 { stem = "stdlib_crypto_test" }
    when i == 3 { stem = "stdlib_json_write_test" }
    hold source = concat(concat("selfhost/", stem), ".sa")
    hold cmd = concat("./tools/sxirexec parity ", concat(sh_quote(source), " "))
    hold run = target_run(concat(cmd, sh_quote(concat(concat(dir, "/"), stem))), "4-way IR parity")
    i = i + 1
  }
  i = 0
  while i < 5 {
    hold source = "selfhost/struct_function_tests/values.sa"
    when i == 1 { source = "selfhost/struct_function_tests/gc.sa" }
    when i == 2 { source = "selfhost/interpolation_tests/values.sa" }
    when i == 3 { source = "selfhost/interpolation_tests/gc.sa" }
    when i == 4 { source = "selfhost/generic_struct_nested.sa" }
    hold ref = concat(dir, "/ref.bin")
    hold compile = ep_compile(2, source, ref)
    hold run = pg_capture(sh_quote(ref), concat(dir, "/ref.out"))
    hold vm = concat(dir, "/vm")
    hold cmd = concat("./tools/sxirexec compile-and-run ", concat(sh_quote(source), " "))
    hold vm_run = pg_capture(concat(cmd, sh_quote(vm)), concat(dir, "/vm.out"))
    hold no_elf = gl_assert_eq_num(path_kind(concat(vm, "/prog.elf")), 0, "ELF deleted before IR VM execution")
    hold parity = gl_assert_files_eq(concat(dir, "/ref.out"), concat(dir, "/vm.out"), "native == IR VM")
    i = i + 1
  }
  give 0
}

make ep_run(name: str, built: list) -> num {
  hold baseline = rt_baseline(built)
  when string_eq(name, "test-stdlib-next") == 1 { give ep_next() }
  when string_eq(name, "test-stdlib-csv") == 1 { give ep_csv() }
  when string_eq(name, "test-stdlib-store") == 1 { give ep_store() }
  hold ir = target_native_tool("sxirexec")
  hold emitter = target_native_tool("emit_to_ir")
  when string_eq(name, "test-stdlib-extended") == 1 { give ep_extended() }
  when string_eq(name, "test-ir-exec") == 1 { give ep_ir() }
  give fail(2, "unknown parity gate")
}

make ep_csv() -> num {
  hold dir = "selfhost/seed_tests/csv_port"
  hold created = gl_ensure_dir(dir)
  hold expected = "1\n3\na\nb\nc\n0\n3\n0\nc\n1\n0\n2\n0\n2\na\n1\n2\na,b\nc\n1\na\"b\nc\n0\n0\n0\n0\n1\n1\n1\na,b,c\na,,c\n\"a,b\",c\n\"a\"\"b\",c\n\n0\n0\n1\nx\n2\na\"b\n1\n1\n0123456789abcdef\ncsv-done"
  hold kind = 0
  while kind < 3 {
    hold bin = concat(concat(dir, "/program"), gl_istr(kind))
    hold c = ep_compile(kind, "selfhost/stdlib_csv_test.sa", bin)
    hold output = gl_assert_out(sh_quote(bin), expected, concat(bin, ".out"))
    when kind > 0 {
      hold parity = gl_assert_files_eq(concat(dir, "/program0.out"), concat(bin, ".out"), "CSV byte-for-byte parity")
    }
    kind = kind + 1
  }
  hold done = ep_has_line(concat(dir, "/program0.out"), "csv-done")
  hold alone = ep_snippet("use \"stdlib/csv.sa\"\nshow csv_count(csv_parse_row(\"x,y\"))\nshow csv_is_valid_row(\"a,b\")\nshow csv_is_valid_row(concat(chr(34), \"a,b\"))\n", "2\n1\n0", concat(dir, "/alone"))
  hold coexist = ep_snippet("use \"stdlib/csv.sa\"\nuse \"stdlib/str_text.sa\"\nshow csv_at(csv_parse_row(\"p,q\"), 1)\nshow t_trim(\"  hi  \" )\n", "q\nhi", concat(dir, "/coexist"))
  give 0
}

// stdlib/store.sa and stdlib/store_index.sa: the relational store and its derived
// indexes. Every backend must reproduce the independently computed oracle byte for
// byte, and the seed, gen2 and native AOT outputs must agree with each other, so a
// silently divergent cell or key layout cannot pass by matching only the oracle.
make ep_store() -> num {
  hold dir = "selfhost/seed_tests/stdlib_store"
  hold created = gl_ensure_dir(dir)
  hold index = 0
  while index < 3 {
    hold module = "store"
    when index == 1 { module = "store_index" }
    when index == 2 { module = "store_rel" }
    hold source = concat(concat("selfhost/stdlib_", module), "_test.sa")
    hold oracle = concat(concat("selfhost/stdlib_", module), ".want")
    hold expected = bt_require_file(oracle)
    hold kind = 0
    while kind < 3 {
      hold bin = concat(concat(concat(dir, "/"), module), gl_istr(kind))
      hold c = ep_compile(kind, source, bin)
      hold r = pg_capture(sh_quote(bin), concat(bin, ".out"))
      hold a = gl_assert_files_eq(concat(bin, ".out"), oracle, concat(concat(module, " independently computed oracle (kind "), concat(gl_istr(kind), ")")))
      when kind > 0 {
        hold parity = gl_assert_files_eq(concat(concat(concat(dir, "/"), module), "0.out"), concat(bin, ".out"), concat(concat(module, " backend parity (kind "), concat(gl_istr(kind), ")")))
      }
      kind = kind + 1
    }
    index = index + 1
  }
  hold done = ep_has_line(concat(dir, "/store0.out"), "store-done")
  hold done_index = ep_has_line(concat(dir, "/store_index0.out"), "store-index-done")
  hold done_rel = ep_has_line(concat(dir, "/store_rel0.out"), "store-rel-done")
  // The modules have to survive being imported alone, without the fixture's other
  // imports, and next to unrelated modules in one program.
  hold alone = ep_snippet("use \"stdlib/store.sa\"\nhold t = db_insert(db_new(2), \"1,Ana\")\nshow db_istr(db_count(t))\nshow db_hits(db_where_n(t, \"0:=:1\"))\nshow db_get(t, db_hit(db_where(t, \"1:has:na\")), 1)\n", "1\n0\nAna", concat(dir, "/alone"))
  hold coexist = ep_snippet("use \"stdlib/store.sa\"\nuse \"stdlib/csv.sa\"\nuse \"stdlib/hash.sa\"\nhold t = db_insert(db_new(2), \"7,zed\")\nshow db_rows(db_project(t, \"0\"))\nshow csv_count(csv_parse_row(\"x,y\"))\nshow db_istr(sh_adler32(\"Wiki\"))\n", "7\n2\n64618901", concat(dir, "/coexist"))
  // The index module depends on the store, so it is checked in one program that
  // imports both, and the index answer must equal the scan answer.
  hold indexed = ep_snippet("use \"stdlib/store.sa\"\nuse \"stdlib/store_index.sa\"\nhold t = db_insert(db_insert(db_new(2), \"1,a\"), \"2,b\")\nhold ix = ix_hash_build(t, 0)\nhold ord = ix_ordered_build(t, 0)\nshow ix_rows_for(ix, t, \"2\")\nshow db_hits(db_where_n(t, \"0:=:2\"))\nshow ix_range(ord, t, \">=\", \"2\")\nshow ix_summary(ix)\n", "1\n1\n1\nkind=1 keys=2", concat(dir, "/alone_index"))
  // The relational module needs the store, and its join/group answers must agree
  // with the single-table reads they replace.
  hold rel = ep_snippet("use \"stdlib/store.sa\"\nuse \"stdlib/store_rel.sa\"\nhold t = db_insert(db_insert(db_new(2), \"1,a\"), \"2,b\")\nhold u = db_insert(db_insert(db_new(2), \"a,x\"), \"b,y\")\nshow db_rows(sr_join(t, 1, u, 0))\nshow db_rows(sr_group_count(t, 1))\nshow db_istr(sr_same_rows(t, t))\n", "1,a,a,x\n2,b,b,y\na,1\nb,1\n1", concat(dir, "/alone_rel"))
  give 0
}
