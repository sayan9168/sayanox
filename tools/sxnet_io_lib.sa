make ns_client_memory() -> num { give 9030 }
make ns_fail(msg: str) -> num {
  hold write = write_file("/dev/stderr", concat("sxnet: ", concat(msg, "\n")))
  hold status = exit(1)
  give 0
}
make ns_slice(s: str, start: num, end: num) -> str {
  hold out = ""
  hold i = start
  while i < end { out = concat(out, chr(sx_index(s, i)))
    i = i + 1 }
  give out
}
make ns_find(s: str, needle: str) -> num {
  hold i = 0
  while i + len(needle) <= len(s) {
    when string_eq(ns_slice(s, i, i + len(needle)), needle) == 1 { give i }
    i = i + 1
  }
  give 0 - 1
}
make ns_dec(n: num) -> str {
  when n == 0 { give "0" }
  hold out = ""
  hold v = n
  while v > 0 { hold digit = v % 10
    v = (v - digit) / 10
    out = concat(chr(48 + digit), out) }
  give out
}
make ns_hex(n: num, width: num) -> str {
  hold digits = "0123456789abcdef"
  hold value = n
  hold out = ""
  hold i = 0
  while i < width { hold digit = value % 16
    value = (value - digit) / 16
    out = concat(chr(sx_index(digits, digit)), out)
    i = i + 1 }
  when value != 0 { hold fail = ns_fail("hex frame overflow") }
  give out
}
make ns_number(hex: str) -> num {
  when len(hex) == 0 || len(hex) > 8 { hold fail = ns_fail("missing/invalid hexadecimal handshake") }
  hold i = 0
  hold n = 0
  while i < len(hex) {
    hold c = sx_index(hex, i)
    hold digit = c - 48
    when c >= 97 && c <= 102 { digit = c - 87 }
    when (c < 48 || c > 57) && (c < 97 || c > 102) { hold fail = ns_fail("invalid handshake digit") }
    n = n * 16 + digit
    i = i + 1
  }
  give n
}
make ns_put(b: list, at: num, v: num, count: num) -> num {
  hold value = v
  hold i = 0
  while i < count { hold byte = value % 256
    b[at + i] = byte
    value = (value - byte) / 256
    i = i + 1 }
  give 0
}
make ns_emit(file: str, client: num) -> num {
  hold b = []
  hold i = 0
  while i < 128 { b = push(b, 0)
    i = i + 1 }
  hold code = ns_server_bytes()
  hold memory = ns_server_memory()
  when client == 1 { code = ns_client_bytes()
    memory = ns_client_memory() }
  i = 0
  while i < len(code) { b = push(b, code[i])
    i = i + 1 }
  b[0] = 127
  b[1] = 69
  b[2] = 76
  b[3] = 70
  b[4] = 2
  b[5] = 1
  b[6] = 1
  hold type = ns_put(b, 16, 2, 2)
  hold machine = ns_put(b, 18, 62, 2)
  hold version = ns_put(b, 20, 1, 4)
  hold entry = ns_put(b, 24, 4194432, 8)
  hold phoff = ns_put(b, 32, 64, 8)
  hold ehsize = ns_put(b, 52, 64, 2)
  hold phsize = ns_put(b, 54, 56, 2)
  hold phcount = ns_put(b, 56, 1, 2)
  hold load = ns_put(b, 64, 1, 4)
  hold flags = ns_put(b, 68, 7, 4)
  hold addr = ns_put(b, 80, 4194304, 8)
  hold paddr = ns_put(b, 88, 4194304, 8)
  hold filesz = ns_put(b, 96, len(b), 8)
  hold memsz = ns_put(b, 104, memory, 8)
  hold align = ns_put(b, 112, 4096, 8)
  when write_bytes(file, b) != 1 { give ns_fail("cannot publish socket binding") }
  // All callers supply a validated workspace filename without shell syntax.
  when ns_find(file, "'") >= 0 || ns_find(file, "\n") >= 0 { give ns_fail("unsafe socket binding filename") }
  give run_command(concat("chmod 0700 '", concat(file, "'")))
}
make ns_send(h: num, text: str) -> num {
  when len(text) > 8192 { give ns_fail("socket frame exceeds 8192 bytes") }
  hold frame = concat("W", concat(ns_hex(len(text), 8), concat("\n", text)))
  hold sent = child_send(h, frame)
  when string_eq(child_line(h), "OK") == 0 { give ns_fail("socket write failed") }
  give 0
}
make ns_recv(h: num) -> str {
  hold ask = child_send(h, "R\n")
  hold n = ns_number(child_line(h))
  when n > 8192 { hold fail = ns_fail("invalid socket read frame size") }
  when n == 0 { give "" }
  hold text = child_recv(h, n)
  when len(text) != n { hold fail = ns_fail("short socket read frame") }
  give text
}
make ns_rm_tree(path: str) -> num {
  when path_kind(path) == 2 {
    hold names = read_dir(path)
    hold pos = 0
    while pos < len(names) {
      hold start = pos
      while pos < len(names) && sx_index(names, pos) != 10 { pos = pos + 1 }
      hold name = ns_slice(names, start, pos)
      pos = pos + 1
      when len(name) > 0 { hold remove = ns_rm_tree(concat(path, concat("/", name))) }
    }
  }
  when path_kind(path) != 0 && remove_path(path) != 1 { give ns_fail("cannot clean fixture directory") }
  give 0
}
make ns_clean(path: str) -> num {
  hold remove = ns_rm_tree(path)
  when make_dir(path) != 1 { give ns_fail("cannot create fixture directory") }
  give 0
}
make ns_decimal(s: str) -> num {
  hold n = 0
  hold i = 0
  while i < len(s) {
    hold c = sx_index(s, i)
    when c == 10 { give n }
    when c < 48 || c > 57 { hold bad = ns_fail("invalid decimal process handle") }
    n = n * 10 + c - 48
    i = i + 1
  }
  give n
}
