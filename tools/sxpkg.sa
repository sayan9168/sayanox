// Local Sayanox package-lock utility.
//
// Sayanox owns local init/add/list/remove, registry seed/search/info, and the
// file side of sync/install/publish/fetch: publish, install-local, the
// local-registry branches of sync and fetch, and ensure-dir/rm-tree/copy-tree
// so the wrapper never calls mkdir, cp, grep, cut, tr or rm itself.  What stays
// in the shell entrypoint is only what Sayanox cannot do yet: reading the
// environment, and launching curl/wget for an http(s) transfer.
//
// Offline package convention (docs/REGISTRY.md): a package is a directory
// .sayanox/registry/<name>/ with main.sa and pkg.meta; pkg.meta carries
// name=, version=, desc= and sum= (pkgsum of main.sa). `verify` checks every
// sx.lock entry against its registry copy. Nothing here touches the network.

// pkgsum: checksum of a file's bytes, h = (h * 31 + byte) mod 1000000007.
// It detects accidental edits to a locked package; it is not a security hash.
make pkgsum(s: str) -> num {
  hold h = 0
  hold i = 0
  while i < len(s) {
    hold t = h * 31 + sx_index(s, i)
    hold h = t % 1000000007
    hold i = i + 1
  }
  give h
}

// decstr: decimal text of a whole number. numstr would round to 6 digits.
make decstr(n: num) -> str {
  when n == 0 {
    give "0"
  }
  hold s = ""
  hold m = n
  while m > 0 {
    // `%` is taken on its own line: gen2 copies a `%` inside a builtin call
    // argument as raw C (documented in docs/STATUS.md, divergences)
    hold r = m % 10
    hold s = concat(chr(48 + r), s)
    hold m = (m - r) / 10
  }
  give s
}

// pkgfield: the value of `key=...` on its own line of a pkg.meta text ("" if absent)
make pkgfield(text: str, key: str) -> str {
  hold n = len(text)
  hold kl = len(key)
  hold p = 0
  hold bol = 1
  while p < n {
    when bol == 1 {
      hold ok = 1
      hold j = 0
      while j < kl {
        when p + j >= n {
          hold ok = 0
          hold j = kl
        } otherwise {
          when sx_index(text, p + j) != sx_index(key, j) {
            hold ok = 0
            hold j = kl
          } otherwise {
            hold j = j + 1
          }
        }
      }
      when ok == 1 && p + kl < n && sx_index(text, p + kl) == 61 {
        hold v = ""
        hold q = p + kl + 1
        while q < n && sx_index(text, q) != 10 {
          hold v = concat(v, chr(sx_index(text, q)))
          hold q = q + 1
        }
        give v
      }
    }
    hold bol = 0
    when sx_index(text, p) == 10 {
      hold bol = 1
    }
    hold p = p + 1
  }
  give ""
}

// line_key / line_val: split one `key=value` lock line at its first `=`
make line_key(line: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(line) {
    when sx_index(line, i) == 61 {
      give out
    }
    hold out = concat(out, chr(sx_index(line, i)))
    hold i = i + 1
  }
  give out
}

make line_val(line: str) -> str {
  hold i = 0
  while i < len(line) && sx_index(line, i) != 61 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(line) {
    hold out = concat(out, chr(sx_index(line, j)))
    hold j = j + 1
  }
  give out
}

// Portable package path component, shared by wrapper preflight.
make package_name_ok(value: str) -> num {
  when len(value) == 0 || string_eq(value, "name") || string_eq(value, "version") {
    give 0
  }
  hold i = 0
  while i < len(value) {
    hold c = sx_index(value, i)
    hold good = 0
    when c >= 48 && c <= 57 {
      good = 1
    }
    when c >= 65 && c <= 90 {
      good = 1
    }
    when c >= 97 && c <= 122 {
      good = 1
    }
    when c == 45 || c == 95 {
      good = 1
    }
    when good == 0 {
      give 0
    }
    i = i + 1
  }
  give 1
}

// check_pkg: "" when the registry copy of NAME matches the lock VERSION and its
// pkg.meta sum; otherwise the reason it does not.
make check_pkg(name: str, version: str) -> str {
  hold meta = read_file(concat(".sayanox/registry/", concat(name, "/pkg.meta")))
  when len(meta) == 0 {
    give "no registry copy (.sayanox/registry/<name>/pkg.meta is missing)"
  }
  hold mver = pkgfield(meta, "version")
  when string_eq(mver, version) == 0 {
    give concat("locked at ", concat(version, concat(" but the registry has ", mver)))
  }
  hold src = read_file(concat(".sayanox/registry/", concat(name, "/main.sa")))
  hold want = pkgfield(meta, "sum")
  hold got = decstr(pkgsum(src))
  when string_eq(want, got) == 0 {
    give concat("main.sa sums to ", concat(got, concat(" but pkg.meta says ", want)))
  }
  give ""
}

// ---- dependency resolution ----------------------------------------------
// A dependency is written `name@version` in pkg.meta's `deps=` line, and the
// version is an exact pin: there are no ranges.  Resolution walks sx.lock and
// each package's `deps=`, offline, from the local registry copy only.
//
// Lists of specs are plain `|`-delimited strings, "a@1|b@2|": take_field reads
// the first entry, drop_field removes it, has_field tests membership.

// dep_name / dep_ver: the two halves of one `name@version` spec
make dep_name(spec: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(spec) {
    when sx_index(spec, i) == 64 {
      give out
    }
    hold out = concat(out, chr(sx_index(spec, i)))
    hold i = i + 1
  }
  give out
}

make dep_ver(spec: str) -> str {
  hold i = 0
  while i < len(spec) && sx_index(spec, i) != 64 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(spec) {
    hold out = concat(out, chr(sx_index(spec, j)))
    hold j = j + 1
  }
  give out
}

// take_field: the first `|`-delimited entry of a spec list
make take_field(list: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      give out
    }
    hold out = concat(out, chr(sx_index(list, i)))
    hold i = i + 1
  }
  give out
}

// drop_field: the same list without its first entry
make drop_field(list: str) -> str {
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      hold out = ""
      hold j = i + 1
      while j < len(list) {
        hold out = concat(out, chr(sx_index(list, j)))
        hold j = j + 1
      }
      give out
    }
    hold i = i + 1
  }
  give ""
}

// has_field: 1 when the spec list already contains this exact entry
make has_field(list: str, x: str) -> num {
  hold n = len(list)
  hold m = len(x)
  hold i = 0
  while i + m + 1 <= n {
    hold ok = 1
    when i > 0 {
      when sx_index(list, i - 1) != 124 {
        hold ok = 0
      }
    }
    when ok == 1 {
      hold j = 0
      while j < m {
        when sx_index(list, i + j) != sx_index(x, j) {
          hold ok = 0
          hold j = m
        } otherwise {
          hold j = j + 1
        }
      }
      when ok == 1 {
        when sx_index(list, i + m) == 124 {
          give 1
        }
      }
    }
    hold i = i + 1
  }
  give 0
}

// split_deps: the `deps=` value "a@1,b@2" as a spec list "a@1|b@2|"
make split_deps(text: str) -> str {
  hold out = ""
  hold n = len(text)
  hold cur = ""
  hold i = 0
  while i <= n {
    hold c = 0
    when i < n {
      hold c = sx_index(text, i)
    }
    when c == 44 || i == n {
      when len(cur) > 0 {
        hold out = concat(out, concat(cur, "|"))
      }
      hold cur = ""
    } otherwise {
      hold cur = concat(cur, chr(c))
    }
    hold i = i + 1
  }
  give out
}

// meta_deps: a pkg.meta's dependencies as a spec list ("" when it has none)
make meta_deps(meta: str) -> str {
  give split_deps(pkgfield(meta, "deps"))
}

// ---- what the shell entrypoint used to do with grep, cut, tr, cp, mkdir ----
// Sayanox has make_dir/path_kind/read_dir/remove_path, so folder creation,
// folder deletion, recursive copies and a `key = ...` manifest read are all
// expressible here.  The wrapper keeps only the network transport and the
// opt-in policy, because Sayanox has no getenv and spawn takes a path with no
// argv.
//
// Note for anyone editing this file: the compiler's signature pre-pass does not
// understand // comments, so a comment with an odd number of double quotes
// silently turns the rest of the file into a string literal and every later
// `make` loses its typed parameter list.  Keep quotes in comments balanced.

// toml_field: the value of a `key = ...` line of a manifest, quotes and spaces
// removed.  The line must START with the key, exactly as the shell pipeline
// `grep '^key' | cut -d= -f2- | tr -d ...` required; the result is empty when
// there is no such line.
make toml_field(text: str, key: str) -> str {
  hold n = len(text)
  hold kl = len(key)
  hold p = 0
  hold bol = 1
  while p < n {
    when bol == 1 {
      hold ok = 1
      hold j = 0
      while j < kl {
        when p + j >= n {
          hold ok = 0
          hold j = kl
        } otherwise {
          when sx_index(text, p + j) != sx_index(key, j) {
            hold ok = 0
            hold j = kl
          } otherwise {
            hold j = j + 1
          }
        }
      }
      when ok == 1 {
        // the line runs from p+kl up to the next newline (or the end)
        hold eol = p + kl
        hold eolstop = 0
        while eolstop == 0 {
          when eol >= n {
            hold eolstop = 1
          } otherwise {
            when sx_index(text, eol) == 10 {
              hold eolstop = 1
            } otherwise {
              hold eol = eol + 1
            }
          }
        }
        // the value starts after the first '=' on that line, or at the key's
        // end when the line has no '=' at all (what cut would have returned)
        hold eq = p + kl
        hold vs = p + kl
        hold eqstop = 0
        while eqstop == 0 {
          when eq >= eol {
            hold eqstop = 1
          } otherwise {
            when sx_index(text, eq) == 61 {
              hold vs = eq + 1
              hold eqstop = 1
            } otherwise {
              hold eq = eq + 1
            }
          }
        }
        hold v = ""
        hold r = vs
        while r < eol {
          hold ch = sx_index(text, r)
          when ch != 34 && ch != 32 {
            hold v = concat(v, chr(ch))
          }
          hold r = r + 1
        }
        give v
      }
      hold bol = 0
    }
    when sx_index(text, p) == 10 {
      hold bol = 1
    }
    hold p = p + 1
  }
  give ""
}

// strip_file_scheme: a registry URL without its "file://" prefix, so
// `SAYANOX_REGISTRY=file:///reg` and `sxpkg sync-local /reg` are one code path.
make strip_file_scheme(p: str) -> str {
  hold scheme = "file://"
  hold n = len(p)
  when n > 7 {
    hold i = 0
    hold ok = 1
    while i < 7 {
      when sx_index(p, i) != sx_index(scheme, i) {
        hold ok = 0
      }
      hold i = i + 1
    }
    when ok == 1 {
      hold out = ""
      hold j = 7
      while j < n {
        hold out = concat(out, chr(sx_index(p, j)))
        hold j = j + 1
      }
      give out
    }
  }
  give p
}

// ensure_dir: `mkdir -p PATH`.  make_dir creates one level and reports failure
// when the directory already exists, so every prefix is attempted and an
// existing directory is accepted rather than treated as an error.
make ensure_dir(path: str) -> num {
  hold ok = 1
  hold cur = ""
  hold i = 0
  hold n = len(path)
  while i < n {
    hold c = sx_index(path, i)
    when c == 47 {
      when len(cur) > 0 {
        hold made = make_dir(cur)
        when made == 0 {
          when path_kind(cur) != 2 {
            hold ok = 0
          }
        }
      }
    }
    hold cur = concat(cur, chr(c))
    hold i = i + 1
  }
  when len(cur) > 0 {
    hold made = make_dir(cur)
    when made == 0 {
      when path_kind(cur) != 2 {
        hold ok = 0
      }
    }
  }
  give ok
}

// rm_tree: `rm -rf PATH`.  read_dir lists a directory and remove_path unlinks a
// file or rmdirs an empty one, so the walk is depth-first and a missing path is
// already a success.
make rm_tree(path: str) -> num {
  hold kind = path_kind(path)
  when kind == 0 {
    give 1
  }
  when kind == 2 {
    hold names = read_dir(path)
    hold n = len(names)
    hold i = 0
    hold one = ""
    hold ok = 1
    while i < n {
      hold c = sx_index(names, i)
      when c == 10 {
        when len(one) > 0 {
          hold child = concat(concat(path, "/"), one)
          when rm_tree(child) == 0 {
            hold ok = 0
          }
        }
        hold one = ""
      } otherwise {
        hold one = concat(one, chr(c))
      }
      hold i = i + 1
    }
    when len(one) > 0 {
      hold child = concat(concat(path, "/"), one)
      when rm_tree(child) == 0 {
        hold ok = 0
      }
    }
    when remove_path(path) == 0 {
      hold ok = 0
    }
    give ok
  }
  give remove_path(path)
}

// copy_tree: `cp -r SRC/. DST/` -- every entry of SRC read and written into
// DST, creating DST first.  Directories recurse; everything else is a
// read_file/write_file pair.
make copy_tree(src: str, dst: str) -> num {
  hold ok = ensure_dir(dst)
  hold names = read_dir(src)
  hold n = len(names)
  hold i = 0
  hold one = ""
  while i < n {
    hold c = sx_index(names, i)
    when c == 10 {
      when len(one) > 0 {
        hold from = concat(concat(src, "/"), one)
        hold to = concat(concat(dst, "/"), one)
        when path_kind(from) == 2 {
          when copy_tree(from, to) == 0 {
            hold ok = 0
          }
        } otherwise {
          when write_file(to, read_file(from)) == 0 {
            hold ok = 0
          }
        }
      }
      hold one = ""
    } otherwise {
      hold one = concat(one, chr(c))
    }
    hold i = i + 1
  }
  when len(one) > 0 {
    hold from = concat(concat(src, "/"), one)
    hold to = concat(concat(dst, "/"), one)
    when path_kind(from) == 2 {
      when copy_tree(from, to) == 0 {
        hold ok = 0
      }
    } otherwise {
      when write_file(to, read_file(from)) == 0 {
        hold ok = 0
      }
    }
  }
  give ok
}

// lock_ver: the version sx.lock pins NAME to, "" when it is not locked
make lock_ver(lock: str, lock_len: num, want: str) -> str {
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      when string_eq(k, want) == 1 {
        give line_val(lline)
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give ""
}

// lock_specs: the locked packages as a spec list "name@version|..."
make lock_specs(lock: str, lock_len: num) -> str {
  hold out = ""
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      hold v = line_val(lline)
      hold skip = 0
      when len(k) == 0 {
        hold skip = 1
      }
      when len(lline) == len(k) {
        hold skip = 1
      }
      when string_eq(k, "version") == 1 {
        hold skip = 1
      }
      when string_eq(k, "name") == 1 {
        hold skip = 1
      }
      when len(lline) > 0 {
        when sx_index(lline, 0) == 35 {
          hold skip = 1
        }
      }
      when skip == 0 {
        hold out = concat(out, concat(k, concat("@", concat(v, "|"))))
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give out
}

// tail1: everything after the first byte (used to drop the "!" error marker)
make tail1(s: str) -> str {
  hold out = ""
  hold i = 1
  while i < len(s) {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// read_meta: a package's pkg.meta from the project's registry copy, falling
// back to the source registry directory.  A separate function because an
// inner `hold` would shadow the outer one instead of replacing it.
make read_meta(nm: str, src: str) -> str {
  hold meta = read_file(concat(".sayanox/registry/", concat(nm, "/pkg.meta")))
  when len(meta) == 0 && len(src) > 0 {
    give read_file(concat(concat(src, "/"), concat(nm, "/pkg.meta")))
  }
  give meta
}

// discover: NAME@VERSION plus every package its (and their) `deps=` lines
// declare, read from the project's registry copy or the source registry.
// A package whose pkg.meta is nowhere to be found is returned on its own:
// it has not been installed yet, so its dependencies are still unknown.
make discover(spec: str, src: str) -> str {
  hold nm = dep_name(spec)
  hold meta = read_meta(nm, src)
  hold out = concat(spec, "|")
  when len(meta) > 0 {
    hold dl = meta_deps(meta)
    while len(dl) > 0 {
      hold d = take_field(dl)
      hold dl = drop_field(dl)
      when has_field(out, d) == 0 {
        hold sub = discover(d, src)
        hold sl = sub
        while len(sl) > 0 {
          hold one = take_field(sl)
          hold sl = drop_field(sl)
          when has_field(out, one) == 0 {
            hold out = concat(out, concat(one, "|"))
          }
        }
      }
    }
  }
  give out
}

// resolve: the transitive dependency closure of the locked packages.
// Gives a spec list "name@version|..." on success, or "!" + the reason it
// could not be resolved.  Every step reads the local registry copy only.
make resolve(lock: str, src: str, lock_len: num) -> str {
  hold out = ""
  hold queue = lock_specs(lock, lock_len)
  hold guard = 0
  while len(queue) > 0 && guard < 64 {
    hold spec = take_field(queue)
    hold queue = drop_field(queue)
    hold guard = guard + 1
    when has_field(out, spec) == 0 {
      hold out = concat(out, concat(spec, "|"))
      hold nm = dep_name(spec)
      hold vr = dep_ver(spec)
      hold meta = read_meta(nm, src)
      when len(meta) == 0 {
        give concat("!", concat(nm, " has no registry copy; run: sxpkg install"))
      }
      hold mver = pkgfield(meta, "version")
      when string_eq(mver, vr) == 0 {
        give concat("!", concat(nm, concat(" is wanted at ", concat(vr, concat(" but the registry has ", mver)))))
      }
      hold dl = meta_deps(meta)
      while len(dl) > 0 {
        hold d = take_field(dl)
        hold dl = drop_field(dl)
        hold dn = dep_name(d)
        hold dv = dep_ver(d)
        hold lv = lock_ver(lock, lock_len, dn)
        when len(lv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" which is not in sx.lock; run: sxpkg add ", concat(dn, concat(" ", dv)))))))))
        }
        when string_eq(lv, dv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" but sx.lock has ", lv)))))))
        }
        hold queue = concat(queue, concat(d, "|"))
      }
    }
  }
  give out
}

hold argn = arg_count()
hold command = "help"
hold name = ""
hold version = "0.1.0"
when argn >= 2 {
  hold command = arg(1)
}
when argn >= 3 {
  hold name = arg(2)
}
when argn >= 4 {
  hold version = arg(3)
}

// Shared state is declared at the top level because the maintained compiler
// emits C blocks for when/while scopes.
hold handled = 0
hold is_init = string_eq(command, "init")
hold is_add = string_eq(command, "add")
hold is_list = string_eq(command, "list")
hold is_remove = string_eq(command, "remove")
hold is_search = string_eq(command, "search")
hold is_info = string_eq(command, "info")
hold is_seed = string_eq(command, "seed")
hold is_verify = string_eq(command, "verify")
hold is_sum = string_eq(command, "sum")
hold is_deps = string_eq(command, "deps")
hold is_install = string_eq(command, "install")
hold src = "registry"
hold query = ""
when argn >= 3 {
  hold query = arg(2)
}
hold lock_path = "sx.lock"
hold manifest_path = "sx.toml"
hold registry_path = ".sayanox/registry"
hold index_path = ".sayanox/registry/INDEX"
hold meta_path = ""
hold index = ""
hold lock = ""
hold manifest = ""
hold result = ""
hold line = ""
hold key = ""
hold lock_len = 0
hold key_len = 0
hold pos = 0
hold c = 0
hold lc = 0
hold j = 0
hold parse_key = 0
hold same = 0
hold replaced = 0
hold removed = 0
hold has_packages = 0
hold found = 0
hold is_comment = 0
hold is_version = 0
hold is_name = 0
hold is_empty = 0
hold line_len = 0
hold first_byte = 0
hold value = ""
hold value_len = 0
hold query_len = 0
hold index_len = 0
hold after_eq = 0
hold match_pos = 0
hold qpos = 0
hold equal = 1
hold scan_match = 0
hold key_byte = 0
hold query_byte = 0
hold name_len = 0
hold invalid = 0
hold reserved = 0
hold last_byte = 0
hold write_status = 0
hold all_ok = 1
// dependency / install state: declared here because the maintained
// compiler emits C blocks for when/while scopes.
hold vres = ""
hold vrest = ""
hold vspec = ""
hold vdn = ""
hold vdv = ""
hold vdlv = ""
hold vwhy = ""
hold ddres = ""
hold ddrest = ""
hold ddspec = ""
hold ddout = ""
hold ddn = 0
hold dires = ""
hold direst = ""
hold dispec = ""
hold diproblems = 0
hold dinm = ""
hold divr = ""
hold diwhy = ""
hold dismeta = ""
hold disver = ""
hold dissa = ""
hold diswant = ""
hold disgot = ""
hold diw1 = 0
hold diw2 = 0
hold pkg_path = ".sayanox/pkgs"
hold is_publish = string_eq(command, "publish")
hold is_install_local = string_eq(command, "install-local")
hold is_sync_local = string_eq(command, "sync-local")
hold is_fetch_local = string_eq(command, "fetch-local")
hold is_ensure_dir = string_eq(command, "ensure-dir")
hold is_rm_tree = string_eq(command, "rm-tree")
hold is_copy_tree = string_eq(command, "copy-tree")

when is_init == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    hold write_status = write_file(lock_path, "# sx.lock\nversion=1\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  hold manifest = read_file(manifest_path)
  hold lock_len = len(manifest)
  when lock_len == 0 {
    hold write_status = write_file(manifest_path, "name = \"my-pkg\"\nversion = \"0.1.0\"\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  when all_ok == 1 {
    show "sxpkg: init ok"
  } otherwise {
    show "sxpkg: init failed to write project files"
  }
}

when string_eq(command, "check-name") {
  hold handled = 1
  when package_name_ok(name) {
    show "sxpkg: package name ok"
  } otherwise {
    show "sxpkg: FAILED invalid or reserved package name (use letters, digits, hyphen, underscore)"
  }
}

when is_add == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg add <name> [version]"
  } otherwise {
    hold invalid = 1 - package_name_ok(name)
    when invalid == 1 {
      show "sxpkg: FAILED invalid or reserved package name"
    } otherwise {
      hold lock = read_file(lock_path)
      hold lock_len = len(lock)
      when lock_len == 0 {
        hold lock = "# sx.lock\nversion=1\n"
      }
      hold lock_len = len(lock)
      when lock_len > 0 {
        hold last_byte = sx_idx(lock, lock_len - 1)
        when last_byte != 10 {
          hold lock = concat(lock, "\n")
        }
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold replaced = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            when replaced == 0 {
              hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
              hold replaced = 1
            }
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when replaced == 0 {
        hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
      }
      // pull in what the package declares in `deps=`, transitively, so
      // `deps` and `install` see a complete set.  Packages that are not
      // installed or present anywhere yet contribute nothing here.
      hold dlist = discover(concat(name, concat("@", version)), src)
      hold drest = dlist
      while len(drest) > 0 {
        hold done = take_field(drest)
        hold drest = drop_field(drest)
        hold adn = dep_name(done)
        hold adv = dep_ver(done)
        hold alv = lock_ver(result, len(result), adn)
        when len(alv) == 0 {
          hold result = concat(result, concat(adn, concat("=", concat(adv, "\n"))))
          show concat(concat("sxpkg: locked ", concat(adn, concat(" ", adv))), concat(" (dependency of ", concat(name, ")")))
        }
      }
      hold write_status = write_file(lock_path, result)
      when write_status == 1 {
        show concat("sxpkg: locked ", concat(name, concat(" ", version)))
      } otherwise {
        show "sxpkg: failed to write sx.lock"
      }
    }
  }
}

when is_list == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold result = "sxpkg: locked packages"
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < lock_len {
      hold c = sx_idx(lock, pos)
      when c == 10 {
        hold key = ""
        hold key_len = len(line)
        hold j = 0
        hold parse_key = 1
        while parse_key == 1 {
          when j < key_len {
            hold lc = sx_idx(line, j)
            when lc == 61 {
              hold parse_key = 0
            } otherwise {
              hold key = concat(key, chr(lc))
              hold j = j + 1
            }
          } otherwise {
            hold parse_key = 0
          }
        }
        hold is_version = string_eq(key, "version")
        hold is_name = string_eq(key, "name")
        hold is_empty = string_eq(line, "")
        hold is_comment = 0
        hold line_len = len(line)
        when line_len > 0 {
          hold first_byte = sx_idx(line, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        when is_version == 0 && is_name == 0 && is_empty == 0 && is_comment == 0 {
          hold result = concat(result, concat("\n", line))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n(none)")
    }
    show result
  }
}

when is_search == 1 {
  hold handled = 1
  hold index = read_file(index_path)
  hold index_len = len(index)
  when index_len == 0 {
    show "sxpkg: no registry index; run sync or seed"
  } otherwise {
    hold last_byte = sx_idx(index, index_len - 1)
    when last_byte != 10 {
      hold index = concat(index, "\n")
    }
    hold index_len = len(index)
    hold query_len = len(query)
    hold result = concat("sxpkg: search ", query)
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < index_len {
      hold c = sx_idx(index, pos)
      when c == 10 {
        hold key = ""
        hold value = ""
        hold after_eq = 0
        hold line_len = len(line)
        hold j = 0
        while j < line_len {
          hold lc = sx_idx(line, j)
          when lc == 61 {
            hold after_eq = 1
          } otherwise {
            when after_eq == 1 {
              hold value = concat(value, chr(lc))
            } otherwise {
              hold key = concat(key, chr(lc))
            }
          }
          hold j = j + 1
        }
        hold key_len = len(key)
        hold same = string_eq(key, "version")
        hold is_version = same
        hold same = string_eq(key, "name")
        hold is_name = same
        hold is_empty = string_eq(key, "")
        hold is_comment = 0
        when key_len > 0 {
          hold first_byte = sx_idx(key, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        hold found = 0
        when query_len == 0 {
          hold found = 1
        } otherwise {
          hold match_pos = 0
          hold scan_match = 1
          while scan_match == 1 {
            when match_pos + query_len <= key_len {
              hold equal = 1
              hold qpos = 0
              while qpos < query_len && equal == 1 {
                hold key_byte = sx_idx(key, match_pos + qpos)
                hold query_byte = sx_idx(query, qpos)
                when key_byte != query_byte {
                  hold equal = 0
                }
                hold qpos = qpos + 1
              }
              when equal == 1 {
                hold found = 1
                hold scan_match = 0
              } otherwise {
                hold match_pos = match_pos + 1
              }
            } otherwise {
              hold scan_match = 0
            }
          }
        }
        when found == 1 && is_version == 0 && is_name == 0 && is_comment == 0 && is_empty == 0 {
          hold result = concat(result, concat("\n  ", concat(key, concat(" ", value))))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n  (no matches)")
    }
    show result
  }
}

when is_info == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg info <name>"
  } otherwise {
    hold meta_path = concat(concat(registry_path, "/"), concat(name, "/pkg.meta"))
    hold manifest = read_file(meta_path)
    hold lock_len = len(manifest)
    when lock_len == 0 {
      show concat("unknown ", concat(name, " - try: sxpkg sync and search"))
    } otherwise {
      show manifest
    }
  }
}

// sync-local: refresh the local registry from another local registry directory
// (`SAYANOX_REGISTRY=file:///reg` or a plain path).  The INDEX is only written
// after every name in it has passed package_name_ok, so a hostile index can
// neither escape the registry nor destroy the one already installed.  The
// wrapper keeps the http(s) branch, which needs curl or wget.
when is_sync_local == 1 {
  hold handled = 1
  hold syurl = arg(2)
  hold sydir = strip_file_scheme(syurl)
  hold sycode = 0
  hold syok = ensure_dir(registry_path)
  show concat("sxpkg: sync from ", syurl)
  hold syidx = read_file(concat(concat(sydir, "/"), "INDEX"))
  when len(syidx) == 0 {
    show "sxpkg: sync failed; using local seed"
    hold is_seed = 1
  } otherwise {
    hold syrest = lock_specs(syidx, len(syidx))
    hold sybad = 0
    while len(syrest) > 0 {
      hold syone = take_field(syrest)
      hold syrest = drop_field(syrest)
      hold synm = dep_name(syone)
      when package_name_ok(synm) == 0 {
        show concat("sxpkg: refusing unsafe package name '", concat(synm, "'"))
        hold sybad = 1
      }
    }
    when sybad == 1 {
      show "sxpkg: rejected index with unsafe package name"
      hold sycode = exit(1)
    } otherwise {
      hold syw0 = write_file(index_path, syidx)
      when syw0 == 0 {
        show "sxpkg: FAILED writing the registry index"
        hold sycode = exit(1)
      } otherwise {
        show "sxpkg: index updated"
        hold syrest2 = lock_specs(syidx, len(syidx))
        while len(syrest2) > 0 {
          hold syone2 = take_field(syrest2)
          hold syrest2 = drop_field(syrest2)
          hold synm2 = dep_name(syone2)
          hold syvr2 = dep_ver(syone2)
          hold syok2 = ensure_dir(concat(concat(registry_path, "/"), synm2))
          hold symeta = read_file(concat(concat(concat(sydir, "/"), synm2), "/pkg.meta"))
          when len(symeta) > 0 {
            hold syw1 = write_file(concat(concat(concat(registry_path, "/"), synm2), "/pkg.meta"), symeta)
            when syw1 == 0 {
              hold syok2 = 0
            }
          }
          hold symain = read_file(concat(concat(concat(sydir, "/"), synm2), "/main.sa"))
          when len(symain) > 0 {
            hold syw2 = write_file(concat(concat(concat(registry_path, "/"), synm2), "/main.sa"), symain)
            when syw2 == 0 {
              hold syok2 = 0
            }
          }
          when syok2 == 1 {
            show concat("  synced ", concat(synm2, concat("=", syvr2)))
          } otherwise {
            show concat("sxpkg: FAILED syncing ", synm2)
            hold sycode = exit(1)
          }
        }
      }
    }
  }
}

when is_seed == 1 {
  hold handled = 1
  hold all_ok = 1
  // the seed packages live in their own folders; the wrapper used to mkdir them
  hold seed_d1 = ensure_dir(concat(concat(registry_path, "/"), "hello"))
  hold seed_d2 = ensure_dir(concat(concat(registry_path, "/"), "math"))
  when seed_d1 == 0 || seed_d2 == 0 {
    hold all_ok = 0
  }
  hold hello_src = "show \"hello from pkg\"\n"
  hold math_src = "make dbl(n) {\n  give n + n\n}\nmake sqr(n) {\n  give n * n\n}\n"
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/main.sa"), hello_src)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/pkg.meta"), concat("name=hello\nversion=0.1.0\ndesc=hello world sample\nsum=", concat(decstr(pkgsum(hello_src)), "\n")))
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/main.sa"), math_src)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/pkg.meta"), concat("name=math\nversion=0.1.0\ndesc=tiny math helpers (dbl, sqr)\nsum=", concat(decstr(pkgsum(math_src)), "\n")))
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(index_path, "hello=0.1.0\nmath=0.1.0\n")
  when write_status == 0 { hold all_ok = 0 }
  when all_ok == 1 {
    show "sxpkg: local registry seeded"
  } otherwise {
    show "sxpkg: seed failed; run the wrapper to create registry folders"
  }
}

when is_remove == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg remove <name>"
  } otherwise {
    hold lock = read_file(lock_path)
    hold lock_len = len(lock)
    when lock_len == 0 {
      show "sxpkg: no sx.lock"
    } otherwise {
      hold last_byte = sx_idx(lock, lock_len - 1)
      when last_byte != 10 {
        hold lock = concat(lock, "\n")
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold removed = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            hold removed = 1
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when removed == 1 {
        hold write_status = write_file(lock_path, result)
        when write_status == 1 {
          show concat("sxpkg: removed ", name)
        } otherwise {
          show "sxpkg: failed to write sx.lock"
        }
      } otherwise {
        show concat("sxpkg: not locked: ", name)
      }
    }
  }
}

// sum <file>: the checksum `pkgsum` gives a file (used when writing pkg.meta)
when is_sum == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg sum <file>"
  } otherwise {
    hold src = read_file(name)
    when len(src) == 0 {
      show concat("sxpkg: cannot read ", name)
    } otherwise {
      show concat("sxpkg: sum ", concat(decstr(pkgsum(src)), concat(" ", name)))
    }
  }
}

// verify: every sx.lock entry must match its registry copy (version and sum)
when is_verify == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_index(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold checked = 0
    hold problems = 0
    hold pos = 0
    hold line = ""
    while pos < lock_len {
      hold c = sx_index(lock, pos)
      when c == 10 {
        hold vkey = line_key(line)
        hold vval = line_val(line)
        hold vlen = len(line)
        when vlen > 0 && sx_index(line, 0) != 35 && string_eq(vkey, "version") == 0 && string_eq(vkey, "name") == 0 {
          when len(vkey) == 0 || len(vval) == 0 || len(line) == len(vkey) {
            hold problems = problems + 1
            show concat("sxpkg: MISMATCH malformed lock line: ", line)
          } otherwise {
            hold checked = checked + 1
            hold why = check_pkg(vkey, vval)
            when len(why) == 0 {
              show concat("sxpkg: verified ", concat(vkey, concat(" ", vval)))
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vkey, concat(": ", why)))
            }
          }
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    // the dependency closure: every package a locked package declares in
    // `deps=` must itself be present, and only the ones pulled in
    // transitively (not already counted above) are reported here.
    hold vres = resolve(lock, "", lock_len)
    when len(vres) > 0 {
      when sx_index(vres, 0) == 33 {
        hold problems = problems + 1
        show concat("sxpkg: DEP ", tail1(vres))
      } otherwise {
        hold vrest = vres
        while len(vrest) > 0 {
          hold vspec = take_field(vrest)
          hold vrest = drop_field(vrest)
          hold vdn = dep_name(vspec)
          hold vdv = dep_ver(vspec)
          hold vdlv = lock_ver(lock, lock_len, vdn)
          when len(vdlv) == 0 {
            hold checked = checked + 1
            hold vwhy = check_pkg(vdn, vdv)
            when len(vwhy) == 0 {
              show concat("sxpkg: verified ", concat(vdn, concat(" ", vdv)))
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vdn, concat(": ", vwhy)))
            }
          }
        }
      }
    }
    when problems == 0 {
      show concat("sxpkg: verify ok (", concat(numstr(checked), " locked packages)"))
    } otherwise {
      show concat("sxpkg: verify FAILED (", concat(numstr(problems), " problem(s))"))
    }
  }
}

// deps: the transitive dependency closure of the locked packages, resolved
// offline from the local registry copies.
when is_deps == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold ddres = resolve(lock, src, lock_len)
    when sx_index(ddres, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(ddres))
    } otherwise {
      hold ddout = "sxpkg: dependency closure"
      hold ddrest = ddres
      hold ddn = 0
      while len(ddrest) > 0 {
        hold ddspec = take_field(ddrest)
        hold ddrest = drop_field(ddrest)
        hold ddn = ddn + 1
        hold ddout = concat(ddout, concat("\n  ", concat(dep_name(ddspec), concat(" ", dep_ver(ddspec)))))
      }
      when ddn == 0 {
        hold ddout = concat(ddout, "\n  (none)")
      }
      show ddout
    }
  }
}

// install-local: the offline install.  It preflights every locked name, creates
// .sayanox/registry/<name>/ and .sayanox/pkgs/<name>/ for each of them, and
// then runs the install logic against a local registry directory.  The wrapper
// used to do the mkdir loop itself and then call `install`; this is one
// delegation that exits non-zero when the lock cannot be resolved.
when is_install_local == 1 {
  hold handled = 1
  hold illock = read_file(lock_path)
  hold ilcode = 0
  when len(illock) == 0 {
    show "sxpkg: no sx.lock - run init/add"
    hold ilcode = exit(1)
  } otherwise {
    hold illast = sx_idx(illock, len(illock) - 1)
    when illast != 10 {
      hold illock = concat(illock, "\n")
    }
    hold ilspecs = lock_specs(illock, len(illock))
    hold ilrest = ilspecs
    hold ilbad = 0
    while len(ilrest) > 0 {
      hold ilone = take_field(ilrest)
      hold ilrest = drop_field(ilrest)
      hold ilnm = dep_name(ilone)
      when package_name_ok(ilnm) == 0 {
        show concat("sxpkg: refusing unsafe package name '", concat(ilnm, "'"))
        hold ilbad = 1
      }
    }
    when ilbad == 1 {
      hold ilcode = exit(1)
    } otherwise {
      // the default source registry is ./registry, exactly as the wrapper
      // documented; arg(2) is empty when none was given
      hold ilsrc = "registry"
      when len(arg(2)) > 0 {
        hold ilsrc = arg(2)
      }
      hold ilrest2 = ilspecs
      while len(ilrest2) > 0 {
        hold ilone2 = take_field(ilrest2)
        hold ilrest2 = drop_field(ilrest2)
        hold ilnm2 = dep_name(ilone2)
        hold ilm1 = ensure_dir(concat(concat(registry_path, "/"), ilnm2))
        hold ilm2 = ensure_dir(concat(concat(pkg_path, "/"), ilnm2))
        when ilm1 == 0 || ilm2 == 0 {
          show concat("sxpkg: FAILED creating folders for ", ilnm2)
          hold ilcode = exit(1)
        }
      }
      hold src = ilsrc
      hold is_install = 1
    }
  }
}

// install: copy every locked package (and its closure) from a local registry
// directory into the project's .sayanox/registry/, checking the version and
// the content sum on both sides.  Offline: it reads files, never the network.
// The default source registry is ./registry; the wrapper `sxpkg.sh install`
// creates the destination folders first and then runs this.
when is_install == 1 {
  hold handled = 1
  when argn >= 3 {
    hold src = arg(2)
  }
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
    hold diproblems = 1
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold dires = resolve(lock, src, lock_len)
    when sx_index(dires, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(dires))
      hold diproblems = 1
    } otherwise {
      hold diproblems = 0
      hold direst = dires
      while len(direst) > 0 {
        hold dispec = take_field(direst)
        hold direst = drop_field(direst)
        hold dinm = dep_name(dispec)
        hold divr = dep_ver(dispec)
        hold diwhy = check_pkg(dinm, divr)
        when len(diwhy) == 0 {
          show concat("sxpkg: ok ", concat(dinm, concat(" ", divr)))
        } otherwise {
          hold dismeta = read_file(concat(concat(src, "/"), concat(dinm, "/pkg.meta")))
          when len(dismeta) == 0 {
            show concat("sxpkg: MISSING ", concat(dinm, concat(": the source registry has no ", concat(src, concat("/", concat(dinm, "/pkg.meta"))))))
            hold diproblems = diproblems + 1
          } otherwise {
            hold disver = pkgfield(dismeta, "version")
            when string_eq(disver, divr) == 0 {
              show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source registry has ", concat(disver, concat(" but sx.lock wants ", divr)))))
              hold diproblems = diproblems + 1
            } otherwise {
              hold dissa = read_file(concat(concat(src, "/"), concat(dinm, "/main.sa")))
              hold diswant = pkgfield(dismeta, "sum")
              hold disgot = decstr(pkgsum(dissa))
              when string_eq(diswant, disgot) == 0 {
                show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source main.sa sums to ", concat(disgot, concat(" but its pkg.meta says ", diswant)))))
                hold diproblems = diproblems + 1
              } otherwise {
                hold diw1 = write_file(concat(".sayanox/registry/", concat(dinm, "/pkg.meta")), dismeta)
                hold diw2 = write_file(concat(".sayanox/registry/", concat(dinm, "/main.sa")), dissa)
                when diw1 == 1 && diw2 == 1 {
                  show concat("sxpkg: installed ", concat(dinm, concat(" ", divr)))
                } otherwise {
                  show concat("sxpkg: MISSING ", concat(dinm, concat(": cannot write .sayanox/registry/", concat(dinm, "/; run sh tools/sxpkg.sh install-local to create the folders"))))
                  hold diproblems = diproblems + 1
                }
              }
            }
          }
        }
      }
      when diproblems == 0 {
        show "sxpkg: install ok"
      } otherwise {
        show concat("sxpkg: install FAILED (", concat(numstr(diproblems), " problem(s))"))
      }
    }
  }
}

// install-local reports through the exit status as well: it is the wrapper's
// delegation, and `test-sxpkg-polish` requires it to exit non-zero when the
// lock cannot be resolved.  A bare `install` deliberately does NOT do this --
// `test-pkgs` pins that it prints its FAILED report and exits 0, which is what
// the wrapper's `checked` has always keyed on.
when is_install_local == 1 {
  when diproblems > 0 {
    hold install_code = exit(1)
  }
}

// ensure-dir / rm-tree / copy-tree: the wrapper's folder and copy primitives.
// Silent on success so they compose inside a shell command; a failure prints
// one line and exits non-zero.
when is_ensure_dir == 1 {
  hold handled = 1
  hold edpath = arg(2)
  hold edcode = 0
  when ensure_dir(edpath) == 1 {
    hold edcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED creating ", edpath)
    hold edcode = exit(1)
  }
}

when is_rm_tree == 1 {
  hold handled = 1
  hold rtpath = arg(2)
  hold rtcode = 0
  when rm_tree(rtpath) == 1 {
    hold rtcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED removing ", rtpath)
    hold rtcode = exit(1)
  }
}

when is_copy_tree == 1 {
  hold handled = 1
  hold ctsrc = arg(2)
  hold ctdst = arg(3)
  hold ctcode = 0
  when copy_tree(ctsrc, ctdst) == 1 {
    hold ctcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED copying ", concat(ctsrc, concat(" into ", ctdst)))
    hold ctcode = exit(1)
  }
}

// publish: write this project's package into the local registry so another
// project can install-local it.  name/version come from sx.toml, the content
// sum is recorded in pkg.meta exactly like the registry seed writes it, and the
// INDEX gains `name=version` unless it is already there.  publish never
// uploads: going online is a commit to the repository registry, which is a
// review step and not a client command.
when is_publish == 1 {
  hold handled = 1
  hold pubmanifest = read_file(manifest_path)
  hold pubname = toml_field(pubmanifest, "name")
  when len(pubname) == 0 {
    hold pubname = "local"
  }
  hold pubver = toml_field(pubmanifest, "version")
  when len(pubver) == 0 {
    hold pubver = "0.1.0"
  }
  hold pubdir = concat(concat(registry_path, "/"), pubname)
  hold pubcode = 0
  hold pubok = ensure_dir(pubdir)
  hold pubmeta = concat(concat(concat("name=", pubname), concat("\nversion=", pubver)), "\n")
  when path_kind("main.sa") == 1 {
    hold pubw1 = write_file(concat(concat(pubdir, "/"), "main.sa"), read_file("main.sa"))
    when pubw1 == 0 {
      hold pubok = 0
    }
  }
  hold pubcopied = concat(concat(pubdir, "/"), "main.sa")
  when path_kind(pubcopied) == 1 {
    hold pubmeta = concat(pubmeta, concat("sum=", concat(decstr(pkgsum(read_file(pubcopied))), "\n")))
  }
  hold pubw2 = write_file(concat(concat(pubdir, "/"), "pkg.meta"), pubmeta)
  when pubw2 == 0 {
    hold pubok = 0
  }
  hold pubidx = read_file(index_path)
  hold pubhas = 0
  hold publine = ""
  hold pubpos = 0
  hold publen = len(pubidx)
  while pubpos < publen {
    hold pubc = sx_index(pubidx, pubpos)
    when pubc == 10 {
      hold pubkey = ""
      hold pubklen = len(publine)
      hold pubj = 0
      hold pubgo = 1
      while pubgo == 1 {
        when pubj < pubklen {
          hold publc = sx_index(publine, pubj)
          when publc == 61 {
            hold pubgo = 0
          } otherwise {
            hold pubkey = concat(pubkey, chr(publc))
            hold pubj = pubj + 1
          }
        } otherwise {
          hold pubgo = 0
        }
      }
      when string_eq(pubkey, pubname) == 1 {
        hold pubhas = 1
      }
      hold publine = ""
    } otherwise {
      hold publine = concat(publine, chr(pubc))
    }
    hold pubpos = pubpos + 1
  }
  when pubhas == 0 {
    hold pubw3 = write_file(index_path, concat(pubidx, concat(concat(pubname, "="), concat(pubver, "\n"))))
    when pubw3 == 0 {
      hold pubok = 0
    }
  }
  when pubok == 1 {
    show concat("sxpkg: published locally ", concat(pubname, concat(" ", pubver)))
    show concat("sxpkg: to go online, commit ", concat(pubdir, " to the sayanox repo"))
  } otherwise {
    show concat("sxpkg: FAILED publishing ", pubname)
    hold pubcode = exit(1)
  }
}

// fetch-local: the file:// and plain-path branch of `fetch`.  It refuses an
// existing cache, project copy or pinned lock, records the content sum in
// pkg.meta and in sx.lock, and rolls the whole thing back if any write fails.
// The wrapper's http(s) branch keeps curl or wget plus its mktemp staging.
when is_fetch_local == 1 {
  hold handled = 1
  hold flsrc = arg(2)
  hold flname = arg(3)
  when len(flname) == 0 {
    hold flname = "remote_pkg"
  }
  hold fldisp = arg(4)
  when len(fldisp) == 0 {
    hold fldisp = flsrc
  }
  hold flcode = 0
  when package_name_ok(flname) == 0 {
    show concat("sxpkg: FAILED invalid fetch name '", concat(flname, "'"))
    hold flcode = exit(1)
  } otherwise {
    hold fltext = read_file(flsrc)
    when len(fltext) == 0 {
      show concat("sxpkg: FAILED fetching ", concat(fldisp, ": no package file there"))
      hold flcode = exit(1)
    } otherwise {
      hold flreg = concat(concat(registry_path, "/"), flname)
      hold flpkg = concat(concat(pkg_path, "/"), flname)
      hold flhas = 0
      when path_kind(flreg) != 0 {
        hold flhas = 1
      }
      when path_kind(flpkg) != 0 {
        hold flhas = 1
      }
      hold fllock = read_file(lock_path)
      hold fllen = len(fllock)
      hold flpos = 0
      hold flline = ""
      while flpos < fllen {
        hold flc = sx_index(fllock, flpos)
        when flc == 10 {
          hold flk = ""
          hold flj = 0
          hold flgo = 1
          while flgo == 1 {
            when flj < len(flline) {
              hold flc2 = sx_index(flline, flj)
              when flc2 == 61 {
                hold flgo = 0
              } otherwise {
                hold flk = concat(flk, chr(flc2))
                hold flj = flj + 1
              }
            } otherwise {
              hold flgo = 0
            }
          }
          when string_eq(flk, flname) == 1 {
            hold flhas = 1
          }
          hold flline = ""
        } otherwise {
          hold flline = concat(flline, chr(flc))
        }
        hold flpos = flpos + 1
      }
      when flhas == 1 {
        show concat("sxpkg: fetch refuses existing package/lock '", concat(flname, "'"))
        hold flcode = exit(1)
      } otherwise {
        hold flsum = decstr(pkgsum(fltext))
        hold flmeta = concat(concat(concat(concat("name=", flname), "\nversion=0.0.0\n"), "sum="), concat(flsum, "\n"))
        hold flok = ensure_dir(registry_path)
        when ensure_dir(pkg_path) == 0 {
          hold flok = 0
        }
        when ensure_dir(flreg) == 0 {
          hold flok = 0
        }
        when ensure_dir(flpkg) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flreg, "/"), "main.sa"), fltext) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flreg, "/"), "pkg.meta"), flmeta) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flpkg, "/"), "main.sa"), fltext) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flpkg, "/"), "pkg.meta"), flmeta) == 0 {
          hold flok = 0
        }
        // An extra leading newline also covers a lock with no final newline.
        hold flnewlock = concat(fllock, concat(concat("\n", flname), "=0.0.0\n"))
        when write_file(lock_path, flnewlock) == 0 {
          hold flok = 0
        }
        when flok == 0 {
          hold flr1 = rm_tree(flreg)
          hold flr2 = rm_tree(flpkg)
          hold flr3 = write_file(lock_path, fllock)
          when flr1 == 0 || flr2 == 0 || flr3 == 0 {
            show "sxpkg: rollback incomplete; inspect .sayanox/registry and .sayanox/pkgs"
          }
          show concat("sxpkg: FAILED fetching ", fldisp)
          hold flcode = exit(1)
        } otherwise {
          show concat("sxpkg: fetched ", concat(flname, concat(" from ", concat(fldisp, " (checksum recorded; not authenticated)"))))
        }
      }
    }
  }
}


// check-lock [file]: preflight every name in a lock or an index before any
// path is built from it.  This is the loop `tools/sxpkg.sh preflight_names`
// used to run in the shell, spawning one `check-name` child per line.  A file
// with no final newline is handled the same way the wrapper's `read` loop was.
when string_eq(command, "check-lock") {
  hold handled = 1
  hold clpath = lock_path
  when len(arg(2)) > 0 {
    hold clpath = arg(2)
  }
  hold cltext = read_file(clpath)
  when len(cltext) > 0 {
    when sx_idx(cltext, len(cltext) - 1) != 10 {
      hold cltext = concat(cltext, "\n")
    }
  }
  hold clrest = lock_specs(cltext, len(cltext))
  hold clbad = 0
  while len(clrest) > 0 {
    hold clone = take_field(clrest)
    hold clrest = drop_field(clrest)
    hold clnm = dep_name(clone)
    when package_name_ok(clnm) == 0 {
      show concat("sxpkg: refusing unsafe package name '", concat(clnm, "'"))
      hold clbad = 1
    }
  }
  when clbad == 1 {
    hold clcode = exit(1)
  }
}

// need-fetch: the locked packages whose registry copy is incomplete, one name
// per line.  A package counts as present only when both pkg.meta and main.sa
// are there: an empty directory left by a failed download is not a copy.
when string_eq(command, "need-fetch") {
  hold handled = 1
  hold nftext = read_file(lock_path)
  when len(nftext) > 0 {
    when sx_idx(nftext, len(nftext) - 1) != 10 {
      hold nftext = concat(nftext, "\n")
    }
  }
  hold nfrest = lock_specs(nftext, len(nftext))
  while len(nfrest) > 0 {
    hold nfone = take_field(nfrest)
    hold nfrest = drop_field(nfrest)
    hold nfnm = dep_name(nfone)
    // An unsafe name is never reported, so a caller cannot fetch or mkdir from
    // one.  `check-lock` is the command that refuses; this one stays silent.
    when package_name_ok(nfnm) == 1 {
      hold nfm = path_kind(concat(concat(concat(registry_path, "/"), nfnm), "/pkg.meta"))
      hold nfs = path_kind(concat(concat(concat(registry_path, "/"), nfnm), "/main.sa"))
      when nfm != 1 || nfs != 1 {
        show nfnm
      }
    }
  }
}

// install-cached [pkgdir]: copy every locked package that already has a
// complete registry copy into pkgdir, and report the ones that do not.  This
// is the offline half of `tools/sxpkg.sh install`, which used to walk the lock
// itself; the shell now only fetches what `need-fetch` named.
when string_eq(command, "install-cached") {
  hold handled = 1
  hold icdir = pkg_path
  when len(arg(2)) > 0 {
    hold icdir = arg(2)
  }
  hold ictext = read_file(lock_path)
  when len(ictext) > 0 {
    when sx_idx(ictext, len(ictext) - 1) != 10 {
      hold ictext = concat(ictext, "\n")
    }
  }
  hold icrest = lock_specs(ictext, len(ictext))
  hold icbad = 0
  while len(icrest) > 0 {
    hold icone = take_field(icrest)
    hold icrest = drop_field(icrest)
    hold icnm = dep_name(icone)
    when package_name_ok(icnm) == 0 {
      show concat("sxpkg: refusing unsafe package name '", concat(icnm, "'"))
      hold icbad = 1
    } otherwise {
      hold icm = path_kind(concat(concat(concat(registry_path, "/"), icnm), "/pkg.meta"))
      hold ics = path_kind(concat(concat(concat(registry_path, "/"), icnm), "/main.sa"))
      when icm != 1 || ics != 1 {
        show concat("sxpkg: missing ", concat(icnm, " in registry"))
      } otherwise {
        hold icreg = concat(concat(registry_path, "/"), icnm)
        hold icdst = concat(concat(icdir, "/"), icnm)
        hold icd = ensure_dir(icdst)
        hold icc = copy_tree(icreg, icdst)
        when icd == 0 || icc == 0 {
          show concat("sxpkg: FAILED installing ", icnm)
          hold icbad = 1
        } otherwise {
          show concat("sxpkg: installed ", concat(icnm, concat(" -> ", icdst)))
        }
      }
    }
  }
  when icbad == 1 {
    hold iccode = exit(1)
  }
}

when handled == 0 {
  show "sxpkg: local commands: init | add <name> [version] | list | remove <name> | seed | search | info | deps | install [registry] | install-local [registry] | verify | sum <file> | publish"
  show "sxpkg: the wrapper keeps http(s) transfers (curl or wget) and the online opt-in policy"
}
