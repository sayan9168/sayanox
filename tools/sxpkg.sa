// Local Sayanox package-lock utility.
//
// Sayanox owns local init/add/list/remove plus registry seed/search/info.
// sync/install/publish/fetch still need directory/process/network APIs and
// remain in the shell entrypoint.
//
// Offline package convention (docs/REGISTRY.md): a package is a directory
// .sayanox/registry/<name>/ with main.sa and pkg.meta; pkg.meta carries
// name=, version=, desc= and sum= (pkgsum of main.sa). `verify` checks every
// sx.lock entry against its registry copy. Nothing here touches the network.

// pkgsum: checksum of a file's bytes, h = (h * 31 + byte) mod 1000000007.
// It detects accidental edits to a locked package; it is not a security hash.
make pkgsum(s: str) -> num {
  hold h = 0
  hold i = 0
  while i < len(s) {
    hold t = h * 31 + sx_index(s, i)
    hold h = t % 1000000007
    hold i = i + 1
  }
  give h
}

// decstr: decimal text of a whole number. numstr would round to 6 digits.
make decstr(n: num) -> str {
  when n == 0 {
    give "0"
  }
  hold s = ""
  hold m = n
  while m > 0 {
    // `%` is taken on its own line: gen2 copies a `%` inside a builtin call
    // argument as raw C (documented in docs/STATUS.md, divergences)
    hold r = m % 10
    hold s = concat(chr(48 + r), s)
    hold m = (m - r) / 10
  }
  give s
}

// pkgfield: the value of `key=...` on its own line of a pkg.meta text ("" if absent)
make pkgfield(text: str, key: str) -> str {
  hold n = len(text)
  hold kl = len(key)
  hold p = 0
  hold bol = 1
  while p < n {
    when bol == 1 {
      hold ok = 1
      hold j = 0
      while j < kl {
        when p + j >= n {
          hold ok = 0
          hold j = kl
        } otherwise {
          when sx_index(text, p + j) != sx_index(key, j) {
            hold ok = 0
            hold j = kl
          } otherwise {
            hold j = j + 1
          }
        }
      }
      when ok == 1 && p + kl < n && sx_index(text, p + kl) == 61 {
        hold v = ""
        hold q = p + kl + 1
        while q < n && sx_index(text, q) != 10 {
          hold v = concat(v, chr(sx_index(text, q)))
          hold q = q + 1
        }
        give v
      }
    }
    hold bol = 0
    when sx_index(text, p) == 10 {
      hold bol = 1
    }
    hold p = p + 1
  }
  give ""
}

// line_key / line_val: split one `key=value` lock line at its first `=`
make line_key(line: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(line) {
    when sx_index(line, i) == 61 {
      give out
    }
    hold out = concat(out, chr(sx_index(line, i)))
    hold i = i + 1
  }
  give out
}

make line_val(line: str) -> str {
  hold i = 0
  while i < len(line) && sx_index(line, i) != 61 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(line) {
    hold out = concat(out, chr(sx_index(line, j)))
    hold j = j + 1
  }
  give out
}

// check_pkg: "" when the registry copy of NAME matches the lock VERSION and its
// pkg.meta sum; otherwise the reason it does not.
make check_pkg(name: str, version: str) -> str {
  hold meta = read_file(concat(".sayanox/registry/", concat(name, "/pkg.meta")))
  when len(meta) == 0 {
    give "no registry copy (.sayanox/registry/<name>/pkg.meta is missing)"
  }
  hold mver = pkgfield(meta, "version")
  when string_eq(mver, version) == 0 {
    give concat("locked at ", concat(version, concat(" but the registry has ", mver)))
  }
  hold src = read_file(concat(".sayanox/registry/", concat(name, "/main.sa")))
  hold want = pkgfield(meta, "sum")
  hold got = decstr(pkgsum(src))
  when string_eq(want, got) == 0 {
    give concat("main.sa sums to ", concat(got, concat(" but pkg.meta says ", want)))
  }
  give ""
}

// ---- dependency resolution ----------------------------------------------
// A dependency is written `name@version` in pkg.meta's `deps=` line, and the
// version is an exact pin: there are no ranges.  Resolution walks sx.lock and
// each package's `deps=`, offline, from the local registry copy only.
//
// Lists of specs are plain `|`-delimited strings, "a@1|b@2|": take_field reads
// the first entry, drop_field removes it, has_field tests membership.

// dep_name / dep_ver: the two halves of one `name@version` spec
make dep_name(spec: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(spec) {
    when sx_index(spec, i) == 64 {
      give out
    }
    hold out = concat(out, chr(sx_index(spec, i)))
    hold i = i + 1
  }
  give out
}

make dep_ver(spec: str) -> str {
  hold i = 0
  while i < len(spec) && sx_index(spec, i) != 64 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(spec) {
    hold out = concat(out, chr(sx_index(spec, j)))
    hold j = j + 1
  }
  give out
}

// take_field: the first `|`-delimited entry of a spec list
make take_field(list: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      give out
    }
    hold out = concat(out, chr(sx_index(list, i)))
    hold i = i + 1
  }
  give out
}

// drop_field: the same list without its first entry
make drop_field(list: str) -> str {
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      hold out = ""
      hold j = i + 1
      while j < len(list) {
        hold out = concat(out, chr(sx_index(list, j)))
        hold j = j + 1
      }
      give out
    }
    hold i = i + 1
  }
  give ""
}

// has_field: 1 when the spec list already contains this exact entry
make has_field(list: str, x: str) -> num {
  hold n = len(list)
  hold m = len(x)
  hold i = 0
  while i + m + 1 <= n {
    hold ok = 1
    when i > 0 {
      when sx_index(list, i - 1) != 124 {
        hold ok = 0
      }
    }
    when ok == 1 {
      hold j = 0
      while j < m {
        when sx_index(list, i + j) != sx_index(x, j) {
          hold ok = 0
          hold j = m
        } otherwise {
          hold j = j + 1
        }
      }
      when ok == 1 {
        when sx_index(list, i + m) == 124 {
          give 1
        }
      }
    }
    hold i = i + 1
  }
  give 0
}

// split_deps: the `deps=` value "a@1,b@2" as a spec list "a@1|b@2|"
make split_deps(text: str) -> str {
  hold out = ""
  hold n = len(text)
  hold cur = ""
  hold i = 0
  while i <= n {
    hold c = 0
    when i < n {
      hold c = sx_index(text, i)
    }
    when c == 44 || i == n {
      when len(cur) > 0 {
        hold out = concat(out, concat(cur, "|"))
      }
      hold cur = ""
    } otherwise {
      hold cur = concat(cur, chr(c))
    }
    hold i = i + 1
  }
  give out
}

// meta_deps: a pkg.meta's dependencies as a spec list ("" when it has none)
make meta_deps(meta: str) -> str {
  give split_deps(pkgfield(meta, "deps"))
}

// lock_ver: the version sx.lock pins NAME to, "" when it is not locked
make lock_ver(lock: str, lock_len: num, want: str) -> str {
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      when string_eq(k, want) == 1 {
        give line_val(lline)
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give ""
}

// lock_specs: the locked packages as a spec list "name@version|..."
make lock_specs(lock: str, lock_len: num) -> str {
  hold out = ""
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      hold v = line_val(lline)
      hold skip = 0
      when len(k) == 0 {
        hold skip = 1
      }
      when len(lline) == len(k) {
        hold skip = 1
      }
      when string_eq(k, "version") == 1 {
        hold skip = 1
      }
      when string_eq(k, "name") == 1 {
        hold skip = 1
      }
      when len(lline) > 0 {
        when sx_index(lline, 0) == 35 {
          hold skip = 1
        }
      }
      when skip == 0 {
        hold out = concat(out, concat(k, concat("@", concat(v, "|"))))
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give out
}

// tail1: everything after the first byte (used to drop the "!" error marker)
make tail1(s: str) -> str {
  hold out = ""
  hold i = 1
  while i < len(s) {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// read_meta: a package's pkg.meta from the project's registry copy, falling
// back to the source registry directory.  A separate function because an
// inner `hold` would shadow the outer one instead of replacing it.
make read_meta(nm: str, src: str) -> str {
  hold meta = read_file(concat(".sayanox/registry/", concat(nm, "/pkg.meta")))
  when len(meta) == 0 && len(src) > 0 {
    give read_file(concat(concat(src, "/"), concat(nm, "/pkg.meta")))
  }
  give meta
}

// discover: NAME@VERSION plus every package its (and their) `deps=` lines
// declare, read from the project's registry copy or the source registry.
// A package whose pkg.meta is nowhere to be found is returned on its own:
// it has not been installed yet, so its dependencies are still unknown.
make discover(spec: str, src: str) -> str {
  hold nm = dep_name(spec)
  hold meta = read_meta(nm, src)
  hold out = concat(spec, "|")
  when len(meta) > 0 {
    hold dl = meta_deps(meta)
    while len(dl) > 0 {
      hold d = take_field(dl)
      hold dl = drop_field(dl)
      when has_field(out, d) == 0 {
        hold sub = discover(d, src)
        hold sl = sub
        while len(sl) > 0 {
          hold one = take_field(sl)
          hold sl = drop_field(sl)
          when has_field(out, one) == 0 {
            hold out = concat(out, concat(one, "|"))
          }
        }
      }
    }
  }
  give out
}

// resolve: the transitive dependency closure of the locked packages.
// Gives a spec list "name@version|..." on success, or "!" + the reason it
// could not be resolved.  Every step reads the local registry copy only.
make resolve(lock: str, src: str, lock_len: num) -> str {
  hold out = ""
  hold queue = lock_specs(lock, lock_len)
  hold guard = 0
  while len(queue) > 0 && guard < 64 {
    hold spec = take_field(queue)
    hold queue = drop_field(queue)
    hold guard = guard + 1
    when has_field(out, spec) == 0 {
      hold out = concat(out, concat(spec, "|"))
      hold nm = dep_name(spec)
      hold vr = dep_ver(spec)
      hold meta = read_meta(nm, src)
      when len(meta) == 0 {
        give concat("!", concat(nm, " has no registry copy; run: sxpkg install"))
      }
      hold mver = pkgfield(meta, "version")
      when string_eq(mver, vr) == 0 {
        give concat("!", concat(nm, concat(" is wanted at ", concat(vr, concat(" but the registry has ", mver)))))
      }
      hold dl = meta_deps(meta)
      while len(dl) > 0 {
        hold d = take_field(dl)
        hold dl = drop_field(dl)
        hold dn = dep_name(d)
        hold dv = dep_ver(d)
        hold lv = lock_ver(lock, lock_len, dn)
        when len(lv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" which is not in sx.lock; run: sxpkg add ", concat(dn, concat(" ", dv)))))))))
        }
        when string_eq(lv, dv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" but sx.lock has ", lv)))))))
        }
        hold queue = concat(queue, concat(d, "|"))
      }
    }
  }
  give out
}

hold argn = arg_count()
hold command = "help"
hold name = ""
hold version = "0.1.0"
when argn >= 2 {
  hold command = arg(1)
}
when argn >= 3 {
  hold name = arg(2)
}
when argn >= 4 {
  hold version = arg(3)
}

// Shared state is declared at the top level because the maintained compiler
// emits C blocks for when/while scopes.
hold handled = 0
hold is_init = string_eq(command, "init")
hold is_add = string_eq(command, "add")
hold is_list = string_eq(command, "list")
hold is_remove = string_eq(command, "remove")
hold is_search = string_eq(command, "search")
hold is_info = string_eq(command, "info")
hold is_seed = string_eq(command, "seed")
hold is_verify = string_eq(command, "verify")
hold is_sum = string_eq(command, "sum")
hold is_deps = string_eq(command, "deps")
hold is_install = string_eq(command, "install")
hold src = "registry"
hold query = ""
when argn >= 3 {
  hold query = arg(2)
}
hold lock_path = "sx.lock"
hold manifest_path = "sx.toml"
hold registry_path = ".sayanox/registry"
hold index_path = ".sayanox/registry/INDEX"
hold meta_path = ""
hold index = ""
hold lock = ""
hold manifest = ""
hold result = ""
hold line = ""
hold key = ""
hold lock_len = 0
hold key_len = 0
hold pos = 0
hold c = 0
hold lc = 0
hold j = 0
hold parse_key = 0
hold same = 0
hold replaced = 0
hold removed = 0
hold has_packages = 0
hold found = 0
hold is_comment = 0
hold is_version = 0
hold is_name = 0
hold is_empty = 0
hold line_len = 0
hold first_byte = 0
hold value = ""
hold value_len = 0
hold query_len = 0
hold index_len = 0
hold after_eq = 0
hold match_pos = 0
hold qpos = 0
hold equal = 1
hold scan_match = 0
hold key_byte = 0
hold query_byte = 0
hold name_len = 0
hold invalid = 0
hold reserved = 0
hold last_byte = 0
hold write_status = 0
hold all_ok = 1
// dependency / install state: declared here because the maintained
// compiler emits C blocks for when/while scopes.
hold vres = ""
hold vrest = ""
hold vspec = ""
hold vdn = ""
hold vdv = ""
hold vdlv = ""
hold vwhy = ""
hold ddres = ""
hold ddrest = ""
hold ddspec = ""
hold ddout = ""
hold ddn = 0
hold dires = ""
hold direst = ""
hold dispec = ""
hold diproblems = 0
hold dinm = ""
hold divr = ""
hold diwhy = ""
hold dismeta = ""
hold disver = ""
hold dissa = ""
hold diswant = ""
hold disgot = ""
hold diw1 = 0
hold diw2 = 0

when is_init == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    hold write_status = write_file(lock_path, "# sx.lock\nversion=1\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  hold manifest = read_file(manifest_path)
  hold lock_len = len(manifest)
  when lock_len == 0 {
    hold write_status = write_file(manifest_path, "name = \"my-pkg\"\nversion = \"0.1.0\"\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  when all_ok == 1 {
    show "sxpkg: init ok"
  } otherwise {
    show "sxpkg: init failed to write project files"
  }
}

when is_add == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg add <name> [version]"
  } otherwise {
    hold name_len = len(name)
    hold invalid = 0
    when name_len == 0 {
      hold invalid = 1
    }
    hold reserved = string_eq(name, "name")
    when reserved == 1 {
      hold invalid = 1
    }
    hold reserved = string_eq(name, "version")
    when reserved == 1 {
      hold invalid = 1
    }
    when invalid == 1 {
      show "sxpkg: invalid or reserved package name"
    } otherwise {
      hold lock = read_file(lock_path)
      hold lock_len = len(lock)
      when lock_len == 0 {
        hold lock = "# sx.lock\nversion=1\n"
      }
      hold lock_len = len(lock)
      when lock_len > 0 {
        hold last_byte = sx_idx(lock, lock_len - 1)
        when last_byte != 10 {
          hold lock = concat(lock, "\n")
        }
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold replaced = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            when replaced == 0 {
              hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
              hold replaced = 1
            }
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when replaced == 0 {
        hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
      }
      // pull in what the package declares in `deps=`, transitively, so
      // `deps` and `install` see a complete set.  Packages that are not
      // installed or present anywhere yet contribute nothing here.
      hold dlist = discover(concat(name, concat("@", version)), src)
      hold drest = dlist
      while len(drest) > 0 {
        hold done = take_field(drest)
        hold drest = drop_field(drest)
        hold adn = dep_name(done)
        hold adv = dep_ver(done)
        hold alv = lock_ver(result, len(result), adn)
        when len(alv) == 0 {
          hold result = concat(result, concat(adn, concat("=", concat(adv, "\n"))))
          show concat(concat("sxpkg: locked ", concat(adn, concat(" ", adv))), concat(" (dependency of ", concat(name, ")")))
        }
      }
      hold write_status = write_file(lock_path, result)
      when write_status == 1 {
        show concat("sxpkg: locked ", concat(name, concat(" ", version)))
      } otherwise {
        show "sxpkg: failed to write sx.lock"
      }
    }
  }
}

when is_list == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold result = "sxpkg: locked packages"
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < lock_len {
      hold c = sx_idx(lock, pos)
      when c == 10 {
        hold key = ""
        hold key_len = len(line)
        hold j = 0
        hold parse_key = 1
        while parse_key == 1 {
          when j < key_len {
            hold lc = sx_idx(line, j)
            when lc == 61 {
              hold parse_key = 0
            } otherwise {
              hold key = concat(key, chr(lc))
              hold j = j + 1
            }
          } otherwise {
            hold parse_key = 0
          }
        }
        hold is_version = string_eq(key, "version")
        hold is_name = string_eq(key, "name")
        hold is_empty = string_eq(line, "")
        hold is_comment = 0
        hold line_len = len(line)
        when line_len > 0 {
          hold first_byte = sx_idx(line, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        when is_version == 0 && is_name == 0 && is_empty == 0 && is_comment == 0 {
          hold result = concat(result, concat("\n", line))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n(none)")
    }
    show result
  }
}

when is_search == 1 {
  hold handled = 1
  hold index = read_file(index_path)
  hold index_len = len(index)
  when index_len == 0 {
    show "sxpkg: no registry index; run sync or seed"
  } otherwise {
    hold last_byte = sx_idx(index, index_len - 1)
    when last_byte != 10 {
      hold index = concat(index, "\n")
    }
    hold index_len = len(index)
    hold query_len = len(query)
    hold result = concat("sxpkg: search ", query)
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < index_len {
      hold c = sx_idx(index, pos)
      when c == 10 {
        hold key = ""
        hold value = ""
        hold after_eq = 0
        hold line_len = len(line)
        hold j = 0
        while j < line_len {
          hold lc = sx_idx(line, j)
          when lc == 61 {
            hold after_eq = 1
          } otherwise {
            when after_eq == 1 {
              hold value = concat(value, chr(lc))
            } otherwise {
              hold key = concat(key, chr(lc))
            }
          }
          hold j = j + 1
        }
        hold key_len = len(key)
        hold same = string_eq(key, "version")
        hold is_version = same
        hold same = string_eq(key, "name")
        hold is_name = same
        hold is_empty = string_eq(key, "")
        hold is_comment = 0
        when key_len > 0 {
          hold first_byte = sx_idx(key, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        hold found = 0
        when query_len == 0 {
          hold found = 1
        } otherwise {
          hold match_pos = 0
          hold scan_match = 1
          while scan_match == 1 {
            when match_pos + query_len <= key_len {
              hold equal = 1
              hold qpos = 0
              while qpos < query_len && equal == 1 {
                hold key_byte = sx_idx(key, match_pos + qpos)
                hold query_byte = sx_idx(query, qpos)
                when key_byte != query_byte {
                  hold equal = 0
                }
                hold qpos = qpos + 1
              }
              when equal == 1 {
                hold found = 1
                hold scan_match = 0
              } otherwise {
                hold match_pos = match_pos + 1
              }
            } otherwise {
              hold scan_match = 0
            }
          }
        }
        when found == 1 && is_version == 0 && is_name == 0 && is_comment == 0 && is_empty == 0 {
          hold result = concat(result, concat("\n  ", concat(key, concat(" ", value))))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n  (no matches)")
    }
    show result
  }
}

when is_info == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg info <name>"
  } otherwise {
    hold meta_path = concat(concat(registry_path, "/"), concat(name, "/pkg.meta"))
    hold manifest = read_file(meta_path)
    hold lock_len = len(manifest)
    when lock_len == 0 {
      show concat("unknown ", concat(name, " - try: sxpkg sync and search"))
    } otherwise {
      show manifest
    }
  }
}

when is_seed == 1 {
  hold handled = 1
  hold all_ok = 1
  hold hello_src = "show \"hello from pkg\"\n"
  hold math_src = "make dbl(n) {\n  give n + n\n}\nmake sqr(n) {\n  give n * n\n}\n"
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/main.sa"), hello_src)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/pkg.meta"), concat("name=hello\nversion=0.1.0\ndesc=hello world sample\nsum=", concat(decstr(pkgsum(hello_src)), "\n")))
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/main.sa"), math_src)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/pkg.meta"), concat("name=math\nversion=0.1.0\ndesc=tiny math helpers (dbl, sqr)\nsum=", concat(decstr(pkgsum(math_src)), "\n")))
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(index_path, "hello=0.1.0\nmath=0.1.0\n")
  when write_status == 0 { hold all_ok = 0 }
  when all_ok == 1 {
    show "sxpkg: local registry seeded"
  } otherwise {
    show "sxpkg: seed failed; run the wrapper to create registry folders"
  }
}

when is_remove == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg remove <name>"
  } otherwise {
    hold lock = read_file(lock_path)
    hold lock_len = len(lock)
    when lock_len == 0 {
      show "sxpkg: no sx.lock"
    } otherwise {
      hold last_byte = sx_idx(lock, lock_len - 1)
      when last_byte != 10 {
        hold lock = concat(lock, "\n")
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold removed = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            hold removed = 1
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when removed == 1 {
        hold write_status = write_file(lock_path, result)
        when write_status == 1 {
          show concat("sxpkg: removed ", name)
        } otherwise {
          show "sxpkg: failed to write sx.lock"
        }
      } otherwise {
        show concat("sxpkg: not locked: ", name)
      }
    }
  }
}

// sum <file>: the checksum `pkgsum` gives a file (used when writing pkg.meta)
when is_sum == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg sum <file>"
  } otherwise {
    hold src = read_file(name)
    when len(src) == 0 {
      show concat("sxpkg: cannot read ", name)
    } otherwise {
      show concat("sxpkg: sum ", concat(decstr(pkgsum(src)), concat(" ", name)))
    }
  }
}

// verify: every sx.lock entry must match its registry copy (version and sum)
when is_verify == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_index(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold checked = 0
    hold problems = 0
    hold pos = 0
    hold line = ""
    while pos < lock_len {
      hold c = sx_index(lock, pos)
      when c == 10 {
        hold vkey = line_key(line)
        hold vval = line_val(line)
        hold vlen = len(line)
        when vlen > 0 && sx_index(line, 0) != 35 && string_eq(vkey, "version") == 0 && string_eq(vkey, "name") == 0 {
          when len(vkey) == 0 || len(vval) == 0 || len(line) == len(vkey) {
            hold problems = problems + 1
            show concat("sxpkg: MISMATCH malformed lock line: ", line)
          } otherwise {
            hold checked = checked + 1
            hold why = check_pkg(vkey, vval)
            when len(why) == 0 {
              show concat("sxpkg: verified ", concat(vkey, concat(" ", vval)))
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vkey, concat(": ", why)))
            }
          }
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    // the dependency closure: every package a locked package declares in
    // `deps=` must itself be present, and only the ones pulled in
    // transitively (not already counted above) are reported here.
    hold vres = resolve(lock, "", lock_len)
    when len(vres) > 0 {
      when sx_index(vres, 0) == 33 {
        hold problems = problems + 1
        show concat("sxpkg: DEP ", tail1(vres))
      } otherwise {
        hold vrest = vres
        while len(vrest) > 0 {
          hold vspec = take_field(vrest)
          hold vrest = drop_field(vrest)
          hold vdn = dep_name(vspec)
          hold vdv = dep_ver(vspec)
          hold vdlv = lock_ver(lock, lock_len, vdn)
          when len(vdlv) == 0 {
            hold checked = checked + 1
            hold vwhy = check_pkg(vdn, vdv)
            when len(vwhy) == 0 {
              show concat("sxpkg: verified ", concat(vdn, concat(" ", vdv)))
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vdn, concat(": ", vwhy)))
            }
          }
        }
      }
    }
    when problems == 0 {
      show concat("sxpkg: verify ok (", concat(numstr(checked), " locked packages)"))
    } otherwise {
      show concat("sxpkg: verify FAILED (", concat(numstr(problems), " problem(s))"))
    }
  }
}

// deps: the transitive dependency closure of the locked packages, resolved
// offline from the local registry copies.
when is_deps == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold ddres = resolve(lock, src, lock_len)
    when sx_index(ddres, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(ddres))
    } otherwise {
      hold ddout = "sxpkg: dependency closure"
      hold ddrest = ddres
      hold ddn = 0
      while len(ddrest) > 0 {
        hold ddspec = take_field(ddrest)
        hold ddrest = drop_field(ddrest)
        hold ddn = ddn + 1
        hold ddout = concat(ddout, concat("\n  ", concat(dep_name(ddspec), concat(" ", dep_ver(ddspec)))))
      }
      when ddn == 0 {
        hold ddout = concat(ddout, "\n  (none)")
      }
      show ddout
    }
  }
}

// install: copy every locked package (and its closure) from a local registry
// directory into the project's .sayanox/registry/, checking the version and
// the content sum on both sides.  Offline: it reads files, never the network.
// The default source registry is ./registry; the wrapper `sxpkg.sh install`
// creates the destination folders first and then runs this.
when is_install == 1 {
  hold handled = 1
  when argn >= 3 {
    hold src = arg(2)
  }
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold dires = resolve(lock, src, lock_len)
    when sx_index(dires, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(dires))
    } otherwise {
      hold diproblems = 0
      hold direst = dires
      while len(direst) > 0 {
        hold dispec = take_field(direst)
        hold direst = drop_field(direst)
        hold dinm = dep_name(dispec)
        hold divr = dep_ver(dispec)
        hold diwhy = check_pkg(dinm, divr)
        when len(diwhy) == 0 {
          show concat("sxpkg: ok ", concat(dinm, concat(" ", divr)))
        } otherwise {
          hold dismeta = read_file(concat(concat(src, "/"), concat(dinm, "/pkg.meta")))
          when len(dismeta) == 0 {
            show concat("sxpkg: MISSING ", concat(dinm, concat(": the source registry has no ", concat(src, concat("/", concat(dinm, "/pkg.meta"))))))
            hold diproblems = diproblems + 1
          } otherwise {
            hold disver = pkgfield(dismeta, "version")
            when string_eq(disver, divr) == 0 {
              show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source registry has ", concat(disver, concat(" but sx.lock wants ", divr)))))
              hold diproblems = diproblems + 1
            } otherwise {
              hold dissa = read_file(concat(concat(src, "/"), concat(dinm, "/main.sa")))
              hold diswant = pkgfield(dismeta, "sum")
              hold disgot = decstr(pkgsum(dissa))
              when string_eq(diswant, disgot) == 0 {
                show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source main.sa sums to ", concat(disgot, concat(" but its pkg.meta says ", diswant)))))
                hold diproblems = diproblems + 1
              } otherwise {
                hold diw1 = write_file(concat(".sayanox/registry/", concat(dinm, "/pkg.meta")), dismeta)
                hold diw2 = write_file(concat(".sayanox/registry/", concat(dinm, "/main.sa")), dissa)
                when diw1 == 1 && diw2 == 1 {
                  show concat("sxpkg: installed ", concat(dinm, concat(" ", divr)))
                } otherwise {
                  show concat("sxpkg: MISSING ", concat(dinm, concat(": cannot write .sayanox/registry/", concat(dinm, "/; run sh tools/sxpkg.sh install-local to create the folders"))))
                  hold diproblems = diproblems + 1
                }
              }
            }
          }
        }
      }
      when diproblems == 0 {
        show "sxpkg: install ok"
      } otherwise {
        show concat("sxpkg: install FAILED (", concat(numstr(diproblems), " problem(s))"))
      }
    }
  }
}

when handled == 0 {
  show "sxpkg: local commands: init | add <name> [version] | list | remove <name> | seed | search | info | deps | install [registry] | verify | sum <file>"
  show "sxpkg: sync/publish/fetch still require the shell implementation"
}
