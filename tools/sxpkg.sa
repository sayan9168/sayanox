// The Sayanox package tool: one program, no shell wrapper.
//
// Everything the old tools/sxpkg.sh did is here -- init/add/list/remove,
// registry seed/search/info/publish, the offline install and install-local,
// the local and http(s) branches of sync and fetch, the online opt-in policy,
// the project-root handling, the help text and the exit statuses.  The only
// thing this file still hands to another program is the http(s) transfer
// itself: `curl`, or `wget` when there is no curl, found on PATH by scanning
// it here and started through the run_command builtin.
//
// SAYANOX_ROOT moves the project, SAYANOX_REGISTRY names the registry and
// SAYANOX_ONLINE=1 (or `sxpkg --online <command>`) permits the network; all
// three are read with the getenv builtin.  A file:// URL or a plain path is
// not the network and needs no permission.
//
// Offline package convention (docs/REGISTRY.md): a package is a directory
// .sayanox/registry/<name>/ with main.sa and pkg.meta; pkg.meta carries
// name=, version=, desc=, sum= (pkgsum of main.sa), sha256= (the real digest
// of main.sa), origin= (provenance: where those bytes came from) and, once
// `sxpkg sign` has run, signer= and sig= (HMAC-SHA256 over the canonical
// record). `verify` checks every sx.lock entry against its registry copy.
// Nothing here touches the network.
//
// WHAT THE SIGNATURE IS AND IS NOT: sig= is a KEYED digest, HMAC-SHA256 with
// a shared secret. It proves the bytes were signed by someone who holds that
// key and that nothing changed afterwards. It is NOT a public-key signature:
// a verifier needs the same secret the signer used, so it authenticates a
// private or self-hosted registry, not an anonymous public download. There is
// no Ed25519/RSA here and none is claimed.

use "../stdlib/crypto.sa"

// pkgsum: checksum of a file's bytes, h = (h * 31 + byte) mod 1000000007.
// It detects accidental edits to a locked package; it is not a security hash.
// sha256= below is the security hash; sum= stays for the older packages and
// is still written, so an old registry keeps verifying.
make pkgsum(s: str) -> num {
  hold h = 0
  hold i = 0
  while i < len(s) {
    hold t = h * 31 + sx_index(s, i)
    hold h = t % 1000000007
    hold i = i + 1
  }
  give h
}

// pkgsha: the SHA-256 of a package's bytes, 64 lowercase hex characters.
// stdlib/crypto.sa computes it in Sayanox on every backend; nothing shells
// out to sha256sum.
make pkgsha(s: str) -> str {
  give cx_sha256(s)
}

// sign_record: the exact text a signature covers. Tying the name and the
// version to the digest is what stops a signed package being replayed under
// another name or another version.
make sign_record(nm: str, ver: str, digest: str) -> str {
  hold rec = "sayanox-pkg-v1\n"
  hold rec = concat(rec, concat("name=", concat(nm, "\n")))
  hold rec = concat(rec, concat("version=", concat(ver, "\n")))
  hold rec = concat(rec, concat("sha256=", concat(digest, "\n")))
  give rec
}

// trim_ws: a key file ends with a newline the key itself does not include.
make trim_ws(s: str) -> str {
  hold stop = len(s)
  hold go = 1
  while go == 1 {
    hold go = 0
    when stop > 0 {
      hold c = sx_index(s, stop - 1)
      when c == 10 {
        hold stop = stop - 1
        hold go = 1
      }
      when c == 13 {
        hold stop = stop - 1
        hold go = 1
      }
      when c == 32 {
        hold stop = stop - 1
        hold go = 1
      }
      when c == 9 {
        hold stop = stop - 1
        hold go = 1
      }
    }
  }
  hold out = ""
  hold i = 0
  while i < stop {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// load_key: the signing secret, from SAYANOX_SIGN_KEY or from the key file
// (default .sayanox/keys/default.key). An empty answer means there is no key,
// and every caller reports that instead of pretending the check passed.
make load_key(keyfile: str) -> str {
  hold k = getenv("SAYANOX_SIGN_KEY")
  when len(k) > 0 {
    give trim_ws(k)
  }
  hold f = read_file(keyfile)
  when len(f) == 0 {
    give ""
  }
  give trim_ws(f)
}

// key_id: the public name of a key -- the first 16 hex characters of the
// SHA-256 of the secret. It identifies which key signed without revealing it.
make key_id(secret: str) -> str {
  hold d = cx_sha256(secret)
  hold out = ""
  hold i = 0
  while i < 16 {
    hold out = concat(out, chr(sx_index(d, i)))
    hold i = i + 1
  }
  give out
}

// decstr: decimal text of a whole number. numstr would round to 6 digits.
make decstr(n: num) -> str {
  when n == 0 {
    give "0"
  }
  hold s = ""
  hold m = n
  while m > 0 {
    // `%` is taken on its own line: gen2 copies a `%` inside a builtin call
    // argument as raw C (documented in docs/STATUS.md, divergences)
    hold r = m % 10
    hold s = concat(chr(48 + r), s)
    hold m = (m - r) / 10
  }
  give s
}

// pkgfield: the value of `key=...` on its own line of a pkg.meta text ("" if absent)
make pkgfield(text: str, key: str) -> str {
  hold n = len(text)
  hold kl = len(key)
  hold p = 0
  hold bol = 1
  while p < n {
    when bol == 1 {
      hold ok = 1
      hold j = 0
      while j < kl {
        when p + j >= n {
          hold ok = 0
          hold j = kl
        } otherwise {
          when sx_index(text, p + j) != sx_index(key, j) {
            hold ok = 0
            hold j = kl
          } otherwise {
            hold j = j + 1
          }
        }
      }
      when ok == 1 && p + kl < n && sx_index(text, p + kl) == 61 {
        hold v = ""
        hold q = p + kl + 1
        while q < n && sx_index(text, q) != 10 {
          hold v = concat(v, chr(sx_index(text, q)))
          hold q = q + 1
        }
        give v
      }
    }
    hold bol = 0
    when sx_index(text, p) == 10 {
      hold bol = 1
    }
    hold p = p + 1
  }
  give ""
}

// line_is_key: 1 when LINE starts with `key=`
make line_is_key(line: str, key: str) -> num {
  hold kl = len(key)
  when len(line) < kl + 1 {
    give 0
  }
  hold i = 0
  while i < kl {
    when sx_index(line, i) != sx_index(key, i) {
      give 0
    }
    hold i = i + 1
  }
  when sx_index(line, kl) != 61 {
    give 0
  }
  give 1
}

// meta_drop: a pkg.meta text without any `key=` line (and without blank ones)
make meta_drop(text: str, key: str) -> str {
  hold out = ""
  hold line = ""
  hold n = len(text)
  hold i = 0
  while i <= n {
    hold c = 10
    when i < n {
      hold c = sx_index(text, i)
    }
    when c == 10 {
      when len(line) > 0 {
        when line_is_key(line, key) == 0 {
          hold out = concat(out, concat(line, "\n"))
        }
      }
      hold line = ""
    } otherwise {
      hold line = concat(line, chr(c))
    }
    hold i = i + 1
  }
  give out
}

// meta_set: the same text with exactly one `key=value` line, appended last
make meta_set(text: str, key: str, value: str) -> str {
  hold out = meta_drop(text, key)
  give concat(out, concat(key, concat("=", concat(value, "\n"))))
}

// line_key / line_val: split one `key=value` lock line at its first `=`
make line_key(line: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(line) {
    when sx_index(line, i) == 61 {
      give out
    }
    hold out = concat(out, chr(sx_index(line, i)))
    hold i = i + 1
  }
  give out
}

make line_val(line: str) -> str {
  hold i = 0
  while i < len(line) && sx_index(line, i) != 61 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(line) {
    hold out = concat(out, chr(sx_index(line, j)))
    hold j = j + 1
  }
  give out
}

// Portable package path component, shared by wrapper preflight.
make package_name_ok(value: str) -> num {
  when len(value) == 0 || string_eq(value, "name") || string_eq(value, "version") {
    give 0
  }
  hold i = 0
  while i < len(value) {
    hold c = sx_index(value, i)
    hold good = 0
    when c >= 48 && c <= 57 {
      good = 1
    }
    when c >= 65 && c <= 90 {
      good = 1
    }
    when c >= 97 && c <= 122 {
      good = 1
    }
    when c == 45 || c == 95 {
      good = 1
    }
    when good == 0 {
      give 0
    }
    i = i + 1
  }
  give 1
}

// check_pkg: "" when the registry copy of NAME matches the lock VERSION and its
// pkg.meta sum; otherwise the reason it does not.
make check_pkg(name: str, version: str, reg: str) -> str {
  hold meta = read_file(concat(concat(reg, "/"), concat(name, "/pkg.meta")))
  when len(meta) == 0 {
    give "no registry copy (.sayanox/registry/<name>/pkg.meta is missing)"
  }
  hold mver = pkgfield(meta, "version")
  when string_eq(mver, version) == 0 {
    give concat("locked at ", concat(version, concat(" but the registry has ", mver)))
  }
  hold src = read_file(concat(concat(reg, "/"), concat(name, "/main.sa")))
  hold want = pkgfield(meta, "sum")
  hold got = decstr(pkgsum(src))
  when string_eq(want, got) == 0 {
    give concat("main.sa sums to ", concat(got, concat(" but pkg.meta says ", want)))
  }
  // sha256= is the cryptographic acceptance test. It is only checked when the
  // package carries one, so a registry written by an older sxpkg still
  // verifies; a package that HAS a digest must match it exactly.
  hold wantsha = pkgfield(meta, "sha256")
  when len(wantsha) > 0 {
    hold gotsha = pkgsha(src)
    when cx_eq_hex(wantsha, gotsha) == 0 {
      give concat("main.sa hashes to ", concat(gotsha, concat(" but pkg.meta says ", wantsha)))
    }
  }
  give ""
}

// check_sig: the signature status of a package, as one word plus a reason.
//   signed    the sig= matches the key over name/version/sha256
//   unsigned  the package carries no sig=
//   nokey     it is signed, but this machine has no key to check it with
//   nodigest  it is signed but carries no sha256= to sign over
//   BAD       there is a signature and it does not match
make check_sig(name: str, reg: str, secret: str) -> str {
  hold meta = read_file(concat(concat(reg, "/"), concat(name, "/pkg.meta")))
  when len(meta) == 0 {
    give "unsigned"
  }
  hold sig = pkgfield(meta, "sig")
  when len(sig) == 0 {
    give "unsigned"
  }
  when len(secret) == 0 {
    give "nokey"
  }
  hold digest = pkgfield(meta, "sha256")
  when len(digest) == 0 {
    give "nodigest"
  }
  // The digest in pkg.meta is only a claim until main.sa is hashed again.
  hold src = read_file(concat(concat(reg, "/"), concat(name, "/main.sa")))
  hold real = pkgsha(src)
  when cx_eq_hex(digest, real) == 0 {
    give "BAD main.sa does not match the signed sha256"
  }
  hold mver = pkgfield(meta, "version")
  hold rec = sign_record(name, mver, digest)
  hold want = cx_hmac(secret, rec)
  when cx_eq_hex(want, sig) == 1 {
    hold signer = pkgfield(meta, "signer")
    when len(signer) == 0 {
      give "signed"
    }
    when string_eq(signer, key_id(secret)) == 0 {
      give concat("BAD signed by ", concat(signer, concat(" but this key is ", key_id(secret))))
    }
    give "signed"
  }
  give "BAD signature does not match this key"
}

// ---- dependency resolution ----------------------------------------------
// A dependency is written `name@version` in pkg.meta's `deps=` line, and the
// version is an exact pin: there are no ranges.  Resolution walks sx.lock and
// each package's `deps=`, offline, from the local registry copy only.
//
// Lists of specs are plain `|`-delimited strings, "a@1|b@2|": take_field reads
// the first entry, drop_field removes it, has_field tests membership.

// dep_name / dep_ver: the two halves of one `name@version` spec
make dep_name(spec: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(spec) {
    when sx_index(spec, i) == 64 {
      give out
    }
    hold out = concat(out, chr(sx_index(spec, i)))
    hold i = i + 1
  }
  give out
}

make dep_ver(spec: str) -> str {
  hold i = 0
  while i < len(spec) && sx_index(spec, i) != 64 {
    hold i = i + 1
  }
  hold out = ""
  hold j = i + 1
  while j < len(spec) {
    hold out = concat(out, chr(sx_index(spec, j)))
    hold j = j + 1
  }
  give out
}

// take_field: the first `|`-delimited entry of a spec list
make take_field(list: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      give out
    }
    hold out = concat(out, chr(sx_index(list, i)))
    hold i = i + 1
  }
  give out
}

// drop_field: the same list without its first entry
make drop_field(list: str) -> str {
  hold i = 0
  while i < len(list) {
    when sx_index(list, i) == 124 {
      hold out = ""
      hold j = i + 1
      while j < len(list) {
        hold out = concat(out, chr(sx_index(list, j)))
        hold j = j + 1
      }
      give out
    }
    hold i = i + 1
  }
  give ""
}

// has_field: 1 when the spec list already contains this exact entry
make has_field(list: str, x: str) -> num {
  hold n = len(list)
  hold m = len(x)
  hold i = 0
  while i + m + 1 <= n {
    hold ok = 1
    when i > 0 {
      when sx_index(list, i - 1) != 124 {
        hold ok = 0
      }
    }
    when ok == 1 {
      hold j = 0
      while j < m {
        when sx_index(list, i + j) != sx_index(x, j) {
          hold ok = 0
          hold j = m
        } otherwise {
          hold j = j + 1
        }
      }
      when ok == 1 {
        when sx_index(list, i + m) == 124 {
          give 1
        }
      }
    }
    hold i = i + 1
  }
  give 0
}

// split_deps: the `deps=` value "a@1,b@2" as a spec list "a@1|b@2|"
make split_deps(text: str) -> str {
  hold out = ""
  hold n = len(text)
  hold cur = ""
  hold i = 0
  while i <= n {
    hold c = 0
    when i < n {
      hold c = sx_index(text, i)
    }
    when c == 44 || i == n {
      when len(cur) > 0 {
        hold out = concat(out, concat(cur, "|"))
      }
      hold cur = ""
    } otherwise {
      hold cur = concat(cur, chr(c))
    }
    hold i = i + 1
  }
  give out
}

// meta_deps: a pkg.meta's dependencies as a spec list ("" when it has none)
make meta_deps(meta: str) -> str {
  give split_deps(pkgfield(meta, "deps"))
}

// ---- what the shell entrypoint used to do with grep, cut, tr, cp, mkdir ----
// Sayanox has make_dir/path_kind/read_dir/remove_path, so folder creation,
// folder deletion, recursive copies and a `key = ...` manifest read are all
// expressible here.  The wrapper keeps only the network transport and the
// opt-in policy, because Sayanox has no getenv and spawn takes a path with no
// argv.
//
// Note for anyone editing this file: the compiler's signature pre-pass does not
// understand // comments, so a comment with an odd number of double quotes
// silently turns the rest of the file into a string literal and every later
// `make` loses its typed parameter list.  Keep quotes in comments balanced.

// toml_field: the value of a `key = ...` line of a manifest, quotes and spaces
// removed.  The line must START with the key, exactly as the shell pipeline
// `grep '^key' | cut -d= -f2- | tr -d ...` required; the result is empty when
// there is no such line.
make toml_field(text: str, key: str) -> str {
  hold n = len(text)
  hold kl = len(key)
  hold p = 0
  hold bol = 1
  while p < n {
    when bol == 1 {
      hold ok = 1
      hold j = 0
      while j < kl {
        when p + j >= n {
          hold ok = 0
          hold j = kl
        } otherwise {
          when sx_index(text, p + j) != sx_index(key, j) {
            hold ok = 0
            hold j = kl
          } otherwise {
            hold j = j + 1
          }
        }
      }
      when ok == 1 {
        // the line runs from p+kl up to the next newline (or the end)
        hold eol = p + kl
        hold eolstop = 0
        while eolstop == 0 {
          when eol >= n {
            hold eolstop = 1
          } otherwise {
            when sx_index(text, eol) == 10 {
              hold eolstop = 1
            } otherwise {
              hold eol = eol + 1
            }
          }
        }
        // the value starts after the first '=' on that line, or at the key's
        // end when the line has no '=' at all (what cut would have returned)
        hold eq = p + kl
        hold vs = p + kl
        hold eqstop = 0
        while eqstop == 0 {
          when eq >= eol {
            hold eqstop = 1
          } otherwise {
            when sx_index(text, eq) == 61 {
              hold vs = eq + 1
              hold eqstop = 1
            } otherwise {
              hold eq = eq + 1
            }
          }
        }
        hold v = ""
        hold r = vs
        while r < eol {
          hold ch = sx_index(text, r)
          when ch != 34 && ch != 32 {
            hold v = concat(v, chr(ch))
          }
          hold r = r + 1
        }
        give v
      }
      hold bol = 0
    }
    when sx_index(text, p) == 10 {
      hold bol = 1
    }
    hold p = p + 1
  }
  give ""
}

// strip_file_scheme: a registry URL without its "file://" prefix, so
// `SAYANOX_REGISTRY=file:///reg` and `sxpkg sync-local /reg` are one code path.
make strip_file_scheme(p: str) -> str {
  hold scheme = "file://"
  hold n = len(p)
  when n > 7 {
    hold i = 0
    hold ok = 1
    while i < 7 {
      when sx_index(p, i) != sx_index(scheme, i) {
        hold ok = 0
      }
      hold i = i + 1
    }
    when ok == 1 {
      hold out = ""
      hold j = 7
      while j < n {
        hold out = concat(out, chr(sx_index(p, j)))
        hold j = j + 1
      }
      give out
    }
  }
  give p
}

// ensure_dir: `mkdir -p PATH`.  make_dir creates one level and reports failure
// when the directory already exists, so every prefix is attempted and an
// existing directory is accepted rather than treated as an error.
make ensure_dir(path: str) -> num {
  hold ok = 1
  hold cur = ""
  hold i = 0
  hold n = len(path)
  while i < n {
    hold c = sx_index(path, i)
    when c == 47 {
      when len(cur) > 0 {
        hold made = make_dir(cur)
        when made == 0 {
          when path_kind(cur) != 2 {
            hold ok = 0
          }
        }
      }
    }
    hold cur = concat(cur, chr(c))
    hold i = i + 1
  }
  when len(cur) > 0 {
    hold made = make_dir(cur)
    when made == 0 {
      when path_kind(cur) != 2 {
        hold ok = 0
      }
    }
  }
  give ok
}

// rm_tree: `rm -rf PATH`.  read_dir lists a directory and remove_path unlinks a
// file or rmdirs an empty one, so the walk is depth-first and a missing path is
// already a success.
make rm_tree(path: str) -> num {
  hold kind = path_kind(path)
  when kind == 0 {
    give 1
  }
  when kind == 2 {
    hold names = read_dir(path)
    hold n = len(names)
    hold i = 0
    hold one = ""
    hold ok = 1
    while i < n {
      hold c = sx_index(names, i)
      when c == 10 {
        when len(one) > 0 {
          hold child = concat(concat(path, "/"), one)
          when rm_tree(child) == 0 {
            hold ok = 0
          }
        }
        hold one = ""
      } otherwise {
        hold one = concat(one, chr(c))
      }
      hold i = i + 1
    }
    when len(one) > 0 {
      hold child = concat(concat(path, "/"), one)
      when rm_tree(child) == 0 {
        hold ok = 0
      }
    }
    when remove_path(path) == 0 {
      hold ok = 0
    }
    give ok
  }
  give remove_path(path)
}

// copy_tree: `cp -r SRC/. DST/` -- every entry of SRC read and written into
// DST, creating DST first.  Directories recurse; everything else is a
// read_file/write_file pair.
make copy_tree(src: str, dst: str) -> num {
  hold ok = ensure_dir(dst)
  hold names = read_dir(src)
  hold n = len(names)
  hold i = 0
  hold one = ""
  while i < n {
    hold c = sx_index(names, i)
    when c == 10 {
      when len(one) > 0 {
        hold from = concat(concat(src, "/"), one)
        hold to = concat(concat(dst, "/"), one)
        when path_kind(from) == 2 {
          when copy_tree(from, to) == 0 {
            hold ok = 0
          }
        } otherwise {
          when write_file(to, read_file(from)) == 0 {
            hold ok = 0
          }
        }
      }
      hold one = ""
    } otherwise {
      hold one = concat(one, chr(c))
    }
    hold i = i + 1
  }
  when len(one) > 0 {
    hold from = concat(concat(src, "/"), one)
    hold to = concat(concat(dst, "/"), one)
    when path_kind(from) == 2 {
      when copy_tree(from, to) == 0 {
        hold ok = 0
      }
    } otherwise {
      when write_file(to, read_file(from)) == 0 {
        hold ok = 0
      }
    }
  }
  give ok
}

// lock_ver: the version sx.lock pins NAME to, "" when it is not locked
make lock_ver(lock: str, lock_len: num, want: str) -> str {
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      when string_eq(k, want) == 1 {
        give line_val(lline)
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give ""
}

// lock_specs: the locked packages as a spec list "name@version|..."
make lock_specs(lock: str, lock_len: num) -> str {
  hold out = ""
  hold p = 0
  hold lline = ""
  while p < lock_len {
    hold c = sx_index(lock, p)
    when c == 10 {
      hold k = line_key(lline)
      hold v = line_val(lline)
      hold skip = 0
      when len(k) == 0 {
        hold skip = 1
      }
      when len(lline) == len(k) {
        hold skip = 1
      }
      when string_eq(k, "version") == 1 {
        hold skip = 1
      }
      when string_eq(k, "name") == 1 {
        hold skip = 1
      }
      when len(lline) > 0 {
        when sx_index(lline, 0) == 35 {
          hold skip = 1
        }
      }
      when skip == 0 {
        hold out = concat(out, concat(k, concat("@", concat(v, "|"))))
      }
      hold lline = ""
    } otherwise {
      hold lline = concat(lline, chr(c))
    }
    hold p = p + 1
  }
  give out
}

// tail1: everything after the first byte (used to drop the "!" error marker)
make tail1(s: str) -> str {
  hold out = ""
  hold i = 1
  while i < len(s) {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// read_meta: a package's pkg.meta from the project's registry copy, falling
// back to the source registry directory.  A separate function because an
// inner `hold` would shadow the outer one instead of replacing it.
make read_meta(nm: str, src: str, reg: str) -> str {
  hold meta = read_file(concat(concat(reg, "/"), concat(nm, "/pkg.meta")))
  when len(meta) == 0 && len(src) > 0 {
    give read_file(concat(concat(src, "/"), concat(nm, "/pkg.meta")))
  }
  give meta
}

// discover: NAME@VERSION plus every package its (and their) `deps=` lines
// declare, read from the project's registry copy or the source registry.
// A package whose pkg.meta is nowhere to be found is returned on its own:
// it has not been installed yet, so its dependencies are still unknown.
make discover(spec: str, src: str, reg: str) -> str {
  hold nm = dep_name(spec)
  hold meta = read_meta(nm, src, reg)
  hold out = concat(spec, "|")
  when len(meta) > 0 {
    hold dl = meta_deps(meta)
    while len(dl) > 0 {
      hold d = take_field(dl)
      hold dl = drop_field(dl)
      when has_field(out, d) == 0 {
        hold sub = discover(d, src, reg)
        hold sl = sub
        while len(sl) > 0 {
          hold one = take_field(sl)
          hold sl = drop_field(sl)
          when has_field(out, one) == 0 {
            hold out = concat(out, concat(one, "|"))
          }
        }
      }
    }
  }
  give out
}

// resolve: the transitive dependency closure of the locked packages.
// Gives a spec list "name@version|..." on success, or "!" + the reason it
// could not be resolved.  Every step reads the local registry copy only.
make resolve(lock: str, src: str, lock_len: num, reg: str) -> str {
  hold out = ""
  hold queue = lock_specs(lock, lock_len)
  hold guard = 0
  while len(queue) > 0 && guard < 64 {
    hold spec = take_field(queue)
    hold queue = drop_field(queue)
    hold guard = guard + 1
    when has_field(out, spec) == 0 {
      hold out = concat(out, concat(spec, "|"))
      hold nm = dep_name(spec)
      hold vr = dep_ver(spec)
      hold meta = read_meta(nm, src, reg)
      when len(meta) == 0 {
        give concat("!", concat(nm, " has no registry copy; run: sxpkg install"))
      }
      hold mver = pkgfield(meta, "version")
      when string_eq(mver, vr) == 0 {
        give concat("!", concat(nm, concat(" is wanted at ", concat(vr, concat(" but the registry has ", mver)))))
      }
      hold dl = meta_deps(meta)
      while len(dl) > 0 {
        hold d = take_field(dl)
        hold dl = drop_field(dl)
        hold dn = dep_name(d)
        hold dv = dep_ver(d)
        hold lv = lock_ver(lock, lock_len, dn)
        when len(lv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" which is not in sx.lock; run: sxpkg add ", concat(dn, concat(" ", dv)))))))))
        }
        when string_eq(lv, dv) == 0 {
          give concat("!", concat(nm, concat(" needs ", concat(dn, concat("@", concat(dv, concat(" but sx.lock has ", lv)))))))
        }
        hold queue = concat(queue, concat(d, "|"))
      }
    }
  }
  give out
}


// ---- entrypoint helpers ---------------------------------------------------
// Each of these replaces one shell construct the wrapper used: a case glob, a
// `command -v`, a cp, a `cd`.

// is_abs: 1 when a path starts at the filesystem root
make is_abs(p: str) -> num {
  when len(p) == 0 {
    give 0
  }
  when sx_index(p, 0) == 47 {
    give 1
  }
  give 0
}

// joined: A/B with a single separator, so "" and "/" tails do not double it
make joined(a: str, b: str) -> str {
  when len(a) == 0 {
    give b
  }
  when sx_index(a, len(a) - 1) == 47 {
    give concat(a, b)
  }
  give concat(a, concat("/", b))
}

// rooted: the path of P inside the project root ROOTDIR.  The wrapper used to
// `cd` into SAYANOX_ROOT; there is no chdir builtin, so every path is built.
make rooted(rootdir: str, p: str) -> str {
  when is_abs(p) == 1 {
    give p
  }
  when string_eq(rootdir, ".") == 1 {
    give p
  }
  when string_eq(rootdir, "") == 1 {
    give p
  }
  give joined(rootdir, p)
}

// starts_with: 1 when TEXT begins with PRE
make starts_with(text: str, pre: str) -> num {
  when len(pre) > len(text) {
    give 0
  }
  hold i = 0
  while i < len(pre) {
    when sx_index(text, i) != sx_index(pre, i) {
      give 0
    }
    hold i = i + 1
  }
  give 1
}

// url_net: 1 for an http(s) target -- the only kind that needs permission
make url_net(u: str) -> num {
  when starts_with(u, "http://") == 1 {
    give 1
  }
  when starts_with(u, "https://") == 1 {
    give 1
  }
  give 0
}

// url_known: 1 when the target is http(s), file://, or a plain path; a target
// with some other scheme is refused rather than silently treated as a path.
make url_known(u: str) -> num {
  when url_net(u) == 1 {
    give 1
  }
  when starts_with(u, "file://") == 1 {
    give 1
  }
  when len(u) >= 3 {
    hold i = 0
    while i < len(u) - 2 {
      when sx_index(u, i) == 58 && sx_index(u, i + 1) == 47 && sx_index(u, i + 2) == 47 {
        give 0
      }
      hold i = i + 1
    }
  }
  give 1
}

// path_find: the full path of the executable NAME on PATH, "" when no
// directory there carries it.  This is what `command -v` did for the wrapper;
// doing it here keeps the choice of transport inside Sayanox.
make path_find(nm: str) -> str {
  hold pth = getenv("PATH")
  hold n = len(pth)
  hold cur = ""
  hold i = 0
  while i <= n {
    hold hit = 0
    when i == n {
      hold hit = 1
    } otherwise {
      when sx_index(pth, i) == 58 {
        hold hit = 1
      } otherwise {
        hold cur = concat(cur, chr(sx_index(pth, i)))
      }
    }
    when hit == 1 {
      hold dir = cur
      when len(dir) == 0 {
        hold dir = "."
      }
      when path_kind(joined(dir, nm)) == 1 {
        give joined(dir, nm)
      }
      hold cur = ""
    }
    hold i = i + 1
  }
  give ""
}

// move_file: the write-then-unlink an `mv` did for the wrapper's staging.
// Copying through a string is safe here because packages are text.
make move_file(srcp: str, dstp: str) -> num {
  when path_kind(srcp) != 1 {
    give 0
  }
  hold body = read_file(srcp)
  hold wrote = write_file(dstp, body)
  hold gone = remove_path(srcp)
  when wrote == 1 {
    give 1
  }
  give 0
}

// download: URL to DESTP through a .part file, so an interrupted transfer can
// never leave a truncated package where a good one belongs.  A local path is a
// read and a write; http(s) is one run_command of curl, or of wget when curl is
// not on PATH.  The status of the transport is the answer -- nothing here
// trusts a partial file.
make download(url: str, destp: str) -> num {
  hold part = concat(destp, ".part")
  hold ok = 0
  when url_net(url) == 1 {
    hold curl = path_find("curl")
    when len(curl) > 0 {
      hold cline = concat(curl, " -fsSL --connect-timeout 10 --max-time 60 \"")
      hold cline = concat(cline, url)
      hold cline = concat(cline, "\" -o \"")
      hold cline = concat(cline, part)
      hold cline = concat(cline, "\"")
      when run_command(cline) == 0 {
        hold ok = 1
      }
    } otherwise {
      hold wget = path_find("wget")
      when len(wget) > 0 {
        hold wline = concat(wget, " -q --timeout=10 --tries=1 -O \"")
        hold wline = concat(wline, part)
        hold wline = concat(wline, "\" \"")
        hold wline = concat(wline, url)
        hold wline = concat(wline, "\"")
        when run_command(wline) == 0 {
          hold ok = 1
        }
      } otherwise {
        show "sxpkg: need curl or wget"
        give 0
      }
    }
  } otherwise {
    hold localp = strip_file_scheme(url)
    when path_kind(localp) != 1 {
      give 0
    }
    hold body = read_file(localp)
    when write_file(part, body) == 1 {
      hold ok = 1
    }
  }
  when ok == 0 {
    hold dropped = remove_path(part)
    give 0
  }
  hold moved = move_file(part, destp)
  give moved
}

// say_err: a diagnostic on stderr, then 1.  The wrapper wrote its refusals
// with `>&2` and the gates read them there; `show` is stdout, so this writes
// /dev/stderr directly, the same way tools/sxdiag.sa reports a failed case.
make say_err(msg: str) -> num {
  hold wrote = write_file("/dev/stderr", concat(msg, "\n"))
  give 1
}

// need_online: the opt-in policy, unchanged from the wrapper.  A file:// URL
// or a plain path is not the network, so it always passes.  Says why, in the
// same words, when it refuses.
make need_online(target: str, optin: num) -> num {
  when url_net(target) == 1 {
    when optin == 1 {
      give 1
    }
    // one write: /dev/stderr is a regular file when the caller redirects it,
    // and a second write would truncate the first
    hold rmsg = "sxpkg: refusing to use the network without an explicit opt-in\n"
    hold rmsg = concat(rmsg, concat("sxpkg:   target: ", concat(target, "\n")))
    hold rmsg = concat(rmsg, "sxpkg: opt in with SAYANOX_ONLINE=1, or 'sxpkg --online <command>'.\n")
    hold rmsg = concat(rmsg, "sxpkg: offline instead: install-local, seed, verify, list, deps, info,\n")
    hold rmsg = concat(rmsg, "sxpkg:   or point SAYANOX_REGISTRY at a local directory (file://...).")
    hold refused = say_err(rmsg)
    give 0
  }
  give 1
}

// ---- the command line -----------------------------------------------------
// `sxpkg --online <command>` used to be read by the shell; the flag is
// consumed here by shifting every argument one place.
hold raw_argn = arg_count()
hold first_arg = ""
when raw_argn >= 2 {
  hold first_arg = arg(1)
}
hold online_shift = 0
when string_eq(first_arg, "--online") {
  hold online_shift = 1
}
hold argn = raw_argn - online_shift
hold command = "help"
hold name = ""
hold version = "0.1.0"
when argn >= 2 {
  hold command = arg(1 + online_shift)
}
when argn >= 3 {
  hold name = arg(2 + online_shift)
}
when argn >= 4 {
  hold version = arg(3 + online_shift)
}

// The project root.  SAYANOX_ROOT used to be a `cd` in the wrapper.
hold root = getenv("SAYANOX_ROOT")
when len(root) == 0 {
  hold root = "."
}
// The network is opt-in: SAYANOX_ONLINE=1 or the --online flag.
hold optin = online_shift
when string_eq(getenv("SAYANOX_ONLINE"), "1") {
  hold optin = 1
}
hold registry_url = getenv("SAYANOX_REGISTRY")
when len(registry_url) == 0 {
  hold registry_url = "https://raw.githubusercontent.com/sayan9168/sayanox/main/registry"
}
// The wrapper ran `cd "$ROOT" && sxpkg ...`, so a root that is not a directory
// failed before anything happened.  There is no chdir here, but the refusal is
// the same one, with the same words: test-pkg-errors pins it.
when string_eq(root, ".") == 0 {
  when path_kind(root) != 2 {
    hold rootmsg = say_err(concat("sxpkg: could not run ", concat(command, concat(" in project ", root))))
    hold root_code = exit(1)
  }
}

// `sync` and `fetch` hand their target to the local-registry blocks instead of
// a flag, because those blocks used to be separate commands.
hold sync_target = ""
hold fetch_src = ""
hold fetch_name = ""
hold fetch_disp = ""
hold fetch_temp = ""


// Shared state is declared at the top level because the maintained compiler
// emits C blocks for when/while scopes.
hold handled = 0
hold is_init = string_eq(command, "init")
hold is_add = string_eq(command, "add")
hold is_list = string_eq(command, "list")
hold is_remove = string_eq(command, "remove")
hold is_search = string_eq(command, "search")
hold is_info = string_eq(command, "info")
hold is_seed = string_eq(command, "seed")
hold is_verify = string_eq(command, "verify")
hold is_sum = string_eq(command, "sum")
hold is_sha = string_eq(command, "sha256")
hold is_sign = string_eq(command, "sign")
hold is_authn = string_eq(command, "authenticate")
hold is_deps = string_eq(command, "deps")
hold is_install = string_eq(command, "install")
hold src = "registry"
hold query = ""
when argn >= 3 {
  hold query = arg(2 + online_shift)
}
hold lock_path = rooted(root, "sx.lock")
hold manifest_path = rooted(root, "sx.toml")
hold registry_path = rooted(root, ".sayanox/registry")
hold index_path = joined(registry_path, "INDEX")
// Signing: the secret comes from SAYANOX_SIGN_KEY, or from a key file --
// SAYANOX_SIGN_KEYFILE, else .sayanox/keys/default.key. No key is not an
// error by itself; it only means signatures cannot be checked here.
hold keys_path = rooted(root, ".sayanox/keys")
hold key_file = getenv("SAYANOX_SIGN_KEYFILE")
when len(key_file) == 0 {
  hold key_file = joined(keys_path, "default.key")
}
hold secret = load_key(key_file)
// SAYANOX_REQUIRE_SIGNED=1 turns `unsigned` and `nokey` into verify failures.
hold require_signed = string_eq(getenv("SAYANOX_REQUIRE_SIGNED"), "1")
hold meta_path = ""
hold index = ""
hold lock = ""
hold manifest = ""
hold result = ""
hold line = ""
hold key = ""
hold lock_len = 0
hold key_len = 0
hold pos = 0
hold c = 0
hold lc = 0
hold j = 0
hold parse_key = 0
hold same = 0
hold replaced = 0
hold removed = 0
hold has_packages = 0
hold found = 0
hold is_comment = 0
hold is_version = 0
hold is_name = 0
hold is_empty = 0
hold line_len = 0
hold first_byte = 0
hold value = ""
hold value_len = 0
hold query_len = 0
hold index_len = 0
hold after_eq = 0
hold match_pos = 0
hold qpos = 0
hold equal = 1
hold scan_match = 0
hold key_byte = 0
hold query_byte = 0
hold name_len = 0
hold invalid = 0
hold reserved = 0
hold last_byte = 0
hold write_status = 0
hold all_ok = 1
// dependency / install state: declared here because the maintained
// compiler emits C blocks for when/while scopes.
hold vres = ""
hold vrest = ""
hold vspec = ""
hold vdn = ""
hold vdv = ""
hold vdlv = ""
hold vwhy = ""
hold ddres = ""
hold ddrest = ""
hold ddspec = ""
hold ddout = ""
hold ddn = 0
hold dires = ""
hold direst = ""
hold dispec = ""
hold diproblems = 0
hold dinm = ""
hold divr = ""
hold diwhy = ""
hold dismeta = ""
hold disver = ""
hold dissa = ""
hold diswant = ""
hold disgot = ""
hold diw1 = 0
hold diw2 = 0
hold pkg_path = rooted(root, ".sayanox/pkgs")
hold is_publish = string_eq(command, "publish")
hold is_install_local = string_eq(command, "install-local")
hold is_sync_local = string_eq(command, "sync-local")
hold is_fetch_local = string_eq(command, "fetch-local")
hold is_ensure_dir = string_eq(command, "ensure-dir")
hold is_rm_tree = string_eq(command, "rm-tree")
hold is_copy_tree = string_eq(command, "copy-tree")
hold is_sync = string_eq(command, "sync")
hold is_fetch = string_eq(command, "fetch")

// Wrapper state, declared at the top level for the same reason as the state
// above: the maintained compiler emits C blocks for when/while scopes, so a
// first declaration inside one of them would not be visible outside it.
hold incode = 0
hold inlock = ""
hold inmk = 0
hold inlast = 0
hold inspecs = ""
hold inrest = ""
hold inbad = 0
hold inone = ""
hold innm = ""
hold inrest2 = ""
hold inone2 = ""
hold innm2 = ""
hold inhall = 0
hold inmk2 = 0
hold ingot1 = 0
hold ingot2 = 0
hold infetched = ""
hold inrest3 = ""
hold inone3 = ""
hold innm3 = ""
hold invr3 = ""
hold inwhy3 = ""
hold insrc3 = ""
hold indst3 = ""
hold inmk3 = 0
hold incp3 = 0
hold inproblems = 0
hold inrest4 = ""
hold inone4 = ""
hold innm4 = ""
hold invr4 = ""
hold inwhy4 = ""
hold inrest5 = ""
hold inone5 = ""
hold innm5 = ""
hold inr51 = 0
hold inr52 = 0
hold incount = 0
hold inrest6 = ""
hold inone6 = ""
hold sy2target = ""
hold sy2code = 0
hold sy2mk = 0
hold sy2tmp = ""
hold sy2got = 0
hold sy2rm0 = 0
hold sy2idx = ""
hold sy2specs = ""
hold sy2scan = ""
hold sy2bad = 0
hold sy2one = ""
hold sy2nm = ""
hold sy2rm1 = 0
hold sy2w = 0
hold sy2rm2 = 0
hold sy2rest = ""
hold sy2one2 = ""
hold sy2nm2 = ""
hold sy2vr2 = ""
hold sy2mk2 = 0
hold sy2d1 = 0
hold sy2d2 = 0
hold sy2rm3 = 0
hold ft2url = ""
hold ft2name = ""
hold ft2code = 0
hold ft2has = 0
hold ft2lk = ""
hold ft2mk = 0
hold ft2mk2 = 0
hold ft2stage = ""
hold ft2got = 0
hold ft2rm = 0

// ---- the wrapper's own commands -------------------------------------------
// `install` with no argument is the one the shell wrapper answered: preflight
// the lock, fetch only what the registry copy is missing, copy the rest out of
// the cache, and accept the result only when every locked package verifies.
// `install <registry>` above stays the direct-source install, which is the
// behaviour test-pkgs pins.
when is_install == 1 && argn < 3 {
  hold handled = 1
  hold inlock = read_file(lock_path)
  when len(inlock) == 0 {
    show "sxpkg: no sx.lock; run init/add"
    hold incode = exit(1)
  }
  hold inmk = ensure_dir(pkg_path)
  hold inlast = sx_idx(inlock, len(inlock) - 1)
  when inlast != 10 {
    hold inlock = concat(inlock, "\n")
  }
  hold inspecs = lock_specs(inlock, len(inlock))
  // a lock line with an unsafe name refuses before any path is built from it
  hold inrest = inspecs
  hold inbad = 0
  while len(inrest) > 0 {
    hold inone = take_field(inrest)
    hold inrest = drop_field(inrest)
    hold innm = dep_name(inone)
    when package_name_ok(innm) == 0 {
      show concat("sxpkg: refusing unsafe package name '", concat(innm, "'"))
      hold inbad = 1
    }
  }
  when inbad == 1 {
    hold incode = exit(1)
  }
  // Fetch only what is missing: a complete cache transfers nothing, which is
  // why an offline `install` needs no permission.
  hold infetched = ""
  hold inrest2 = inspecs
  while len(inrest2) > 0 {
    hold inone2 = take_field(inrest2)
    hold inrest2 = drop_field(inrest2)
    hold innm2 = dep_name(inone2)
    hold inhall = 0
    when package_name_ok(innm2) == 1 {
      when path_kind(concat(concat(registry_path, "/"), concat(innm2, "/pkg.meta"))) == 1 {
        when path_kind(concat(concat(registry_path, "/"), concat(innm2, "/main.sa"))) == 1 {
          hold inhall = 1
        }
      }
    }
    when inhall == 0 && package_name_ok(innm2) == 1 {
      when need_online(registry_url, optin) == 0 {
        hold incode = exit(1)
      }
      hold inmk2 = ensure_dir(concat(concat(registry_path, "/"), innm2))
      hold ingot1 = download(concat(concat(concat(registry_url, "/"), innm2), "/pkg.meta"), concat(concat(concat(registry_path, "/"), innm2), "/pkg.meta"))
      when ingot1 == 0 {
        show concat("sxpkg: could not fetch ", concat(innm2, concat("/pkg.meta from ", registry_url)))
      }
      hold ingot2 = download(concat(concat(concat(registry_url, "/"), innm2), "/main.sa"), concat(concat(concat(registry_path, "/"), innm2), "/main.sa"))
      when ingot2 == 0 {
        show concat("sxpkg: could not fetch ", concat(innm2, concat("/main.sa from ", registry_url)))
      }
      hold infetched = concat(infetched, concat(" ", innm2))
    }
  }
  // copy and report whatever is complete now
  hold inrest3 = inspecs
  hold inproblems = 0
  while len(inrest3) > 0 {
    hold inone3 = take_field(inrest3)
    hold inrest3 = drop_field(inrest3)
    hold innm3 = dep_name(inone3)
    hold invr3 = dep_ver(inone3)
    hold inwhy3 = check_pkg(innm3, invr3, registry_path)
    when len(inwhy3) == 0 {
      hold insrc3 = concat(concat(registry_path, "/"), innm3)
      hold indst3 = concat(concat(pkg_path, "/"), innm3)
      hold inmk3 = ensure_dir(indst3)
      hold incp3 = copy_tree(insrc3, indst3)
      when incp3 == 1 {
        show concat("sxpkg: installed ", concat(innm3, concat(" -> ", indst3)))
      } otherwise {
        show concat("sxpkg: FAILED installing ", innm3)
        hold inproblems = inproblems + 1
      }
    } otherwise {
      show concat("sxpkg: missing ", concat(innm3, " in registry"))
      hold inproblems = inproblems + 1
    }
  }
  // the transport is not trusted; the checksum is the acceptance test
  hold inrest4 = inspecs
  while len(inrest4) > 0 {
    hold inone4 = take_field(inrest4)
    hold inrest4 = drop_field(inrest4)
    hold innm4 = dep_name(inone4)
    hold invr4 = dep_ver(inone4)
    hold inwhy4 = check_pkg(innm4, invr4, registry_path)
    when len(inwhy4) > 0 {
      show concat("sxpkg: verify FAILED ", concat(innm4, concat(": ", inwhy4)))
      hold inproblems = inproblems + 1
    }
  }
  when inproblems == 0 {
    // the wrapper ran `verify` after installing and printed its report; the
    // acceptance line is that every locked package matches its checksum
    hold incount = 0
    hold inrest6 = inspecs
    while len(inrest6) > 0 {
      hold inone6 = take_field(inrest6)
      hold inrest6 = drop_field(inrest6)
      hold incount = incount + 1
    }
    show concat("sxpkg: verify ok (", concat(numstr(incount), " locked packages)"))
    show "sxpkg: install done"
  } otherwise {
    // a rejected download never stays behind in the registry or the project
    hold inrest5 = inspecs
    while len(inrest5) > 0 {
      hold inone5 = take_field(inrest5)
      hold inrest5 = drop_field(inrest5)
      hold innm5 = dep_name(inone5)
      hold inr51 = rm_tree(concat(concat(registry_path, "/"), innm5))
      hold inr52 = rm_tree(concat(concat(pkg_path, "/"), innm5))
    }
    when len(infetched) > 0 {
      show concat("sxpkg: rejected and removed downloaded:", infetched)
    }
    hold incode = exit(1)
  }
}

// sync: a local registry is the sync-local code path below; an http(s) one
// downloads INDEX first and one pkg.meta and main.sa per name after it, and
// replaces the INDEX only once every name in the new one has passed the
// package-name check, so a hostile index can neither escape the registry nor
// destroy the one already installed.
when is_sync == 1 {
  hold handled = 1
  hold sy2target = arg(2 + online_shift)
  when len(sy2target) == 0 {
    hold sy2target = registry_url
  }
  when url_known(sy2target) == 0 {
    hold syscheme = say_err("sxpkg: unsupported transfer scheme (use http, https, file or a path)")
    hold sy2code = exit(1)
  }
  when url_net(sy2target) == 0 {
    hold sync_target = sy2target
    hold is_sync_local = 1
  } otherwise {
    when need_online(sy2target, optin) == 0 {
      hold sy2code = exit(1)
    }
    hold sy2mk = ensure_dir(registry_path)
    show concat("sxpkg: sync from ", sy2target)
    hold sy2tmp = concat(registry_path, "/.sync.index")
    hold sy2got = download(concat(sy2target, "/INDEX"), sy2tmp)
    when sy2got == 0 {
      hold sy2rm0 = remove_path(sy2tmp)
      show "sxpkg: online sync failed; using local seed"
      hold is_seed = 1
    } otherwise {
      hold sy2idx = read_file(sy2tmp)
      hold sy2specs = lock_specs(sy2idx, len(sy2idx))
      hold sy2scan = sy2specs
      hold sy2bad = 0
      while len(sy2scan) > 0 {
        hold sy2one = take_field(sy2scan)
        hold sy2scan = drop_field(sy2scan)
        hold sy2nm = dep_name(sy2one)
        when package_name_ok(sy2nm) == 0 {
          show concat("sxpkg: refusing unsafe package name '", concat(sy2nm, "'"))
          hold sy2bad = 1
        }
      }
      when sy2bad == 1 {
        hold sy2rm1 = remove_path(sy2tmp)
        hold sybad2 = say_err("sxpkg: rejected index with unsafe package name")
        hold sy2code = exit(1)
      }
      hold sy2w = write_file(index_path, sy2idx)
      when sy2w == 0 {
        hold sy2rm2 = remove_path(sy2tmp)
        show "sxpkg: FAILED writing the registry index"
        hold sy2code = exit(1)
      }
      show "sxpkg: index updated"
      hold sy2rest = sy2specs
      while len(sy2rest) > 0 {
        hold sy2one2 = take_field(sy2rest)
        hold sy2rest = drop_field(sy2rest)
        hold sy2nm2 = dep_name(sy2one2)
        hold sy2vr2 = dep_ver(sy2one2)
        hold sy2mk2 = ensure_dir(concat(concat(registry_path, "/"), sy2nm2))
        hold sy2d1 = download(concat(concat(concat(sy2target, "/"), sy2nm2), "/pkg.meta"), concat(concat(concat(registry_path, "/"), sy2nm2), "/pkg.meta"))
        hold sy2d2 = download(concat(concat(concat(sy2target, "/"), sy2nm2), "/main.sa"), concat(concat(concat(registry_path, "/"), sy2nm2), "/main.sa"))
        show concat("  synced ", concat(sy2nm2, concat("=", sy2vr2)))
      }
      hold sy2rm3 = remove_path(sy2tmp)
    }
  }
}

// fetch: every check the wrapper made happens before a single byte moves, and
// a local source is the fetch-local code path below.  A remote one is
// downloaded into a staging file inside the registry and handed to the same
// code, so the checksum, the rollback and the refusal of an existing package
// are shared rather than duplicated.
when is_fetch == 1 {
  hold handled = 1
  hold ft2url = arg(2 + online_shift)
  hold ft2name = arg(3 + online_shift)
  when len(ft2name) == 0 {
    hold ft2name = "remote_pkg"
  }
  when len(ft2url) == 0 {
    show "usage: sxpkg fetch <url> [name]"
    hold ft2code = exit(1)
  }
  when package_name_ok(ft2name) == 0 {
    hold ftbad = say_err("sxpkg: invalid fetch name")
    hold ft2code = exit(1)
  }
  // never silently replace a cache, a project copy or a differently pinned lock
  hold ft2has = 0
  when path_kind(concat(concat(registry_path, "/"), ft2name)) != 0 {
    hold ft2has = 1
  }
  when path_kind(concat(concat(pkg_path, "/"), ft2name)) != 0 {
    hold ft2has = 1
  }
  hold ft2lk = read_file(lock_path)
  when len(lock_ver(ft2lk, len(ft2lk), ft2name)) > 0 {
    hold ft2has = 1
  }
  when ft2has == 1 {
    hold ftdup = say_err(concat("sxpkg: fetch refuses existing package/lock '", concat(ft2name, "'")))
    hold ft2code = exit(1)
  }
  when url_known(ft2url) == 0 {
    hold ftscheme = say_err("sxpkg: unsupported transfer scheme (use http, https, file or a path)")
    hold ft2code = exit(1)
  }
  when url_net(ft2url) == 0 {
    hold fetch_src = strip_file_scheme(ft2url)
    hold fetch_name = ft2name
    hold fetch_disp = ft2url
    hold is_fetch_local = 1
  } otherwise {
    when need_online(ft2url, optin) == 0 {
      hold ft2code = exit(1)
    }
    hold ft2mk = ensure_dir(registry_path)
    hold ft2mk2 = ensure_dir(pkg_path)
    hold ft2stage = concat(registry_path, "/.fetch.stage")
    hold ft2got = download(ft2url, ft2stage)
    when ft2got == 0 {
      hold ft2rm = remove_path(ft2stage)
      show concat("sxpkg: FAILED fetching ", ft2name)
      hold ft2code = exit(1)
    }
    hold fetch_src = ft2stage
    hold fetch_name = ft2name
    hold fetch_disp = ft2url
    hold fetch_temp = ft2stage
    hold is_fetch_local = 1
  }
}

when is_init == 1 {
  hold handled = 1
  hold init_mk1 = ensure_dir(registry_path)
  hold init_mk2 = ensure_dir(pkg_path)
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    hold write_status = write_file(lock_path, "# sx.lock\nversion=1\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  hold manifest = read_file(manifest_path)
  hold lock_len = len(manifest)
  when lock_len == 0 {
    hold write_status = write_file(manifest_path, "name = \"my-pkg\"\nversion = \"0.1.0\"\n")
    when write_status == 0 {
      hold all_ok = 0
    }
  }
  when all_ok == 1 {
    show "sxpkg: init ok"
  } otherwise {
    show "sxpkg: init failed to write project files"
  }
  // an empty registry gets the offline seed, exactly as the wrapper did
  when path_kind(index_path) != 1 {
    hold is_seed = 1
  }
}

when string_eq(command, "check-name") {
  hold handled = 1
  when package_name_ok(name) {
    show "sxpkg: package name ok"
  } otherwise {
    show "sxpkg: FAILED invalid or reserved package name (use letters, digits, hyphen, underscore)"
  }
}

when is_add == 1 {
  hold handled = 1
  hold add_mk1 = ensure_dir(registry_path)
  hold add_mk2 = ensure_dir(pkg_path)
  when argn < 3 {
    show "usage: sxpkg add <name> [version]"
  } otherwise {
    hold invalid = 1 - package_name_ok(name)
    when invalid == 1 {
      show "sxpkg: FAILED invalid or reserved package name"
    } otherwise {
      hold lock = read_file(lock_path)
      hold lock_len = len(lock)
      when lock_len == 0 {
        hold lock = "# sx.lock\nversion=1\n"
      }
      hold lock_len = len(lock)
      when lock_len > 0 {
        hold last_byte = sx_idx(lock, lock_len - 1)
        when last_byte != 10 {
          hold lock = concat(lock, "\n")
        }
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold replaced = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            when replaced == 0 {
              hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
              hold replaced = 1
            }
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when replaced == 0 {
        hold result = concat(result, concat(concat(name, "="), concat(version, "\n")))
      }
      // pull in what the package declares in `deps=`, transitively, so
      // `deps` and `install` see a complete set.  Packages that are not
      // installed or present anywhere yet contribute nothing here.
      hold dlist = discover(concat(name, concat("@", version)), src, registry_path)
      hold drest = dlist
      while len(drest) > 0 {
        hold done = take_field(drest)
        hold drest = drop_field(drest)
        hold adn = dep_name(done)
        hold adv = dep_ver(done)
        hold alv = lock_ver(result, len(result), adn)
        when len(alv) == 0 {
          hold result = concat(result, concat(adn, concat("=", concat(adv, "\n"))))
          show concat(concat("sxpkg: locked ", concat(adn, concat(" ", adv))), concat(" (dependency of ", concat(name, ")")))
        }
      }
      hold write_status = write_file(lock_path, result)
      when write_status == 1 {
        show concat("sxpkg: locked ", concat(name, concat(" ", version)))
        // Sayanox locks any name it is given; say so when the registry has no
        // copy, so an offline user is not surprised by `verify` later
        when path_kind(concat(concat(registry_path, "/"), concat(name, "/pkg.meta"))) != 1 {
          show concat("sxpkg: note: ", concat(name, " has no local registry copy yet (run: sxpkg seed; or sxpkg sync when online)"))
        }
      } otherwise {
        show "sxpkg: failed to write sx.lock"
      }
    }
  }
}

when is_list == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold result = "sxpkg: locked packages"
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < lock_len {
      hold c = sx_idx(lock, pos)
      when c == 10 {
        hold key = ""
        hold key_len = len(line)
        hold j = 0
        hold parse_key = 1
        while parse_key == 1 {
          when j < key_len {
            hold lc = sx_idx(line, j)
            when lc == 61 {
              hold parse_key = 0
            } otherwise {
              hold key = concat(key, chr(lc))
              hold j = j + 1
            }
          } otherwise {
            hold parse_key = 0
          }
        }
        hold is_version = string_eq(key, "version")
        hold is_name = string_eq(key, "name")
        hold is_empty = string_eq(line, "")
        hold is_comment = 0
        hold line_len = len(line)
        when line_len > 0 {
          hold first_byte = sx_idx(line, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        when is_version == 0 && is_name == 0 && is_empty == 0 && is_comment == 0 {
          hold result = concat(result, concat("\n", line))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n(none)")
    }
    show result
  }
}

when is_search == 1 {
  hold handled = 1
  hold index = read_file(index_path)
  hold index_len = len(index)
  when index_len == 0 {
    hold noidx = say_err("sxpkg: no local index; run seed (offline) or sync (explicit network)")
    hold search_code = exit(1)
  } otherwise {
    hold last_byte = sx_idx(index, index_len - 1)
    when last_byte != 10 {
      hold index = concat(index, "\n")
    }
    hold index_len = len(index)
    hold query_len = len(query)
    hold result = concat("sxpkg: search ", query)
    hold has_packages = 0
    hold line = ""
    hold pos = 0
    while pos < index_len {
      hold c = sx_idx(index, pos)
      when c == 10 {
        hold key = ""
        hold value = ""
        hold after_eq = 0
        hold line_len = len(line)
        hold j = 0
        while j < line_len {
          hold lc = sx_idx(line, j)
          when lc == 61 {
            hold after_eq = 1
          } otherwise {
            when after_eq == 1 {
              hold value = concat(value, chr(lc))
            } otherwise {
              hold key = concat(key, chr(lc))
            }
          }
          hold j = j + 1
        }
        hold key_len = len(key)
        hold same = string_eq(key, "version")
        hold is_version = same
        hold same = string_eq(key, "name")
        hold is_name = same
        hold is_empty = string_eq(key, "")
        hold is_comment = 0
        when key_len > 0 {
          hold first_byte = sx_idx(key, 0)
          when first_byte == 35 {
            hold is_comment = 1
          }
        }
        hold found = 0
        when query_len == 0 {
          hold found = 1
        } otherwise {
          hold match_pos = 0
          hold scan_match = 1
          while scan_match == 1 {
            when match_pos + query_len <= key_len {
              hold equal = 1
              hold qpos = 0
              while qpos < query_len && equal == 1 {
                hold key_byte = sx_idx(key, match_pos + qpos)
                hold query_byte = sx_idx(query, qpos)
                when key_byte != query_byte {
                  hold equal = 0
                }
                hold qpos = qpos + 1
              }
              when equal == 1 {
                hold found = 1
                hold scan_match = 0
              } otherwise {
                hold match_pos = match_pos + 1
              }
            } otherwise {
              hold scan_match = 0
            }
          }
        }
        when found == 1 && is_version == 0 && is_name == 0 && is_comment == 0 && is_empty == 0 {
          hold result = concat(result, concat("\n  ", concat(key, concat(" ", value))))
          hold has_packages = 1
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    when has_packages == 0 {
      hold result = concat(result, "\n  (no matches)")
    }
    show result
  }
}

when is_info == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg info <name>"
  } otherwise {
    hold meta_path = concat(concat(registry_path, "/"), concat(name, "/pkg.meta"))
    hold manifest = read_file(meta_path)
    hold lock_len = len(manifest)
    when lock_len == 0 {
      show concat("unknown ", concat(name, " - try: sxpkg sync and search"))
    } otherwise {
      show manifest
    }
  }
}

// sync-local: refresh the local registry from another local registry directory
// (`SAYANOX_REGISTRY=file:///reg` or a plain path).  The INDEX is only written
// after every name in it has passed package_name_ok, so a hostile index can
// neither escape the registry nor destroy the one already installed.  The
// wrapper keeps the http(s) branch, which needs curl or wget.
when is_sync_local == 1 {
  hold handled = 1
  hold syurl = arg(2 + online_shift)
  when len(syurl) == 0 {
    hold syurl = sync_target
  }
  hold sydir = strip_file_scheme(syurl)
  hold sycode = 0
  hold syok = ensure_dir(registry_path)
  show concat("sxpkg: sync from ", syurl)
  hold syidx = read_file(concat(concat(sydir, "/"), "INDEX"))
  when len(syidx) == 0 {
    show "sxpkg: sync failed; using local seed"
    hold is_seed = 1
  } otherwise {
    hold syrest = lock_specs(syidx, len(syidx))
    hold sybad = 0
    while len(syrest) > 0 {
      hold syone = take_field(syrest)
      hold syrest = drop_field(syrest)
      hold synm = dep_name(syone)
      when package_name_ok(synm) == 0 {
        show concat("sxpkg: refusing unsafe package name '", concat(synm, "'"))
        hold sybad = 1
      }
    }
    when sybad == 1 {
      show "sxpkg: rejected index with unsafe package name"
      hold sycode = exit(1)
    } otherwise {
      hold syw0 = write_file(index_path, syidx)
      when syw0 == 0 {
        show "sxpkg: FAILED writing the registry index"
        hold sycode = exit(1)
      } otherwise {
        show "sxpkg: index updated"
        hold syrest2 = lock_specs(syidx, len(syidx))
        while len(syrest2) > 0 {
          hold syone2 = take_field(syrest2)
          hold syrest2 = drop_field(syrest2)
          hold synm2 = dep_name(syone2)
          hold syvr2 = dep_ver(syone2)
          hold syok2 = ensure_dir(concat(concat(registry_path, "/"), synm2))
          hold symeta = read_file(concat(concat(concat(sydir, "/"), synm2), "/pkg.meta"))
          when len(symeta) > 0 {
            hold syw1 = write_file(concat(concat(concat(registry_path, "/"), synm2), "/pkg.meta"), symeta)
            when syw1 == 0 {
              hold syok2 = 0
            }
          }
          hold symain = read_file(concat(concat(concat(sydir, "/"), synm2), "/main.sa"))
          when len(symain) > 0 {
            hold syw2 = write_file(concat(concat(concat(registry_path, "/"), synm2), "/main.sa"), symain)
            when syw2 == 0 {
              hold syok2 = 0
            }
          }
          when syok2 == 1 {
            show concat("  synced ", concat(synm2, concat("=", syvr2)))
          } otherwise {
            show concat("sxpkg: FAILED syncing ", synm2)
            hold sycode = exit(1)
          }
        }
      }
    }
  }
}

when is_seed == 1 {
  hold handled = 1
  hold all_ok = 1
  // the seed packages live in their own folders; the wrapper used to mkdir them
  hold seed_d1 = ensure_dir(concat(concat(registry_path, "/"), "hello"))
  hold seed_d2 = ensure_dir(concat(concat(registry_path, "/"), "math"))
  when seed_d1 == 0 || seed_d2 == 0 {
    hold all_ok = 0
  }
  hold hello_src = "show \"hello from pkg\"\n"
  hold math_src = "make dbl(n) {\n  give n + n\n}\nmake sqr(n) {\n  give n * n\n}\n"
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/main.sa"), hello_src)
  when write_status == 0 { hold all_ok = 0 }
  hold hello_meta = concat("name=hello\nversion=0.1.0\ndesc=hello world sample\nsum=", concat(decstr(pkgsum(hello_src)), "\n"))
  hold hello_meta = concat(hello_meta, concat("sha256=", concat(pkgsha(hello_src), "\n")))
  hold hello_meta = concat(hello_meta, "origin=seed:builtin\n")
  hold write_status = write_file(concat(concat(registry_path, "/hello"), "/pkg.meta"), hello_meta)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/main.sa"), math_src)
  when write_status == 0 { hold all_ok = 0 }
  hold math_meta = concat("name=math\nversion=0.1.0\ndesc=tiny math helpers (dbl, sqr)\nsum=", concat(decstr(pkgsum(math_src)), "\n"))
  hold math_meta = concat(math_meta, concat("sha256=", concat(pkgsha(math_src), "\n")))
  hold math_meta = concat(math_meta, "origin=seed:builtin\n")
  hold write_status = write_file(concat(concat(registry_path, "/math"), "/pkg.meta"), math_meta)
  when write_status == 0 { hold all_ok = 0 }
  hold write_status = write_file(index_path, "hello=0.1.0\nmath=0.1.0\n")
  when write_status == 0 { hold all_ok = 0 }
  when all_ok == 1 {
    show "sxpkg: local registry seeded"
  } otherwise {
    show "sxpkg: seed failed; run the wrapper to create registry folders"
  }
}

when is_remove == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg remove <name>"
  } otherwise {
    hold lock = read_file(lock_path)
    hold lock_len = len(lock)
    when lock_len == 0 {
      show "sxpkg: no sx.lock"
    } otherwise {
      hold last_byte = sx_idx(lock, lock_len - 1)
      when last_byte != 10 {
        hold lock = concat(lock, "\n")
      }
      hold lock_len = len(lock)
      hold result = ""
      hold line = ""
      hold pos = 0
      hold removed = 0
      while pos < lock_len {
        hold c = sx_idx(lock, pos)
        when c == 10 {
          hold key = ""
          hold key_len = len(line)
          hold j = 0
          hold parse_key = 1
          while parse_key == 1 {
            when j < key_len {
              hold lc = sx_idx(line, j)
              when lc == 61 {
                hold parse_key = 0
              } otherwise {
                hold key = concat(key, chr(lc))
                hold j = j + 1
              }
            } otherwise {
              hold parse_key = 0
            }
          }
          hold same = string_eq(key, name)
          when same == 1 {
            hold removed = 1
          } otherwise {
            hold result = concat(result, concat(line, "\n"))
          }
          hold line = ""
        } otherwise {
          hold line = concat(line, chr(c))
        }
        hold pos = pos + 1
      }
      when removed == 1 {
        hold write_status = write_file(lock_path, result)
        when write_status == 1 {
          show concat("sxpkg: removed ", name)
          when path_kind(concat(concat(pkg_path, "/"), name)) != 0 {
            hold rm_pkg = rm_tree(concat(concat(pkg_path, "/"), name))
          }
        } otherwise {
          show "sxpkg: failed to write sx.lock"
        }
      } otherwise {
        show concat("sxpkg: not locked: ", name)
      }
    }
  }
}

// sum <file>: the checksum `pkgsum` gives a file (used when writing pkg.meta)
when is_sum == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg sum <file>"
  } otherwise {
    hold src = read_file(name)
    when len(src) == 0 {
      show concat("sxpkg: cannot read ", name)
    } otherwise {
      show concat("sxpkg: sum ", concat(decstr(pkgsum(src)), concat(" ", name)))
    }
  }
}

// sha256 <file>: the cryptographic digest of a file's bytes, computed by
// stdlib/crypto.sa. This is the number `publish`, `seed` and `fetch` write
// into pkg.meta as sha256= and `verify` checks.
when is_sha == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg sha256 <file>"
  } otherwise {
    hold shsrc = read_file(name)
    when len(shsrc) == 0 {
      show concat("sxpkg: cannot read ", name)
    } otherwise {
      show concat("sxpkg: sha256 ", concat(pkgsha(shsrc), concat(" ", name)))
    }
  }
}

// sign <name>: hash the registry copy of NAME, write sha256=, signer= and
// sig= into its pkg.meta. The signature is HMAC-SHA256 over
// `sayanox-pkg-v1 / name / version / sha256`, so it cannot be replayed under
// a different name or version.
when is_sign == 1 {
  hold handled = 1
  when argn < 3 {
    show "usage: sxpkg sign <name>"
  } otherwise {
    when len(secret) == 0 {
      show "sxpkg: no signing key; set SAYANOX_SIGN_KEY or write .sayanox/keys/default.key"
      hold sign_code1 = exit(1)
    } otherwise {
      hold sgdir = concat(concat(registry_path, "/"), name)
      hold sgmain = concat(sgdir, "/main.sa")
      hold sgmetap = concat(sgdir, "/pkg.meta")
      when path_kind(sgmain) != 1 {
        show concat("sxpkg: no registry copy of ", name)
        hold sign_code2 = exit(1)
      } otherwise {
        hold sgsrc = read_file(sgmain)
        hold sgmeta = read_file(sgmetap)
        hold sgver = pkgfield(sgmeta, "version")
        when len(sgver) == 0 {
          hold sgver = "0.0.0"
        }
        hold sgdigest = pkgsha(sgsrc)
        hold sgmeta = meta_set(sgmeta, "sha256", sgdigest)
        hold sgmeta = meta_set(sgmeta, "signer", key_id(secret))
        hold sgsig = cx_hmac(secret, sign_record(name, sgver, sgdigest))
        hold sgmeta = meta_set(sgmeta, "sig", sgsig)
        when write_file(sgmetap, sgmeta) == 0 {
          show concat("sxpkg: cannot write ", sgmetap)
          hold sign_code3 = exit(1)
        } otherwise {
          show concat("sxpkg: signed ", concat(name, concat(" ", sgver)))
          show concat("  sha256=", sgdigest)
          show concat("  signer=", key_id(secret))
          show concat("  sig=", sgsig)
        }
      }
    }
  }
}

// authenticate [name]: check the signature of one package, or of every
// package in the registry. A tampered main.sa, a tampered sha256=, a
// signature made with another key and a package signed under another name
// all end here as FAILED.
when is_authn == 1 {
  hold handled = 1
  hold auproblems = 0
  hold auchecked = 0
  hold aulist = ""
  when len(name) > 0 {
    hold aulist = concat(name, "\n")
  } otherwise {
    hold aulist = read_dir(registry_path)
    when len(aulist) > 0 {
      when sx_index(aulist, len(aulist) - 1) != 10 {
        hold aulist = concat(aulist, "\n")
      }
    }
  }
  hold aupos = 0
  hold auline = ""
  while aupos < len(aulist) {
    hold auc = sx_index(aulist, aupos)
    when auc == 10 {
      when len(auline) > 0 {
        hold audir = concat(concat(registry_path, "/"), auline)
        when path_kind(audir) == 2 {
          hold auchecked = auchecked + 1
          hold austat = check_sig(auline, registry_path, secret)
          when string_eq(austat, "signed") == 1 {
            show concat("sxpkg: authentic ", concat(auline, concat(" signer=", pkgfield(read_file(concat(audir, "/pkg.meta")), "signer"))))
          } otherwise {
            when string_eq(austat, "unsigned") == 1 {
              show concat("sxpkg: UNSIGNED ", auline)
              when require_signed == 1 {
                hold auproblems = auproblems + 1
              }
            } otherwise {
              when string_eq(austat, "nokey") == 1 {
                show concat("sxpkg: NOKEY ", concat(auline, " (signed; no key here to check it)"))
                when require_signed == 1 {
                  hold auproblems = auproblems + 1
                }
              } otherwise {
                show concat("sxpkg: FAILED ", concat(auline, concat(": ", austat)))
                hold auproblems = auproblems + 1
              }
            }
          }
        }
      }
      hold auline = ""
    } otherwise {
      hold auline = concat(auline, chr(auc))
    }
    hold aupos = aupos + 1
  }
  when auchecked == 0 {
    show "sxpkg: nothing to authenticate"
  }
  when auproblems == 0 {
    show concat("sxpkg: authenticate ok (", concat(numstr(auchecked), " packages)"))
  } otherwise {
    show concat("sxpkg: authenticate FAILED (", concat(numstr(auproblems), " problem(s))"))
    hold authn_code = exit(1)
  }
}

// verify: every sx.lock entry must match its registry copy (version and sum)
when is_verify == 1 {
  hold handled = 1
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_index(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold checked = 0
    hold problems = 0
    hold pos = 0
    hold line = ""
    while pos < lock_len {
      hold c = sx_index(lock, pos)
      when c == 10 {
        hold vkey = line_key(line)
        hold vval = line_val(line)
        hold vlen = len(line)
        when vlen > 0 && sx_index(line, 0) != 35 && string_eq(vkey, "version") == 0 && string_eq(vkey, "name") == 0 {
          when len(vkey) == 0 || len(vval) == 0 || len(line) == len(vkey) {
            hold problems = problems + 1
            show concat("sxpkg: MISMATCH malformed lock line: ", line)
          } otherwise {
            hold checked = checked + 1
            hold why = check_pkg(vkey, vval, registry_path)
            when len(why) == 0 {
              show concat("sxpkg: verified ", concat(vkey, concat(" ", vval)))
              // The signature is reported only when there is something to
              // report: a signed package, or a run that demanded signatures.
              // An unsigned registry prints exactly what it printed before.
              hold vstat = check_sig(vkey, registry_path, secret)
              when string_eq(vstat, "signed") == 1 {
                show concat("sxpkg: signature ok ", vkey)
              } otherwise {
                when string_eq(vstat, "unsigned") == 1 {
                  when require_signed == 1 {
                    hold problems = problems + 1
                    show concat("sxpkg: UNSIGNED ", vkey)
                  }
                } otherwise {
                  when string_eq(vstat, "nokey") == 1 {
                    show concat("sxpkg: NOKEY ", concat(vkey, " (signed; no key here to check it)"))
                    when require_signed == 1 {
                      hold problems = problems + 1
                    }
                  } otherwise {
                    hold problems = problems + 1
                    show concat("sxpkg: SIGNATURE ", concat(vkey, concat(": ", vstat)))
                  }
                }
              }
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vkey, concat(": ", why)))
            }
          }
        }
        hold line = ""
      } otherwise {
        hold line = concat(line, chr(c))
      }
      hold pos = pos + 1
    }
    // the dependency closure: every package a locked package declares in
    // `deps=` must itself be present, and only the ones pulled in
    // transitively (not already counted above) are reported here.
    hold vres = resolve(lock, "", lock_len, registry_path)
    when len(vres) > 0 {
      when sx_index(vres, 0) == 33 {
        hold problems = problems + 1
        show concat("sxpkg: DEP ", tail1(vres))
      } otherwise {
        hold vrest = vres
        while len(vrest) > 0 {
          hold vspec = take_field(vrest)
          hold vrest = drop_field(vrest)
          hold vdn = dep_name(vspec)
          hold vdv = dep_ver(vspec)
          hold vdlv = lock_ver(lock, lock_len, vdn)
          when len(vdlv) == 0 {
            hold checked = checked + 1
            hold vwhy = check_pkg(vdn, vdv, registry_path)
            when len(vwhy) == 0 {
              show concat("sxpkg: verified ", concat(vdn, concat(" ", vdv)))
            } otherwise {
              hold problems = problems + 1
              show concat("sxpkg: MISMATCH ", concat(vdn, concat(": ", vwhy)))
            }
          }
        }
      }
    }
    when problems == 0 {
      show concat("sxpkg: verify ok (", concat(numstr(checked), " locked packages)"))
    } otherwise {
      show concat("sxpkg: verify FAILED (", concat(numstr(problems), " problem(s))"))
      hold verify_code = exit(1)
    }
  }
}

// deps: the transitive dependency closure of the locked packages, resolved
// offline from the local registry copies.
when is_deps == 1 {
  hold handled = 1
  hold src = rooted(root, src)
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold ddres = resolve(lock, src, lock_len, registry_path)
    when sx_index(ddres, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(ddres))
    } otherwise {
      hold ddout = "sxpkg: dependency closure"
      hold ddrest = ddres
      hold ddn = 0
      while len(ddrest) > 0 {
        hold ddspec = take_field(ddrest)
        hold ddrest = drop_field(ddrest)
        hold ddn = ddn + 1
        hold ddout = concat(ddout, concat("\n  ", concat(dep_name(ddspec), concat(" ", dep_ver(ddspec)))))
      }
      when ddn == 0 {
        hold ddout = concat(ddout, "\n  (none)")
      }
      show ddout
    }
  }
}

// install-local: the offline install.  It preflights every locked name, creates
// .sayanox/registry/<name>/ and .sayanox/pkgs/<name>/ for each of them, and
// then runs the install logic against a local registry directory.  The wrapper
// used to do the mkdir loop itself and then call `install`; this is one
// delegation that exits non-zero when the lock cannot be resolved.
when is_install_local == 1 {
  hold handled = 1
  hold illock = read_file(lock_path)
  hold ilcode = 0
  when len(illock) == 0 {
    show "sxpkg: no sx.lock - run init/add"
    hold ilcode = exit(1)
  } otherwise {
    hold illast = sx_idx(illock, len(illock) - 1)
    when illast != 10 {
      hold illock = concat(illock, "\n")
    }
    hold ilspecs = lock_specs(illock, len(illock))
    hold ilrest = ilspecs
    hold ilbad = 0
    while len(ilrest) > 0 {
      hold ilone = take_field(ilrest)
      hold ilrest = drop_field(ilrest)
      hold ilnm = dep_name(ilone)
      when package_name_ok(ilnm) == 0 {
        show concat("sxpkg: refusing unsafe package name '", concat(ilnm, "'"))
        hold ilbad = 1
      }
    }
    when ilbad == 1 {
      hold ilcode = exit(1)
    } otherwise {
      // the default source registry is ./registry, exactly as the wrapper
      // documented; arg(2 + online_shift) is empty when none was given
      hold ilsrc = "registry"
      when len(arg(2 + online_shift)) > 0 {
        hold ilsrc = arg(2 + online_shift)
      }
      hold ilsrc = rooted(root, ilsrc)
      hold ilrest2 = ilspecs
      while len(ilrest2) > 0 {
        hold ilone2 = take_field(ilrest2)
        hold ilrest2 = drop_field(ilrest2)
        hold ilnm2 = dep_name(ilone2)
        hold ilm1 = ensure_dir(concat(concat(registry_path, "/"), ilnm2))
        hold ilm2 = ensure_dir(concat(concat(pkg_path, "/"), ilnm2))
        when ilm1 == 0 || ilm2 == 0 {
          show concat("sxpkg: FAILED creating folders for ", ilnm2)
          hold ilcode = exit(1)
        }
      }
      hold src = ilsrc
      hold is_install = 1
    }
  }
}

// install: copy every locked package (and its closure) from a local registry
// directory into the project's .sayanox/registry/, checking the version and
// the content sum on both sides.  Offline: it reads files, never the network.
// The default source registry is ./registry; the wrapper `sxpkg.sh install`
// creates the destination folders first and then runs this.
when is_install == 1 && argn >= 3 {
  hold handled = 1
  when argn >= 3 {
    hold src = rooted(root, arg(2 + online_shift))
  }
  hold lock = read_file(lock_path)
  hold lock_len = len(lock)
  when lock_len == 0 {
    show "sxpkg: no sx.lock; run init first"
    hold diproblems = 1
  } otherwise {
    hold last_byte = sx_idx(lock, lock_len - 1)
    when last_byte != 10 {
      hold lock = concat(lock, "\n")
    }
    hold lock_len = len(lock)
    hold dires = resolve(lock, src, lock_len, registry_path)
    when sx_index(dires, 0) == 33 {
      show concat("sxpkg: DEP ", tail1(dires))
      hold diproblems = 1
    } otherwise {
      hold diproblems = 0
      hold direst = dires
      while len(direst) > 0 {
        hold dispec = take_field(direst)
        hold direst = drop_field(direst)
        hold dinm = dep_name(dispec)
        hold divr = dep_ver(dispec)
        hold diwhy = check_pkg(dinm, divr, registry_path)
        when len(diwhy) == 0 {
          show concat("sxpkg: ok ", concat(dinm, concat(" ", divr)))
        } otherwise {
          hold dismeta = read_file(concat(concat(src, "/"), concat(dinm, "/pkg.meta")))
          when len(dismeta) == 0 {
            show concat("sxpkg: MISSING ", concat(dinm, concat(": the source registry has no ", concat(src, concat("/", concat(dinm, "/pkg.meta"))))))
            hold diproblems = diproblems + 1
          } otherwise {
            hold disver = pkgfield(dismeta, "version")
            when string_eq(disver, divr) == 0 {
              show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source registry has ", concat(disver, concat(" but sx.lock wants ", divr)))))
              hold diproblems = diproblems + 1
            } otherwise {
              hold dissa = read_file(concat(concat(src, "/"), concat(dinm, "/main.sa")))
              hold diswant = pkgfield(dismeta, "sum")
              hold disgot = decstr(pkgsum(dissa))
              when string_eq(diswant, disgot) == 0 {
                show concat("sxpkg: MISMATCH ", concat(dinm, concat(": the source main.sa sums to ", concat(disgot, concat(" but its pkg.meta says ", diswant)))))
                hold diproblems = diproblems + 1
              } otherwise {
                hold diw1 = write_file(concat(concat(registry_path, "/"), concat(dinm, "/pkg.meta")), dismeta)
                hold diw2 = write_file(concat(concat(registry_path, "/"), concat(dinm, "/main.sa")), dissa)
                when diw1 == 1 && diw2 == 1 {
                  show concat("sxpkg: installed ", concat(dinm, concat(" ", divr)))
                } otherwise {
                  show concat("sxpkg: MISSING ", concat(dinm, concat(": cannot write ", concat(concat(registry_path, "/"), concat(dinm, "/; run sxpkg install-local to create the folders")))))
                  hold diproblems = diproblems + 1
                }
              }
            }
          }
        }
      }
      when diproblems == 0 {
        show "sxpkg: install ok"
      } otherwise {
        show concat("sxpkg: install FAILED (", concat(numstr(diproblems), " problem(s))"))
      }
    }
  }
}

// install-local reports through the exit status as well: it is the wrapper's
// delegation, and `test-sxpkg-polish` requires it to exit non-zero when the
// lock cannot be resolved.  A bare `install` deliberately does NOT do this --
// `test-pkgs` pins that it prints its FAILED report and exits 0, which is what
// the wrapper's `checked` has always keyed on.
when is_install_local == 1 {
  when diproblems > 0 {
    hold install_code = exit(1)
  }
}

// ensure-dir / rm-tree / copy-tree: the wrapper's folder and copy primitives.
// Silent on success so they compose inside a shell command; a failure prints
// one line and exits non-zero.
when is_ensure_dir == 1 {
  hold handled = 1
  hold edpath = arg(2 + online_shift)
  hold edcode = 0
  when ensure_dir(edpath) == 1 {
    hold edcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED creating ", edpath)
    hold edcode = exit(1)
  }
}

when is_rm_tree == 1 {
  hold handled = 1
  hold rtpath = arg(2 + online_shift)
  hold rtcode = 0
  when rm_tree(rtpath) == 1 {
    hold rtcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED removing ", rtpath)
    hold rtcode = exit(1)
  }
}

when is_copy_tree == 1 {
  hold handled = 1
  hold ctsrc = arg(2 + online_shift)
  hold ctdst = arg(3 + online_shift)
  hold ctcode = 0
  when copy_tree(ctsrc, ctdst) == 1 {
    hold ctcode = exit(0)
  } otherwise {
    show concat("sxpkg: FAILED copying ", concat(ctsrc, concat(" into ", ctdst)))
    hold ctcode = exit(1)
  }
}

// publish: write this project's package into the local registry so another
// project can install-local it.  name/version come from sx.toml, the content
// sum is recorded in pkg.meta exactly like the registry seed writes it, and the
// INDEX gains `name=version` unless it is already there.  publish never
// uploads: going online is a commit to the repository registry, which is a
// review step and not a client command.
when is_publish == 1 {
  hold handled = 1
  hold pubmanifest = read_file(manifest_path)
  hold pubname = toml_field(pubmanifest, "name")
  when len(pubname) == 0 {
    hold pubname = "local"
  }
  hold pubver = toml_field(pubmanifest, "version")
  when len(pubver) == 0 {
    hold pubver = "0.1.0"
  }
  hold pubdir = concat(concat(registry_path, "/"), pubname)
  hold pubcode = 0
  hold pubok = ensure_dir(pubdir)
  hold pubmeta = concat(concat(concat("name=", pubname), concat("\nversion=", pubver)), "\n")
  when path_kind("main.sa") == 1 {
    hold pubw1 = write_file(concat(concat(pubdir, "/"), "main.sa"), read_file("main.sa"))
    when pubw1 == 0 {
      hold pubok = 0
    }
  }
  hold pubcopied = concat(concat(pubdir, "/"), "main.sa")
  when path_kind(pubcopied) == 1 {
    hold pubsrc = read_file(pubcopied)
    hold pubmeta = concat(pubmeta, concat("sum=", concat(decstr(pkgsum(pubsrc)), "\n")))
    // the cryptographic digest and where these bytes came from
    hold pubmeta = concat(pubmeta, concat("sha256=", concat(pkgsha(pubsrc), "\n")))
    hold pubmeta = concat(pubmeta, concat("origin=publish:", concat(path_real("main.sa"), "\n")))
  }
  hold pubw2 = write_file(concat(concat(pubdir, "/"), "pkg.meta"), pubmeta)
  when pubw2 == 0 {
    hold pubok = 0
  }
  hold pubidx = read_file(index_path)
  hold pubhas = 0
  hold publine = ""
  hold pubpos = 0
  hold publen = len(pubidx)
  while pubpos < publen {
    hold pubc = sx_index(pubidx, pubpos)
    when pubc == 10 {
      hold pubkey = ""
      hold pubklen = len(publine)
      hold pubj = 0
      hold pubgo = 1
      while pubgo == 1 {
        when pubj < pubklen {
          hold publc = sx_index(publine, pubj)
          when publc == 61 {
            hold pubgo = 0
          } otherwise {
            hold pubkey = concat(pubkey, chr(publc))
            hold pubj = pubj + 1
          }
        } otherwise {
          hold pubgo = 0
        }
      }
      when string_eq(pubkey, pubname) == 1 {
        hold pubhas = 1
      }
      hold publine = ""
    } otherwise {
      hold publine = concat(publine, chr(pubc))
    }
    hold pubpos = pubpos + 1
  }
  when pubhas == 0 {
    hold pubw3 = write_file(index_path, concat(pubidx, concat(concat(pubname, "="), concat(pubver, "\n"))))
    when pubw3 == 0 {
      hold pubok = 0
    }
  }
  when pubok == 1 {
    show concat("sxpkg: published locally ", concat(pubname, concat(" ", pubver)))
    show concat("sxpkg: to go online, commit ", concat(pubdir, " to the sayanox repo"))
  } otherwise {
    show concat("sxpkg: FAILED publishing ", pubname)
    hold pubcode = exit(1)
  }
}

// fetch-local: the file:// and plain-path branch of `fetch`.  It refuses an
// existing cache, project copy or pinned lock, records the content sum in
// pkg.meta and in sx.lock, and rolls the whole thing back if any write fails.
// The wrapper's http(s) branch keeps curl or wget plus its mktemp staging.
when is_fetch_local == 1 {
  hold handled = 1
  hold flsrc = arg(2 + online_shift)
  when len(fetch_src) > 0 {
    hold flsrc = fetch_src
  }
  hold flname = arg(3 + online_shift)
  when len(fetch_name) > 0 {
    hold flname = fetch_name
  }
  when len(flname) == 0 {
    hold flname = "remote_pkg"
  }
  hold fldisp = arg(4 + online_shift)
  when len(fetch_disp) > 0 {
    hold fldisp = fetch_disp
  }
  when len(fldisp) == 0 {
    hold fldisp = flsrc
  }
  hold flcode = 0
  when package_name_ok(flname) == 0 {
    show concat("sxpkg: FAILED invalid fetch name '", concat(flname, "'"))
    hold flcode = exit(1)
  } otherwise {
    hold fltext = read_file(flsrc)
    when len(fltext) == 0 {
      show concat("sxpkg: FAILED fetching ", concat(fldisp, ": no package file there"))
      hold flcode = exit(1)
    } otherwise {
      hold flreg = concat(concat(registry_path, "/"), flname)
      hold flpkg = concat(concat(pkg_path, "/"), flname)
      hold flhas = 0
      when path_kind(flreg) != 0 {
        hold flhas = 1
      }
      when path_kind(flpkg) != 0 {
        hold flhas = 1
      }
      hold fllock = read_file(lock_path)
      hold fllen = len(fllock)
      hold flpos = 0
      hold flline = ""
      while flpos < fllen {
        hold flc = sx_index(fllock, flpos)
        when flc == 10 {
          hold flk = ""
          hold flj = 0
          hold flgo = 1
          while flgo == 1 {
            when flj < len(flline) {
              hold flc2 = sx_index(flline, flj)
              when flc2 == 61 {
                hold flgo = 0
              } otherwise {
                hold flk = concat(flk, chr(flc2))
                hold flj = flj + 1
              }
            } otherwise {
              hold flgo = 0
            }
          }
          when string_eq(flk, flname) == 1 {
            hold flhas = 1
          }
          hold flline = ""
        } otherwise {
          hold flline = concat(flline, chr(flc))
        }
        hold flpos = flpos + 1
      }
      when flhas == 1 {
        show concat("sxpkg: fetch refuses existing package/lock '", concat(flname, "'"))
        hold flcode = exit(1)
      } otherwise {
        hold flsum = decstr(pkgsum(fltext))
        hold flmeta = concat(concat(concat(concat("name=", flname), "\nversion=0.0.0\n"), "sum="), concat(flsum, "\n"))
        // provenance of a download: the digest of exactly these bytes and the
        // place they were read from. Neither authenticates the source.
        hold flmeta = concat(flmeta, concat("sha256=", concat(pkgsha(fltext), "\n")))
        hold flmeta = concat(flmeta, concat("origin=fetch:", concat(fldisp, "\n")))
        hold flok = ensure_dir(registry_path)
        when ensure_dir(pkg_path) == 0 {
          hold flok = 0
        }
        when ensure_dir(flreg) == 0 {
          hold flok = 0
        }
        when ensure_dir(flpkg) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flreg, "/"), "main.sa"), fltext) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flreg, "/"), "pkg.meta"), flmeta) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flpkg, "/"), "main.sa"), fltext) == 0 {
          hold flok = 0
        }
        when write_file(concat(concat(flpkg, "/"), "pkg.meta"), flmeta) == 0 {
          hold flok = 0
        }
        // An extra leading newline also covers a lock with no final newline.
        hold flnewlock = concat(fllock, concat(concat("\n", flname), "=0.0.0\n"))
        when write_file(lock_path, flnewlock) == 0 {
          hold flok = 0
        }
        when flok == 0 {
          hold flr1 = rm_tree(flreg)
          hold flr2 = rm_tree(flpkg)
          hold flr3 = write_file(lock_path, fllock)
          when flr1 == 0 || flr2 == 0 || flr3 == 0 {
            show "sxpkg: rollback incomplete; inspect .sayanox/registry and .sayanox/pkgs"
          }
          show concat("sxpkg: FAILED fetching ", fldisp)
          hold flcode = exit(1)
        } otherwise {
          show concat("sxpkg: fetched ", concat(flname, concat(" from ", concat(fldisp, " (checksum recorded; not authenticated)"))))
        }
      }
    }
  }
  // the staging file a remote fetch came through is not left behind
  when len(fetch_temp) > 0 {
    hold ft2_rm = remove_path(fetch_temp)
  }
}


// check-lock [file]: preflight every name in a lock or an index before any
// path is built from it.  This is the loop `tools/sxpkg.sh preflight_names`
// used to run in the shell, spawning one `check-name` child per line.  A file
// with no final newline is handled the same way the wrapper's `read` loop was.
when string_eq(command, "check-lock") {
  hold handled = 1
  hold clpath = lock_path
  when len(arg(2 + online_shift)) > 0 {
    hold clpath = arg(2 + online_shift)
  }
  hold cltext = read_file(clpath)
  when len(cltext) > 0 {
    when sx_idx(cltext, len(cltext) - 1) != 10 {
      hold cltext = concat(cltext, "\n")
    }
  }
  hold clrest = lock_specs(cltext, len(cltext))
  hold clbad = 0
  while len(clrest) > 0 {
    hold clone = take_field(clrest)
    hold clrest = drop_field(clrest)
    hold clnm = dep_name(clone)
    when package_name_ok(clnm) == 0 {
      show concat("sxpkg: refusing unsafe package name '", concat(clnm, "'"))
      hold clbad = 1
    }
  }
  when clbad == 1 {
    hold clcode = exit(1)
  }
}

// need-fetch: the locked packages whose registry copy is incomplete, one name
// per line.  A package counts as present only when both pkg.meta and main.sa
// are there: an empty directory left by a failed download is not a copy.
when string_eq(command, "need-fetch") {
  hold handled = 1
  hold nftext = read_file(lock_path)
  when len(nftext) > 0 {
    when sx_idx(nftext, len(nftext) - 1) != 10 {
      hold nftext = concat(nftext, "\n")
    }
  }
  hold nfrest = lock_specs(nftext, len(nftext))
  while len(nfrest) > 0 {
    hold nfone = take_field(nfrest)
    hold nfrest = drop_field(nfrest)
    hold nfnm = dep_name(nfone)
    // An unsafe name is never reported, so a caller cannot fetch or mkdir from
    // one.  `check-lock` is the command that refuses; this one stays silent.
    when package_name_ok(nfnm) == 1 {
      hold nfm = path_kind(concat(concat(concat(registry_path, "/"), nfnm), "/pkg.meta"))
      hold nfs = path_kind(concat(concat(concat(registry_path, "/"), nfnm), "/main.sa"))
      when nfm != 1 || nfs != 1 {
        show nfnm
      }
    }
  }
}

// install-cached [pkgdir]: copy every locked package that already has a
// complete registry copy into pkgdir, and report the ones that do not.  This
// is the offline half of `tools/sxpkg.sh install`, which used to walk the lock
// itself; the shell now only fetches what `need-fetch` named.
when string_eq(command, "install-cached") {
  hold handled = 1
  hold icdir = pkg_path
  when len(arg(2 + online_shift)) > 0 {
    hold icdir = arg(2 + online_shift)
  }
  hold ictext = read_file(lock_path)
  when len(ictext) > 0 {
    when sx_idx(ictext, len(ictext) - 1) != 10 {
      hold ictext = concat(ictext, "\n")
    }
  }
  hold icrest = lock_specs(ictext, len(ictext))
  hold icbad = 0
  while len(icrest) > 0 {
    hold icone = take_field(icrest)
    hold icrest = drop_field(icrest)
    hold icnm = dep_name(icone)
    when package_name_ok(icnm) == 0 {
      show concat("sxpkg: refusing unsafe package name '", concat(icnm, "'"))
      hold icbad = 1
    } otherwise {
      hold icm = path_kind(concat(concat(concat(registry_path, "/"), icnm), "/pkg.meta"))
      hold ics = path_kind(concat(concat(concat(registry_path, "/"), icnm), "/main.sa"))
      when icm != 1 || ics != 1 {
        show concat("sxpkg: missing ", concat(icnm, " in registry"))
      } otherwise {
        hold icreg = concat(concat(registry_path, "/"), icnm)
        hold icdst = concat(concat(icdir, "/"), icnm)
        hold icd = ensure_dir(icdst)
        hold icc = copy_tree(icreg, icdst)
        when icd == 0 || icc == 0 {
          show concat("sxpkg: FAILED installing ", icnm)
          hold icbad = 1
        } otherwise {
          show concat("sxpkg: installed ", concat(icnm, concat(" -> ", icdst)))
        }
      }
    }
  }
  when icbad == 1 {
    hold iccode = exit(1)
  }
}

// help and an unknown command: the two answers the wrapper's case statement
// gave, including the exit status 2 that test-sxpkg-polish pins.
when handled == 0 {
  hold ask_help = 0
  when string_eq(command, "help") {
    hold ask_help = 1
  }
  when string_eq(command, "-h") {
    hold ask_help = 1
  }
  when string_eq(command, "--help") {
    hold ask_help = 1
  }
  when ask_help == 1 {
    show "sxpkg: init|sync|add|list|deps|install|install-local|search|publish|remove|info|seed|verify|sum|sha256|sign|authenticate|fetch"
    show concat("  ONLINE registry: ", registry_url)
    show "  override: SAYANOX_REGISTRY=https://... (or file:///path/to/registry)"
    show "  network is opt-in: SAYANOX_ONLINE=1 or 'sxpkg --online <command>'"
    show "  offline commands: init add list deps info search seed verify sum sha256 sign authenticate install-local publish"
    show "  signing key: SAYANOX_SIGN_KEY, or SAYANOX_SIGN_KEYFILE, or .sayanox/keys/default.key"
    show "  SAYANOX_REQUIRE_SIGNED=1 makes verify refuse an unsigned or uncheckable package"
  } otherwise {
    show concat("sxpkg: unknown command '", concat(command, "'"))
    show "sxpkg: init|sync|add|list|deps|install|install-local|search|publish|remove|info|seed|verify|sum|sha256|sign|authenticate|fetch"
    hold help_code = exit(2)
  }
}
