#!/usr/bin/env bash
# sxpkg — Sayanox package manager (lockfile + path/git deps)
#   sxpkg init | install | list | add name path|url | lock
set -euo pipefail

ROOT="${SXPKG_ROOT:-.}"
MANIFEST="$ROOT/Sayanox.toml"
PKG_DIR="$ROOT/.sx/pkg"
LOCK="$ROOT/sx.lock"

cmd="${1:-}"

init_manifest() {
  if [[ -f "$MANIFEST" ]]; then
    echo "sxpkg: $MANIFEST already exists"
    exit 0
  fi
  cat > "$MANIFEST" <<'EOF'
[package]
name = "my-sayanox-app"
version = "0.1.0"

[deps]
# example = { path = "../libs/example" }
# remote  = { git = "https://github.com/user/repo.git" }
EOF
  echo "sxpkg: created $MANIFEST"
}

write_lock_header() {
  echo "# sx.lock — generated by sxpkg install" > "$LOCK"
  echo "# name source" >> "$LOCK"
}

install_deps() {
  if [[ ! -f "$MANIFEST" ]]; then
    echo "sxpkg: error: no Sayanox.toml (run sxpkg init)" >&2
    exit 1
  fi
  mkdir -p "$PKG_DIR"
  write_lock_header
  while IFS= read -r line; do
    if [[ "$line" =~ ^([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*\{[[:space:]]*path[[:space:]]*=[[:space:]]*"([^"]+)" ]]; then
      name="${BASH_REMATCH[1]}"
      path="${BASH_REMATCH[2]}"
      dest="$PKG_DIR/$name"
      rm -rf "$dest"
      mkdir -p "$dest"
      if [[ -d "$path" ]]; then
        cp -R "$path"/. "$dest"/
        echo "$name path:$path" >> "$LOCK"
        echo "sxpkg: installed $name from path $path"
      else
        echo "sxpkg: warn: path not found for $name: $path" >&2
      fi
    elif [[ "$line" =~ ^([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*\{[[:space:]]*git[[:space:]]*=[[:space:]]*"([^"]+)" ]]; then
      name="${BASH_REMATCH[1]}"
      giturl="${BASH_REMATCH[2]}"
      dest="$PKG_DIR/$name"
      rm -rf "$dest"
      if command -v git >/dev/null 2>&1; then
        git clone --depth 1 "$giturl" "$dest"
        echo "$name git:$giturl" >> "$LOCK"
        echo "sxpkg: installed $name from git $giturl"
      else
        echo "sxpkg: error: git not found" >&2
        exit 1
      fi
    fi
  done < "$MANIFEST"
  echo "sxpkg: install done → $PKG_DIR"
  echo "sxpkg: lock written → $LOCK"
}

list_pkgs() {
  if [[ ! -d "$PKG_DIR" ]]; then
    echo "sxpkg: no packages (run sxpkg install)"
    exit 0
  fi
  ls -1 "$PKG_DIR" 2>/dev/null || echo "(empty)"
  if [[ -f "$LOCK" ]]; then
    echo "--- lock ---"
    cat "$LOCK"
  fi
}

add_dep() {
  local name="${1:-}"
  local spec="${2:-}"
  if [[ -z "$name" || -z "$spec" ]]; then
    echo "usage: sxpkg add <name> <path|git-url>" >&2
    exit 1
  fi
  if [[ ! -f "$MANIFEST" ]]; then
    init_manifest
  fi
  if [[ "$spec" == http* || "$spec" == git@* ]]; then
    echo "$name = { git = \"$spec\" }" >> "$MANIFEST"
  else
    echo "$name = { path = \"$spec\" }" >> "$MANIFEST"
  fi
  echo "sxpkg: added $name → $spec"
}

show_lock() {
  if [[ -f "$LOCK" ]]; then
    cat "$LOCK"
  else
    echo "sxpkg: no sx.lock (run sxpkg install)"
  fi
}

case "$cmd" in
  init) init_manifest ;;
  install) install_deps ;;
  list) list_pkgs ;;
  add) add_dep "${2:-}" "${3:-}" ;;
  lock) show_lock ;;
  *)
    echo "sxpkg — Sayanox package manager"
    echo "  sxpkg init"
    echo "  sxpkg install"
    echo "  sxpkg list"
    echo "  sxpkg lock"
    echo "  sxpkg add <name> <path|git-url>"
    exit 1
    ;;
esac
