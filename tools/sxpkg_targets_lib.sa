// Package acceptance obligations retained from the retired build interface.
make kp_name(index: num) -> str {
  when index == 0 { give "test-sxpkg" }
  when index == 1 { give "test-sxpkg-wrapper" }
  when index == 2 { give "test-sxpkg-polish" }
  when index == 3 { give "test-sxpkg-sayanox-logic" }
  when index == 4 { give "test-sxpkg-online-optin" }
  when index == 5 { give "test-sxpkg-online-local" }
  when index == 6 { give "test-sxpkg-crypto" }
  when index == 7 { give "test-registry-sums" }
  when index == 8 { give "test-pkgs" }
  give ""
}
make kp_count() -> num { give 9 }
make kp_known(name: str) -> num {
  hold i = 0
  while i < kp_count() {
    when string_eq(name, kp_name(i)) == 1 { give 1 }
    i = i + 1
  }
  give 0
}
