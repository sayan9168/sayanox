// Acceptance surface captured before Makefile retirement; names only.
// This audit never reads/parses Makefile and cannot silently drop its targets.
make cmd_migration() -> num {
  hold names = "all\nverify-seed\nfix-seed\ntools/sxpack\ntools/sxlsp_probe\ntools/sxpkg_transfer_test\ntools/sxnet_test\npack-compiler\nrestore-compiler-module\nrestore-compiler\nseed-bin\nselfhost/gen1.c\nselfhost/gen1\nselfhost/gen1_min.c\nselfhost/gen1_min\nselfhost/gen2.c\nselfhost/gen2\ntools/sxc_native\nsxc-native\ntools/sxfmt\nsxfmt\ntools/sxpkg\nsxpkg\ntools\ntools/sayanox_lsp\nlsp\ntest-lsp\ntest-lsp-robust\ntest-sxfmt\ntest-sxpkg\ntest-sxpkg-wrapper\ntest-reassign\ntest-while\ntest-when\ntest-mod\ntest-user\ntest-chain\ntest-condmod\ntest-struct2\ntest-list2\ntest-use\ntest-nest\ntest-prec\ntest-float\ntest-parens\ntest-full-lang\ntest-generics\ntest-push-stmt\ntest-native-num\ntest-native-io\ntest-native-mem\ntest-seed-gc\ntest-generic-structs\ntest-stage2-demos\ntest-stdlib\ntest-sxpkg-polish\ntest-sxpkg-sayanox-logic\ntest-native-emit-split\ntest-native-ir-log\ntools/emit_to_ir\ntest-emit-to-ir\ntest-native-ir-portable\nnative-test\ntools/sxlink\ntest-native-sxlink\ntools/sxaudit\ntools/sxmod\ntools/native32\ntest-native32\ntest-native-arm64\ntest-native-riscv64\ntest-sxmod\ntest-trust-anchor\ntools/sxencode\ntest-native-sxencode\ntools/sxdefs\ntest-native-sxdefs\ntools/sxinfer\ntest-native-sxinfer\ntools/sxemit\ntools/sxruntime\ntools/sxgc\ntest-native-sxruntime\ntest-native-sxgc\ntest-native-sxemit\ntest-read-bytes\ntest-sxpkg-online-optin\ntest-sxpkg-online-local\ntest-stdlib-growth\ntest-stdlib-modules\ntest-native-strord\ntest-native-lang\ntest-native-locals\ntest-give-index\ntest-typed-sig\ntest-list-expr\ntest-list-paren\ntest-native-strfn\ntest-native-strgen\ntest-native-listgen\ntest-native-logicarg\ntest-cond-string\ntest-gen2-logic-builtin\ntest-struct-logic\ntest-network\ntest-http-get\ntest-sayacrawl\ntest-logic-value\ntest-native-generics\ntest-native-cond\ntest-pkgs\ntest-builtin-names\ntest-exit-builtin\ntest-stage2\ntest-path-builtins\ntest-proc-builtins\ntest-comment-quotes\ntest-native-primitives\ntest-for-str\ntest-registry-sums\ntest-gen2-gaps\ntest-doc-claims\ntest-language-deps\ntest-gen2-index-expr\ntest-for-paren\ntest-gen2-index-mod\ntest-type-refusals\ntest-gen2-expr-lowering\ntest-parity\ntest-boot\nselfhost/seed/sxc_seed_min\nseed-min\ntest-struct\ntest-list\ntest-fn\ntest-fn2\nseed-min-gen1\ntrue-selfhost-min\ntrue-selfhost-full\ntrue-selfhost\nselfhost\nall-sayanox\ntools/sxdiag\ntest-sxdiag\nselfhost/native_aot\nnative\ngrammar\ngc-test\ntest-gc\ngen3\nsubset\ngen1\ngen2\ntest\nclean\ndoctor\ntest-stdlib-interpolation\ntest-seed-stage2\ntest-seed-limits\ntest-pkg-errors\ntest-seed-assignment\ntest-seed-hold-types\ntest-lsp-unicode\ntest-seed-for-literals\ntest-seed-for-range\ntest-seed-for-calls\ntest-seed-for-untyped\ntest-seed-for-fields\ntest-seed-typed-functions\ntest-native-param-reassign\ntest-native-range-live\ntest-native-for-functions\ntest-native-list-alias\ntest-seed-generics\ntest-native-generic-local\ntest-gen2-forward\ntest-gen2-function-scope\ntest-gen2-boolean-args\ntest-gen2-generic-queue\ntest-gen2-list-return\ntest-gen2-list-args\ntest-gen2-gc-roots\ntest-gen2-list-arithmetic\ntest-return-paths\ntest-name-resolution\ntest-inline-expressions\ntest-inline-runtime\ntest-seed-list-sequence\ntest-list-postfix\ntest-seed-borrow\ntest-list-struct-fields\ntest-gen2-list-struct-fields\ntest-seed-list-budget\ntest-seed-collector\ntest-seed-sanitize\ntest-seed-bootstrap-budget\ntest-generic-struct-limits\ntest-generic-structs-nested\ntest-full-language-expr\ntest-stdlib-list-search\ntest-sxpkg-transfer-hardening\ntest-lsp-workspace\ntest-full-language-readiness\ntest-struct-functions\ntest-string-interpolation\ntest-stdlib-crypto\ntest-stdlib-json-deep\ntest-stdlib-json-write\ntest-sxpkg-crypto\ntest-lsp-semantic\ntest-struct-field-struct\ntools/sxbuild\ntest-sxbuild\ntools/sxstage2_parity\ntest-native-stage2-parity\ntools/sxirexec\ntest-ir-exec\ntools/sxpkg_pubkey_test\ntest-sxpkg-pubkey\ntest-lsp-types\ntools/lsp_ide_test\ntest-lsp-ide\ntools/sxc_native_test\ntest-sxc-native\ntools/sxsuite\ntest-sxsuite\ntools/sxisaexec\ntools/sxisaexec_test\ntest-sxisaexec\ntools/sxmod_deep_test\ntest-sxmod-deep\ntest-stdlib-extended\ntest-ci-shape\nci\ntest-stdlib-csv\ntest-stdlib-next\n"
  hold i = 0
  hold total = 0
  hold implemented = 0
  while i < len(names) {
    hold start = i
    while i < len(names) && sx_index(names, i) != 10 { i = i + 1 }
    hold name = gl_slice(names, start, i)
    i = i + 1
    when len(name) > 0 {
      total = total + 1
      when target_known(name) == 1 { implemented = implemented + 1 } otherwise {
        show concat("[PENDING] ", name)
      }
    }
  }
  show concat(concat("Sayanox driver target coverage: ", istr(implemented)), concat(" / ", istr(total)))
  when implemented != total { hold status = exit(1) }
  give 0
}
