// Fixture programs and pinned record names, not shell recipes.
make xb_source(key: str) -> str {
  when string_eq(key, "gc_oom") == 1 { give "hold i = 0\nwhile i < 200000 {\n  hold t = concat(\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"b\")\n  hold i = i + 1\n}\nshow i\nshow gc_runs()\n" }
  when string_eq(key, "gc_keep") == 1 { give "struct Box {\n  n,\n  s\n}\nhold b = Box { 1, \"hello-world\" }\nhold a0 = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\nhold xs = []\nhold i = 0\nwhile i < 30000 {\n  hold junk = concat(\"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\", \"yyyyyyyyyyyyyyyyyyyyyyyyyy\")\n  push(xs, i)\n  hold i = i + 1\n}\nshow len(a0)\nshow b.s\nshow len(xs)\nshow xs[29999]\nshow gc() >= 0\nshow gc_live() > 0\n" }
  when string_eq(key, "ieee_edge") == 1 { give "hold b1 = 0.1\nhold b2 = 0.2\nhold b4 = 3.141592653589793\nhold t0 = 9007199254740992\nhold t1 = 9007199254740993\nhold t2 = 9007199254740994\nhold t3 = 9007199254740995\nhold c2 = 999999999999999934463\nhold c3 = 999999999999999934465\nshow b1 + b2\nshow b4\nshow t1 - t0\nshow t3 - t2\nwhen c3 > c2 {\n  show 1\n}\n" }
  when string_eq(key, "link_fn") == 1 { give "make fac(n) {\n  when n <= 1 {\n    give 1\n  }\n  give n * fac(n - 1)\n}\nmake fib(n) {\n  when n <= 1 {\n    give n\n  } else {\n    give fib(n - 1) + fib(n - 2)\n  }\n}\nshow fac(6)\nshow fib(20)\n" }
  when string_eq(key, "link_data") == 1 { give "struct Item {\n  name,\n  count\n}\nhold it = Item { name: \"first\", count: 3 }\nshow it.name\nshow it.count\nhold s = \"\"\nhold i = 0\nwhile i < 40 {\n  s = concat(s, \"sayanox\")\n  i = i + 1\n}\nshow len(s)\nshow sx_index(s, 250)\nhold items = [1, 2, 3]\npush(items, 4)\nshow len(items)\nshow gc()\n" }
  when string_eq(key, "encode_ops") == 1 { give "J_cc\nJ_mp\nL_bind\nL_new\naddsd\nb\nbin_imm32\nbin_imm8\nbin_rr\ncall_p\ncvtsd2si\ncvtsi2sd\ncvttsd2si\ndivsd\nerel32\nerel32j\nfm7\ninc_mem_r\nincdec_r\njcc_rel32\njmp5_slot\njmp_rel32\nlea_r12_data\nlea_rm\nleave_ret\nmov_imm64\nmov_imm8m\nmovq_rx\nmovq_xr\nmovzx_al_to_rax\nmulsd\nmv_m64\nmv_r64m\nmv_rr\nmvz_rm\npatch_imm32\npop_r\npush_r\nraw_patch32\nsar_imm\nsetcc\nshl_imm\nshr_imm\nstal_rdi\nstb_rdi\nsub_rsp_slot\nsubsd\ntest_rr\nucomisd\nxor_rr\n" }
  give ""
}
