// Sayanox language server (LSP 3.17 subset) — JSON-RPC over stdio.
//
// Built like the other tools:
//
//   make lsp        -> tools/sayanox_lsp
//   printf 'Content-Length: N\r\n\r\n{...}' | tools/sayanox_lsp
//
// Methods: initialize / initialized / shutdown / exit, textDocument didOpen,
// didChange, didClose, publishDiagnostics, diagnostic, documentSymbol,
// completion, hover, definition, references, workspace/symbol, formatting,
// rename, signatureHelp, codeAction. Workspace symbols/references also scan
// a bounded local folder via the tool-only C directory bridge. Rename stays
// open-buffer-only; see docs/LSP.md for the separate limits.
//
// The diagnostics are real checks over the document text: unknown statements,
// brace and paren balance, unterminated strings, and `use` targets that do not
// resolve next to the document. Nothing here shells out. Protocol/scanning
// are Sayanox compiled by gen2; only filesystem enumeration uses C.

// ---------------------------------------------------------------- scanning

make starts(t: str, i: num, p: str) -> num {
  hold n = 0
  hold k = 0
  hold ok = 1
  hold c1 = 0
  hold c2 = 0
  n = len(p)
  when i + n > len(t) {
    give 0
  }
  while k < n {
    c1 = sx_index(t, i + k)
    c2 = sx_index(p, k)
    when c1 != c2 {
      ok = 0
      k = n
    }
    k += 1
  }
  give ok
}

make find_from(t: str, p: str, from: num) -> num {
  hold n = 0
  hold m = 0
  hold i = 0
  hold hit = 0
  n = len(t)
  m = len(p)
  when m <= 0 {
    give -1
  }
  when from > 0 {
    i = from
  }
  while i + m <= n {
    hit = starts(t, i, p)
    when hit == 1 {
      give i
    }
    i += 1
  }
  give -1
}

make find(t: str, p: str) -> num {
  hold r = 0
  r = find_from(t, p, 0)
  give r
}

make is_ident(c: num) -> num {
  hold ok = 0
  when c >= 97 && c <= 122 {
    ok = 1
  }
  when c >= 65 && c <= 90 {
    ok = 1
  }
  when c >= 48 && c <= 57 {
    ok = 1
  }
  when c == 95 {
    ok = 1
  }
  give ok
}

make is_word(c: num) -> num {
  hold ok = 0
  when c >= 97 && c <= 122 {
    ok = 1
  }
  when c >= 65 && c <= 90 {
    ok = 1
  }
  when c == 95 {
    ok = 1
  }
  give ok
}

// ------------------------------------------------------------ JSON strings

make json_esc(s: str) -> str {
  hold r = ""
  hold i = 0
  hold n = 0
  hold c = 0
  n = len(s)
  while i < n {
    c = sx_index(s, i)
    when c == 34 {
      r = r + "\\\""
    } otherwise {
      when c == 92 {
        r = r + "\\\\"
      } otherwise {
        when c == 10 {
          r = r + "\\n"
        } otherwise {
          when c == 13 {
            r = r + "\\r"
          } otherwise {
            when c == 9 {
              r = r + "\\t"
            } otherwise {
              r = r + chr(c)
            }
          }
        }
      }
    }
    i += 1
  }
  give r
}

// Unicode boundary helpers. Internal scanner offsets are UTF-8 bytes;
// protocol positions are UTF-16 code units (the LSP default).
make hex4(s: str, at: num) -> num {
  hold v = 0
  hold k = 0
  hold c = 0
  hold d = 0
  when at + 4 > len(s) {
    give -1
  }
  while k < 4 {
    c = sx_index(s, at + k)
    d = -1
    when c >= 48 and c <= 57 {
      d = c - 48
    }
    when c >= 65 and c <= 70 {
      d = c - 55
    }
    when c >= 97 and c <= 102 {
      d = c - 87
    }
    when d < 0 {
      give -1
    }
    v = v * 16 + d
    k = k + 1
  }
  give v
}

make utf8_scalar(v: num) -> str {
  hold r = ""
  hold a = 0
  hold b = 0
  hold c = 0
  // The runtime uses NUL-terminated strings; U+0000 is not representable.
  when v <= 0 or v > 1114111 {
    v = 65533
  }
  when v >= 55296 and v <= 57343 {
    v = 65533
  }
  when v < 128 {
    give chr(v)
  }
  a = (v - v % 64) / 64
  when v < 2048 {
    r = concat(chr(192 + a), chr(128 + v % 64))
    give r
  }
  b = (a - a % 64) / 64
  when v < 65536 {
    r = concat(chr(224 + b), chr(128 + a % 64))
    give concat(r, chr(128 + v % 64))
  }
  c = (b - b % 64) / 64
  r = concat(chr(240 + c), chr(128 + b % 64))
  r = concat(r, chr(128 + a % 64))
  give concat(r, chr(128 + v % 64))
}

make utf8_width(s: str, i: num) -> num {
  hold c = 0
  hold d = 0
  hold width = 1
  hold k = 1
  when i >= len(s) {
    give 0
  }
  c = sx_index(s, i)
  when c >= 194 and c <= 223 {
    width = 2
  }
  when c >= 224 and c <= 239 {
    width = 3
  }
  when c >= 240 and c <= 244 {
    width = 4
  }
  when i + width > len(s) {
    give 1
  }
  while k < width {
    d = sx_index(s, i + k)
    when d < 128 or d > 191 {
      give 1
    }
    k = k + 1
  }
  when width >= 3 {
    d = sx_index(s, i + 1)
    when c == 224 and d < 160 {
      give 1
    }
    when c == 237 and d >= 160 {
      give 1
    }
    when c == 240 and d < 144 {
      give 1
    }
    when c == 244 and d >= 144 {
      give 1
    }
  }
  give width
}

make utf16_byte(s: str, units: num) -> num {
  hold i = 0
  hold u = 0
  hold width = 0
  hold step = 0
  while i < len(s) and u < units {
    when sx_index(s, i) == 10 or sx_index(s, i) == 13 {
      break
    }
    width = utf8_width(s, i)
    step = 1
    when width == 4 {
      step = 2
    }
    when u + step > units {
      break
    }
    u = u + step
    i = i + width
  }
  give i
}

// Span of the codepoint containing a scanner byte offset. Never split a
// surrogate pair. At EOF produce a zero-width span rather than overshoot.
make utf16_span(s: str, offset: num) -> list {
  hold i = 0
  hold u = 0
  hold width = 0
  hold step = 0
  hold result = [0, 0]
  while i < len(s) {
    width = utf8_width(s, i)
    step = 1
    when width == 4 {
      step = 2
    }
    when i + width > offset {
      result = [u, u + step]
      give result
    }
    i = i + width
    u = u + step
  }
  result = [u, u]
  give result
}

make unesc(s: str) -> str {
  hold r = ""
  hold i = 0
  hold c = 0
  hold d = 0
  hold v = 0
  hold low = 0
  while i < len(s) {
    c = sx_index(s, i)
    when c == 92 and i + 1 < len(s) {
      d = sx_index(s, i + 1)
      when d == 117 {
        v = hex4(s, i + 2)
        i = i + 6
        when v >= 55296 and v <= 56319 {
          when starts(s, i, "\\u") == 1 {
            low = hex4(s, i + 2)
            when low >= 56320 and low <= 57343 {
              v = 65536 + (v - 55296) * 1024 + low - 56320
              i = i + 6
            }
          }
        }
        r = concat(r, utf8_scalar(v))
      } otherwise {
        when d == 110 {
          d = 10
        }
        elif d == 114 {
          d = 13
        }
        elif d == 116 {
          d = 9
        }
        elif d == 98 {
          d = 8
        }
        elif d == 102 {
          d = 12
        }
        r = concat(r, chr(d))
        i = i + 2
      }
    } otherwise {
      r = concat(r, chr(c))
      i = i + 1
    }
  }
  give r
}

make str_field(msg: str, key: str) -> str {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold out = ""
  hold run = 1
  hold nc = 0
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find(msg, k)
  when p < 0 {
    give ""
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give ""
  }
  p += 1
  n = len(msg)
  while p < n {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      run = 0
      p = p
      break
    }
  }
  when p >= n {
    give ""
  }
  when sx_index(msg, p) != 34 {
    give ""
  }
  p += 1
  run = 1
  while run == 1 {
    when p >= n {
      run = 0
    } otherwise {
      c = sx_index(msg, p)
      when c == 92 {
        when p + 1 < n {
          out = out + chr(c)
          nc = sx_index(msg, p + 1)
          out = out + chr(nc)
          p += 2
        } otherwise {
          run = 0
        }
      } otherwise {
        when c == 34 {
          run = 0
          p += 1
        } otherwise {
          out = out + chr(c)
          p += 1
        }
      }
    }
  }
  give unesc(out)
}

make num_field(msg: str, key: str, def: num) -> num {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold v = 0
  hold got = 0
  hold skip = 1
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find(msg, k)
  when p < 0 {
    give def
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give def
  }
  p += 1
  n = len(msg)
  while p < n && skip == 1 {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      skip = 0
    }
  }
  while p < n {
    c = sx_index(msg, p)
    when c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
      got = 1
      p += 1
    } otherwise {
      break
    }
  }
  when got == 0 {
    give def
  }
  give v
}

// ------------------------------------------------------------- line access

make line_start(text: str, line: num) -> num {
  hold i = 0
  hold n = 0
  hold l = 0
  hold c = 0
  hold ok = 0
  n = len(text)
  when line <= 0 {
    give 0
  }
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      l += 1
      when l >= line {
        give i + 1
      }
    }
    i += 1
  }
  give n
}

make line_end(text: str, line: num) -> num {
  hold i = 0
  hold n = 0
  hold c = 0
  i = line_start(text, line)
  n = len(text)
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      give i
    }
    i += 1
  }
  give n
}

make line_text(text: str, line: num) -> str {
  hold a = 0
  hold b = 0
  hold r = ""
  hold i = 0
  hold c = 0
  a = line_start(text, line)
  b = line_end(text, line)
  i = a
  while i < b {
    c = sx_index(text, i)
    when c != 13 {
      r = r + chr(c)
    }
    i += 1
  }
  give r
}

make count_lines(text: str) -> num {
  hold i = 0
  hold n = 0
  hold l = 0
  hold c = 0
  n = len(text)
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      l += 1
    }
    i += 1
  }
  when n > 0 {
    c = sx_index(text, n - 1)
    when c != 10 {
      l += 1
    }
  }
  give l
}

make word_at(text: str, line: num, ch: num) -> str {
  hold a = 0
  hold p = 0
  hold n = 0
  hold w = ""
  hold c = 0
  hold ok = 0
  a = line_start(text, line)
  p = a + utf16_byte(line_text(text, line), ch)
  n = a + len(line_text(text, line))
  when p > n {
    p = n
  }
  ok = 1
  while p > a && ok == 1 {
    c = sx_index(text, p - 1)
    ok = is_ident(c)
    when ok == 1 {
      p -= 1
    }
  }
  ok = 1
  while p < n && ok == 1 {
    c = sx_index(text, p)
    ok = is_ident(c)
    when ok == 1 {
      w = w + chr(c)
      p += 1
    }
  }
  give w
}

// ------------------------------------------------------ language knowledge

make known_word(w: str) -> num {
  hold ok = 0
  when string_eq(w, "hold") || string_eq(w, "show") || string_eq(w, "give") {
    ok = 1
  }
  when string_eq(w, "when") || string_eq(w, "otherwise") || string_eq(w, "else") {
    ok = 1
  }
  when string_eq(w, "elif") || string_eq(w, "while") || string_eq(w, "for") {
    ok = 1
  }
  when string_eq(w, "break") || string_eq(w, "continue") {
    ok = 1
  }
  when string_eq(w, "make") || string_eq(w, "struct") || string_eq(w, "use") {
    ok = 1
  }
  when string_eq(w, "true") || string_eq(w, "false") {
    ok = 1
  }
  when string_eq(w, "and") || string_eq(w, "or") || string_eq(w, "not") {
    ok = 1
  }
  when string_eq(w, "concat") || string_eq(w, "len") || string_eq(w, "chr") {
    ok = 1
  }
  when string_eq(w, "sx_index") || string_eq(w, "index") || string_eq(w, "push") {
    ok = 1
  }
  when string_eq(w, "string_eq") || string_eq(w, "sx_eq") {
    ok = 1
  }
  when string_eq(w, "read_file") || string_eq(w, "write_file") {
    ok = 1
  }
  when string_eq(w, "arg") || string_eq(w, "arg_count") {
    ok = 1
  }
  when string_eq(w, "read_line") || string_eq(w, "read_n") {
    ok = 1
  }
  when string_eq(w, "write_out") || string_eq(w, "flush_out") {
    ok = 1
  }
  when string_eq(w, "numstr") || string_eq(w, "str") {
    ok = 1
  }
  when string_eq(w, "gc") || string_eq(w, "gc_live") || string_eq(w, "gc_runs") {
    ok = 1
  }
  give ok
}

make declared_in(text: str, w: str) -> num {
  hold p = 0
  hold pat = ""
  hold found = 0
  pat = concat("hold ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  pat = concat("make ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  pat = concat("struct ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  give found
}

make doc_for(w: str) -> str {
  hold d = ""
  when string_eq(w, "hold") {
    d = "`hold name = value` declares a variable (or `hold name: type = value`)."
  }
  when string_eq(w, "show") {
    d = "`show EXPR` prints a value."
  }
  when string_eq(w, "when") {
    d = "`when COND { ... }` runs the block when COND is non-zero; `otherwise` is the else branch."
  }
  when string_eq(w, "while") {
    d = "`while COND { ... }` loops while COND is non-zero."
  }
  when string_eq(w, "for") {
    d = "`for i in 0..10 { ... }` counts; `for v in xs { ... }` walks a list."
  }
  when string_eq(w, "make") {
    d = "`make name(a, b: str) -> str { give a }` defines a function."
  }
  when string_eq(w, "give") {
    d = "`give EXPR` returns a value from a function."
  }
  when string_eq(w, "struct") {
    d = "`struct Point { x, y }` declares a struct type."
  }
  when string_eq(w, "use") {
    d = "`use \"file.sa\"` splices another source file in place."
  }
  when string_eq(w, "push") {
    d = "`push(xs, v)` appends a number to a list."
  }
  when string_eq(w, "concat") {
    d = "`concat(a, b)` joins two strings."
  }
  when string_eq(w, "len") {
    d = "`len(s)` is a string's byte length; `len(xs)` a list's element count."
  }
  when string_eq(w, "chr") {
    d = "`chr(n)` is the one-byte string with code n."
  }
  when string_eq(w, "sx_index") {
    d = "`sx_index(s, i)` is the byte at index i (same as `s[i]`)."
  }
  when string_eq(w, "gc") {
    d = "`gc()` collects now and returns the bytes it reclaimed."
  }
  when string_eq(w, "gc_live") {
    d = "`gc_live()` is the bytes held by the managed heap."
  }
  when string_eq(w, "gc_runs") {
    d = "`gc_runs()` is the number of collections so far."
  }
  when string_eq(w, "read_line") {
    d = "`read_line()` reads one line from stdin without the newline."
  }
  when string_eq(w, "read_n") {
    d = "`read_n(n)` reads exactly n bytes from stdin."
  }
  when string_eq(w, "write_out") {
    d = "`write_out(s)` writes s to stdout without a newline."
  }
  when string_eq(w, "flush_out") {
    d = "`flush_out()` flushes stdout."
  }
  when string_eq(w, "numstr") {
    d = "`numstr(n)` formats a number as a string."
  }
  when string_eq(w, "read_file") {
    d = "`read_file(path)` returns the file text, or \"\" when unreadable."
  }
  when string_eq(w, "write_file") {
    d = "`write_file(path, text)` writes a file and returns a status."
  }
  when string_eq(w, "arg") {
    d = "`arg(i)` is command-line argument i."
  }
  when string_eq(w, "arg_count") {
    d = "`arg_count()` is the number of command-line arguments."
  }
  give d
}

// ------------------------------------------------------------- diagnostics

make diag_item(line: num, span: list, sev: num, code: str, msg: str, first: num) -> str {
  hold ch = span[0]
  hold endch = span[1]
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(ch)
  b = b + "},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}},\"severity\":"
  b = b + numstr(sev)
  b = b + ",\"code\":\""
  b = b + code
  b = b + "\",\"source\":\"sayanox\",\"message\":\""
  b = b + json_esc(msg)
  b = b + "\"}"
  give b
}

make diagnostics(text: str, dir: str) -> str {
  hold items = ""
  hold count = 0
  hold lines = 0
  hold depth = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold a = 0
  hold blank = 0
  hold bd = 0
  hold st = 0
  hold j = 0
  hold c = 0
  hold cmt = 0
  hold pd = 0
  hold k = 0
  hold w = ""
  hold q = 0
  hold rest = 0
  hold expected = 0
  hold is_assign = 0
  hold is_call = 0
  hold msg = ""
  hold u = 0
  hold v = 0
  hold path = ""
  hold full = ""
  hold body = ""
  hold z = 0
  hold l2 = 0
  lines = count_lines(text)
  while l < lines {
    line = line_text(text, l)
    n = len(line)
    i = 0
    while i < n {
      c = sx_index(line, i)
      when c == 32 || c == 9 {
        i += 1
      } otherwise {
        break
      }
    }
    a = i
    blank = 0
    when i >= n {
      blank = 1
    }
    when blank == 0 {
      c = sx_index(line, i)
      when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
        blank = 1
      }
    }
    when blank == 0 {
      c = sx_index(line, i)
      when c == 125 {
        depth -= 1
      }
      when c == 123 {
        depth += 1
      }
      // braces and parens must balance within the statement line
      bd = 0
      pd = 0
      st = 0
      cmt = 0
      j = i
      while j < n {
        c = sx_index(line, j)
        when st == 1 {
          when c == 92 {
            j += 2
          } otherwise {
            when c == 34 {
              st = 0
            }
            j += 1
          }
        } otherwise {
          when c == 34 {
            st = 1
            j += 1
          } otherwise {
            when c == 47 && j + 1 < n && sx_index(line, j + 1) == 47 {
              j = n
              cmt = 1
            } otherwise {
              when c == 123 {
                bd += 1
              }
              when c == 125 {
                bd -= 1
              }
              when c == 40 {
                pd += 1
              }
              when c == 41 {
                pd -= 1
              }
              j += 1
            }
          }
        }
      }
      when cmt == 0 && st == 1 {
        items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1002", "unterminated string", count)
        count += 1
      }
      when pd != 0 {
        items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1004", "unbalanced parentheses", count)
        count += 1
      }
      c = sx_index(line, a)
      when is_word(c) == 1 {
        w = ""
        q = a
        while q < n {
          c = sx_index(line, q)
          when is_ident(c) == 1 {
            w = w + chr(c)
            q += 1
          } otherwise {
            break
          }
        }
        expected = known_word(w)
        rest = q
        while rest < n {
          c = sx_index(line, rest)
          when c == 32 || c == 9 {
            rest += 1
          } otherwise {
            break
          }
        }
        is_assign = 0
        is_call = 0
        when rest < n {
          c = sx_index(line, rest)
          when c == 61 {
            is_assign = 1
          }
          when c == 46 || c == 91 {
            is_assign = 1
          }
          when c == 40 {
            is_call = 1
          }
        }
        when expected == 0 && is_assign == 0 && is_call == 0 {
          when declared_in(text, w) == 0 {
            msg = concat("unknown statement '", w)
            msg = concat(msg, "'")
            items = items + diag_item(l, utf16_span(line, a), 1, "SX1001", msg, count)
            count += 1
          }
        }
        when string_eq(w, "use") {
          u = find_from(line, "\"", q)
          when u >= 0 {
            v = find_from(line, "\"", u + 1)
            when v < 0 {
              items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1005", "unterminated use path", count)
              count += 1
            } otherwise {
              path = ""
              z = u + 1
              while z < v {
                path = path + chr(sx_index(line, z))
                z += 1
              }
              full = path
              c = sx_index(path, 0)
              when c != 47 {
                full = concat(dir, path)
              }
              body = read_file(full)
              when len(body) <= 0 {
                msg = concat("cannot read module '", path)
                msg = concat(msg, "' (looked next to the document)")
                items = items + diag_item(l, utf16_span(line, u), 2, "SX1005", msg, count)
                count += 1
              }
            }
          }
        }
      }
    }
    l += 1
  }
  when depth != 0 {
    l2 = lines - 1
    when l2 < 0 {
      l2 = 0
    }
    msg = "unbalanced braces: "
    when depth > 0 {
      msg = concat(msg, numstr(depth))
      msg = concat(msg, " block(s) never close")
    } otherwise {
      msg = concat(msg, "more '}' than '{'")
    }
    items = items + diag_item(l2, utf16_span(line_text(text, l2), 0), 1, "SX1003", msg, count)
    count += 1
  }
  give concat("[", concat(items, "]"))
}

// ---------------------------------------------------------- documentSymbol

make sym_item(name: str, kind: num, line: num, uri: str, first: num) -> str {
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"name\":\""
  b = b + json_esc(name)
  b = b + "\",\"kind\":"
  b = b + numstr(kind)
  b = b + ",\"location\":{\"uri\":\""
  b = b + json_esc(uri)
  b = b + "\",\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":0},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":1}}}}"
  give b
}

// lower: ASCII lowercase, for the case-insensitive workspace/symbol filter.
make lower(s: str) -> str {
  hold r = ""
  hold i = 0
  hold n = 0
  hold c = 0
  n = len(s)
  while i < n {
    c = sx_index(s, i)
    when c >= 65 && c <= 90 {
      c = c + 32
    }
    r = r + chr(c)
    i += 1
  }
  give r
}

// sym_scan: the symbols of ONE document as a comma-joined list of
// DocumentSymbol items, each carrying its own leading comma except the very
// first, so a caller may concatenate the scans of several documents without
// knowing how many items each produced. `first` is the number of items the
// caller already has, which is all the comma rule needs. A non-empty `query`
// keeps only the symbols whose name contains it, case-insensitively: that is
// the workspace/symbol filter, and documentSymbol passes "" for "no filter".
make sym_scan(text: str, uri: str, query: str, first: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold kind = 0
  hold skip = 0
  hold w = ""
  hold q = 0
  hold c = 0
  lines = count_lines(text)
  while l < lines {
    line = line_text(text, l)
    n = len(line)
    i = 0
    while i < n {
      c = sx_index(line, i)
      when c == 32 || c == 9 {
        i += 1
      } otherwise {
        break
      }
    }
    kind = 0
    skip = 0
    when starts(line, i, "make ") == 1 {
      kind = 3
      skip = 5
    }
    when starts(line, i, "struct ") == 1 {
      kind = 5
      skip = 7
    }
    when starts(line, i, "hold ") == 1 {
      kind = 13
      skip = 5
    }
    when kind != 0 {
      w = ""
      q = i + skip
      while q < n {
        c = sx_index(line, q)
        when is_ident(c) == 1 {
          w = w + chr(c)
          q += 1
        } otherwise {
          break
        }
      }
      when len(w) > 0 {
        when len(query) <= 0 {
          arr = arr + sym_item(w, kind, l, uri, count)
          count += 1
        } otherwise {
          when find(lower(w), lower(query)) >= 0 {
            arr = arr + sym_item(w, kind, l, uri, count)
            count += 1
          }
        }
      }
    }
    l += 1
  }
  give arr
}

make symbols(text: str, uri: str) -> str {
  give concat("[", concat(sym_scan(text, uri, "", 0), "]"))
}

// ------------------------------------------------- rename / signature help

// rename_edits: every whole-word occurrence of `w` in ONE document as
// TextEdit items (same scan and comma rule as refs_for, declaration
// included), each replacing the word with `newtext`. "" when none.
make rename_edits(w: str, newtext: str, text: str, first: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold j = 0
  hold c = 0
  hold run = ""
  hold span = [0, 0]
  hold espan = [0, 0]
  hold b = ""
  when len(w) > 0 && len(newtext) > 0 {
    lines = count_lines(text)
    while l < lines {
      line = line_text(text, l)
      n = len(line)
      i = 0
      while i < n {
        c = sx_index(line, i)
        when is_ident(c) == 1 {
          run = ""
          j = i
          while j < n {
            c = sx_index(line, j)
            when is_ident(c) == 1 {
              run = run + chr(c)
              j += 1
            } otherwise {
              break
            }
          }
          when string_eq(run, w) == 1 {
            span = utf16_span(line, i)
            espan = utf16_span(line, i + len(w))
            b = ""
            when count > 0 {
              b = b + ","
            }
            b = b + "{\"range\":{\"start\":{\"line\":"
            b = b + numstr(l)
            b = b + ",\"character\":"
            b = b + numstr(span[0])
            b = b + "},\"end\":{\"line\":"
            b = b + numstr(l)
            b = b + ",\"character\":"
            b = b + numstr(espan[0])
            b = b + "}},\"newText\":\""
            b = b + json_esc(newtext)
            b = b + "\"}"
            arr = arr + b
            count += 1
          }
          i = j
        } otherwise {
          i += 1
        }
      }
      l += 1
    }
  }
  give arr
}

// trim_str: strip spaces and tabs at both ends.
make trim_str(s: str) -> str {
  hold a = 0
  hold z = len(s)
  hold run = 1
  while run == 1 {
    when a >= z {
      hold run = 0
    } otherwise {
      hold c = sx_index(s, a)
      when c == 32 || c == 9 {
        hold a = a + 1
      } otherwise {
        hold run = 0
      }
    }
  }
  hold run = 1
  while run == 1 {
    when z <= a {
      hold run = 0
    } otherwise {
      hold c = sx_index(s, z - 1)
      when c == 32 || c == 9 {
        hold z = z - 1
      } otherwise {
        hold run = 0
      }
    }
  }
  hold out = ""
  hold i = a
  while i < z {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// sub_str: bytes [a, z) of s, clamped.
make sub_str(s: str, a: num, z: num) -> str {
  hold out = ""
  hold i = a
  when i < 0 {
    hold i = 0
  }
  hold e = z
  when e > len(s) {
    hold e = len(s)
  }
  while i < e {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// sig_help: signature help for the call at (line, ch) of THIS document.
// The callee is the word under the cursor, or -- when the cursor sits in an
// argument list -- the identifier of the innermost enclosing call on that
// line. The declaration is the `make NAME(...)` line in the same document;
// there is no cross-file lookup. Parameters are the comma-separated pieces
// of the declaration's parameter list, and activeParameter counts the
// top-level commas of the call between its '(' and the cursor. "null" when
// no declaration is found, which the protocol allows.
make sig_help(w: str, text: str, line: num, ch: num) -> str {
  hold lt = line_text(text, line)
  hold bytepos = utf16_byte(lt, ch)
  hold callee = w
  hold callopen = 0 - 1
  hold depth = 0
  hold i = 0
  hold best = ""
  hold bestopen = 0 - 1
  hold cur = ""
  hold c = 0
  hold active = 0
  hold d2 = 0
  hold Decl = ""
  hold lines = 0
  hold l = 0
  hold pat = ""
  hold dl = ""
  hold m = 0
  hold after = 0
  hold po = 0
  hold pc = 0
  hold params = ""
  hold npar = 0
  hold inner = ""
  hold start = 0
  hold at_end = 0
  hold piece = ""
  hold b = ""
  // the innermost enclosing call on this line, if any
  while i < bytepos && i < len(lt) {
    hold c = sx_index(lt, i)
    when is_ident(c) == 1 {
      cur = concat(cur, chr(c))
    } otherwise {
      when c == 40 {
        when len(cur) > 0 {
          best = cur
          bestopen = i
        }
        depth = depth + 1
        cur = ""
      } otherwise {
        when c == 41 {
          depth = depth - 1
          cur = ""
        } otherwise {
          cur = ""
        }
      }
    }
    i = i + 1
  }
  when depth > 0 && len(best) > 0 {
    callee = best
    callopen = bestopen
  }
  // activeParameter: top-level commas between the call's '(' and the cursor
  when callopen >= 0 {
    d2 = 1
    i = callopen + 1
    while i < bytepos && i < len(lt) {
      hold c = sx_index(lt, i)
      when c == 40 || c == 91 {
        d2 = d2 + 1
      }
      when c == 41 || c == 93 {
        d2 = d2 - 1
      }
      when c == 44 && d2 == 1 {
        active = active + 1
      }
      i = i + 1
    }
  }
  // find the declaration line in this document
  lines = count_lines(text)
  pat = concat("make ", callee)
  while l < lines {
    dl = line_text(text, l)
    m = 0
    while m < len(dl) {
      when sx_index(dl, m) == 32 || sx_index(dl, m) == 9 {
        m = m + 1
      } otherwise {
        break
      }
    }
    when len(Decl) <= 0 && starts(dl, m, pat) == 1 {
      // the name must be followed by '(' so make helper2 is not helper
      after = m + len(pat)
      when after < len(dl) {
        when sx_index(dl, after) == 40 {
          Decl = trim_str(dl)
        }
      }
    }
    l = l + 1
  }
  when len(Decl) <= 0 {
    give "null"
  }
  // parameter labels: the comma-separated pieces inside the first ( ... )
  po = find(Decl, "(")
  pc = find_from(Decl, ")", po)
  when po >= 0 && pc > po {
    inner = sub_str(Decl, po + 1, pc)
    start = 0
    i = 0
    while i <= len(inner) {
      at_end = 0
      when i == len(inner) {
        at_end = 1
      } otherwise {
        when sx_index(inner, i) == 44 {
          at_end = 1
        }
      }
      when at_end == 1 {
        piece = trim_str(sub_str(inner, start, i))
        when len(piece) > 0 {
          when npar > 0 {
            params = concat(params, ",")
          }
          params = concat(params, "{\"label\":\"")
          params = concat(params, json_esc(piece))
          params = concat(params, "\"}")
          npar = npar + 1
        }
        start = i + 1
      }
      i = i + 1
    }
  }
  when active >= npar && npar > 0 {
    active = npar - 1
  }
  b = "{\"signatures\":[{\"label\":\""
  b = concat(b, json_esc(Decl))
  b = concat(b, "\",\"parameters\":[")
  b = concat(b, params)
  b = concat(b, "]],\"activeSignature\":0,\"activeParameter\":")
  b = concat(b, numstr(active))
  b = concat(b, "}")
  give b
}


// ------------------------------------------------------------- references

make ref_item(uri: str, line: num, ch: num, endch: num, first: num) -> str {
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"uri\":\""
  b = b + json_esc(uri)
  b = b + "\",\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(ch)
  b = b + "},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}}}"
  give b
}

// refs_for: every whole-word occurrence of `w` in one document, as Location
// items with the same comma rule as sym_scan. Positions are UTF-16 code units
// (utf16_span), so a non-ASCII line still reports the column a client expects.
// `incl` is the LSP context.includeDeclaration flag: when it is 0 the line that
// declares the word (`make w`, `hold w`, `struct w`) is skipped, which is what
// "find references, not the definition" means in an editor.
make refs_for(w: str, text: str, uri: str, incl: num, first: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold j = 0
  hold m = 0
  hold c = 0
  hold run = ""
  hold decl = 0
  hold span = [0, 0]
  hold espan = [0, 0]
  when len(w) > 0 {
    lines = count_lines(text)
    while l < lines {
      line = line_text(text, l)
      n = len(line)
      decl = 0
      when incl == 0 {
        m = 0
        while m < n {
          c = sx_index(line, m)
          when c == 32 || c == 9 {
            m += 1
          } otherwise {
            break
          }
        }
        when starts(line, m, concat("make ", w)) == 1 {
          decl = 1
        }
        when starts(line, m, concat("hold ", w)) == 1 {
          decl = 1
        }
        when starts(line, m, concat("struct ", w)) == 1 {
          decl = 1
        }
      }
      when decl == 0 {
        i = 0
        while i < n {
          c = sx_index(line, i)
          when is_ident(c) == 1 {
            run = ""
            j = i
            while j < n {
              c = sx_index(line, j)
              when is_ident(c) == 1 {
                run = run + chr(c)
                j += 1
              } otherwise {
                break
              }
            }
            when string_eq(run, w) == 1 {
              // the start of the word and the offset just past its last byte,
              // each as UTF-16 units, so the range covers the whole word
              span = utf16_span(line, i)
              espan = utf16_span(line, i + len(w))
              arr = arr + ref_item(uri, l, span[0], espan[0], count)
              count += 1
            }
            i = j
          } otherwise {
            i += 1
          }
        }
      }
      l += 1
    }
  }
  give arr
}

// ---------------------------------------------------------------- formatting

// format_text: the rules of tools/sxfmt.sa, ported so a client can ask for
// them over the protocol instead of running the formatter as a program.
// Indentation is rebuilt from brace depth at two spaces per level, leading and
// trailing whitespace is stripped, blank lines stay blank, a final newline is
// added, and braces inside a quoted string or a // comment do not change the
// depth. Tokens and comments are never rewritten: the formatter stays
// conservative, and running it twice gives the same text.
make format_text(text: str) -> str {
  hold src = text
  hold n = 0
  hold pos = 0
  hold c = 0
  hold depth = 0
  hold result = ""
  hold line = ""
  hold left = 0
  hold right = 0
  hold t = 0
  hold body = ""
  hold copy_pos = 0
  hold close_prefix = 0
  hold lead_pos = 0
  hold lead_scan = 0
  hold open_count = 0
  hold close_count = 0
  hold in_quote = 0
  hold escaped = 0
  hold in_comment = 0
  hold scan_pos = 0
  hold sc = 0
  hold line_depth = 0
  hold indent = ""
  hold indent_pos = 0
  n = len(src)
  when n > 0 {
    when sx_index(src, n - 1) != 10 {
      src = src + "\n"
      n = len(src)
    }
  }
  while pos < n {
    c = sx_index(src, pos)
    when c == 10 {
      left = 0
      right = len(line)
      while left < right {
        t = sx_index(line, left)
        when t == 32 || t == 9 || t == 13 {
          left += 1
        } otherwise {
          break
        }
      }
      while right > left {
        t = sx_index(line, right - 1)
        when t == 32 || t == 9 || t == 13 {
          right -= 1
        } otherwise {
          break
        }
      }
      body = ""
      copy_pos = left
      while copy_pos < right {
        body = body + chr(sx_index(line, copy_pos))
        copy_pos += 1
      }
      // a line that starts with closing braces is indented at the depth those
      // braces return to
      close_prefix = 0
      lead_pos = 0
      lead_scan = 1
      while lead_scan == 1 {
        when lead_pos < len(body) {
          t = sx_index(body, lead_pos)
          when t == 125 {
            close_prefix += 1
            lead_pos += 1
          } otherwise {
            when t == 32 || t == 9 {
              lead_pos += 1
            } otherwise {
              lead_scan = 0
            }
          }
        } otherwise {
          lead_scan = 0
        }
      }
      // count braces, ignoring quoted strings and // comments
      open_count = 0
      close_count = 0
      in_quote = 0
      escaped = 0
      in_comment = 0
      scan_pos = 0
      while scan_pos < len(line) {
        sc = sx_index(line, scan_pos)
        when in_comment == 1 {
          scan_pos += 1
        } otherwise {
          when in_quote == 1 {
            when escaped == 1 {
              escaped = 0
            } otherwise {
              when sc == 92 {
                escaped = 1
              } otherwise {
                when sc == 34 {
                  in_quote = 0
                }
              }
            }
          } otherwise {
            when sc == 34 {
              in_quote = 1
            } otherwise {
              when sc == 47 && scan_pos + 1 < len(line) {
                when sx_index(line, scan_pos + 1) == 47 {
                  in_comment = 1
                }
              } otherwise {
                when sc == 123 {
                  open_count += 1
                }
                when sc == 125 {
                  close_count += 1
                }
              }
            }
          }
          scan_pos += 1
        }
      }
      when len(body) > 0 {
        line_depth = depth - close_prefix
        when line_depth < 0 {
          line_depth = 0
        }
        indent = ""
        indent_pos = 0
        while indent_pos < line_depth {
          indent = indent + "  "
          indent_pos += 1
        }
        result = result + indent
        result = result + body
      }
      result = result + "\n"
      depth = depth + open_count - close_count
      when depth < 0 {
        depth = 0
      }
      line = ""
    } otherwise {
      line = line + chr(c)
    }
    pos += 1
  }
  give result
}

// format_edit: one TextEdit replacing the whole buffer, or [] when the
// document is already formatted so the client leaves the buffer alone. The end
// of the range is the end of the document: one past the last newline when the
// text ends with one, else the UTF-16 width of the last line.
make format_edit(text: str) -> str {
  hold out = ""
  hold lines = 0
  hold endline = 0
  hold endch = 0
  hold lastline = ""
  hold span = [0, 0]
  hold b = ""
  out = format_text(text)
  when string_eq(out, text) == 1 {
    give "[]"
  }
  lines = count_lines(text)
  endline = lines
  endch = 0
  when len(text) > 0 {
    when sx_index(text, len(text) - 1) != 10 {
      endline = lines - 1
      lastline = line_text(text, endline)
      span = utf16_span(lastline, len(lastline))
      endch = span[0]
    }
  }
  b = "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":"
  b = b + numstr(endline)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}},\"newText\":\""
  b = b + json_esc(out)
  b = b + "\"}]"
  give b
}

// code_actions: the one action this server can truthfully offer -- format
// the document -- and only when formatting would change it. The edit is the
// same whole-buffer edit textDocument/formatting answers.
make code_actions(text: str, uri: str) -> str {
  hold fe = format_edit(text)
  hold b = "[]"
  when string_eq(fe, "[]") == 0 {
    hold b = "[{\"title\":\"Format this Sayanox document\",\"kind\":\"source.formatDocument\",\"edit\":{\"changes\":{\""
    hold b = concat(b, json_esc(uri))
    hold b = concat(b, "\":")
    hold b = concat(b, fe)
    hold b = concat(b, "}}}]")
  }
  give b
}

// ------------------------------------------------------------- completion

make completion_items() -> str {
  hold words = ""
  hold arr = ""
  hold count = 0
  hold n = 0
  hold i = 0
  hold c = 0
  hold d = 0
  hold w = ""
  hold item = ""
  words = "hold show when otherwise else elif while for break continue make give struct use true false and or not push concat len chr sx_index string_eq read_file write_file arg arg_count read_line read_n write_out flush_out numstr gc gc_live gc_runs"
  n = len(words)
  while i < n {
    c = sx_index(words, i)
    when is_ident(c) == 1 {
      w = ""
      while i < n {
        d = sx_index(words, i)
        when is_ident(d) == 1 {
          w = w + chr(d)
          i += 1
        } otherwise {
          break
        }
      }
      item = ""
      when count > 0 {
        item = ","
      }
      item = item + "{\"label\":\""
      item = item + w
      item = item + "\",\"kind\":14,\"detail\":\"standard\"}"
      arr = arr + item
      count += 1
    } otherwise {
      i += 1
    }
  }
  give concat("[", concat(arr, "]"))
}

// --------------------------------------------------------- hover / definition

make hover_for(w: str, text: str) -> str {
  hold d = ""
  hold md = ""
  hold pat = ""
  hold lines = 0
  hold l = 0
  hold line = ""
  hold found = 0
  hold b = ""
  hold hd = ""
  d = doc_for(w)
  when len(w) <= 0 {
    md = "**Sayanox** — hold / show / when / while / make / give / struct, lists, and the standard builtins."
  } otherwise {
    when len(d) > 0 {
      md = d
    } otherwise {
      pat = concat("make ", w)
      lines = count_lines(text)
      while l < lines {
        line = line_text(text, l)
        when found == 0 {
          when starts(line, 0, pat) == 1 {
            md = concat("`", line)
            md = concat(md, "`")
            found = 1
          }
        }
        l += 1
      }
      when found == 0 {
        hd = concat("hold ", w)
        when find(text, hd) >= 0 {
          md = concat("`", w)
          md = concat(md, "` — a variable in this document.")
        } otherwise {
          md = concat("`", w)
          md = concat(md, "` — no declaration in this document.")
        }
      }
    }
  }
  b = "{\"contents\":{\"kind\":\"markdown\",\"value\":\""
  b = b + json_esc(md)
  b = b + "\"}}"
  give b
}

make definition_for(w: str, text: str, uri: str) -> str {
  hold res = "null"
  hold lines = 0
  hold l = 0
  hold found = 0
  hold line = ""
  hold m = 0
  hold mk = ""
  hold hd = ""
  hold sd = ""
  hold b = ""
  when len(w) > 0 {
    lines = count_lines(text)
    while l < lines {
      when found == 0 {
        line = line_text(text, l)
        m = 0
        while m < len(line) {
          when sx_index(line, m) == 32 || sx_index(line, m) == 9 {
            m += 1
          } otherwise {
            break
          }
        }
        mk = concat("make ", w)
        hd = concat("hold ", w)
        sd = concat("struct ", w)
        when starts(line, m, mk) == 1 {
          found = 1
        }
        when starts(line, m, hd) == 1 {
          found = 1
        }
        when starts(line, m, sd) == 1 {
          found = 1
        }
        when found == 1 {
          b = "{\"uri\":\""
          b = b + json_esc(uri)
          b = b + "\",\"range\":{\"start\":{\"line\":"
          b = b + numstr(l)
          b = b + ",\"character\":0},\"end\":{\"line\":"
          b = b + numstr(l)
          b = b + ",\"character\":1}}"
          res = b
        }
      }
      l += 1
    }
  }
  give res
}

// ------------------------------------------------------------- transport

make emit(s: str) -> num {
  hold r = 0
  r = write_out(s)
  give r
}

make send(body: str) -> num {
  hold r = 0
  hold n = 0
  n = len(body)
  r = write_out("Content-Length: ")
  r = write_out(numstr(n))
  r = write_out("\r\n\r\n")
  r = write_out(body)
  r = flush_out()
  give r
}

// id_raw: the JSON text of the request id, exactly as sent: a number ("7",
// "-3"), a string with its quotes and escapes ("\"abc\""), or null.  Empty
// when the body has no id, which makes it a notification.  The raw text is
// echoed back unchanged, so a string id keeps its type in the reply.
make id_raw(msg: str) -> str {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold run = 1
  hold out = ""
  k = "\"id\""
  p = find(msg, k)
  when p < 0 {
    give ""
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give ""
  }
  p += 1
  n = len(msg)
  while p < n {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      break
    }
  }
  when p >= n {
    give ""
  }
  c = sx_index(msg, p)
  when c == 34 {
    out = "\""
    p += 1
    while run == 1 {
      when p >= n {
        run = 0
      } otherwise {
        c = sx_index(msg, p)
        when c == 92 {
          when p + 1 < n {
            out = out + chr(c)
            out = out + chr(sx_index(msg, p + 1))
            p += 2
          } otherwise {
            run = 0
          }
        } otherwise {
          out = out + chr(c)
          p += 1
          when c == 34 {
            run = 0
          }
        }
      }
    }
    give out
  }
  when starts(msg, p, "null") == 1 {
    give "null"
  }
  when c == 45 || (c >= 48 && c <= 57) {
    while run == 1 {
      when p >= n {
        run = 0
      } otherwise {
        c = sx_index(msg, p)
        when c == 45 || (c >= 48 && c <= 57) {
          out = out + chr(c)
          p += 1
        } otherwise {
          run = 0
        }
      }
    }
    give out
  }
  give ""
}

make reply(idraw: str, result: str) -> num {
  hold b = ""
  hold r = 0
  hold idt = idraw
  when len(idt) <= 0 {
    idt = "null"
  }
  b = concat("{\"jsonrpc\":\"2.0\",\"id\":", idt)
  b = concat(b, ",\"result\":")
  b = concat(b, result)
  b = concat(b, "}")
  r = send(b)
  give r
}

// reply_error: a JSON-RPC 2.0 error response.  An empty idraw means "no usable
// id" and is sent as null (the spec's answer for a body that cannot be parsed).
make reply_error(idraw: str, code: num, msg: str) -> num {
  hold b = ""
  hold r = 0
  hold idt = idraw
  when len(idt) <= 0 {
    idt = "null"
  }
  b = concat("{\"jsonrpc\":\"2.0\",\"id\":", idt)
  b = concat(b, ",\"error\":{\"code\":")
  b = concat(b, numstr(code))
  b = concat(b, ",\"message\":\"")
  b = concat(b, msg)
  b = concat(b, "\"}}")
  r = send(b)
  give r
}

// known_method: 1 when the server dispatches this method, else 0. Kept in
// step with the dispatch chain in main; an unknown *request* gets -32601.
make known_method(m: str) -> num {
  when string_eq(m, "initialize") {
    give 1
  }
  when string_eq(m, "initialized") {
    give 1
  }
  when string_eq(m, "shutdown") {
    give 1
  }
  when string_eq(m, "exit") {
    give 1
  }
  when string_eq(m, "textDocument/didOpen") {
    give 1
  }
  when string_eq(m, "textDocument/didChange") {
    give 1
  }
  when string_eq(m, "textDocument/didClose") {
    give 1
  }
  when string_eq(m, "textDocument/diagnostic") {
    give 1
  }
  when string_eq(m, "textDocument/documentSymbol") {
    give 1
  }
  when string_eq(m, "textDocument/completion") {
    give 1
  }
  when string_eq(m, "textDocument/hover") {
    give 1
  }
  when string_eq(m, "textDocument/definition") {
    give 1
  }
  when string_eq(m, "textDocument/references") {
    give 1
  }
  when string_eq(m, "textDocument/formatting") {
    give 1
  }
  when string_eq(m, "workspace/symbol") {
    give 1
  }
  when string_eq(m, "textDocument/rename") {
    give 1
  }
  when string_eq(m, "textDocument/signatureHelp") {
    give 1
  }
  when string_eq(m, "textDocument/codeAction") {
    give 1
  }
  give 0
}

// first_char: the first non-whitespace byte of a body (-1 if none). A JSON-RPC
// body must be an object, so anything but '{' is a parse error.
make first_char(s: str) -> num {
  hold i = 0
  hold n = len(s)
  hold c = -1
  while i < n {
    hold c = sx_index(s, i)
    when c != 32 && c != 9 && c != 10 && c != 13 {
      give c
    }
    hold i = i + 1
  }
  give -1
}

make notify(method: str, params: str) -> num {
  hold b = ""
  hold r = 0
  b = concat("{\"jsonrpc\":\"2.0\",\"method\":\"", method)
  b = concat(b, "\",\"params\":")
  b = concat(b, params)
  b = concat(b, "}")
  r = send(b)
  give r
}

make capabilities() -> str {
  hold c = ""
  c = "{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":1,\"completionProvider\":{\"triggerCharacters\":[\" \"]},"
  c = concat(c, "\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,")
  c = concat(c, "\"referencesProvider\":true,\"documentFormattingProvider\":true,\"workspaceSymbolProvider\":true,\"renameProvider\":true,\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"codeActionProvider\":true,")
  c = concat(c, "\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false}}")
  give c
}

make dir_of(uri: str) -> str {
  hold off = 0
  hold p = 0
  hold i = 0
  hold n = 0
  hold last = 0
  hold d = ""
  hold j = 0
  hold c = 0
  p = find(uri, "file://")
  when p >= 0 {
    off = p + 7
  }
  i = off
  n = len(uri)
  last = off
  while i < n {
    c = sx_index(uri, i)
    when c == 47 {
      last = i + 1
    }
    i += 1
  }
  j = off
  while j < last {
    d = d + chr(sx_index(uri, j))
    j += 1
  }
  give d
}

// --------------------------------------------------------------- main loop

// Native directory enumeration is bound only in the LSP build by a checked
// generated-C transformation. Compiling this file alone gives no disk index.
make workspace_manifest(root: str) -> str {
  give ""
}

make workspace_text(manifest: str, uri: str) -> str {
  hold row = 0
  hold total = count_lines(manifest)
  while row + 1 < total {
    hold candidate = line_text(manifest, row)
    when string_eq(candidate, uri) {
      hold path = line_text(manifest, row + 1)
      give read_file(path)
    }
    row = row + 2
  }
  give ""
}

// Open buffers are scanned separately and override their on-disk copies.
make workspace_scan(manifest: str, word: str, query: str, mode: num, incl: num, first: num, open0: str, open1: str, open2: str, open3: str) -> str {
  hold out = ""
  hold row = 0
  hold total = count_lines(manifest)
  while row + 1 < total {
    hold candidate = line_text(manifest, row)
    hold path = line_text(manifest, row + 1)
    when string_eq(candidate, open0) == 0 && string_eq(candidate, open1) == 0 && string_eq(candidate, open2) == 0 && string_eq(candidate, open3) == 0 {
      hold source = read_file(path)
      hold part = ""
      when mode == 0 {
        part = sym_scan(source, candidate, query, first + len(out))
      } otherwise {
        part = refs_for(word, source, candidate, incl, first + len(out))
      }
      out = concat(out, part)
    }
    row = row + 2
  }
  give out
}

// ------------------------------------------------------- open documents
// Four documents can be open at once. The dialect has no array of strings, so
// the table is four parallel pairs of globals, and exactly three places touch
// it: the load cascade under the framing loop, didOpen (store) and didClose
// (clear). `doc`/`docuri` are NOT the table -- they are the document the
// message being handled refers to, reloaded per message, which is what makes
// hover/definition/documentSymbol/diagnostic answer from the right buffer.
// A fifth didOpen evicts the oldest slot (round robin through slotnext) and the
// evicted document simply stops being served: a request for it gets an empty
// text, so hover answers null and documentSymbol answers [] instead of
// answering from another file.
hold uri0 = ""
hold txt0 = ""
hold uri1 = ""
hold txt1 = ""
hold uri2 = ""
hold txt2 = ""
hold uri3 = ""
hold txt3 = ""
hold workspace_root = ""
hold workspace_index = ""
hold slotnext = 0
hold placed = 0
hold doc = ""
hold docuri = ""
hold running = 1
hold hdr = ""
hold clen = 0
hold got = 0
hold body = ""
hold method = ""
hold idraw = ""
hold uri = ""
hold text = ""
hold line = 0
hold ch = 0
hold w = ""
hold res = ""
hold params = ""
hold d = 0
hold c = 0
hold v = 0
hold i = 0
hold n = 0
hold seen = 0
hold ln = 0
hold incl = 1
hold part = ""
hold part2 = ""
hold q = ""

while running == 1 {
  hdr = read_line()
  when len(hdr) <= 0 {
    running = 0
  } otherwise {
    clen = -1
    got = 0
    while len(hdr) > 0 {
      when starts(hdr, 0, "Content-Length:") == 1 {
        v = 0
        seen = 0
        i = 15
        n = len(hdr)
        while i < n {
          c = sx_index(hdr, i)
          when c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            seen = 1
          }
          i += 1
        }
        when seen == 1 {
          clen = v
          got = 1
        }
      }
      hdr = read_line()
    }
    when got == 1 && clen > 0 {
      body = read_n(clen)
      idraw = id_raw(body)
      method = str_field(body, "method")
      when len(method) <= 0 {
        method = ""
      }
      uri = str_field(body, "uri")
      text = str_field(body, "text")
      ln = num_field(body, "line", 0)
      ch = num_field(body, "character", 0)
      // Load the document this message is about. A message whose uri is not
      // open leaves doc empty (and every reader below then answers "nothing
      // here" rather than reading the buffer that happened to be opened last).
      doc = ""
      docuri = uri
      when string_eq(uri, uri0) {
        doc = txt0
      }
      when string_eq(uri, uri1) {
        doc = txt1
      }
      when string_eq(uri, uri2) {
        doc = txt2
      }
      when string_eq(uri, uri3) {
        doc = txt3
      }
      when string_eq(method, "initialize") {
        workspace_root = str_field(body, "rootUri")
        when len(workspace_root) == 0 {
          workspace_root = str_field(body, "uri")
        }
        res = concat("{\"capabilities\":", capabilities())
        res = concat(res, ",\"serverInfo\":{\"name\":\"sayanox-lsp\",\"version\":\"2.0\"}}")
        d = reply(idraw, res)
      }
      when string_eq(method, "initialized") {
        d = 1
      }
      when string_eq(method, "shutdown") {
        d = reply(idraw, "null")
      }
      when string_eq(method, "textDocument/didOpen") {
        // Reuse this uri's slot when it is already open, else take the next
        // slot round robin (evicting the document that has been open longest).
        placed = 0
        when string_eq(uri, uri0) {
          txt0 = text
          placed = 1
        }
        when string_eq(uri, uri1) {
          txt1 = text
          placed = 1
        }
        when string_eq(uri, uri2) {
          txt2 = text
          placed = 1
        }
        when string_eq(uri, uri3) {
          txt3 = text
          placed = 1
        }
        when placed == 0 {
          when slotnext == 0 {
            uri0 = uri
            txt0 = text
          }
          when slotnext == 1 {
            uri1 = uri
            txt1 = text
          }
          when slotnext == 2 {
            uri2 = uri
            txt2 = text
          }
          when slotnext == 3 {
            uri3 = uri
            txt3 = text
          }
          when slotnext >= 3 {
            slotnext = 0
          } otherwise {
            slotnext = slotnext + 1
          }
        }
        docuri = uri
        doc = text
        params = concat("{\"uri\":\"", json_esc(docuri))
        params = concat(params, "\",\"diagnostics\":")
        params = concat(params, diagnostics(doc, dir_of(docuri)))
        params = concat(params, "}")
        d = notify("textDocument/publishDiagnostics", params)
      }
      when string_eq(method, "textDocument/didChange") {
        // Empty text is a replacement; an empty change array is a no-op, so the
        // buffer is only rewritten when the body really carries "text".
        when find(body, "\"text\"") >= 0 {
          when string_eq(uri, uri0) {
            txt0 = text
          }
          when string_eq(uri, uri1) {
            txt1 = text
          }
          when string_eq(uri, uri2) {
            txt2 = text
          }
          when string_eq(uri, uri3) {
            txt3 = text
          }
        }
        // Reload, then publish only for a document that is actually open: a
        // change to an unknown uri must not be answered from another buffer.
        placed = 0
        doc = ""
        when string_eq(uri, uri0) {
          doc = txt0
          placed = 1
        }
        when string_eq(uri, uri1) {
          doc = txt1
          placed = 1
        }
        when string_eq(uri, uri2) {
          doc = txt2
          placed = 1
        }
        when string_eq(uri, uri3) {
          doc = txt3
          placed = 1
        }
        docuri = uri
        when placed == 1 {
          params = concat("{\"uri\":\"", json_esc(docuri))
          params = concat(params, "\",\"diagnostics\":")
          params = concat(params, diagnostics(doc, dir_of(docuri)))
          params = concat(params, "}")
          d = notify("textDocument/publishDiagnostics", params)
        }
      }
      when string_eq(method, "textDocument/didClose") {
        when string_eq(uri, uri0) {
          uri0 = ""
          txt0 = ""
        }
        when string_eq(uri, uri1) {
          uri1 = ""
          txt1 = ""
        }
        when string_eq(uri, uri2) {
          uri2 = ""
          txt2 = ""
        }
        when string_eq(uri, uri3) {
          uri3 = ""
          txt3 = ""
        }
        doc = ""
        docuri = ""
        params = concat("{\"uri\":\"", json_esc(uri))
        params = concat(params, "\",\"diagnostics\":[]}")
        d = notify("textDocument/publishDiagnostics", params)
      }
      when string_eq(method, "textDocument/diagnostic") {
        res = concat("{\"kind\":\"full\",\"items\":", diagnostics(doc, dir_of(docuri)))
        res = concat(res, "}")
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/documentSymbol") {
        d = reply(idraw, symbols(doc, docuri))
      }
      when string_eq(method, "textDocument/completion") {
        res = concat("{\"isIncomplete\":false,\"items\":", completion_items())
        res = concat(res, "}")
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/hover") {
        w = word_at(doc, ln, ch)
        d = reply(idraw, hover_for(w, doc))
      }
      when string_eq(method, "textDocument/definition") {
        w = word_at(doc, ln, ch)
        d = reply(idraw, definition_for(w, doc, docuri))
      }
      // Open buffers overlay the bounded disk index. Helpers cannot capture
      // the four-slot table, so the
      // cascade lives here: each slot is scanned in turn and the comma rule
      // inside the helper joins the items. len(res) is the running item count.
      when string_eq(method, "textDocument/references") {
        workspace_index = workspace_manifest(workspace_root)
        when string_eq(uri, uri0) == 0 && string_eq(uri, uri1) == 0 && string_eq(uri, uri2) == 0 && string_eq(uri, uri3) == 0 {
          doc = workspace_text(workspace_index, uri)
        }
        w = word_at(doc, ln, ch)
        incl = 1
        when find(body, "\"includeDeclaration\":false") >= 0 || find(body, "\"includeDeclaration\": false") >= 0 {
          incl = 0
        }
        res = refs_for(w, txt0, uri0, incl, 0)
        part = refs_for(w, txt1, uri1, incl, len(res))
        res = res + part
        part = refs_for(w, txt2, uri2, incl, len(res))
        res = res + part
        part = refs_for(w, txt3, uri3, incl, len(res))
        res = res + part
        part = workspace_scan(workspace_index, w, "", 1, incl, len(res), uri0, uri1, uri2, uri3)
        res = res + part
        res = concat("[", concat(res, "]"))
        d = reply(idraw, res)
      }
      when string_eq(method, "workspace/symbol") {
        workspace_index = workspace_manifest(workspace_root)
        q = str_field(body, "query")
        res = sym_scan(txt0, uri0, q, 0)
        part = sym_scan(txt1, uri1, q, len(res))
        res = res + part
        part = sym_scan(txt2, uri2, q, len(res))
        res = res + part
        part = sym_scan(txt3, uri3, q, len(res))
        res = res + part
        part = workspace_scan(workspace_index, "", q, 0, 1, len(res), uri0, uri1, uri2, uri3)
        res = res + part
        res = concat("[", concat(res, "]"))
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/formatting") {
        d = reply(idraw, format_edit(doc))
      }
      // Rename spans the open documents, like references: one changes entry
      // per open document that mentions the word, declaration included. An
      // empty word or an empty newName answers an empty WorkspaceEdit.
      when string_eq(method, "textDocument/rename") {
        w = word_at(doc, ln, ch)
        part = str_field(body, "newName")
        res = "{\"changes\":{"
        q = ""
        when len(uri0) > 0 {
          part2 = rename_edits(w, part, txt0, 0)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri0)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri1) > 0 {
          part2 = rename_edits(w, part, txt1, 0)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri1)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri2) > 0 {
          part2 = rename_edits(w, part, txt2, 0)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri2)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri3) > 0 {
          part2 = rename_edits(w, part, txt3, 0)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri3)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        res = res + "}}"
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/signatureHelp") {
        w = word_at(doc, ln, ch)
        d = reply(idraw, sig_help(w, doc, ln, ch))
      }
      when string_eq(method, "textDocument/codeAction") {
        d = reply(idraw, code_actions(doc, docuri))
      }
      when string_eq(method, "exit") {
        running = 0
      }
      // Error paths. A body that is not a JSON object is a parse error (id
      // null). A method-less body is an invalid request. An unknown method is
      // answered only when it is a request (has an id): notifications are
      // silently ignored, as the spec requires, so clients never hang waiting.
      when first_char(body) != 123 {
        d = reply_error("", -32700, "parse error: body is not a JSON object")
      } otherwise {
        when len(method) <= 0 {
          d = reply_error(idraw, -32600, "invalid request: no method")
        } otherwise {
          when known_method(method) == 0 {
            when len(idraw) > 0 {
              d = reply_error(idraw, -32601, "method not found")
            }
          }
        }
      }
    }
  }
}
d = flush_out()
