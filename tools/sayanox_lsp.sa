// Sayanox language server (LSP 3.17 subset) — JSON-RPC over stdio.
//
// Built like the other tools:
//
//   make lsp        -> tools/sayanox_lsp
//   printf 'Content-Length: N\r\n\r\n{...}' | tools/sayanox_lsp
//
// Methods: initialize / initialized / shutdown / exit, textDocument didOpen,
// didChange, didClose, publishDiagnostics, diagnostic, documentSymbol,
// completion, hover, definition, references, workspace/symbol, formatting,
// rename, signatureHelp, codeAction. Workspace symbols/references also scan
// a bounded local folder with read_dir/path_kind/path_size/path_real. Rename
// stays open-buffer-only; see docs/LSP.md for the separate limits.
//
// The diagnostics are real checks over the document text: unknown statements,
// brace and paren balance, unterminated strings, and `use` targets that do not
// resolve next to the document. Nothing here shells out: protocol, scanning
// and the folder index are Sayanox compiled by gen2.

// ---------------------------------------------------------------- scanning

make starts(t: str, i: num, p: str) -> num {
  hold n = 0
  hold k = 0
  hold ok = 1
  hold c1 = 0
  hold c2 = 0
  n = len(p)
  when i + n > len(t) {
    give 0
  }
  while k < n {
    c1 = sx_index(t, i + k)
    c2 = sx_index(p, k)
    when c1 != c2 {
      ok = 0
      k = n
    }
    k += 1
  }
  give ok
}

make find_from(t: str, p: str, from: num) -> num {
  hold n = 0
  hold m = 0
  hold i = 0
  hold hit = 0
  n = len(t)
  m = len(p)
  when m <= 0 {
    give -1
  }
  when from > 0 {
    i = from
  }
  while i + m <= n {
    hit = starts(t, i, p)
    when hit == 1 {
      give i
    }
    i += 1
  }
  give -1
}

make find(t: str, p: str) -> num {
  hold r = 0
  r = find_from(t, p, 0)
  give r
}

make is_ident(c: num) -> num {
  hold ok = 0
  when c >= 97 && c <= 122 {
    ok = 1
  }
  when c >= 65 && c <= 90 {
    ok = 1
  }
  when c >= 48 && c <= 57 {
    ok = 1
  }
  when c == 95 {
    ok = 1
  }
  give ok
}

make is_word(c: num) -> num {
  hold ok = 0
  when c >= 97 && c <= 122 {
    ok = 1
  }
  when c >= 65 && c <= 90 {
    ok = 1
  }
  when c == 95 {
    ok = 1
  }
  give ok
}

// ------------------------------------------------------------ JSON strings

make json_esc(s: str) -> str {
  hold r = ""
  hold i = 0
  hold n = 0
  hold c = 0
  n = len(s)
  while i < n {
    c = sx_index(s, i)
    when c == 34 {
      r = r + "\\\""
    } otherwise {
      when c == 92 {
        r = r + "\\\\"
      } otherwise {
        when c == 10 {
          r = r + "\\n"
        } otherwise {
          when c == 13 {
            r = r + "\\r"
          } otherwise {
            when c == 9 {
              r = r + "\\t"
            } otherwise {
              r = r + chr(c)
            }
          }
        }
      }
    }
    i += 1
  }
  give r
}

// Unicode boundary helpers. Internal scanner offsets are UTF-8 bytes;
// protocol positions are UTF-16 code units (the LSP default).
make hex4(s: str, at: num) -> num {
  hold v = 0
  hold k = 0
  hold c = 0
  hold d = 0
  when at + 4 > len(s) {
    give -1
  }
  while k < 4 {
    c = sx_index(s, at + k)
    d = -1
    when c >= 48 and c <= 57 {
      d = c - 48
    }
    when c >= 65 and c <= 70 {
      d = c - 55
    }
    when c >= 97 and c <= 102 {
      d = c - 87
    }
    when d < 0 {
      give -1
    }
    v = v * 16 + d
    k = k + 1
  }
  give v
}

make utf8_scalar(v: num) -> str {
  hold r = ""
  hold a = 0
  hold b = 0
  hold c = 0
  // The runtime uses NUL-terminated strings; U+0000 is not representable.
  when v <= 0 or v > 1114111 {
    v = 65533
  }
  when v >= 55296 and v <= 57343 {
    v = 65533
  }
  when v < 128 {
    give chr(v)
  }
  a = (v - v % 64) / 64
  when v < 2048 {
    r = concat(chr(192 + a), chr(128 + v % 64))
    give r
  }
  b = (a - a % 64) / 64
  when v < 65536 {
    r = concat(chr(224 + b), chr(128 + a % 64))
    give concat(r, chr(128 + v % 64))
  }
  c = (b - b % 64) / 64
  r = concat(chr(240 + c), chr(128 + b % 64))
  r = concat(r, chr(128 + a % 64))
  give concat(r, chr(128 + v % 64))
}

make utf8_width(s: str, i: num) -> num {
  hold c = 0
  hold d = 0
  hold width = 1
  hold k = 1
  when i >= len(s) {
    give 0
  }
  c = sx_index(s, i)
  when c >= 194 and c <= 223 {
    width = 2
  }
  when c >= 224 and c <= 239 {
    width = 3
  }
  when c >= 240 and c <= 244 {
    width = 4
  }
  when i + width > len(s) {
    give 1
  }
  while k < width {
    d = sx_index(s, i + k)
    when d < 128 or d > 191 {
      give 1
    }
    k = k + 1
  }
  when width >= 3 {
    d = sx_index(s, i + 1)
    when c == 224 and d < 160 {
      give 1
    }
    when c == 237 and d >= 160 {
      give 1
    }
    when c == 240 and d < 144 {
      give 1
    }
    when c == 244 and d >= 144 {
      give 1
    }
  }
  give width
}

make utf16_byte(s: str, units: num) -> num {
  hold i = 0
  hold u = 0
  hold width = 0
  hold step = 0
  while i < len(s) and u < units {
    when sx_index(s, i) == 10 or sx_index(s, i) == 13 {
      break
    }
    width = utf8_width(s, i)
    step = 1
    when width == 4 {
      step = 2
    }
    when u + step > units {
      break
    }
    u = u + step
    i = i + width
  }
  give i
}

// Span of the codepoint containing a scanner byte offset. Never split a
// surrogate pair. At EOF produce a zero-width span rather than overshoot.
make utf16_span(s: str, offset: num) -> list {
  hold i = 0
  hold u = 0
  hold width = 0
  hold step = 0
  hold result = [0, 0]
  while i < len(s) {
    width = utf8_width(s, i)
    step = 1
    when width == 4 {
      step = 2
    }
    when i + width > offset {
      result = [u, u + step]
      give result
    }
    i = i + width
    u = u + step
  }
  result = [u, u]
  give result
}

make unesc(s: str) -> str {
  hold r = ""
  hold i = 0
  hold c = 0
  hold d = 0
  hold v = 0
  hold low = 0
  while i < len(s) {
    c = sx_index(s, i)
    when c == 92 and i + 1 < len(s) {
      d = sx_index(s, i + 1)
      when d == 117 {
        v = hex4(s, i + 2)
        i = i + 6
        when v >= 55296 and v <= 56319 {
          when starts(s, i, "\\u") == 1 {
            low = hex4(s, i + 2)
            when low >= 56320 and low <= 57343 {
              v = 65536 + (v - 55296) * 1024 + low - 56320
              i = i + 6
            }
          }
        }
        r = concat(r, utf8_scalar(v))
      } otherwise {
        when d == 110 {
          d = 10
        }
        elif d == 114 {
          d = 13
        }
        elif d == 116 {
          d = 9
        }
        elif d == 98 {
          d = 8
        }
        elif d == 102 {
          d = 12
        }
        r = concat(r, chr(d))
        i = i + 2
      }
    } otherwise {
      r = concat(r, chr(c))
      i = i + 1
    }
  }
  give r
}

make str_field(msg: str, key: str) -> str {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold out = ""
  hold run = 1
  hold nc = 0
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find(msg, k)
  when p < 0 {
    give ""
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give ""
  }
  p += 1
  n = len(msg)
  while p < n {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      run = 0
      p = p
      break
    }
  }
  when p >= n {
    give ""
  }
  when sx_index(msg, p) != 34 {
    give ""
  }
  p += 1
  run = 1
  while run == 1 {
    when p >= n {
      run = 0
    } otherwise {
      c = sx_index(msg, p)
      when c == 92 {
        when p + 1 < n {
          out = out + chr(c)
          nc = sx_index(msg, p + 1)
          out = out + chr(nc)
          p += 2
        } otherwise {
          run = 0
        }
      } otherwise {
        when c == 34 {
          run = 0
          p += 1
        } otherwise {
          out = out + chr(c)
          p += 1
        }
      }
    }
  }
  give unesc(out)
}

make num_field(msg: str, key: str, def: num) -> num {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold v = 0
  hold got = 0
  hold skip = 1
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find(msg, k)
  when p < 0 {
    give def
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give def
  }
  p += 1
  n = len(msg)
  while p < n && skip == 1 {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      skip = 0
    }
  }
  while p < n {
    c = sx_index(msg, p)
    when c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
      got = 1
      p += 1
    } otherwise {
      break
    }
  }
  when got == 0 {
    give def
  }
  give v
}

// Same scan as num_field/str_field, but starting at `from`, so one message can
// carry several objects with identically named fields (a change object's
// `range.start` and `range.end` both have `line`/`character`).
make num_field_from(msg: str, key: str, from: num, def: num) -> num {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold v = 0
  hold got = 0
  hold skip = 1
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find_from(msg, k, from)
  when p < 0 {
    give def
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give def
  }
  p += 1
  n = len(msg)
  while p < n && skip == 1 {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      skip = 0
    }
  }
  while p < n {
    c = sx_index(msg, p)
    when c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
      got = 1
      p += 1
    } otherwise {
      break
    }
  }
  when got == 0 {
    give def
  }
  give v
}

make str_field_from(msg: str, key: str, from: num) -> str {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold out = ""
  hold run = 1
  hold nc = 0
  k = concat("\"", key)
  k = concat(k, "\"")
  p = find_from(msg, k, from)
  when p < 0 {
    give ""
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give ""
  }
  p += 1
  n = len(msg)
  while p < n {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      run = 0
      p = p
      break
    }
  }
  run = 1
  when p >= n {
    give ""
  }
  when sx_index(msg, p) != 34 {
    give ""
  }
  p += 1
  while run == 1 {
    when p >= n {
      run = 0
    } otherwise {
      c = sx_index(msg, p)
      when c == 92 {
        when p + 1 < n {
          out = out + chr(c)
          nc = sx_index(msg, p + 1)
          out = out + chr(nc)
          p += 2
        } otherwise {
          run = 0
        }
      } otherwise {
        when c == 34 {
          run = 0
          p += 1
        } otherwise {
          out = out + chr(c)
          p += 1
        }
      }
    }
  }
  give unesc(out)
}

// -------------------------------------------- bounded JSON object scanning
// R05: one didChange notification may carry several change objects, so field
// scans have to stay inside the element they belong to. `find_from` re-finds
// the same key at `at`, which is why the bounded readers can reuse the
// unbounded ones after the bound check.

make key_lit(key: str) -> str {
  hold k = concat("\"", key)
  give concat(k, "\"")
}

make num_field_between(msg: str, key: str, from: num, to: num, def: num) -> num {
  hold p = find_from(msg, key_lit(key), from)
  when p < 0 {
    give def
  }
  when p >= to {
    give def
  }
  give num_field_from(msg, key, p, def)
}

make str_field_between(msg: str, key: str, from: num, to: num, def: str) -> str {
  hold p = find_from(msg, key_lit(key), from)
  when p < 0 {
    give def
  }
  when p >= to {
    give def
  }
  give str_field_from(msg, key, p)
}

// End offset (just past the closing brace) of the JSON object that opens at
// `open`. Strings and backslash escapes are skipped, so braces inside a
// replacement text cannot end the object early. An unterminated object ends at
// the message end; the caller then clamps with the same helpers it uses for
// out-of-range positions.
make obj_end(msg: str, open: num) -> num {
  hold n = len(msg)
  hold i = open
  hold depth = 0
  hold instr = 0
  hold c = 0
  while i < n {
    c = sx_index(msg, i)
    when instr == 1 {
      when c == 92 {
        i += 2
      } otherwise {
        when c == 34 {
          instr = 0
        }
        i += 1
      }
    } otherwise {
      when c == 34 {
        instr = 1
        i += 1
      } otherwise {
        when c == 123 {
          depth += 1
          i += 1
        } otherwise {
          when c == 125 {
            depth -= 1
            i += 1
            when depth == 0 {
              give i
            }
          } otherwise {
            i += 1
          }
        }
      }
    }
  }
  give n
}

// ------------------------------------------------------------- line access

make line_start(text: str, line: num) -> num {
  hold i = 0
  hold n = 0
  hold l = 0
  hold c = 0
  hold ok = 0
  n = len(text)
  when line <= 0 {
    give 0
  }
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      l += 1
      when l >= line {
        give i + 1
      }
    }
    i += 1
  }
  give n
}

make line_end(text: str, line: num) -> num {
  hold i = 0
  hold n = 0
  hold c = 0
  i = line_start(text, line)
  n = len(text)
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      give i
    }
    i += 1
  }
  give n
}

make line_text(text: str, line: num) -> str {
  hold a = 0
  hold b = 0
  hold r = ""
  hold i = 0
  hold c = 0
  a = line_start(text, line)
  b = line_end(text, line)
  i = a
  while i < b {
    c = sx_index(text, i)
    when c != 13 {
      r = r + chr(c)
    }
    i += 1
  }
  give r
}

make count_lines(text: str) -> num {
  hold i = 0
  hold n = 0
  hold l = 0
  hold c = 0
  n = len(text)
  while i < n {
    c = sx_index(text, i)
    when c == 10 {
      l += 1
    }
    i += 1
  }
  when n > 0 {
    c = sx_index(text, n - 1)
    when c != 10 {
      l += 1
    }
  }
  give l
}

make word_at(text: str, line: num, ch: num) -> str {
  hold a = 0
  hold p = 0
  hold n = 0
  hold w = ""
  hold c = 0
  hold ok = 0
  a = line_start(text, line)
  p = a + utf16_byte(line_text(text, line), ch)
  n = a + len(line_text(text, line))
  when p > n {
    p = n
  }
  ok = 1
  while p > a && ok == 1 {
    c = sx_index(text, p - 1)
    ok = is_ident(c)
    when ok == 1 {
      p -= 1
    }
  }
  ok = 1
  while p < n && ok == 1 {
    c = sx_index(text, p)
    ok = is_ident(c)
    when ok == 1 {
      w = w + chr(c)
      p += 1
    }
  }
  give w
}

// ------------------------------------------------------ language knowledge

make known_word(w: str) -> num {
  hold ok = 0
  when string_eq(w, "hold") || string_eq(w, "show") || string_eq(w, "give") {
    ok = 1
  }
  when string_eq(w, "when") || string_eq(w, "otherwise") || string_eq(w, "else") {
    ok = 1
  }
  when string_eq(w, "elif") || string_eq(w, "while") || string_eq(w, "for") {
    ok = 1
  }
  when string_eq(w, "break") || string_eq(w, "continue") {
    ok = 1
  }
  when string_eq(w, "make") || string_eq(w, "struct") || string_eq(w, "use") || string_eq(w, "module") {
    ok = 1
  }
  when string_eq(w, "true") || string_eq(w, "false") {
    ok = 1
  }
  when string_eq(w, "and") || string_eq(w, "or") || string_eq(w, "not") {
    ok = 1
  }
  when string_eq(w, "concat") || string_eq(w, "len") || string_eq(w, "chr") {
    ok = 1
  }
  when string_eq(w, "sx_index") || string_eq(w, "index") || string_eq(w, "push") {
    ok = 1
  }
  when string_eq(w, "string_eq") || string_eq(w, "sx_eq") {
    ok = 1
  }
  when string_eq(w, "read_file") || string_eq(w, "write_file") {
    ok = 1
  }
  when string_eq(w, "arg") || string_eq(w, "arg_count") {
    ok = 1
  }
  when string_eq(w, "read_line") || string_eq(w, "read_n") {
    ok = 1
  }
  when string_eq(w, "write_out") || string_eq(w, "flush_out") {
    ok = 1
  }
  when string_eq(w, "numstr") || string_eq(w, "str") {
    ok = 1
  }
  when string_eq(w, "gc") || string_eq(w, "gc_live") || string_eq(w, "gc_runs") {
    ok = 1
  }
  when string_eq(w, "spawn") || string_eq(w, "child_send") {
    ok = 1
  }
  when string_eq(w, "child_recv") || string_eq(w, "child_line") || string_eq(w, "child_close") {
    ok = 1
  }
  when string_eq(w, "make_dir") || string_eq(w, "make_link") || string_eq(w, "remove_path") {
    ok = 1
  }
  give ok
}

make declared_in(text: str, w: str) -> num {
  hold p = 0
  hold pat = ""
  hold found = 0
  pat = concat("hold ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  pat = concat("make ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  pat = concat("struct ", w)
  p = find(text, pat)
  when p >= 0 {
    found = 1
  }
  give found
}

make doc_for(w: str) -> str {
  hold d = ""
  when string_eq(w, "hold") {
    d = "`hold name = value` declares a variable (or `hold name: type = value`)."
  }
  when string_eq(w, "show") {
    d = "`show EXPR` prints a value."
  }
  when string_eq(w, "when") {
    d = "`when COND { ... }` runs the block when COND is non-zero; `otherwise` is the else branch."
  }
  when string_eq(w, "while") {
    d = "`while COND { ... }` loops while COND is non-zero."
  }
  when string_eq(w, "for") {
    d = "`for i in 0..10 { ... }` counts; `for v in xs { ... }` walks a list."
  }
  when string_eq(w, "make") {
    d = "`make name(a, b: str) -> str { give a }` defines a function."
  }
  when string_eq(w, "give") {
    d = "`give EXPR` returns a value from a function."
  }
  when string_eq(w, "struct") {
    d = "`struct Point { x, y }` declares a struct type."
  }
  when string_eq(w, "use") {
    d = "`use \"file.sa\"` splices another source file in place."
  }
  when string_eq(w, "push") {
    d = "`push(xs, v)` appends a number to a list."
  }
  when string_eq(w, "concat") {
    d = "`concat(a, b)` joins two strings."
  }
  when string_eq(w, "len") {
    d = "`len(s)` is a string's byte length; `len(xs)` a list's element count."
  }
  when string_eq(w, "chr") {
    d = "`chr(n)` is the one-byte string with code n."
  }
  when string_eq(w, "sx_index") {
    d = "`sx_index(s, i)` is the byte at index i (same as `s[i]`)."
  }
  when string_eq(w, "gc") {
    d = "`gc()` collects now and returns the bytes it reclaimed."
  }
  when string_eq(w, "gc_live") {
    d = "`gc_live()` is the bytes held by the managed heap."
  }
  when string_eq(w, "gc_runs") {
    d = "`gc_runs()` is the number of collections so far."
  }
  when string_eq(w, "read_line") {
    d = "`read_line()` reads one line from stdin without the newline."
  }
  when string_eq(w, "read_n") {
    d = "`read_n(n)` reads exactly n bytes from stdin."
  }
  when string_eq(w, "write_out") {
    d = "`write_out(s)` writes s to stdout without a newline."
  }
  when string_eq(w, "flush_out") {
    d = "`flush_out()` flushes stdout."
  }
  when string_eq(w, "numstr") {
    d = "`numstr(n)` formats a number as a string."
  }
  when string_eq(w, "read_file") {
    d = "`read_file(path)` returns the file text, or \"\" when unreadable."
  }
  when string_eq(w, "write_file") {
    d = "`write_file(path, text)` writes a file and returns a status."
  }
  when string_eq(w, "arg") {
    d = "`arg(i)` is command-line argument i."
  }
  when string_eq(w, "arg_count") {
    d = "`arg_count()` is the number of command-line arguments."
  }
  when string_eq(w, "spawn") {
    d = "`spawn(path)` starts a child with piped stdin/stdout and returns a handle."
  }
  when string_eq(w, "child_send") {
    d = "`child_send(h, s)` writes s to the child's stdin."
  }
  when string_eq(w, "child_recv") {
    d = "`child_recv(h, n)` reads up to n bytes from the child's stdout."
  }
  when string_eq(w, "child_line") {
    d = "`child_line(h)` reads one line from the child's stdout."
  }
  when string_eq(w, "child_close") {
    d = "`child_close(h)` closes the child's stdin and returns its exit status."
  }
  when string_eq(w, "make_dir") {
    d = "`make_dir(path)` creates a directory and returns a status."
  }
  when string_eq(w, "make_link") {
    d = "`make_link(target, path)` creates a symlink and returns a status."
  }
  when string_eq(w, "remove_path") {
    d = "`remove_path(path)` removes a file or an empty directory."
  }
  when string_eq(w, "module") {
    d = "`module name [as alias] from \"path.sa\"` imports a namespaced module."
  }
  give d
}

// ------------------------------------------------------------- diagnostics

make diag_item(line: num, span: list, sev: num, code: str, msg: str, first: num) -> str {
  hold ch = span[0]
  hold endch = span[1]
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(ch)
  b = b + "},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}},\"severity\":"
  b = b + numstr(sev)
  b = b + ",\"code\":\""
  b = b + code
  b = b + "\",\"source\":\"sayanox\",\"message\":\""
  b = b + json_esc(msg)
  b = b + "\"}"
  give b
}

make diagnostics(text: str, dir: str) -> str {
  hold items = ""
  hold count = 0
  hold lines = 0
  hold depth = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold a = 0
  hold blank = 0
  hold bd = 0
  hold st = 0
  hold j = 0
  hold c = 0
  hold cmt = 0
  hold pd = 0
  hold k = 0
  hold w = ""
  hold q = 0
  hold rest = 0
  hold expected = 0
  hold is_assign = 0
  hold is_call = 0
  hold msg = ""
  hold u = 0
  hold v = 0
  hold path = ""
  hold full = ""
  hold body = ""
  hold z = 0
  hold l2 = 0
  hold pdepth = 0
  hold popen_line = 0
  hold was_in_parens = 0
  lines = count_lines(text)
  while l < lines {
    line = line_text(text, l)
    n = len(line)
    i = 0
    while i < n {
      c = sx_index(line, i)
      when c == 32 || c == 9 {
        i += 1
      } otherwise {
        break
      }
    }
    a = i
    blank = 0
    when i >= n {
      blank = 1
    }
    when blank == 0 {
      c = sx_index(line, i)
      when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
        blank = 1
      }
    }
    when blank == 0 {
      // braces and parens balance across statements (strings & // excluded)
      bd = 0
      pd = 0
      st = 0
      cmt = 0
      j = i
      while j < n {
        c = sx_index(line, j)
        when st == 1 {
          when c == 92 {
            j += 2
          } otherwise {
            when c == 34 {
              st = 0
            }
            j += 1
          }
        } otherwise {
          when c == 34 {
            st = 1
            j += 1
          } otherwise {
            when c == 47 && j + 1 < n && sx_index(line, j + 1) == 47 {
              j = n
              cmt = 1
            } otherwise {
              when c == 123 {
                bd += 1
              }
              when c == 125 {
                bd -= 1
              }
              when c == 40 {
                pd += 1
              }
              when c == 41 {
                pd -= 1
              }
              j += 1
            }
          }
        }
      }
      when cmt == 0 && st == 1 {
        items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1002", "unterminated string", count)
        count += 1
      }
      depth = depth + bd
      was_in_parens = 0
      when pdepth > 0 {
        was_in_parens = 1
      }
      when pdepth == 0 && pd > 0 {
        popen_line = l
      }
      pdepth = pdepth + pd
      when pdepth < 0 {
        items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1004", "unbalanced parentheses", count)
        count += 1
        pdepth = 0
      }
      when pdepth > 0 && bd != 0 {
        items = items + diag_item(popen_line, utf16_span(line_text(text, popen_line), 0), 1, "SX1004", "unbalanced parentheses", count)
        count += 1
        pdepth = 0
      }
      c = sx_index(line, a)
      when was_in_parens == 0 && is_word(c) == 1 {
        w = ""
        q = a
        while q < n {
          c = sx_index(line, q)
          when is_ident(c) == 1 {
            w = w + chr(c)
            q += 1
          } otherwise {
            break
          }
        }
        expected = known_word(w)
        rest = q
        while rest < n {
          c = sx_index(line, rest)
          when c == 32 || c == 9 {
            rest += 1
          } otherwise {
            break
          }
        }
        is_assign = 0
        is_call = 0
        when rest < n {
          c = sx_index(line, rest)
          when c == 61 {
            is_assign = 1
          }
          when c == 46 || c == 91 {
            is_assign = 1
          }
          when c == 40 {
            is_call = 1
          }
        }
        when expected == 0 && is_assign == 0 && is_call == 0 {
          when declared_in(text, w) == 0 {
            msg = concat("unknown statement '", w)
            msg = concat(msg, "'")
            items = items + diag_item(l, utf16_span(line, a), 1, "SX1001", msg, count)
            count += 1
          }
        }
        when string_eq(w, "use") {
          u = find_from(line, "\"", q)
          when u >= 0 {
            v = find_from(line, "\"", u + 1)
            when v < 0 {
              items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1005", "unterminated use path", count)
              count += 1
            } otherwise {
              path = ""
              z = u + 1
              while z < v {
                path = path + chr(sx_index(line, z))
                z += 1
              }
              full = path
              c = sx_index(path, 0)
              when c != 47 {
                full = concat(dir, path)
              }
              body = read_file(full)
              when len(body) <= 0 {
                msg = concat("cannot read module '", path)
                msg = concat(msg, "' (looked next to the document)")
                items = items + diag_item(l, utf16_span(line, u), 2, "SX1005", msg, count)
                count += 1
              }
            }
          }
        }
        when string_eq(w, "module") {
          u = find_from(line, "\"", q)
          when u >= 0 {
            v = find_from(line, "\"", u + 1)
            when v < 0 {
              items = items + diag_item(l, utf16_span(line, n - 1), 1, "SX1005", "unterminated module path", count)
              count += 1
            } otherwise {
              path = ""
              z = u + 1
              while z < v {
                path = path + chr(sx_index(line, z))
                z += 1
              }
              full = path
              c = sx_index(path, 0)
              when c != 47 {
                full = concat(dir, path)
              }
              body = read_file(full)
              when len(body) <= 0 && path_kind(path) != 1 {
                msg = concat("cannot read module '", path)
                msg = concat(msg, "' (looked next to the document)")
                items = items + diag_item(l, utf16_span(line, u), 2, "SX1005", msg, count)
                count += 1
              }
            }
          }
        }
      }
    }
    l += 1
  }
  when depth != 0 {
    l2 = lines - 1
    when l2 < 0 {
      l2 = 0
    }
    msg = "unbalanced braces: "
    when depth > 0 {
      msg = concat(msg, numstr(depth))
      msg = concat(msg, " block(s) never close")
    } otherwise {
      msg = concat(msg, "more '}' than '{'")
    }
    items = items + diag_item(l2, utf16_span(line_text(text, l2), 0), 1, "SX1003", msg, count)
    count += 1
  }
  when pdepth != 0 {
    items = items + diag_item(popen_line, utf16_span(line_text(text, popen_line), 0), 1, "SX1004", "unbalanced parentheses", count)
    count += 1
  }
  give concat("[", concat(items, "]"))
}

// ---------------------------------------------------------- documentSymbol

make sym_item(name: str, kind: num, line: num, uri: str, first: num) -> str {
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"name\":\""
  b = b + json_esc(name)
  b = b + "\",\"kind\":"
  b = b + numstr(kind)
  b = b + ",\"location\":{\"uri\":\""
  b = b + json_esc(uri)
  b = b + "\",\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":0},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":1}}}}"
  give b
}

// lower: ASCII lowercase, for the case-insensitive workspace/symbol filter.
make lower(s: str) -> str {
  hold r = ""
  hold i = 0
  hold n = 0
  hold c = 0
  n = len(s)
  while i < n {
    c = sx_index(s, i)
    when c >= 65 && c <= 90 {
      c = c + 32
    }
    r = r + chr(c)
    i += 1
  }
  give r
}

// sym_scan: the symbols of ONE document as a comma-joined list of
// DocumentSymbol items, each carrying its own leading comma except the very
// first, so a caller may concatenate the scans of several documents without
// knowing how many items each produced. `first` is the number of items the
// caller already has, which is all the comma rule needs. A non-empty `query`
// keeps only the symbols whose name contains it, case-insensitively: that is
// the workspace/symbol filter, and documentSymbol passes "" for "no filter".
make sym_scan(text: str, uri: str, query: str, first: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold kind = 0
  hold skip = 0
  hold w = ""
  hold q = 0
  hold c = 0
  lines = count_lines(text)
  while l < lines {
    line = line_text(text, l)
    n = len(line)
    i = 0
    while i < n {
      c = sx_index(line, i)
      when c == 32 || c == 9 {
        i += 1
      } otherwise {
        break
      }
    }
    kind = 0
    skip = 0
    when starts(line, i, "make ") == 1 {
      kind = 3
      skip = 5
    }
    when starts(line, i, "struct ") == 1 {
      kind = 5
      skip = 7
    }
    when starts(line, i, "hold ") == 1 {
      kind = 13
      skip = 5
    }
    when kind != 0 {
      w = ""
      q = i + skip
      while q < n {
        c = sx_index(line, q)
        when is_ident(c) == 1 {
          w = w + chr(c)
          q += 1
        } otherwise {
          break
        }
      }
      when len(w) > 0 {
        when len(query) <= 0 {
          arr = arr + sym_item(w, kind, l, uri, count)
          count += 1
        } otherwise {
          when find(lower(w), lower(query)) >= 0 {
            arr = arr + sym_item(w, kind, l, uri, count)
            count += 1
          }
        }
      }
    }
    l += 1
  }
  give arr
}

make symbols(text: str, uri: str) -> str {
  give concat("[", concat(sym_scan(text, uri, "", 0), "]"))
}

// ------------------------------------------------- rename / signature help

// rename_edits: every whole-word occurrence of `w` in ONE document as
// TextEdit items (same scan and comma rule as refs_for, declaration
// included), each replacing the word with `newtext`. "" when none.
// Lines outside [lo, hi] are left alone, and a word inside a string literal or
// after // is not an occurrence -- the same two rules refs_for applies, so a
// rename and a reference search always agree (hi < 0 = the whole document).
make rename_edits(w: str, newtext: str, text: str, first: num, lo: num, hi: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold j = 0
  hold c = 0
  hold run = ""
  hold quote = 0
  hold skip = 0
  hold span = [0, 0]
  hold espan = [0, 0]
  hold b = ""
  when len(w) > 0 && len(newtext) > 0 {
    lines = count_lines(text)
    while l < lines {
      line = line_text(text, l)
      n = len(line)
      skip = 0
      when l < lo {
        skip = 1
      }
      when hi >= 0 && l > hi {
        skip = 1
      }
      i = 0
      quote = 0
      while i < n && skip == 0 {
        c = sx_index(line, i)
        when quote == 1 {
          when c == 92 && i + 1 < n {
            i += 1
          } otherwise {
            when c == 34 {
              quote = 0
            }
          }
          i += 1
        } otherwise {
          when c == 34 {
            quote = 1
            i += 1
          } otherwise {
            when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
              i = n
            } otherwise {
              when is_ident(c) == 1 {
                run = ""
                j = i
                while j < n {
                  c = sx_index(line, j)
                  when is_ident(c) == 1 {
                    run = run + chr(c)
                    j += 1
                  } otherwise {
                    break
                  }
                }
                when string_eq(run, w) == 1 {
                  span = utf16_span(line, i)
                  espan = utf16_span(line, i + len(w))
                  b = ""
                  when count > 0 {
                    b = b + ","
                  }
                  b = b + "{\"range\":{\"start\":{\"line\":"
                  b = b + numstr(l)
                  b = b + ",\"character\":"
                  b = b + numstr(span[0])
                  b = b + "},\"end\":{\"line\":"
                  b = b + numstr(l)
                  b = b + ",\"character\":"
                  b = b + numstr(espan[0])
                  b = b + "}},\"newText\":\""
                  b = b + json_esc(newtext)
                  b = b + "\"}"
                  arr = arr + b
                  count += 1
                }
                i = j
              } otherwise {
                i += 1
              }
            }
          }
        }
      }
      l += 1
    }
  }
  give arr
}

// trim_str: strip spaces and tabs at both ends.
make trim_str(s: str) -> str {
  hold a = 0
  hold z = len(s)
  hold run = 1
  while run == 1 {
    when a >= z {
      hold run = 0
    } otherwise {
      hold c = sx_index(s, a)
      when c == 32 || c == 9 {
        hold a = a + 1
      } otherwise {
        hold run = 0
      }
    }
  }
  hold run = 1
  while run == 1 {
    when z <= a {
      hold run = 0
    } otherwise {
      hold c = sx_index(s, z - 1)
      when c == 32 || c == 9 {
        hold z = z - 1
      } otherwise {
        hold run = 0
      }
    }
  }
  hold out = ""
  hold i = a
  while i < z {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// sub_str: bytes [a, z) of s, clamped.
make sub_str(s: str, a: num, z: num) -> str {
  hold out = ""
  hold i = a
  when i < 0 {
    hold i = 0
  }
  hold e = z
  when e > len(s) {
    hold e = len(s)
  }
  while i < e {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// ------------------------------------------------------- incremental edits

// A UTF-16 (line, character) protocol position as a byte offset. A character
// count past the end of its line clamps to the line end, and a line past the
// last line clamps to EOF: the same clamping hover/definition already use.
make pos_byte(text: str, line: num, character: num) -> num {
  hold a = line_start(text, line)
  hold b = line_end(text, line)
  hold col = utf16_byte(sub_str(text, a, b), character)
  give a + col
}

// p clamped into [low, len(text)].
make pos_clamp(text: str, low: num, p: num) -> num {
  when p < low {
    give low
  }
  when p > len(text) {
    give len(text)
  }
  give p
}

// Replace [start, stop) with ins. Both ends clamp into the buffer and a
// reversed range becomes an insertion at its start, so a malformed edit can
// never move text outside the document.
make splice(text: str, start: num, stop: num, ins: str) -> str {
  hold a = pos_clamp(text, 0, start)
  hold b = pos_clamp(text, a, stop)
  give concat(sub_str(text, 0, a), concat(ins, sub_str(text, b, len(text))))
}

// The end position of the change object whose `"range"` starts at from. A
// missing end re-uses start, which makes the edit a pure insertion.
make range_end_line(msg: str, from: num, def: num) -> num {
  hold p = find_from(msg, "\"end\"", from)
  when p < 0 {
    give def
  }
  give num_field_from(msg, "line", p, def)
}

make range_end_char(msg: str, from: num, def: num) -> num {
  hold p = find_from(msg, "\"end\"", from)
  when p < 0 {
    give def
  }
  give num_field_from(msg, "character", p, def)
}

// sig_help: signature help for the call at (line, ch) of THIS document.
// The callee is the word under the cursor, or -- when the cursor sits in an
// argument list -- the identifier of the innermost enclosing call on that
// line. The declaration is the `make NAME(...)` line in the same document;
// there is no cross-file lookup. Parameters are the comma-separated pieces
// of the declaration's parameter list, and activeParameter counts the
// top-level commas of the call between its '(' and the cursor. "null" when
// no declaration is found, which the protocol allows.
make sig_help(w: str, text: str, line: num, ch: num) -> str {
  hold lt = line_text(text, line)
  hold bytepos = utf16_byte(lt, ch)
  hold callee = w
  hold callopen = 0 - 1
  hold depth = 0
  hold i = 0
  hold best = ""
  hold bestopen = 0 - 1
  hold cur = ""
  hold c = 0
  hold active = 0
  hold d2 = 0
  hold Decl = ""
  hold lines = 0
  hold l = 0
  hold pat = ""
  hold dl = ""
  hold m = 0
  hold after = 0
  hold po = 0
  hold pc = 0
  hold params = ""
  hold npar = 0
  hold inner = ""
  hold start = 0
  hold at_end = 0
  hold piece = ""
  hold b = ""
  // the innermost enclosing call on this line, if any
  while i < bytepos && i < len(lt) {
    hold c = sx_index(lt, i)
    when is_ident(c) == 1 {
      cur = concat(cur, chr(c))
    } otherwise {
      when c == 40 {
        when len(cur) > 0 {
          best = cur
          bestopen = i
        }
        depth = depth + 1
        cur = ""
      } otherwise {
        when c == 41 {
          depth = depth - 1
          cur = ""
        } otherwise {
          cur = ""
        }
      }
    }
    i = i + 1
  }
  when depth > 0 && len(best) > 0 {
    callee = best
    callopen = bestopen
  }
  // activeParameter: top-level commas between the call's '(' and the cursor
  when callopen >= 0 {
    d2 = 1
    i = callopen + 1
    while i < bytepos && i < len(lt) {
      hold c = sx_index(lt, i)
      when c == 40 || c == 91 {
        d2 = d2 + 1
      }
      when c == 41 || c == 93 {
        d2 = d2 - 1
      }
      when c == 44 && d2 == 1 {
        active = active + 1
      }
      i = i + 1
    }
  }
  // find the declaration line in this document
  lines = count_lines(text)
  pat = concat("make ", callee)
  while l < lines {
    dl = line_text(text, l)
    m = 0
    while m < len(dl) {
      when sx_index(dl, m) == 32 || sx_index(dl, m) == 9 {
        m = m + 1
      } otherwise {
        break
      }
    }
    when len(Decl) <= 0 && starts(dl, m, pat) == 1 {
      // the name must be followed by '(' so make helper2 is not helper
      after = m + len(pat)
      when after < len(dl) {
        when sx_index(dl, after) == 40 {
          Decl = trim_str(dl)
        }
      }
    }
    l = l + 1
  }
  when len(Decl) <= 0 {
    give "null"
  }
  // parameter labels: the comma-separated pieces inside the first ( ... )
  po = find(Decl, "(")
  pc = find_from(Decl, ")", po)
  when po >= 0 && pc > po {
    inner = sub_str(Decl, po + 1, pc)
    start = 0
    i = 0
    while i <= len(inner) {
      at_end = 0
      when i == len(inner) {
        at_end = 1
      } otherwise {
        when sx_index(inner, i) == 44 {
          at_end = 1
        }
      }
      when at_end == 1 {
        piece = trim_str(sub_str(inner, start, i))
        when len(piece) > 0 {
          when npar > 0 {
            params = concat(params, ",")
          }
          params = concat(params, "{\"label\":\"")
          params = concat(params, json_esc(piece))
          params = concat(params, "\"}")
          npar = npar + 1
        }
        start = i + 1
      }
      i = i + 1
    }
  }
  when active >= npar && npar > 0 {
    active = npar - 1
  }
  b = "{\"signatures\":[{\"label\":\""
  b = concat(b, json_esc(Decl))
  b = concat(b, "\",\"parameters\":[")
  b = concat(b, params)
  b = concat(b, "]],\"activeSignature\":0,\"activeParameter\":")
  b = concat(b, numstr(active))
  b = concat(b, "}")
  give b
}


// ------------------------------------------------------------- references

make ref_item(uri: str, line: num, ch: num, endch: num, first: num) -> str {
  hold b = ""
  when first > 0 {
    b = b + ","
  }
  b = b + "{\"uri\":\""
  b = b + json_esc(uri)
  b = b + "\",\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(ch)
  b = b + "},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}}}"
  give b
}

// refs_for: every whole-word occurrence of `w` in one document, as Location
// items with the same comma rule as sym_scan. Positions are UTF-16 code units
// (utf16_span), so a non-ASCII line still reports the column a client expects.
// `incl` is the LSP context.includeDeclaration flag: when it is 0 the line that
// declares the word (`make w`, `hold w`, `struct w`) is skipped, which is what
// "find references, not the definition" means in an editor.
//
// Two restrictions make the answer a resolution rather than a text search:
//   * lines outside [lo, hi] are skipped, so a name that binds inside one
//     function body can be reported inside that body only (hi < 0 = no limit);
//   * a word inside a string literal or after // is not an occurrence, because
//     the compiler does not read it as the name either.
make refs_for(w: str, text: str, uri: str, incl: num, first: num, lo: num, hi: num) -> str {
  hold arr = ""
  hold count = first
  hold lines = 0
  hold l = 0
  hold line = ""
  hold n = 0
  hold i = 0
  hold j = 0
  hold m = 0
  hold c = 0
  hold run = ""
  hold decl = 0
  hold quote = 0
  hold span = [0, 0]
  hold espan = [0, 0]
  when len(w) > 0 {
    lines = count_lines(text)
    while l < lines {
      line = line_text(text, l)
      n = len(line)
      decl = 0
      when l < lo {
        decl = 1
      }
      when hi >= 0 && l > hi {
        decl = 1
      }
      when incl == 0 {
        m = 0
        while m < n {
          c = sx_index(line, m)
          when c == 32 || c == 9 {
            m += 1
          } otherwise {
            break
          }
        }
        when starts(line, m, concat("make ", w)) == 1 {
          decl = 1
        }
        when starts(line, m, concat("hold ", w)) == 1 {
          decl = 1
        }
        when starts(line, m, concat("struct ", w)) == 1 {
          decl = 1
        }
      }
      when decl == 0 {
        i = 0
        quote = 0
        while i < n {
          c = sx_index(line, i)
          when quote == 1 {
            when c == 92 && i + 1 < n {
              i += 1
            } otherwise {
              when c == 34 {
                quote = 0
              }
            }
            i += 1
          } otherwise {
            when c == 34 {
              quote = 1
              i += 1
            } otherwise {
              when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
                i = n
              } otherwise {
                when is_ident(c) == 1 {
                  run = ""
                  j = i
                  while j < n {
                    c = sx_index(line, j)
                    when is_ident(c) == 1 {
                      run = run + chr(c)
                      j += 1
                    } otherwise {
                      break
                    }
                  }
                  when string_eq(run, w) == 1 {
                    // the start of the word and the offset just past its last
                    // byte, each as UTF-16 units, so the range covers the word
                    span = utf16_span(line, i)
                    espan = utf16_span(line, i + len(w))
                    arr = arr + ref_item(uri, l, span[0], espan[0], count)
                    count += 1
                  }
                  i = j
                } otherwise {
                  i += 1
                }
              }
            }
          }
        }
      }
      l += 1
    }
  }
  give arr
}

// ---------------------------------------------------------------- formatting

// format_text: the rules of tools/sxfmt.sa, ported so a client can ask for
// them over the protocol instead of running the formatter as a program.
// Indentation is rebuilt from brace depth at two spaces per level, leading and
// trailing whitespace is stripped, blank lines stay blank, a final newline is
// added, and braces inside a quoted string or a // comment do not change the
// depth. Tokens and comments are never rewritten: the formatter stays
// conservative, and running it twice gives the same text.
make format_text(text: str) -> str {
  hold src = text
  hold n = 0
  hold pos = 0
  hold c = 0
  hold depth = 0
  hold result = ""
  hold line = ""
  hold left = 0
  hold right = 0
  hold t = 0
  hold body = ""
  hold copy_pos = 0
  hold close_prefix = 0
  hold lead_pos = 0
  hold lead_scan = 0
  hold open_count = 0
  hold close_count = 0
  hold in_quote = 0
  hold escaped = 0
  hold in_comment = 0
  hold scan_pos = 0
  hold sc = 0
  hold line_depth = 0
  hold indent = ""
  hold indent_pos = 0
  n = len(src)
  when n > 0 {
    when sx_index(src, n - 1) != 10 {
      src = src + "\n"
      n = len(src)
    }
  }
  while pos < n {
    c = sx_index(src, pos)
    when c == 10 {
      left = 0
      right = len(line)
      while left < right {
        t = sx_index(line, left)
        when t == 32 || t == 9 || t == 13 {
          left += 1
        } otherwise {
          break
        }
      }
      while right > left {
        t = sx_index(line, right - 1)
        when t == 32 || t == 9 || t == 13 {
          right -= 1
        } otherwise {
          break
        }
      }
      body = ""
      copy_pos = left
      while copy_pos < right {
        body = body + chr(sx_index(line, copy_pos))
        copy_pos += 1
      }
      // a line that starts with closing braces is indented at the depth those
      // braces return to
      close_prefix = 0
      lead_pos = 0
      lead_scan = 1
      while lead_scan == 1 {
        when lead_pos < len(body) {
          t = sx_index(body, lead_pos)
          when t == 125 {
            close_prefix += 1
            lead_pos += 1
          } otherwise {
            when t == 32 || t == 9 {
              lead_pos += 1
            } otherwise {
              lead_scan = 0
            }
          }
        } otherwise {
          lead_scan = 0
        }
      }
      // count braces, ignoring quoted strings and // comments
      open_count = 0
      close_count = 0
      in_quote = 0
      escaped = 0
      in_comment = 0
      scan_pos = 0
      while scan_pos < len(line) {
        sc = sx_index(line, scan_pos)
        when in_comment == 1 {
          scan_pos += 1
        } otherwise {
          when in_quote == 1 {
            when escaped == 1 {
              escaped = 0
            } otherwise {
              when sc == 92 {
                escaped = 1
              } otherwise {
                when sc == 34 {
                  in_quote = 0
                }
              }
            }
          } otherwise {
            when sc == 34 {
              in_quote = 1
            } otherwise {
              when sc == 47 && scan_pos + 1 < len(line) {
                when sx_index(line, scan_pos + 1) == 47 {
                  in_comment = 1
                }
              } otherwise {
                when sc == 123 {
                  open_count += 1
                }
                when sc == 125 {
                  close_count += 1
                }
              }
            }
          }
          scan_pos += 1
        }
      }
      when len(body) > 0 {
        line_depth = depth - close_prefix
        when line_depth < 0 {
          line_depth = 0
        }
        indent = ""
        indent_pos = 0
        while indent_pos < line_depth {
          indent = indent + "  "
          indent_pos += 1
        }
        result = result + indent
        result = result + body
      }
      result = result + "\n"
      depth = depth + open_count - close_count
      when depth < 0 {
        depth = 0
      }
      line = ""
    } otherwise {
      line = line + chr(c)
    }
    pos += 1
  }
  give result
}

// format_edit: one TextEdit replacing the whole buffer, or [] when the
// document is already formatted so the client leaves the buffer alone. The end
// of the range is the end of the document: one past the last newline when the
// text ends with one, else the UTF-16 width of the last line.
make format_edit(text: str) -> str {
  hold out = ""
  hold lines = 0
  hold endline = 0
  hold endch = 0
  hold lastline = ""
  hold span = [0, 0]
  hold b = ""
  out = format_text(text)
  when string_eq(out, text) == 1 {
    give "[]"
  }
  lines = count_lines(text)
  endline = lines
  endch = 0
  when len(text) > 0 {
    when sx_index(text, len(text) - 1) != 10 {
      endline = lines - 1
      lastline = line_text(text, endline)
      span = utf16_span(lastline, len(lastline))
      endch = span[0]
    }
  }
  b = "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":"
  b = b + numstr(endline)
  b = b + ",\"character\":"
  b = b + numstr(endch)
  b = b + "}},\"newText\":\""
  b = b + json_esc(out)
  b = b + "\"}]"
  give b
}

// code_actions: the one action this server can truthfully offer -- format
// the document -- and only when formatting would change it. The edit is the
// same whole-buffer edit textDocument/formatting answers.
make code_actions(text: str, uri: str) -> str {
  hold fe = format_edit(text)
  hold b = "[]"
  when string_eq(fe, "[]") == 0 {
    hold b = "[{\"title\":\"Format this Sayanox document\",\"kind\":\"source.formatDocument\",\"edit\":{\"changes\":{\""
    hold b = concat(b, json_esc(uri))
    hold b = concat(b, "\":")
    hold b = concat(b, fe)
    hold b = concat(b, "}}}]")
  }
  give b
}

// ------------------------------------------------------------- completion

make completion_items() -> str {
  hold words = ""
  hold arr = ""
  hold count = 0
  hold n = 0
  hold i = 0
  hold c = 0
  hold d = 0
  hold w = ""
  hold item = ""
  words = "hold show when otherwise else elif while for break continue make give struct use true false and or not push concat len chr sx_index string_eq read_file write_file arg arg_count read_line read_n write_out flush_out numstr gc gc_live gc_runs"
  n = len(words)
  while i < n {
    c = sx_index(words, i)
    when is_ident(c) == 1 {
      w = ""
      while i < n {
        d = sx_index(words, i)
        when is_ident(d) == 1 {
          w = w + chr(d)
          i += 1
        } otherwise {
          break
        }
      }
      item = ""
      when count > 0 {
        item = ","
      }
      item = item + "{\"label\":\""
      item = item + w
      item = item + "\",\"kind\":14,\"detail\":\"standard\"}"
      arr = arr + item
      count += 1
    } otherwise {
      i += 1
    }
  }
  give concat("[", concat(arr, "]"))
}

// --------------------------------------------------------- hover / definition

make hover_for(w: str, text: str) -> str {
  hold d = ""
  hold md = ""
  hold pat = ""
  hold lines = 0
  hold l = 0
  hold line = ""
  hold found = 0
  hold b = ""
  hold hd = ""
  d = doc_for(w)
  when len(w) <= 0 {
    md = "**Sayanox** — hold / show / when / while / make / give / struct, lists, and the standard builtins."
  } otherwise {
    when len(d) > 0 {
      md = d
    } otherwise {
      pat = concat("make ", w)
      lines = count_lines(text)
      while l < lines {
        line = line_text(text, l)
        when found == 0 {
          when starts(line, 0, pat) == 1 {
            md = concat("`", line)
            md = concat(md, "`")
            found = 1
          }
        }
        l += 1
      }
      when found == 0 {
        hd = concat("hold ", w)
        when find(text, hd) >= 0 {
          md = concat("`", w)
          md = concat(md, "` — a variable in this document.")
        } otherwise {
          md = concat("`", w)
          md = concat(md, "` — no declaration in this document.")
        }
      }
    }
  }
  b = "{\"contents\":{\"kind\":\"markdown\",\"value\":\""
  b = b + json_esc(md)
  b = b + "\"}}"
  give b
}

make definition_for(w: str, text: str, uri: str) -> str {
  hold res = "null"
  hold lines = 0
  hold l = 0
  hold found = 0
  hold line = ""
  hold m = 0
  hold mk = ""
  hold hd = ""
  hold sd = ""
  hold b = ""
  when len(w) > 0 {
    lines = count_lines(text)
    while l < lines {
      when found == 0 {
        line = line_text(text, l)
        m = 0
        while m < len(line) {
          when sx_index(line, m) == 32 || sx_index(line, m) == 9 {
            m += 1
          } otherwise {
            break
          }
        }
        mk = concat("make ", w)
        hd = concat("hold ", w)
        sd = concat("struct ", w)
        when starts(line, m, mk) == 1 {
          found = 1
        }
        when starts(line, m, hd) == 1 {
          found = 1
        }
        when starts(line, m, sd) == 1 {
          found = 1
        }
        when found == 1 {
          b = "{\"uri\":\""
          b = b + json_esc(uri)
          b = b + "\",\"range\":{\"start\":{\"line\":"
          b = b + numstr(l)
          b = b + ",\"character\":0},\"end\":{\"line\":"
          b = b + numstr(l)
          b = b + ",\"character\":1}}"
          res = b
        }
      }
      l += 1
    }
  }
  give res
}

// --------------------------------------------------- semantic resolution
// Everything above answers by text: "the identifier that looks like this one".
// A name in this language binds in one of two places. `make`, `struct` and a
// `hold` written outside every body bind at the top level and are visible in
// every file of the folder. A parameter, or a `hold` inside a function body,
// binds in that body only -- a second function may use the same name for
// something else, and the compiler never confuses the two.
//
// These helpers find the binder of the word under the cursor, so definition,
// references and rename can answer about the declaration the cursor really
// means. Without them, renaming the `i` of one loop rewrites every `i` in the
// workspace, which is the difference between a text editor and an IDE.

// brace_delta: '{' minus '}' on one line, not counting braces inside a string
// literal or after //. The same reading of a line the formatter uses.
make brace_delta(line: str) -> num {
  hold n = len(line)
  hold i = 0
  hold d = 0
  hold quote = 0
  hold c = 0
  while i < n {
    c = sx_index(line, i)
    when quote == 1 {
      when c == 92 && i + 1 < n {
        i += 1
      } otherwise {
        when c == 34 {
          quote = 0
        }
      }
    } otherwise {
      when c == 34 {
        quote = 1
      } otherwise {
        when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
          i = n
        } otherwise {
          when c == 123 {
            d += 1
          }
          when c == 125 {
            d -= 1
          }
        }
      }
    }
    i += 1
  }
  give d
}

// fn_open_line: the line of the `make` whose body contains line `at`, or -1
// when `at` is at the top level of the document (including inside a top-level
// `when`/`while` block, where names are still global).
make fn_open_line(text: str, at: num) -> num {
  hold lines = count_lines(text)
  hold l = 0
  hold depth = 0
  hold cur = 0 - 1
  hold line = ""
  hold t = ""
  while l < lines && l <= at {
    line = line_text(text, l)
    when depth <= 0 {
      t = trim_str(line)
      cur = 0 - 1
      when starts(t, 0, "make ") == 1 {
        cur = l
      }
    }
    depth = depth + brace_delta(line)
    when depth < 0 {
      depth = 0
    }
    l += 1
  }
  when depth <= 0 {
    give 0 - 1
  }
  give cur
}

// fn_close_line: the line that closes the body opened on line `start`.
make fn_close_line(text: str, start: num) -> num {
  hold lines = count_lines(text)
  hold l = start
  hold depth = 0
  hold seen = 0
  while l < lines {
    depth = depth + brace_delta(line_text(text, l))
    when depth > 0 {
      seen = 1
    }
    when seen == 1 && depth <= 0 {
      give l
    }
    l += 1
  }
  give lines - 1
}

// sig_param: 1 when a `make` line declares a parameter named `w`. A parameter
// name is the identifier that opens a parameter, so the `num` of `v: num` and
// the `str` of a return type are not names.
make sig_param(line: str, w: str) -> num {
  hold n = len(line)
  hold i = find(line, "(")
  hold c = 0
  hold run = ""
  hold j = 0
  hold hit = 0
  when i < 0 {
    give 0
  }
  i += 1
  while i < n && hit == 0 {
    c = sx_index(line, i)
    when c == 41 {
      i = n
    } otherwise {
      when c == 32 || c == 9 {
        i += 1
      } otherwise {
        run = ""
        j = i
        while j < n {
          c = sx_index(line, j)
          when is_ident(c) == 1 {
            run = run + chr(c)
            j += 1
          } otherwise {
            break
          }
        }
        when string_eq(run, w) == 1 {
          hit = 1
        }
        while j < n && sx_index(line, j) != 44 && sx_index(line, j) != 41 {
          j += 1
        }
        when j < n && sx_index(line, j) == 44 {
          j += 1
        }
        when j > i {
          i = j
        } otherwise {
          i += 1
        }
      }
    }
  }
  give hit
}

// word_bound: 1 when the byte that follows a declaration keyword plus `w`
// inside `t` is not another identifier byte, so `hold xs` does not answer for
// the word `x`.
make word_bound(t: str, at: num) -> num {
  when at >= len(t) {
    give 1
  }
  when is_ident(sx_index(t, at)) == 1 {
    give 0
  }
  give 1
}

// local_decl_line: the line inside [start, stop] that binds `w` as a local --
// the `make` line itself when `w` is one of its parameters, else the first
// `hold w` or `for w in` in the body. -1 when the body does not bind the name,
// which means the name comes from the top level and is global.
make local_decl_line(text: str, start: num, stop: num, w: str) -> num {
  hold l = 0
  hold t = ""
  hold hd = ""
  hold fr = ""
  when len(w) <= 0 {
    give 0 - 1
  }
  when start < 0 {
    give 0 - 1
  }
  when sig_param(line_text(text, start), w) == 1 {
    give start
  }
  hd = concat("hold ", w)
  fr = concat("for ", w)
  l = start + 1
  while l <= stop {
    t = trim_str(line_text(text, l))
    when starts(t, 0, hd) == 1 && word_bound(t, len(hd)) == 1 {
      give l
    }
    when starts(t, 0, fr) == 1 && word_bound(t, len(fr)) == 1 {
      give l
    }
    l += 1
  }
  give 0 - 1
}

// top_decl_line: the first line that declares `w` at the top level of the
// document -- `make w`, `struct w` or a `hold w` written outside every body.
// -1 when the document has no top-level declaration of the name. This is the
// second half of the resolution: a global is the binder for every use that no
// function body binds, and a `hold` that happens to sit inside an earlier
// function is NOT that binder, which is the mistake a plain text search makes.
make top_decl_line(text: str, w: str) -> num {
  hold lines = count_lines(text)
  hold l = 0
  hold depth = 0
  hold line = ""
  hold t = ""
  hold mk = ""
  hold hd = ""
  hold sd = ""
  when len(w) <= 0 {
    give 0 - 1
  }
  mk = concat("make ", w)
  hd = concat("hold ", w)
  sd = concat("struct ", w)
  while l < lines {
    line = line_text(text, l)
    when depth <= 0 {
      t = trim_str(line)
      when starts(t, 0, mk) == 1 && word_bound(t, len(mk)) == 1 {
        give l
      }
      when starts(t, 0, hd) == 1 && word_bound(t, len(hd)) == 1 {
        give l
      }
      when starts(t, 0, sd) == 1 && word_bound(t, len(sd)) == 1 {
        give l
      }
    }
    depth = depth + brace_delta(line)
    when depth < 0 {
      depth = 0
    }
    l += 1
  }
  give 0 - 1
}

// loc_line: a Location covering the first character of one line, the shape
// definition_for answers with.
make loc_line(uri: str, line: num) -> str {
  hold b = "{\"uri\":\""
  b = b + json_esc(uri)
  b = b + "\",\"range\":{\"start\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":0},\"end\":{\"line\":"
  b = b + numstr(line)
  b = b + ",\"character\":1}}"
  give b
}

// ------------------------------------------------------------- transport

make emit(s: str) -> num {
  hold r = 0
  r = write_out(s)
  give r
}

make send(body: str) -> num {
  hold r = 0
  hold n = 0
  n = len(body)
  r = write_out("Content-Length: ")
  r = write_out(numstr(n))
  r = write_out("\r\n\r\n")
  r = write_out(body)
  r = flush_out()
  give r
}

// id_raw: the JSON text of the request id, exactly as sent: a number ("7",
// "-3"), a string with its quotes and escapes ("\"abc\""), or null.  Empty
// when the body has no id, which makes it a notification.  The raw text is
// echoed back unchanged, so a string id keeps its type in the reply.
make id_raw(msg: str) -> str {
  hold k = ""
  hold p = 0
  hold n = 0
  hold c = 0
  hold run = 1
  hold out = ""
  k = "\"id\""
  p = find(msg, k)
  when p < 0 {
    give ""
  }
  p = find_from(msg, ":", p + len(k))
  when p < 0 {
    give ""
  }
  p += 1
  n = len(msg)
  while p < n {
    c = sx_index(msg, p)
    when c == 32 || c == 9 {
      p += 1
    } otherwise {
      break
    }
  }
  when p >= n {
    give ""
  }
  c = sx_index(msg, p)
  when c == 34 {
    out = "\""
    p += 1
    while run == 1 {
      when p >= n {
        run = 0
      } otherwise {
        c = sx_index(msg, p)
        when c == 92 {
          when p + 1 < n {
            out = out + chr(c)
            out = out + chr(sx_index(msg, p + 1))
            p += 2
          } otherwise {
            run = 0
          }
        } otherwise {
          out = out + chr(c)
          p += 1
          when c == 34 {
            run = 0
          }
        }
      }
    }
    give out
  }
  when starts(msg, p, "null") == 1 {
    give "null"
  }
  when c == 45 || (c >= 48 && c <= 57) {
    while run == 1 {
      when p >= n {
        run = 0
      } otherwise {
        c = sx_index(msg, p)
        when c == 45 || (c >= 48 && c <= 57) {
          out = out + chr(c)
          p += 1
        } otherwise {
          run = 0
        }
      }
    }
    give out
  }
  give ""
}

make reply(idraw: str, result: str) -> num {
  hold b = ""
  hold r = 0
  hold idt = idraw
  when len(idt) <= 0 {
    idt = "null"
  }
  b = concat("{\"jsonrpc\":\"2.0\",\"id\":", idt)
  b = concat(b, ",\"result\":")
  b = concat(b, result)
  b = concat(b, "}")
  r = send(b)
  give r
}

// reply_error: a JSON-RPC 2.0 error response.  An empty idraw means "no usable
// id" and is sent as null (the spec's answer for a body that cannot be parsed).
make reply_error(idraw: str, code: num, msg: str) -> num {
  hold b = ""
  hold r = 0
  hold idt = idraw
  when len(idt) <= 0 {
    idt = "null"
  }
  b = concat("{\"jsonrpc\":\"2.0\",\"id\":", idt)
  b = concat(b, ",\"error\":{\"code\":")
  b = concat(b, numstr(code))
  b = concat(b, ",\"message\":\"")
  b = concat(b, msg)
  b = concat(b, "\"}}")
  r = send(b)
  give r
}

// known_method: 1 when the server dispatches this method, else 0. Kept in
// step with the dispatch chain in main; an unknown *request* gets -32601.
make known_method(m: str) -> num {
  when string_eq(m, "initialize") {
    give 1
  }
  when string_eq(m, "initialized") {
    give 1
  }
  when string_eq(m, "shutdown") {
    give 1
  }
  when string_eq(m, "exit") {
    give 1
  }
  when string_eq(m, "textDocument/didOpen") {
    give 1
  }
  when string_eq(m, "textDocument/didChange") {
    give 1
  }
  when string_eq(m, "textDocument/didClose") {
    give 1
  }
  when string_eq(m, "textDocument/diagnostic") {
    give 1
  }
  when string_eq(m, "textDocument/documentSymbol") {
    give 1
  }
  when string_eq(m, "textDocument/completion") {
    give 1
  }
  when string_eq(m, "textDocument/hover") {
    give 1
  }
  when string_eq(m, "textDocument/definition") {
    give 1
  }
  when string_eq(m, "textDocument/references") {
    give 1
  }
  when string_eq(m, "textDocument/formatting") {
    give 1
  }
  when string_eq(m, "workspace/didChangeWatchedFiles") {
    give 1
  }
  when string_eq(m, "workspace/symbol") {
    give 1
  }
  when string_eq(m, "textDocument/rename") {
    give 1
  }
  when string_eq(m, "textDocument/prepareRename") {
    give 1
  }
  when string_eq(m, "textDocument/signatureHelp") {
    give 1
  }
  when string_eq(m, "textDocument/codeAction") {
    give 1
  }
  give 0
}

// first_char: the first non-whitespace byte of a body (-1 if none). A JSON-RPC
// body must be an object, so anything but '{' is a parse error.
make first_char(s: str) -> num {
  hold i = 0
  hold n = len(s)
  hold c = -1
  while i < n {
    hold c = sx_index(s, i)
    when c != 32 && c != 9 && c != 10 && c != 13 {
      give c
    }
    hold i = i + 1
  }
  give -1
}

make notify(method: str, params: str) -> num {
  hold b = ""
  hold r = 0
  b = concat("{\"jsonrpc\":\"2.0\",\"method\":\"", method)
  b = concat(b, "\",\"params\":")
  b = concat(b, params)
  b = concat(b, "}")
  r = send(b)
  give r
}

// request_out: a request from the server to the client. Only one is ever
// sent -- client/registerCapability for the file watcher -- and its id is a
// string the client echoes back; the answer is a response (no method) and is
// ignored by the dispatch below, which is what the spec asks of a server that
// does not care whether the registration succeeded.
make request_out(id: str, method: str, params: str) -> num {
  hold b = ""
  hold r = 0
  b = concat("{\"jsonrpc\":\"2.0\",\"id\":\"", id)
  b = concat(b, "\",\"method\":\"")
  b = concat(b, method)
  b = concat(b, "\",\"params\":")
  b = concat(b, params)
  b = concat(b, "}")
  r = send(b)
  give r
}

// watch_registration: the params of client/registerCapability that ask the
// client to tell this server when a .sa file is created, changed or deleted
// anywhere in the folder. Registration is dynamic because that is the only
// way the protocol offers: there is no static watcher capability.
make watch_registration() -> str {
  hold p = "{\"registrations\":[{\"id\":\"sayanox-watch-sa\",\"method\":\"workspace/didChangeWatchedFiles\","
  p = p + "\"registerOptions\":{\"watchers\":[{\"globPattern\":\"**/*.sa\",\"kind\":7}]}}]}"
  give p
}

make capabilities_ext(prep_ren: num) -> str {
  hold c = ""
  c = "{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":2},\"completionProvider\":{\"triggerCharacters\":[\" \",\".\"]},"
  c = concat(c, "\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,")
  when prep_ren == 1 {
    c = concat(c, "\"referencesProvider\":true,\"documentFormattingProvider\":true,\"workspaceSymbolProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"codeActionProvider\":true,")
  } otherwise {
    c = concat(c, "\"referencesProvider\":true,\"documentFormattingProvider\":true,\"workspaceSymbolProvider\":true,\"renameProvider\":true,\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"codeActionProvider\":true,")
  }
  c = concat(c, "\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false}}")
  give c
}

make capabilities() -> str {
  give capabilities_ext(0)
}

make dir_of(uri: str) -> str {
  hold off = 0
  hold p = 0
  hold i = 0
  hold n = 0
  hold last = 0
  hold d = ""
  hold j = 0
  hold c = 0
  p = find(uri, "file://")
  when p >= 0 {
    off = p + 7
  }
  i = off
  n = len(uri)
  last = off
  while i < n {
    c = sx_index(uri, i)
    when c == 47 {
      last = i + 1
    }
    i += 1
  }
  j = off
  while j < last {
    d = d + chr(sx_index(uri, j))
    j += 1
  }
  give d
}

// --------------------------------------------------------------- main loop

// ------------------------------------------------------- workspace index
// The folder index is ordinary Sayanox: read_dir/path_kind/path_size/path_real
// (added to the compiler on 2026-10-17) provide the operating-system surface,
// and the walk, skip rules, percent-encoding and caps live here.
//
// The manifest is alternating lines: a percent-encoded file:// URI and the
// absolute path. It is capped at 128 files (256 lines) and 2 MB. The cap used
// to be applied while walking; it is applied to the finished listing now, so
// a huge tree is still bounded, just after the walk instead of during it.
make ws_prefix(t: str, p: str) -> num {
  hold r = 1
  when len(t) < len(p) { r = 0 }
  hold i = 0
  while i < len(p) && r == 1 {
    when sx_index(t, i) != sx_index(p, i) { r = 0 }
    i = i + 1
  }
  give r
}

make ws_hexval(c: num) -> num {
  hold r = 0 - 1
  when c >= 48 && c <= 57 { r = c - 48 }
  when c >= 97 && c <= 102 { r = c - 87 }
  when c >= 65 && c <= 70 { r = c - 55 }
  give r
}

// A local file URI becomes an absolute path; anything else becomes "".
// Rejections match the old C bridge: wrong scheme, malformed %XX, NUL,
// newline, carriage return and a result that is not absolute.
make ws_decode(uri: str) -> str {
  hold start = 0
  hold known = 0
  when ws_prefix(uri, "file://localhost/") == 1 {
    start = 16
    known = 1
  }
  when known == 0 && ws_prefix(uri, "file:///") == 1 {
    start = 7
    known = 1
  }
  when known == 0 {
    give ""
  }
  hold out = ""
  hold i = start
  hold n = len(uri)
  while i < n {
    hold c = sx_index(uri, i)
    when c == 37 {
      when i + 2 >= n {
        give ""
      }
      hold hi = ws_hexval(sx_index(uri, i + 1))
      hold lo = ws_hexval(sx_index(uri, i + 2))
      when hi < 0 || lo < 0 {
        give ""
      }
      c = hi * 16 + lo
      i = i + 2
    }
    when c == 0 || c == 10 || c == 13 {
      give ""
    }
    out = concat(out, chr(c))
    i = i + 1
  }
  when len(out) == 0 || sx_index(out, 0) != 47 {
    give ""
  }
  give out
}

make ws_hexdig(v: num) -> str {
  hold digits = "0123456789ABCDEF"
  give chr(sx_index(digits, v))
}

make ws_safe(c: num) -> num {
  hold r = 0
  when c >= 97 && c <= 122 { r = 1 }
  when c >= 65 && c <= 90 { r = 1 }
  when c >= 48 && c <= 57 { r = 1 }
  when c == 47 { r = 1 }
  when c == 45 { r = 1 }
  when c == 95 { r = 1 }
  when c == 46 { r = 1 }
  when c == 126 { r = 1 }
  give r
}

make ws_encode(path: str) -> str {
  hold out = ""
  hold i = 0
  while i < len(path) {
    hold c = sx_index(path, i)
    when ws_safe(c) == 1 {
      out = concat(out, chr(c))
    } otherwise {
      out = concat(out, "%")
      out = concat(out, ws_hexdig(c / 16))
      out = concat(out, ws_hexdig(c % 16))
    }
    i = i + 1
  }
  give out
}

make ws_skip(name: str) -> num {
  hold r = 0
  when len(name) > 0 && sx_index(name, 0) == 46 { r = 1 }
  when string_eq(name, "node_modules") { r = 1 }
  when string_eq(name, "build") { r = 1 }
  when string_eq(name, "dist") { r = 1 }
  when string_eq(name, "target") { r = 1 }
  when string_eq(name, "vendor") { r = 1 }
  give r
}

make ws_ends_sa(name: str) -> num {
  hold r = 0
  hold n = len(name)
  when n >= 3 && sx_index(name, n - 3) == 46 && sx_index(name, n - 2) == 115 && sx_index(name, n - 1) == 97 {
    r = 1
  }
  give r
}

// Depth 16, regular files only (lstat kind 1, so symlinks are not followed),
// .sa suffix, at most 256 KiB per file.
make ws_walk(dir: str, depth: num) -> str {
  hold out = ""
  when depth > 16 {
    give out
  }
  hold names = read_dir(dir)
  hold total = len(names)
  hold i = 0
  hold start = 0
  while i <= total {
    hold c = 0
    when i < total { c = sx_index(names, i) }
    when i == total || c == 10 {
      hold name = sub_str(names, start, i)
      when len(name) > 0 && ws_skip(name) == 0 {
        hold path = concat(concat(dir, "/"), name)
        hold kind = path_kind(path)
        when kind == 2 {
          out = concat(out, ws_walk(path, depth + 1))
        }
        when kind == 1 && ws_ends_sa(name) == 1 {
          hold size = path_size(path)
          when size <= 262144 {
            out = concat(out, "file://")
            out = concat(out, ws_encode(path))
            out = concat(out, "\n")
            out = concat(out, path)
            out = concat(out, "\n")
          }
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  give out
}

// The first `lines` lines, or everything when the text is shorter.
make ws_first(text: str, lines: num) -> str {
  hold i = 0
  hold seen = 0
  hold stop = len(text)
  hold done = 0
  while i < len(text) && done == 0 {
    when sx_index(text, i) == 10 {
      seen = seen + 1
      when seen >= lines {
        stop = i + 1
        done = 1
      }
    }
    i = i + 1
  }
  give sub_str(text, 0, stop)
}

// Byte offset just after the last newline, or -1 when there is none.
make ws_last_nl(text: str) -> num {
  hold i = len(text) - 1
  hold found = 0 - 1
  hold done = 0
  while i >= 0 && done == 0 {
    when sx_index(text, i) == 10 {
      found = i + 1
      done = 1
    }
    i = i - 1
  }
  give found
}

make workspace_manifest(root: str) -> str {
  hold decoded = ws_decode(root)
  when len(decoded) == 0 {
    give ""
  }
  hold canonical = path_real(decoded)
  when len(canonical) == 0 {
    give ""
  }
  when path_kind(canonical) != 2 {
    give ""
  }
  hold raw = ws_walk(canonical, 0)
  hold capped = ws_first(raw, 256)
  when len(capped) > 2097152 {
    hold cut = ws_last_nl(sub_str(capped, 0, 2097152))
    when cut < 0 {
      cut = 0
    }
    capped = sub_str(capped, 0, cut)
  }
  give capped
}

make workspace_text(manifest: str, uri: str) -> str {
  hold row = 0
  hold total = count_lines(manifest)
  while row + 1 < total {
    hold candidate = line_text(manifest, row)
    when string_eq(candidate, uri) {
      hold path = line_text(manifest, row + 1)
      give read_file(path)
    }
    row = row + 2
  }
  give ""
}

// Open buffers are scanned separately and override their on-disk copies.
make workspace_scan(manifest: str, word: str, query: str, mode: num, incl: num, first: num, open0: str, open1: str, open2: str, open3: str) -> str {
  hold out = ""
  hold row = 0
  hold total = count_lines(manifest)
  while row + 1 < total {
    hold candidate = line_text(manifest, row)
    hold path = line_text(manifest, row + 1)
    when string_eq(candidate, open0) == 0 && string_eq(candidate, open1) == 0 && string_eq(candidate, open2) == 0 && string_eq(candidate, open3) == 0 {
      hold source = read_file(path)
      hold part = ""
      when mode == 0 {
        part = sym_scan(source, candidate, query, first + len(out))
      } otherwise {
        part = refs_for(word, source, candidate, incl, first + len(out), 0, 0 - 1)
      }
      out = concat(out, part)
    }
    row = row + 2
  }
  give out
}

// workspace_rename: the `"uri":[edits]` entries of a WorkspaceEdit for every
// indexed file the client does not have open. `pre` is "," when an open
// document already contributed an entry, so the changes object stays valid
// JSON however the two halves combine. A file with no occurrence contributes
// nothing: clients show one entry per touched file, not per scanned file.
make workspace_rename(manifest: str, w: str, newtext: str, pre: str, open0: str, open1: str, open2: str, open3: str) -> str {
  hold out = ""
  hold sep = pre
  hold row = 0
  hold total = count_lines(manifest)
  hold candidate = ""
  hold path = ""
  hold source = ""
  hold part = ""
  while row + 1 < total {
    candidate = line_text(manifest, row)
    path = line_text(manifest, row + 1)
    when string_eq(candidate, open0) == 0 && string_eq(candidate, open1) == 0 && string_eq(candidate, open2) == 0 && string_eq(candidate, open3) == 0 {
      source = read_file(path)
      part = rename_edits(w, newtext, source, 0, 0, 0 - 1)
      when len(part) > 0 {
        out = out + sep
        out = out + "\""
        out = out + json_esc(candidate)
        out = out + "\":["
        out = out + part
        out = out + "]"
        sep = ","
      }
    }
    row = row + 2
  }
  give out
}

// watched_refresh: answer workspace/didChangeWatchedFiles. For every changed
// file the client is NOT editing, publish the diagnostics of the file as it
// now is on disk; a file that was deleted (type 3) or can no longer be read
// gets an empty list, which is how the protocol says to clear diagnostics.
// Files the client has open are skipped: the buffer, not the disk, is the
// truth for those, and didChange already republishes them.
// At most 32 changes are answered per notification, so a mass checkout cannot
// make the server write an unbounded burst of frames.
make watched_refresh(body: str, open0: str, open1: str, open2: str, open3: str) -> num {
  hold rest = body
  hold sent = 0
  hold at = 0
  hold u = ""
  hold kind = 0
  hold path = ""
  hold src = ""
  hold params = ""
  hold d = 0
  hold guard = 0
  while guard < 32 {
    at = find(rest, "\"uri\"")
    when at < 0 {
      guard = 32
    } otherwise {
      u = str_field(rest, "uri")
      kind = num_field(rest, "type", 2)
      rest = sub_str(rest, at + 5, len(rest))
      guard += 1
      when len(u) > 0 && string_eq(u, open0) == 0 && string_eq(u, open1) == 0 && string_eq(u, open2) == 0 && string_eq(u, open3) == 0 {
        src = ""
        when kind != 3 {
          path = ws_decode(u)
          when len(path) > 0 {
            src = read_file(path)
          }
        }
        params = concat("{\"uri\":\"", json_esc(u))
        params = concat(params, "\",\"diagnostics\":")
        when len(src) > 0 {
          params = concat(params, diagnostics(src, dir_of(u)))
        } otherwise {
          params = concat(params, "[]")
        }
        params = concat(params, "}")
        d = notify("textDocument/publishDiagnostics", params)
        sent += 1
      }
    }
  }
  give sent
}

// ------------------------------------ type-level hover & cross-file resolution

make strip_line_comment(s: str) -> str {
  hold n = len(s)
  hold i = 0
  hold qmode = 0
  while i < n {
    hold c = sx_index(s, i)
    when qmode == 1 {
      when c == 92 {
        i = i + 2
      } otherwise {
        when c == 34 {
          qmode = 0
        }
        i = i + 1
      }
    } otherwise {
      when c == 34 {
        qmode = 1
        i = i + 1
      } otherwise {
        when c == 47 && i + 1 < n {
          when sx_index(s, i + 1) == 47 {
            give trim_str(sub_str(s, 0, i))
          }
        }
        i = i + 1
      }
    }
  }
  give trim_str(s)
}

make basename_uri(u: str) -> str {
  hold n = len(u)
  hold i = 0
  hold last = 0
  while i < n {
    when sx_index(u, i) == 47 {
      last = i + 1
    }
    i = i + 1
  }
  give sub_str(u, last, n)
}

make parse_int_str(s: str) -> num {
  hold n = len(s)
  hold i = 0
  hold v = 0
  while i < n {
    hold c = sx_index(s, i)
    when c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  give v
}

make open_or_disk(u: str, p: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when len(u) > 0 {
    when string_eq(u, u0) == 1 {
      give t0
    }
    when string_eq(u, u1) == 1 {
      give t1
    }
    when string_eq(u, u2) == 1 {
      give t2
    }
    when string_eq(u, u3) == 1 {
      give t3
    }
  }
  when len(p) > 0 {
    give read_file(p)
  }
  give ""
}

make resolve_use_pair(rel_p: str, docuri: str) -> str {
  when len(rel_p) <= 0 {
    give ""
  }
  hold dec = ws_decode(docuri)
  hold base_dir = ""
  when len(dec) > 0 {
    base_dir = dir_of(concat("file://", dec))
  } otherwise {
    base_dir = dir_of(docuri)
  }
  hold full = rel_p
  when sx_index(rel_p, 0) != 47 {
    full = concat(base_dir, rel_p)
  }
  hold real_p = path_real(full)
  when len(real_p) > 0 {
    full = real_p
  }
  hold enc_u = concat("file://", ws_encode(full))
  give concat(enc_u, concat("\n", concat(full, "\n")))
}

// Parse one `module NAME [as ALIAS] from "path.sa"` line.
// part 0 -> mname, part 1 -> alias, part 2 -> rel_path ("" if not a valid module line).
make parse_module_import_part(raw_line: str, part: num) -> str {
  hold t = strip_line_comment(raw_line)
  when starts(t, 0, "module ") == 0 {
    give ""
  }
  hold rest = trim_str(sub_str(t, 7, len(t)))
  hold i = 0
  hold mname = ""
  while i < len(rest) && is_ident(sx_index(rest, i)) == 1 {
    mname = concat(mname, chr(sx_index(rest, i)))
    i = i + 1
  }
  when len(mname) <= 0 {
    give ""
  }
  rest = trim_str(sub_str(rest, len(mname), len(rest)))
  hold alias = mname
  when starts(rest, 0, "as ") == 1 {
    rest = trim_str(sub_str(rest, 3, len(rest)))
    alias = ""
    i = 0
    while i < len(rest) && is_ident(sx_index(rest, i)) == 1 {
      alias = concat(alias, chr(sx_index(rest, i)))
      i = i + 1
    }
    when len(alias) <= 0 {
      give ""
    }
    rest = trim_str(sub_str(rest, len(alias), len(rest)))
  }
  when starts(rest, 0, "from ") == 0 && starts(rest, 0, "from\"") == 0 {
    give ""
  }
  hold q1 = find(rest, "\"")
  when q1 < 0 {
    give ""
  }
  hold q2 = find_from(rest, "\"", q1 + 1)
  when q2 <= q1 + 1 {
    give ""
  }
  hold rel = sub_str(rest, q1 + 1, q2)
  when part == 0 {
    give mname
  }
  when part == 1 {
    give alias
  }
  give rel
}

make doc_module_manifest(doc: str, docuri: str) -> str {
  hold out = ""
  hold lines = count_lines(doc)
  hold l = 0
  while l < lines {
    hold rel = parse_module_import_part(line_text(doc, l), 2)
    when len(rel) > 0 {
      hold pair = resolve_use_pair(rel, docuri)
      out = concat(out, pair)
    }
    l = l + 1
  }
  give out
}

// Look up `alias` among `module NAME [as ALIAS] from "path.sa"` lines in `doc`.
// Returns: mname\ndecl_line\ntarget_uri\ntarget_path\nrel_path (or "" if not found).
make doc_module_lookup(doc: str, docuri: str, alias: str) -> str {
  when len(alias) <= 0 {
    give ""
  }
  hold lines = count_lines(doc)
  hold l = 0
  while l < lines {
    hold raw = line_text(doc, l)
    hold al = parse_module_import_part(raw, 1)
    when string_eq(al, alias) == 1 {
      hold mname = parse_module_import_part(raw, 0)
      hold rel = parse_module_import_part(raw, 2)
      hold pair = resolve_use_pair(rel, docuri)
      when len(pair) > 0 {
        hold tu = line_text(pair, 0)
        hold tp = line_text(pair, 1)
        give concat(mname, concat("\n", concat(numstr(l), concat("\n", concat(tu, concat("\n", concat(tp, concat("\n", rel))))))))
      }
    }
    l = l + 1
  }
  give ""
}

make module_uri_on_line(lt: str, docuri: str, u0: str, u1: str, u2: str, u3: str) -> str {
  hold rel = parse_module_import_part(lt, 2)
  when len(rel) <= 0 {
    give ""
  }
  hold pair = resolve_use_pair(rel, docuri)
  when len(pair) <= 0 {
    give ""
  }
  hold target_u = line_text(pair, 0)
  hold target_p = line_text(pair, 1)
  when string_eq(target_u, u0) == 1 || string_eq(target_u, u1) == 1 || string_eq(target_u, u2) == 1 || string_eq(target_u, u3) == 1 {
    give target_u
  }
  when path_kind(target_p) == 1 {
    give target_u
  }
  give ""
}

// Lexical block-scope local binder inside [fnl, fnend] visible at `at_ln`.
// Distinguishes inner `when`/`while`/`for` block `hold` shadowing from outer
// parameters/locals while ignoring sibling inner blocks that closed before `at_ln`.
make scoped_local_decl_line(text: str, fnl: num, fnend: num, at_ln: num, w: str) -> num {
  when len(w) <= 0 || fnl < 0 {
    give 0 - 1
  }
  hold b0 = 0 - 1
  when sig_param(line_text(text, fnl), w) == 1 {
    b0 = fnl
  }
  hold b1 = 0 - 1
  hold b2 = 0 - 1
  hold b3 = 0 - 1
  hold b4 = 0 - 1
  hold hd = concat("hold ", w)
  hold fr = concat("for ", w)
  hold d = brace_delta(line_text(text, fnl))
  when d < 1 {
    d = 1
  }
  hold stop = at_ln
  when stop > fnend {
    stop = fnend
  }
  hold l = fnl + 1
  while l <= stop {
    hold raw = line_text(text, l)
    hold t = trim_str(raw)
    hold is_bind = 0
    when starts(t, 0, hd) == 1 && word_bound(t, len(hd)) == 1 {
      is_bind = 1
    }
    when starts(t, 0, fr) == 1 && word_bound(t, len(fr)) == 1 {
      is_bind = 1
    }
    when is_bind == 1 {
      when d <= 1 {
        b1 = l
      }
      when d == 2 {
        b2 = l
      }
      when d == 3 {
        b3 = l
      }
      when d >= 4 {
        b4 = l
      }
    }
    when l < stop {
      hold nd = d + brace_delta(raw)
      when nd < 4 {
        b4 = 0 - 1
      }
      when nd < 3 {
        b3 = 0 - 1
      }
      when nd < 2 {
        b2 = 0 - 1
      }
      d = nd
    }
    l = l + 1
  }
  when b4 >= 0 {
    give b4
  }
  when b3 >= 0 {
    give b3
  }
  when b2 >= 0 {
    give b2
  }
  when b1 >= 0 {
    give b1
  }
  when b0 >= 0 {
    give b0
  }
  give local_decl_line(text, fnl, fnend, w)
}

make doc_use_manifest(doc: str, docuri: str) -> str {
  hold out = ""
  hold lines = count_lines(doc)
  hold l = 0
  while l < lines {
    hold t = trim_str(line_text(doc, l))
    when starts(t, 0, "use ") == 1 || starts(t, 0, "use\"") == 1 {
      hold q1 = find(t, "\"")
      when q1 >= 0 {
        hold q2 = find_from(t, "\"", q1 + 1)
        when q2 > q1 + 1 {
          hold rel = sub_str(t, q1 + 1, q2)
          hold pair = resolve_use_pair(rel, docuri)
          out = concat(out, pair)
        }
      }
    }
    l = l + 1
  }
  give out
}

make use_uri_on_line(lt: str, docuri: str, u0: str, u1: str, u2: str, u3: str) -> str {
  hold t = trim_str(lt)
  when starts(t, 0, "use ") == 0 && starts(t, 0, "use\"") == 0 {
    give ""
  }
  hold q1 = find(t, "\"")
  when q1 < 0 {
    give ""
  }
  hold q2 = find_from(t, "\"", q1 + 1)
  when q2 <= q1 + 1 {
    give ""
  }
  hold rel = sub_str(t, q1 + 1, q2)
  hold pair = resolve_use_pair(rel, docuri)
  when len(pair) <= 0 {
    give ""
  }
  hold target_u = line_text(pair, 0)
  hold target_p = line_text(pair, 1)
  when string_eq(target_u, u0) == 1 || string_eq(target_u, u1) == 1 || string_eq(target_u, u2) == 1 || string_eq(target_u, u3) == 1 {
    give target_u
  }
  when path_kind(target_p) == 1 {
    give target_u
  }
  give ""
}

// Search order: doc -> explicit use targets -> open buffers -> workspace index.
// Returns: uri\nline_num\ntrimmed_decl_line (or empty string if not found).
make ws_find_top_decl(w: str, doc: str, docuri: str, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when len(w) <= 0 {
    give ""
  }
  hold dl = top_decl_line(doc, w)
  when dl >= 0 {
    hold dtxt = strip_line_comment(line_text(doc, dl))
    give concat(docuri, concat("\n", concat(numstr(dl), concat("\n", dtxt))))
  }
  hold uses = doc_use_manifest(doc, docuri)
  hold urows = count_lines(uses)
  hold r = 0
  while r + 1 < urows {
    hold uu = line_text(uses, r)
    hold up = line_text(uses, r + 1)
    hold usrc = open_or_disk(uu, up, u0, t0, u1, t1, u2, t2, u3, t3)
    when len(usrc) > 0 {
      hold udl = top_decl_line(usrc, w)
      when udl >= 0 {
        hold udtxt = strip_line_comment(line_text(usrc, udl))
        give concat(uu, concat("\n", concat(numstr(udl), concat("\n", udtxt))))
      }
    }
    r = r + 2
  }
  when len(u0) > 0 && string_eq(u0, docuri) == 0 {
    hold dl0 = top_decl_line(t0, w)
    when dl0 >= 0 {
      give concat(u0, concat("\n", concat(numstr(dl0), concat("\n", strip_line_comment(line_text(t0, dl0))))))
    }
  }
  when len(u1) > 0 && string_eq(u1, docuri) == 0 {
    hold dl1 = top_decl_line(t1, w)
    when dl1 >= 0 {
      give concat(u1, concat("\n", concat(numstr(dl1), concat("\n", strip_line_comment(line_text(t1, dl1))))))
    }
  }
  when len(u2) > 0 && string_eq(u2, docuri) == 0 {
    hold dl2 = top_decl_line(t2, w)
    when dl2 >= 0 {
      give concat(u2, concat("\n", concat(numstr(dl2), concat("\n", strip_line_comment(line_text(t2, dl2))))))
    }
  }
  when len(u3) > 0 && string_eq(u3, docuri) == 0 {
    hold dl3 = top_decl_line(t3, w)
    when dl3 >= 0 {
      give concat(u3, concat("\n", concat(numstr(dl3), concat("\n", strip_line_comment(line_text(t3, dl3))))))
    }
  }
  hold mrows = count_lines(manifest)
  hold mr = 0
  while mr + 1 < mrows {
    hold mu = line_text(manifest, mr)
    hold mp = line_text(manifest, mr + 1)
    when string_eq(mu, u0) == 0 && string_eq(mu, u1) == 0 && string_eq(mu, u2) == 0 && string_eq(mu, u3) == 0 && string_eq(mu, docuri) == 0 {
      hold msrc = read_file(mp)
      hold mdl = top_decl_line(msrc, w)
      when mdl >= 0 {
        give concat(mu, concat("\n", concat(numstr(mdl), concat("\n", strip_line_comment(line_text(msrc, mdl))))))
      }
    }
    mr = mr + 2
  }
  give ""
}

make base_type_name(tname: str) -> str {
  hold lt = find(tname, "<")
  when lt > 0 {
    give trim_str(sub_str(tname, 0, lt))
  }
  give trim_str(tname)
}

make first_type_arg(tname: str) -> str {
  hold lt = find(tname, "<")
  hold gt = find(tname, ">")
  when lt > 0 && gt > lt + 1 {
    hold inside = sub_str(tname, lt + 1, gt)
    hold cm = find(inside, ",")
    when cm > 0 {
      give trim_str(sub_str(inside, 0, cm))
    }
    give trim_str(inside)
  }
  give ""
}

make source_for_uri(target_u: str, doc: str, docuri: str, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when string_eq(target_u, docuri) == 1 {
    give doc
  }
  when string_eq(target_u, u0) == 1 {
    give t0
  }
  when string_eq(target_u, u1) == 1 {
    give t1
  }
  when string_eq(target_u, u2) == 1 {
    give t2
  }
  when string_eq(target_u, u3) == 1 {
    give t3
  }
  hold uses = doc_use_manifest(doc, docuri)
  hold urows = count_lines(uses)
  hold r = 0
  while r + 1 < urows {
    when string_eq(line_text(uses, r), target_u) == 1 {
      give read_file(line_text(uses, r + 1))
    }
    r = r + 2
  }
  hold mods = doc_module_manifest(doc, docuri)
  hold mrows = count_lines(mods)
  hold mr = 0
  while mr + 1 < mrows {
    when string_eq(line_text(mods, mr), target_u) == 1 {
      give read_file(line_text(mods, mr + 1))
    }
    mr = mr + 2
  }
  give workspace_text(manifest, target_u)
}

make parse_struct_summary(src: str, sline: num) -> str {
  hold lines = count_lines(src)
  hold hdr = strip_line_comment(line_text(src, sline))
  hold bo = find(hdr, "{")
  hold head_nm = hdr
  when bo > 0 {
    head_nm = trim_str(sub_str(hdr, 0, bo))
  }
  hold fields = ""
  hold nf = 0
  hold l = sline + 1
  hold done = 0
  while l < lines && done == 0 {
    hold fl = strip_line_comment(line_text(src, l))
    when find(fl, "}") >= 0 {
      done = 1
    } otherwise {
      hold col = find(fl, ":")
      when col > 0 {
        hold fnm = trim_str(sub_str(fl, 0, col))
        hold fty = trim_str(sub_str(fl, col + 1, len(fl)))
        when sx_index(fty, len(fty) - 1) == 44 {
          fty = trim_str(sub_str(fty, 0, len(fty) - 1))
        }
        when nf > 0 {
          fields = concat(fields, ", ")
        }
        fields = concat(fields, concat(fnm, concat(": ", fty)))
        nf = nf + 1
      }
    }
    l = l + 1
  }
  give concat(head_nm, concat(" { ", concat(fields, " }")))
}

// Returns: field_uri\nfield_line\nfield_type (with single generic param substituted)
make ws_find_struct_field(stype: str, fname: str, doc: str, docuri: str, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  hold bname = base_type_name(stype)
  when len(bname) <= 0 || len(fname) <= 0 {
    give ""
  }
  hold hit = ""
  hold qdot = find(bname, ".")
  when qdot > 0 {
    hold mal = trim_str(sub_str(bname, 0, qdot))
    hold mstruct = trim_str(sub_str(bname, qdot + 1, len(bname)))
    hold mhit = doc_module_lookup(doc, docuri, mal)
    when len(mhit) > 0 {
      hold mu = line_text(mhit, 2)
      hold mp = line_text(mhit, 3)
      hold msrc0 = open_or_disk(mu, mp, u0, t0, u1, t1, u2, t2, u3, t3)
      hold msdl = top_decl_line(msrc0, mstruct)
      when msdl >= 0 {
        hit = concat(mu, concat("\n", concat(numstr(msdl), concat("\n", strip_line_comment(line_text(msrc0, msdl))))))
      }
    }
    bname = mstruct
  }
  when len(hit) <= 0 {
    hit = ws_find_top_decl(bname, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
  }
  when len(hit) <= 0 {
    give ""
  }
  hold su = line_text(hit, 0)
  hold sl = parse_int_str(line_text(hit, 1))
  hold shdr = line_text(hit, 2)
  when starts(shdr, 0, "struct ") == 0 {
    give ""
  }
  hold tparam = first_type_arg(shdr)
  hold targ = first_type_arg(stype)
  hold ssrc = source_for_uri(su, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
  // Support inline `struct Vec2 { x, y }` single-line declarations
  hold bo_inline = find(shdr, "{")
  hold bc_inline = find(shdr, "}")
  when bo_inline > 0 && bc_inline > bo_inline {
    hold in_body = sub_str(shdr, bo_inline + 1, bc_inline)
    hold ii = 0
    hold in_n = len(in_body)
    while ii < in_n {
      while ii < in_n && (sx_index(in_body, ii) == 32 || sx_index(in_body, ii) == 9 || sx_index(in_body, ii) == 44) {
        ii = ii + 1
      }
      hold fnm0 = ""
      while ii < in_n && is_ident(sx_index(in_body, ii)) == 1 {
        fnm0 = concat(fnm0, chr(sx_index(in_body, ii)))
        ii = ii + 1
      }
      hold fty0 = "any"
      while ii < in_n && (sx_index(in_body, ii) == 32 || sx_index(in_body, ii) == 9) {
        ii = ii + 1
      }
      when ii < in_n && sx_index(in_body, ii) == 58 {
        ii = ii + 1
        hold fts = ii
        while ii < in_n && sx_index(in_body, ii) != 44 {
          ii = ii + 1
        }
        fty0 = trim_str(sub_str(in_body, fts, ii))
      } otherwise {
        while ii < in_n && sx_index(in_body, ii) != 44 {
          ii = ii + 1
        }
      }
      when string_eq(fnm0, fname) == 1 {
        when len(tparam) > 0 && len(targ) > 0 && string_eq(fty0, tparam) == 1 {
          fty0 = targ
        }
        give concat(su, concat("\n", concat(numstr(sl), concat("\n", fty0))))
      }
    }
    give ""
  }
  hold lines = count_lines(ssrc)
  hold l = sl + 1
  while l < lines {
    hold fl = strip_line_comment(line_text(ssrc, l))
    when find(fl, "}") >= 0 {
      give ""
    }
    hold col = find(fl, ":")
    when col > 0 {
      hold fnm = trim_str(sub_str(fl, 0, col))
      when string_eq(fnm, fname) == 1 {
        hold fty = trim_str(sub_str(fl, col + 1, len(fl)))
        when len(fty) > 0 && sx_index(fty, len(fty) - 1) == 44 {
          fty = trim_str(sub_str(fty, 0, len(fty) - 1))
        }
        when len(tparam) > 0 && len(targ) > 0 && string_eq(fty, tparam) == 1 {
          fty = targ
        }
        give concat(su, concat("\n", concat(numstr(l), concat("\n", fty))))
      }
    } otherwise {
      hold fnm_u = trim_str(fl)
      when len(fnm_u) > 0 && sx_index(fnm_u, len(fnm_u) - 1) == 44 {
        fnm_u = trim_str(sub_str(fnm_u, 0, len(fnm_u) - 1))
      }
      when is_ident_word(fnm_u) == 1 && string_eq(fnm_u, fname) == 1 {
        give concat(su, concat("\n", concat(numstr(l), "\nany")))
      }
    }
    l = l + 1
  }
  give ""
}

make extract_fn_ret_type(decl_line: str) -> str {
  hold ar = find(decl_line, "->")
  when ar < 0 {
    give "void"
  }
  hold rest = trim_str(sub_str(decl_line, ar + 2, len(decl_line)))
  hold bo = find(rest, "{")
  when bo >= 0 {
    rest = trim_str(sub_str(rest, 0, bo))
  }
  give rest
}

make extract_param_type(sig_line: str, pname: str) -> str {
  hold po = find(sig_line, "(")
  hold pc = find_from(sig_line, ")", po)
  when po < 0 || pc <= po {
    give ""
  }
  hold inner = sub_str(sig_line, po + 1, pc)
  hold n = len(inner)
  hold start = 0
  hold i = 0
  hold depth = 0
  while i <= n {
    hold split = 0
    when i == n {
      split = 1
    } otherwise {
      hold c = sx_index(inner, i)
      when c == 60 {
        depth = depth + 1
      }
      when c == 62 {
        depth = depth - 1
      }
      when c == 44 && depth <= 0 {
        split = 1
      }
    }
    when split == 1 {
      hold piece = trim_str(sub_str(inner, start, i))
      hold col = find(piece, ":")
      when col > 0 {
        hold pnm = trim_str(sub_str(piece, 0, col))
        when string_eq(pnm, pname) == 1 {
          give trim_str(sub_str(piece, col + 1, len(piece)))
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  give ""
}

make builtin_ret_type(callee: str) -> str {
  when string_eq(callee, "concat") == 1 || string_eq(callee, "chr") == 1 || string_eq(callee, "sub_str") == 1 || string_eq(callee, "read_file") == 1 || string_eq(callee, "read_dir") == 1 || string_eq(callee, "arg") == 1 || string_eq(callee, "getenv") == 1 || string_eq(callee, "path_real") == 1 || string_eq(callee, "numstr") == 1 || string_eq(callee, "child_line") == 1 || string_eq(callee, "child_recv") == 1 {
    give "str"
  }
  when string_eq(callee, "len") == 1 || string_eq(callee, "sx_index") == 1 || string_eq(callee, "string_eq") == 1 || string_eq(callee, "arg_count") == 1 || string_eq(callee, "write_file") == 1 || string_eq(callee, "path_kind") == 1 || string_eq(callee, "path_size") == 1 || string_eq(callee, "remove_path") == 1 || string_eq(callee, "run_command") == 1 || string_eq(callee, "exit") == 1 || string_eq(callee, "bit_and") == 1 || string_eq(callee, "bit_or") == 1 || string_eq(callee, "bit_xor") == 1 || string_eq(callee, "bit_not") == 1 || string_eq(callee, "shl") == 1 || string_eq(callee, "shr") == 1 || string_eq(callee, "spawn") == 1 || string_eq(callee, "child_send") == 1 || string_eq(callee, "child_close") == 1 || string_eq(callee, "gc_runs") == 1 || string_eq(callee, "gc_bytes") == 1 {
    give "num"
  }
  when string_eq(callee, "push") == 1 || string_eq(callee, "read_bytes") == 1 {
    give "list"
  }
  give ""
}

make is_ident_word(s: str) -> num {
  hold n = len(s)
  when n <= 0 {
    give 0
  }
  hold c0 = sx_index(s, 0)
  when is_ident(c0) == 0 || (c0 >= 48 && c0 <= 57) {
    give 0
  }
  hold i = 1
  while i < n {
    when is_ident(sx_index(s, i)) == 0 {
      give 0
    }
    i = i + 1
  }
  give 1
}

make recv_before_dot(lt: str, bytepos: num) -> str {
  hold n = len(lt)
  when bytepos < 0 || bytepos > n {
    give ""
  }
  hold ws = bytepos
  when ws == n && ws > 0 {
    ws = ws - 1
  }
  while ws > 0 && is_ident(sx_index(lt, ws - 1)) == 1 {
    ws = ws - 1
  }
  when ws <= 1 {
    give ""
  }
  when sx_index(lt, ws - 1) != 46 {
    give ""
  }
  hold re = ws - 1
  hold rs = re
  while rs > 0 && is_ident(sx_index(lt, rs - 1)) == 1 {
    rs = rs - 1
  }
  when rs >= re {
    give ""
  }
  give sub_str(lt, rs, re)
}

make hold_rhs_of(line: str) -> str {
  hold cl = strip_line_comment(line)
  hold eq = find(cl, "=")
  when eq < 0 {
    give ""
  }
  give trim_str(sub_str(cl, eq + 1, len(cl)))
}

make hold_ann_of(line: str, vname: str) -> str {
  hold cl = strip_line_comment(line)
  hold eq = find(cl, "=")
  hold lhs = cl
  when eq > 0 {
    lhs = sub_str(cl, 0, eq)
  }
  hold col = find(lhs, ":")
  when col > 0 {
    give trim_str(sub_str(lhs, col + 1, len(lhs)))
  }
  give ""
}

// Forward-free mutual recursion via depth-bounded lsp_infer_type(mode, ...):
// mode 0 = infer expression `target`, mode 1 = infer variable `target` at line `at_ln`.
make lsp_infer_type(mode: num, target: str, doc: str, docuri: str, at_ln: num, depth: num, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when depth > 5 {
    give ""
  }
  when mode == 1 {
    hold vname = trim_str(target)
    when len(vname) <= 0 {
      give ""
    }
    hold fnl = fn_open_line(doc, at_ln)
    when fnl >= 0 {
      hold fnend = fn_close_line(doc, fnl)
      hold sig_l = strip_line_comment(line_text(doc, fnl))
      hold l = scoped_local_decl_line(doc, fnl, fnend, at_ln, vname)
      when l == fnl && sig_param(sig_l, vname) == 1 {
        give extract_param_type(sig_l, vname)
      }
      when l > fnl {
        hold dl = strip_line_comment(line_text(doc, l))
        when starts(dl, 0, concat("for ", vname)) == 1 {
          give "num"
        }
        hold ann = hold_ann_of(dl, vname)
        when len(ann) > 0 {
          give ann
        }
        hold rhs = hold_rhs_of(dl)
        give lsp_infer_type(0, rhs, doc, docuri, l, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      }
      when sig_param(sig_l, vname) == 1 {
        give extract_param_type(sig_l, vname)
      }
    }
    hold thit = ws_find_top_decl(vname, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
    when len(thit) > 0 {
      hold tu = line_text(thit, 0)
      hold tl = parse_int_str(line_text(thit, 1))
      hold td = line_text(thit, 2)
      when starts(td, 0, "hold ") == 1 {
        hold tann = hold_ann_of(td, vname)
        when len(tann) > 0 {
          give tann
        }
        hold tsrc = source_for_uri(tu, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
        give lsp_infer_type(0, hold_rhs_of(td), tsrc, tu, tl, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      }
    }
    give ""
  }

  // mode == 0: expression type inference
  hold e = strip_line_comment(target)
  when len(e) <= 0 {
    give ""
  }
  hold c0 = sx_index(e, 0)
  when c0 == 34 {
    give "str"
  }
  when c0 == 91 {
    give "list"
  }
  when c0 >= 48 && c0 <= 57 {
    give "num"
  }
  when c0 == 45 && len(e) > 1 {
    hold c1 = sx_index(e, 1)
    when c1 >= 48 && c1 <= 57 {
      give "num"
    }
  }
  // Struct literal: TypeName { ... }, alias.TypeName { ... }, or TypeName<Arg> { ... }
  hold bo = find(e, "{")
  hold po = find(e, "(")
  when bo > 0 && (po < 0 || bo < po) {
    hold sname = trim_str(sub_str(e, 0, bo))
    hold bsn = base_type_name(sname)
    when is_ident_word(bsn) == 1 {
      give sname
    }
    hold sdot = find(bsn, ".")
    when sdot > 0 {
      hold smal = trim_str(sub_str(bsn, 0, sdot))
      hold smnm = trim_str(sub_str(bsn, sdot + 1, len(bsn)))
      when is_ident_word(smal) == 1 && is_ident_word(smnm) == 1 {
        give sname
      }
    }
  }
  // Function call: callee(...), alias.callee(...), or callee<Arg>(...)
  when po > 0 {
    hold raw_cal = trim_str(sub_str(e, 0, po))
    hold cal = base_type_name(raw_cal)
    hold call_targ = first_type_arg(raw_cal)
    hold cdot = find(cal, ".")
    when cdot > 0 {
      hold cmal = trim_str(sub_str(cal, 0, cdot))
      hold cmfn = trim_str(sub_str(cal, cdot + 1, len(cal)))
      hold cmhit = doc_module_lookup(doc, docuri, cmal)
      when len(cmhit) > 0 && is_ident_word(cmfn) == 1 {
        hold cmu = line_text(cmhit, 2)
        hold cmp = line_text(cmhit, 3)
        hold cmsrc = open_or_disk(cmu, cmp, u0, t0, u1, t1, u2, t2, u3, t3)
        hold cmdl = top_decl_line(cmsrc, cmfn)
        when cmdl >= 0 {
          hold cmfd = strip_line_comment(line_text(cmsrc, cmdl))
          when starts(cmfd, 0, "make ") == 1 {
            hold cmrt = extract_fn_ret_type(cmfd)
            when find(cmrt, ".") < 0 && is_ident_word(cmrt) == 1 && string_eq(cmrt, "num") == 0 && string_eq(cmrt, "str") == 0 && string_eq(cmrt, "list") == 0 && string_eq(cmrt, "void") == 0 {
              cmrt = concat(cmal, concat(".", cmrt))
            }
            give cmrt
          }
        }
      }
    }
    when is_ident_word(cal) == 1 {
      hold bt = builtin_ret_type(cal)
      when len(bt) > 0 {
        give bt
      }
      hold fhit = ws_find_top_decl(cal, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(fhit) > 0 {
        hold fd = line_text(fhit, 2)
        when starts(fd, 0, "make ") == 1 {
          hold rt = extract_fn_ret_type(fd)
          hold fn_tp = first_type_arg(sub_str(fd, 0, find(fd, "(")))
          when len(fn_tp) > 0 && len(call_targ) > 0 && string_eq(rt, fn_tp) == 1 {
            rt = call_targ
          }
          give rt
        }
      }
    }
  }
  // Dot field or module member access: recv.field
  hold dot = find(e, ".")
  when dot > 0 && po < 0 {
    hold rcv = trim_str(sub_str(e, 0, dot))
    hold fld = trim_str(sub_str(e, dot + 1, len(e)))
    when is_ident_word(rcv) == 1 && is_ident_word(fld) == 1 {
      hold dmhit = doc_module_lookup(doc, docuri, rcv)
      when len(dmhit) > 0 {
        hold dmu = line_text(dmhit, 2)
        hold dmp = line_text(dmhit, 3)
        hold dmsrc = open_or_disk(dmu, dmp, u0, t0, u1, t1, u2, t2, u3, t3)
        hold dmdl = top_decl_line(dmsrc, fld)
        when dmdl >= 0 {
          give lsp_infer_type(1, fld, dmsrc, dmu, dmdl, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
        }
      }
      hold rty = lsp_infer_type(1, rcv, doc, docuri, at_ln, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(rty) > 0 {
        hold fmeta = ws_find_struct_field(rty, fld, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
        when len(fmeta) > 0 {
          give line_text(fmeta, 2)
        }
      }
    }
  }
  // Bare variable reference
  when is_ident_word(e) == 1 {
    give lsp_infer_type(1, e, doc, docuri, at_ln, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
  }
  // Binary arithmetic / comparison operators outside strings
  when find(e, " + ") >= 0 {
    hold p_plus = find(e, " + ")
    hold lty = lsp_infer_type(0, sub_str(e, 0, p_plus), doc, docuri, at_ln, depth + 1, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
    when string_eq(lty, "str") == 1 {
      give "str"
    }
    give "num"
  }
  when find(e, " - ") >= 0 || find(e, " * ") >= 0 || find(e, " / ") >= 0 || find(e, " % ") >= 0 || find(e, " == ") >= 0 || find(e, " != ") >= 0 || find(e, " < ") >= 0 || find(e, " > ") >= 0 {
    give "num"
  }
  give ""
}

make wrap_hover_json(md: str) -> str {
  hold b = "{\"contents\":{\"kind\":\"markdown\",\"value\":\""
  b = b + json_esc(md)
  b = b + "\"}}"
  give b
}

make hover_typed(w: str, doc: str, docuri: str, ln: num, ch: num, ws_root: str, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when len(doc) <= 0 || len(w) <= 0 {
    give hover_for(w, doc)
  }
  hold lt = line_text(doc, ln)
  hold bytepos = utf16_byte(lt, ch)
  // 1. Module member or struct field hover on recv.member
  hold recv = recv_before_dot(lt, bytepos)
  when len(recv) > 0 {
    hold mhit_h = doc_module_lookup(doc, docuri, recv)
    when len(mhit_h) > 0 {
      hold h_mname = line_text(mhit_h, 0)
      hold h_mu = line_text(mhit_h, 2)
      hold h_mp = line_text(mhit_h, 3)
      hold h_msrc = open_or_disk(h_mu, h_mp, u0, t0, u1, t1, u2, t2, u3, t3)
      hold h_mdl = top_decl_line(h_msrc, w)
      when h_mdl >= 0 {
        hold h_md = strip_line_comment(line_text(h_msrc, h_mdl))
        when starts(h_md, 0, "make ") == 1 {
          give wrap_hover_json(concat("`", concat(h_md, concat("` — in module `", concat(h_mname, concat("` (`", concat(basename_uri(h_mu), "`)")))))))
        }
        when starts(h_md, 0, "struct ") == 1 {
          hold h_sum = parse_struct_summary(h_msrc, h_mdl)
          give wrap_hover_json(concat("`", concat(h_sum, concat("` — in module `", concat(h_mname, concat("` (`", concat(basename_uri(h_mu), "`)")))))))
        }
        when starts(h_md, 0, "hold ") == 1 {
          hold h_vty = lsp_infer_type(1, w, h_msrc, h_mu, h_mdl, 0, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
          when len(h_vty) <= 0 {
            h_vty = "any"
          }
          give wrap_hover_json(concat("`", concat(recv, concat(".", concat(w, concat(": ", concat(h_vty, concat("` — in module `", concat(h_mname, "`")))))))))
        }
      }
    }
    hold rtype = lsp_infer_type(1, recv, doc, docuri, ln, 0, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
    when len(rtype) > 0 {
      hold fhit = ws_find_struct_field(rtype, w, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(fhit) > 0 {
        hold fu = line_text(fhit, 0)
        hold fty = line_text(fhit, 2)
        hold fmd = concat("`", concat(rtype, concat(".", concat(w, concat(": ", concat(fty, "` — struct field"))))))
        when string_eq(fu, docuri) == 0 {
          fmd = concat(fmd, concat(" (defined in `", concat(basename_uri(fu), "`)")))
        }
        give wrap_hover_json(fmd)
      }
    }
  }
  // 1b. Hovering directly on a module alias identifier
  hold mal_hit = doc_module_lookup(doc, docuri, w)
  when len(mal_hit) > 0 {
    hold mal_nm = line_text(mal_hit, 0)
    hold mal_rel = line_text(mal_hit, 4)
    give wrap_hover_json(concat("`module ", concat(mal_nm, concat(" as ", concat(w, concat(" from \"", concat(mal_rel, "\"` — namespaced module.")))))))
  }
  // 2. Builtin / keyword doc
  hold bdoc = doc_for(w)
  when len(bdoc) > 0 {
    give wrap_hover_json(bdoc)
  }
  // 3. Local parameter or block-scoped local variable inside enclosing function
  hold fnl = fn_open_line(doc, ln)
  when fnl >= 0 {
    hold fnend = fn_close_line(doc, fnl)
    hold sig_l = strip_line_comment(line_text(doc, fnl))
    hold sdecl = scoped_local_decl_line(doc, fnl, fnend, ln, w)
    when sdecl > fnl {
      hold vty = lsp_infer_type(1, w, doc, docuri, ln, 0, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(vty) > 0 {
        give wrap_hover_json(concat("`", concat(w, concat(": ", concat(vty, "` — local variable in this function.")))))
      }
      give hover_for(w, doc)
    }
    when sig_param(sig_l, w) == 1 {
      hold pty = extract_param_type(sig_l, w)
      when len(pty) <= 0 {
        pty = "any"
      }
      give wrap_hover_json(concat("`", concat(w, concat(": ", concat(pty, "` — parameter in enclosing function.")))))
    }
  }
  // 4. Top-level make / struct / hold across doc + use imports + open buffers + workspace index
  hold thit = ws_find_top_decl(w, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
  when len(thit) > 0 {
    hold tu = line_text(thit, 0)
    hold tl = parse_int_str(line_text(thit, 1))
    hold td = line_text(thit, 2)
    when starts(td, 0, "make ") == 1 {
      hold mmd = concat("`", concat(td, "`"))
      when string_eq(tu, docuri) == 0 {
        mmd = concat(mmd, concat(" — defined in `", concat(basename_uri(tu), "`")))
      }
      give wrap_hover_json(mmd)
    }
    when starts(td, 0, "struct ") == 1 {
      hold ssrc = source_for_uri(tu, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      hold sum = parse_struct_summary(ssrc, tl)
      hold smd = concat("`", concat(sum, "`"))
      when string_eq(tu, docuri) == 0 {
        smd = concat(smd, concat(" — defined in `", concat(basename_uri(tu), "`")))
      }
      give wrap_hover_json(smd)
    }
    when starts(td, 0, "hold ") == 1 {
      hold tsrc2 = source_for_uri(tu, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      hold gty = lsp_infer_type(1, w, tsrc2, tu, tl, 0, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      // Preserve legacy rootless single-file numeric blurb expected by tools/sayanox-lsp-unicode.sh
      when len(ws_root) <= 0 && string_eq(tu, docuri) == 1 && string_eq(gty, "num") == 1 && find(hold_rhs_of(td), "(") < 0 && find(hold_rhs_of(td), ".") < 0 {
        give hover_for(w, doc)
      }
      when len(gty) > 0 {
        hold gmd = concat("`", concat(w, concat(": ", concat(gty, "` — a variable"))))
        when string_eq(tu, docuri) == 1 {
          gmd = concat(gmd, " in this document.")
        } otherwise {
          gmd = concat(gmd, concat(" defined in `", concat(basename_uri(tu), "`.")))
        }
        give wrap_hover_json(gmd)
      }
    }
  }
  give hover_for(w, doc)
}

make definition_typed(w: str, doc: str, docuri: str, ln: num, ch: num, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when len(doc) <= 0 {
    give "null"
  }
  hold lt = line_text(doc, ln)
  // 1. Clicking on a use "mod.sa" or module ... from "mod.sa" line jumps to line 0 of that module
  hold uuri = use_uri_on_line(lt, docuri, u0, u1, u2, u3)
  when len(uuri) > 0 {
    give loc_line(uuri, 0)
  }
  hold muri = module_uri_on_line(lt, docuri, u0, u1, u2, u3)
  when len(muri) > 0 {
    give loc_line(muri, 0)
  }
  when len(w) <= 0 {
    give "null"
  }
  // 2. Clicking on .member in alias.member or recv.field
  hold bytepos = utf16_byte(lt, ch)
  hold recv = recv_before_dot(lt, bytepos)
  when len(recv) > 0 {
    hold mhit_d = doc_module_lookup(doc, docuri, recv)
    when len(mhit_d) > 0 {
      hold d_mu = line_text(mhit_d, 2)
      hold d_mp = line_text(mhit_d, 3)
      hold d_msrc = open_or_disk(d_mu, d_mp, u0, t0, u1, t1, u2, t2, u3, t3)
      hold d_mdl = top_decl_line(d_msrc, w)
      when d_mdl >= 0 {
        give loc_line(d_mu, d_mdl)
      }
    }
    hold rtype = lsp_infer_type(1, recv, doc, docuri, ln, 0, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
    when len(rtype) > 0 {
      hold fhit = ws_find_struct_field(rtype, w, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(fhit) > 0 {
        give loc_line(line_text(fhit, 0), parse_int_str(line_text(fhit, 1)))
      }
    }
  }
  // 2b. Clicking on a module alias identifier jumps to line 0 of that module file
  hold mal_def = doc_module_lookup(doc, docuri, w)
  when len(mal_def) > 0 {
    hold mal_tu = line_text(mal_def, 2)
    hold mal_tp = line_text(mal_def, 3)
    when string_eq(mal_tu, u0) == 1 || string_eq(mal_tu, u1) == 1 || string_eq(mal_tu, u2) == 1 || string_eq(mal_tu, u3) == 1 || path_kind(mal_tp) == 1 {
      give loc_line(mal_tu, 0)
    }
    give loc_line(docuri, parse_int_str(line_text(mal_def, 1)))
  }
  // 3. Enclosing function parameter / lexical block-scoped local binder
  hold fnl = fn_open_line(doc, ln)
  when fnl >= 0 {
    hold fnend = fn_close_line(doc, fnl)
    hold ldecl = scoped_local_decl_line(doc, fnl, fnend, ln, w)
    when ldecl >= 0 {
      give loc_line(docuri, ldecl)
    }
  }
  // 4. Current document top-level declaration
  hold tdecl = top_decl_line(doc, w)
  when tdecl >= 0 {
    give loc_line(docuri, tdecl)
  }
  // 5. Cross-file declaration in use imports, open buffers, or workspace folder index
  hold whit = ws_find_top_decl(w, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
  when len(whit) > 0 {
    give loc_line(line_text(whit, 0), parse_int_str(line_text(whit, 1)))
  }
  give definition_for(w, doc, docuri)
}

// Sanitize one line up to `limit_b` by blanking string interiors and stripping // comments
// while preserving exact byte offsets of `(`, `)`, `,`, `.`, and identifiers outside strings.
make sanitize_call_line(raw: str, limit_b: num) -> str {
  hold n = len(raw)
  when limit_b >= 0 && limit_b < n {
    n = limit_b
  }
  hold out = ""
  hold i = 0
  hold in_s = 0
  while i < n {
    hold c = sx_index(raw, i)
    when in_s == 1 {
      when c == 92 && i + 1 < n {
        out = concat(out, "  ")
        i = i + 2
      } otherwise {
        when c == 34 {
          in_s = 0
        }
        out = concat(out, " ")
        i = i + 1
      }
    } otherwise {
      when c == 47 && i + 1 < n && sx_index(raw, i + 1) == 47 {
        i = n
      } otherwise {
        when c == 34 {
          in_s = 1
          out = concat(out, " ")
          i = i + 1
        } otherwise {
          out = concat(out, chr(c))
          i = i + 1
        }
      }
    }
  }
  give out
}

// Multi-line + qualified `alias.fn(...)` call scanner looking backwards up to 16 lines.
// Returns: recv\ncallee\nactive_param (or "" if cursor is not inside an open call).
make multiline_call_context(doc: str, line: num, ch: num) -> str {
  hold min_l = line - 16
  when min_l < 0 {
    min_l = 0
  }
  hold joined = ""
  hold l = min_l
  while l <= line {
    hold raw = line_text(doc, l)
    hold lim = 0 - 1
    when l == line {
      lim = utf16_byte(raw, ch)
    }
    hold clean = sanitize_call_line(raw, lim)
    joined = concat(joined, concat(clean, " "))
    l = l + 1
  }
  // Scan backwards from end of `joined` to find innermost unmatched `(` and active comma count
  hold i = len(joined) - 1
  hold depth = 0
  hold commas = 0
  hold open_at = 0 - 1
  while i >= 0 && open_at < 0 {
    hold c = sx_index(joined, i)
    when c == 41 {
      depth = depth + 1
    } otherwise {
      when c == 40 {
        when depth == 0 {
          open_at = i
        } otherwise {
          depth = depth - 1
        }
      } otherwise {
        when c == 44 && depth == 0 {
          commas = commas + 1
        }
      }
    }
    i = i - 1
  }
  when open_at <= 0 {
    give ""
  }
  hold p = open_at
  while p > 0 && (sx_index(joined, p - 1) == 32 || sx_index(joined, p - 1) == 9) {
    p = p - 1
  }
  hold ce = p
  while p > 0 && is_ident(sx_index(joined, p - 1)) == 1 {
    p = p - 1
  }
  when p >= ce {
    give ""
  }
  hold callee = sub_str(joined, p, ce)
  hold recv = ""
  when p > 1 && sx_index(joined, p - 1) == 46 {
    hold re = p - 1
    hold rs = re
    while rs > 0 && is_ident(sx_index(joined, rs - 1)) == 1 {
      rs = rs - 1
    }
    when rs < re {
      recv = sub_str(joined, rs, re)
    }
  }
  give concat(recv, concat("\n", concat(callee, concat("\n", numstr(commas)))))
}

make sig_help_ws(w: str, doc: str, docuri: str, line: num, ch: num, manifest: str, u0: str, t0: str, u1: str, t1: str, u2: str, t2: str, u3: str, t3: str) -> str {
  when len(doc) <= 0 {
    give "null"
  }
  hold ctx = multiline_call_context(doc, line, ch)
  when len(ctx) <= 0 {
    give sig_help(w, doc, line, ch)
  }
  hold recv = line_text(ctx, 0)
  hold callee = line_text(ctx, 1)
  hold active_idx = parse_int_str(line_text(ctx, 2))
  // Single-line unqualified call in same document: try fast local sig_help first
  when len(recv) <= 0 {
    hold local_ans = sig_help(w, doc, line, ch)
    when string_eq(local_ans, "null") == 0 {
      give local_ans
    }
  }
  hold fd = ""
  when len(recv) > 0 {
    hold mhit = doc_module_lookup(doc, docuri, recv)
    when len(mhit) > 0 {
      hold mu = line_text(mhit, 2)
      hold mp = line_text(mhit, 3)
      hold msrc = open_or_disk(mu, mp, u0, t0, u1, t1, u2, t2, u3, t3)
      hold mdl = top_decl_line(msrc, callee)
      when mdl >= 0 {
        fd = strip_line_comment(line_text(msrc, mdl))
      }
    }
  } otherwise {
    hold dl_self = top_decl_line(doc, callee)
    when dl_self >= 0 {
      fd = strip_line_comment(line_text(doc, dl_self))
    } otherwise {
      hold fhit = ws_find_top_decl(callee, doc, docuri, manifest, u0, t0, u1, t1, u2, t2, u3, t3)
      when len(fhit) > 0 {
        fd = line_text(fhit, 2)
      }
    }
  }
  when starts(fd, 0, "make ") == 0 {
    give "null"
  }
  // Construct synthetic 2-line buffer with exact active parameter comma count
  hold call_ln = concat(callee, "(")
  hold ci = 0
  while ci < active_idx {
    call_ln = concat(call_ln, "x,")
    ci = ci + 1
  }
  hold cur_col = len(call_ln)
  call_ln = concat(call_ln, "y)")
  hold synth = concat(fd, concat("\n", concat(call_ln, "\n")))
  give sig_help(callee, synth, 1, cur_col)
}

// Validate cursor for textDocument/prepareRename: refuses keywords, builtins,
// string literals, // comments, numbers, and non-identifier positions.
make prepare_rename_at(doc: str, ln: num, ch: num) -> str {
  when len(doc) <= 0 {
    give "null"
  }
  hold lt = line_text(doc, ln)
  hold n = len(lt)
  hold bytepos = utf16_byte(lt, ch)
  when bytepos < 0 || bytepos > n {
    give "null"
  }
  // Reject positions inside string literals or // comments
  hold i = 0
  hold in_s = 0
  while i < bytepos && i < n {
    hold c = sx_index(lt, i)
    when in_s == 1 {
      when c == 92 && i + 1 < n {
        i = i + 2
      } otherwise {
        when c == 34 {
          in_s = 0
        }
        i = i + 1
      }
    } otherwise {
      when c == 47 && i + 1 < n && sx_index(lt, i + 1) == 47 {
        give "null"
      }
      when c == 34 {
        in_s = 1
      }
      i = i + 1
    }
  }
  when in_s == 1 {
    give "null"
  }
  when bytepos < n && sx_index(lt, bytepos) == 47 && bytepos + 1 < n && sx_index(lt, bytepos + 1) == 47 {
    give "null"
  }
  when bytepos < n && sx_index(lt, bytepos) == 34 {
    give "null"
  }
  hold ws = bytepos
  when ws == n && ws > 0 && is_ident(sx_index(lt, ws - 1)) == 1 {
    ws = ws - 1
  }
  while ws > 0 && is_ident(sx_index(lt, ws - 1)) == 1 {
    ws = ws - 1
  }
  hold we = ws
  while we < n && is_ident(sx_index(lt, we)) == 1 {
    we = we + 1
  }
  when we <= ws || bytepos < ws || bytepos > we {
    give "null"
  }
  hold word = sub_str(lt, ws, we)
  when is_ident_word(word) == 0 || known_word(word) == 1 {
    give "null"
  }
  hold sp_a = utf16_span(lt, ws)
  hold sp_b = utf16_span(lt, we - 1)
  hold u_start = sp_a[0]
  hold u_end = sp_b[1]
  hold r = "{\"range\":{\"start\":{\"line\":"
  r = concat(r, numstr(ln))
  r = concat(r, ",\"character\":")
  r = concat(r, numstr(u_start))
  r = concat(r, "},\"end\":{\"line\":")
  r = concat(r, numstr(ln))
  r = concat(r, ",\"character\":")
  r = concat(r, numstr(u_end))
  r = concat(r, "}},\"placeholder\":\"")
  r = concat(r, json_esc(word))
  r = concat(r, "\"}")
  give r
}

// ------------------------------------------------------- open documents
// Four documents can be open at once. The dialect has no array of strings, so
// the table is four parallel pairs of globals, and exactly three places touch
// it: the load cascade under the framing loop, didOpen (store) and didClose
// (clear). `doc`/`docuri` are NOT the table -- they are the document the
// message being handled refers to, reloaded per message, which is what makes
// hover/definition/documentSymbol/diagnostic answer from the right buffer.
// A fifth didOpen evicts the oldest slot (round robin through slotnext) and the
// evicted document simply stops being served: a request for it gets an empty
// text, so hover answers null and documentSymbol answers [] instead of
// answering from another file.
hold uri0 = ""
hold txt0 = ""
hold uri1 = ""
hold txt1 = ""
hold uri2 = ""
hold txt2 = ""
hold uri3 = ""
hold txt3 = ""
hold workspace_root = ""
hold workspace_index = ""
hold slotnext = 0
hold placed = 0
hold doc = ""
hold docuri = ""
hold running = 1
hold hdr = ""
hold clen = 0
hold got = 0
hold body = ""
hold method = ""
hold idraw = ""
hold uri = ""
hold text = ""
hold line = 0
hold ch = 0
hold w = ""
hold res = ""
hold params = ""
hold d = 0
hold c = 0
hold v = 0
hold i = 0
hold n = 0
hold seen = 0
hold ln = 0
hold incl = 1
hold part = ""
hold part2 = ""
hold q = ""
// Semantic scope of the word a position request is about: fnl/fnend are the
// first and last line of the enclosing function body (-1 when the cursor is
// at the top level) and decl is the line that binds the word inside it, so
// decl >= 0 means "this name is local to that body".
hold fnl = 0
hold fnend = 0
hold decl = 0
hold rlo = 0
// 1 when the client said it supports dynamic registration for file watching.
hold watch_dyn = 0

while running == 1 {
  hdr = read_line()
  when len(hdr) <= 0 {
    running = 0
  } otherwise {
    clen = -1
    got = 0
    while len(hdr) > 0 {
      when starts(hdr, 0, "Content-Length:") == 1 {
        v = 0
        seen = 0
        i = 15
        n = len(hdr)
        while i < n {
          c = sx_index(hdr, i)
          when c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
            seen = 1
          }
          i += 1
        }
        when seen == 1 {
          clen = v
          got = 1
        }
      }
      hdr = read_line()
    }
    when got == 1 && clen > 0 {
      body = read_n(clen)
      idraw = id_raw(body)
      method = str_field(body, "method")
      when len(method) <= 0 {
        method = ""
      }
      uri = str_field(body, "uri")
      text = str_field(body, "text")
      ln = num_field(body, "line", 0)
      ch = num_field(body, "character", 0)
      // Load the document this message is about. A message whose uri is not
      // open leaves doc empty (and every reader below then answers "nothing
      // here" rather than reading the buffer that happened to be opened last).
      doc = ""
      docuri = uri
      when string_eq(uri, uri0) {
        doc = txt0
      }
      when string_eq(uri, uri1) {
        doc = txt1
      }
      when string_eq(uri, uri2) {
        doc = txt2
      }
      when string_eq(uri, uri3) {
        doc = txt3
      }
      when string_eq(method, "initialize") {
        workspace_root = str_field(body, "rootUri")
        when len(workspace_root) == 0 {
          workspace_root = str_field(body, "uri")
        }
        // A watcher can only be asked for when the client offers dynamic
        // registration for it; a client that does not mention
        // didChangeWatchedFiles is never sent a registration request.
        watch_dyn = 0
        when find(body, "didChangeWatchedFiles") >= 0 {
          watch_dyn = 1
        }
        hold prep_ren = 0
        when find(body, "\"prepareSupport\":true") >= 0 || find(body, "\"prepareSupport\": true") >= 0 {
          prep_ren = 1
        }
        res = concat("{\"capabilities\":", capabilities_ext(prep_ren))
        res = concat(res, ",\"serverInfo\":{\"name\":\"sayanox-lsp\",\"version\":\"2.0\"}}")
        d = reply(idraw, res)
      }
      when string_eq(method, "initialized") {
        d = 1
        when watch_dyn == 1 {
          d = request_out("sayanox-watch-sa", "client/registerCapability", watch_registration())
          watch_dyn = 2
        }
      }
      // The client's answer to that registration comes back as a response:
      // an id, no method, and a result or an error. It is not a request, so
      // it is acknowledged by doing nothing (the error paths at the end skip
      // it too, which is why this branch records nothing).
      when string_eq(method, "workspace/didChangeWatchedFiles") {
        workspace_index = workspace_manifest(workspace_root)
        d = watched_refresh(body, uri0, uri1, uri2, uri3)
      }
      when string_eq(method, "shutdown") {
        d = reply(idraw, "null")
      }
      when string_eq(method, "textDocument/didOpen") {
        // Reuse this uri's slot when it is already open, else take the next
        // slot round robin (evicting the document that has been open longest).
        placed = 0
        when string_eq(uri, uri0) {
          txt0 = text
          placed = 1
        }
        when string_eq(uri, uri1) {
          txt1 = text
          placed = 1
        }
        when string_eq(uri, uri2) {
          txt2 = text
          placed = 1
        }
        when string_eq(uri, uri3) {
          txt3 = text
          placed = 1
        }
        when placed == 0 {
          when slotnext == 0 {
            uri0 = uri
            txt0 = text
          }
          when slotnext == 1 {
            uri1 = uri
            txt1 = text
          }
          when slotnext == 2 {
            uri2 = uri
            txt2 = text
          }
          when slotnext == 3 {
            uri3 = uri
            txt3 = text
          }
          when slotnext >= 3 {
            slotnext = 0
          } otherwise {
            slotnext = slotnext + 1
          }
        }
        docuri = uri
        doc = text
        params = concat("{\"uri\":\"", json_esc(docuri))
        params = concat(params, "\",\"diagnostics\":")
        params = concat(params, diagnostics(doc, dir_of(docuri)))
        params = concat(params, "}")
        d = notify("textDocument/publishDiagnostics", params)
      }
      when string_eq(method, "textDocument/didChange") {
        // One notification may carry several change objects; they are applied
        // in order to the current buffer (LSP applies them sequentially). Each
        // object without a `range` is a full replacement of that document, an
        // object with a `range` is a UTF-16 splice (the `change: 2` capability
        // advertised in initialize). At most 8 objects are applied; extra ones
        // are ignored rather than partially applied. Positions and ranges are
        // clamped, so a malformed element cannot move text outside the buffer.
        hold newtxt = ""
        hold have = 0
        when string_eq(uri, uri0) {
          newtxt = txt0
          have = 1
        }
        when string_eq(uri, uri1) {
          newtxt = txt1
          have = 1
        }
        when string_eq(uri, uri2) {
          newtxt = txt2
          have = 1
        }
        when string_eq(uri, uri3) {
          newtxt = txt3
          have = 1
        }
        hold cur = find(body, "\"contentChanges\"")
        when cur >= 0 {
          cur = find_from(body, "[", cur)
        }
        hold applied = 0
        while have == 1 && applied < 8 {
          when cur < 0 {
            break
          }
          hold ob = find_from(body, "{", cur + 1)
          when ob < 0 {
            break
          }
          hold close = find_from(body, "]", cur + 1)
          when close >= 0 && close < ob {
            break
          }
          hold oe = obj_end(body, ob)
          hold rp = find_from(body, "\"range\"", ob)
          when rp >= 0 && rp < oe {
            hold rsl = num_field_between(body, "line", ob, oe, 0)
            hold rsc = num_field_between(body, "character", ob, oe, 0)
            hold rel = range_end_line(body, rp, rsl)
            hold rec = range_end_char(body, rp, rsc)
            hold ins = str_field_between(body, "text", ob, oe, "")
            newtxt = splice(newtxt, pos_byte(newtxt, rsl, rsc), pos_byte(newtxt, rel, rec), ins)
          } otherwise {
            // No range: the whole buffer becomes this element's text.
            newtxt = str_field_between(body, "text", ob, oe, newtxt)
          }
          applied += 1
          cur = oe
        }
        when have == 1 && applied > 0 {
          when string_eq(uri, uri0) {
            txt0 = newtxt
          }
          when string_eq(uri, uri1) {
            txt1 = newtxt
          }
          when string_eq(uri, uri2) {
            txt2 = newtxt
          }
          when string_eq(uri, uri3) {
            txt3 = newtxt
          }
        }

        // Reload, then publish only for a document that is actually open: a
        // change to an unknown uri must not be answered from another buffer.
        placed = 0
        doc = ""
        when string_eq(uri, uri0) {
          doc = txt0
          placed = 1
        }
        when string_eq(uri, uri1) {
          doc = txt1
          placed = 1
        }
        when string_eq(uri, uri2) {
          doc = txt2
          placed = 1
        }
        when string_eq(uri, uri3) {
          doc = txt3
          placed = 1
        }
        docuri = uri
        when placed == 1 {
          params = concat("{\"uri\":\"", json_esc(docuri))
          params = concat(params, "\",\"diagnostics\":")
          params = concat(params, diagnostics(doc, dir_of(docuri)))
          params = concat(params, "}")
          d = notify("textDocument/publishDiagnostics", params)
        }
      }
      when string_eq(method, "textDocument/didClose") {
        when string_eq(uri, uri0) {
          uri0 = ""
          txt0 = ""
        }
        when string_eq(uri, uri1) {
          uri1 = ""
          txt1 = ""
        }
        when string_eq(uri, uri2) {
          uri2 = ""
          txt2 = ""
        }
        when string_eq(uri, uri3) {
          uri3 = ""
          txt3 = ""
        }
        doc = ""
        docuri = ""
        params = concat("{\"uri\":\"", json_esc(uri))
        params = concat(params, "\",\"diagnostics\":[]}")
        d = notify("textDocument/publishDiagnostics", params)
      }
      when string_eq(method, "textDocument/diagnostic") {
        res = concat("{\"kind\":\"full\",\"items\":", diagnostics(doc, dir_of(docuri)))
        res = concat(res, "}")
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/documentSymbol") {
        d = reply(idraw, symbols(doc, docuri))
      }
      when string_eq(method, "textDocument/completion") {
        res = concat("{\"isIncomplete\":false,\"items\":", completion_items())
        res = concat(res, "}")
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/hover") {
        workspace_index = workspace_manifest(workspace_root)
        w = word_at(doc, ln, ch)
        d = reply(idraw, hover_typed(w, doc, docuri, ln, ch, workspace_root, workspace_index, uri0, txt0, uri1, txt1, uri2, txt2, uri3, txt3))
      }
      // Definition resolves local binders, struct fields (recv.field), use targets,
      // and top-level declarations across current doc, use imports, open buffers,
      // and the bounded workspace folder index.
      when string_eq(method, "textDocument/definition") {
        workspace_index = workspace_manifest(workspace_root)
        w = word_at(doc, ln, ch)
        d = reply(idraw, definition_typed(w, doc, docuri, ln, ch, workspace_index, uri0, txt0, uri1, txt1, uri2, txt2, uri3, txt3))
      }
      // Open buffers overlay the bounded disk index. Helpers cannot capture
      // the four-slot table, so the
      // cascade lives here: each slot is scanned in turn and the comma rule
      // inside the helper joins the items. len(res) is the running item count.
      when string_eq(method, "textDocument/references") {
        workspace_index = workspace_manifest(workspace_root)
        when string_eq(uri, uri0) == 0 && string_eq(uri, uri1) == 0 && string_eq(uri, uri2) == 0 && string_eq(uri, uri3) == 0 {
          doc = workspace_text(workspace_index, uri)
        }
        w = word_at(doc, ln, ch)
        incl = 1
        when find(body, "\"includeDeclaration\":false") >= 0 || find(body, "\"includeDeclaration\": false") >= 0 {
          incl = 0
        }
        // A name bound inside a function body cannot be referred to from
        // anywhere else, so the answer is that body and nothing else. Only a
        // top-level name is searched for across the open buffers and the
        // folder index.
        fnl = fn_open_line(doc, ln)
        decl = 0 - 1
        fnend = 0
        when fnl >= 0 {
          fnend = fn_close_line(doc, fnl)
          decl = local_decl_line(doc, fnl, fnend, w)
        }
        when decl >= 0 {
          // includeDeclaration:false drops the binder. refs_for already skips
          // a `hold w` line; a parameter is dropped here, by starting the
          // search on the line after the signature.
          rlo = fnl
          when incl == 0 && decl == fnl {
            rlo = fnl + 1
          }
          res = refs_for(w, doc, docuri, incl, 0, rlo, fnend)
        } otherwise {
          res = refs_for(w, txt0, uri0, incl, 0, 0, 0 - 1)
          part = refs_for(w, txt1, uri1, incl, len(res), 0, 0 - 1)
          res = res + part
          part = refs_for(w, txt2, uri2, incl, len(res), 0, 0 - 1)
          res = res + part
          part = refs_for(w, txt3, uri3, incl, len(res), 0, 0 - 1)
          res = res + part
          part = workspace_scan(workspace_index, w, "", 1, incl, len(res), uri0, uri1, uri2, uri3)
          res = res + part
        }
        res = concat("[", concat(res, "]"))
        d = reply(idraw, res)
      }
      when string_eq(method, "workspace/symbol") {
        workspace_index = workspace_manifest(workspace_root)
        q = str_field(body, "query")
        res = sym_scan(txt0, uri0, q, 0)
        part = sym_scan(txt1, uri1, q, len(res))
        res = res + part
        part = sym_scan(txt2, uri2, q, len(res))
        res = res + part
        part = sym_scan(txt3, uri3, q, len(res))
        res = res + part
        part = workspace_scan(workspace_index, "", q, 0, 1, len(res), uri0, uri1, uri2, uri3)
        res = res + part
        res = concat("[", concat(res, "]"))
        d = reply(idraw, res)
      }
      when string_eq(method, "textDocument/formatting") {
        d = reply(idraw, format_edit(doc))
      }
      when string_eq(method, "textDocument/prepareRename") {
        workspace_index = workspace_manifest(workspace_root)
        when string_eq(uri, uri0) == 0 && string_eq(uri, uri1) == 0 && string_eq(uri, uri2) == 0 && string_eq(uri, uri3) == 0 {
          doc = workspace_text(workspace_index, uri)
        }
        d = reply(idraw, prepare_rename_at(doc, ln, ch))
      }
      // Rename spans the open documents, like references: one changes entry
      // per open document that mentions the word, declaration included. An
      // empty word or an empty newName answers an empty WorkspaceEdit.
      when string_eq(method, "textDocument/rename") {
        workspace_index = workspace_manifest(workspace_root)
        when string_eq(uri, uri0) == 0 && string_eq(uri, uri1) == 0 && string_eq(uri, uri2) == 0 && string_eq(uri, uri3) == 0 {
          doc = workspace_text(workspace_index, uri)
        }
        w = word_at(doc, ln, ch)
        part = str_field(body, "newName")
        res = "{\"changes\":{"
        q = ""
        // Same resolution as references: a name bound inside a function body
        // is renamed inside that body only, and a top-level name is renamed
        // in every open buffer and every indexed file of the folder.
        fnl = fn_open_line(doc, ln)
        decl = 0 - 1
        fnend = 0
        when fnl >= 0 {
          fnend = fn_close_line(doc, fnl)
          decl = local_decl_line(doc, fnl, fnend, w)
        }
        when decl >= 0 {
          part2 = rename_edits(w, part, doc, 0, fnl, fnend)
          when len(part2) > 0 {
            res = res + "\""
            res = res + json_esc(docuri)
            res = res + "\":["
            res = res + part2
            res = res + "]"
          }
          res = res + "}}"
          d = reply(idraw, res)
        } otherwise {
        when len(uri0) > 0 {
          part2 = rename_edits(w, part, txt0, 0, 0, 0 - 1)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri0)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri1) > 0 {
          part2 = rename_edits(w, part, txt1, 0, 0, 0 - 1)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri1)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri2) > 0 {
          part2 = rename_edits(w, part, txt2, 0, 0, 0 - 1)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri2)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        when len(uri3) > 0 {
          part2 = rename_edits(w, part, txt3, 0, 0, 0 - 1)
          when len(part2) > 0 {
            res = res + q
            res = res + "\""
            res = res + json_esc(uri3)
            res = res + "\":["
            res = res + part2
            res = res + "]"
            q = ","
          }
        }
        // ... and every file of the folder the client is not editing.
        part2 = workspace_rename(workspace_index, w, part, q, uri0, uri1, uri2, uri3)
        res = res + part2
        res = res + "}}"
        d = reply(idraw, res)
        }
      }
      when string_eq(method, "textDocument/signatureHelp") {
        workspace_index = workspace_manifest(workspace_root)
        w = word_at(doc, ln, ch)
        d = reply(idraw, sig_help_ws(w, doc, docuri, ln, ch, workspace_index, uri0, txt0, uri1, txt1, uri2, txt2, uri3, txt3))
      }
      when string_eq(method, "textDocument/codeAction") {
        d = reply(idraw, code_actions(doc, docuri))
      }
      when string_eq(method, "exit") {
        running = 0
      }
      // Error paths. A body that is not a JSON object is a parse error (id
      // null). A method-less body is an invalid request. An unknown method is
      // answered only when it is a request (has an id): notifications are
      // silently ignored, as the spec requires, so clients never hang waiting.
      when first_char(body) != 123 {
        d = reply_error("", -32700, "parse error: body is not a JSON object")
      } otherwise {
        when len(method) <= 0 {
          // A body with no method is an invalid request -- unless it is the
          // client's answer to the one request this server sends
          // (client/registerCapability), which carries a result or an error
          // instead of a method and must be passed over in silence.
          when find(body, "\"result\"") >= 0 || find(body, "\"error\"") >= 0 {
            d = 0
          } otherwise {
            d = reply_error(idraw, -32600, "invalid request: no method")
          }
        } otherwise {
          when known_method(method) == 0 {
            when len(idraw) > 0 {
              d = reply_error(idraw, -32601, "method not found")
            }
          }
        }
      }
    }
  }
}
d = flush_out()
