// tools/sxlink_lib.sa -- shared Sayanox ELF64 image writer and rel32 linker.
// Used by tools/sxlink.sa, tools/sxemit.sa, and selfhost/native_aot.sa.

// segment is linear rather than quadratic.

make put_u16(xs: list, v: num) -> list {
  xs = push(xs, bit_and(v, 255))
  xs = push(xs, bit_and(shr(v, 8), 255))
  give xs
}

make put_u32(xs: list, v: num) -> list {
  xs = put_u16(xs, bit_and(v, 65535))
  xs = put_u16(xs, shr(v, 16))
  give xs
}

make put_u64(xs: list, v: num) -> list {
  xs = put_u32(xs, bit_and(v, 4294967295))
  xs = put_u32(xs, shr(v, 32))
  give xs
}

make put_zeros(xs: list, n: num) -> list {
  hold i = 0
  while i < n {
    xs = push(xs, 0)
    i = i + 1
  }
  give xs
}

make put_bytes(xs: list, src: list, off: num, n: num) -> list {
  hold i = 0
  while i < n {
    xs = push(xs, src[off + i])
    i = i + 1
  }
  give xs
}

// ---- little-endian readers ------------------------------------------------

make le16_at(xs: list, off: num) -> num {
  give xs[off] + xs[off + 1] * 256
}

make le32_at(xs: list, off: num) -> num {
  give xs[off] + xs[off + 1] * 256 + xs[off + 2] * 65536 + xs[off + 3] * 16777216
}

make le64_at(xs: list, off: num) -> num {
  give le32_at(xs, off) + le32_at(xs, off + 4) * 4294967296
}

// ---- layout arithmetic ----------------------------------------------------
// Integer arithmetic only, through the checked `%`: a page mask is 2^64-4096,
// which a double cannot hold exactly, so rounding cannot go through `bit_and`.
// A value that is already page-aligned must not grow by a page, which is why
// both helpers special-case a zero remainder.

make round_page(n: num) -> num {
  hold r = n % 4096
  when r == 0 {
    give n
  }
  give n + (4096 - r)
}

make page_pad(n: num) -> num {
  hold r = n % 4096
  when r == 0 {
    give 0
  }
  give 4096 - r
}

make sxlink_is_digit(c: num) -> num {
  hold r = 0
  when c >= 48 && c <= 57 {
    r = 1
  }
  give r
}

// meta.txt is "npc npr cn dn\n"; only the first number is needed here, so the
// scan stops at the first non-digit instead of running the four together.
make parse_num(text: str) -> num {
  hold n = len(text)
  hold v = 0
  hold i = 0
  hold on = 0
  while i < n {
    hold c = sx_index(text, i)
    when sxlink_is_digit(c) == 1 {
      v = v * 10 + (c - 48)
      on = 1
    } otherwise {
      when on == 1 {
        i = n
      }
    }
    i = i + 1
  }
  give v
}

// ---- ELF header and program headers ---------------------------------------
// ELFCLASS64, little endian, ET_EXEC, EM_X86_64, three PT_LOAD segments and no
// section table: the 64 + 3*56 bytes native_aot writes.

make elf_header(entry: num) -> list {
  hold xs = [127, 69, 76, 70, 2, 1, 1, 0]
  xs = put_zeros(xs, 8)
  xs = put_u16(xs, 2)
  xs = put_u16(xs, 62)
  xs = put_u32(xs, 1)
  xs = put_u64(xs, entry)
  xs = put_u64(xs, 64)
  xs = put_u64(xs, 0)
  xs = put_u32(xs, 64)
  xs = put_u16(xs, 64)
  xs = put_u16(xs, 56)
  xs = put_u16(xs, 3)
  xs = put_u16(xs, 0)
  xs = put_u16(xs, 0)
  xs = put_u16(xs, 0)
  give xs
}

make program_header(xs: list, flags: num, off: num, va: num, filesz: num, memsz: num) -> list {
  xs = put_u32(xs, 1)
  xs = put_u32(xs, flags)
  xs = put_u64(xs, off)
  xs = put_u64(xs, va)
  xs = put_u64(xs, va)
  xs = put_u64(xs, filesz)
  xs = put_u64(xs, memsz)
  xs = put_u64(xs, 4096)
  give xs
}

// ---- the image ------------------------------------------------------------

make link_image(code: list, data: list, patch: list, npc: num) -> list {
  hold base = 4194304
  hold cn = len(code)
  hold dn = len(data)
  // Page 0 holds the headers and is mapped read-only. The code segment starts
  // on page 1 and spans whole pages, because the kernel refuses to map a
  // partial-page RX segment. The data segment follows it, and the file is
  // padded out to a page so the heap chunk that starts there is page-aligned.
  hold code_off = 4096
  hold code_len = round_page(cn)
  hold data_off = code_off + code_len
  hold data_va = base + data_off
  hold img = elf_header(base + code_off)
  img = program_header(img, 4, 0, base, code_off, code_off)
  img = program_header(img, 5, code_off, base + code_off, code_len, code_len)
  img = program_header(img, 6, data_off, data_va, dn, dn)
  // The C writer mallocs the whole image and memsets it, so the rest of page 0
  // is zero by construction; a buffer built by appending has to say so, and
  // without it the code segment lands at 232 instead of at 4096.
  img = put_zeros(img, code_off - len(img))
  img = put_bytes(img, code, 0, cn)
  img = put_zeros(img, code_len - cn)
  img = put_bytes(img, data, 0, dn)
  // The file is padded out to a page so the heap chunk that starts there is
  // page-aligned. Every fixup below is an indexed write, so the image has to be
  // grown to its final size first -- the C writer patches a fully-sized image
  // too, and this is the same order.
  img = put_zeros(img, page_pad(data_off + dn))
  // The collector's bump cursor starts one page past the end of the data
  // segment and the chunk list starts empty; both words live in the data
  // segment itself (OFF_CUR = 0, OFF_END = 24).
  hold cur = base + round_page(data_off + dn)
  img[ data_off ] = bit_and(cur, 255)
  img[ data_off + 1 ] = bit_and(shr(cur, 8), 255)
  img[ data_off + 2 ] = bit_and(shr(cur, 16), 255)
  img[ data_off + 3 ] = bit_and(shr(cur, 24), 255)
  img[ data_off + 4 ] = 0
  img[ data_off + 5 ] = 0
  img[ data_off + 6 ] = 0
  img[ data_off + 7 ] = 0
  hold e = 24
  while e < 32 {
    img[ data_off + e ] = 0
    e = e + 1
  }
  // rel32 fixups: every call site and every `lea r12,[rip+disp32]`. A record
  // holds the site and its resolved target, both offsets inside the image, so
  // the displacement is target - (site + 4) and the code segment's file offset
  // cancels out of it.
  hold np = len(patch) / 16
  when npc > np {
    hold stop = fail(1, "meta.txt claims more call patches than patch.bin holds")
  }
  hold i = 0
  while i < np {
    hold at = le64_at(patch, i * 16)
    hold to = le64_at(patch, i * 16 + 8)
    when at + 4 > cn {
      hold stop = fail(1, "a patch site is outside the code segment")
    }
    hold d = to - (at + 4)
    when d < 0 - 2147483648 || d > 2147483647 {
      hold stop = fail(1, "a rel32 displacement does not fit in 32 bits")
    }
    hold u = d
    when u < 0 {
      u = u + 4294967296
    }
    hold site = code_off + at
    img[ site ] = bit_and(u, 255)
    img[ site + 1 ] = bit_and(shr(u, 8), 255)
    img[ site + 2 ] = bit_and(shr(u, 16), 255)
    img[ site + 3 ] = bit_and(shr(u, 24), 255)
    i = i + 1
  }
  give img
}

