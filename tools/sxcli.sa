// tools/sxcli.sa -- project scaffolding and a project test runner
// (2026-11-10).
//
//   sxcli new DIR [NAME]        scaffold a project that runs as-is
//   sxcli test [DIR]            compile and run every test file in a project
//   sxcli help                  this list
//
// Every project is a small tree with one file that is the program and one
// directory that holds tests:
//
//   DIR/Sayanox.toml            package name and version
//   DIR/main.sa                 the program (`sx build DIR/main.sa DIR/main`)
//   DIR/tests/*.sa              tests, one per file, each printing its own output
//   DIR/README.md               how to build and test it
//
// `sxcli test` compiles each test file with the project's compiler and runs it,
// then reports a count. A test passes when it compiles, builds and exits 0; its
// stdout is shown so a human can see what it printed. This is deliberately not a
// framework: it has no expectations, no matchers and no runner API, because any
// such API would be a new language feature (a test would have to fail from
// inside). A test that wants to fail simply exits non-zero.
//
// Design notes worth keeping:
//
//   * The scaffold is generated by `pp_*` functions that are pure string
//     builders, so a gate can check the generated text without writing a file.
//   * Nothing here parses Sayanox. Test discovery lists a directory and keeps
//     `*.sa`, which is the same rule the rest of the repository uses.
//   * Every refusal says which path or which stage failed, because the caller is
//     usually a person at a terminal.

make cl_nl() -> str {
  give chr(10)
}

make cl_say(s: str) -> num {
  hold w = write_out(s)
  hold n = write_out(cl_nl())
  hold f = flush_out()
  give 0
}

make cl_err(s: str) -> num {
  hold w = write_file("/dev/stderr", concat(s, cl_nl()))
  give 0
}

make cl_slice(s: str, a: num, b: num) -> str {
  hold n = len(s)
  hold lo = a
  when lo < 0 {
    lo = 0
  }
  hold hi = b
  when hi > n {
    hi = n
  }
  when lo >= hi {
    give ""
  }
  hold out = ""
  hold i = lo
  while i < hi {
    out = concat(out, chr(sx_index(s, i)))
    i = i + 1
  }
  give out
}

make cl_starts(s: str, p: str) -> num {
  when len(p) > len(s) {
    give 0
  }
  hold i = 0
  while i < len(p) {
    when sx_index(s, i) != sx_index(p, i) {
      give 0
    }
    i = i + 1
  }
  give 1
}

make cl_ends(s: str, p: str) -> num {
  when len(p) > len(s) {
    give 0
  }
  hold off = len(s) - len(p)
  hold i = 0
  while i < len(p) {
    when sx_index(s, off + i) != sx_index(p, i) {
      give 0
    }
    i = i + 1
  }
  give 1
}

// ---------------------------------------------------------------------------
// Scaffold text
// ---------------------------------------------------------------------------

make pp_manifest(name: str) -> str {
  hold m = "[package]"
  m = concat(m, concat(cl_nl(), concat("name = \"", name)))
  m = concat(m, concat("\"", cl_nl()))
  m = concat(m, concat("version = \"0.1.0\"", cl_nl()))
  m = concat(m, concat(cl_nl(), "[deps]"))
  m = concat(m, cl_nl())
  give m
}

make pp_main(name: str) -> str {
  hold p = concat("// ", concat(name, ": program entry point."))
  p = concat(p, cl_nl())
  p = concat(p, "// Build: sx build main.sa main    Run: ./main")
  p = concat(p, cl_nl())
  p = concat(p, cl_nl())
  p = concat(p, concat("make greet(who: str) -> str {", cl_nl()))
  p = concat(p, concat("  give concat(\"hello, \", who)", cl_nl()))
  p = concat(p, concat("}", cl_nl()))
  p = concat(p, cl_nl())
  p = concat(p, concat("show greet(\"", name))
  p = concat(p, concat("\")", cl_nl()))
  give p
}

// A generated test compiles, builds and exits 0 to pass. The `when` is there so
// the template shows the failing shape too: change the comparison and the test
// exits 1, which sxcli reports as FAIL.
make pp_test(name: str) -> str {
  hold t = concat("// test: ", name)
  t = concat(t, " basic check. A test passes when it compiles, builds and exits 0.")
  t = concat(t, cl_nl())
  t = concat(t, "// Run all tests with: sxcli test")
  t = concat(t, cl_nl())
  t = concat(t, cl_nl())
  t = concat(t, concat("when 2 + 2 != 4 {", cl_nl()))
  t = concat(t, concat("  show \"", name))
  t = concat(t, concat(": arithmetic is broken\"", cl_nl()))
  t = concat(t, concat("  hold bad = exit(1)", cl_nl()))
  t = concat(t, concat("}", cl_nl()))
  t = concat(t, cl_nl())
  t = concat(t, concat("show \"", name))
  t = concat(t, ": ok\"")
  t = concat(t, cl_nl())
  give t
}

make pp_readme(name: str) -> str {
  hold r = concat("# ", name)
  r = concat(r, cl_nl())
  r = concat(r, cl_nl())
  r = concat(r, "Build the program:")
  r = concat(r, cl_nl())
  r = concat(r, cl_nl())
  r = concat(r, "    sx build main.sa main")
  r = concat(r, "  ")
  r = concat(r, "   # or: sxcli test to run the tests")
  r = concat(r, cl_nl())
  r = concat(r, cl_nl())
  r = concat(r, "Run the tests:")
  r = concat(r, cl_nl())
  r = concat(r, cl_nl())
  r = concat(r, "    sxcli test .")
  r = concat(r, cl_nl())
  give r
}

// ---------------------------------------------------------------------------
// Project checks, usable without touching the filesystem
// ---------------------------------------------------------------------------

// A project is a directory that holds a manifest and a main source. This is the
// one place that decides what "is a project" means, so `new` and `test` cannot
// disagree about it.
make pp_is_project(dir: str) -> num {
  when path_kind(concat(dir, "/Sayanox.toml")) != 1 {
    give 0
  }
  when path_kind(concat(dir, "/main.sa")) != 1 {
    give 0
  }
  give 1
}

// 1 when `file` is a Sayanox test source: it ends in `.sa` and lives in the
// project's tests directory.
make pp_is_test(file: str) -> num {
  when cl_ends(file, ".sa") != 1 {
    give 0
  }
  give 1
}

// Does `text` contain `needle`? A local scan so this file does not depend on a
// helper it does not own.
make pp_has(text: str, needle: str) -> num {
  hold n = len(text)
  hold m = len(needle)
  hold i = 0
  while i + m <= n {
    hold k = 0
    hold same = 1
    while k < m && same == 1 {
      when sx_index(text, i + k) != sx_index(needle, k) {
        same = 0
      }
      k = k + 1
    }
    when same == 1 {
      give 1
    }
    i = i + 1
  }
  give 0
}

// The frontend's own one-line refusal out of an emitted source, or "" when there
// is none. A compiler refusal is written as `#error` on its own line, so the line
// after the marker is the message worth showing.
make pp_error_line(text: str) -> str {
  hold at = pp_find(text, "#error")
  when at < 0 {
    give ""
  }
  hold start = at + 6
  while start < len(text) && sx_index(text, start) == 32 {
    start = start + 1
  }
  hold end = start
  while end < len(text) && sx_index(text, end) != 10 {
    end = end + 1
  }
  give cl_slice(text, start, end)
}

make pp_find(text: str, needle: str) -> num {
  hold n = len(text)
  hold m = len(needle)
  hold i = 0
  while i + m <= n {
    hold k = 0
    hold same = 1
    while k < m && same == 1 {
      when sx_index(text, i + k) != sx_index(needle, k) {
        same = 0
      }
      k = k + 1
    }
    when same == 1 {
      give i
    }
    i = i + 1
  }
  give 0 - 1
}

// The name a manifest declares, or "" when there is no name line. This is a
// line scan, not a TOML parser, and it says so.
make pp_manifest_name(text: str) -> str {
  hold n = len(text)
  hold pos = 0
  while pos < n {
    hold end = pos
    while end < n && sx_index(text, end) != 10 {
      end = end + 1
    }
    hold row = cl_slice(text, pos, end)
    when cl_starts(row, "name = ") == 1 {
      hold v = cl_slice(row, 7, len(row))
      when len(v) >= 2 && sx_index(v, 0) == 34 && sx_index(v, len(v) - 1) == 34 {
        give cl_slice(v, 1, len(v) - 1)
      }
      give v
    }
    pos = end + 1
  }
  give ""
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

make cl_usage() -> num {
  hold u = "usage: sxcli new DIR [NAME] | sxcli test [DIR] | sxcli help"
  hold w = write_file("/dev/stderr", concat(u, cl_nl()))
  hold stop = exit(2)
  give 0
}

// `new` writes the four scaffold files. It refuses an existing project so a
// typo cannot overwrite a tree someone is working in.
make cl_new(dir: str, name: str) -> num {
  when path_kind(dir) == 2 {
    when pp_is_project(dir) == 1 {
      hold e = cl_err(concat("sxcli: ", concat(dir, " is already a project")))
      hold stop = exit(1)
    }
  }
  when path_kind(dir) != 2 {
    hold made = make_dir(dir)
  }
  when path_kind(dir) != 2 {
    hold e = cl_err(concat("sxcli: cannot create ", dir))
    hold stop = exit(1)
  }
  hold tests = concat(dir, "/tests")
  when path_kind(tests) != 2 {
    hold made_tests = make_dir(tests)
  }
  hold w1 = write_file(concat(dir, "/Sayanox.toml"), pp_manifest(name))
  hold w2 = write_file(concat(dir, "/main.sa"), pp_main(name))
  hold w3 = write_file(concat(dir, "/README.md"), pp_readme(name))
  hold w4 = write_file(concat(tests, "/basic.sa"), pp_test(name))
  hold s1 = cl_say(concat("sxcli: created ", concat(dir, "/")))
  hold s2 = cl_say("  Sayanox.toml  main.sa  README.md  tests/basic.sa")
  hold s3 = cl_say(concat("  next: sx build ", concat(dir, concat("/main.sa ", concat(dir, "/main")))))
  give 0
}

// Compile and run one test file. Gives 1 on pass, 0 on any failure, and says
// which stage failed so a broken test is not just a number.
make cl_run_test(compiler: str, dir: str, file: str) -> num {
  hold stem = cl_slice(file, 0, len(file) - 3)
  hold bin = concat(concat(dir, "/.sxcli/"), stem)
  when path_kind(concat(dir, "/.sxcli")) != 2 {
    hold made = make_dir(concat(dir, "/.sxcli"))
  }
  hold src = concat(concat(dir, "/tests/"), file)
  hold cfile = concat(bin, ".c")
  hold elog = concat(bin, ".emit.log")
  hold build = concat(compiler, concat(" ", concat(src, concat(" ", concat(cfile, concat(" 2>", elog))))))
  when run_command(build) != 0 {
    hold d = read_file(elog)
    hold e = cl_err(concat("FAIL ", concat(file, ": does not compile")))
    when len(d) > 0 {
      hold d2 = cl_err(d)
    }
    give 0
  }
  // A frontend refusal is not always an exit status: `gen2` writes a source
  // containing `#error` and succeeds, so the refusal only shows up when the C
  // compiler reads it. Detect that here and report it as the compile failure it
  // is, with the frontend's own message, instead of blaming the C stage.
  hold emitted = read_file(cfile)
  when pp_has(emitted, "#error") == 1 {
    hold e = cl_err(concat("FAIL ", concat(file, ": does not compile")))
    hold d = pp_error_line(emitted)
    when len(d) > 0 {
      hold d2 = cl_err(d)
    }
    give 0
  }
  hold cc = "cc -std=gnu11 -O2 -o "
  cc = concat(cc, concat(bin, concat(" ", cfile)))
  cc = concat(cc, concat(" -lm 2>", concat(bin, ".cc.log")))
  when run_command(cc) != 0 {
    hold d = read_file(concat(bin, ".cc.log"))
    hold e = cl_err(concat("FAIL ", concat(file, ": generated C did not build")))
    when len(d) > 0 {
      hold d2 = cl_err(d)
    }
    give 0
  }
  hold out = concat(bin, ".out")
  hold code = run_command(concat(bin, concat(" > ", out)))
  hold said = read_file(out)
  when len(said) > 0 {
    hold w = write_out(said)
    hold f = flush_out()
  }
  when code != 0 {
    hold e = cl_err(concat("FAIL ", concat(file, concat(": exit ", numstr(code)))))
    give 0
  }
  hold s = cl_say(concat("PASS ", file))
  give 1
}

// Run every test in the project. Discovery is a directory listing plus the
// `.sa` rule, in name order as read_dir gives it, and the count is printed
// either way so a project with no tests is visibly empty rather than silently
// green.
make cl_test(dir: str) -> num {
  when pp_is_project(dir) != 1 {
    hold e = cl_err(concat("sxcli: no project at ", dir))
    hold e2 = cl_err("  (expected Sayanox.toml and main.sa; run `sxcli new DIR` first)")
    hold stop = exit(1)
  }
  hold name = pp_manifest_name(read_file(concat(dir, "/Sayanox.toml")))
  when len(name) == 0 {
    name = dir
  }
  hold compiler = "./selfhost/gen2"
  when path_kind(compiler) != 1 {
    compiler = getenv("SX")
  }
  when path_kind(compiler) != 1 {
    hold e = cl_err("sxcli: no compiler; build it with `sx target gen2` or set SX")
    hold stop = exit(1)
  }
  hold tests = concat(dir, "/tests")
  when path_kind(tests) != 2 {
    hold s = cl_say(concat(name, ": 0 tests, 0 passed (no tests directory)"))
    give 0
  }
  hold names = read_dir(tests)
  hold pos = 0
  hold total = 0
  hold passed = 0
  while pos < len(names) {
    hold start = pos
    while pos < len(names) && sx_index(names, pos) != 10 {
      pos = pos + 1
    }
    hold entry = cl_slice(names, start, pos)
    pos = pos + 1
    when len(entry) > 0 && pp_is_test(entry) == 1 {
      total = total + 1
      hold ok = cl_run_test(compiler, dir, entry)
      when ok == 1 {
        passed = passed + 1
      }
    }
  }
  hold line = concat(name, concat(": ", concat(numstr(total), concat(" tests, ", concat(numstr(passed), " passed")))))
  hold s = cl_say(line)
  when passed < total {
    hold stop = exit(1)
  }
  give 0
}

make cl_main() -> num {
  hold cmd = ""
  when arg_count() > 1 {
    cmd = arg(1)
  }
  when string_eq(cmd, "help") == 1 || len(cmd) == 0 {
    hold h = cl_say("sxcli new DIR [NAME]   scaffold a project")
    hold h2 = cl_say("sxcli test [DIR]       compile and run the project's tests")
    hold h3 = cl_say("sxcli help             this list")
    give 0
  }
  when string_eq(cmd, "new") == 1 {
    when arg_count() < 3 {
      hold u = cl_usage()
      give 2
    }
    hold dir = arg(2)
    hold name = "app"
    when arg_count() > 3 {
      name = arg(3)
    }
    hold made = cl_new(dir, name)
    give 0
  }
  when string_eq(cmd, "test") == 1 {
    hold dir = "."
    when arg_count() > 2 {
      dir = arg(2)
    }
    hold ran = cl_test(dir)
    give 0
  }
  hold u = cl_usage()
  give 2
}

hold done = cl_main()
hold stop = exit(0)
