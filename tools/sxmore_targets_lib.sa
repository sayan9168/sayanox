// Names and dependency declarations only; no shell recipes.
make mp_name(index: num) -> str {
  when index == 0 { give "test-push-stmt" }
  when index == 1 { give "test-stage2-demos" }
  when index == 2 { give "test-native-lang" }
  when index == 3 { give "test-native-locals" }
  when index == 4 { give "test-typed-sig" }
  when index == 5 { give "test-list-expr" }
  when index == 6 { give "test-native-strfn" }
  when index == 7 { give "test-native-strgen" }
  when index == 8 { give "test-native-listgen" }
  when index == 9 { give "test-logic-value" }
  when index == 10 { give "test-native-generics" }
  when index == 11 { give "test-native-cond" }
  when index == 12 { give "test-proc-builtins" }
  when index == 13 { give "test-comment-quotes" }
  when index == 14 { give "test-for-paren" }
  when index == 15 { give "test-gen2-index-mod" }
  when index == 16 { give "test-gen2-expr-lowering" }
  when index == 17 { give "test-parity" }
  when index == 18 { give "test-boot" }
  when index == 19 { give "test-sxdiag" }
  when index == 20 { give "test-stdlib-interpolation" }
  when index == 21 { give "test-seed-stage2" }
  when index == 22 { give "test-pkg-errors" }
  when index == 23 { give "test-seed-assignment" }
  when index == 24 { give "test-seed-hold-types" }
  when index == 25 { give "test-seed-for-literals" }
  when index == 26 { give "test-seed-for-untyped" }
  when index == 27 { give "test-seed-typed-functions" }
  when index == 28 { give "test-native-param-reassign" }
  when index == 29 { give "test-native-generic-local" }
  when index == 30 { give "test-gen2-forward" }
  when index == 31 { give "test-gen2-function-scope" }
  when index == 32 { give "test-gen2-boolean-args" }
  when index == 33 { give "test-gen2-generic-queue" }
  when index == 34 { give "test-gen2-list-return" }
  when index == 35 { give "test-gen2-list-args" }
  when index == 36 { give "test-gen2-gc-roots" }
  when index == 37 { give "test-gen2-list-arithmetic" }
  when index == 38 { give "test-return-paths" }
  when index == 39 { give "test-name-resolution" }
  when index == 40 { give "test-inline-expressions" }
  when index == 41 { give "test-list-postfix" }
  when index == 42 { give "test-seed-borrow" }
  when index == 43 { give "test-seed-collector" }
  when index == 44 { give "test-generic-struct-limits" }
  when index == 45 { give "test-stdlib-json-deep" }
  when index == 46 { give "test-stdlib-json-write" }
  when index == 47 { give "test-sxbuild" }
  give ""
}
make mp_count() -> num { give 48 }
make mp_known(name: str) -> num {
  hold i = 0
  while i < mp_count() {
    when string_eq(name, mp_name(i)) == 1 { give 1 }
    i = i + 1
  }
  give 0
}
