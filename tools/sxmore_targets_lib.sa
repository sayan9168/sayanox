make mp_tools(name: str) -> str {
  when string_eq(name, "test-typed-sig") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-sxdiag") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-pkg-errors") == 1 { give "sxpkg\n" }
  when string_eq(name, "test-return-paths") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-name-resolution") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-inline-expressions") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-list-postfix") == 1 { give "sxdiag\n" }
  when string_eq(name, "test-generic-struct-limits") == 1 { give "sxsuite\n" }
  when string_eq(name, "test-sxbuild") == 1 { give "sxbuild\n" }
