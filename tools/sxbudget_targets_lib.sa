// The @budget contract gate's target name. One name, registered in
// sxtargets_lib.sa's target_known()/cmd_target() and dispatched from sxgates.sa.
make xg_name(index: num) -> str {
  when index == 0 { give "test-fn-budget" }
  give ""
}
make xg_known(name: str) -> num {
  hold i = 0
  while i < 2 {
    when string_eq(name, xg_name(i)) == 1 { give 1 }
    i = i + 1
  }
  give 0
}
