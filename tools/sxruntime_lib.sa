make emit_rt_ext_proc(st: list) -> list {
  hold neg1 = 0 - 1
  hold d_empty = 1320

  // ---- r_readline (B_READLINE = 42) ----
  st = set_builtin(st, 42)
  hold Lrl_loop = L_new(st)
  hold Lrl_done = L_new(st)
  hold Lrl_alloc = L_new(st)
  hold Lrl_cpy = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = bin_imm32(st, 5, 4, 4112)
  st = xor_rr(st, 15, 15)
  st = L_bind(st, Lrl_loop)
  st = xor_rr(st, 7, 7)
  st = lea_rm(st, 6, 4, 15, 0, 0)
  st = mov_imm64(st, 2, 1)
  st = xor_rr(st, 0, 0)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 14, Lrl_done)
  st = mvz_rm(st, 0, 4, 15, 0, 0)
  st = bin_imm8(st, 7, 0, 10)
  st = J_cc(st, 4, Lrl_done)
  st = incdec_r(st, 1, 15)
  st = bin_imm32(st, 7, 15, 4094)
  st = J_cc(st, 12, Lrl_loop)
  st = L_bind(st, Lrl_done)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 4, Lrl_alloc)
  st = lea_rm(st, 1, 4, 15, 0, 0)
  st = bin_imm8(st, 5, 1, 1)
  st = mvz_rm(st, 0, 1, neg1, 0, 0)
  st = bin_imm8(st, 7, 0, 13)
  st = J_cc(st, 5, Lrl_alloc)
  st = bin_imm8(st, 5, 15, 1)
  st = L_bind(st, Lrl_alloc)
  st = xor_rr(st, 0, 0)
  st = lea_rm(st, 7, 4, 15, 0, 0)
  st = stal_rdi(st)
  st = lea_rm(st, 7, 15, neg1, 0, 1)
  st = xor_rr(st, 6, 6)
  st = callb(st, 0)
  st = mv_rr(st, 14, 0)
  st = xor_rr(st, 13, 13)
  st = L_bind(st, Lrl_cpy)
  st = mvz_rm(st, 0, 4, 13, 0, 0)
  st = lea_rm(st, 7, 14, 13, 0, 0)
  st = stal_rdi(st)
  st = incdec_r(st, 1, 13)
  st = bin_rr(st, 57, 13, 15)
  st = J_cc(st, 14, Lrl_cpy)
  st = mv_rr(st, 0, 14)
  st = bin_imm32(st, 0, 4, 4112)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_readn (B_READN = 43) ----
  st = set_builtin(st, 43)
  hold Lrn_loop = L_new(st)
  hold Lrn_done = L_new(st)
  hold Lrn_empty = L_new(st)
  hold Lrn_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = mv_rr(st, 13, 7)
  st = test_rr(st, 13, 13)
  st = J_cc(st, 14, Lrn_empty)
  st = lea_rm(st, 7, 13, neg1, 0, 1)
  st = xor_rr(st, 6, 6)
  st = callb(st, 0)
  st = mv_rr(st, 14, 0)
  st = xor_rr(st, 15, 15)
  st = L_bind(st, Lrn_loop)
  st = bin_rr(st, 57, 15, 13)
  st = J_cc(st, 13, Lrn_done)
  st = xor_rr(st, 7, 7)
  st = lea_rm(st, 6, 14, 15, 0, 0)
  st = mv_rr(st, 2, 13)
  st = bin_rr(st, 41, 2, 15)
  st = xor_rr(st, 0, 0)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 14, Lrn_done)
  st = bin_rr(st, 1, 15, 0)
  st = J_mp(st, Lrn_loop)
  st = L_bind(st, Lrn_done)
  st = xor_rr(st, 0, 0)
  st = lea_rm(st, 7, 14, 15, 0, 0)
  st = stal_rdi(st)
  st = mv_rr(st, 0, 14)
  st = J_mp(st, Lrn_ret)
  st = L_bind(st, Lrn_empty)
  st = lea_rm(st, 0, 12, neg1, 0, d_empty)
  st = L_bind(st, Lrn_ret)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_spawn (B_SPAWN = 44) ----
  st = set_builtin(st, 44)
  hold Lsp_scan = L_new(st)
  hold Lsp_found = L_new(st)
  hold Lsp_child = L_new(st)
  hold Lsp_cl2 = L_new(st)
  hold Lsp_cl1 = L_new(st)
  hold Lsp_zero = L_new(st)
  hold Lsp_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = bin_imm32(st, 5, 4, 64)
  st = mv_rr(st, 14, 7)
  // Ignore SIGPIPE (13) so writing to a closed child pipe returns -EPIPE
  st = mov_imm64(st, 0, 1)
  st = mv_m64(st, 4, neg1, 0, 16, 0)
  st = xor_rr(st, 0, 0)
  st = mv_m64(st, 4, neg1, 0, 24, 0)
  st = mv_m64(st, 4, neg1, 0, 32, 0)
  st = mv_m64(st, 4, neg1, 0, 40, 0)
  st = mov_imm64(st, 7, 13)
  st = lea_rm(st, 6, 4, neg1, 0, 16)
  st = xor_rr(st, 2, 2)
  st = mov_imm64(st, 10, 8)
  st = mov_imm64(st, 0, 13)
  st = syscall_inst(st)
  // Find free slot 0..7 in PROC_TBL_OFF (3912)
  st = xor_rr(st, 15, 15)
  st = L_bind(st, Lsp_scan)
  st = bin_imm8(st, 7, 15, 8)
  st = J_cc(st, 13, Lsp_zero)
  st = mv_rr(st, 1, 15)
  st = shl_imm(st, 1, 5)
  st = lea_rm(st, 13, 12, 1, 0, 3912)
  st = mv_r64m(st, 0, 13, neg1, 0, 0)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lsp_found)
  st = incdec_r(st, 1, 15)
  st = J_mp(st, Lsp_scan)
  st = L_bind(st, Lsp_found)
  // pipe(pin) at [rsp + 0]
  st = mv_rr(st, 7, 4)
  st = mov_imm64(st, 0, 22)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 8, Lsp_zero)
  // pipe(pout) at [rsp + 8]
  st = lea_rm(st, 7, 4, neg1, 0, 8)
  st = mov_imm64(st, 0, 22)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 8, Lsp_cl1)
  // fork()
  st = mov_imm64(st, 0, 57)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 8, Lsp_cl2)
  st = J_cc(st, 4, Lsp_child)
  // Parent: rbx = pid
  st = mv_rr(st, 3, 0)
  // close(pin[0]), close(pout[1]), store pin[1] & pout[0]
  st = mv_r64m(st, 0, 4, neg1, 0, 0)
  st = mv_rr(st, 7, 0)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = shr_imm(st, 0, 32)
  st = mv_m64(st, 13, neg1, 0, 16, 0)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_r64m(st, 0, 4, neg1, 0, 8)
  st = mv_rr(st, 1, 0)
  st = bin_imm32(st, 4, 1, 2147483647)
  st = mv_m64(st, 13, neg1, 0, 24, 1)
  st = mv_rr(st, 7, 0)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_m64(st, 13, neg1, 0, 8, 3)
  st = mov_imm64(st, 0, 1)
  st = mv_m64(st, 13, neg1, 0, 0, 0)
  st = lea_rm(st, 0, 15, neg1, 0, 1)
  st = J_mp(st, Lsp_ret)
  // Child: dup2(pin[0], 0), dup2(pout[1], 1), close all 4 fds, execve(path, [path, 0], envp)
  st = L_bind(st, Lsp_child)
  st = mv_r64m(st, 3, 4, neg1, 0, 0)
  st = mv_rr(st, 7, 3)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = xor_rr(st, 6, 6)
  st = mov_imm64(st, 0, 33)
  st = syscall_inst(st)
  st = mv_r64m(st, 15, 4, neg1, 0, 8)
  st = mv_rr(st, 7, 15)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 6, 1)
  st = mov_imm64(st, 0, 33)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 3)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 3)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 15)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 15)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_m64(st, 4, neg1, 0, 16, 14)
  st = xor_rr(st, 0, 0)
  st = mv_m64(st, 4, neg1, 0, 24, 0)
  st = mv_r64m(st, 2, 12, neg1, 0, 8)
  st = mv_r64m(st, 1, 12, neg1, 0, 16)
  st = lea_rm(st, 2, 2, 1, 3, 8)
  st = mv_rr(st, 7, 14)
  st = lea_rm(st, 6, 4, neg1, 0, 16)
  st = mov_imm64(st, 0, 59)
  st = syscall_inst(st)
  st = mov_imm64(st, 7, 127)
  st = mov_imm64(st, 0, 60)
  st = syscall_inst(st)
  // Error cleanup
  st = L_bind(st, Lsp_cl2)
  st = mv_r64m(st, 3, 4, neg1, 0, 8)
  st = mv_rr(st, 7, 3)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 3)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = L_bind(st, Lsp_cl1)
  st = mv_r64m(st, 3, 4, neg1, 0, 0)
  st = mv_rr(st, 7, 3)
  st = bin_imm32(st, 4, 7, 2147483647)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = mv_rr(st, 7, 3)
  st = shr_imm(st, 7, 32)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = L_bind(st, Lsp_zero)
  st = xor_rr(st, 0, 0)
  st = L_bind(st, Lsp_ret)
  st = bin_imm32(st, 0, 4, 64)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_childsend (B_CHILDSEND = 45) ----
  st = set_builtin(st, 45)
  hold Lcs_loop = L_new(st)
  hold Lcs_ok = L_new(st)
  hold Lcs_bad = L_new(st)
  hold Lcs_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = mv_rr(st, 14, 6)
  st = bin_imm8(st, 7, 7, 1)
  st = J_cc(st, 12, Lcs_bad)
  st = bin_imm8(st, 7, 7, 8)
  st = J_cc(st, 15, Lcs_bad)
  st = bin_imm8(st, 5, 7, 1)
  st = shl_imm(st, 7, 5)
  st = lea_rm(st, 13, 12, 7, 0, 3912)
  st = mv_r64m(st, 0, 13, neg1, 0, 0)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lcs_bad)
  st = mv_r64m(st, 3, 13, neg1, 0, 16)
  st = mv_rr(st, 0, 14)
  st = callb(st, 1)
  st = mv_rr(st, 15, 0)
  st = L_bind(st, Lcs_loop)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 14, Lcs_ok)
  st = mv_rr(st, 7, 3)
  st = mv_rr(st, 6, 14)
  st = mv_rr(st, 2, 15)
  st = mov_imm64(st, 0, 1)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 14, Lcs_bad)
  st = bin_rr(st, 1, 14, 0)
  st = bin_rr(st, 41, 15, 0)
  st = J_mp(st, Lcs_loop)
  st = L_bind(st, Lcs_ok)
  st = mov_imm64(st, 0, 1)
  st = J_mp(st, Lcs_ret)
  st = L_bind(st, Lcs_bad)
  st = xor_rr(st, 0, 0)
  st = L_bind(st, Lcs_ret)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_childrecv (B_CHILDRECV = 46) ----
  st = set_builtin(st, 46)
  hold Lcr_loop = L_new(st)
  hold Lcr_done = L_new(st)
  hold Lcr_empty = L_new(st)
  hold Lcr_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = mv_rr(st, 13, 6)
  st = test_rr(st, 13, 13)
  st = J_cc(st, 14, Lcr_empty)
  st = bin_imm8(st, 7, 7, 1)
  st = J_cc(st, 12, Lcr_empty)
  st = bin_imm8(st, 7, 7, 8)
  st = J_cc(st, 15, Lcr_empty)
  st = bin_imm8(st, 5, 7, 1)
  st = shl_imm(st, 7, 5)
  st = lea_rm(st, 1, 12, 7, 0, 3912)
  st = mv_r64m(st, 0, 1, neg1, 0, 0)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lcr_empty)
  st = mv_r64m(st, 3, 1, neg1, 0, 24)
  st = lea_rm(st, 7, 13, neg1, 0, 1)
  st = xor_rr(st, 6, 6)
  st = callb(st, 0)
  st = mv_rr(st, 14, 0)
  st = xor_rr(st, 15, 15)
  st = L_bind(st, Lcr_loop)
  st = bin_rr(st, 57, 15, 13)
  st = J_cc(st, 13, Lcr_done)
  st = mv_rr(st, 7, 3)
  st = lea_rm(st, 6, 14, 15, 0, 0)
  st = mv_rr(st, 2, 13)
  st = bin_rr(st, 41, 2, 15)
  st = xor_rr(st, 0, 0)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 14, Lcr_done)
  st = bin_rr(st, 1, 15, 0)
  st = J_mp(st, Lcr_loop)
  st = L_bind(st, Lcr_done)
  st = xor_rr(st, 0, 0)
  st = lea_rm(st, 7, 14, 15, 0, 0)
  st = stal_rdi(st)
  st = mv_rr(st, 0, 14)
  st = J_mp(st, Lcr_ret)
  st = L_bind(st, Lcr_empty)
  st = lea_rm(st, 0, 12, neg1, 0, d_empty)
  st = L_bind(st, Lcr_ret)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_childline (B_CHILDLINE = 47) ----
  st = set_builtin(st, 47)
  hold Lcl_loop = L_new(st)
  hold Lcl_done = L_new(st)
  hold Lcl_alloc = L_new(st)
  hold Lcl_cpy = L_new(st)
  hold Lcl_empty = L_new(st)
  hold Lcl_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = bin_imm32(st, 5, 4, 4112)
  st = bin_imm8(st, 7, 7, 1)
  st = J_cc(st, 12, Lcl_empty)
  st = bin_imm8(st, 7, 7, 8)
  st = J_cc(st, 15, Lcl_empty)
  st = bin_imm8(st, 5, 7, 1)
  st = shl_imm(st, 7, 5)
  st = lea_rm(st, 13, 12, 7, 0, 3912)
  st = mv_r64m(st, 0, 13, neg1, 0, 0)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lcl_empty)
  st = mv_r64m(st, 3, 13, neg1, 0, 24)
  st = xor_rr(st, 15, 15)
  st = L_bind(st, Lcl_loop)
  st = mv_rr(st, 7, 3)
  st = lea_rm(st, 6, 4, 15, 0, 0)
  st = mov_imm64(st, 2, 1)
  st = xor_rr(st, 0, 0)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 14, Lcl_done)
  st = mvz_rm(st, 0, 4, 15, 0, 0)
  st = bin_imm8(st, 7, 0, 10)
  st = J_cc(st, 4, Lcl_done)
  st = incdec_r(st, 1, 15)
  st = bin_imm32(st, 7, 15, 4094)
  st = J_cc(st, 12, Lcl_loop)
  st = L_bind(st, Lcl_done)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 4, Lcl_alloc)
  st = lea_rm(st, 1, 4, 15, 0, 0)
  st = bin_imm8(st, 5, 1, 1)
  st = mvz_rm(st, 0, 1, neg1, 0, 0)
  st = bin_imm8(st, 7, 0, 13)
  st = J_cc(st, 5, Lcl_alloc)
  st = bin_imm8(st, 5, 15, 1)
  st = L_bind(st, Lcl_alloc)
  st = xor_rr(st, 0, 0)
  st = lea_rm(st, 7, 4, 15, 0, 0)
  st = stal_rdi(st)
  st = lea_rm(st, 7, 15, neg1, 0, 1)
  st = xor_rr(st, 6, 6)
  st = callb(st, 0)
  st = mv_rr(st, 14, 0)
  st = xor_rr(st, 13, 13)
  st = L_bind(st, Lcl_cpy)
  st = mvz_rm(st, 0, 4, 13, 0, 0)
  st = lea_rm(st, 7, 14, 13, 0, 0)
  st = stal_rdi(st)
  st = incdec_r(st, 1, 13)
  st = bin_rr(st, 57, 13, 15)
  st = J_cc(st, 14, Lcl_cpy)
  st = mv_rr(st, 0, 14)
  st = J_mp(st, Lcl_ret)
  st = L_bind(st, Lcl_empty)
  st = lea_rm(st, 0, 12, neg1, 0, d_empty)
  st = L_bind(st, Lcl_ret)
  st = bin_imm32(st, 0, 4, 4112)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_childclose (B_CHILDCLOSE = 48) ----
  st = set_builtin(st, 48)
  hold Lcc_wait = L_new(st)
  hold Lcc_eintr = L_new(st)
  hold Lcc_bad = L_new(st)
  hold Lcc_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = bin_imm32(st, 5, 4, 16)
  st = bin_imm8(st, 7, 7, 1)
  st = J_cc(st, 12, Lcc_bad)
  st = bin_imm8(st, 7, 7, 8)
  st = J_cc(st, 15, Lcc_bad)
  st = bin_imm8(st, 5, 7, 1)
  st = shl_imm(st, 7, 5)
  st = lea_rm(st, 13, 12, 7, 0, 3912)
  st = mv_r64m(st, 0, 13, neg1, 0, 0)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 4, Lcc_bad)
  // close(in_fd)
  st = mv_r64m(st, 7, 13, neg1, 0, 16)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  // wait4(pid, &status, 0, 0)
  st = mv_r64m(st, 3, 13, neg1, 0, 8)
  st = xor_rr(st, 0, 0)
  st = mv_m64(st, 4, neg1, 0, 0, 0)
  st = L_bind(st, Lcc_wait)
  st = mv_rr(st, 7, 3)
  st = mv_rr(st, 6, 4)
  st = xor_rr(st, 2, 2)
  st = xor_rr(st, 10, 10)
  st = mov_imm64(st, 0, 61)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 8, Lcc_eintr)
  // close(out_fd), mark slot dead
  st = mv_r64m(st, 7, 13, neg1, 0, 24)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = xor_rr(st, 0, 0)
  st = mv_m64(st, 13, neg1, 0, 0, 0)
  // decode status
  st = mv_r64m(st, 0, 4, neg1, 0, 0)
  st = mv_rr(st, 2, 0)
  st = bin_imm8(st, 4, 2, 127)
  st = test_rr(st, 2, 2)
  st = J_cc(st, 5, Lcc_bad)
  st = shr_imm(st, 0, 8)
  st = bin_imm32(st, 4, 0, 255)
  st = J_mp(st, Lcc_ret)
  st = L_bind(st, Lcc_eintr)
  st = bin_imm8(st, 7, 0, 252)
  st = J_cc(st, 4, Lcc_wait)
  st = mv_r64m(st, 7, 13, neg1, 0, 24)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = xor_rr(st, 0, 0)
  st = mv_m64(st, 13, neg1, 0, 0, 0)
  st = L_bind(st, Lcc_bad)
  st = mov_imm64_hl(st, 0, 0 - 1, 0 - 1)
  st = L_bind(st, Lcc_ret)
  st = bin_imm32(st, 0, 4, 16)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)

  // ---- r_pathreal (B_PATHREAL = 49) ----
  st = set_builtin(st, 49)
  hold Lpr_dcpy = L_new(st)
  hold Lpr_cpy = L_new(st)
  hold Lpr_empty = L_new(st)
  hold Lpr_ret = L_new(st)
  st = push_r(st, 12)
  st = push_r(st, 3)
  st = push_r(st, 13)
  st = push_r(st, 14)
  st = push_r(st, 15)
  st = bin_imm32(st, 5, 4, 4144)
  // open(path, O_PATH = 0x200000, 0)
  st = mov_imm64(st, 6, 2097152)
  st = xor_rr(st, 2, 2)
  st = mov_imm64(st, 0, 2)
  st = syscall_inst(st)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 8, Lpr_empty)
  st = mv_rr(st, 3, 0)
  // build "/proc/self/fd/" + digits(fd) at [rsp + 4096]
  st = mov_imm64_hl(st, 0, 1702047587, 1869770799)
  st = mv_m64(st, 4, neg1, 0, 4096, 0)
  st = mov_imm64_hl(st, 0, 12132, 1714382444)
  st = mv_m64(st, 4, neg1, 0, 4104, 0)
  st = lea_rm(st, 6, 4, neg1, 0, 4135)
  st = xor_rr(st, 0, 0)
  st = mv_rr(st, 7, 6)
  st = stal_rdi(st)
  st = mv_rr(st, 1, 3)
  st = xor_rr(st, 8, 8)
  st = emit_digs(st)
  st = lea_rm(st, 13, 4, neg1, 0, 4110)
  st = L_bind(st, Lpr_dcpy)
  st = mvz_rm(st, 0, 6, neg1, 0, 0)
  st = mv_rr(st, 7, 13)
  st = stal_rdi(st)
  st = incdec_r(st, 1, 6)
  st = incdec_r(st, 1, 13)
  st = test_rr(st, 0, 0)
  st = J_cc(st, 5, Lpr_dcpy)
  // readlink("/proc/self/fd/<fd>", rsp, 4095)
  st = lea_rm(st, 7, 4, neg1, 0, 4096)
  st = mv_rr(st, 6, 4)
  st = mov_imm64(st, 2, 4095)
  st = mov_imm64(st, 0, 89)
  st = syscall_inst(st)
  st = mv_rr(st, 15, 0)
  // close(fd)
  st = mv_rr(st, 7, 3)
  st = mov_imm64(st, 0, 3)
  st = syscall_inst(st)
  st = test_rr(st, 15, 15)
  st = J_cc(st, 14, Lpr_empty)
  st = xor_rr(st, 0, 0)
  st = lea_rm(st, 7, 4, 15, 0, 0)
  st = stal_rdi(st)
  st = lea_rm(st, 7, 15, neg1, 0, 1)
  st = xor_rr(st, 6, 6)
  st = callb(st, 0)
  st = mv_rr(st, 14, 0)
  st = xor_rr(st, 13, 13)
  st = L_bind(st, Lpr_cpy)
  st = mvz_rm(st, 0, 4, 13, 0, 0)
  st = lea_rm(st, 7, 14, 13, 0, 0)
  st = stal_rdi(st)
  st = incdec_r(st, 1, 13)
  st = bin_rr(st, 57, 13, 15)
  st = J_cc(st, 14, Lpr_cpy)
  st = mv_rr(st, 0, 14)
  st = J_mp(st, Lpr_ret)
  st = L_bind(st, Lpr_empty)
  st = lea_rm(st, 0, 12, neg1, 0, d_empty)
  st = L_bind(st, Lpr_ret)
  st = bin_imm32(st, 0, 4, 4144)
  st = pop_r(st, 15)
  st = pop_r(st, 14)
  st = pop_r(st, 13)
  st = pop_r(st, 3)
  st = pop_r(st, 12)
  st = ret_inst(st)
  st = reset_labels(st)
  give st
}

make emit_gc_full_ext(st: list) -> list {
  hold neg1 = 0 - 1
  hold orig_collect = st[33]
  st = set_builtin(st, 23)
  hold Lx_loop = L_new(st)
  hold Lx_done = L_new(st)
  st = push_r(st, 13)
  st = push_r(st, 7)
  st = lea_rm(st, 13, 12, neg1, 0, 20552)
  st = L_bind(st, Lx_loop)
  st = mv_r64m(st, 7, 13, neg1, 0, 0)
  st = test_rr(st, 7, 7)
  st = J_cc(st, 4, Lx_done)
  st = bin_rr(st, 1, 7, 12)
  st = mv_r64m(st, 7, 7, neg1, 0, 0)
  st = callb(st, 27)
  st = bin_imm8(st, 0, 13, 8)
  st = J_mp(st, Lx_loop)
  st = L_bind(st, Lx_done)
  st = pop_r(st, 7)
  st = pop_r(st, 13)
  st = jmp_rel32(st, orig_collect - here_local(st) - 5)
  st = reset_labels(st)
  give st
}

make emit_builtins_full_ext(st: list) -> list {
  st = emit_rt_ext_list_io(st)
  st = emit_rt_ext_os(st)
  st = emit_rt_ext_proc(st)
  give st
}
