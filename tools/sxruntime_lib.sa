// ---- small loop helpers in phase 4 ----------------------------------------

make emit_list_resolve(st: list, ptr: num, tmp: num) -> list {
  hold neg1 = 0 - 1
  hold again = here_local(st)
  st = mv_r64m(st, tmp, ptr, neg1, 0, 8)
  st = test_rr(st, tmp, tmp)
  hold done = here_local(st)
  st = jcc_rel32(st, 4, 0)
  st = mv_rr(st, ptr, tmp)
  st = jmp_rel32(st, again - here_local(st) - 5)
  st = erel32(st, done, here_local(st))
  give st
}

make emit_cpybyte_r10(st: list) -> list {
  hold neg1 = 0 - 1
  hold L = here_local(st)
  st = test_rr(st, 2, 2)
  hold jz = here_local(st)
  st = jcc_rel32(st, 4, 0)
  st = mvz_rm(st, 0, 6, 10, 0, neg1)
  st = rexb(st, 0, 0, 0, 1)
  st = e1(st, 136)
  st = emit_modrm(st, 0, 8, 0, 1, neg1)
  st = incdec_r(st, 1, 1)
  st = incdec_r(st, 1, 10)
  st = bin_imm8(st, 5, 2, 1)
  st = jmp_rel32(st, L - here_local(st) - 5)
  st = erel32(st, jz, here_local(st))
  give st
}

make emit_digs(st: list) -> list {
  st = test_rr(st, 1, 1)
  hold jns = here_local(st)
  st = jcc_rel32(st, 9, 0)
  st = mov_imm64(st, 8, 1)
  st = fm7(st, 3, 1)
  st = erel32(st, jns, here_local(st))
  st = test_rr(st, 1, 1)
  hold jnz = here_local(st)
  st = jcc_rel32(st, 5, 0)
  st = bin_imm8(st, 5, 6, 1)
  st = e1(st, 198)
  st = e1(st, 6)
  st = e1(st, 48)
  hold jmpsign = here_local(st)
  st = e1(st, 233)
  st = e32(st, 0)
  hold dig = here_local(st)
  st = xor_rr(st, 2, 2)
  st = mv_rr(st, 0, 1)
  st = mov_imm64(st, 9, 10)
  st = fm7(st, 6, 9)
  st = mv_rr(st, 1, 0)
  st = bin_imm8(st, 0, 2, 48)
  st = bin_imm8(st, 5, 6, 1)
  st = e1(st, 136)
  st = e1(st, 22)
  st = test_rr(st, 1, 1)
  hold jnz2 = here_local(st)
  st = jcc_rel32(st, 5, 0)
  st = erel32(st, jnz2, dig)
  hold sign = here_local(st)
  st = erel32(st, jnz, dig)
  st = raw_patch32(st, jmpsign + 1, sign - (jmpsign + 5))
  st = test_rr(st, 8, 8)
  hold jz = here_local(st)
  st = jcc_rel32(st, 4, 0)
  st = bin_imm8(st, 5, 6, 1)
  st = e1(st, 198)
  st = e1(st, 6)
  st = e1(st, 45)
  st = erel32(st, jz, here_local(st))
  give st
}

