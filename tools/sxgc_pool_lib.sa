// Actual C-output collector cache probe; maintained in Sayanox.
make gpm_test(source: str) -> num {
  hold base = "selfhost/seed_tests/gc-pool"
  hold pre = "#include <stdlib.h>\n#include <assert.h>\nstatic void *pool_nodes[60]; static unsigned pool_freed[60]; static size_t pool_n;\nstatic void pool_free(void *p){\n  for(size_t i=0;i<pool_n;i++) if(pool_nodes[i]==p){ assert(!pool_freed[i]); pool_freed[i]++; }\n  free(p);\n}\n#define free pool_free\n#define main pool_original_main\n"
  hold body = "#undef main\n#undef free\nstatic int pool_probe(void){\n  sx_list *volatile live=sx_llit(2,7.0,9.0);\n  sx_list *volatile alias=live;\n  for(size_t c=0;c<15;c++) for(int j=0;j<4;j++){\n    sx_gcb *b=malloc(sx_gc_class_size(c)); assert(b);\n    pool_nodes[pool_n++]=b; b->cls=c; b->next=sx_gfree[c]; sx_gfree[c]=b;\n  }\n  sx_gc_collect(); /* Must invoke trimming after the sweep. */\n  size_t freed=0;\n  for(size_t i=0;i<pool_n;i++) freed+=pool_freed[i];\n  assert(freed==36);\n  for(size_t c=0;c<15;c++){\n    size_t n=0; for(sx_gcb *b=sx_gfree[c];b;b=b->next) n++;\n    assert(n==(c<12?2:0));\n  }\n  sx_gc_trim_free();\n  size_t again=0; for(size_t i=0;i<pool_n;i++) again+=pool_freed[i];\n  assert(again==freed);\n  /* Do not mistake later allocator address reuse for a double free. */\n  pool_n=0;\n  char *volatile reused=sx_gc_alloc(0,16); strcpy(reused,\"warm\");\n  assert(sx_gc_hash_get((char*)reused));\n  sx_gc_collect();\n  assert(alias==live && live->n==2 && live->d[0]==7.0 && live->d[1]==9.0);\n  assert(strcmp((char*)reused,\"warm\")==0);\n  puts(\"gc-pool-ok: oversized blocks freed; small cache bounded; aliases and reuse intact\");\n  return 0;\n}\nint main(void){ char anchor; sx_gc_init(&anchor); int (*volatile run)(void)=pool_probe; return run(); }\n"
  hold written = gl_must_write(concat(base, ".c"), concat(pre, concat(read_file(source), body)))
  hold mode = 0
  while mode < 3 {
    hold flags = "-O0 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types"
    when mode == 1 { flags = "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types" }
    when mode == 2 { flags = "-O2 -g -fno-pie -no-pie -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all" }
    hold bin = concat(base, numstr(mode))
    hold built = gl_compile_c(concat(base, ".c"), bin, flags)
    hold cmd = concat("./", bin)
    when mode == 2 { cmd = concat("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ", cmd) }
    hold checked = gl_assert_out(cmd, "gc-pool-ok: oversized blocks freed; small cache bounded; aliases and reuse intact", concat(bin, ".out"))
    mode = mode + 1
  }
  show "[OK] C-output GC free-pool trimming: O0/O2/ASan+UBSan"
  give 0
}
