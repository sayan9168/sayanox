// Actual C-output collector cache probe; maintained in Sayanox.
// Preserve the exact failing probe/compiler diagnostic in the checks API.
make gpm_run(cmd: str, log: str, label: str) -> num {
  hold status = gl_run_merged(cmd, log)
  when status != 0 {
    hold detail = concat(label, concat(": ", read_file(log)))
    show detail
    when string_eq(getenv("GITHUB_ACTIONS"), "true") {
      hold escaped = ""
      hold i = 0
      while i < len(detail) && i < 6000 {
        hold c = sx_index(detail, i)
        when c == 37 { escaped = concat(escaped, "%25") } otherwise {
          when c == 10 { escaped = concat(escaped, "%0A") } otherwise {
            when c == 13 { escaped = concat(escaped, "%0D") } otherwise { escaped = concat(escaped, chr(c)) }
          }
        }
        i = i + 1
      }
      show concat("::error title=GC pool probe failure::", escaped)
    }
    give gl_fail(label)
  }
  give 0
}
make gpm_test(source: str) -> num {
  hold base = "selfhost/seed_tests/gc-pool"
  hold pre = "#include <stdlib.h>\n#include <assert.h>\n#include <stdint.h>\nstatic uintptr_t pool_nodes[60]; static size_t pool_classes[60]; static unsigned pool_freed[60]; static size_t pool_n;\nstatic void pool_free(void *p){\n  for(size_t i=0;i<pool_n;i++) if(pool_nodes[i]==(uintptr_t)p){ assert(!pool_freed[i]); pool_freed[i]++; }\n  free(p);\n}\n#define free pool_free\n#define main pool_original_main\n"
  hold body = "#undef main\n#undef free\nstatic int pool_empty_probe(void){\n  /* Empty-heap control, run before any managed block exists so no\n     conservative stack word can keep a block alive. The cache held 4\n     MiB here; an empty heap must release it whole instead of keeping\n     two blocks per class. */\n  for(size_t c=0;c<15;c++) for(int j=0;j<4;j++){\n    sx_gcb *b=malloc(sx_gc_class_size(c)); assert(b);\n    pool_nodes[pool_n]=(uintptr_t)b; pool_classes[pool_n++]=c; b->cls=c; b->next=sx_gfree[c]; sx_gfree[c]=b;\n  }\n  size_t cached=0; for(size_t i=0;i<pool_n;i++) cached+=sx_gc_class_size(pool_classes[i]);\n  assert(cached==4194176u);\n  assert(sx_gcall==0);\n  sx_gc_collect();\n  assert(sx_gcall==0);\n  for(size_t c=0;c<SX_NCLS;c++) assert(sx_gfree[c]==0);\n  for(size_t i=0;i<pool_n;i++) assert(pool_freed[i]==1);\n  /* Hand the slots back with clean free counters for the cache-policy probe. */\n  for(size_t i=0;i<pool_n;i++) pool_freed[i]=0;\n  pool_n=0;\n  return 0;\n}\nstatic int pool_probe(void){\n  sx_list *volatile live=sx_llit(2,7.0,9.0);\n  sx_list *volatile alias=live;\n  for(size_t c=0;c<15;c++) for(int j=0;j<4;j++){\n    sx_gcb *b=malloc(sx_gc_class_size(c)); assert(b);\n    pool_nodes[pool_n]=(uintptr_t)b; pool_classes[pool_n++]=c; b->cls=c; b->next=sx_gfree[c]; sx_gfree[c]=b;\n  }\n  /* Model an unrelated pre-existing warm block in the reuse class. */\n  sx_gcb *noise=malloc(sx_gc_class_size(1)); assert(noise);\n  noise->cls=1; noise->next=sx_gfree[1]; sx_gfree[1]=noise;\n  sx_gc_collect(); /* Must invoke trimming after the sweep. */\n  /* Sweeping may add other blocks to these classes. Check the policy,\n     not an absolute count of which injected blocks happened to be freed. */\n  size_t freed=0;\n  for(size_t c=0;c<SX_NCLS;c++){\n    size_t limit=sx_gc_class_size(c)<=65536 ? 2 : 0, n=0;\n    for(sx_gcb *b=sx_gfree[c];b;b=b->next){\n      assert(b->cls==c); n++; assert(n<=limit);\n    }\n  }\n  for(size_t i=0;i<pool_n;i++){\n    size_t found=0, c=pool_classes[i];\n    for(sx_gcb *b=sx_gfree[c];b;b=b->next)\n      if((uintptr_t)b==pool_nodes[i]) found++;\n    assert(found<=1 && pool_freed[i]==(found?0:1));\n    if(sx_gc_class_size(c)>65536) assert(pool_freed[i]==1);\n    freed+=pool_freed[i];\n  }\n  sx_gc_trim_free();\n  size_t again=0; for(size_t i=0;i<pool_n;i++) again+=pool_freed[i];\n  assert(again==freed);\n  /* Do not mistake later allocator address reuse for a double free. */\n  pool_n=0;\n  sx_gcb *warm=sx_gfree[sx_gc_cls(16+SX_GCH)]; assert(warm);\n  char *volatile reused=sx_gc_alloc(0,16); strcpy(reused,\"warm\");\n  assert((char*)reused==(char*)warm+SX_GCH);\n  assert(sx_gc_hash_get((char*)reused));\n  sx_gc_collect();\n  assert(alias==live && live->n==2 && live->d[0]==7.0 && live->d[1]==9.0);\n  assert(strcmp((char*)reused,\"warm\")==0);\n  puts(\"gc-pool-ok: empty heap released the whole cache; oversized blocks freed; small cache bounded; aliases and reuse intact\");\n  return 0;\n}\nint main(void){ char anchor; sx_gc_init(&anchor); if(pool_empty_probe()) return 1; int (*volatile run)(void)=pool_probe; return run(); }\n"
  hold written = gl_must_write(concat(base, ".c"), concat(pre, concat(read_file(source), body)))
  hold mode = 0
  while mode < 4 {
    hold flags = "-O0 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types"
    when mode == 1 { flags = "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types" }
    when mode >= 2 { flags = "-O2 -g -fno-pie -no-pie -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all" }
    hold bin = concat(base, numstr(mode))
    hold compile = concat(gl_sh_quote(gl_cc()), concat(" -o ", concat(gl_sh_quote(bin), concat(" ", concat(gl_sh_quote(concat(base, ".c")), concat(" ", flags))))))
    hold built = gpm_run(compile, concat(bin, ".build"), concat("GC pool compile mode ", numstr(mode)))
    hold cmd = concat("./", bin)
    when mode == 2 { cmd = concat("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ", cmd) }
    when mode == 3 { cmd = concat("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:detect_stack_use_after_return=1 UBSAN_OPTIONS=halt_on_error=1 ", concat("./", bin)) }
    hold checked = gpm_run(cmd, concat(bin, ".out"), concat("GC pool execution mode ", numstr(mode)))
    hold output = gl_assert_eq_str(gl_strip_trailing_nl(read_file(concat(bin, ".out"))), "gc-pool-ok: empty heap released the whole cache; oversized blocks freed; small cache bounded; aliases and reuse intact", "GC pool exact stdout")
    mode = mode + 1
  }
  show "[OK] C-output GC free-pool trimming: O0/O2/ASan+UBSan, including fake-stack roots"
  give 0
}
