// tools/sxmod_lib.sa -- Pure-Sayanox transitive DAG module namespacing engine.
// Shared by tools/sxmod.sa (--transitive) and tools/sxc_native.sa (in-memory
// compilation of multi-module programs directly to static x86-64 ELF64).

make mxl_istr(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold n = v
  when n < 0 {
    neg = 1
    n = 0 - n
  }
  hold out = ""
  while n > 0 {
    hold d = n % 10
    out = concat(chr(48 + d), out)
    n = (n - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make mxl_sub(s: str, a: num, b: num) -> str {
  hold out = ""
  hold i = a
  while i < b {
    out = concat(out, chr(sx_index(s, i)))
    i = i + 1
  }
  give out
}

make mxl_trim(s: str) -> str {
  hold n = len(s)
  hold a = 0
  while a < n && (sx_index(s, a) == 32 || sx_index(s, a) == 9) {
    a = a + 1
  }
  hold b = n
  while b > a && (sx_index(s, b - 1) == 32 || sx_index(s, b - 1) == 9 || sx_index(s, b - 1) == 13) {
    b = b - 1
  }
  give mxl_sub(s, a, b)
}

make mxl_starts(s: str, p: str) -> num {
  hold pn = len(p)
  when len(s) < pn {
    give 0
  }
  hold i = 0
  while i < pn {
    when sx_index(s, i) != sx_index(p, i) {
      give 0
    }
    i = i + 1
  }
  give 1
}

make mxl_is_name_char(c: num) -> num {
  when (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 {
    give 1
  }
  give 0
}

make mxl_name_at(s: str, i: num) -> str {
  hold n = len(s)
  hold j = i
  hold out = ""
  while j < n && mxl_is_name_char(sx_index(s, j)) == 1 {
    out = concat(out, chr(sx_index(s, j)))
    j = j + 1
  }
  give out
}

make mxl_first_word(s: str) -> str {
  give mxl_name_at(s, 0)
}

make mxl_find_sub(hay: str, needle: str) -> num {
  hold hn = len(hay)
  hold nn = len(needle)
  when nn == 0 {
    give 0
  }
  hold i = 0
  while i + nn <= hn {
    hold same = 1
    hold j = 0
    while j < nn && same == 1 {
      when sx_index(hay, i + j) != sx_index(needle, j) {
        same = 0
      }
      j = j + 1
    }
    when same == 1 {
      give i
    }
    i = i + 1
  }
  give 0 - 1
}

make mxl_tbl_has(tbl: str, k: str) -> num {
  hold key = concat(concat("|", k), "=")
  when mxl_find_sub(tbl, key) >= 0 {
    give 1
  }
  give 0
}

make mxl_tbl_get(tbl: str, k: str) -> str {
  hold key = concat(concat("|", k), "=")
  hold at = mxl_find_sub(tbl, key)
  when at < 0 {
    give ""
  }
  hold i = at + len(key)
  hold n = len(tbl)
  hold out = ""
  while i < n && sx_index(tbl, i) != 124 {
    out = concat(out, chr(sx_index(tbl, i)))
    i = i + 1
  }
  give out
}

make mxl_tbl_put(tbl: str, k: str, v: str) -> str {
  give concat(tbl, concat(concat(k, "="), concat(v, "|")))
}

make mxl_tbl_del(tbl: str, k: str) -> str {
  hold key = concat(concat("|", k), "=")
  hold at = mxl_find_sub(tbl, key)
  when at < 0 {
    give tbl
  }
  hold n = len(tbl)
  hold end_bar = at + len(key)
  while end_bar < n && sx_index(tbl, end_bar) != 124 {
    end_bar = end_bar + 1
  }
  give concat(mxl_sub(tbl, 0, at), mxl_sub(tbl, end_bar, n))
}

make mxl_dir_of(p: str) -> str {
  hold n = len(p)
  hold last = 0 - 1
  hold i = 0
  while i < n {
    when sx_index(p, i) == 47 {
      last = i
    }
    i = i + 1
  }
  when last < 0 {
    give ""
  }
  when last == 0 {
    give "/"
  }
  give mxl_sub(p, 0, last)
}

// Canonicalize relative slash paths (strips ./, collapses //, folds seg/..)
make mxl_norm_path(p: str) -> str {
  hold n = len(p)
  when n == 0 {
    give p
  }
  hold lead_slash = 0
  when sx_index(p, 0) == 47 {
    lead_slash = 1
  }
  hold stack = ""
  hold i = 0
  while i < n {
    while i < n && sx_index(p, i) == 47 {
      i = i + 1
    }
    hold j = i
    while j < n && sx_index(p, j) != 47 {
      j = j + 1
    }
    when j > i {
      hold seg = mxl_sub(p, i, j)
      when string_eq(seg, ".") == 1 {
        // skip dot segment
        i = j
      } otherwise {
        when string_eq(seg, "..") == 1 {
          hold sn = len(stack)
          when sn > 0 {
            hold cut = 0 - 1
            hold k = 0
            while k < sn {
              when sx_index(stack, k) == 47 {
                cut = k
              }
              k = k + 1
            }
            hold tail_seg = stack
            when cut >= 0 {
              tail_seg = mxl_sub(stack, cut + 1, sn)
            }
            when string_eq(tail_seg, "..") == 1 {
              stack = concat(stack, "/..")
            } otherwise {
              when cut < 0 {
                stack = ""
              } otherwise {
                stack = mxl_sub(stack, 0, cut)
              }
            }
          } otherwise {
            when lead_slash == 0 {
              stack = ".."
            }
          }
        } otherwise {
          when len(stack) == 0 {
            stack = seg
          } otherwise {
            stack = concat(stack, concat("/", seg))
          }
        }
      }
    }
    i = j
  }
  when lead_slash == 1 {
    give concat("/", stack)
  }
  when len(stack) == 0 {
    give "."
  }
  give stack
}

make mxl_resolve_mod_path(importer: str, raw_rel: str) -> str {
  when len(raw_rel) > 0 && sx_index(raw_rel, 0) == 47 {
    give mxl_norm_path(raw_rel)
  }
  hold base_dir = mxl_dir_of(importer)
  when len(base_dir) > 0 {
    hold cand = concat(base_dir, concat("/", raw_rel))
    when path_kind(cand) == 1 {
      give mxl_norm_path(cand)
    }
  }
  when path_kind(raw_rel) == 1 {
    give mxl_norm_path(raw_rel)
  }
  give mxl_norm_path(raw_rel)
}

make mxl_has_module_header(src: str) -> num {
  hold n = len(src)
  hold pos = 0
  while pos < n {
    hold raw = ""
    while pos < n && sx_index(src, pos) != 10 {
      raw = concat(raw, chr(sx_index(src, pos)))
      pos = pos + 1
    }
    pos = pos + 1
    hold line = mxl_trim(raw)
    when len(line) > 0 && mxl_starts(line, "//") == 0 {
      when mxl_starts(line, "module ") == 1 || string_eq(line, "module") == 1 {
        give 1
      }
      give 0
    }
  }
  give 0
}

make mxl_depth_delta(line: str) -> num {
  hold n = len(line)
  hold i = 0
  hold d = 0
  hold instr = 0
  while i < n {
    hold c = sx_index(line, i)
    when instr == 1 {
      when c == 92 {
        i = i + 1
      } otherwise {
        when c == 34 {
          instr = 0
        }
      }
    } otherwise {
      when c == 34 {
        instr = 1
      } otherwise {
        when c == 47 && i + 1 < n && sx_index(line, i + 1) == 47 {
          i = n
        } otherwise {
          when c == 123 {
            d = d + 1
          }
          when c == 125 {
            d = d - 1
          }
        }
      }
    }
    i = i + 1
  }
  give d
}

make mxl_members_of_body(text: str, sub_aliases: str, path: str) -> str {
  hold n = len(text)
  hold pos = 0
  hold depth = 0
  hold lineno = 0
  hold out = "|"
  while pos <= n {
    hold raw = ""
    while pos < n && sx_index(text, pos) != 10 {
      raw = concat(raw, chr(sx_index(text, pos)))
      pos = pos + 1
    }
    pos = pos + 1
    lineno = lineno + 1
    hold line = mxl_trim(raw)
    when depth == 0 {
      hold nm = ""
      hold kind = ""
      when mxl_starts(line, "make ") == 1 {
        nm = mxl_first_word(mxl_trim(mxl_sub(line, 5, len(line))))
        kind = "f"
      }
      when mxl_starts(line, "hold ") == 1 {
        nm = mxl_first_word(mxl_trim(mxl_sub(line, 5, len(line))))
        kind = "h"
      }
      when mxl_starts(line, "struct ") == 1 {
        nm = mxl_first_word(mxl_trim(mxl_sub(line, 7, len(line))))
        kind = "s"
      }
      when len(nm) > 0 {
        when mxl_tbl_has(out, nm) == 1 {
          hold dupm = fail(1, concat(concat(concat(path, " line "), mxl_istr(lineno)), concat(concat(": '", nm), "' is declared twice at the top level of this module")))
        }
        when mxl_tbl_has(sub_aliases, nm) == 1 {
          hold dupa = fail(1, concat(concat(concat(path, " line "), mxl_istr(lineno)), concat(concat(": '", nm), "' collides with an imported module alias in the same module")))
        }
        out = mxl_tbl_put(out, nm, kind)
      }
    }
    depth = depth + mxl_depth_delta(raw)
  }
  when depth != 0 {
    hold unbal = fail(1, concat(path, ": the braces in this module do not balance"))
  }
  give out
}

make mxl_shadow_check_trans(text: str, members: str, sub_aliases: str, path: str) -> num {
  hold n = len(text)
  hold pos = 0
  hold depth = 0
  hold lineno = 0
  while pos <= n {
    hold raw = ""
    while pos < n && sx_index(text, pos) != 10 {
      raw = concat(raw, chr(sx_index(text, pos)))
      pos = pos + 1
    }
    pos = pos + 1
    lineno = lineno + 1
    hold line = mxl_trim(raw)
    when depth == 0 && mxl_starts(line, "make ") == 1 {
      hold op = mxl_find_sub(line, "(")
      when op >= 0 {
        hold i = op + 1
        hold ln = len(line)
        hold prm = ""
        while i < ln && sx_index(line, i) != 41 {
          hold c = sx_index(line, i)
          when mxl_is_name_char(c) == 1 {
            prm = concat(prm, chr(c))
          } otherwise {
            when c == 58 {
              when mxl_tbl_has(members, prm) == 1 || mxl_tbl_has(sub_aliases, prm) == 1 {
                hold shp = fail(1, concat(concat(concat(path, " line "), mxl_istr(lineno)), concat(concat(": the parameter '", prm), "' shadows a module-level name or imported alias; rename the parameter")))
              }
            }
            prm = ""
          }
          i = i + 1
        }
      }
    }
    when depth > 0 {
      hold lnm = ""
      when mxl_starts(line, "hold ") == 1 {
        lnm = mxl_first_word(mxl_trim(mxl_sub(line, 5, len(line))))
      }
      when mxl_starts(line, "for ") == 1 {
        lnm = mxl_first_word(mxl_trim(mxl_sub(line, 4, len(line))))
      }
      when len(lnm) > 0 && (mxl_tbl_has(members, lnm) == 1 || mxl_tbl_has(sub_aliases, lnm) == 1) {
        hold shl = fail(1, concat(concat(concat(path, " line "), mxl_istr(lineno)), concat(concat(": the local '", lnm), "' shadows a module-level name or imported alias; rename the local")))
      }
    }
    depth = depth + mxl_depth_delta(raw)
  }
  give 0
}

make mxl_rewrite_unit(text: str, members: str, prefix: str, aliases: str, allm: str, srcpath: str) -> str {
  hold n = len(text)
  hold i = 0
  hold out = ""
  hold lineno = 1
  hold in_struct_decl = 0
  hold struct_depth = 0
  while i < n {
    hold c = sx_index(text, i)
    when c == 10 {
      lineno = lineno + 1
      out = concat(out, chr(c))
      i = i + 1
    } otherwise {
      when c == 34 {
        out = concat(out, chr(c))
        i = i + 1
        hold done = 0
        while i < n && done == 0 {
          hold sc = sx_index(text, i)
          out = concat(out, chr(sc))
          when sc == 92 && i + 1 < n {
            out = concat(out, chr(sx_index(text, i + 1)))
            i = i + 1
          } otherwise {
            when sc == 34 {
              done = 1
            }
          }
          i = i + 1
        }
      } otherwise {
        when c == 47 && i + 1 < n && sx_index(text, i + 1) == 47 {
          while i < n && sx_index(text, i) != 10 {
            out = concat(out, chr(sx_index(text, i)))
            i = i + 1
          }
        } otherwise {
          when c == 123 {
            when in_struct_decl == 1 {
              struct_depth = struct_depth + 1
            }
            out = concat(out, chr(c))
            i = i + 1
          } otherwise {
            when c == 125 {
              when in_struct_decl == 1 {
                struct_depth = struct_depth - 1
                when struct_depth <= 0 {
                  in_struct_decl = 0
                  struct_depth = 0
                }
              }
              out = concat(out, chr(c))
              i = i + 1
            } otherwise {
              when mxl_is_name_char(c) == 1 {
                hold nm = mxl_name_at(text, i)
                hold after = i + len(nm)
                hold prevc = 0
                when i > 0 {
                  prevc = sx_index(text, i - 1)
                }
                hold nextc = 0
                when after < n {
                  nextc = sx_index(text, after)
                }
                when string_eq(nm, "struct") == 1 && prevc != 46 && mxl_is_name_char(prevc) == 0 {
                  in_struct_decl = 1
                  struct_depth = 0
                  out = concat(out, nm)
                  i = after
                } otherwise {
                  when in_struct_decl == 1 && struct_depth > 0 {
                    // Inside struct { field1, field2 }: never prefix field declarations!
                    out = concat(out, nm)
                    i = after
                  } otherwise {
                    hold isalias = 0
                    when mxl_tbl_has(aliases, nm) == 1 && prevc != 46 && mxl_is_name_char(prevc) == 0 {
                      isalias = 1
                    }
                    when isalias == 1 {
                      when after >= n || sx_index(text, after) != 46 {
                        hold bareal = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(concat(": '", nm), "' is a module alias, not a value; write alias.member")))
                      }
                      hold mem = mxl_name_at(text, after + 1)
                      when len(mem) == 0 {
                        hold nomem = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(concat(": '", nm), ".' with no member name")))
                      }
                      hold modname = mxl_tbl_get(aliases, nm)
                      hold full = mxl_tbl_get(allm, concat(concat(modname, "."), mem))
                      when len(full) == 0 {
                        hold unkmem = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(concat(concat(": module '", modname), concat("' has no member '", mem)), "'")))
                      }
                      out = concat(out, full)
                      i = after + 1 + len(mem)
                    } otherwise {
                      hold rename = 0
                      when len(prefix) > 0 && mxl_tbl_has(members, nm) == 1 && prevc != 46 && nextc != 58 && mxl_is_name_char(prevc) == 0 {
                        rename = 1
                      }
                      when rename == 1 {
                        hold mkind = mxl_tbl_get(members, nm)
                        when string_eq(mkind, "s") == 1 {
                          hold m_base = mxl_sub(prefix, 0, len(prefix) - 2)
                          out = concat(out, concat("Mod_", concat(m_base, concat("_", nm))))
                        } otherwise {
                          out = concat(out, concat(prefix, nm))
                        }
                      } otherwise {
                        out = concat(out, nm)
                      }
                      i = after
                    }
                  }
                }
              } otherwise {
                out = concat(out, chr(c))
                i = i + 1
              }
            }
          }
        }
      }
    }
  }
  give out
}

make mxl_parse_mod_line(line: str, srcpath: str, lineno: num, part: num) -> str {
  // part 0 -> mname, part 1 -> alias, part 2 -> raw path
  hold q = chr(34)
  hold rest = mxl_trim(mxl_sub(line, 7, len(line)))
  hold mname = mxl_first_word(rest)
  when len(mname) == 0 {
    hold noname = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": a `module` line with no module name"))
  }
  hold c0 = sx_index(mname, 0)
  when c0 < 97 || c0 > 122 {
    hold badcase = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(concat(": the module name '", mname), "' must start with a lowercase letter (an uppercase prefix could collide with a generic specialisation)")))
  }
  rest = mxl_trim(mxl_sub(rest, len(mname), len(rest)))
  hold alias = mname
  when mxl_starts(rest, "as ") == 1 {
    rest = mxl_trim(mxl_sub(rest, 3, len(rest)))
    alias = mxl_first_word(rest)
    when len(alias) == 0 {
      hold noalias = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": an `as` with no alias"))
    }
    rest = mxl_trim(mxl_sub(rest, len(alias), len(rest)))
  }
  when mxl_starts(rest, "from ") == 0 {
    hold nofrom = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(": a `module` line needs `from ", concat(q, concat("path", concat(q, "`"))))))
  }
  rest = mxl_trim(mxl_sub(rest, 5, len(rest)))
  when len(rest) < 2 || sx_index(rest, 0) != 34 || sx_index(rest, len(rest) - 1) != 34 {
    hold noquote = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": the module path must be in double quotes"))
  }
  hold mpath = mxl_sub(rest, 1, len(rest) - 1)
  when part == 0 {
    give mname
  }
  when part == 1 {
    give alias
  }
  give mpath
}

make mxl_pack1(s: str) -> str {
  give concat(concat(mxl_istr(len(s)), ":"), s)
}

make mxl_pack4(s0: str, s1: str, s2: str, s3: str) -> str {
  hold p = mxl_pack1(s0)
  p = concat(p, mxl_pack1(s1))
  p = concat(p, mxl_pack1(s2))
  p = concat(p, mxl_pack1(s3))
  give p
}

make mxl_get4(packed: str, slot: num) -> str {
  hold n = len(packed)
  hold pos = 0
  hold cur = 0
  while pos < n {
    hold slen = 0
    while pos < n && sx_index(packed, pos) != 58 {
      slen = slen * 10 + (sx_index(packed, pos) - 48)
      pos = pos + 1
    }
    pos = pos + 1
    when cur == slot {
      give mxl_sub(packed, pos, pos + slen)
    }
    pos = pos + slen
    cur = cur + 1
  }
  give ""
}

make mxl_load_mod_dag(dag_in: str, mname: str, rpath: str, req_from: str, req_line: num, depth: num) -> str {
  when depth > 16 {
    hold ed = fail(1, concat(req_from, ": module nesting deeper than 16"))
  }
  hold visited = mxl_get4(dag_in, 0)
  hold visiting = mxl_get4(dag_in, 1)
  hold allm = mxl_get4(dag_in, 2)
  hold modtext = mxl_get4(dag_in, 3)

  when mxl_tbl_has(visiting, rpath) == 1 {
    hold ec = fail(1, concat(concat(concat(req_from, " line "), mxl_istr(req_line)), concat(concat(": module cycle detected involving '", rpath), "'")))
  }
  when mxl_tbl_has(visited, mname) == 1 {
    hold prev_p = mxl_tbl_get(visited, mname)
    when string_eq(prev_p, rpath) == 1 {
      give dag_in
    }
    hold eb = fail(1, concat(concat(concat(req_from, " line "), mxl_istr(req_line)), concat(concat(": the module name '", mname), concat("' is already bound to '", concat(prev_p, concat("' (cannot rebind to '", concat(rpath, "')")))))))
  }

  hold mtext = read_file(rpath)
  when len(mtext) == 0 {
    hold nr = fail(1, concat(concat(concat(req_from, " line "), mxl_istr(req_line)), concat(concat(": cannot read the module file '", rpath), "' (or it is empty)")))
  }

  visiting = mxl_tbl_put(visiting, rpath, "1")
  hold dag = mxl_pack4(visited, visiting, allm, modtext)

  hold n = len(mtext)
  hold pos = 0
  hold lineno = 0
  hold sub_aliases = "|"
  hold mbody = ""
  hold inbody = 0
  while pos <= n {
    hold raw = ""
    while pos < n && sx_index(mtext, pos) != 10 {
      raw = concat(raw, chr(sx_index(mtext, pos)))
      pos = pos + 1
    }
    pos = pos + 1
    lineno = lineno + 1
    hold line = mxl_trim(raw)
    hold ismod = 0
    when mxl_starts(line, "module ") == 1 || string_eq(line, "module") == 1 {
      ismod = 1
    }
    when ismod == 1 && inbody == 1 {
      hold late = fail(1, concat(concat(concat(rpath, " line "), mxl_istr(lineno)), ": a `module` line after the first statement; all module lines come first"))
    }
    when ismod == 1 {
      when string_eq(line, "module") == 1 {
        hold nonm = fail(1, concat(concat(concat(rpath, " line "), mxl_istr(lineno)), ": a `module` line with no module name"))
      }
      hold smname = mxl_parse_mod_line(line, rpath, lineno, 0)
      hold salias = mxl_parse_mod_line(line, rpath, lineno, 1)
      hold smpath_raw = mxl_parse_mod_line(line, rpath, lineno, 2)
      when mxl_tbl_has(sub_aliases, salias) == 1 {
        hold dupal = fail(1, concat(concat(concat(rpath, " line "), mxl_istr(lineno)), concat(concat(": the alias '", salias), "' is already in use")))
      }
      hold smpath = mxl_resolve_mod_path(rpath, smpath_raw)
      dag = mxl_load_mod_dag(dag, smname, smpath, rpath, lineno, depth + 1)
      sub_aliases = mxl_tbl_put(sub_aliases, salias, smname)
      mbody = concat(mbody, "\n")
    } otherwise {
      when mxl_starts(line, "use ") == 1 {
        hold baduse = fail(1, concat(concat(concat(rpath, " line "), mxl_istr(lineno)), ": a `use` splice inside a namespaced module (its names would stay unprefixed); compose with `module` instead"))
      }
      when inbody == 0 && len(line) > 0 && mxl_starts(line, "//") == 0 {
        inbody = 1
      }
      when pos <= n {
        mbody = concat(mbody, concat(raw, "\n"))
      }
    }
  }

  visited = mxl_get4(dag, 0)
  visiting = mxl_get4(dag, 1)
  allm = mxl_get4(dag, 2)
  modtext = mxl_get4(dag, 3)

  hold members = mxl_members_of_body(mbody, sub_aliases, rpath)
  when len(members) < 2 {
    hold empty_m = fail(1, concat(concat("the module file '", rpath), "' declares nothing at its top level"))
  }
  hold sh = mxl_shadow_check_trans(mbody, members, sub_aliases, rpath)
  hold prefix = concat(mname, "__")

  hold mi = 0
  hold mn = len(members)
  while mi < mn {
    when sx_index(members, mi) == 124 {
      hold memname = ""
      hold mj = mi + 1
      while mj < mn && sx_index(members, mj) != 61 {
        memname = concat(memname, chr(sx_index(members, mj)))
        mj = mj + 1
      }
      when len(memname) > 0 {
        hold memkind = mxl_tbl_get(members, memname)
        hold full_mem = concat(prefix, memname)
        when string_eq(memkind, "s") == 1 {
          full_mem = concat("Mod_", concat(mname, concat("_", memname)))
        }
        allm = mxl_tbl_put(allm, concat(concat(mname, "."), memname), full_mem)
      }
      mi = mj
    } otherwise {
      mi = mi + 1
    }
  }

  hold rewritten = mxl_rewrite_unit(mbody, members, prefix, sub_aliases, allm, rpath)
  modtext = concat(modtext, concat(concat("// ---- module ", mname), concat(concat(" <- ", rpath), "\n")))
  modtext = concat(modtext, rewritten)
  when len(modtext) > 0 && sx_index(modtext, len(modtext) - 1) != 10 {
    modtext = concat(modtext, "\n")
  }

  visiting = mxl_tbl_del(visiting, rpath)
  visited = mxl_tbl_put(visited, mname, rpath)
  give mxl_pack4(visited, visiting, allm, modtext)
}

make mxl_lower_transitive(src: str, srcpath: str) -> str {
  hold root_norm = mxl_norm_path(srcpath)
  hold init_visiting = mxl_tbl_put("|", root_norm, "1")
  hold dag = mxl_pack4("|", init_visiting, "|", "")

  hold n = len(src)
  hold pos = 0
  hold lineno = 0
  hold aliases = "|"
  hold body = ""
  hold inbody = 0
  hold nmods = 0

  while pos <= n {
    hold raw = ""
    while pos < n && sx_index(src, pos) != 10 {
      raw = concat(raw, chr(sx_index(src, pos)))
      pos = pos + 1
    }
    pos = pos + 1
    lineno = lineno + 1
    hold line = mxl_trim(raw)
    hold ismod = 0
    when mxl_starts(line, "module ") == 1 || string_eq(line, "module") == 1 {
      ismod = 1
    }
    when ismod == 1 && inbody == 1 {
      hold late = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": a `module` line after the first statement; all module lines come first"))
    }
    when ismod == 1 {
      when string_eq(line, "module") == 1 {
        hold nonm = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": a `module` line with no module name"))
      }
      hold mname = mxl_parse_mod_line(line, srcpath, lineno, 0)
      hold alias = mxl_parse_mod_line(line, srcpath, lineno, 1)
      hold mpath_raw = mxl_parse_mod_line(line, srcpath, lineno, 2)
      when mxl_tbl_has(aliases, alias) == 1 {
        hold dupal = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), concat(concat(": the alias '", alias), "' is already in use")))
      }
      hold rpath = mxl_resolve_mod_path(srcpath, mpath_raw)
      dag = mxl_load_mod_dag(dag, mname, rpath, srcpath, lineno, 1)
      aliases = mxl_tbl_put(aliases, alias, mname)
      nmods = nmods + 1
      body = concat(body, "\n")
    } otherwise {
      when mxl_starts(line, "use ") == 1 {
        hold mainuse = fail(1, concat(concat(concat(srcpath, " line "), mxl_istr(lineno)), ": a `use` splice in a namespaced program; compose with `module` instead"))
      }
      when inbody == 0 && len(line) > 0 && mxl_starts(line, "//") == 0 {
        inbody = 1
      }
      when pos <= n {
        body = concat(body, concat(raw, "\n"))
      }
    }
  }

  when nmods == 0 {
    hold nomod = fail(1, concat(srcpath, ": no `module` line, so there is nothing to namespace"))
  }

  hold allm_fin = mxl_get4(dag, 2)
  hold modtext_fin = mxl_get4(dag, 3)
  hold rbody = mxl_rewrite_unit(body, "|", "", aliases, allm_fin, srcpath)
  hold out = concat(concat("// generated by tools/sxmod (--transitive) from ", srcpath), "\n")
  out = concat(out, "// Namespaced module DAG rewritten into the flat bootstrap dialect.\n")
  out = concat(out, "// Edit the sources, not this file.\n\n")
  out = concat(out, modtext_fin)
  out = concat(out, "\n// ---- program ----\n")
  out = concat(out, rbody)
  give out
}
