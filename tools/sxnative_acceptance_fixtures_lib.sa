make ng_diagnostic(name: str) -> str {
  when string_eq(name, "native_undef.sa") == 1 { give "undefined variable" }
  when string_eq(name, "native_fld.sa") == 1 { give "cannot access a field" }
  when string_eq(name, "native_nestfwd.sa") == 1 { give "declare the nested struct first" }
  when string_eq(name, "native_showstruct.sa") == 1 { give "show of a struct" }
  when string_eq(name, "native_nestchain.sa") == 1 { give "cannot access a field" }
  when string_eq(name, "nu_miss.sa") == 1 { give "cannot open use file" }
  when string_eq(name, "nu_uq.sa") == 1 { give "use needs a quoted path" }
  when string_eq(name, "native_giveout.sa") == 1 { give "give outside a make function" }
  when string_eq(name, "native_mkin.sa") == 1 { give "make must be at the top level" }
  when string_eq(name, "native_fnargs.sa") == 1 { give "takes 1 args, got 2" }
  when string_eq(name, "native_fnty.sa") == 1 { give "takes numbers" }
  when string_eq(name, "native_fngive.sa") == 1 { give "give must give a number" }
  give ""
}
