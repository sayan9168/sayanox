make pg_test_native_for_functions() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/native_for_functions_test.sa", "selfhost/seed_tests/nff_seed.c", 0, "selfhost/seed_tests/nff_seed.c.emit.log", "selfhost/seed_tests/nff_seed.c.err")
