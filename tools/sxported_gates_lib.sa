  hold p4 = pg_emit_stream(1, "selfhost/list_struct_fields_test.sa", "selfhost/seed_tests/list_struct_gen2.c", 0, "/dev/null", "selfhost/seed_tests/list_struct_gen2.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/list_struct_gen2.c", "selfhost/seed_tests/list_struct_gen2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p6 = gl_assert_out("./selfhost/seed_tests/list_struct_gen2", "5\n2\n3\n5\n7\n11\n28\n5", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pg_emit_stream(2, "selfhost/list_struct_fields_test.sa", "selfhost/seed_tests/list_struct_native", 0, "selfhost/seed_tests/list_struct_native.emit.log", "selfhost/seed_tests/list_struct_native.err")
  hold p8 = gl_assert_out("./selfhost/seed_tests/list_struct_native", "5\n2\n3\n5\n7\n11\n28\n5", "selfhost/seed_tests/sxported.stdout")
  hold p9 = pg_emit_stream(2, "selfhost/list_struct_fields_gc_test.sa", "selfhost/seed_tests/list_struct_gc", 0, "selfhost/seed_tests/list_struct_gc.emit.log", "selfhost/seed_tests/list_struct_gc.err")
  hold p10 = gl_assert_out("./selfhost/seed_tests/list_struct_gc", "gc-ok\n5\n4\n5\n6\n7\n8", "selfhost/seed_tests/sxported.stdout")
  hold p11 = gl_must_write("selfhost/seed_tests/list_struct_conflict.sa", "struct P { xs }\nhold p = P { xs: [1] }\nhold q = P { xs: 2 }\n")
  hold p12 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/list_struct_conflict.sa >selfhost/seed_tests/list_struct_conflict_seed.c 2>selfhost/seed_tests/list_struct_conflict_seed.err", "test-list-struct-fields refusal")
  hold p13 = pg_contains("selfhost/seed_tests/list_struct_conflict_seed.err", "earlier literal")
  hold p14 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/list_struct_conflict.sa selfhost/seed_tests/list_struct_conflict_native >selfhost/seed_tests/list_struct_conflict_native.out 2>selfhost/seed_tests/list_struct_conflict_native.err", "test-list-struct-fields refusal")
  hold p15 = pg_contains("selfhost/seed_tests/list_struct_conflict_native.err", "two different types")
  give 0
}

make pg_test_gen2_list_struct_fields() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(1, "selfhost/gen2_list_struct_fields_test.sa", "selfhost/seed_tests/gen2_list_struct.c", 0, "/dev/null", "selfhost/seed_tests/gen2_list_struct.c.err")
  hold p2 = pg_not_contains("selfhost/seed_tests/gen2_list_struct.c", "#error sayanox-min:")
  hold p3 = gl_compile_c("selfhost/seed_tests/gen2_list_struct.c", "selfhost/seed_tests/gen2_list_struct", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p4 = gl_assert_out("./selfhost/seed_tests/gen2_list_struct", "10\n20\n11\n3\n30\n61\n20\n77\n88\n61", "selfhost/seed_tests/sxported.stdout")
  hold p5 = pg_contains("selfhost/seed_tests/gen2_list_struct.c", "typedef struct { sx_list *xs; char *label; } Packet;")
  hold p6 = pg_contains("selfhost/seed_tests/gen2_list_struct.c", "typedef struct { Packet p; } Envelope;")
  hold p7 = pg_contains("selfhost/seed_tests/gen2_list_struct.c", "q.xs = sx_lset(q.xs, 0.0, 11.0);")
  hold p8 = pg_contains("selfhost/seed_tests/gen2_list_struct.c", "sx_lget((q).xs,(sx_llen((q).xs) - 1.0))")
  hold p9 = pg_contains("selfhost/seed_tests/gen2_list_struct.c", "for (double __sx_ix = 0.0; __sx_ix < sx_llen(__sx_fv")
  hold p10 = gl_must_write("selfhost/seed_tests/gen2_list_struct_conflict.sa", "struct P { xs }\nhold p = P { xs: [1] }\nhold q = P { xs: 2 }\n")
  hold p11 = pg_emit_stream(1, "selfhost/seed_tests/gen2_list_struct_conflict.sa", "selfhost/seed_tests/gen2_list_struct_conflict.c", 0, "selfhost/seed_tests/gen2_list_struct_conflict.msg", "selfhost/seed_tests/gen2_list_struct_conflict.c.err")
  hold p12 = pg_contains("selfhost/seed_tests/gen2_list_struct_conflict.c", "#error sayanox-min: struct field is used with two different value kinds")
  hold p13 = pg_contains("selfhost/seed_tests/gen2_list_struct_conflict.msg", "two different value kinds")
  hold p14 = gl_must_write("selfhost/seed_tests/gen2_list_struct_push_bad.sa", "struct P { xs }\nhold p = P { xs: [1] }\npush(p.xs, 2)\n")
  hold p15 = pg_emit_stream(1, "selfhost/seed_tests/gen2_list_struct_push_bad.sa", "selfhost/seed_tests/gen2_list_struct_push_bad.c", 0, "selfhost/seed_tests/gen2_list_struct_push_bad.msg", "selfhost/seed_tests/gen2_list_struct_push_bad.c.err")
  hold p16 = pg_contains("selfhost/seed_tests/gen2_list_struct_push_bad.c", "#error sayanox-min: push statement:")
  hold p17 = gl_must_write("selfhost/seed_tests/gen2_list_struct_show_bad.sa", "struct P { xs }\nhold p = P { xs: [1] }\nshow p.xs\n")
  hold p18 = pg_emit_stream(1, "selfhost/seed_tests/gen2_list_struct_show_bad.sa", "selfhost/seed_tests/gen2_list_struct_show_bad.c", 0, "selfhost/seed_tests/gen2_list_struct_show_bad.msg", "selfhost/seed_tests/gen2_list_struct_show_bad.c.err")
  hold p19 = pg_contains("selfhost/seed_tests/gen2_list_struct_show_bad.c", "#error sayanox-min: show value cannot be a list")
  hold p20 = gl_must_write("selfhost/seed_tests/gen2_list_direct_show_bad.sa", "hold xs = [1]\nshow xs\n")
  hold p21 = pg_emit_stream(1, "selfhost/seed_tests/gen2_list_direct_show_bad.sa", "selfhost/seed_tests/gen2_list_direct_show_bad.c", 0, "selfhost/seed_tests/gen2_list_direct_show_bad.msg", "selfhost/seed_tests/gen2_list_direct_show_bad.c.err")
  hold p22 = pg_contains("selfhost/seed_tests/gen2_list_direct_show_bad.c", "#error sayanox-min: show value cannot be a list")
  hold p23 = gl_must_write("selfhost/seed_tests/gen2_list_struct_cond_bad.sa", "struct P { xs }\nhold p = P { xs: [1] }\nwhen p.xs {\n  show 1\n}\n")
  hold p24 = pg_emit_stream(1, "selfhost/seed_tests/gen2_list_struct_cond_bad.sa", "selfhost/seed_tests/gen2_list_struct_cond_bad.c", 0, "selfhost/seed_tests/gen2_list_struct_cond_bad.msg", "selfhost/seed_tests/gen2_list_struct_cond_bad.c.err")
  hold p25 = pg_contains("selfhost/seed_tests/gen2_list_struct_cond_bad.c", "#error sayanox-min: a list-valued struct field cannot be a condition")
  give 0
}

make pg_test_seed_list_budget() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/seed_list_lifetime_stress.sa", "selfhost/seed_tests/seed-list-budget.c", 0, "selfhost/seed_tests/seed-list-budget.c.emit.log", "selfhost/seed_tests/seed-list-budget.c.err")
  hold p2 = gl_compile_c("selfhost/seed_tests/seed-list-budget.c", "selfhost/seed_tests/seed-list-budget", "-O2")
  hold p3 = lm_assert_out("./selfhost/seed_tests/seed-list-budget", 32768, "20001\n7\n0\n19999\n20001", "selfhost/seed_tests/sxported_limit")
  hold churn = pg_emit_stream(0, "selfhost/seed_list_gc_churn.sa", "selfhost/seed_tests/seed-list-churn.c", 0, "selfhost/seed_tests/seed-list-churn.emit.log", "selfhost/seed_tests/seed-list-churn.err")
  hold compiled = gl_compile_c("selfhost/seed_tests/seed-list-churn.c", "selfhost/seed_tests/seed-list-churn", "-O2")
  hold bounded = lm_assert_out("./selfhost/seed_tests/seed-list-churn", 4096, "450000\n2\n17\n29\n2\ncollected", "selfhost/seed_tests/seed-list-churn-limit")

  hold compiler = read_file("selfhost/compiler_min.sa")
  hold prefix_end = pg_find(compiler, "make sxesegment(")
  when prefix_end <= 0 { give gl_fail("compiler source-view helper boundary changed") }
  hold view_source = "selfhost/seed_tests/compiler-source-view.sa"
  hold view_written = gl_must_write(view_source, concat(gl_slice(compiler, 0, prefix_end), read_file("selfhost/compiler_source_view_test.sa")))
  hold view_emit = pg_emit(0, view_source, "selfhost/seed_tests/compiler-source-view.c", 0)
  hold view_build = gl_compile_c("selfhost/seed_tests/compiler-source-view.c", "selfhost/seed_tests/compiler-source-view", "-O2")
  hold view_c = gl_assert_out("./selfhost/seed_tests/compiler-source-view", "source-view-ok", "selfhost/seed_tests/compiler-source-view.out")
  hold view_native = pg_emit(5, view_source, "selfhost/seed_tests/compiler-source-view-native", 0)
  hold view_parity = gl_assert_out("./selfhost/seed_tests/compiler-source-view-native", "source-view-ok", "selfhost/seed_tests/compiler-source-view-native.out")

  give 0
}

make pg_test_stdlib_list_search() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/stdlib_list_search_test.sa", "selfhost/seed_tests/stdlib_search_seed.c", 0, "selfhost/seed_tests/stdlib_search_seed.c.emit.log", "selfhost/seed_tests/stdlib_search_seed.c.err")
  hold p2 = pg_emit_stream(1, "selfhost/stdlib_list_search_test.sa", "selfhost/seed_tests/stdlib_search_gen2.c", 0, "/dev/null", "selfhost/seed_tests/stdlib_search_gen2.c.err")
  hold p3 = gl_compile_c("selfhost/seed_tests/stdlib_search_seed.c", "selfhost/seed_tests/stdlib_search_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p4 = gl_compile_c("selfhost/seed_tests/stdlib_search_gen2.c", "selfhost/seed_tests/stdlib_search_gen2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p5 = pg_emit_stream(2, "selfhost/stdlib_list_search_test.sa", "selfhost/seed_tests/stdlib_search_native", 0, "selfhost/seed_tests/stdlib_search_native.emit.log", "selfhost/seed_tests/stdlib_search_native.err")
  hold p6 = gl_assert_out("./selfhost/seed_tests/stdlib_search_seed", "1\nlist-search-done", "selfhost/seed_tests/sxported.stdout")
  hold p7 = gl_assert_out("./selfhost/seed_tests/stdlib_search_gen2", "1\nlist-search-done", "selfhost/seed_tests/sxported.stdout")
  hold p8 = gl_assert_out("./selfhost/seed_tests/stdlib_search_native", "1\nlist-search-done", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_dispatch(name: str) -> num {
  hold dir = gl_ensure_dir("selfhost/seed_tests")
  when string_eq(name, "test-mod") == 1 {
    hold r = pg_test_mod()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-user") == 1 {
    hold r = pg_test_user()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-chain") == 1 {
    hold r = pg_test_chain()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-condmod") == 1 {
    hold r = pg_test_condmod()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-struct2") == 1 {
    hold r = pg_test_struct2()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-list2") == 1 {
    hold r = pg_test_list2()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-use") == 1 {
    hold r = pg_test_use()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-nest") == 1 {
    hold r = pg_test_nest()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-prec") == 1 {
    hold r = pg_test_prec()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-float") == 1 {
    hold r = pg_test_float()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-parens") == 1 {
    hold r = pg_test_parens()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-full-lang") == 1 {
    hold r = pg_test_full_lang()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-strord") == 1 {
    hold r = pg_test_native_strord()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-give-index") == 1 {
    hold r = pg_test_give_index()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-list-paren") == 1 {
    hold r = pg_test_list_paren()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-logicarg") == 1 {
    hold r = pg_test_native_logicarg()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-gen2-logic-builtin") == 1 {
    hold r = pg_test_gen2_logic_builtin()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-struct-logic") == 1 {
    hold r = pg_test_struct_logic()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-builtin-names") == 1 {
    hold r = pg_test_builtin_names()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-fn2") == 1 {
    hold r = pg_test_fn2()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-lsp-unicode") == 1 {
    hold r = pg_test_lsp_unicode()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-range-live") == 1 {
    hold r = pg_test_native_range_live()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-for-functions") == 1 {
    hold r = pg_test_native_for_functions()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-list-alias") == 1 {
    hold r = pg_test_native_list_alias()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-inline-runtime") == 1 {
    hold r = pg_test_inline_runtime()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-seed-list-sequence") == 1 {
    hold r = pg_test_seed_list_sequence()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-list-struct-fields") == 1 {
    hold dep = pg_dispatch("test-gen2-list-struct-fields")
    hold r = pg_test_list_struct_fields()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-gen2-list-struct-fields") == 1 {
    hold r = pg_test_gen2_list_struct_fields()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-seed-list-budget") == 1 {
    hold r = pg_test_seed_list_budget()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-stdlib-list-search") == 1 {
    hold r = pg_test_stdlib_list_search()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  give gl_fail(concat("unknown migrated gate: ", name))
}
