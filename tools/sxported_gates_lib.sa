// Migrated regression gates: fixtures, branches and assertions are Sayanox.
// No Makefile parsing and no embedded shell control-flow recipes.
// C-lowering text assertions use literal substrings (stricter than old BRE dots).
use "tools/sxport_lib.sa"
use "tools/sxported_targets_lib.sa"

make pg_test_mod() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_mod.sa", "hold a = 10\nshow a % 3\nwhen a > 5 { show 1 } else { show 0 }\n")
  hold p3 = pg_emit_stream(1, "selfhost/seed_tests/ts_mod.sa", "selfhost/seed_tests/ts_mod.c", 0, "/dev/null", "selfhost/seed_tests/ts_mod.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/ts_mod.c", "selfhost/seed_tests/ts_mod", "-O2")
  hold p5 = pg_contains("selfhost/seed_tests/ts_mod.c", "sx_mod((double)(a),(double)(3.0))")
  hold p6 = pg_contains("selfhost/seed_tests/ts_mod.c", "} else {")
  hold p7 = gl_assert_out("./selfhost/seed_tests/ts_mod", "1\n1", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_test_user() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_user.sa", "struct User {\n  name,\n  age\n}\nhold u = User { name: \"Ada\", age: 36 }\nshow u.name\nshow u.age\nhold s = u.name\nshow s\nshow u.name + \"!\"\nshow u.age + 1\nhold v = User { \"Bob\", 7 }\nshow v.name\nshow len(v.name)\n")
  hold p4 = pg_emit_stream(0, "selfhost/seed_tests/ts_user.sa", "selfhost/seed_tests/ts_user_sm.c", 0, "selfhost/seed_tests/ts_user_sm.c.emit.log", "selfhost/seed_tests/ts_user_sm.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_user_sm.c", "selfhost/seed_tests/ts_user_sm", "-O2")
  hold p6 = pg_emit_stream(1, "selfhost/seed_tests/ts_user.sa", "selfhost/seed_tests/ts_user_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_user_g2.c.err")
  hold p7 = gl_compile_c("selfhost/seed_tests/ts_user_g2.c", "selfhost/seed_tests/ts_user_g2", "-O2")
  hold p8 = pg_contains("selfhost/seed_tests/ts_user_sm.c", "char *name; double age")
  hold p9 = pg_contains("selfhost/seed_tests/ts_user_g2.c", "char *name; double age")
  hold p10 = pg_capture("./selfhost/seed_tests/ts_user_sm", "selfhost/seed_tests/ts_user_sm.out")
  hold p11 = pg_capture("./selfhost/seed_tests/ts_user_g2", "selfhost/seed_tests/ts_user_g2.out")
  hold p12 = gl_assert_files_eq("selfhost/seed_tests/ts_user_sm.out", "selfhost/seed_tests/ts_user_g2.out", "test-user parity")
  hold p13 = gl_must_write("selfhost/seed_tests/ts_fcat.sa", "struct U {\n  name\n}\nhold u = U { name: \"x\" }\nhold t = u.name + \"y\"\nshow t\nshow u.name + \"z\"\n")
  hold p14 = pg_emit_stream(0, "selfhost/seed_tests/ts_fcat.sa", "selfhost/seed_tests/ts_fcat_sm.c", 0, "selfhost/seed_tests/ts_fcat_sm.c.emit.log", "selfhost/seed_tests/ts_fcat_sm.c.err")
  hold p15 = gl_compile_c("selfhost/seed_tests/ts_fcat_sm.c", "selfhost/seed_tests/ts_fcat_sm", "-O2")
  hold p16 = gl_assert_out("./selfhost/seed_tests/ts_fcat_sm", "xy\nxz", "selfhost/seed_tests/sxported.stdout")
  hold p17 = pg_emit_stream(1, "selfhost/seed_tests/ts_fcat.sa", "selfhost/seed_tests/ts_fcat_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_fcat_g2.c.err")
  hold p18 = gl_compile_c("selfhost/seed_tests/ts_fcat_g2.c", "selfhost/seed_tests/ts_fcat_g2", "-O2")
  hold p19 = gl_assert_out("./selfhost/seed_tests/ts_fcat_g2", "xy\nxz", "selfhost/seed_tests/sxported.stdout")
  hold p20 = gl_assert_out("./selfhost/seed_tests/ts_user_g2", "Ada\n36\nAda\nAda!\n37\nBob\n3", "selfhost/seed_tests/sxported.stdout")
  hold p21 = gl_must_write("selfhost/seed_tests/ts_userbad.sa", "struct User {\n  name,\n  age\n}\nhold a = User { name: \"Ada\", age: 36 }\nhold b = User { name: 1, age: 2 }\n")
  hold p22 = pg_emit_stream(1, "selfhost/seed_tests/ts_userbad.sa", "selfhost/seed_tests/ts_userbad.c", 0, "/dev/null", "selfhost/seed_tests/ts_userbad.c.err")
  hold p23 = pg_contains("selfhost/seed_tests/ts_userbad.c", "#error")
  hold p24 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_userbad.sa > /dev/null 2>&1", "test-user refusal")
  hold p25 = gl_must_write("selfhost/seed_tests/ts_order.sa", "struct User {\n  name,\n  age\n}\nhold u = User { age: 1, name: \"Ada\" }\n")
  hold p26 = pg_emit_stream(1, "selfhost/seed_tests/ts_order.sa", "selfhost/seed_tests/ts_order.c", 0, "/dev/null", "selfhost/seed_tests/ts_order.c.err")
  hold p27 = pg_contains("selfhost/seed_tests/ts_order.c", "#error")
  hold p28 = gl_must_write("selfhost/seed_tests/ts_part.sa", "struct User {\n  name,\n  age\n}\nhold u = User { age: 36, name: \"Ada\" }\nshow u.name\nshow u.age\n")
  hold p29 = pg_emit_stream(0, "selfhost/seed_tests/ts_part.sa", "selfhost/seed_tests/ts_part_sm.c", 0, "selfhost/seed_tests/ts_part_sm.c.emit.log", "selfhost/seed_tests/ts_part_sm.c.err")
  hold p30 = gl_compile_c("selfhost/seed_tests/ts_part_sm.c", "selfhost/seed_tests/ts_part_sm", "-O2")
  hold p31 = gl_assert_out("./selfhost/seed_tests/ts_part_sm", "Ada\n36", "selfhost/seed_tests/sxported.stdout")
  hold nested_path = "selfhost/seed_tests/ts_named_nested.sa"
  hold nested_source = gl_must_write(nested_path, "struct Child { age, name }\nstruct Parent { child, name }\nhold p = Parent { name: \"outer\", child: Child { name: \"inner\", age: 9 } }\nshow p.name\nshow p.child.name\nshow p.child.age\n")
  hold nested_emit = pg_emit(0, nested_path, "selfhost/seed_tests/ts_named_nested.c", 0)
  hold nested_build = gl_compile_c("selfhost/seed_tests/ts_named_nested.c", "selfhost/seed_tests/ts_named_nested", "-O2")
  hold nested_out = gl_assert_out("./selfhost/seed_tests/ts_named_nested", "outer\ninner\n9", "selfhost/seed_tests/ts_named_nested.out")
  hold duplicate = gl_must_write("selfhost/seed_tests/ts_named_duplicate.sa", "struct User { name, age }\nhold u = User { name: \"a\", name: \"b\" }\n")
  hold duplicate_reject = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_named_duplicate.sa > selfhost/seed_tests/ts_named_duplicate.c 2>selfhost/seed_tests/ts_named_duplicate.err", "duplicate named field refusal")

  give 0
}

make pg_test_chain() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_chain.sa", "hold t = \"b\"\nhold s = \"a\"\nshow s + t\nhold u = s + t + \"!\"\nshow u\nhold a = 1\nhold b = 2\nhold c = 3\nshow a + b + c\nshow a * b + c\nshow 1 + 2 * 3\nhold d = 10 - 2 - 3\nshow d\nshow 10 % 4 + 1\nshow a % 2 + b * c\n")
  hold p4 = pg_emit_stream(0, "selfhost/seed_tests/ts_chain.sa", "selfhost/seed_tests/ts_chain_sm.c", 0, "selfhost/seed_tests/ts_chain_sm.c.emit.log", "selfhost/seed_tests/ts_chain_sm.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_chain_sm.c", "selfhost/seed_tests/ts_chain_sm", "-O2")
  hold p6 = pg_emit_stream(1, "selfhost/seed_tests/ts_chain.sa", "selfhost/seed_tests/ts_chain_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_chain_g2.c.err")
  hold p7 = gl_compile_c("selfhost/seed_tests/ts_chain_g2.c", "selfhost/seed_tests/ts_chain_g2", "-O2")
  hold p8 = pg_capture("./selfhost/seed_tests/ts_chain_sm", "selfhost/seed_tests/ts_chain_sm.out")
  hold p9 = pg_capture("./selfhost/seed_tests/ts_chain_g2", "selfhost/seed_tests/ts_chain_g2.out")
  hold p10 = gl_assert_files_eq("selfhost/seed_tests/ts_chain_sm.out", "selfhost/seed_tests/ts_chain_g2.out", "test-chain parity")
  hold p11 = gl_assert_out("./selfhost/seed_tests/ts_chain_g2", "ab\nab!\n6\n5\n7\n5\n3\n7", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_test_condmod() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_cm.sa", "hold a = 17\nwhile a % 10 > 0 {\n  show a % 10\n  hold a = a - 3\n}\nwhen 10 % 3 == 1 {\n  show \"mod-ok\"\n}\n")
  hold p3 = pg_emit_stream(1, "selfhost/seed_tests/ts_cm.sa", "selfhost/seed_tests/ts_cm.c", 0, "/dev/null", "selfhost/seed_tests/ts_cm.c.err")
  hold p4 = pg_contains("selfhost/seed_tests/ts_cm.c", "sx_mod((double)(a)")
  hold p5 = pg_contains("selfhost/seed_tests/ts_cm.c", "sx_mod((double)(10.0")
  hold p6 = gl_compile_c("selfhost/seed_tests/ts_cm.c", "selfhost/seed_tests/ts_cm", "-O2")
  hold p7 = gl_assert_out("./selfhost/seed_tests/ts_cm", "7\n4\n1\n8\n5\n2\nmod-ok", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_test_struct2() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_st2.sa", "struct Point {\n  x,\n  y\n}\nstruct Pair {\n  a,\n  b\n}\nhold p = Point { x: 3, y: 4 }\nshow p.x\nshow p.y\nshow p.x + p.y\nhold q = Pair { a: 5, b: 6 }\nshow q.a + q.b\n")
  hold p3 = pg_emit_stream(1, "selfhost/seed_tests/ts_st2.sa", "selfhost/seed_tests/ts_st2.c", 0, "/dev/null", "selfhost/seed_tests/ts_st2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/ts_st2.c", "selfhost/seed_tests/ts_st2", "-O2")
  hold p5 = gl_assert_out("./selfhost/seed_tests/ts_st2", "3\n4\n7\n11", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_test_list2() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_li2.sa", "hold xs = [10, 20, 30]\nshow xs[0]\nshow len(xs)\nhold xs = push(xs, 40)\nshow len(xs)\nshow xs[3]\n")
  hold p3 = pg_emit_stream(1, "selfhost/seed_tests/ts_li2.sa", "selfhost/seed_tests/ts_li2.c", 0, "/dev/null", "selfhost/seed_tests/ts_li2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/ts_li2.c", "selfhost/seed_tests/ts_li2", "-O2")
  hold p5 = gl_assert_out("./selfhost/seed_tests/ts_li2", "10\n3\n4\n40", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_must_write("selfhost/seed_tests/ts_li3.sa", "hold xs = [5, 6]\nshow xs[1] + 1\nshow len(xs)\n")
  hold p7 = pg_emit_stream(1, "selfhost/seed_tests/ts_li3.sa", "selfhost/seed_tests/ts_li3.c", 0, "/dev/null", "selfhost/seed_tests/ts_li3.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/ts_li3.c", "selfhost/seed_tests/ts_li3", "-O2")
  hold p9 = gl_assert_out("./selfhost/seed_tests/ts_li3", "7\n2", "selfhost/seed_tests/sxported.stdout")
  hold p10 = gl_must_write("selfhost/seed_tests/ts_li4.sa", "hold xs = [5, 6]\nshow len(xs) + 1\nshow 10 % 3\nhold y = 10 + 2\nshow y\n")
  hold p11 = pg_emit_stream(1, "selfhost/seed_tests/ts_li4.sa", "selfhost/seed_tests/ts_li4.c", 0, "/dev/null", "selfhost/seed_tests/ts_li4.c.err")
  hold p12 = gl_compile_c("selfhost/seed_tests/ts_li4.c", "selfhost/seed_tests/ts_li4", "-O2")
  hold p13 = gl_assert_out("./selfhost/seed_tests/ts_li4", "3\n1\n12", "selfhost/seed_tests/sxported.stdout")
  hold p14 = gl_must_write("selfhost/seed_tests/ts_li5.sa", "hold xs = [5, 6]\nshow xs[len(xs) - 1]\n")
  hold p15 = pg_emit_stream(1, "selfhost/seed_tests/ts_li5.sa", "selfhost/seed_tests/ts_li5.c", 0, "/dev/null", "selfhost/seed_tests/ts_li5.c.err")
  hold p16 = gl_compile_c("selfhost/seed_tests/ts_li5.c", "selfhost/seed_tests/ts_li5", "-O2")
  hold p17 = pg_contains("selfhost/seed_tests/ts_li5.c", "sx_lget(xs,sx_llen(xs) - 1.0)")
  hold p18 = gl_assert_out("./selfhost/seed_tests/ts_li5", "6", "selfhost/seed_tests/sxported.stdout")
  give 0
}

make pg_test_use() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_other.sa", "hold z = 99\n")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_use.sa", "use \"selfhost/seed_tests/ts_other.sa\"\nshow z\n")
  hold p4 = pg_emit_stream(1, "selfhost/seed_tests/ts_use.sa", "selfhost/seed_tests/ts_use.c", 0, "/dev/null", "selfhost/seed_tests/ts_use.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_use.c", "selfhost/seed_tests/ts_use", "-O2")
  hold p6 = gl_assert_out("./selfhost/seed_tests/ts_use", "99", "selfhost/seed_tests/sxported.stdout")
  hold p7 = gl_must_write("selfhost/seed_tests/ts_mid.sa", "use \"selfhost/seed_tests/ts_other.sa\"\nhold y = 1\n")
  hold p8 = gl_must_write("selfhost/seed_tests/ts_top.sa", "use \"selfhost/seed_tests/ts_mid.sa\"\nshow z\nshow y\n")
  hold p9 = pg_emit_stream(1, "selfhost/seed_tests/ts_top.sa", "selfhost/seed_tests/ts_top.c", 0, "/dev/null", "selfhost/seed_tests/ts_top.c.err")
  hold p10 = gl_compile_c("selfhost/seed_tests/ts_top.c", "selfhost/seed_tests/ts_top", "-O2")
  hold p11 = gl_assert_out("./selfhost/seed_tests/ts_top", "99\n1", "selfhost/seed_tests/sxported.stdout")
  hold p12 = gl_must_write("selfhost/seed_tests/ts_miss.sa", "use \"selfhost/seed_tests/no_such_file.sa\"\nshow 1\n")
  hold p13 = pg_emit_stream(1, "selfhost/seed_tests/ts_miss.sa", "selfhost/seed_tests/ts_miss.c", 1, "/dev/null", "selfhost/seed_tests/ts_miss.c.err")
  hold p14 = pg_contains("selfhost/seed_tests/ts_miss.c", "#error")
  hold p15 = gl_must_write("selfhost/seed_tests/ts_uq.sa", "use other.sa\nshow 1\n")
  hold p16 = pg_emit_stream(1, "selfhost/seed_tests/ts_uq.sa", "selfhost/seed_tests/ts_uq.c", 0, "/dev/null", "selfhost/seed_tests/ts_uq.c.err")
  hold p17 = pg_contains("selfhost/seed_tests/ts_uq.c", "#error")
  give 0
}

make pg_test_nest() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_nest.sa", "struct Point {\n  name,\n  x\n}\nstruct Line {\n  a,\n  b\n}\nhold l = Line { a: Point { name: \"p1\", x: 1 }, b: Point { name: \"p2\", x: 2 } }\nshow l.a.name\nshow l.a.x\nshow l.b.name\nshow l.b.x\nhold m = l.b\nshow m.name\nshow m.x\n")
  hold p4 = pg_emit_stream(0, "selfhost/seed_tests/ts_nest.sa", "selfhost/seed_tests/ts_nest_sm.c", 0, "selfhost/seed_tests/ts_nest_sm.c.emit.log", "selfhost/seed_tests/ts_nest_sm.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_nest_sm.c", "selfhost/seed_tests/ts_nest_sm", "-O2")
  hold p6 = pg_contains("selfhost/seed_tests/ts_nest_sm.c", "typedef struct { char *name; double x; } Point;")
  hold p7 = pg_contains("selfhost/seed_tests/ts_nest_sm.c", "typedef struct { Point a; Point b; } Line;")
  hold p8 = gl_assert_out("./selfhost/seed_tests/ts_nest_sm", "p1\n1\np2\n2\np2\n2", "selfhost/seed_tests/sxported.stdout")
  hold p9 = pg_emit_stream(1, "selfhost/seed_tests/ts_nest.sa", "selfhost/seed_tests/ts_nest_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_nest_g2.c.err")
  hold p10 = gl_compile_c("selfhost/seed_tests/ts_nest_g2.c", "selfhost/seed_tests/ts_nest_g2", "-O2")
  hold p11 = pg_contains("selfhost/seed_tests/ts_nest_g2.c", "typedef struct { char *name; double x; } Point;")
  hold p12 = pg_contains("selfhost/seed_tests/ts_nest_g2.c", "typedef struct { Point a; Point b; } Line;")
  hold p13 = gl_assert_out("./selfhost/seed_tests/ts_nest_g2", "p1\n1\np2\n2\np2\n2", "selfhost/seed_tests/sxported.stdout")
  hold p14 = gl_must_write("selfhost/seed_tests/ts_nest3.sa", "struct Point {\n  x,\n  y\n}\nstruct Rect {\n  o,\n  sz\n}\nstruct Scene {\n  r,\n  label\n}\nhold s = Scene { r: Rect { o: Point { 1, 2 }, sz: Point { 3, 4 } }, label: \"main\" }\nshow s.r.o.x\nshow s.r.o.y\nshow s.r.sz.x\nshow s.label\nhold rr = s.r\nshow rr.sz.y\n")
  hold p15 = pg_emit_stream(0, "selfhost/seed_tests/ts_nest3.sa", "selfhost/seed_tests/ts_nest3_sm.c", 0, "selfhost/seed_tests/ts_nest3_sm.c.emit.log", "selfhost/seed_tests/ts_nest3_sm.c.err")
  hold p16 = gl_compile_c("selfhost/seed_tests/ts_nest3_sm.c", "selfhost/seed_tests/ts_nest3_sm", "-O2")
  hold p17 = gl_assert_out("./selfhost/seed_tests/ts_nest3_sm", "1\n2\n3\nmain\n4", "selfhost/seed_tests/sxported.stdout")
  hold p18 = pg_emit_stream(1, "selfhost/seed_tests/ts_nest3.sa", "selfhost/seed_tests/ts_nest3_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_nest3_g2.c.err")
  hold p19 = gl_compile_c("selfhost/seed_tests/ts_nest3_g2.c", "selfhost/seed_tests/ts_nest3_g2", "-O2")
  hold p20 = pg_contains("selfhost/seed_tests/ts_nest3_g2.c", "typedef struct { Point o; Point sz; } Rect;")
  hold p21 = pg_contains("selfhost/seed_tests/ts_nest3_g2.c", "typedef struct { Rect r; char *label; } Scene;")
  hold p22 = gl_assert_out("./selfhost/seed_tests/ts_nest3_g2", "1\n2\n3\nmain\n4", "selfhost/seed_tests/sxported.stdout")
  hold p23 = gl_must_write("selfhost/seed_tests/ts_nestcopy.sa", "struct Point {\n  x\n}\nstruct Mid {\n  p\n}\nstruct Top {\n  q\n}\nhold t = Top { q: Mid { p: Point { x: 7 } } }\nhold p2 = t.q.p\nshow p2.x\n")
  hold p24 = pg_emit_stream(0, "selfhost/seed_tests/ts_nestcopy.sa", "selfhost/seed_tests/ts_nestcopy_sm.c", 0, "selfhost/seed_tests/ts_nestcopy_sm.c.emit.log", "selfhost/seed_tests/ts_nestcopy_sm.c.err")
  hold p25 = gl_compile_c("selfhost/seed_tests/ts_nestcopy_sm.c", "selfhost/seed_tests/ts_nestcopy_sm", "-O2")
  hold p26 = gl_assert_out("./selfhost/seed_tests/ts_nestcopy_sm", "7", "selfhost/seed_tests/sxported.stdout")
  hold p27 = pg_emit_stream(1, "selfhost/seed_tests/ts_nestcopy.sa", "selfhost/seed_tests/ts_nestcopy_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_nestcopy_g2.c.err")
  hold p28 = gl_compile_c("selfhost/seed_tests/ts_nestcopy_g2.c", "selfhost/seed_tests/ts_nestcopy_g2", "-O2")
  hold p29 = gl_assert_out("./selfhost/seed_tests/ts_nestcopy_g2", "7", "selfhost/seed_tests/sxported.stdout")
  hold p30 = gl_must_write("selfhost/seed_tests/ts_nestcopybad.sa", "struct Point {\n  x\n}\nhold q = Point { x: 1 }\nhold p2 = q.x.y\n")
  hold p31 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_nestcopybad.sa >/dev/null 2>&1", "test-nest refusal")
  hold p32 = gl_must_write("selfhost/seed_tests/ts_nestfwd.sa", "struct Line {\n  a\n}\nstruct Point {\n  x\n}\nhold l = Line { a: Point { 1 } }\n")
  hold p33 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_nestfwd.sa >/dev/null 2>&1", "test-nest refusal")
  hold p34 = pg_emit_stream(1, "selfhost/seed_tests/ts_nestfwd.sa", "selfhost/seed_tests/ts_nestfwd_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_nestfwd_g2.c.err")
  hold p35 = pg_contains("selfhost/seed_tests/ts_nestfwd_g2.c", "declare the nested struct first")
  hold p36 = gl_must_write("selfhost/seed_tests/ts_nestlist.sa", "struct Line {\n  a\n}\nhold l = Line { a: [1] }\nhold alias = l.a\npush(alias, 2)\nshow len(l.a)\nshow l.a[1]\n")
  hold p37 = pg_emit_stream(0, "selfhost/seed_tests/ts_nestlist.sa", "selfhost/seed_tests/ts_nestlist_sm.c", 0, "selfhost/seed_tests/ts_nestlist_sm.c.emit.log", "selfhost/seed_tests/ts_nestlist_sm.c.err")
  hold p38 = gl_compile_c("selfhost/seed_tests/ts_nestlist_sm.c", "selfhost/seed_tests/ts_nestlist_sm", "-O2")
  hold p39 = gl_assert_out("./selfhost/seed_tests/ts_nestlist_sm", "2\n2", "selfhost/seed_tests/sxported.stdout")
  hold p40 = pg_emit_stream(1, "selfhost/seed_tests/ts_nestlist.sa", "selfhost/seed_tests/ts_nestlist_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_nestlist_g2.c.err")
  hold p41 = gl_compile_c("selfhost/seed_tests/ts_nestlist_g2.c", "selfhost/seed_tests/ts_nestlist_g2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p42 = gl_assert_out("./selfhost/seed_tests/ts_nestlist_g2", "2\n2", "selfhost/seed_tests/sxported.stdout")
  hold p43 = pg_contains("selfhost/seed_tests/ts_nestlist_g2.c", "typedef struct { sx_list *a; } Line;")
  hold p44 = pg_contains("selfhost/seed_tests/ts_nestlist_g2.c", "sx_lget((l).a,1.0)")
  hold p45 = gl_must_write("selfhost/seed_tests/ts_nestmiss.sa", "struct Line {\n  a\n}\nhold l = Line { a: 1 }\nshow l.a.x\n")
  hold p46 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_nestmiss.sa >/dev/null 2>&1", "test-nest refusal")
  hold p47 = pg_emit_stream(1, "selfhost/seed_tests/ts_nestmiss.sa", "selfhost/seed_tests/ts_nestmiss_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_nestmiss_g2.c.err")
  hold p48 = pg_contains("selfhost/seed_tests/ts_nestmiss_g2.c", "is not a struct")
  hold p49 = gl_must_write("selfhost/seed_tests/ts_nestshow.sa", "struct Point {\n  x\n}\nhold q = Point { x: 1 }\nshow q\n")
  hold p50 = pg_emit_stream(1, "selfhost/seed_tests/ts_nestshow.sa", "selfhost/seed_tests/ts_nestshow_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_nestshow_g2.c.err")
  hold p51 = pg_contains("selfhost/seed_tests/ts_nestshow_g2.c", "show value cannot be a struct")
  give 0
}

make pg_test_prec() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_prec.sa", "hold a = 2\nshow a + 3 * 4\nshow a * 3 + 4\nshow 1 + 2 * 3\nshow a + 3 / 3\nshow a + 1 % 3\n")
  hold p3 = pg_emit_stream(0, "selfhost/seed_tests/ts_prec.sa", "selfhost/seed_tests/ts_prec_sm.c", 0, "selfhost/seed_tests/ts_prec_sm.c.emit.log", "selfhost/seed_tests/ts_prec_sm.c.err")
