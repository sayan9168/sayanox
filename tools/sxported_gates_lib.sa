make pg_test_fn2() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_ensure_dir("selfhost/seed_tests")
  hold p2 = gl_must_write("selfhost/seed_tests/ts_fn2.sa", "make add(a, b) {\n  give a + b\n}\nmake fac(n) {\n  when n <= 1 {\n    give 1\n  }\n  give n * fac(n - 1)\n}\nhold r = add(40, 2)\nshow r\nshow fac(5)\nshow add(r, 1)\n")
  hold p3 = pg_emit_stream(1, "selfhost/seed_tests/ts_fn2.sa", "selfhost/seed_tests/ts_fn2.c", 0, "/dev/null", "selfhost/seed_tests/ts_fn2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/ts_fn2.c", "selfhost/seed_tests/ts_fn2", "-O2")
  hold p5 = gl_assert_out("./selfhost/seed_tests/ts_fn2", "42\n120\n43", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_must_write("selfhost/seed_tests/ts_fn3.sa", "make f(n) {\n  when n <= 0 { give 0 }\n  give n * 2\n}\nshow f(3)\n")
  hold p7 = pg_emit_stream(1, "selfhost/seed_tests/ts_fn3.sa", "selfhost/seed_tests/ts_fn3.c", 0, "/dev/null", "selfhost/seed_tests/ts_fn3.c.err")
  hold p8 = pg_contains("selfhost/seed_tests/ts_fn3.c", "#error")
  give 0
}

