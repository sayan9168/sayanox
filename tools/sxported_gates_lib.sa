  give 0
}

make pg_test_float() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_float.sa", "hold x = 2.5\nshow x\nshow x * 2\nshow 10 / 4\nshow 7 / 2 * 2\nshow 1 / 3\nhold xs = [1.5, 2]\nshow xs[0]\nstruct P {\n  v\n}\nhold p = P { v: 1.25 }\nshow p.v\nwhen x > 2.4 {\n  show 1\n}\nshow 10 % 4\nshow 0.5 + 0.25\nhold y = -1.5\nshow y\nshow 5 % 2.5\n")
  hold p4 = pg_emit_stream(0, "selfhost/seed_tests/ts_float.sa", "selfhost/seed_tests/ts_float_sm.c", 0, "selfhost/seed_tests/ts_float_sm.c.emit.log", "selfhost/seed_tests/ts_float_sm.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_float_sm.c", "selfhost/seed_tests/ts_float_sm", "-O2")
  hold p6 = gl_assert_out("./selfhost/seed_tests/ts_float_sm", "2.5\n5\n2.5\n7\n0.333333\n1.5\n1.25\n1\n2\n0.75\n-1.5\n1", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pg_emit_stream(1, "selfhost/seed_tests/ts_float.sa", "selfhost/seed_tests/ts_float_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_float_g2.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/ts_float_g2.c", "selfhost/seed_tests/ts_float_g2", "-O2")
  hold p9 = gl_assert_out("./selfhost/seed_tests/ts_float_g2", "2.5\n5\n2.5\n7\n0.333333\n1.5\n1.25\n1\n2\n0.75\n-1.5\n1", "selfhost/seed_tests/sxported.stdout")
  hold p10 = gl_must_write("selfhost/seed_tests/ts_floatbad.sa", "hold x = 2.\nshow x\n")
  hold p11 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_floatbad.sa >/dev/null 2>&1", "test-float refusal")
  hold p12 = pg_emit_stream(1, "selfhost/seed_tests/ts_floatbad.sa", "selfhost/seed_tests/ts_floatbad_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_floatbad_g2.c.err")
  hold p13 = pg_contains("selfhost/seed_tests/ts_floatbad_g2.c", "#error")
  hold p14 = gl_must_write("selfhost/seed_tests/ts_float3.sa", "hold x = 1.2.3\nshow x\nshow \"v1.2.3\"\n")
  hold p15 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_float3.sa >/dev/null 2>&1", "test-float refusal")
  hold p16 = pg_emit_stream(1, "selfhost/seed_tests/ts_float3.sa", "selfhost/seed_tests/ts_float3_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_float3_g2.c.err")
  hold p17 = pg_contains("selfhost/seed_tests/ts_float3_g2.c", "malformed number literal")
  hold p18 = gl_must_write("selfhost/seed_tests/ts_float4.sa", "show \"v1.2.3\"\n// 4.5.6 in a comment\nhold v1 = 2.5\nshow v1\n")
  hold p19 = pg_emit_stream(1, "selfhost/seed_tests/ts_float4.sa", "selfhost/seed_tests/ts_float4_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_float4_g2.c.err")
  hold p20 = gl_compile_c("selfhost/seed_tests/ts_float4_g2.c", "selfhost/seed_tests/ts_float4_g2", "-O2")
  hold p21 = gl_assert_out("./selfhost/seed_tests/ts_float4_g2", "v1.2.3\n2.5", "selfhost/seed_tests/sxported.stdout")
  hold p22 = gl_must_write("selfhost/seed_tests/ts_big.sa", "show 100000 * 100000\nshow 100000 + 100000 * 100000\nshow 100000 * 100000.0\nshow (100000 * 100000) / 2\nhold a = 100000\nshow a * 100000\nwhen 100000 * 100000 > 2000000000 {\n  show 1\n} else {\n  show 0\n}\nmake big() {\n  give 100000 * 100000\n}\nmake pass(n) {\n  give n\n}\nshow big()\nshow pass(100000 * 100000)\n")
  hold p23 = pg_emit_stream(0, "selfhost/seed_tests/ts_big.sa", "selfhost/seed_tests/ts_big_sm.c", 0, "selfhost/seed_tests/ts_big_sm.c.emit.log", "selfhost/seed_tests/ts_big_sm.c.err")
  hold p24 = gl_compile_c("selfhost/seed_tests/ts_big_sm.c", "selfhost/seed_tests/ts_big_sm", "-O2")
  hold p25 = gl_assert_out("./selfhost/seed_tests/ts_big_sm", "1e+10\n1.00001e+10\n1e+10\n5e+09\n1e+10\n1\n1e+10\n1e+10", "selfhost/seed_tests/sxported.stdout")
  hold p26 = pg_emit_stream(1, "selfhost/seed_tests/ts_big.sa", "selfhost/seed_tests/ts_big_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_big_g2.c.err")
  hold p27 = gl_compile_c("selfhost/seed_tests/ts_big_g2.c", "selfhost/seed_tests/ts_big_g2", "-O2")
  hold p28 = gl_assert_out("./selfhost/seed_tests/ts_big_g2", "1e+10\n1.00001e+10\n1e+10\n5e+09\n1e+10\n1\n1e+10\n1e+10", "selfhost/seed_tests/sxported.stdout")
  hold p29 = gl_must_write("selfhost/seed_tests/ts_modzero.sa", "hold zero = 0\nshow 7 % zero\n")
  hold p30 = pg_emit_stream(0, "selfhost/seed_tests/ts_modzero.sa", "selfhost/seed_tests/ts_modzero_sm.c", 0, "selfhost/seed_tests/ts_modzero_sm.c.emit.log", "selfhost/seed_tests/ts_modzero_sm.c.err")
  hold p31 = gl_compile_c("selfhost/seed_tests/ts_modzero_sm.c", "selfhost/seed_tests/ts_modzero_sm", "-O2")
  hold p32 = pg_expect_failure("./selfhost/seed_tests/ts_modzero_sm >/dev/null 2>selfhost/seed_tests/ts_modzero_sm.err", "test-float refusal")
  hold p33 = pg_contains("selfhost/seed_tests/ts_modzero_sm.err", "division by zero")
  hold p34 = pg_emit_stream(1, "selfhost/seed_tests/ts_modzero.sa", "selfhost/seed_tests/ts_modzero_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_modzero_g2.c.err")
  hold p35 = gl_compile_c("selfhost/seed_tests/ts_modzero_g2.c", "selfhost/seed_tests/ts_modzero_g2", "-O2")
  hold p36 = pg_expect_failure("./selfhost/seed_tests/ts_modzero_g2 >/dev/null 2>selfhost/seed_tests/ts_modzero_g2.err", "test-float refusal")
  hold p37 = pg_contains("selfhost/seed_tests/ts_modzero_g2.err", "division by zero")
  give 0
}

make pg_test_parens() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/ts_parens.sa", "hold a = 2\nshow (a + 3) * 4\nshow 4 * (a + 3)\nhold b = (a + 1) % 2\nshow b\nshow ((a))\nshow (10 / 4) * 2\nshow -(a + 1)\nshow (a % 3 + 1) * 2\nhold b = (b + 1) * 10\nshow b\nshow (a < 3) + 1\nmake f(x) {\n  give (x + 1) * 2\n}\nshow (f(2) + 1) * 2\nmake g(x) {\n  give x % 3\n}\nshow g(7)\nwhen (a + 1) * 2 == 6 {\n  show 6\n}\n")
  hold p4 = pg_emit_stream(0, "selfhost/seed_tests/ts_parens.sa", "selfhost/seed_tests/ts_parens_sm.c", 0, "selfhost/seed_tests/ts_parens_sm.c.emit.log", "selfhost/seed_tests/ts_parens_sm.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/ts_parens_sm.c", "selfhost/seed_tests/ts_parens_sm", "-O2")
  hold p6 = gl_assert_out("./selfhost/seed_tests/ts_parens_sm", "20\n20\n1\n2\n5\n-3\n6\n20\n2\n14\n1\n6", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pg_emit_stream(1, "selfhost/seed_tests/ts_parens.sa", "selfhost/seed_tests/ts_parens_g2.c", 0, "/dev/null", "selfhost/seed_tests/ts_parens_g2.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/ts_parens_g2.c", "selfhost/seed_tests/ts_parens_g2", "-O2")
  hold p9 = gl_assert_out("./selfhost/seed_tests/ts_parens_g2", "20\n20\n1\n2\n5\n-3\n6\n20\n2\n14\n1\n6", "selfhost/seed_tests/sxported.stdout")
  hold p10 = gl_must_write("selfhost/seed_tests/ts_parenstr.sa", "hold s = \"x\"\nshow (s + 1) * 2\n")
  hold p11 = pg_emit_stream(1, "selfhost/seed_tests/ts_parenstr.sa", "selfhost/seed_tests/ts_parenstr_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_parenstr_g2.c.err")
  hold p12 = pg_contains("selfhost/seed_tests/ts_parenstr_g2.c", "parenthesized expression must be numeric")
  hold p13 = gl_must_write("selfhost/seed_tests/ts_parenb.sa", "show (len(\"ab\") + 1) * 2\n")
  hold p14 = pg_emit_stream(1, "selfhost/seed_tests/ts_parenb.sa", "selfhost/seed_tests/ts_parenb_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_parenb_g2.c.err")
  hold p15 = gl_compile_c("selfhost/seed_tests/ts_parenb_g2.c", "selfhost/seed_tests/ts_parenb_g2", "-O2")
  hold p16 = gl_assert_out("./selfhost/seed_tests/ts_parenb_g2", "6", "selfhost/seed_tests/sxported.stdout")
  hold p17 = gl_must_write("selfhost/seed_tests/ts_parenu.sa", "show (1 + 2\n")
  hold p18 = pg_emit_stream(1, "selfhost/seed_tests/ts_parenu.sa", "selfhost/seed_tests/ts_parenu_g2.c", 1, "/dev/null", "selfhost/seed_tests/ts_parenu_g2.c.err")
  hold p19 = pg_contains("selfhost/seed_tests/ts_parenu_g2.c", "unbalanced '('")
  hold p20 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/ts_parenu.sa >/dev/null 2>&1", "test-parens refusal")
  give 0
}

make pg_test_full_lang() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/fl_for.sa", "hold total = 0\nfor i in 0..5 {\n  hold total = total + i\n}\nshow total\nhold k = 1\nfor k in 1..100 {\n  when k == 4 {\n    break\n  }\n}\nshow k\nhold odd = 0\nfor i in 0..10 {\n  when i % 2 == 0 {\n    continue\n  }\n  hold odd = odd + 1\n}\nshow odd\n")
  hold p4 = pg_emit_stream(1, "selfhost/seed_tests/fl_for.sa", "selfhost/seed_tests/fl_for.c", 0, "/dev/null", "selfhost/seed_tests/fl_for.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/fl_for.c", "selfhost/seed_tests/fl_for", "-O2")
  hold p6 = gl_assert_out("./selfhost/seed_tests/fl_for", "10\n4\n5", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pg_emit_stream(0, "selfhost/seed_tests/fl_for.sa", "selfhost/seed_tests/fl_for_seed.c", 0, "selfhost/seed_tests/fl_for_seed.c.emit.log", "selfhost/seed_tests/fl_for_seed.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/fl_for_seed.c", "selfhost/seed_tests/fl_for_seed", "-O2")
  hold p9 = gl_assert_out("./selfhost/seed_tests/fl_for_seed", "10\n4\n5", "selfhost/seed_tests/sxported.stdout")
  hold p10 = gl_must_write("selfhost/seed_tests/fl_list.sa", "hold xs = [3, 4, 5]\nhold sum = 0\nfor v in xs {\n  hold sum = sum + v\n}\nshow sum\nfor v in xs {\n  when v == 4 {\n    continue\n  }\n  show v\n}\n")
  hold p11 = pg_emit_stream(1, "selfhost/seed_tests/fl_list.sa", "selfhost/seed_tests/fl_list.c", 0, "/dev/null", "selfhost/seed_tests/fl_list.c.err")
  hold p12 = gl_compile_c("selfhost/seed_tests/fl_list.c", "selfhost/seed_tests/fl_list", "-O2")
  hold p13 = gl_assert_out("./selfhost/seed_tests/fl_list", "12\n3\n5", "selfhost/seed_tests/sxported.stdout")
  hold p14 = gl_must_write("selfhost/seed_tests/fl_elif.sa", "hold grade = 0\nhold score = 85\nwhen score >= 90 {\n  hold grade = 4\n} elif score >= 80 {\n  hold grade = 3\n} elif score >= 70 {\n  hold grade = 2\n} otherwise {\n  hold grade = 1\n}\nshow grade\nwhen score >= 80 {\n  hold grade = 9\n} elif score >= 70 {\n  hold grade = 8\n}\nshow grade\n")
  hold p15 = pg_emit_stream(1, "selfhost/seed_tests/fl_elif.sa", "selfhost/seed_tests/fl_elif.c", 0, "/dev/null", "selfhost/seed_tests/fl_elif.c.err")
  hold p16 = gl_compile_c("selfhost/seed_tests/fl_elif.c", "selfhost/seed_tests/fl_elif", "-O2")
  hold p17 = gl_assert_out("./selfhost/seed_tests/fl_elif", "3\n9", "selfhost/seed_tests/sxported.stdout")
  hold p18 = pg_emit_stream(0, "selfhost/seed_tests/fl_elif.sa", "selfhost/seed_tests/fl_elif_sm.c", 0, "selfhost/seed_tests/fl_elif_sm.c.emit.log", "selfhost/seed_tests/fl_elif_sm.c.err")
  hold p19 = gl_compile_c("selfhost/seed_tests/fl_elif_sm.c", "selfhost/seed_tests/fl_elif_sm", "-O2")
  hold p20 = gl_assert_out("./selfhost/seed_tests/fl_elif_sm", "3\n9", "selfhost/seed_tests/sxported.stdout")
  hold p21 = gl_must_write("selfhost/seed_tests/fl_fn.sa", "make greet(name: str) -> str {\n  give concat(\"hi \", name)\n}\nmake twice(n: num) -> num {\n  give n * 2\n}\nhold m = greet(\"ada\")\nshow m\nshow twice(21)\nshow len(m)\n")
  hold p22 = pg_emit_stream(1, "selfhost/seed_tests/fl_fn.sa", "selfhost/seed_tests/fl_fn.c", 0, "/dev/null", "selfhost/seed_tests/fl_fn.c.err")
  hold p23 = gl_compile_c("selfhost/seed_tests/fl_fn.c", "selfhost/seed_tests/fl_fn", "-O2")
  hold p24 = gl_assert_out("./selfhost/seed_tests/fl_fn", "hi ada\n42\n6", "selfhost/seed_tests/sxported.stdout")
  hold p25 = gl_must_write("selfhost/seed_tests/fl_type.sa", "hold n: num = 4\nhold s: str = \"abc\"\nhold xs: list = [1, 2]\nshow n + len(xs)\nshow s\nhold ok = 0\nwhen n > 2 and s != \"z\" {\n  hold ok = 1\n}\nshow ok\nwhen not ok or n == 0 {\n  show 7\n} otherwise {\n  show 8\n}\nhold flag = true\nshow flag\n")
  hold p26 = pg_emit_stream(1, "selfhost/seed_tests/fl_type.sa", "selfhost/seed_tests/fl_type.c", 0, "/dev/null", "selfhost/seed_tests/fl_type.c.err")
  hold p27 = gl_compile_c("selfhost/seed_tests/fl_type.c", "selfhost/seed_tests/fl_type", "-O2")
  hold p28 = gl_assert_out("./selfhost/seed_tests/fl_type", "6\nabc\n1\n8\n1", "selfhost/seed_tests/sxported.stdout")
  hold p29 = gl_must_write("selfhost/seed_tests/fl_comp.sa", "hold s = \"a\"\nhold s += \"b\"\nshow s\nhold x = 10\nhold x += 5\nhold x -= 3\nhold x *= 2\nshow x\nhold x /= 4\nhold x %= 4\nshow x\n")
  hold p30 = pg_emit_stream(1, "selfhost/seed_tests/fl_comp.sa", "selfhost/seed_tests/fl_comp.c", 0, "/dev/null", "selfhost/seed_tests/fl_comp.c.err")
  hold p31 = gl_compile_c("selfhost/seed_tests/fl_comp.c", "selfhost/seed_tests/fl_comp", "-O2")
  hold p32 = gl_assert_out("./selfhost/seed_tests/fl_comp", "ab\n24\n2", "selfhost/seed_tests/sxported.stdout")
  hold p33 = gl_must_write("selfhost/seed_tests/fl_badtype.sa", "hold n: str = 5\n")
  hold p34 = pg_emit_stream(1, "selfhost/seed_tests/fl_badtype.sa", "selfhost/seed_tests/fl_badtype.c", 1, "/dev/null", "selfhost/seed_tests/fl_badtype.c.err")
  hold p35 = pg_contains("selfhost/seed_tests/fl_badtype.c", "type error: 'n' is declared str but the value is a number")
  hold p36 = gl_must_write("selfhost/seed_tests/fl_badbreak.sa", "hold n = 1\nbreak\n")
  hold p37 = pg_emit_stream(1, "selfhost/seed_tests/fl_badbreak.sa", "selfhost/seed_tests/fl_badbreak.c", 1, "/dev/null", "selfhost/seed_tests/fl_badbreak.c.err")
  hold p38 = pg_contains("selfhost/seed_tests/fl_badbreak.c", "break/continue outside a loop")
  hold p39 = gl_must_write("selfhost/seed_tests/fl_badcomp.sa", "hold n = 1\nhold m += 1\n")
  hold p40 = pg_emit_stream(1, "selfhost/seed_tests/fl_badcomp.sa", "selfhost/seed_tests/fl_badcomp.c", 1, "/dev/null", "selfhost/seed_tests/fl_badcomp.c.err")
  hold p41 = pg_contains("selfhost/seed_tests/fl_badcomp.c", "compound assignment needs an existing variable")
  hold p42 = gl_must_write("selfhost/seed_tests/fl_badlist.sa", "hold xs = [1, 2]\nfor v in xs {\n  break\n}\nhold ys = 1\nfor v in ys {\n}\n")
  hold p43 = pg_emit_stream(1, "selfhost/seed_tests/fl_badlist.sa", "selfhost/seed_tests/fl_badlist.c", 1, "/dev/null", "selfhost/seed_tests/fl_badlist.c.err")
  hold p44 = pg_contains("selfhost/seed_tests/fl_badlist.c", "for loop: 'ys' is not a list")
  give 0
}

make pg_test_native_strord() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/native_strord_test.sa", "selfhost/seed_tests/nso_sm.c", 0, "selfhost/seed_tests/nso_sm.c.emit.log", "selfhost/seed_tests/nso_sm.c.err")
