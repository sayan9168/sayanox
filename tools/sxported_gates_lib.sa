  hold p3 = pg_emit_stream(1, "selfhost/native_for_functions_test.sa", "selfhost/seed_tests/nff_gen2.c", 0, "selfhost/seed_tests/nff_gen2.c.emit.log", "selfhost/seed_tests/nff_gen2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/nff_gen2.c", "selfhost/seed_tests/nff_gen2", "-O2")
  hold p5 = pg_emit_stream(2, "selfhost/native_for_functions_test.sa", "selfhost/seed_tests/nff_native", 0, "selfhost/seed_tests/nff_native.emit.log", "selfhost/seed_tests/nff_native.err")
  hold p6 = gl_assert_out("./selfhost/seed_tests/nff_seed", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done\n3\n8\n21", "selfhost/seed_tests/sxported.stdout")
  hold p7 = gl_assert_out("./selfhost/seed_tests/nff_gen2", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done\n3\n8\n21", "selfhost/seed_tests/sxported.stdout")
  hold p8 = gl_assert_out("./selfhost/seed_tests/nff_native", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done\n3\n8\n21", "selfhost/seed_tests/sxported.stdout")
  hold p9 = pg_emit_stream(2, "selfhost/native_for_gc_test.sa", "selfhost/seed_tests/nff_gc", 0, "selfhost/seed_tests/nff_gc.emit.log", "selfhost/seed_tests/nff_gc.err")
  hold p10 = gl_assert_out("./selfhost/seed_tests/nff_gc", "30\n1\n1\n99\n7", "selfhost/seed_tests/sxported.stdout")
  hold p11 = gl_must_write("selfhost/seed_tests/nff_bad.sa", "make bad(s: str) -> num {\n for s in 0..2 { show s }\n give 0\n}\nshow bad(\"x\")\n")
  hold p12 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/nff_bad.sa selfhost/seed_tests/nff_bad 2>selfhost/seed_tests/nff_bad.err", "test-native-for-functions refusal")
  hold p13 = pg_contains("selfhost/seed_tests/nff_bad.err", "two different types")
  hold p14 = gl_must_write("selfhost/seed_tests/nff_names.sa", "make f() -> num {\n hold total = 0\n for v in [1, 2, 3] {\n hold __for0_idx = 999\n total = total + 1\n }\n give total\n}\nshow f()\n")
  hold p15 = pg_emit_stream(2, "selfhost/seed_tests/nff_names.sa", "selfhost/seed_tests/nff_names", 0, "selfhost/seed_tests/nff_names.emit.log", "selfhost/seed_tests/nff_names.err")
  hold p16 = gl_assert_out("./selfhost/seed_tests/nff_names", "3", "selfhost/seed_tests/sxported.stdout")
  give 0
}

