// Immutable dependency names, not executable legacy recipes.
make ag_known(name: str) -> num {
  when string_eq(name, "native-bootstrap") == 1 || string_eq(name, "test-native-bootstrap") == 1 { give 1 }
  when string_eq(name, "test-full-seed-diagnostics") == 1 || string_eq(name, "test-recovery") == 1 { give 1 }
  when string_eq(name, "test-network") == 1 || string_eq(name, "test-http-get") == 1 || string_eq(name, "test-sayacrawl") == 1 || string_eq(name, "ci") == 1 { give 1 }
  when string_eq(name, "native-test") == 1 || string_eq(name, "native-test-body") == 1 { give 1 }
  when string_eq(name, "test-language-deps") == 1 { give 1 }
  when string_eq(name, "all") == 1 { give 1 }
  when string_eq(name, "selfhost/gen1.c") == 1 { give 1 }
  when string_eq(name, "selfhost/gen1") == 1 { give 1 }
  when string_eq(name, "true-selfhost-min") == 1 { give 1 }
  when string_eq(name, "true-selfhost-full") == 1 { give 1 }
  when string_eq(name, "true-selfhost") == 1 { give 1 }
  when string_eq(name, "selfhost") == 1 { give 1 }
  when string_eq(name, "grammar") == 1 { give 1 }
  when string_eq(name, "gc-test") == 1 { give 1 }
  when string_eq(name, "gen3") == 1 { give 1 }
  when string_eq(name, "subset") == 1 { give 1 }
  when string_eq(name, "test") == 1 { give 1 }
  when string_eq(name, "test-seed-sanitize") == 1 { give 1 }
  give 0
}
