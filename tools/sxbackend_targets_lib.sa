// Backend target declarations and native tool dependencies.
make xb_name(index: num) -> str {
  when index == 0 { give "test-native-sxlink" }
  when index == 1 { give "test-native-sxencode" }
  when index == 2 { give "test-native-sxruntime" }
  when index == 3 { give "test-native-sxgc" }
  when index == 4 { give "test-native-sxemit" }
  give ""
}
make xb_count() -> num { give 5 }
make xb_known(name: str) -> num {
  hold i = 0
  while i < xb_count() {
    when string_eq(name, xb_name(i)) == 1 { give 1 }
    i = i + 1
  }
  give 0
}
