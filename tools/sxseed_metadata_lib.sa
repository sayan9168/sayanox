// Fault-inject metadata allocation in the actual seed-emitted C runtime.
// Not a bounded-heap or full native-runtime GC claim.
// Four modes: success, failed bucket calloc, failed pointer-array realloc,
// and failed bitmap realloc after the pointer array has already shrunk.
// Follow each with retry and test growth again after the last partial failure.
// The C is a compatibility-output probe; no maintained .c or interpreter is added.
make sgm_test_metadata() -> num {
  hold prelude = "#include <stdlib.h>\n#include <assert.h>\n/* Macro interception affects this translation unit, not libc internals. */\nstatic int mg_calloc_fail, mg_realloc_fail, mg_realloc_calls, mg_failures;\nstatic void *mg_calloc(size_t n,size_t z){\n  if(mg_calloc_fail){ mg_failures++; return NULL; }\n  return calloc(n,z);\n}\nstatic void *mg_realloc(void *p,size_t n){\n  mg_realloc_calls++;\n  if(mg_realloc_fail && mg_realloc_calls==mg_realloc_fail){ mg_failures++; return NULL; }\n  return realloc(p,n);\n}\n#define calloc mg_calloc\n#define realloc mg_realloc\n#define main mg_original_main\n"
  hold body = "\n#undef main\n#undef calloc\n#undef realloc\n/* Use the real emitted seed runtime, but not the fixture's application. */\nstatic void mg_fill(void **roots){\n  for(size_t i=2;i<8192;i++) roots[i]=sx_gc_alloc(1,32);\n}\nstatic void mg_numeric_leaf(void){\n  sx_list *volatile numbers=sx_llit(2,12.0,34.0);\n  char *volatile target=sx_sb_from(\"numeric-not-pointer\");\n  void **volatile edge=(void**)sx_gc_alloc(1,sizeof(void*));\n  edge[0]=(void*)target;\n  uintptr_t bits=(uintptr_t)target;\n  _Static_assert(sizeof(double)==sizeof(uintptr_t), \"x86-64 numeric layout\");\n  memcpy(numbers->d,&bits,sizeof bits);\n  sx_gc_collect();\n  size_t n=sx_sb_count, header=n, data=n, object=n, generic=n;\n  for(size_t j=0;j<n;j++){\n    char *p=sx_gc_arr[j]->data;\n    if(p==(char*)numbers) header=j;\n    if(p==(char*)numbers->d) data=j;\n    if(p==(char*)target) object=j;\n    if(p==(char*)edge) generic=j;\n  }\n  assert(header<n && data<n && object<n && generic<n);\n  assert(sx_gc_arr[data]->kind==2);\n  /* Isolate heap tracing from conservative stack false roots. No sweep. */\n  memset(sx_gc_bits,0,n); sx_gc_bits[header]=1;\n  sx_gc_trace(n);\n  assert(sx_gc_bits[data] && !sx_gc_bits[object]);\n  assert(numbers->n==2 && numbers->d[1]==34.0);\n  sx_gc_bits[generic]=1; sx_gc_trace(n);\n  assert(sx_gc_bits[object]);\n  /* Grow the numeric buffer without changing its header/borrowed alias. */\n  sx_list *volatile alias=numbers;\n  numbers=sx_lpush(numbers,56.0); numbers=sx_lpush(numbers,67.0);\n  numbers=sx_lpush(numbers,78.0);\n  /* A real subsequent collection still preserves header/data aliases. */\n  sx_gc_collect();\n  assert(alias==numbers && alias->n==5 && alias->d[4]==78.0);\n  assert(sx_sb_is((char*)numbers) && sx_sb_is((char*)numbers->d));\n  assert(sx_sb_is((char*)target) && edge[0]==(void*)target);\n  puts(\"metadata-numeric-leaf-ok: pointer-shaped numbers ignored; generic edges preserved\");\n}\nstatic int mg_probe(void){\n  void **volatile roots;\n  sx_gc_collect(); /* Empty, before any scratch allocation: no NULL qsort. */\n  assert(sx_gc_n==1 && sx_gc_freed==0 && sx_gc_cap==0);\n  sx_gc_thresh=(size_t)-1;\n  roots=(void**)sx_gc_alloc(1,8192*sizeof(void*));\n  roots[0]=sx_gc_alloc(1,32); roots[1]=sx_gc_alloc(1,32);\n  ((void**)roots[0])[0]=roots[1]; ((void**)roots[1])[0]=roots[0];\n  ((size_t*)roots[0])[2]=123; ((size_t*)roots[1])[2]=456;\n  for(int mode=0;mode<4;mode++){\n    sx_gc_thresh=(size_t)-1;\n    mg_fill(roots);\n    sx_gc_collect();\n    assert(sx_sb_count>=8193 && sx_sb_nbucket>=8192 && sx_gc_cap>=8193);\n    size_t old_buckets=sx_sb_nbucket, old_cap=sx_gc_cap;\n    unsigned char *old_bits=sx_gc_bits;\n    /* Retain the array, aliases and cycle; drop thousands of payloads. */\n    memset(roots+2,0,(8192-2)*sizeof(void*));\n    mg_calloc_fail=(mode==1);\n    mg_realloc_fail=(mode==2 ? 1 : (mode==3 ? 2 : 0));\n    mg_realloc_calls=0; mg_failures=0;\n    sx_gc_collect();\n    assert(sx_sb_count>=3 && sx_sb_count<32);\n    assert(sx_sb_is((char*)roots) && sx_sb_is((char*)roots[0]) && sx_sb_is((char*)roots[1]));\n    assert(((void**)roots[0])[0]==roots[1] && ((void**)roots[1])[0]==roots[0]);\n    assert(((size_t*)roots[0])[2]==123 && ((size_t*)roots[1])[2]==456);\n    assert(!sx_sb_is((char*)roots[0]+1)); /* exact registry lookup */\n    assert(!sx_sb_is((char*)&old_buckets)); /* foreign stack pointer */\n    assert(sx_sb_nbucket==(mode==1 ? old_buckets : 1024));\n    assert(sx_gc_cap==(mode==2 ? old_cap : 1024));\n    assert(mg_failures==(mode==0 ? 0 : 1));\n    if(mode==3) assert(sx_gc_bits==old_bits && mg_realloc_calls==2);\n    if(mode==0){\n      printf(\"metadata buckets: %zu -> %zu\\n\",old_buckets,sx_sb_nbucket);\n      printf(\"metadata scratch: %zu -> %zu\\n\",old_cap,sx_gc_cap);\n    }\n    mg_calloc_fail=mg_realloc_fail=0;\n    sx_gc_collect();\n    assert(sx_sb_nbucket==1024 && sx_gc_cap==1024);\n    /* The next iteration regrows both structures after partial failures. */\n  }\n  sx_gc_thresh=(size_t)-1;\n  mg_fill(roots); sx_gc_collect();\n  assert(sx_sb_count>=8193 && sx_gc_cap>=8193);\n  memset(roots+2,0,(8192-2)*sizeof(void*));\n  sx_gc_collect();\n  assert(sx_sb_nbucket==1024 && sx_gc_cap==1024);\n  /* Deterministic empty-registry setup: explicitly release managed blocks.\n     Conservative stack remnants are not a reliable way to force zero live. */\n  for(int round=0;round<3;round++){\n    for(size_t bucket=0;bucket<sx_sb_nbucket;bucket++)\n      while(sx_sb_buckets[bucket]) sx_sb_free(sx_sb_buckets[bucket]->data);\n    roots=NULL;\n    assert(sx_sb_count==0 && sx_gc_bytes==0);\n    mg_calloc_fail=1; mg_realloc_fail=1; mg_realloc_calls=mg_failures=0;\n    sx_gc_collect();\n    assert(sx_sb_nbucket==0 && sx_gc_cap==0);\n    assert(!sx_sb_buckets && !sx_gc_arr && !sx_gc_bits);\n    assert(mg_realloc_calls==0 && mg_failures==0);\n    assert(sx_gc_freed==0 && sx_gc_live()==0);\n    /* Repeated empty collection is allocation-free and counts exactly once. */\n    double runs=sx_gc_count();\n    sx_gc_collect();\n    assert(sx_gc_count()==runs+1 && sx_gc_run()==0);\n    assert(!sx_sb_buckets && !sx_gc_arr && !sx_gc_bits);\n    mg_calloc_fail=mg_realloc_fail=0;\n    sx_gc_thresh=(size_t)-1;\n    roots=(void**)sx_gc_alloc(1,8192*sizeof(void*));\n    roots[0]=sx_gc_alloc(1,32); roots[1]=sx_gc_alloc(1,32);\n    mg_fill(roots); sx_gc_collect();\n    assert(sx_sb_count>=8193 && sx_gc_cap>=8193 && sx_sb_nbucket>=8192);\n    assert(sx_sb_is((char*)roots) && sx_sb_is((char*)roots[8191]));\n  }\n  puts(\"metadata-empty-ok: 3 release/regrowth rounds; allocation-free empty collections\");\n  mg_numeric_leaf();\n  puts(\"metadata-shrink-ok: 4 cases; aliases, failures, regrowth, empty collection\");\n  return 0;\n}\nint main(void){\n  char anchor; sx_gc_init(&anchor);\n  int (*volatile entry)(void)=mg_probe;\n  return entry();\n}\n"
  hold base = "selfhost/seed_tests/seed-metadata"
  hold source = gl_must_write(concat(base, ".c"), concat(prelude, concat(read_file("selfhost/seed_tests/sgc_drop_ms.c"), body)))
  hold want = "metadata buckets: 16384 -> 1024\nmetadata scratch: 8193 -> 1024\nmetadata-empty-ok: 3 release/regrowth rounds; allocation-free empty collections\nmetadata-numeric-leaf-ok: pointer-shaped numbers ignored; generic edges preserved\nmetadata-shrink-ok: 4 cases; aliases, failures, regrowth, empty collection"
  hold mode = 0
  while mode < 3 {
    hold flags = "-O0 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types"
    when mode == 1 { flags = "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types" }
    when mode == 2 { flags = "-O2 -g -fno-omit-frame-pointer -fno-pie -no-pie -fsanitize=address,undefined -fno-sanitize-recover=all" }
    hold bin = concat(base, concat("-", numstr(mode)))
    when mode == 1 { bin = base } // Preserve the existing sanitizer gate oracle.
    hold cc = gl_compile_c(concat(base, ".c"), bin, flags)
    hold cmd = concat("./", bin)
    when mode == 2 { cmd = concat("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ", cmd) }
    hold run = gl_assert_out(cmd, want, concat(bin, ".out"))
    mode = mode + 1
  }
  show "[OK] seed metadata: shrink/failure/empty-release/numeric-leaf/regrowth at O0/O2 and ASan+UBSan"
  give 0
}
