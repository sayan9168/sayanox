// Fault-inject metadata allocation in the actual seed-emitted C runtime.
// Not a bounded-heap or full native-runtime GC claim.
// Four modes: success, failed bucket calloc, failed pointer-array realloc,
// and failed bitmap realloc after the pointer array has already shrunk.
// Follow each with retry and test growth again after the last partial failure.
// The C is a compatibility-output probe; no maintained .c or interpreter is added.
make sgm_test_metadata() -> num {
  hold prelude = "#include <stdlib.h>\n#include <assert.h>\n/* Macro interception affects this translation unit, not libc internals. */\nstatic int mg_calloc_fail, mg_realloc_fail, mg_realloc_calls, mg_failures;\nstatic void *mg_calloc(size_t n,size_t z){\n  if(mg_calloc_fail){ mg_failures++; return NULL; }\n  return calloc(n,z);\n}\nstatic void *mg_realloc(void *p,size_t n){\n  mg_realloc_calls++;\n  if(mg_realloc_fail && mg_realloc_calls==mg_realloc_fail){ mg_failures++; return NULL; }\n  return realloc(p,n);\n}\n#define calloc mg_calloc\n#define realloc mg_realloc\n#define main mg_original_main\n"
  hold body = "\n#undef main\n#undef calloc\n#undef realloc\n/* Use the real emitted seed runtime, but not the fixture's application. */\nstatic void mg_fill(void **roots){\n  for(size_t i=2;i<8192;i++) roots[i]=sx_gc_alloc(1,32);\n}\nstatic int mg_probe(void){\n  void **volatile roots;\n  sx_gc_collect(); /* Empty, before any scratch allocation: no NULL qsort. */\n  assert(sx_gc_n==1 && sx_gc_freed==0 && sx_gc_cap==0);\n  sx_gc_thresh=(size_t)-1;\n  roots=(void**)sx_gc_alloc(1,8192*sizeof(void*));\n  roots[0]=sx_gc_alloc(1,32); roots[1]=sx_gc_alloc(1,32);\n  ((void**)roots[0])[0]=roots[1]; ((void**)roots[1])[0]=roots[0];\n  ((size_t*)roots[0])[2]=123; ((size_t*)roots[1])[2]=456;\n  for(int mode=0;mode<4;mode++){\n    sx_gc_thresh=(size_t)-1;\n    mg_fill(roots);\n    sx_gc_collect();\n    assert(sx_sb_count>=8193 && sx_sb_nbucket>=8192 && sx_gc_cap>=8193);\n    size_t old_buckets=sx_sb_nbucket, old_cap=sx_gc_cap;\n    unsigned char *old_bits=sx_gc_bits;\n    /* Retain the array, aliases and cycle; drop thousands of payloads. */\n    memset(roots+2,0,(8192-2)*sizeof(void*));\n    mg_calloc_fail=(mode==1);\n    mg_realloc_fail=(mode==2 ? 1 : (mode==3 ? 2 : 0));\n    mg_realloc_calls=0; mg_failures=0;\n    sx_gc_collect();\n    assert(sx_sb_count>=3 && sx_sb_count<32);\n    assert(sx_sb_is((char*)roots) && sx_sb_is((char*)roots[0]) && sx_sb_is((char*)roots[1]));\n    assert(((void**)roots[0])[0]==roots[1] && ((void**)roots[1])[0]==roots[0]);\n    assert(((size_t*)roots[0])[2]==123 && ((size_t*)roots[1])[2]==456);\n    assert(!sx_sb_is((char*)roots[0]+1)); /* exact registry lookup */\n    assert(!sx_sb_is((char*)&old_buckets)); /* foreign stack pointer */\n    assert(sx_sb_nbucket==(mode==1 ? old_buckets : 1024));\n    assert(sx_gc_cap==(mode==2 ? old_cap : 1024));\n    assert(mg_failures==(mode==0 ? 0 : 1));\n    if(mode==3) assert(sx_gc_bits==old_bits && mg_realloc_calls==2);\n    if(mode==0){\n      printf(\"metadata buckets: %zu -> %zu\\n\",old_buckets,sx_sb_nbucket);\n      printf(\"metadata scratch: %zu -> %zu\\n\",old_cap,sx_gc_cap);\n    }\n    mg_calloc_fail=mg_realloc_fail=0;\n    sx_gc_collect();\n    assert(sx_sb_nbucket==1024 && sx_gc_cap==1024);\n    /* The next iteration regrows both structures after partial failures. */\n  }\n  sx_gc_thresh=(size_t)-1;\n  mg_fill(roots); sx_gc_collect();\n  assert(sx_sb_count>=8193 && sx_gc_cap>=8193);\n  memset(roots+2,0,(8192-2)*sizeof(void*));\n  sx_gc_collect();\n  assert(sx_sb_nbucket==1024 && sx_gc_cap==1024);\n  puts(\"metadata-shrink-ok: 4 cases; aliases, failures, regrowth, empty collection\");\n  return 0;\n}\nint main(void){\n  char anchor; sx_gc_init(&anchor);\n  int (*volatile entry)(void)=mg_probe;\n  return entry();\n}\n"
  hold base = "selfhost/seed_tests/seed-metadata"
  hold source = gl_must_write(concat(base, ".c"), concat(prelude, concat(read_file("selfhost/seed_tests/sgc_drop_ms.c"), body)))
  hold cc = gl_compile_c(concat(base, ".c"), base, "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold run = gl_assert_out(concat("./", base), "metadata buckets: 16384 -> 1024\nmetadata scratch: 8193 -> 1024\nmetadata-shrink-ok: 4 cases; aliases, failures, regrowth, empty collection", concat(base, ".out"))
  give 0
}
