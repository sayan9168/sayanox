// tools/sxlsp_probe.sa -- Pure-Sayanox JSON-RPC framed LSP test driver.
// Replaces tools/sayanox-lsp-probe.sh, tools/sayanox-lsp-robust.sh, and
// tools/sayanox-lsp-unicode.sh with zero POSIX shell or interpreter use.
// Built C-free via ./tools/sxc_native.
//
// Subcommands:
//   sxlsp_probe probe <lsp-bin> [work-dir]
//   sxlsp_probe robust <lsp-bin>
//   sxlsp_probe unicode <lsp-bin>

make istr(n: num) -> str {
  when n == 0 {
    give "0"
  }
  hold neg = 0
  hold v = n
  when v < 0 {
    neg = 1
    v = 0 - v
  }
  hold s = ""
  while v >= 1 {
    hold d = v % 10
    v = (v - d) / 10
    s = concat(chr(48 + d), s)
  }
  when neg == 1 {
    s = concat("-", s)
  }
  give s
}

// Expand ~ -> chr(123) and | -> chr(125) so string literals never carry raw braces
make jb(s: str) -> str {
  hold out = ""
  hold i = 0
  hold n = len(s)
  while i < n {
    hold c = sx_index(s, i)
    when c == 126 {
      out = concat(out, chr(123))
    } otherwise {
      when c == 124 {
        out = concat(out, chr(125))
      } otherwise {
        out = concat(out, chr(c))
      }
    }
    i = i + 1
  }
  give out
}

make fail_probe(msg: str, dump: str) -> num {
  hold nl = chr(10)
  hold err = concat("FAIL: ", concat(msg, nl))
  when len(dump) > 0 {
    err = concat(err, concat(dump, nl))
  }
  hold w = write_file("/dev/stderr", err)
  hold z = exit(1)
  give 0
}

make contains(hay: str, needle: str) -> num {
  hold nh = len(hay)
  hold nn = len(needle)
  when nn == 0 {
    give 1
  }
  when nn > nh {
    give 0
  }
  hold lim = nh - nn
  hold i = 0
  while i <= lim {
    when sx_index(hay, i) == sx_index(needle, 0) {
      hold j = 1
      hold ok = 1
      while j < nn {
        when sx_index(hay, i + j) != sx_index(needle, j) {
          ok = 0
          j = nn
        } otherwise {
          j = j + 1
        }
      }
      when ok == 1 {
        give 1
      }
    }
    i = i + 1
  }
  give 0
}

make check_has(label: str, out: str, pat_t: str) -> num {
  hold pat = jb(pat_t)
  when contains(out, pat) != 1 {
    hold f = fail_probe(concat(label, concat(" (missing ", concat(pat, ")"))), out)
  }
  show label
  give 0
}

make check_lacks(label: str, out: str, pat_t: str) -> num {
  hold pat = jb(pat_t)
  when contains(out, pat) == 1 {
    hold f = fail_probe(concat(label, concat(" (unexpected ", concat(pat, ")"))), out)
  }
  show label
  give 0
}

make lsp_frame(body_t: str) -> str {
  hold body = jb(body_t)
  hold crlf = concat(chr(13), chr(10))
  give concat("Content-Length: ", concat(istr(len(body)), concat(crlf, concat(crlf, body))))
}

make parse_cl_header(hdr: str) -> num {
  hold pfx = "Content-Length:"
  hold np = len(pfx)
  when len(hdr) < np {
    give -1
  }
  hold i = 0
  while i < np {
    hold ca = sx_index(hdr, i)
    hold cb = sx_index(pfx, i)
    when ca >= 65 && ca <= 90 {
      ca = ca + 32
    }
    when cb >= 65 && cb <= 90 {
      cb = cb + 32
    }
    when ca != cb {
      give -1
    }
    i = i + 1
  }
  while i < len(hdr) && (sx_index(hdr, i) == 32 || sx_index(hdr, i) == 9) {
    i = i + 1
  }
  hold val = 0
  hold got = 0
  while i < len(hdr) {
    hold c = sx_index(hdr, i)
    when c >= 48 && c <= 57 {
      val = val * 10 + (c - 48)
      got = 1
      i = i + 1
    } otherwise {
      i = len(hdr)
    }
  }
  when got == 0 {
    give -1
  }
  give val
}

make run_lsp_raw(bin: str, payload: str) -> str {
  hold h = spawn(bin)
  when h < 0 {
    hold fs = fail_probe(concat("spawn failed for ", bin), "")
  }
  when len(payload) > 0 {
    hold s = child_send(h, payload)
  }
  hold nl = chr(10)
  hold out = ""
  hold reading = 1
  while reading == 1 {
    hold line = child_line(h)
    when len(line) == 0 {
      reading = 0
    } otherwise {
      hold cl = parse_cl_header(line)
      when cl >= 0 {
        hold sep = child_line(h)
        while len(sep) > 0 && sx_index(sep, 0) != 13 && sx_index(sep, 0) != 10 {
          sep = child_line(h)
        }
        hold body = ""
        when cl > 0 {
          body = child_recv(h, cl)
        }
        out = concat(out, concat(body, nl))
      }
    }
  }
  hold rc = child_close(h)
  when rc != 0 {
    hold fc = fail_probe(concat("LSP exited with status ", istr(rc)), out)
  }
  give out
}

make jq(s: str) -> str {
  hold q = chr(34)
  give concat(q, concat(s, q))
}

make ensure_work_dir(p: str) -> num {
  hold cmd = concat("mkdir -p ", jq(p))
  give run_command(cmd)
}

// ---- Subcommand 1: probe (matches tools/sayanox-lsp-probe.sh) -------------

make cap_open(work: str, k: num) -> str {
  hold ks = istr(k)
  hold uri = concat("file://", concat(work, concat("/cap", concat(ks, ".sa"))))
  hold txt = concat("make f", concat(ks, concat("(v: num) -> num ~\\n  give v + ", concat(ks, concat("\\n|\\nshow f", concat(ks, "(1)\\n"))))))
  give lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uri), concat(",\"text\":", concat(jq(txt), "||")))))
}

make cap_sym(work: str, idn: num, k: num) -> str {
  hold uri = concat("file://", concat(work, concat("/cap", concat(istr(k), ".sa"))))
  give lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":", concat(istr(idn), concat(",\"method\":\"textDocument/documentSymbol\",\"params\":~\"uri\":", concat(jq(uri), "||")))))
}

make run_probe_part1(bin: str, work: str) -> num {
  hold q = chr(34)
  hold bs = chr(92)
  hold nl = chr(10)
  hold jnl = concat(bs, "n")
  hold jq_esc = concat(bs, q)

  when ensure_work_dir(work) != 0 {
    hold fm = fail_probe("cannot create workdir", work)
  }
  hold abs_work = path_real(work)
  when len(abs_work) == 0 {
    abs_work = work
  }
  when write_file(concat(abs_work, "/good.sa"), concat("hold a = 1", nl)) != 1 {
    hold fg = fail_probe("cannot write good.sa", abs_work)
  }

  hold doc = concat(abs_work, "/doc.sa")
  hold doc2 = concat(abs_work, "/doc2.sa")
  hold uri1 = concat("file://", doc)
  hold uri2 = concat("file://", doc2)

  hold init = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":~\"capabilities\":~~||")
  hold shut = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\",\"params\":~~|")
  hold exitmsg = lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"exit\"|")

  hold doc_txt = ""
  doc_txt = concat(doc_txt, concat("hold x = 1", jnl))
  doc_txt = concat(doc_txt, concat("frobnicate x", jnl))
  doc_txt = concat(doc_txt, concat("use ", concat(jq_esc, concat("good.sa", concat(jq_esc, jnl)))))
  doc_txt = concat(doc_txt, concat("use ", concat(jq_esc, concat("nope.sa", concat(jq_esc, jnl)))))
  doc_txt = concat(doc_txt, concat("make twice(v: num) -> num ~", jnl))
  doc_txt = concat(doc_txt, concat("  give v + v", jnl))
  doc_txt = concat(doc_txt, concat("|", jnl))
  doc_txt = concat(doc_txt, concat("show twice(x)", jnl))
  doc_txt = concat(doc_txt, concat("when x == 2 ~", jnl))
  doc_txt = concat(doc_txt, concat("  show ", concat(jq_esc, concat("oops", jnl))))

  hold open1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uri1), concat(",\"text\":", concat(jq(doc_txt), "||")))))
  hold change1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":~\"uri\":", concat(jq(uri1), ",\"text\":\"hold y = 2\\nshow y\\n\"||")))
  hold sym1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentSymbol\",\"params\":~\"uri\":", concat(jq(uri1), "||")))
  hold comp1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/completion\",\"params\":~\"uri\":", concat(jq(uri1), ",\"position\":~\"line\":7,\"character\":8|||")))
  hold hov1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/hover\",\"params\":~\"uri\":", concat(jq(uri1), ",\"position\":~\"line\":0,\"character\":3|||")))
  hold def1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/definition\",\"params\":~\"uri\":", concat(jq(uri1), ",\"position\":~\"line\":7,\"character\":7|||")))
  hold diag1 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/diagnostic\",\"params\":~\"uri\":", concat(jq(uri1), "||")))

  hold open2 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uri2), ",\"text\":\"make thrice(v: num) -> num ~\\n  give v * 3\\n|\\nshow thrice(2)\\n\"||")))
  hold sym2 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/documentSymbol\",\"params\":~\"uri\":", concat(jq(uri2), "||")))
  hold close2 = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":~\"uri\":", concat(jq(uri2), "||")))

  // Session 1
  hold s1 = concat(init, concat(open1, concat(hov1, concat(def1, concat(comp1, concat(diag1, concat(open2, concat(sym2, concat(sym1, concat(change1, concat(shut, exitmsg)))))))))))
  hold out1 = run_lsp_raw(bin, s1)
  hold ok = check_has("initialize", out1, "\"capabilities\"")
  ok = check_has("serverInfo", out1, "\"sayanox-lsp\"")
  when contains(out1, "\"renameProvider\":true") == 1 || contains(out1, "\"prepareSupport\"") == 1 {
    show "rename capability"
  } otherwise {
    hold fr = fail_probe("rename capability", out1)
  }
  ok = check_has("diag unknown-statement", out1, "SX1001")
  ok = check_has("diag unterminated-string", out1, "SX1002")
  ok = check_has("diag unbalanced-braces", out1, "SX1003")
  ok = check_has("diag unresolved-use", out1, "SX1005")
  ok = check_has("symbol function", out1, "\"name\":\"twice\"")
  ok = check_has("symbol variable", out1, "\"name\":\"x\"")
  ok = check_has("completion builtin", out1, "\"label\":\"gc_runs\"")
  ok = check_has("completion literal preserved", out1, "\"label\":\"numstr\"")
  ok = check_has("hover builtin", out1, "hold name = value")
  ok = check_has("definition", out1, "\"line\":4")
  ok = check_has("diagnostics cleared on change", out1, "\"diagnostics\":[]")
  ok = check_has("second document symbols", out1, "\"name\":\"thrice\"")

  // Session 2: closed documents
  hold s2 = concat(init, concat(open2, concat(close2, concat(sym2, concat(shut, exitmsg)))))
  hold out2 = run_lsp_raw(bin, s2)
  ok = check_has("closed document answers empty", out2, "\"id\":8,\"result\":[]")
  ok = check_lacks("closed document not served from another buffer", out2, "\"name\":\"thrice\"")

  // Session 3: 4-slot cap
  hold s3 = concat(init, concat(cap_open(abs_work, 1), concat(cap_open(abs_work, 2), concat(cap_open(abs_work, 3), concat(cap_open(abs_work, 4), concat(cap_open(abs_work, 5), concat(cap_sym(abs_work, 11, 1), concat(cap_sym(abs_work, 12, 5), concat(shut, exitmsg)))))))))
  hold out3 = run_lsp_raw(bin, s3)
  ok = check_lacks("fifth document evicts the oldest", out3, "\"name\":\"f1\"")
  ok = check_has("newest document still served", out3, "\"name\":\"f5\"")
  give 0
}

make run_probe_part2(bin: str, work: str) -> num {
  hold q = chr(34)
  hold bs = chr(92)
  hold jnl = concat(bs, "n")
  hold jq_esc = concat(bs, q)

  hold abs_work = path_real(work)
  when len(abs_work) == 0 {
    abs_work = work
  }
  hold uriA = concat("file://", concat(abs_work, "/refA.sa"))
  hold uriB = concat("file://", concat(abs_work, "/refB.sa"))
  hold uriC = concat("file://", concat(abs_work, "/fmtC.sa"))
  hold uriD = concat("file://", concat(abs_work, "/sigD.sa"))

  hold init = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":~\"capabilities\":~~||")
  hold shut = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"shutdown\",\"params\":~~|")
  hold exitmsg = lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"exit\"|")

  hold openA = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uriA), ",\"text\":\"hold zz = 1\\nshow zz\\nwhen zz == 1 ~\\n  show zz\\n|\\n\"||")))
  hold openB = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uriB), ",\"text\":\"make helper(v: num) -> num ~\\n  give v + zz\\n|\\nshow helper(2)\\n\"||")))

  hold fmt_txt = concat("hold x = 1  ", concat(jnl, concat("when x > 0 ~  ", concat(jnl, concat("show ", concat(jq_esc, concat("brace | // not comment", concat(jq_esc, concat(jnl, concat("// comment ~ |", concat(jnl, concat("when x == 1 ~", concat(jnl, concat("  show 42   ", concat(jnl, concat("|", concat(jnl, concat("|", jnl))))))))))))))))))
  hold openC = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uriC), concat(",\"text\":", concat(jq(fmt_txt), "||")))))

  // Session 4: references
  hold refA = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":21,\"method\":\"textDocument/references\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriA), "|,\"position\":~\"line\":1,\"character\":6|,\"context\":~\"includeDeclaration\":true|||")))
  hold refB = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":22,\"method\":\"textDocument/references\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriA), "|,\"position\":~\"line\":1,\"character\":6|,\"context\":~\"includeDeclaration\":false|||")))
  hold refNone = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":23,\"method\":\"textDocument/references\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriA), "|,\"position\":~\"line\":4,\"character\":0|,\"context\":~\"includeDeclaration\":true|||")))

  hold s4 = concat(init, concat(openA, concat(openB, concat(refA, concat(refB, concat(refNone, concat(shut, exitmsg)))))))
  hold out4 = run_lsp_raw(bin, s4)
  hold ok = check_has("references include the declaration", out4, concat("\"id\":21,\"result\":[~\"uri\":", concat(jq(uriA), ",\"range\":~\"start\":~\"line\":0,\"character\":5|,\"end\":~\"line\":0,\"character\":7|")))
  ok = check_has("references honour includeDeclaration:false", out4, concat("\"id\":22,\"result\":[~\"uri\":", concat(jq(uriA), ",\"range\":~\"start\":~\"line\":1,\"character\":5|")))
  ok = check_has("references span the open documents", out4, concat("\"uri\":", jq(uriB)))
  ok = check_has("references at a non-word answer empty", out4, "\"id\":23,\"result\":[]")

  // Session 5: workspace/symbol + formatting
  hold wsQ = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":31,\"method\":\"workspace/symbol\",\"params\":~\"query\":\"help\"||")
  hold wsAll = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":32,\"method\":\"workspace/symbol\",\"params\":~\"query\":\"\"||")
  hold fmtC = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":33,\"method\":\"textDocument/formatting\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriC), "|,\"options\":~\"tabSize\":2,\"insertSpaces\":true|||")))
  hold fmtB = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":34,\"method\":\"textDocument/formatting\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriB), "|,\"options\":~\"tabSize\":2,\"insertSpaces\":true|||")))

  hold s5 = concat(init, concat(openA, concat(openB, concat(openC, concat(wsQ, concat(wsAll, concat(fmtC, concat(fmtB, concat(shut, exitmsg)))))))))
  hold out5 = run_lsp_raw(bin, s5)
  ok = check_has("workspace symbol matches a query", out5, "\"id\":31,\"result\":[~\"name\":\"helper\",\"kind\":3")
  ok = check_has("workspace symbol with an empty query spans documents", out5, "\"id\":32,\"result\":[~\"name\":\"zz\",\"kind\":13")
  ok = check_has("formatting answers one whole-buffer edit", out5, "\"end\":~\"line\":8,\"character\":0||,\"newText\":\"hold x = 1")
  ok = check_has("formatting indents a comment inside a block", out5, "n  // comment ~ |")
  ok = check_has("formatting indents a nested block by four spaces", out5, "n    show 42")
  ok = check_lacks("formatting strips trailing whitespace", out5, "x = 1  ")
  ok = check_has("formatting leaves a formatted document alone", out5, "\"id\":34,\"result\":[]")

  // Session 6: rename, signatureHelp, codeAction
  hold openD = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"uri\":", concat(jq(uriD), ",\"text\":\"make add2(a: num, b: num) -> num ~\\n  give a + b\\n|\\nshow add2(1, 2)\\n\"||")))
  hold renA = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":41,\"method\":\"textDocument/rename\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriA), "|,\"position\":~\"line\":1,\"character\":6|,\"newName\":\"ww\"||")))
  hold sigD = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":42,\"method\":\"textDocument/signatureHelp\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriD), "|,\"position\":~\"line\":3,\"character\":13|||")))
  hold actC = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":43,\"method\":\"textDocument/codeAction\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriC), "|,\"range\":~\"start\":~\"line\":0,\"character\":0|,\"end\":~\"line\":0,\"character\":1||||")))
  hold actB = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":44,\"method\":\"textDocument/codeAction\",\"params\":~\"textDocument\":~\"uri\":", concat(jq(uriB), "|,\"range\":~\"start\":~\"line\":0,\"character\":0|,\"end\":~\"line\":0,\"character\":1||||")))

  hold s6 = concat(init, concat(openA, concat(openB, concat(openC, concat(openD, concat(renA, concat(sigD, concat(actC, concat(actB, concat(shut, exitmsg))))))))))
  hold out6 = run_lsp_raw(bin, s6)
  ok = check_has("rename edits the declaration", out6, concat("\"id\":41,\"result\":~\"changes\":~", concat(jq(uriA), ":[~\"range\":~\"start\":~\"line\":0,\"character\":5|")))
  ok = check_has("rename carries the new name", out6, "\"newText\":\"ww\"")
  ok = check_has("rename spans the open documents", out6, concat(jq(uriB), ":["))
  ok = check_has("signature help labels the declaration", out6, "\"label\":\"make add2(a: num, b: num)")
  ok = check_has("signature help lists the parameters", out6, "\"label\":\"a: num\"")
  ok = check_has("signature help counts the argument", out6, "\"activeParameter\":1")
  ok = check_has("code action offers formatting", out6, "Format this Sayanox document")
  ok = check_has("code action is empty when already formatted", out6, "\"id\":44,\"result\":[]")
  give 0
}

// ---- Subcommand 2: robust (matches tools/sayanox-lsp-robust.sh) -----------

make run_robust(bin: str) -> num {
  hold crlf = concat(chr(13), chr(10))
  hold jq_esc = concat(chr(92), chr(34))
  hold exitmsg = lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"exit\"|")

  // 1. Unknown request -> -32601, then server keeps serving
  hold r1 = concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/foldingRange\",\"params\":~~|"), concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"shutdown\",\"params\":~~|"), exitmsg))
  hold o1 = run_lsp_raw(bin, r1)
  hold ok = check_has("unknown request -32601", o1, "\"id\":9,\"error\":~\"code\":-32601")
  ok = check_has("server keeps serving after error", o1, "\"id\":10,\"result\":null")

  // 2. Unknown notification -> zero output
  hold r2 = concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"$/setTrace\",\"params\":~\"value\":\"off\"||"), exitmsg)
  hold o2 = run_lsp_raw(bin, r2)
  when len(o2) != 0 {
    hold f2 = fail_probe("unknown notification got a reply", o2)
  }
  show "unknown notification ignored"

  // 3. Garbage body -> -32700 parse error, id null
  hold r3 = concat(lsp_frame("this is not json~~~"), exitmsg)
  hold o3 = run_lsp_raw(bin, r3)
  ok = check_has("garbage body -32700", o3, "\"id\":null,\"error\":~\"code\":-32700")

  // 4. Object without method -> -32600 invalid request
  hold r4 = concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":4|"), exitmsg)
  hold o4 = run_lsp_raw(bin, r4)
  ok = check_has("no method -32600", o4, "\"code\":-32600")

  // 5. Junk before valid frame -> skipped, valid frame answered
  hold r5 = concat("junk", concat(crlf, concat(crlf, concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"shutdown\",\"params\":~~|"), exitmsg))))
  hold o5 = run_lsp_raw(bin, r5)
  ok = check_has("junk header skipped", o5, "\"id\":12,\"result\":null")

  // 6. Truncated frame at EOF -> exits 0 cleanly
  hold trunc = concat("Content-Length: 500", concat(crlf, concat(crlf, jb("~\"jsonrpc\":\"2.0\""))))
  hold ht = spawn(bin)
  when ht < 0 {
    hold fsp = fail_probe("spawn failed on truncated test", "")
  }
  hold ts = child_send(ht, trunc)
  hold trc = child_close(ht)
  when trc != 0 {
    hold ft = fail_probe("truncated frame did not exit 0", istr(trc))
  }
  show "truncated frame ends cleanly"

  // 7. String ids (including escaped quotes) echoed verbatim
  hold r7 = concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":\"abc-1\",\"method\":\"shutdown\",\"params\":~~|"), concat(lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"id\":\"a", concat(jq_esc, "b\",\"method\":\"textDocument/foldingRange\",\"params\":~~|"))), exitmsg))
  hold o7 = run_lsp_raw(bin, r7)
  ok = check_has("string id echoed on a result", o7, "\"id\":\"abc-1\",\"result\":null")
  ok = check_has("string id with an escaped quote echoed on an error", o7, concat("\"id\":\"a", concat(jq_esc, "b\",\"error\":~\"code\":-32601")))

  // 8. Negative and null ids echoed unchanged
  hold r8 = concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":-3,\"method\":\"shutdown\"|"), concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"shutdown\"|"), exitmsg))
  hold o8 = run_lsp_raw(bin, r8)
  ok = check_has("negative id echoed", o8, "\"id\":-3,\"result\":null")
  ok = check_has("null id echoed", o8, "\"id\":null,\"result\":null")
  give 0
}

// ---- Subcommand 3: unicode (matches tools/sayanox-lsp-unicode.sh) ---------

make unicode_session(open_frame: str) -> str {
  hold s = lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":~\"capabilities\":~~||")
  s = concat(s, open_frame)
  s = concat(s, lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|,\"position\":~\"line\":1,\"character\":16|||"))
  s = concat(s, lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/diagnostic\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|||"))
  s = concat(s, lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\",\"version\":2|,\"contentChanges\":[~\"text\":\"\"|]||"))
  s = concat(s, lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/diagnostic\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|||"))
  s = concat(s, lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"exit\"|"))
  give s
}

make run_unicode(bin: str) -> num {
  hold q = chr(34)
  hold bs = chr(92)
  hold jnl = concat(bs, "n")
  hold jq_esc = concat(bs, q)
  hold exitmsg = lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"exit\"|")

  // UTF-8 multi-byte code points: e-acute (C3 A9), Bengali ka (E0 A6 95), emoji (F0 9F 98 80), em-dash (E2 80 94)
  hold u_ea = concat(chr(195), chr(169))
  hold u_ka = concat(chr(224), concat(chr(166), chr(149)))
  hold u_em = concat(chr(240), concat(chr(159), concat(chr(152), chr(128))))
  hold em_dash = concat(chr(226), concat(chr(128), chr(148)))

  hold raw_txt = concat("hold target = 1", concat(jnl, concat("show ", concat(jq_esc, concat(u_ea, concat(u_ka, concat(u_em, concat(jq_esc, concat(" + target", concat(jnl, concat("show ", concat(jq_esc, u_em))))))))))))
  hold esc_txt = concat("hold target = 1", concat(jnl, concat("show ", concat(jq_esc, concat(bs, concat("u00e9", concat(bs, concat("u0995", concat(bs, concat("ud83d", concat(bs, concat("ude00", concat(jq_esc, concat(" + target", concat(jnl, concat("show ", concat(jq_esc, concat(bs, concat("ud83d", concat(bs, "ude00"))))))))))))))))))))

  hold raw_open = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\",\"text\":", concat(jq(raw_txt), "|||")))
  hold esc_open = lsp_frame(concat("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\",\"text\":", concat(jq(esc_txt), "|||")))

  hold out_raw = run_lsp_raw(bin, unicode_session(raw_open))
  hold out_esc = run_lsp_raw(bin, unicode_session(esc_open))

  when string_eq(out_raw, out_esc) != 1 {
    hold f1 = fail_probe("raw UTF-8 and JSON Unicode escapes differ", out_esc)
  }
  show "raw UTF-8 and JSON Unicode escapes agree"

  hold ok = check_has("UTF-16 advertised", out_raw, "\"positionEncoding\":\"utf-16\"")
  hold hov_want = concat("\"id\":2,\"result\":~\"contents\":~\"kind\":\"markdown\",\"value\":\"`target` ", concat(em_dash, " a variable in this document.\"|"))
  ok = check_has("UTF-16 hover after BMP and supplementary characters", out_raw, hov_want)
  ok = check_has("diagnostic range does not split surrogate pair", out_raw, "\"start\":~\"line\":2,\"character\":6|,\"end\":~\"line\":2,\"character\":8|")
  ok = check_has("empty full-text didChange clears document", out_raw, "\"id\":4,\"result\":~\"kind\":\"full\",\"items\":[]|")

  // Session 2: didClose releases document state
  hold u2 = concat(raw_open, concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|||"), concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/diagnostic\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|||"), exitmsg)))
  hold out_u2 = run_lsp_raw(bin, u2)
  ok = check_has("didClose releases document state", out_u2, "\"id\":5,\"result\":~\"kind\":\"full\",\"items\":[]|")

  // Session 3: empty change array and unrelated URI preserve document
  hold u3 = concat(raw_open, concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\",\"version\":2|,\"contentChanges\":[]||"), concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":~\"textDocument\":~\"uri\":\"file:///other.sa\",\"version\":3|,\"contentChanges\":[~\"text\":\"\"|]||"), concat(lsp_frame("~\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/hover\",\"params\":~\"textDocument\":~\"uri\":\"file:///unicode.sa\"|,\"position\":~\"line\":1,\"character\":16|||"), exitmsg))))
  hold out_u3 = run_lsp_raw(bin, u3)
  hold hov6_want = concat("\"id\":6,\"result\":~\"contents\":~\"kind\":\"markdown\",\"value\":\"`target` ", concat(em_dash, " a variable in this document.\"|"))
  ok = check_has("empty change array and unrelated URI preserve document", out_u3, hov6_want)
  give 0
}

// ---- Entry ----------------------------------------------------------------

when arg_count() < 3 {
  hold u = fail_probe("usage: sxlsp_probe <probe|robust|unicode> <lsp-bin> [work-dir]", "")
}

hold mode = arg(1)
hold lsp_bin = arg(2)

when string_eq(mode, "probe") == 1 {
  hold wd = "selfhost/seed_tests/lsp-probe"
  when arg_count() >= 4 {
    wd = arg(3)
  }
  hold r1a = run_probe_part1(lsp_bin, wd)
  hold r1b = run_probe_part2(lsp_bin, wd)
  hold e1 = exit(0)
}
when string_eq(mode, "robust") == 1 {
  hold r2 = run_robust(lsp_bin)
  hold e2 = exit(0)
}
when string_eq(mode, "unicode") == 1 {
  hold r3 = run_unicode(lsp_bin)
  hold e3 = exit(0)
}

hold bad = fail_probe(concat("unknown subcommand: ", mode), "")
