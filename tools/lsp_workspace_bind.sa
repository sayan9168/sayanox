// tools/lsp_workspace_bind.sa -- Sayanox replacement for the old awk binder.
//
// The language server is a normal .sa program. `workspace_manifest` is a stub
// because the pure-min dialect has no directory API; the LSP build binds it to
// the tool-local C directory bridge in tools/lsp_workspace.h. This program
// performs that binding as a checked text transformation:
//
//   ./lsp_workspace_bind <generated.c> > <bound.c>
//
// It is fail-closed: if the generated fallback is not exactly the expected
// three-line shape, it writes a C `#error` so the build fails loudly instead of
// producing a server that silently indexes nothing. Only gen2 builtins are
// used (arg, read_file, len, sx_index, chr, concat, string_eq, write_out), so
// the build needs no awk, sed, or shell text processing.

make slice(text: str, begin: num, end: num) -> str {
  hold value = ""
  hold i = begin
  hold stop = end
  while i < stop {
    value = concat(value, chr(sx_index(text, i)))
    i = i + 1
  }
  give value
}

make emit(line: str) -> num {
  hold written = write_out(concat(line, "\n"))
  give written
}

// gen2 cannot spell a brace inside a `when` condition string, so the two
// structural strings are built from chr(123) / chr(125) instead.
hold header_line_text = concat("static char *workspace_manifest(char *root) ", chr(123))
hold close_brace = chr(125)

hold path = arg(1)
hold src = read_file(path)
hold n = len(src)
when n == 0 {
  hold empty = write_out("#error lsp_workspace_bind: empty generated C\n")
}
when n > 0 {
  when sx_index(src, n - 1) != 10 {
    src = concat(src, "\n")
    n = n + 1
  }
  hold i = 0
  hold start = 0
  hold state = 0
  hold found = 0
  hold bad = 0
  hold line = ""
  hold handled = 0
  while i < n {
    when sx_index(src, i) == 10 {
      line = slice(src, start, i)
      // One branch per line: `handled` stops a state transition from being
      // re-tested by the later guards in the same iteration.
      handled = 0
      when handled == 0 && state == 0 && string_eq(line, header_line_text) {
        found = found + 1
        hold include_line = emit("#include \"lsp_workspace.h\"")
        hold header_line = emit(line)
        state = 1
        handled = 1
      }
      when handled == 0 && state == 0 {
        hold copied = emit(line)
        handled = 1
      }
      when handled == 0 && state == 1 && string_eq(line, "  return \"\";") {
        hold bridge = emit("  return sx_lsp_workspace_manifest(root);")
        state = 2
        handled = 1
      }
      when handled == 0 && state == 1 {
        bad = 1
        handled = 1
      }
      when handled == 0 && state == 2 && string_eq(line, close_brace) {
        hold closed = emit(line)
        state = 0
        handled = 1
      }
      when handled == 0 && state == 2 {
        bad = 1
        handled = 1
      }
      start = i + 1
    }
    i = i + 1
  }
  when bad != 0 || found != 1 || state != 0 {
    hold failed = write_out("#error lsp_workspace_bind: unexpected generated workspace_manifest fallback shape\n")
  }
}
