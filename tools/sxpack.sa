// Offline compiler pack/restore/verify CLI; the native entry shares the same implementation.
use "tools/sxpack_lib.sa"

when arg_count() < 2 {
  hold u = sp_fail_pack("usage: sxpack <pack|restore|verify>")
}
hold mode = arg(1)
when string_eq(mode, "pack") == 1 {
  hold r1 = sp_run_pack()
  hold e1 = exit(0)
}
when string_eq(mode, "restore") == 1 {
  hold r2 = sp_run_restore()
  hold e2 = exit(0)
}
when string_eq(mode, "verify") == 1 {
  hold r3 = sp_run_verify()
  show "[OK] sxpack verify: compiler_min_gz and compiler_text.sa.gz.b64 match checked-in sources byte-for-byte"
  hold e3 = exit(0)
}
hold uk = sp_fail_pack(concat("unknown subcommand: ", mode))
