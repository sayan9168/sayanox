  when path_kind("selfhost/native_aot") == 1 {
  hold p13 = pg_emit_stream(2, "selfhost/typed_sig_test.sa", "selfhost/seed_tests/tsg_nat", 0, "selfhost/seed_tests/tsg_nat.emit.log", "selfhost/seed_tests/tsg_nat.err")
