  hold p3 = pg_emit_stream(1, "selfhost/stdlib_json_write_test.sa", "selfhost/seed_tests/jsonw_gen2.c", 0, "/dev/null", "selfhost/seed_tests/jsonw_gen2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/jsonw_gen2.c", "selfhost/seed_tests/jsonw_gen2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p5 = gl_assert_out("./selfhost/seed_tests/jsonw_seed", "1\n2\nobject\n0\n1\n3.75\n-3.25\nnull\n0\n0\n2\nalpha\ntls\nbeta\n\"node\"\n8080\n0\n1\n1\nedge\n3.75\n{\n  \"a\": [],\n  \"b\": [\n    1\n  ]\n}\njson-write-done", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_assert_out("./selfhost/seed_tests/jsonw_gen2", "1\n2\nobject\n0\n1\n3.75\n-3.25\nnull\n0\n0\n2\nalpha\ntls\nbeta\n\"node\"\n8080\n0\n1\n1\nedge\n3.75\n{\n  \"a\": [],\n  \"b\": [\n    1\n  ]\n}\njson-write-done", "selfhost/seed_tests/sxported.stdout")
  when path_kind("selfhost/native_aot") == 1 {
  hold p7 = pg_emit_stream(2, "selfhost/stdlib_json_write_test.sa", "selfhost/seed_tests/jsonw_native", 0, "selfhost/seed_tests/jsonw_native.emit.log", "selfhost/seed_tests/jsonw_native.err")
  hold p8 = pg_capture("./selfhost/seed_tests/jsonw_native", "selfhost/seed_tests/jsonw_native.out")
  hold p9 = pg_capture("./selfhost/seed_tests/jsonw_seed", "selfhost/seed_tests/jsonw_seed.out")
  hold p10 = gl_assert_files_eq("selfhost/seed_tests/jsonw_seed.out", "selfhost/seed_tests/jsonw_native.out", "test-stdlib-json-write parity")
  }
  give 0
}

make mp_test_sxbuild() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests/sxbuild_gate")
  hold p1 = pg_command("./tools/sxbuild doctor >/dev/null", "test-sxbuild child command")
  hold p2 = pg_command("./tools/sxbuild inventory > selfhost/seed_tests/sxbuild_gate/inv.out", "test-sxbuild child command")
  hold p3 = pr_assert("selfhost/seed_tests/sxbuild_gate/inv.out", "native_aot.c present: *0", 0, 0, 0, 0, 1)
  hold p4 = pr_assert("selfhost/seed_tests/sxbuild_gate/inv.out", "non-anchor .c/.h files: *0", 0, 0, 0, 0, 1)
  hold p5 = pg_command("./tools/sxbuild parity selfhost/native_ir_log_test.sa selfhost/seed_tests/sxbuild_gate/parity", "test-sxbuild child command")
  give 0
}

make mp_dispatch(name: str) -> num {
  hold dir = gl_ensure_dir("selfhost/seed_tests")
  when string_eq(name, "test-push-stmt") == 1 {
    hold r = mp_test_push_stmt()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-stage2-demos") == 1 {
    hold r = mp_test_stage2_demos()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-lang") == 1 {
    hold r = mp_test_native_lang()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-native-locals") == 1 {
    hold dep = mp_dispatch("test-native-param-reassign")
    hold dep = pg_dispatch("test-native-for-functions")
    hold dep = pg_dispatch("test-native-list-alias")
    hold dep = mp_dispatch("test-native-generic-local")
    hold r = mp_test_native_locals()
    show concat("[OK] Sayanox gate: ", name)
    give 0
  }
  when string_eq(name, "test-typed-sig") == 1 {
    hold dep = mp_dispatch("test-seed-typed-functions")
    hold dep = mp_dispatch("test-gen2-forward")
    hold dep = mp_dispatch("test-gen2-function-scope")
    hold dep = mp_dispatch("test-gen2-boolean-args")
    hold dep = mp_dispatch("test-gen2-list-return")
    hold dep = mp_dispatch("test-gen2-list-args")
    hold dep = mp_dispatch("test-gen2-gc-roots")
    hold dep = mp_dispatch("test-gen2-list-arithmetic")
    hold dep = mp_dispatch("test-return-paths")
    hold dep = mp_dispatch("test-name-resolution")
    hold dep = mp_dispatch("test-inline-expressions")
    hold dep = pg_dispatch("test-seed-list-sequence")
    hold dep = mp_dispatch("test-list-postfix")
