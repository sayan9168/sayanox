  hold p29 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p30 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p31 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: num) -> num { give a }\nshow f()\n")
  hold p32 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p33 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p34 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: num, b) -> num { give a }\n")
  hold p35 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p36 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p37 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a, b: str) -> str { give b }\n")
  hold p38 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p39 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p40 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) { give a }\n")
  hold p41 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p42 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p43 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: num, a: num) -> num { give a }\n")
  hold p44 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p45 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p46 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: other) -> num { give 1 }\n")
  hold p47 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p48 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p49 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) -> str { a = 1\ngive a }\n")
  hold p50 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p51 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p52 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) -> str { hold a: num = 1\ngive a }\n")
  hold p53 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p54 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p55 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f() -> num { when true { hold x = 1 }\ngive x }\n")
  hold p56 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p57 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p58 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f() -> num { when true { give 1 } }\n")
  hold p59 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p60 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p61 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(s: str) -> num { while s { show 1 }\ngive 0 }\n")
  hold p62 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p63 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p64 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f() -> num { hold n: num = \"bad\"\ngive n }\n")
  hold p65 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p66 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p67 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f() -> num { hold n: num = 1\nhold n: str = \"bad\"\ngive 0 }\n")
  hold p68 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
