  hold p4 = gl_compile_c("selfhost/seed_tests/for_lit_gen2.c", "selfhost/seed_tests/for_lit_gen2", "-O2 -Werror=implicit-function-declaration")
  hold p5 = gl_assert_out("./selfhost/seed_tests/for_lit_seed", "tick\n2\n3\n7\n99\na\nc\n1\na\n1\na\n2\nb\n1\nb\n2\n2\ntick\n7\ntick\n7\ndone", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_assert_out("./selfhost/seed_tests/for_lit_gen2", "tick\n2\n3\n7\n99\na\nc\n1\na\n1\na\n2\nb\n1\nb\n2\n2\ntick\n7\ntick\n7\ndone", "selfhost/seed_tests/sxported.stdout")
  hold p7 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "hold c = 1\nfor c in \"ab\" { show c }\n")
  hold p8 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p9 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p10 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "hold x = \"a\"\nfor x in [1] { show x }\n")
  hold p11 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p12 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p13 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "for x in [\"a\"] { show x }\n")
  hold p14 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p15 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p16 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "for x in [[1]] { show x }\n")
  hold p17 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p18 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p19 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "for c in \"a\" + \"b\" { show c }\n")
  hold p20 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p21 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p22 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "for c in \"a\" show c\n")
  hold p23 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p24 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  hold p25 = gl_must_write("selfhost/seed_tests/for_lit_bad.sa", "hold _sx_iter_src_0 = 1\n")
  hold p26 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_lit_bad.sa >/dev/null 2>selfhost/seed_tests/for_lit_bad.err", "test-seed-for-literals refusal")
  hold p27 = gl_assert_eq_num(path_size("selfhost/seed_tests/for_lit_bad.err") > 0, 1, "nonempty selfhost/seed_tests/for_lit_bad.err")
  when path_kind("selfhost/native_aot") == 1 {
  hold p28 = pg_emit_stream(2, "selfhost/seed_for_literals_test.sa", "selfhost/seed_tests/for_lit_native", 0, "selfhost/seed_tests/for_lit_native.emit.log", "selfhost/seed_tests/for_lit_native.err")
  hold p29 = pg_capture("./selfhost/seed_tests/for_lit_native", "selfhost/seed_tests/for_lit_native.out")
  hold p30 = pg_capture("./selfhost/seed_tests/for_lit_seed", "selfhost/seed_tests/for_lit_seed.out")
  hold p31 = gl_assert_files_eq("selfhost/seed_tests/for_lit_seed.out", "selfhost/seed_tests/for_lit_native.out", "test-seed-for-literals parity")
  }
  give 0
}

