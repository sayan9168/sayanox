make mp_test_seed_borrow() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/seed_borrow_test.sa", "selfhost/seed_tests/borrow.c", 0, "selfhost/seed_tests/borrow.c.emit.log", "selfhost/seed_tests/borrow.c.err")
  hold p2 = gl_compile_c("selfhost/seed_tests/borrow.c", "selfhost/seed_tests/borrow", "-O2")
  hold p3 = gl_assert_out("./selfhost/seed_tests/borrow", "6\nkeeper\nkeeper\nkeeper!?\nkeeper\nkeeper\nkeeper\nother\nkeeper\na\nb\nb!\nkeeper\nkeeper\nkeeper+\n7", "selfhost/seed_tests/sxported.stdout")
  hold read_only = pr_assert("selfhost/seed_tests/borrow.c", "source = sx_sb_from(source)", 1, 0, 0, 0, 0)
  when pr_count("selfhost/seed_tests/borrow.c", "#define SX_SEED_PROFILE 1", 1, 1, 0, 0) == 1 {
    // Immutable fresh-allocation + conservative rooting replaces the old
    // writable-parameter copy / early-free protocol. Keep every alias/lifetime
    // output and allocation-pressure fixture, and inspect the active contract.
    hold ownership = pg_contains("selfhost/seed_tests/borrow.c", "if(kind==0 && SX_SEED_PROFILE) return sx_sb_new(n);")
    hold fresh_concat = pg_contains("selfhost/seed_tests/borrow.c", "char *r=(char*)sx_gc_alloc(0,la+lb+1);")
    hold rooted = pg_contains("selfhost/seed_tests/borrow.c", "static void sx_gc_roots(")
    hold poison = pg_contains("selfhost/seed_tests/borrow.c", "__asan_region_is_poisoned")
    hold instrumented = pg_not_contains("selfhost/seed_tests/borrow.c", "no_sanitize")
  } otherwise {
    hold p5 = pr_assert("selfhost/seed_tests/borrow.c", "a = sx_sb_from(a)", 1, 0, 0, 0, 1)
    hold p6 = pr_assert("selfhost/seed_tests/borrow.c", "s = sx_sb_from(s)", 1, 0, 0, 0, 1)
  }
  hold p7 = pg_emit_stream(0, "selfhost/seed_borrow_stress.sa", "selfhost/seed_tests/borrow-stress.c", 0, "selfhost/seed_tests/borrow-stress.c.emit.log", "selfhost/seed_tests/borrow-stress.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/borrow-stress.c", "selfhost/seed_tests/borrow-stress", "-O2")
  hold p9 = lm_assert_out("./selfhost/seed_tests/borrow-stress", 131072, "16481\n16384\n97\n3\n7", "selfhost/seed_tests/sxmore_limit")
  hold p10 = pg_emit_stream(1, "selfhost/seed_borrow_stress.sa", "selfhost/seed_tests/borrow-stress-g2.c", 0, "selfhost/seed_tests/borrow-stress-g2.c.emit.log", "selfhost/seed_tests/borrow-stress-g2.c.err")
  hold p11 = gl_compile_c("selfhost/seed_tests/borrow-stress-g2.c", "selfhost/seed_tests/borrow-stress-g2", "-O2")
  hold p12 = gl_assert_out("./selfhost/seed_tests/borrow-stress-g2", "16481\n16384\n97\n3\n7", "selfhost/seed_tests/sxported.stdout")
  hold p13 = pg_emit_stream(2, "selfhost/seed_borrow_stress.sa", "selfhost/seed_tests/borrow-stress-native", 0, "selfhost/seed_tests/borrow-stress-native.emit.log", "selfhost/seed_tests/borrow-stress-native.err")
  hold p14 = gl_assert_out("./selfhost/seed_tests/borrow-stress-native", "16481\n16384\n97\n3\n7", "selfhost/seed_tests/sxported.stdout")
  hold p15 = pg_emit_stream(1, "selfhost/seed_builder_registry_test.sa", "selfhost/seed_tests/builder-registry.c", 0, "/dev/null", "selfhost/seed_tests/builder-registry.c.err")
  hold p16 = pg_emit_stream(5, "selfhost/seed_builder_registry_test.sa", "selfhost/seed_tests/builder-registry", 0, "selfhost/seed_tests/builder-registry.emit.log", "selfhost/seed_tests/builder-registry.err")
  hold p17 = gl_assert_out("./selfhost/seed_tests/builder-registry", "registry-ok", "selfhost/seed_tests/sxported.stdout")
  give 0
}

