  hold p6 = gl_assert_out("./selfhost/seed_tests/seed_s2_g2", "1\n0\n0\n1\n1\n0\n0\n1\n8\n8\n3\n11\n21\n2\n4\na\nand or not true false elif break continue", "selfhost/seed_tests/sxported.stdout")
  hold p7 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "break\n")
