  hold p12 = pr_assert("selfhost/seed_tests/cq/sxpkg.c", "static char \\*toml_field(char \\*text, char \\*key);", 0, 0, 0, 0, 1)
  hold p13 = pg_emit_stream(0, "selfhost/seed_tests/cq/odd.sa", "selfhost/seed_tests/cq/odd_seed.c", 0, "selfhost/seed_tests/cq/odd_seed.c.emit.log", "selfhost/seed_tests/cq/odd_seed.c.err")
  hold p14 = pr_assert("selfhost/seed_tests/cq/odd_seed.c", "static double add2(double a, double b){", 0, 0, 0, 0, 1)
  give 0
}

