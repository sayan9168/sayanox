  give 0
}

make mp_test_sxdiag() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_command("./tools/sxdiag inline ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-inline", "test-sxdiag child command")
  hold p2 = pg_command("./tools/sxdiag postfix ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-postfix", "test-sxdiag child command")
  hold p3 = pg_command("./tools/sxdiag return ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-return", "test-sxdiag child command")
  hold p4 = pg_command("./tools/sxdiag name ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-name", "test-sxdiag child command")
  hold p5 = pg_expect_failure("./tools/sxdiag bogus ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-bad >/dev/null 2>&1", "test-sxdiag refusal")
  hold p6 = pg_probe("./tools/sxdiag bogus ./selfhost/seed/sxc_seed_min ./selfhost/gen2 ./selfhost/native_aot selfhost/seed_tests/sxdiag-bad", 2, "selfhost/seed_tests/sxmore.diagnostic")
  hold p7 = pr_assert("selfhost/seed_tests/sxmore.diagnostic", "unknown suite", 0, 0, 0, 0, 1)
  hold p8 = pg_expect_failure("./tools/sxdiag 2>/dev/null", "test-sxdiag refusal")
  hold p9 = pg_expect_failure("./tools/sxdiag return /bin/true /bin/true /bin/true selfhost/seed_tests/sxdiag-dead >/dev/null 2>&1", "test-sxdiag refusal")
  hold p10 = pg_expect_failure("./tools/sxdiag inline /bin/true /bin/true /bin/true selfhost/seed_tests/sxdiag-dead >/dev/null 2>&1", "test-sxdiag refusal")
  hold p11 = gl_must_write("selfhost/seed_tests/sxdiag_run.sa", "show run_command(\"exit 3\")\nhold r = run_command(\"echo builtin-run-ok > selfhost/seed_tests/sxdiag-run.txt\")\nshow r\n")
  hold p12 = pg_emit_stream(1, "selfhost/seed_tests/sxdiag_run.sa", "selfhost/seed_tests/sxdiag_run.c", 0, "/dev/null", "selfhost/seed_tests/sxdiag_run.c.err")
  hold p13 = gl_compile_c("selfhost/seed_tests/sxdiag_run.c", "selfhost/seed_tests/sxdiag_run", "-O2 -Werror=implicit-function-declaration")
  hold p14 = gl_assert_out("./selfhost/seed_tests/sxdiag_run", "3\n0", "selfhost/seed_tests/sxported.stdout")
  hold p15 = pr_assert("selfhost/seed_tests/sxdiag-run.txt", "builtin-run-ok", 0, 0, 0, 0, 1)
  hold p16 = gl_must_write("selfhost/seed_tests/sxdiag_run_seed.sa", "hold n = run_command(\"true\")\nshow n\n")
  hold p17 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/sxdiag_run_seed.sa >/dev/null 2>selfhost/seed_tests/sxdiag_run_seed.err", "test-sxdiag refusal")
  hold p18 = pr_assert("selfhost/seed_tests/sxdiag_run_seed.err", "unknown function or builtin", 0, 0, 0, 0, 1)
  hold p19 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/sxdiag_run_seed.sa selfhost/seed_tests/sxdiag_run_native 2>/dev/null", "test-sxdiag refusal")
  hold p20 = gl_must_write("selfhost/seed_tests/sxdiag_env.sa", "show getenv(\"SXDIAG_MARK\")\nhold unset = getenv(\"SXDIAG_NOT_SET\")\nshow concat(\"[\", concat(unset, \"]\"))\nwhen string_eq(getenv(\"SXDIAG_MODE\"), \"on\") { show \"mode-on\" }\n")
  hold p21 = pg_emit_stream(1, "selfhost/seed_tests/sxdiag_env.sa", "selfhost/seed_tests/sxdiag_env.c", 0, "/dev/null", "selfhost/seed_tests/sxdiag_env.c.err")
  hold p22 = gl_compile_c("selfhost/seed_tests/sxdiag_env.c", "selfhost/seed_tests/sxdiag_env", "-O2 -Werror=implicit-function-declaration")
  hold p23 = gl_assert_out("SXDIAG_MARK=marked SXDIAG_MODE=on ./selfhost/seed_tests/sxdiag_env", "marked\n[]\nmode-on", "selfhost/seed_tests/sxported.stdout")
  hold p24 = gl_assert_out("./selfhost/seed_tests/sxdiag_env", "\n[]", "selfhost/seed_tests/sxported.stdout")
  hold p25 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/sxdiag_env.sa >/dev/null 2>selfhost/seed_tests/sxdiag_env_seed.err", "test-sxdiag refusal")
  hold p26 = pr_assert("selfhost/seed_tests/sxdiag_env_seed.err", "unknown function or builtin", 0, 0, 0, 0, 1)
  hold p27 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/sxdiag_env.sa selfhost/seed_tests/sxdiag_env_native 2>/dev/null", "test-sxdiag refusal")
  give 0
}

make mp_test_stdlib_interpolation() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/stdlib_interpolation_test.sa", "selfhost/seed_tests/interp_seed.c", 0, "selfhost/seed_tests/interp_seed.c.emit.log", "selfhost/seed_tests/interp_seed.c.err")
  hold p2 = gl_compile_c("selfhost/seed_tests/interp_seed.c", "selfhost/seed_tests/interp_seed", "-O2")
  hold p3 = pg_emit_stream(1, "selfhost/stdlib_interpolation_test.sa", "selfhost/seed_tests/interp_gen2.c", 0, "selfhost/seed_tests/interp_gen2.c.emit.log", "selfhost/seed_tests/interp_gen2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/interp_gen2.c", "selfhost/seed_tests/interp_gen2", "-O2")
  hold p5 = gl_assert_out("./selfhost/seed_tests/interp_seed", "2\n10\n4\n-6\n0\n0.25\n1\n0\n0.5\n1\n25\n0.5", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_assert_out("./selfhost/seed_tests/interp_gen2", "2\n10\n4\n-6\n0\n0.25\n1\n0\n0.5\n1\n25\n0.5", "selfhost/seed_tests/sxported.stdout")
  when path_kind("selfhost/native_aot") == 1 {
  hold p7 = pg_emit_stream(2, "selfhost/stdlib_interpolation_test.sa", "selfhost/seed_tests/interp_native", 0, "selfhost/seed_tests/interp_native.emit.log", "selfhost/seed_tests/interp_native.err")
  hold p8 = pg_capture("./selfhost/seed_tests/interp_native", "selfhost/seed_tests/interp_native.out")
  hold p9 = pg_capture("./selfhost/seed_tests/interp_seed", "selfhost/seed_tests/interp_seed.out")
  hold p10 = gl_assert_files_eq("selfhost/seed_tests/interp_native.out", "selfhost/seed_tests/interp_seed.out", "test-stdlib-interpolation parity")
  }
  give 0
}

