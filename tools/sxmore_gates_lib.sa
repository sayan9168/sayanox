  hold p9 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "continue\n")
  hold p10 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_s2_bad.sa > selfhost/seed_tests/seed_s2_bad.c 2> selfhost/seed_tests/seed_s2_bad.err", "test-seed-stage2 refusal")
  hold p11 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "show not \"x\"\n")
  hold p12 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_s2_bad.sa > selfhost/seed_tests/seed_s2_bad.c 2> selfhost/seed_tests/seed_s2_bad.err", "test-seed-stage2 refusal")
  hold p13 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "show 1 and \"x\"\n")
  hold p14 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_s2_bad.sa > selfhost/seed_tests/seed_s2_bad.c 2> selfhost/seed_tests/seed_s2_bad.err", "test-seed-stage2 refusal")
  hold p15 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "show [] or 1\n")
  hold p16 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_s2_bad.sa > selfhost/seed_tests/seed_s2_bad.c 2> selfhost/seed_tests/seed_s2_bad.err", "test-seed-stage2 refusal")
  hold p17 = gl_must_write("selfhost/seed_tests/seed_s2_bad.sa", "show 1 and\n")
  hold p18 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_s2_bad.sa > selfhost/seed_tests/seed_s2_bad.c 2> selfhost/seed_tests/seed_s2_bad.err", "test-seed-stage2 refusal")
  hold p19 = gl_must_write("selfhost/seed_tests/seed_for_bad.sa", "for c in concat(1, \"b\") { show c }\n")
  hold p20 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/seed_for_bad.sa > /dev/null 2> selfhost/seed_tests/seed_for_bad.err", "test-seed-stage2 refusal")
  hold p21 = pr_assert("selfhost/seed_tests/seed_for_bad.err", "seed-min for", 0, 0, 0, 0, 1)
  give 0
}

