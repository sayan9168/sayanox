make mp_test_native_param_reassign() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(2, "selfhost/seed_typed_params_test.sa", "selfhost/seed_tests/npr_existing", 0, "selfhost/seed_tests/npr_existing.emit.log", "selfhost/seed_tests/npr_existing.err")
  hold p2 = gl_assert_out("./selfhost/seed_tests/npr_existing", "keep\nkeep!\nkeep\nb\na!\nxyxyxy\n3\n10\nkeep+\nkeep\n3\n4\nz\n+\ntyped-done", "selfhost/seed_tests/sxported.stdout")
  hold p3 = pg_emit_stream(0, "selfhost/native_param_reassign_test.sa", "selfhost/seed_tests/npr_seed.c", 0, "selfhost/seed_tests/npr_seed.c.emit.log", "selfhost/seed_tests/npr_seed.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/npr_seed.c", "selfhost/seed_tests/npr_seed", "-O2")
  hold p5 = pg_emit_stream(1, "selfhost/native_param_reassign_test.sa", "selfhost/seed_tests/npr_gen2.c", 0, "selfhost/seed_tests/npr_gen2.c.emit.log", "selfhost/seed_tests/npr_gen2.c.err")
  hold p6 = gl_compile_c("selfhost/seed_tests/npr_gen2.c", "selfhost/seed_tests/npr_gen2", "-O2")
  hold p7 = pg_emit_stream(2, "selfhost/native_param_reassign_test.sa", "selfhost/seed_tests/npr_native", 0, "selfhost/seed_tests/npr_native.emit.log", "selfhost/seed_tests/npr_native.err")
  hold p8 = gl_assert_out("./selfhost/seed_tests/npr_seed", "1\n2\n9\naxxx\na", "selfhost/seed_tests/sxported.stdout")
  hold p9 = gl_assert_out("./selfhost/seed_tests/npr_gen2", "1\n2\n9\naxxx\na", "selfhost/seed_tests/sxported.stdout")
  hold p10 = gl_assert_out("./selfhost/seed_tests/npr_native", "1\n2\n9\naxxx\na", "selfhost/seed_tests/sxported.stdout")
  hold p11 = pg_emit_stream(2, "selfhost/native_param_gc_test.sa", "selfhost/seed_tests/npr_gc", 0, "selfhost/seed_tests/npr_gc.emit.log", "selfhost/seed_tests/npr_gc.err")
  hold p12 = gl_assert_out("./selfhost/seed_tests/npr_gc", "local!\nlocal!!\nglobal\n99\n1\n2\n7", "selfhost/seed_tests/sxported.stdout")
  hold p13 = gl_must_write("selfhost/seed_tests/npr_bad.sa", "make f(s: str) -> str { s = 1\ngive s }\nshow f(\"a\")\n")
  hold p14 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/npr_bad.sa selfhost/seed_tests/npr_bad 2>selfhost/seed_tests/npr_bad.err", "test-native-param-reassign refusal")
  hold p15 = pr_assert("selfhost/seed_tests/npr_bad.err", "assignment to parameter", 0, 0, 0, 0, 1)
  hold p16 = gl_must_write("selfhost/seed_tests/npr_bad.sa", "make f(xs: list) -> list { xs = \"bad\"\ngive xs }\nhold a = [1]\nhold b = f(a)\n")
  hold p17 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/npr_bad.sa selfhost/seed_tests/npr_bad 2>selfhost/seed_tests/npr_bad.err", "test-native-param-reassign refusal")
  hold p18 = pr_assert("selfhost/seed_tests/npr_bad.err", "assignment to parameter", 0, 0, 0, 0, 1)
  hold p19 = gl_must_write("selfhost/seed_tests/npr_bad.sa", "make f(n: num) -> num { n = \"bad\"\ngive n }\nshow f(1)\n")
  hold p20 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/npr_bad.sa selfhost/seed_tests/npr_bad 2>selfhost/seed_tests/npr_bad.err", "test-native-param-reassign refusal")
  hold p21 = pr_assert("selfhost/seed_tests/npr_bad.err", "assignment to parameter", 0, 0, 0, 0, 1)
  give 0
}

make mp_test_native_generic_local() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(2, "selfhost/seed_typed_loops_test.sa", "selfhost/seed_tests/ngl_loops", 0, "selfhost/seed_tests/ngl_loops.emit.log", "selfhost/seed_tests/ngl_loops.err")
  hold p2 = gl_assert_out("./selfhost/seed_tests/ngl_loops", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done", "selfhost/seed_tests/sxported.stdout")
  hold p3 = pg_emit_stream(2, "selfhost/seed_generics_extended_test.sa", "selfhost/seed_tests/ngl_extended", 0, "selfhost/seed_tests/ngl_extended.emit.log", "selfhost/seed_tests/ngl_extended.err")
  hold p4 = gl_assert_out("./selfhost/seed_tests/ngl_extended", "3\nhi\n2\nfirst\nsecond\n2\n8\nnested\n15\nxyxyxy\n3\n6\no\nk\n4\n5\n6", "selfhost/seed_tests/sxported.stdout")
  hold p5 = pg_emit_stream(2, "selfhost/native_generic_local_test.sa", "selfhost/seed_tests/ngl_native", 0, "selfhost/seed_tests/ngl_native.emit.log", "selfhost/seed_tests/ngl_native.err")
  hold p6 = pg_emit_stream(0, "selfhost/native_generic_local_test.sa", "selfhost/seed_tests/ngl_seed.c", 0, "selfhost/seed_tests/ngl_seed.c.emit.log", "selfhost/seed_tests/ngl_seed.c.err")
  hold p7 = gl_compile_c("selfhost/seed_tests/ngl_seed.c", "selfhost/seed_tests/ngl_seed", "-O2")
  hold p8 = pg_emit_stream(1, "selfhost/native_generic_local_test.sa", "selfhost/seed_tests/ngl_gen2.c", 0, "selfhost/seed_tests/ngl_gen2.c.emit.log", "selfhost/seed_tests/ngl_gen2.c.err")
  hold p9 = gl_compile_c("selfhost/seed_tests/ngl_gen2.c", "selfhost/seed_tests/ngl_gen2", "-O2")
  hold p10 = gl_assert_out("./selfhost/seed_tests/ngl_native", "9\nhello!\n3\nhello", "selfhost/seed_tests/sxported.stdout")
  hold p11 = gl_assert_out("./selfhost/seed_tests/ngl_seed", "9\nhello!\n3\nhello", "selfhost/seed_tests/sxported.stdout")
  hold p12 = gl_assert_out("./selfhost/seed_tests/ngl_gen2", "9\nhello!\n3\nhello", "selfhost/seed_tests/sxported.stdout")
  hold p13 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "hold n: num = \"bad\"\n")
  hold p14 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p15 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p16 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "hold xs: list = 3\n")
  hold p17 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p18 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p19 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "hold s: str = \"a\"\nhold s: num = 2\n")
  hold p20 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p21 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p22 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "hold x: other = 1\n")
  hold p23 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p24 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p25 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "make f() -> num { hold x: num = \"bad\"\ngive 0 }\nshow f()\n")
  hold p26 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p27 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p28 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "make f<T>(x:T)->T { hold local:T = \"bad\"\ngive x }\nshow f(1)\n")
  hold p29 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p30 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  hold p31 = gl_must_write("selfhost/seed_tests/ngl_bad.sa", "make f<T>(x:T)->T { give concat(x,\"bad\") }\nshow f(1)\n")
  hold p32 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/ngl_bad.sa selfhost/seed_tests/ngl_bad 2>selfhost/seed_tests/ngl_bad.err", "test-native-generic-local refusal")
  hold p33 = pr_assert("selfhost/seed_tests/ngl_bad.err", "native_aot:", 0, 0, 0, 0, 1)
  give 0
}

