make mp_test_proc_builtins() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = gl_rm_tree("selfhost/seed_tests/proc_frame_dir")
  hold p2 = pg_emit_stream(1, "selfhost/proc_frame_server.sa", "selfhost/seed_tests/proc_frame_server.c", 0, "/dev/null", "selfhost/seed_tests/proc_frame_server.c.err")
  hold p3 = gl_compile_c("selfhost/seed_tests/proc_frame_server.c", "selfhost/seed_tests/proc_frame_server", "-O2 -Werror=implicit-function-declaration")
  hold p4 = pg_emit_stream(1, "selfhost/proc_frame_client.sa", "selfhost/seed_tests/proc_frame_client.c", 0, "/dev/null", "selfhost/seed_tests/proc_frame_client.c.err")
  hold p5 = gl_compile_c("selfhost/seed_tests/proc_frame_client.c", "selfhost/seed_tests/proc_frame_client", "-O2 -Werror=implicit-function-declaration")
  hold p6 = pg_command(concat("./selfhost/seed_tests/proc_frame_client '", concat(path_real("."), concat("/selfhost/seed_tests/proc_frame_server' '", concat(path_real("."), "/selfhost/seed_tests/proc_frame_dir' > selfhost/seed_tests/proc_frame.out")))), "test-proc-builtins child command")
  hold p7 = gl_must_write("selfhost/seed_tests/proc_frame.want", "spawn, child_send, child_line, child_recv, child_close: one framed session, two answers, clean exit\nmake_dir, make_link, remove_path and dead handles behave as documented\n")
  hold p8 = gl_assert_files_eq("selfhost/seed_tests/proc_frame.want", "selfhost/seed_tests/proc_frame.out", "test-proc-builtins parity")
  hold p9 = gl_must_write("selfhost/seed_tests/proc_frame_seed.sa", "hold h = spawn(\"x\")\nshow h\nhold n = make_dir(\"x\")\nshow n\n")
  hold p10 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/proc_frame_seed.sa > /dev/null 2>selfhost/seed_tests/proc_frame_seed.err", "test-proc-builtins refusal")
  hold p11 = pr_assert("selfhost/seed_tests/proc_frame_seed.err", "call names an unknown function or builtin", 0, 0, 0, 0, 1)
  give 0
}

