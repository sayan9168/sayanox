  hold p7 = pg_capture("./selfhost/seed_tests/tfp_gen2", "selfhost/seed_tests/tfp_gen2.out")
  hold p8 = gl_assert_files_eq("selfhost/seed_tests/tfp_seed.out", "selfhost/seed_tests/tfp_gen2.out", "test-for-paren parity")
  when path_kind("selfhost/native_aot") == 1 {
  hold p9 = pg_emit_stream(2, "selfhost/for_paren_test.sa", "selfhost/seed_tests/tfp_native", 0, "selfhost/seed_tests/tfp_native.emit.log", "selfhost/seed_tests/tfp_native.err")
  hold p10 = pg_capture("./selfhost/seed_tests/tfp_native", "selfhost/seed_tests/tfp_native.out")
  hold p11 = gl_assert_files_eq("selfhost/seed_tests/tfp_seed.out", "selfhost/seed_tests/tfp_native.out", "test-for-paren parity")
  }
  give 0
}

