make mp_test_gen2_expr_lowering() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/gen2_str_cat_test.sa", "selfhost/seed_tests/gsc_seed.c", 0, "selfhost/seed_tests/gsc_seed.c.emit.log", "selfhost/seed_tests/gsc_seed.c.err")
  hold p2 = gl_compile_c("selfhost/seed_tests/gsc_seed.c", "selfhost/seed_tests/gsc_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p3 = pg_emit_stream(1, "selfhost/gen2_str_cat_test.sa", "selfhost/seed_tests/gsc_gen2.c", 0, "/dev/null", "selfhost/seed_tests/gsc_gen2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/gsc_gen2.c", "selfhost/seed_tests/gsc_gen2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p5 = gl_assert_out("./selfhost/seed_tests/gsc_seed", "hi bob\nsay \"hi\" kim\nLR\nxabcy\nabc!\npq/p\n[L-R]\n1\n2\nhi abc\nstr-cat-done", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_assert_out("./selfhost/seed_tests/gsc_gen2", "hi bob\nsay \"hi\" kim\nLR\nxabcy\nabc!\npq/p\n[L-R]\n1\n2\nhi abc\nstr-cat-done", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "return sx_cat(\"hi \" , n);", 1, 0, 0, 0, 1)
  hold p8 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "return sx_cat(sx_cat(\"x\" , n) , \"y\");", 1, 0, 0, 0, 1)
  hold p9 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "return sx_cat(n , \"!\");", 1, 0, 0, 0, 1)
  hold p10 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "return sx_cat(sx_cat(sx_cat(p, q) , \"/\") , p);", 1, 0, 0, 0, 1)
  hold p11 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "char *j = sx_cat(sx_cat(a, \"-\"), b);", 1, 0, 0, 0, 1)
  hold p12 = pr_assert("selfhost/seed_tests/gsc_gen2.c", "\" + n", 0, 0, 0, 0, 0)
  when path_kind("selfhost/native_aot") == 1 {
  hold p13 = pg_emit_stream(2, "selfhost/gen2_str_cat_test.sa", "selfhost/seed_tests/gsc_native", 0, "selfhost/seed_tests/gsc_native.emit.log", "selfhost/seed_tests/gsc_native.err")
  hold p14 = pg_capture("./selfhost/seed_tests/gsc_native", "selfhost/seed_tests/gsc_native.out")
  hold p15 = pg_capture("./selfhost/seed_tests/gsc_seed", "selfhost/seed_tests/gsc_seed.out")
  hold p16 = gl_assert_files_eq("selfhost/seed_tests/gsc_seed.out", "selfhost/seed_tests/gsc_native.out", "test-gen2-expr-lowering parity")
  }
  hold p17 = pg_emit_stream(0, "selfhost/gen2_index_call_test.sa", "selfhost/seed_tests/gic_seed.c", 0, "selfhost/seed_tests/gic_seed.c.emit.log", "selfhost/seed_tests/gic_seed.c.err")
  hold p18 = gl_compile_c("selfhost/seed_tests/gic_seed.c", "selfhost/seed_tests/gic_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p19 = pg_emit_stream(1, "selfhost/gen2_index_call_test.sa", "selfhost/seed_tests/gic_gen2.c", 0, "/dev/null", "selfhost/seed_tests/gic_gen2.c.err")
  hold p20 = gl_compile_c("selfhost/seed_tests/gic_gen2.c", "selfhost/seed_tests/gic_gen2", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p21 = gl_assert_out("./selfhost/seed_tests/gic_seed", "40\n30\n20\n40\n102\n101\n40\n70\n100\n101\n0\n1\n2\n1\n40\n2\n102\nindex-call-done", "selfhost/seed_tests/sxported.stdout")
  hold p22 = gl_assert_out("./selfhost/seed_tests/gic_gen2", "40\n30\n20\n40\n102\n101\n40\n70\n100\n101\n0\n1\n2\n1\n40\n2\n102\nindex-call-done", "selfhost/seed_tests/sxported.stdout")
  hold p23 = pr_assert("selfhost/seed_tests/gic_gen2.c", "sx_lget(xs,sx_llen(xs) - 1.0)", 1, 0, 0, 0, 1)
  hold p24 = pr_assert("selfhost/seed_tests/gic_gen2.c", "sx_idx(s,sx_len(s) - 1.0)", 1, 0, 0, 0, 1)
  hold p25 = pr_assert("selfhost/seed_tests/gic_gen2.c", "sx_lget(xs,sx_lget(ys,0.0))", 1, 0, 0, 0, 1)
  hold p26 = pr_assert("selfhost/seed_tests/gic_gen2.c", "if (sx_lget(xs,sx_llen(xs) - 1.0) > 39.0)", 1, 0, 0, 0, 1)
  hold p27 = pr_assert("selfhost/seed_tests/gic_gen2.c", "for (k = 0.0; k < sx_lget(ys,sx_llen(ys) - 1.0)", 1, 0, 0, 0, 1)
  hold p28 = pr_assert("selfhost/seed_tests/gic_gen2.c", "return sx_lget(v,sx_llen(v) - 1.0);", 1, 0, 0, 0, 1)
  hold p29 = pr_assert("selfhost/seed_tests/gic_gen2.c", "return sx_idx(t,sx_len(t) - 1.0);", 1, 0, 0, 0, 1)
  hold p30 = pr_assert("selfhost/seed_tests/gic_gen2.c", "xs\\[", 0, 0, 0, 0, 0)
  when path_kind("selfhost/native_aot") == 1 {
  hold p31 = pg_emit_stream(2, "selfhost/gen2_index_call_test.sa", "selfhost/seed_tests/gic_native", 0, "selfhost/seed_tests/gic_native.emit.log", "selfhost/seed_tests/gic_native.err")
  hold p32 = pg_capture("./selfhost/seed_tests/gic_native", "selfhost/seed_tests/gic_native.out")
  hold p33 = pg_capture("./selfhost/seed_tests/gic_seed", "selfhost/seed_tests/gic_seed.out")
  hold p34 = gl_assert_files_eq("selfhost/seed_tests/gic_seed.out", "selfhost/seed_tests/gic_native.out", "test-gen2-expr-lowering parity")
  }
  hold p35 = gl_must_write("selfhost/seed_tests/gel_bad_call.sa", "hold xs = [1, 2, 3]\nmake pick(v: list) -> num {\n  give v[0]\n}\nshow xs[pick(xs)]\n")
  hold p36 = gl_must_write("selfhost/seed_tests/gel_bad_quote.sa", "hold xs = [1, 2, 3]\nshow xs[\"a\"]\n")
  hold p37 = gl_must_write("selfhost/seed_tests/gel_bad_unbal.sa", "hold xs = [1, 2, 3]\nhold ys = [0]\nshow xs[ys[0]\n")
  hold p38 = gl_must_write("selfhost/seed_tests/gel_bad_mix.sa", "make bad(x: str, v: num) -> str {\n  give \"v=\" + v\n}\nshow bad(\"q\", 3)\n")
  hold p39 = gl_must_write("selfhost/seed_tests/gel_bad_pctstr.sa", "make bad2(x: num, s: str) -> num {\n  give x % s\n}\nshow bad2(4, \"ab\")\n")
  hold p40 = pg_emit_stream(1, "selfhost/seed_tests/gel_bad_call.sa", "selfhost/seed_tests/gel_bad_call.c", 0, "selfhost/seed_tests/gel_bad_call.msg", "selfhost/seed_tests/gel_bad_call.c.err")
  hold p41 = pr_assert("selfhost/seed_tests/gel_bad_call.c", "#error sayanox-min:", 0, 0, 0, 0, 1)
  hold p42 = pr_assert("selfhost/seed_tests/gel_bad_call.msg", "^min: ", 0, 0, 0, 0, 1)
  hold p43 = pg_emit_stream(1, "selfhost/seed_tests/gel_bad_quote.sa", "selfhost/seed_tests/gel_bad_quote.c", 0, "selfhost/seed_tests/gel_bad_quote.msg", "selfhost/seed_tests/gel_bad_quote.c.err")
  hold p44 = pr_assert("selfhost/seed_tests/gel_bad_quote.c", "#error sayanox-min:", 0, 0, 0, 0, 1)
  hold p45 = pr_assert("selfhost/seed_tests/gel_bad_quote.msg", "^min: ", 0, 0, 0, 0, 1)
  hold p46 = pg_emit_stream(1, "selfhost/seed_tests/gel_bad_unbal.sa", "selfhost/seed_tests/gel_bad_unbal.c", 0, "selfhost/seed_tests/gel_bad_unbal.msg", "selfhost/seed_tests/gel_bad_unbal.c.err")
  hold p47 = pr_assert("selfhost/seed_tests/gel_bad_unbal.c", "#error sayanox-min:", 0, 0, 0, 0, 1)
  hold p48 = pr_assert("selfhost/seed_tests/gel_bad_unbal.msg", "^min: ", 0, 0, 0, 0, 1)
  hold p49 = pg_emit_stream(1, "selfhost/seed_tests/gel_bad_mix.sa", "selfhost/seed_tests/gel_bad_mix.c", 0, "selfhost/seed_tests/gel_bad_mix.msg", "selfhost/seed_tests/gel_bad_mix.c.err")
  hold p50 = pr_assert("selfhost/seed_tests/gel_bad_mix.c", "#error sayanox-min:", 0, 0, 0, 0, 1)
  hold p51 = pr_assert("selfhost/seed_tests/gel_bad_mix.msg", "^min: ", 0, 0, 0, 0, 1)
  hold p52 = pg_emit_stream(1, "selfhost/seed_tests/gel_bad_pctstr.sa", "selfhost/seed_tests/gel_bad_pctstr.c", 0, "selfhost/seed_tests/gel_bad_pctstr.msg", "selfhost/seed_tests/gel_bad_pctstr.c.err")
  hold p53 = pr_assert("selfhost/seed_tests/gel_bad_pctstr.c", "#error sayanox-min:", 0, 0, 0, 0, 1)
  hold p54 = pr_assert("selfhost/seed_tests/gel_bad_pctstr.msg", "^min: ", 0, 0, 0, 0, 1)
  hold p55 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/gel_bad_mix.sa >/dev/null 2>&1", "test-gen2-expr-lowering refusal")
  hold p56 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/gel_bad_pctstr.sa >/dev/null 2>&1", "test-gen2-expr-lowering refusal")
  when path_kind("selfhost/native_aot") == 1 {
  hold p57 = pg_expect_failure("./selfhost/native_aot selfhost/seed_tests/gel_bad_pctstr.sa selfhost/seed_tests/gel_bad_pctstr_nat >/dev/null 2>&1", "test-gen2-expr-lowering refusal")
  }
  give 0
}

make mp_test_parity() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = gl_assert_eq_num(path_kind("selfhost/seed/sxc_seed_min"), 1, "compiler present: selfhost/seed/sxc_seed_min")
  hold p2 = gl_ensure_dir("selfhost/seed_tests")
  hold p3 = gl_must_write("selfhost/seed_tests/par_lib.sa", "hold lib = 7\n")
  hold p4 = gl_must_write("selfhost/seed_tests/par.sa", "use \"selfhost/seed_tests/par_lib.sa\"\n")
  hold p5 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "struct Point {\n  x,\n  y\n}\n"))
  hold p6 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "make twice(n) {\n  when n <= 0 {\n    give 0\n  }\n  give n * 2\n}\n"))
  hold p7 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "hold p = Point { x: 3, y: 4 }\n"))
  hold p8 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "hold xs = [10, 20, 30]\nhold i = 0\n"))
  hold p9 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "while i < 3 {\n  show i\n  hold i = i + 1\n}\n"))
  hold p10 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "when p.x < p.y {\n  show p.x + p.y\n} else {\n  show 0\n}\n"))
  hold p11 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "show lib\nshow 10 % 3\nshow twice(21)\nshow xs[2]\n"))
  hold p12 = gl_must_write("selfhost/seed_tests/par.sa", concat(read_file("selfhost/seed_tests/par.sa"), "hold xs = push(xs, 40)\nshow len(xs)\nshow concat(\"a\", \"b\")\n"))
  hold p13 = pg_emit_stream(0, "selfhost/seed_tests/par.sa", "selfhost/seed_tests/par_sm.c", 0, "selfhost/seed_tests/par_sm.c.emit.log", "selfhost/seed_tests/par_sm.c.err")
  hold p14 = gl_compile_c("selfhost/seed_tests/par_sm.c", "selfhost/seed_tests/par_sm", "-O2")
  hold p15 = pg_emit_stream(1, "selfhost/seed_tests/par.sa", "selfhost/seed_tests/par_g2.c", 0, "/dev/null", "selfhost/seed_tests/par_g2.c.err")
  hold p16 = gl_compile_c("selfhost/seed_tests/par_g2.c", "selfhost/seed_tests/par_g2", "-O2")
  hold p17 = pg_capture("./selfhost/seed_tests/par_sm", "selfhost/seed_tests/par_sm.out")
  hold p18 = pg_capture("./selfhost/seed_tests/par_g2", "selfhost/seed_tests/par_g2.out")
  hold p19 = gl_assert_files_eq("selfhost/seed_tests/par_sm.out", "selfhost/seed_tests/par_g2.out", "test-parity parity")
  give 0
}

make mp_test_boot() -> num {
  hold p0 = gl_assert_eq_num(path_kind("selfhost/gen2"), 1, "compiler present: selfhost/gen2")
  hold p1 = pg_emit_stream(1, "selfhost/compiler_boot.sa", "selfhost/boot_from_gen2.c", 0, "/dev/null", "selfhost/boot_from_gen2.c.err")
