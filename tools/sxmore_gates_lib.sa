  hold p13 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f(a) {\n  for c in a {\n    show c\n  }\n  give 0\n}\n")
  hold p14 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p15 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p16 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f() {\n  for v in missing {\n    show v\n  }\n  give 0\n}\n")
  hold p17 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p18 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p19 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f() {\n  for i in 0..\"x\" {\n    show i\n  }\n  give 0\n}\n")
  hold p20 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p21 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p22 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f() {\n  hold xs = [1]\n  for xs in xs {\n    show xs\n  }\n  give 0\n}\n")
  hold p23 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p24 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p25 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f() {\n  for c in chr(\"x\") {\n    show c\n  }\n  give 0\n}\n")
  hold p26 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p27 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p28 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "make f() {\n  hold x = nosuch(1)\n  give x\n}\n")
  hold p29 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p30 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p31 = gl_must_write("selfhost/seed_tests/for_untyped_bad.sa", "hold a = nosuch()\n")
  hold p32 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/for_untyped_bad.sa >/dev/null 2>selfhost/seed_tests/for_untyped_bad.err", "test-seed-for-untyped refusal")
  hold p33 = pr_assert("selfhost/seed_tests/for_untyped_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  when path_kind("selfhost/native_aot") == 1 {
  hold p34 = pg_emit_stream(2, "selfhost/seed_for_untyped_test.sa", "selfhost/seed_tests/for_untyped_native", 0, "selfhost/seed_tests/for_untyped_native.emit.log", "selfhost/seed_tests/for_untyped_native.err")
  hold p35 = pg_capture("./selfhost/seed_tests/for_untyped_native", "selfhost/seed_tests/for_untyped_native.out")
  hold p36 = pg_capture("./selfhost/seed_tests/for_untyped_seed", "selfhost/seed_tests/for_untyped_seed.out")
  hold p37 = gl_assert_files_eq("selfhost/seed_tests/for_untyped_seed.out", "selfhost/seed_tests/for_untyped_native.out", "test-seed-for-untyped parity")
  }
  give 0
}

make mp_test_seed_typed_functions() -> num {
  hold p0 = gl_ensure_dir("selfhost/seed_tests")
  hold p1 = pg_emit_stream(0, "selfhost/seed_typed_params_test.sa", "selfhost/seed_tests/typed_params_seed.c", 0, "selfhost/seed_tests/typed_params_seed.c.emit.log", "selfhost/seed_tests/typed_params_seed.c.err")
  hold p2 = gl_compile_c("selfhost/seed_tests/typed_params_seed.c", "selfhost/seed_tests/typed_params_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p3 = pg_emit_stream(1, "selfhost/seed_typed_params_test.sa", "selfhost/seed_tests/typed_params_gen2.c", 0, "selfhost/seed_tests/typed_params_gen2.c.emit.log", "selfhost/seed_tests/typed_params_gen2.c.err")
  hold p4 = gl_compile_c("selfhost/seed_tests/typed_params_gen2.c", "selfhost/seed_tests/typed_params_gen2", "-O2 -Werror=incompatible-pointer-types")
  hold p5 = gl_assert_out("./selfhost/seed_tests/typed_params_seed", "keep\nkeep!\nkeep\nb\na!\nxyxyxy\n3\n10\nkeep+\nkeep\n3\n4\nz\n+\ntyped-done", "selfhost/seed_tests/sxported.stdout")
  hold p6 = gl_assert_out("./selfhost/seed_tests/typed_params_gen2", "keep\nkeep!\nkeep\nb\na!\nxyxyxy\n3\n10\nkeep+\nkeep\n3\n4\nz\n+\ntyped-done", "selfhost/seed_tests/sxported.stdout")
  hold p7 = pg_emit_stream(0, "selfhost/seed_typed_loops_test.sa", "selfhost/seed_tests/typed_loops_seed.c", 0, "selfhost/seed_tests/typed_loops_seed.c.emit.log", "selfhost/seed_tests/typed_loops_seed.c.err")
  hold p8 = gl_compile_c("selfhost/seed_tests/typed_loops_seed.c", "selfhost/seed_tests/typed_loops_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p9 = pg_emit_stream(1, "selfhost/seed_typed_loops_test.sa", "selfhost/seed_tests/typed_loops_gen2.c", 0, "selfhost/seed_tests/typed_loops_gen2.c.emit.log", "selfhost/seed_tests/typed_loops_gen2.c.err")
  hold p10 = gl_compile_c("selfhost/seed_tests/typed_loops_gen2.c", "selfhost/seed_tests/typed_loops_gen2", "-O2 -Werror=incompatible-pointer-types")
  hold p11 = gl_assert_out("./selfhost/seed_tests/typed_loops_seed", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done", "selfhost/seed_tests/sxported.stdout")
  hold p12 = gl_assert_out("./selfhost/seed_tests/typed_loops_gen2", "3\n0\n2\n3\n10\n10\nok!\nglobal\nloops-done", "selfhost/seed_tests/sxported.stdout")
  hold p13 = pg_emit_stream(0, "selfhost/seed_typed_scope_test.sa", "selfhost/seed_tests/typed_scope_seed.c", 0, "selfhost/seed_tests/typed_scope_seed.c.emit.log", "selfhost/seed_tests/typed_scope_seed.c.err")
  hold p14 = gl_compile_c("selfhost/seed_tests/typed_scope_seed.c", "selfhost/seed_tests/typed_scope_seed", "-O2 -Werror=implicit-function-declaration -Werror=incompatible-pointer-types")
  hold p15 = gl_assert_out("./selfhost/seed_tests/typed_scope_seed", "9\n11\nforward!\n1", "selfhost/seed_tests/sxported.stdout")
  hold p16 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) -> str { give a }\nshow f(1)\n")
  hold p17 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p18 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p19 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) -> str { give a }\nshow f(concat(1, 2))\n")
  hold p20 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p21 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p22 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: num) -> num { give a }\nshow f(missing)\n")
  hold p23 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p24 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
  hold p25 = gl_must_write("selfhost/seed_tests/typed_functions_bad.sa", "make f(a: str) -> str { give a }\nshow f(unknown())\n")
  hold p26 = pg_expect_failure("./selfhost/seed/sxc_seed_min selfhost/seed_tests/typed_functions_bad.sa >/dev/null 2>selfhost/seed_tests/typed_functions_bad.err", "test-seed-typed-functions refusal")
  hold p27 = pr_assert("selfhost/seed_tests/typed_functions_bad.err", "seed_min:", 0, 0, 0, 0, 1)
