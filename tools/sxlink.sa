// tools/sxlink.sa -- the Sayanox ELF image writer and linker for the native
// x86-64 backend (Phase D, step 3; docs/ALL_SAYANOX_PHASE.md).
//
//   ./tools/sxlink <linked.elf> <dumpdir> <out.elf>

make fail(code: num, msg: str) -> num {
  hold w = write_file("/dev/stderr", concat("sxlink: ", msg))
  hold nl = write_file("/dev/stderr", "\n")
  hold stop = exit(code)
  give 0
}

use "tools/sxlink_lib.sa"

make run() -> num {
  when arg_count() < 4 {
    hold stop = fail(2, "usage: sxlink <linked.elf> <dumpdir> <out.elf>")
  }
  hold elf_path = arg(1)
  hold dir = arg(2)
  hold out_path = arg(3)
  hold elf = []
  hold got_elf = read_bytes(elf_path, elf)
  when got_elf < 0 {
    hold stop = fail(1, concat("cannot read ", elf_path))
  }
  when len(elf) < 232 {
    hold stop = fail(1, "the linked file is too small to be a native_aot ELF")
  }
  when elf[0] != 127 || elf[1] != 69 || elf[2] != 76 || elf[3] != 70 {
    hold stop = fail(1, "the linked file is not an ELF")
  }
  when le16_at(elf, 18) != 62 {
    hold stop = fail(1, "the linked file is not x86-64")
  }
  hold code = []
  hold got_code = read_bytes(concat(concat(dir, "/"), "code.bin"), code)
  when got_code < 0 {
    hold stop = fail(1, "cannot read code.bin from the dump directory")
  }
  hold data = []
  hold got_data = read_bytes(concat(concat(dir, "/"), "data.bin"), data)
  when got_data < 0 {
    hold stop = fail(1, "cannot read data.bin from the dump directory")
  }
  hold patch = []
  hold got_patch = read_bytes(concat(concat(dir, "/"), "patch.bin"), patch)
  when got_patch < 0 {
    hold stop = fail(1, "cannot read patch.bin from the dump directory")
  }
  when len(patch) % 16 != 0 {
    hold stop = fail(1, "patch.bin is not a whole number of 16-byte records")
  }
  hold meta = read_file(concat(concat(dir, "/"), "meta.txt"))
  when len(meta) == 0 {
    hold stop = fail(1, "cannot read meta.txt from the dump directory")
  }
  hold npc = parse_num(meta)
  hold img = link_image(code, data, patch, npc)
  when len(img) != len(elf) {
    show len(img)
    show len(elf)
    hold stop = fail(1, "the Sayanox-linked image has a different size than the C-linked one")
  }
  hold wrote = write_bytes(out_path, img)
  when wrote != 1 {
    hold stop = fail(1, concat("cannot write ", out_path))
  }
  show len(img)
  show len(code)
  show len(data)
  show len(patch) / 16
  give 0
}

hold rc = run()
