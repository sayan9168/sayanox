// tools/sxlink.sa -- the Sayanox ELF image writer and linker for the native
// x86-64 backend (Phase D, step 3; docs/ALL_SAYANOX_PHASE.md).
//
// selfhost/native_aot.c compiles a .sa program into two byte blobs -- machine
// code and the data segment -- plus a list of rel32 sites that only become
// resolvable once the final image layout is known. `write_elf()` in that C file
// is the piece that turns those three things into a runnable static ELF: it
// lays out the pages, writes the ELF header and the three program headers,
// copies code and data, seeds the collector's heap cursor and then patches
// every call and every `lea r12,[rip+disp32]`.
//
// This program is that piece, in Sayanox, built on nothing but the byte-buffer
// and bitwise surface added on 2026-10-18 (`push`, `xs[i]`, `len`,
// `write_bytes`, `shr`, `bit_and`) plus `read_bytes`, the binary reader added
// with it. It reads the seam dump that native_aot writes when
// SX_LINK_DUMP=<dir> is set:
//
//   <dir>/code.bin    the emitted machine code, cn bytes
//   <dir>/data.bin    the data segment, dn bytes
//   <dir>/patch.bin   npc+npr 16-byte records: rel32 site, then its target
//   <dir>/meta.txt    "npc npr cn dn"; only npc is read here, because the call
//                     records come first and their count is the one thing a
//                     reader cannot recover from patch.bin itself
//
//   ./tools/sxlink <linked.elf> <dumpdir> <out.elf>
//
// The linked ELF is an input because it is the thing the result is compared
// against: out must be byte-identical to it, and then out is chmod +x'd and
// RUN by `make test-native-sxlink`, so "the kernel loads an ELF that a Sayanox
// program wrote" is proved rather than assumed. It is read for that comparison
// and for two sanity checks (ELF magic, EM_X86_64) -- no part of the layout is
// taken from it. The header, the three program headers, the page rounding, the
// padding, the heap cursor and every rel32 are computed here.
//
// Honest limits, recorded rather than hidden:
//   * the patch records carry already-resolved targets. Turning a `make` name
//     or a builtin name into a code offset is the compiler's job and stays in
//     C; this program resolves offsets to bytes, not names to offsets.
//   * every value here is a Sayanox number, which is a C double: exact below
//     2^53. The image is at most CMAX+DMAX+2 pages (786,432 bytes) and every
//     address is BASE+offset, so nothing gets near that bound. The one place a
//     value is deliberately reduced modulo 2^32 is the rel32 displacement,
//     which is how a negative distance becomes its two's complement bytes.

make fail(code: num, msg: str) -> num {
  hold w = write_file("/dev/stderr", concat("sxlink: ", msg))
  hold nl = write_file("/dev/stderr", "\n")
  hold stop = exit(code)
  give 0
}

// ---- byte-buffer helpers --------------------------------------------------
// A buffer is an ordinary list of numbers, one per byte. `push` lowers to
// sx_lpush, which grows in place with amortised doubling, so appending a whole
// segment is linear rather than quadratic.

make put_u16(xs: list, v: num) -> list {
  xs = push(xs, bit_and(v, 255))
  xs = push(xs, bit_and(shr(v, 8), 255))
  give xs
}

make put_u32(xs: list, v: num) -> list {
  xs = put_u16(xs, bit_and(v, 65535))
  xs = put_u16(xs, shr(v, 16))
  give xs
}

make put_u64(xs: list, v: num) -> list {
  xs = put_u32(xs, bit_and(v, 4294967295))
  xs = put_u32(xs, shr(v, 32))
  give xs
}

make put_zeros(xs: list, n: num) -> list {
  hold i = 0
  while i < n {
    xs = push(xs, 0)
    i = i + 1
  }
  give xs
}

make put_bytes(xs: list, src: list, off: num, n: num) -> list {
  hold i = 0
  while i < n {
    xs = push(xs, src[off + i])
    i = i + 1
  }
  give xs
}

// ---- little-endian readers ------------------------------------------------

make le16_at(xs: list, off: num) -> num {
  give xs[off] + xs[off + 1] * 256
}

make le32_at(xs: list, off: num) -> num {
  give xs[off] + xs[off + 1] * 256 + xs[off + 2] * 65536 + xs[off + 3] * 16777216
}

make le64_at(xs: list, off: num) -> num {
  give le32_at(xs, off) + le32_at(xs, off + 4) * 4294967296
}

// ---- layout arithmetic ----------------------------------------------------
// Integer arithmetic only, through the checked `%`: a page mask is 2^64-4096,
// which a double cannot hold exactly, so rounding cannot go through `bit_and`.
// A value that is already page-aligned must not grow by a page, which is why
// both helpers special-case a zero remainder.

make round_page(n: num) -> num {
  hold r = n % 4096
  when r == 0 {
    give n
  }
  give n + (4096 - r)
}

make page_pad(n: num) -> num {
  hold r = n % 4096
  when r == 0 {
    give 0
  }
  give 4096 - r
}

make is_digit(c: num) -> num {
  hold r = 0
  when c >= 48 && c <= 57 {
    r = 1
  }
  give r
}

// meta.txt is "npc npr cn dn\n"; only the first number is needed here, so the
// scan stops at the first non-digit instead of running the four together.
make parse_num(text: str) -> num {
  hold n = len(text)
  hold v = 0
  hold i = 0
  hold on = 0
  while i < n {
    hold c = sx_index(text, i)
    when is_digit(c) == 1 {
      v = v * 10 + (c - 48)
      on = 1
    } otherwise {
      when on == 1 {
        i = n
      }
    }
    i = i + 1
  }
  give v
}

// ---- ELF header and program headers ---------------------------------------
// ELFCLASS64, little endian, ET_EXEC, EM_X86_64, three PT_LOAD segments and no
// section table: the 64 + 3*56 bytes native_aot writes.

make elf_header(entry: num) -> list {
  hold xs = [127, 69, 76, 70, 2, 1, 1, 0]
  xs = put_zeros(xs, 8)
  xs = put_u16(xs, 2)
  xs = put_u16(xs, 62)
  xs = put_u32(xs, 1)
  xs = put_u64(xs, entry)
  xs = put_u64(xs, 64)
  xs = put_u64(xs, 0)
  xs = put_u32(xs, 64)
  xs = put_u16(xs, 64)
  xs = put_u16(xs, 56)
  xs = put_u16(xs, 3)
  xs = put_u16(xs, 0)
  xs = put_u16(xs, 0)
  xs = put_u16(xs, 0)
  give xs
}

make program_header(xs: list, flags: num, off: num, va: num, filesz: num, memsz: num) -> list {
  xs = put_u32(xs, 1)
  xs = put_u32(xs, flags)
  xs = put_u64(xs, off)
  xs = put_u64(xs, va)
  xs = put_u64(xs, va)
  xs = put_u64(xs, filesz)
  xs = put_u64(xs, memsz)
  xs = put_u64(xs, 4096)
  give xs
}

// ---- the image ------------------------------------------------------------

make link_image(code: list, data: list, patch: list, npc: num) -> list {
  hold base = 4194304
  hold cn = len(code)
  hold dn = len(data)
  // Page 0 holds the headers and is mapped read-only. The code segment starts
  // on page 1 and spans whole pages, because the kernel refuses to map a
  // partial-page RX segment. The data segment follows it, and the file is
  // padded out to a page so the heap chunk that starts there is page-aligned.
  hold code_off = 4096
  hold code_len = round_page(cn)
  hold data_off = code_off + code_len
  hold data_va = base + data_off
  hold img = elf_header(base + code_off)
  img = program_header(img, 4, 0, base, code_off, code_off)
  img = program_header(img, 5, code_off, base + code_off, code_len, code_len)
  img = program_header(img, 6, data_off, data_va, dn, dn)
  // The C writer mallocs the whole image and memsets it, so the rest of page 0
  // is zero by construction; a buffer built by appending has to say so, and
  // without it the code segment lands at 232 instead of at 4096.
  img = put_zeros(img, code_off - len(img))
  img = put_bytes(img, code, 0, cn)
  img = put_zeros(img, code_len - cn)
  img = put_bytes(img, data, 0, dn)
  // The file is padded out to a page so the heap chunk that starts there is
  // page-aligned. Every fixup below is an indexed write, so the image has to be
  // grown to its final size first -- the C writer patches a fully-sized image
  // too, and this is the same order.
  img = put_zeros(img, page_pad(data_off + dn))
  // The collector's bump cursor starts one page past the end of the data
  // segment and the chunk list starts empty; both words live in the data
  // segment itself (OFF_CUR = 0, OFF_END = 24).
  hold cur = base + round_page(data_off + dn)
  img[ data_off ] = bit_and(cur, 255)
  img[ data_off + 1 ] = bit_and(shr(cur, 8), 255)
  img[ data_off + 2 ] = bit_and(shr(cur, 16), 255)
  img[ data_off + 3 ] = bit_and(shr(cur, 24), 255)
  img[ data_off + 4 ] = 0
  img[ data_off + 5 ] = 0
  img[ data_off + 6 ] = 0
  img[ data_off + 7 ] = 0
  hold e = 24
  while e < 32 {
    img[ data_off + e ] = 0
    e = e + 1
  }
  // rel32 fixups: every call site and every `lea r12,[rip+disp32]`. A record
  // holds the site and its resolved target, both offsets inside the image, so
  // the displacement is target - (site + 4) and the code segment's file offset
  // cancels out of it.
  hold np = len(patch) / 16
  when npc > np {
    hold stop = fail(1, "meta.txt claims more call patches than patch.bin holds")
  }
  hold i = 0
  while i < np {
    hold at = le64_at(patch, i * 16)
    hold to = le64_at(patch, i * 16 + 8)
    when at + 4 > cn {
      hold stop = fail(1, "a patch site is outside the code segment")
    }
    hold d = to - (at + 4)
    when d < 0 - 2147483648 || d > 2147483647 {
      hold stop = fail(1, "a rel32 displacement does not fit in 32 bits")
    }
    hold u = d
    when u < 0 {
      u = u + 4294967296
    }
    hold site = code_off + at
    img[ site ] = bit_and(u, 255)
    img[ site + 1 ] = bit_and(shr(u, 8), 255)
    img[ site + 2 ] = bit_and(shr(u, 16), 255)
    img[ site + 3 ] = bit_and(shr(u, 24), 255)
    i = i + 1
  }
  give img
}

make run() -> num {
  when arg_count() < 4 {
    hold stop = fail(2, "usage: sxlink <linked.elf> <dumpdir> <out.elf>")
  }
  hold elf_path = arg(1)
  hold dir = arg(2)
  hold out_path = arg(3)
  // The linked ELF is read for the comparison the gate makes, and to prove this
  // program was handed a real x86-64 image rather than an arbitrary file.
  hold elf = []
  hold got_elf = read_bytes(elf_path, elf)
  when got_elf < 0 {
    hold stop = fail(1, concat("cannot read ", elf_path))
  }
  when len(elf) < 232 {
    hold stop = fail(1, "the linked file is too small to be a native_aot ELF")
  }
  when elf[0] != 127 || elf[1] != 69 || elf[2] != 76 || elf[3] != 70 {
    hold stop = fail(1, "the linked file is not an ELF")
  }
  when le16_at(elf, 18) != 62 {
    hold stop = fail(1, "the linked file is not x86-64")
  }
  hold code = []
  hold got_code = read_bytes(concat(concat(dir, "/"), "code.bin"), code)
  when got_code < 0 {
    hold stop = fail(1, "cannot read code.bin from the dump directory")
  }
  hold data = []
  hold got_data = read_bytes(concat(concat(dir, "/"), "data.bin"), data)
  when got_data < 0 {
    hold stop = fail(1, "cannot read data.bin from the dump directory")
  }
  hold patch = []
  hold got_patch = read_bytes(concat(concat(dir, "/"), "patch.bin"), patch)
  when got_patch < 0 {
    hold stop = fail(1, "cannot read patch.bin from the dump directory")
  }
  when len(patch) % 16 != 0 {
    hold stop = fail(1, "patch.bin is not a whole number of 16-byte records")
  }
  hold meta = read_file(concat(concat(dir, "/"), "meta.txt"))
  when len(meta) == 0 {
    hold stop = fail(1, "cannot read meta.txt from the dump directory")
  }
  hold npc = parse_num(meta)
  hold img = link_image(code, data, patch, npc)
  when len(img) != len(elf) {
    show len(img)
    show len(elf)
    hold stop = fail(1, "the Sayanox-linked image has a different size than the C-linked one")
  }
  hold wrote = write_bytes(out_path, img)
  when wrote != 1 {
    hold stop = fail(1, concat("cannot write ", out_path))
  }
  show len(img)
  show len(code)
  show len(data)
  show len(patch) / 16
  give 0
}

hold rc = run()
