// Frozen independent expectations; do not edit by hand.
// Unicode module group: ucase (UAX #44 full case conversion and case folding).
// The oracle is an independent Python reference that reads the Unicode
// 17.0.0 Character Database files directly: UnicodeData.txt for the simple
// one-code-point mappings, SpecialCasing.txt for the multi-code-point ones
// (sharp s -> SS, the ligatures, Greek iota-subscript forms) and
// CaseFolding.txt for the folds. That reference is cross-checked against
// CPython's own case tables on every SpecialCasing entry before any
// expectation is frozen, which is how a wrong column order in the parser
// was caught. The generator is a host-side tool and is not tracked, so the
// .want bytes are the oracle.

use "stdlib/utf8.sa"
use "stdlib/ucase.sa"

make fx_i(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_csv(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    hold piece = fx_i(xs[i])
    when i > 0 {
      out = concat(out, ",")
    }
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num(tag: str, v: num) -> num {
  hold line = concat(tag, fx_i(v))
  show line
  give 0
}

// A leading bar, then the decimal CSV, so an empty list is still visible.
make fx_text(xs: list) -> str {
  hold body = fx_csv(xs)
  give concat("|", body)
}

// One simple-casing group, read back out of the module's own compressed table
// as [lo, hi, du, dl, dt] so the fixture compares the table, not just its
// effect.
// The fields are bound to plain numbers first: the seed-min profile refuses a
// list literal whose elements are index expressions, and this fixture has to
// compile there too.
make fx_group(lo: num) -> str {
  hold tbl = uc_case_groups()
  hold at = uc_find(tbl, lo, 5)
  when at < 0 {
    give "|"
  }
  hold a = tbl[at * 5]
  hold b = tbl[at * 5 + 1]
  hold c = tbl[at * 5 + 2]
  hold d = tbl[at * 5 + 3]
  hold e = tbl[at * 5 + 4]
  give concat("|", fx_csv([a, b, c, d, e]))
}

  hold z = fx_say("group 65 ", fx_group(65))
  hold z = fx_say("group 97 ", fx_group(97))
