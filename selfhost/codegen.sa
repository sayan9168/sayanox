// Full-language self-host codegen (Sayanox)
// Keywords: hold/show by first char; when len=4, while len>=5
// Target path: selfhost/SX_TARGET (no newline)

show 42

// Target path comes from selfhost/SX_TARGET (written by bootstrap)
hold path = read_file("selfhost/SX_TARGET")
hold source = read_file(path)
hold n = len(source)
hold pos = 0
hold ch = 0
hold ch2 = 0
hold val = 0
hold scanning = 0
hold first_char = 0
hold ident_len = 0
hold st = 0
hold emit = ""
hold piece = ""
hold ok = 1
hold depth = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

hold emit = "#include <stdio.h>\nint main(void){\n  double v = 0;\n"

while pos < n {
    hold ch = source[pos]
    when is_space(ch) == 1 {
        hold pos = pos + 1
    } otherwise {
        when ch == 123 {
            hold pos = pos + 1
            when st == 6 {
                hold piece = " {\n"
                hold emit = concat(emit, piece)
                hold depth = depth + 1
                hold st = 0
            } otherwise {
                when st == 8 {
                    hold piece = " {\n"
                    hold emit = concat(emit, piece)
                    hold depth = depth + 1
                    hold st = 0
                } otherwise {
                    hold ok = 0
                    hold pos = n
                }
            }
        } otherwise {
            when ch == 125 {
                hold pos = pos + 1
                hold piece = "  }\n"
                hold emit = concat(emit, piece)
                when depth > 0 {
                    hold depth = depth - 1
                } otherwise {
                    hold depth = 0
                }
                hold st = 0
            } otherwise {
                when ch == 61 {
                    hold pos = pos + 1
                    when st == 2 {
                        hold st = 3
                    } otherwise {
                        hold ok = 0
                        hold pos = n
                    }
                } otherwise {
                    when is_digit(ch) == 1 {
                        hold val = 0
                        hold scanning = 1
                        while scanning == 1 {
                            when pos < n {
                                hold ch2 = source[pos]
                                when is_digit(ch2) == 1 {
                                    hold val = val * 10 + (ch2 - 48)
                                    hold pos = pos + 1
                                } otherwise {
                                    hold scanning = 0
                                }
                            } otherwise {
                                hold scanning = 0
                            }
                        }
                        when st == 3 {
                            hold piece = "  v = "
                            hold emit = concat(emit, piece)
                            hold emit = concat(emit, str(val))
                            hold piece = ";\n"
                            hold emit = concat(emit, piece)
                            hold st = 0
                        } otherwise {
                            when st == 4 {
                                hold piece = "  printf(\"%g\\n\", (double)("
                                hold emit = concat(emit, piece)
                                hold emit = concat(emit, str(val))
                                hold piece = "));\n"
                                hold emit = concat(emit, piece)
                                hold st = 0
                            } otherwise {
                                when st == 5 {
                                    hold piece = "  if ("
                                    hold emit = concat(emit, piece)
                                    hold emit = concat(emit, str(val))
                                    hold piece = ")"
                                    hold emit = concat(emit, piece)
                                    hold st = 6
                                } otherwise {
                                    when st == 7 {
                                        hold piece = "  while ("
                                        hold emit = concat(emit, piece)
                                        hold emit = concat(emit, str(val))
                                        hold piece = ")"
                                        hold emit = concat(emit, piece)
                                        hold st = 8
                                    } otherwise {
                                        hold ok = 0
                                        hold pos = n
                                    }
                                }
                            }
                        }
                    } otherwise {
                        when is_alpha(ch) == 1 {
                            hold first_char = ch
                            hold ident_len = 0
                            hold scanning = 1
                            while scanning == 1 {
                                when pos < n {
                                    hold ch2 = source[pos]
                                    when is_alpha(ch2) == 1 {
                                        hold ident_len = ident_len + 1
                                        hold pos = pos + 1
                                    } otherwise {
                                        when is_digit(ch2) == 1 {
                                            hold ident_len = ident_len + 1
                                            hold pos = pos + 1
                                        } otherwise {
                                            hold scanning = 0
                                        }
                                    }
                                } otherwise {
                                    hold scanning = 0
                                }
                            }
                            when st == 0 {
                                when first_char == 104 {
                                    hold st = 1
                                } otherwise {
                                    when first_char == 115 {
                                        hold st = 4
                                    } otherwise {
                                        when first_char == 119 {
                                            when ident_len >= 5 {
                                                hold st = 7
                                            } otherwise {
                                                hold st = 5
                                            }
                                        } otherwise {
                                            hold ok = 0
                                            hold pos = n
                                        }
                                    }
                                }
                            } otherwise {
                                when st == 1 {
                                    hold st = 2
                                } otherwise {
                                    when st == 4 {
                                        hold piece = "  printf(\"%g\\n\", v);\n"
                                        hold emit = concat(emit, piece)
                                        hold st = 0
                                    } otherwise {
                                        when st == 5 {
                                            hold piece = "  if (v)"
                                            hold emit = concat(emit, piece)
                                            hold st = 6
                                        } otherwise {
                                            when st == 7 {
                                                hold piece = "  while (v)"
                                                hold emit = concat(emit, piece)
                                                hold st = 8
                                            } otherwise {
                                                hold ok = 0
                                                hold pos = n
                                            }
                                        }
                                    }
                                }
                            }
                        } otherwise {
                            hold pos = pos + 1
                            hold ok = 0
                            hold pos = n
                        }
                    }
                }
            }
        }
    }
}

hold piece = "  return 0;\n}\n"
hold emit = concat(emit, piece)
write_file("selfhost/codegen_emit.c", emit)
when ok == 1 {
    show 1
} otherwise {
    show 0
}
show 42
