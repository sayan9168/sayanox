// Step 4.1 codegen: hold name = number; show name|number
// State machine in Sayanox. Emits selfhost/codegen_emit.c
//
//   ./selfhost/step4_hold_show.sh

show "=== codegen 4.1 hold+show ==="

hold path = "selfhost/hold_show.sa"
hold source = read_file(path)
hold n = len(source)
hold pos = 0
hold ch = 0
hold ch2 = 0
hold val = 0
hold scanning = 0
hold first_char = 0
hold st = 0
hold var_first = 0
hold var_val = 0
hold has_var = 0
hold emit = ""
hold piece = ""
hold ok = 1

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

hold emit = "#include <stdio.h>\nint main(void){\n"

while pos < n {
    hold ch = source[pos]
    when is_space(ch) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(ch) == 1 {
            hold val = 0
            hold scanning = 1
            while scanning == 1 {
                when pos < n {
                    hold ch2 = source[pos]
                    when is_digit(ch2) == 1 {
                        hold val = val * 10 + (ch2 - 48)
                        hold pos = pos + 1
                    } otherwise {
                        hold scanning = 0
                    }
                } otherwise {
                    hold scanning = 0
                }
            }
            when st == 3 {
                hold var_val = val
                hold has_var = 1
                hold piece = "  double v = "
                hold emit = concat(emit, piece)
                hold emit = concat(emit, str(val))
                hold piece = ";\n"
                hold emit = concat(emit, piece)
                hold st = 0
            } otherwise {
                when st == 4 {
                    hold piece = "  printf(\"%g\\n\", (double)("
                    hold emit = concat(emit, piece)
                    hold emit = concat(emit, str(val))
                    hold piece = "));\n"
                    hold emit = concat(emit, piece)
                    hold st = 0
                } otherwise {
                    hold ok = 0
                    hold pos = n
                }
            }
        } otherwise {
            when is_alpha(ch) == 1 {
                hold first_char = ch
                hold scanning = 1
                while scanning == 1 {
                    when pos < n {
                        hold ch2 = source[pos]
                        when is_alpha(ch2) == 1 {
                            hold pos = pos + 1
                        } otherwise {
                            when is_digit(ch2) == 1 {
                                hold pos = pos + 1
                            } otherwise {
                                hold scanning = 0
                            }
                        }
                    } otherwise {
                        hold scanning = 0
                    }
                }
                when st == 0 {
                    when first_char == 104 {
                        hold st = 1
                    } otherwise {
                        when first_char == 115 {
                            hold st = 4
                        } otherwise {
                            hold ok = 0
                            hold pos = n
                        }
                    }
                } otherwise {
                    when st == 1 {
                        hold var_first = first_char
                        hold st = 2
                    } otherwise {
                        when st == 4 {
                            hold piece = "  printf(\"%g\\n\", v);\n"
                            hold emit = concat(emit, piece)
                            hold st = 0
                        } otherwise {
                            hold ok = 0
                            hold pos = n
                        }
                    }
                }
            } otherwise {
                when ch == 61 {
                    hold pos = pos + 1
                    when st == 2 {
                        hold st = 3
                    } otherwise {
                        hold ok = 0
                        hold pos = n
                    }
                } otherwise {
                    hold pos = pos + 1
                    hold ok = 0
                    hold pos = n
                }
            }
        }
    }
}

hold piece = "  return 0;\n}\n"
hold emit = concat(emit, piece)
write_file("selfhost/codegen_emit.c", emit)

when ok == 1 {
    show "codegen OK"
    show has_var
    show var_val
} otherwise {
    show "codegen FAIL"
}
show "=== codegen 4.1 done ==="
