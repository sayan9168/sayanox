// Sayanox-written codegen (Step 3)
// Parse show <number> from hello.sa and emit C to selfhost/codegen_emit.c
// Pipeline is entirely driven from .sa (lex/parse/emit logic).
//
//   ./selfhost/step3_codegen.sh
// Expected: codegen OK, emitted binary prints 42

show "=== Sayanox codegen.sa ==="

hold path = "selfhost/hello.sa"
hold source = read_file(path)
hold n = len(source)
hold pos = 0
hold ch = 0
hold ch2 = 0
hold val = 0
hold scanning = 0
hold tok_val = 0
hold parse_ok = 0
hold ast_number = 0
hold phase = 0
hold part_a = ""
hold part_b = ""
hold part_c = ""
hold out = ""

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}

make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

hold phase = 0
hold parse_ok = 0
hold ast_number = 0

while phase < 2 {
    when pos >= n {
        hold phase = 3
    } otherwise {
        hold ch = source[pos]
        when is_space(ch) == 1 {
            hold pos = pos + 1
        } otherwise {
            when is_digit(ch) == 1 {
                hold val = 0
                hold scanning = 1
                while scanning == 1 {
                    when pos < n {
                        hold ch2 = source[pos]
                        when is_digit(ch2) == 1 {
                            hold val = val * 10 + (ch2 - 48)
                            hold pos = pos + 1
                        } otherwise {
                            hold scanning = 0
                        }
                    } otherwise {
                        hold scanning = 0
                    }
                }
                when phase == 1 {
                    hold ast_number = val
                    hold phase = 2
                    hold parse_ok = 1
                } otherwise {
                    hold phase = 3
                }
            } otherwise {
                when is_alpha(ch) == 1 {
                    hold tok_val = ch
                    hold scanning = 1
                    while scanning == 1 {
                        when pos < n {
                            hold ch2 = source[pos]
                            when is_alpha(ch2) == 1 {
                                hold pos = pos + 1
                            } otherwise {
                                when is_digit(ch2) == 1 {
                                    hold pos = pos + 1
                                } otherwise {
                                    hold scanning = 0
                                }
                            }
                        } otherwise {
                            hold scanning = 0
                        }
                    }
                    when phase == 0 {
                        when tok_val == 115 {
                            hold phase = 1
                        } otherwise {
                            hold phase = 3
                        }
                    } otherwise {
                        hold phase = 3
                    }
                } otherwise {
                    hold pos = pos + 1
                    hold phase = 3
                }
            }
        }
    }
}

when parse_ok == 1 {
    show "AST Show"
    show ast_number
    hold part_a = "#include <stdio.h>\nint main(void){ puts(\""
    hold part_b = str(ast_number)
    hold part_c = "\"); return 0; }\n"
    hold out = concat(part_a, part_b)
    hold out = concat(out, part_c)
    write_file("selfhost/codegen_emit.c", out)
    show "wrote selfhost/codegen_emit.c"
    show "codegen OK"
} otherwise {
    show "codegen FAIL"
}

show "=== codegen done ==="
