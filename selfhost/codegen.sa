// ============================================================
// Sayanox Self-Hosting — Phase 4
// Codegen: walk AST (parallel arrays) and emit C source
// ============================================================

show "=== Sayanox Self-Hosted Codegen Phase 4 ==="

hold ST_SHOW   = 1
hold ST_HOLD   = 2
hold ST_MAKE   = 3
hold ST_GIVE   = 4
hold ST_WHEN   = 5
hold ST_WHILE  = 6
hold ST_EXPR   = 7
hold EX_NUMBER = 10
hold EX_IDENT  = 11
hold EX_BINARY = 12
hold EX_CALL   = 13
hold OP_ADD = 20
hold OP_SUB = 21
hold OP_MUL = 22
hold OP_DIV = 23

hold kind  = []
hold left  = []
hold right = []
hold value = []
hold count = 0

make ast_new(k, l, r, v) {
    push(kind, k)
    push(left, l)
    push(right, r)
    push(value, v)
    hold id = count
    hold count = count + 1
    give id
}

hold num_node = ast_new(EX_NUMBER, -1, -1, 42)
hold show_node = ast_new(ST_SHOW, num_node, -1, 0)
hold stmts = []
push(stmts, show_node)

make emit_header() {
    show "// Generated by Sayanox self-hosted codegen (Phase 4)"
    show "#include <stdio.h>"
    show "#include <stdlib.h>"
    show ""
    give 0
}

make emit_expr(node) {
    when node < 0 {
        show "0"
        give 0
    } otherwise {
        hold k = kind[node]
        when k == EX_NUMBER {
            show value[node]
            give 0
        } otherwise {
            when k == EX_IDENT {
                show "v"
                show value[node]
                give 0
            } otherwise {
                when k == EX_BINARY {
                    show "("
                    emit_expr(left[node])
                    hold op = value[node]
                    when op == OP_ADD {
                        show "+"
                    } otherwise {
                        when op == OP_SUB {
                            show "-"
                        } otherwise {
                            when op == OP_MUL {
                                show "*"
                            } otherwise {
                                show "/"
                            }
                        }
                    }
                    emit_expr(right[node])
                    show ")"
                    give 0
                } otherwise {
                    show "0"
                    give 0
                }
            }
        }
    }
}

make emit_stmt(node) {
    when node < 0 {
        give 0
    } otherwise {
        hold k = kind[node]
        when k == ST_SHOW {
            show "    printf(\"%g\\n\", "
            emit_expr(left[node])
            show ");"
            give 0
        } otherwise {
            when k == ST_HOLD {
                show "    double v = "
                emit_expr(left[node])
                show ";"
                give 0
            } otherwise {
                when k == ST_GIVE {
                    show "    return "
                    emit_expr(left[node])
                    show ";"
                    give 0
                } otherwise {
                    when k == ST_EXPR {
                        show "    "
                        emit_expr(left[node])
                        show ";"
                        give 0
                    } otherwise {
                        show "    /* unsupported stmt */"
                        give 0
                    }
                }
            }
        }
    }
}

make emit_program() {
    emit_header()
    show "int main() {"
    hold i = 0
    hold n = len(stmts)
    while i < n {
        emit_stmt(stmts[i])
        hold i = i + 1
    }
    show "    return 0;"
    show "}"
    give 0
}

show "--- Emitted C ---"
emit_program()
show "--- End ---"

show "Self-hosted Codegen Phase 4 finished"
show "Next: wire lexer \u2192 parser \u2192 codegen into one pipeline"
