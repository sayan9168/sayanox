// Input: abcLINE newline EOF. SX_CONTRACT_ENV=present, no external network.
show (string_eq(read_n(3), "abc"))
show (string_eq(read_line(), "LINE"))
show (len(read_n(2)))
show (len(read_line()))
hold written = write_out("raw")
show written
show (flush_out())
when getenv("SX_CONTRACT_ENV") == "present" {
  show 1
} otherwise {
  show 0
}
show (len(getenv("")))
hold child = spawn("/bin/cat")
show (child > 0)
show (child_send(child + 0.5, "invalid"))
show (child_close(child + 0.5))
show (child_send(child, "hello\n"))
show (string_eq(child_line(child), "hello"))
show (child_send(child, "ok"))
show (string_eq(child_recv(child, 2), "ok"))
show (child_close(child))
show (child_send(child, "closed"))
show (len(child_recv(child, 1)))
show (len(child_line(child)))
show (child_close(child))
hold handles = []
for i in 0..8 {
  hold h = spawn("/bin/cat")
  push(handles, h)
}
show (len(handles))
show (spawn("/bin/cat") == 0)
for h in handles {
  show (child_close(h) == 0)
}
