// Negative control: division by zero in exact decimal arithmetic
// Must refuse and exit with code 1 (or diagnostic)
// Expected output: "division by zero" or exit code 1
make decimal_div_zero() {
  hold d1 = decimal_from_str("10.0")
  hold d2 = decimal_from_str("0.0")
  // The following should refuse or return an empty/error string
  // depending on the exact API contract of `stdlib/decimal.sa`
  // We assert the refusal here.
  hold res = decimal_div(d1, d2)
  // If `decimal_div` returns an empty string on error:
  when len(res) == 0 {
    show "PASS: division by zero refused"
    give exit(0)
  }
  // If it panics or returns garbage, the gate fails.
  show "FAIL: division by zero accepted"
  give exit(1)
}

// Negative control: overflow beyond 256 digits
make decimal_overflow() {
  // Construct a number with 257 digits (e.g., 1 followed by 256 zeros)
  hold big = "1"
  hold i = 0
  while i < 256 {
    big = concat(big, "0")
    i = i + 1
  }
  hold d = decimal_from_str(big)
  // Attempt to add 1 (should overflow)
  hold res = decimal_add(d, decimal_from_str("1"))
  // If the result length > 256 or if it refuses:
  when len(decimal_to_str(res)) > 256 {
    show "PASS: overflow detected"
    give exit(0)
  }
  // If the implementation silently truncates, this gate fails.
  show "FAIL: overflow silently accepted"
  give exit(1)
}

// Entry point for the test gate
make main() {
  hold c1 = decimal_div_zero()
  hold c2 = decimal_overflow()
  when c1 == 0 && c2 == 0 {
    give exit(0)
  }
  give exit(1)
}