// Executable negative controls for stdlib/decimal.sa. The public API returns
// "" on refusal; these checks require that exact behavior for division by zero,
// invalid input, and a 256-digit overflow. They do not use nonexistent aliases.
use "stdlib/decimal.sa"

make dnc_check(ok: num, label: str) -> num {
  when ok == 0 {
    show label
  }
  give 0
}

make dnc_repeat(ch: str, count: num) -> str {
  hold out = ""
  hold i = 0
  while i < count {
    out = concat(out, ch)
    i = i + 1
  }
  give out
}

make main_dnc() -> num {
  hold zero = dec_div("10.0", "0.0", 2)
  hold c0 = dnc_check(len(zero) == 0, "decimal division by zero accepted")
  hold bad = dec_add("1.2.3", "1")
  hold c1 = dnc_check(len(bad) == 0, "decimal invalid input accepted")
  hold max = dnc_repeat("9", 256)
  hold valid = dec_valid(max)
  hold c2 = dnc_check(valid == 1, "256-digit input refused")
  hold overflow = dec_add(max, "1")
  hold c3 = dnc_check(len(overflow) == 0, "257-digit result accepted")
  hold oversized = dnc_repeat("9", 257)
  hold c4 = dnc_check(dec_valid(oversized) == 0, "257-digit input accepted")
  hold rounded = dec_div("1", "3", 4)
  hold c5 = dnc_check(string_eq(rounded, "0.3333") == 1, "decimal division rounding")
  show "decimal-negative-controls-ok"
  give 0
}

hold run_dnc = main_dnc()
