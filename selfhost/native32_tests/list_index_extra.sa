// Additional expressions supported by native32; native_aot currently rejects
// negative list indices and seed-min rejects an index inside another index.
make pick(n: num) -> num {
  hold xs = [11, 22, 33]
  hold offsets = [2, 0, 1]
  give xs[offsets[n]] + xs[0 - 1]
}
show pick(0)
show pick(1)
show pick(2)
hold xs = [3, 5, 7]
hold offsets = [2, 0, 1]
show xs[0 - 3]
show xs[0 - 1]
show xs[offsets[0]]
