// native32: static string values carry a data pointer and a runtime length.
// This exercises reassignment, both branch paths, loop updates, and literals.
hold msg = "short"
show msg
show len(msg)
show len(msg) + 1
hold suffix = "!"
hold empty = ""
hold blank = concat(empty, empty)
show blank
show len(blank)
hold joined = concat(msg, suffix)
show joined
show len(joined)
joined = concat(joined, suffix)
show joined
msg = "a longer string"
show msg
show len(msg)
hold choice = 0
when choice == 0 {
  msg = "branch-A"
} otherwise {
  msg = "branch B is longer"
}
show msg
show len(msg)
hold i = 0
while i < 3 {
  msg = "loop"
  i = i + 1
}
show msg
show len(msg)
hold number = 42
show number
show "literal still works"
