show ct_valid(ct_parse_d("h1|h2|h3\r\nv1|\"v|2\"|v3\r\nx|\"q\"\"t\"|\r\n", 34))

// UTF-8 field content is preserved byte for byte
show csv_write_row_d(csv_push(csv_push(csv_push(csv_empty(), "café"), "বাংলা"), "ok"), 44)
show csv_count(csv_parse_row_d("café,বাংলা,ok", 44))
show csv_at(csv_parse_row_d("café,বাংলা,ok", 44), 1)
show csv_write_row_d(csv_push(csv_push(csv_push(csv_empty(), "café"), "বাংলা"), "ok"), 9)
show csv_count(csv_parse_row_d("café\tবাংলা\tok", 9))
show csv_at(csv_parse_row_d("café\tবাংলা\tok", 9), 1)
show csv_write_row_d(csv_push(csv_push(csv_push(csv_empty(), "café"), "বাংলা"), "ok"), 59)
show csv_count(csv_parse_row_d("café;বাংলা;ok", 59))
show csv_at(csv_parse_row_d("café;বাংলা;ok", 59), 1)
show csv_write_row_d(csv_push(csv_push(csv_push(csv_empty(), "café"), "বাংলা"), "ok"), 124)
show csv_count(csv_parse_row_d("café|বাংলা|ok", 124))
show csv_at(csv_parse_row_d("café|বাংলা|ok", 124), 1)
show "csv-dialect-ok"
