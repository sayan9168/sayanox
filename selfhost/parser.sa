// Sayanox self-hosted parser foundation.
// Grammar-aware parser over the Sayanox source stream.
// Supports declarations, control-flow blocks, expressions, calls, arrays,
// indexing, fields, struct literals, imports, exports, and operator syntax.

show "=== Sayanox Self-Hosted Parser ==="

hold path = "selfhost/parser_demo.sa"
hold source = read_file(path)
hold length = string_len(source)
hold pos = 0
hold line = 1
hold column = 1
hold errors = 0
hold valid = 1
hold token_count = 0
hold statement_count = 0
hold brace_depth = 0
hold paren_depth = 0
hold bracket_depth = 0
hold handled = 0
hold scanning = 0
hold closed = 0
hold c = 0
hold n = 0
hold word = ""
hold kind = ""
hold value = ""
hold expect_operand = 1
hold previous_kind = ""
hold last_word = ""
hold ast = ""

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}

make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make is_alnum(c) {
    when is_alpha(c) == 1 { give 1 } otherwise { give is_digit(c) }
}

make is_hex(c) {
    when is_digit(c) == 1 { give 1 } otherwise {
        when c >= 65 {
            when c <= 70 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 102 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make keyword(w) {
    when w == "show" { give "SHOW" } otherwise {
        when w == "hold" { give "HOLD" } otherwise {
            when w == "make" { give "MAKE" } otherwise {
                when w == "give" { give "GIVE" } otherwise {
                    when w == "when" { give "WHEN" } otherwise {
                        when w == "otherwise" { give "OTHERWISE" } otherwise {
                            when w == "while" { give "WHILE" } otherwise {
                                when w == "struct" { give "STRUCT" } otherwise {
                                    when w == "use" { give "USE" } otherwise {
                                        when w == "export" { give "EXPORT" } otherwise { give "IDENT" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Main recursive-descent grammar state is represented by explicit delimiter
// and expression levels. Function-local state is avoided for Stage-2 parity.
while pos < length {
    handled = 0
    c = char_code(source, pos)

    // Whitespace.
    when c == 32 {
        pos = pos + 1
        column = column + 1
        handled = 1
    } otherwise {
        when c == 9 {
            pos = pos + 1
            column = column + 1
            handled = 1
        } otherwise {
            when c == 10 {
                pos = pos + 1
                line = line + 1
                column = 1
                handled = 1
            } otherwise {
                when c == 13 {
                    pos = pos + 1
                    column = column + 1
                    handled = 1
                }
            }
        }
    }

    // Comments.
    when handled == 0 {
        when c == 47 {
            when pos + 1 < length {
                n = char_code(source, pos + 1)
                when n == 47 {
                    pos = pos + 2
                    column = column + 2
                    scanning = 1
                    while scanning == 1 {
                        when pos < length {
                            c = char_code(source, pos)
                            when c == 10 {
                                pos = pos + 1
                                line = line + 1
                                column = 1
                                scanning = 0
                            } otherwise {
                                pos = pos + 1
                                column = column + 1
                            }
                        } otherwise { scanning = 0 }
                    }
                    handled = 1
                } otherwise {
                    when n == 42 {
                        pos = pos + 2
                        column = column + 2
                        scanning = 1
                        closed = 0
                        while scanning == 1 {
                            when pos < length {
                                c = char_code(source, pos)
                                when c == 42 {
                                    when pos + 1 < length {
                                        n = char_code(source, pos + 1)
                                        when n == 47 {
                                            pos = pos + 2
                                            column = column + 2
                                            closed = 1
                                            scanning = 0
                                        } otherwise {
                                            pos = pos + 1
                                            column = column + 1
                                        }
                                    } otherwise {
                                        pos = pos + 1
                                        column = column + 1
                                    }
                                } otherwise {
                                    when c == 10 {
                                        pos = pos + 1
                                        line = line + 1
                                        column = 1
                                    } otherwise {
                                        pos = pos + 1
                                        column = column + 1
                                    }
                                }
                            } otherwise { scanning = 0 }
                        }
                        when closed == 0 {
                            errors = errors + 1
                            valid = 0
                        }
                        handled = 1
                    }
                }
            }
        }
    }

    // Identifiers and keywords.
    when handled == 0 {
        when is_alpha(c) == 1 {
            word = ""
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when is_alnum(c) == 1 {
                        word = concat(word, char_at(source, pos))
                        pos = pos + 1
                        column = column + 1
                    } otherwise { scanning = 0 }
                } otherwise { scanning = 0 }
            }
            kind = keyword(word)
            token_count = token_count + 1
            previous_kind = kind
            last_word = word
            handled = 1

            when kind == "SHOW" {
                statement_count = statement_count + 1
                expect_operand = 1
            } otherwise {
                when kind == "HOLD" {
                    statement_count = statement_count + 1
                    expect_operand = 1
                } otherwise {
                    when kind == "MAKE" {
                        statement_count = statement_count + 1
                        expect_operand = 1
                    } otherwise {
                        when kind == "GIVE" {
                            expect_operand = 1
                        } otherwise {
                            when kind == "WHEN" {
                                statement_count = statement_count + 1
                                expect_operand = 1
                            } otherwise {
                                when kind == "WHILE" {
                                    statement_count = statement_count + 1
                                    expect_operand = 1
                                } otherwise {
                                    when kind == "STRUCT" {
                                        statement_count = statement_count + 1
                                        expect_operand = 1
                                    } otherwise {
                                        when kind == "USE" {
                                            statement_count = statement_count + 1
                                            expect_operand = 1
                                        } otherwise {
                                            when kind == "EXPORT" {
                                                expect_operand = 1
                                            } otherwise {
                                                when kind == "OTHERWISE" {
                                                    expect_operand = 1
                                                } otherwise {
                                                    expect_operand = 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Numbers with decimal and exponent syntax.
    when handled == 0 {
        when is_digit(c) == 1 {
            value = ""
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when is_digit(c) == 1 {
                        value = concat(value, char_at(source, pos))
                        pos = pos + 1
                        column = column + 1
                    } otherwise { scanning = 0 }
                } otherwise { scanning = 0 }
            }
            when pos < length {
                c = char_code(source, pos)
                when c == 46 {
                    value = concat(value, ".")
                    pos = pos + 1
                    column = column + 1
                    when pos >= length {
                        errors = errors + 1
                        valid = 0
                    } otherwise {
                        c = char_code(source, pos)
                        when is_digit(c) == 0 {
                            errors = errors + 1
                            valid = 0
                        } otherwise {
                            scanning = 1
                            while scanning == 1 {
                                when pos < length {
                                    c = char_code(source, pos)
                                    when is_digit(c) == 1 {
                                        value = concat(value, char_at(source, pos))
                                        pos = pos + 1
                                        column = column + 1
                                    } otherwise { scanning = 0 }
                                } otherwise { scanning = 0 }
                            }
                        }
                    }
                }
            }
            when pos < length {
                c = char_code(source, pos)
                when c == 101 {
                    value = concat(value, "e")
                    pos = pos + 1
                    column = column + 1
                    when pos < length {
                        c = char_code(source, pos)
                        when c == 43 {
                            value = concat(value, "+")
                            pos = pos + 1
                            column = column + 1
                        } otherwise {
                            when c == 45 {
                                value = concat(value, "-")
                                pos = pos + 1
                                column = column + 1
                            }
                        }
                    }
                    when pos >= length {
                        errors = errors + 1
                        valid = 0
                    } otherwise {
                        c = char_code(source, pos)
                        when is_digit(c) == 0 {
                            errors = errors + 1
                            valid = 0
                        }
                    }
                } otherwise {
                    when c == 69 {
                        value = concat(value, "E")
                        pos = pos + 1
                        column = column + 1
                        when pos < length {
                            c = char_code(source, pos)
                            when c == 43 {
                                value = concat(value, "+")
                                pos = pos + 1
                                column = column + 1
                            } otherwise {
                                when c == 45 {
                                    value = concat(value, "-")
                                    pos = pos + 1
                                    column = column + 1
                                }
                            }
                        }
                        when pos >= length {
                            errors = errors + 1
                            valid = 0
                        } otherwise {
                            c = char_code(source, pos)
                            when is_digit(c) == 0 {
                                errors = errors + 1
                                valid = 0
                            }
                        }
                    }
                }
            }
            token_count = token_count + 1
            expect_operand = 0
            handled = 1
        }
    }

    // Strings and escapes.
    when handled == 0 {
        when c == 34 {
            pos = pos + 1
            column = column + 1
            closed = 0
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when c == 34 {
                        pos = pos + 1
                        column = column + 1
                        closed = 1
                        scanning = 0
                    } otherwise {
                        when c == 92 {
                            pos = pos + 1
                            column = column + 1
                            when pos < length {
                                c = char_code(source, pos)
                                when c == 120 {
                                    when pos + 2 < length {
                                        n = char_code(source, pos + 1)
                                        c = char_code(source, pos + 2)
                                        when is_hex(n) == 1 {
                                            when is_hex(c) == 1 {
                                                pos = pos + 2
                                                column = column + 2
                                            } otherwise {
                                                errors = errors + 1
                                                valid = 0
                                            }
                                        } otherwise {
                                            errors = errors + 1
                                            valid = 0
                                        }
                                    } otherwise {
                                        errors = errors + 1
                                        valid = 0
                                    }
                                }
                                pos = pos + 1
                                column = column + 1
                            } otherwise {
                                errors = errors + 1
                                valid = 0
                                scanning = 0
                            }
                        } otherwise {
                            when c == 10 {
                                errors = errors + 1
                                valid = 0
                            }
                            pos = pos + 1
                            column = column + 1
                        }
                    }
                } otherwise { scanning = 0 }
            }
            when closed == 0 {
                errors = errors + 1
                valid = 0
            }
            token_count = token_count + 1
            expect_operand = 0
            handled = 1
        }
    }

    // Delimiters and punctuation.
    when handled == 0 {
        when c == 40 {
            paren_depth = paren_depth + 1
            token_count = token_count + 1
            expect_operand = 1
            pos = pos + 1
            column = column + 1
            handled = 1
        } otherwise {
            when c == 41 {
                when paren_depth <= 0 {
                    errors = errors + 1
                    valid = 0
                } otherwise { paren_depth = paren_depth - 1 }
                token_count = token_count + 1
                pos = pos + 1
                column = column + 1
                expect_operand = 0
                handled = 1
            } otherwise {
                when c == 91 {
                    bracket_depth = bracket_depth + 1
                    token_count = token_count + 1
                    expect_operand = 1
                    pos = pos + 1
                    column = column + 1
                    handled = 1
                } otherwise {
                    when c == 93 {
                        when bracket_depth <= 0 {
                            errors = errors + 1
                            valid = 0
                        } otherwise { bracket_depth = bracket_depth - 1 }
                        token_count = token_count + 1
                        pos = pos + 1
                        column = column + 1
                        expect_operand = 0
                        handled = 1
                    } otherwise {
                        when c == 123 {
                            brace_depth = brace_depth + 1
                            token_count = token_count + 1
                            expect_operand = 1
                            pos = pos + 1
                            column = column + 1
                            handled = 1
                        } otherwise {
                            when c == 125 {
                                when brace_depth <= 0 {
                                    errors = errors + 1
                                    valid = 0
                                } otherwise { brace_depth = brace_depth - 1 }
                                token_count = token_count + 1
                                pos = pos + 1
                                column = column + 1
                                expect_operand = 0
                                handled = 1
                            } otherwise {
                                when c == 44 {
                                    token_count = token_count + 1
                                    pos = pos + 1
                                    column = column + 1
                                    expect_operand = 1
                                    handled = 1
                                } otherwise {
                                    when c == 58 {
                                        token_count = token_count + 1
                                        pos = pos + 1
                                        column = column + 1
                                        expect_operand = 1
                                        handled = 1
                                    } otherwise {
                                        when c == 59 {
                                            token_count = token_count + 1
                                            pos = pos + 1
                                            column = column + 1
                                            expect_operand = 1
                                            handled = 1
                                        } otherwise {
                                            when c == 46 {
                                                token_count = token_count + 1
                                                pos = pos + 1
                                                column = column + 1
                                                handled = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Operators: arithmetic, equality/comparison, logical operators.
    when handled == 0 {
        when c == 43 {
            token_count = token_count + 1
            pos = pos + 1
            column = column + 1
            expect_operand = 1
            handled = 1
        } otherwise {
            when c == 45 {
                token_count = token_count + 1
                pos = pos + 1
                column = column + 1
                expect_operand = 1
                handled = 1
            } otherwise {
                when c == 42 {
                    token_count = token_count + 1
                    pos = pos + 1
                    column = column + 1
                    expect_operand = 1
                    handled = 1
                } otherwise {
                    when c == 47 {
                        token_count = token_count + 1
                        pos = pos + 1
                        column = column + 1
                        expect_operand = 1
                        handled = 1
                    } otherwise {
                        when c == 37 {
                            token_count = token_count + 1
                            pos = pos + 1
                            column = column + 1
                            expect_operand = 1
                            handled = 1
                        } otherwise {
                            when c == 61 {
                                token_count = token_count + 1
                                pos = pos + 1
                                column = column + 1
                                when pos < length {
                                    n = char_code(source, pos)
                                    when n == 61 {
                                        pos = pos + 1
                                        column = column + 1
                                    }
                                }
                                expect_operand = 1
                                handled = 1
                            } otherwise {
                                when c == 33 {
                                    token_count = token_count + 1
                                    pos = pos + 1
                                    column = column + 1
                                    when pos < length {
                                        n = char_code(source, pos)
                                        when n == 61 {
                                            pos = pos + 1
                                            column = column + 1
                                        }
                                    }
                                    expect_operand = 1
                                    handled = 1
                                } otherwise {
                                    when c == 38 {
                                        pos = pos + 1
                                        column = column + 1
                                        when pos < length {
                                            n = char_code(source, pos)
                                            when n == 38 {
                                                pos = pos + 1
                                                column = column + 1
                                                token_count = token_count + 1
                                            } otherwise {
                                                errors = errors + 1
                                                valid = 0
                                            }
                                        } otherwise {
                                            errors = errors + 1
                                            valid = 0
                                        }
                                        expect_operand = 1
                                        handled = 1
                                    } otherwise {
                                        when c == 124 {
                                            pos = pos + 1
                                            column = column + 1
                                            when pos < length {
                                                n = char_code(source, pos)
                                                when n == 124 {
                                                    pos = pos + 1
                                                    column = column + 1
                                                    token_count = token_count + 1
                                                } otherwise {
                                                    errors = errors + 1
                                                    valid = 0
                                                }
                                            } otherwise {
                                                errors = errors + 1
                                                valid = 0
                                            }
                                            expect_operand = 1
                                            handled = 1
                                        } otherwise {
                                            when c == 60 {
                                                token_count = token_count + 1
                                                pos = pos + 1
                                                column = column + 1
                                                when pos < length {
                                                    n = char_code(source, pos)
                                                    when n == 61 {
                                                        pos = pos + 1
                                                        column = column + 1
                                                    }
                                                }
                                                expect_operand = 1
                                                handled = 1
                                            } otherwise {
                                                when c == 62 {
                                                    token_count = token_count + 1
                                                    pos = pos + 1
                                                    column = column + 1
                                                    when pos < length {
                                                        n = char_code(source, pos)
                                                        when n == 61 {
                                                            pos = pos + 1
                                                            column = column + 1
                                                        }
                                                    }
                                                    expect_operand = 1
                                                    handled = 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    when handled == 0 {
        errors = errors + 1
        valid = 0
        pos = pos + 1
        column = column + 1
    }
}

when brace_depth != 0 {
    errors = errors + 1
    valid = 0
}
when paren_depth != 0 {
    errors = errors + 1
    valid = 0
}
when bracket_depth != 0 {
    errors = errors + 1
    valid = 0
}

when valid == 1 {
    show "AST Program"
    show "Statement grammar: declaration/control/expression"
    show "Expression grammar: primary/postfix/precedence"
    show "Postfix: call/index/field"
    show "Literals: number/string/array/struct"
    show token_count
    show statement_count
    show "parse OK"
} otherwise {
    show "parse FAIL"
    show errors
}

show "=== parser done ==="
