// Minimal-seed C-output runtime profile. The compiler/frontend is Sayanox.
// Strings, list headers and list buffers share a hashed, tracing collector.
// The low-memory profile collects
// before exhausting the 4 MiB acceptance bound. This is output code, not a
// stored C compiler or an embedded legacy build recipe.
make seed_runtime_c() -> str {
  give "#define SX_SEED_PROFILE 1\n#include <stdint.h>\n#include <stddef.h>\ntypedef struct sx_sb { size_t len, cap, kind; struct sx_sb *next; char data[1]; } sx_sb;\n/* Exact allocation registry: never inspect bytes before a foreign pointer. */\nstatic sx_sb **sx_sb_buckets; static size_t sx_sb_nbucket, sx_sb_count;\nstatic size_t sx_sb_hash(const void *p){ uintptr_t v=(uintptr_t)p; return (size_t)((v>>3)^(v>>17)); }\nstatic sx_sb *sx_sb_hdr(const char *p){ return (sx_sb*)((char*)p - offsetof(sx_sb,data)); }\nstatic int sx_sb_is(const char *p){\n  if(!p || !sx_sb_nbucket) return 0;\n  for(sx_sb *h=sx_sb_buckets[sx_sb_hash(p)&(sx_sb_nbucket-1)]; h; h=h->next) if(h->data==p) return 1;\n  return 0; }\nstatic void sx_sb_register(sx_sb *h){\n  if(sx_sb_count>=sx_sb_nbucket){\n    size_t n=sx_sb_nbucket?sx_sb_nbucket*2:1024;\n    if(n<sx_sb_nbucket || n>SIZE_MAX/sizeof(sx_sb*)){fputs(\"sx: out of memory\\n\",stderr);exit(1);}\n    sx_sb **b=calloc(n,sizeof *b); if(!b){fputs(\"sx: out of memory\\n\",stderr);exit(1);}\n    for(size_t i=0;i<sx_sb_nbucket;i++){ sx_sb *p=sx_sb_buckets[i]; while(p){sx_sb *next=p->next; size_t j=sx_sb_hash(p->data)&(n-1); p->next=b[j]; b[j]=p; p=next;} }\n    free(sx_sb_buckets); sx_sb_buckets=b; sx_sb_nbucket=n;\n  }\n  size_t i=sx_sb_hash(h->data)&(sx_sb_nbucket-1); h->next=sx_sb_buckets[i]; sx_sb_buckets[i]=h; sx_sb_count++;\n}\n/* Conservative stack roots plus transitive heap edges. Strings are immutable\n * leaves; list headers and numeric backing buffers are registered allocations.\n * No assignment frees an aliased value. Registry membership guards foreign\n * pointers, and collection removes identity metadata with each dead object. */\n#include <setjmp.h>\n#ifndef __has_feature\n#define __has_feature(x) 0\n#endif\n#if defined(__SANITIZE_ADDRESS__) || __has_feature(address_sanitizer)\n#include <sanitizer/asan_interface.h>\n#define SX_SEED_WORD_OK(p) (!__asan_region_is_poisoned((void*)(p), sizeof(char*)))\n#else\n#define SX_SEED_WORD_OK(p) 1\n#endif\nstatic char *sx_gc_bot;                 /* stack anchor, planted by main */\nstatic size_t sx_gc_bytes;              /* bytes held by registered builders */\nstatic size_t sx_gc_thresh = 262144;   /* collect once live bytes pass this */\nstatic double sx_gc_n, sx_gc_freed;     /* collections run, bytes last freed */\nstatic sx_sb **sx_gc_arr; static unsigned char *sx_gc_bits; static size_t sx_gc_cap;\nstatic void sx_gc_init(void *bot){ sx_gc_bot=(char*)bot; }\nstatic size_t sx_gc_block(sx_sb *h){ return offsetof(sx_sb,data)+h->cap+1; }\nstatic int sx_gc_cmp(const void *a,const void *b){\n  sx_sb *x=*(sx_sb *const *)a, *y=*(sx_sb *const *)b;\n  return x<y ? -1 : (x>y ? 1 : 0); }\nstatic void sx_gc_grow(void){ sx_gc_thresh=sx_gc_bytes+sx_gc_bytes/2+262144; }\nstatic void sx_gc_roots(char *lo,char *hi,size_t k){\n  while((uintptr_t)lo % sizeof(char*)) lo++;\n  for(; lo+sizeof(char*)<=hi; lo+=sizeof(char*)){\n    if(!SX_SEED_WORD_OK(lo)) continue;\n    char *c=*(char**)lo; size_t a=0, b=k;\n    if(!c) continue;\n    while(a<b){ size_t m=a+(b-a)/2; if((char*)sx_gc_arr[m]<=c) a=m+1; else b=m; }\n    if(a && c<=sx_gc_arr[a-1]->data+sx_gc_arr[a-1]->cap && !sx_gc_bits[a-1]) sx_gc_bits[a-1]=1;\n  }\n}\n/* Best-effort metadata compaction, only after marking/sweeping is finished.\n   Payloads never move. A failed allocation leaves the old storage usable. */\nstatic void sx_gc_trim(void){\n  size_t live=sx_sb_count, n=sx_sb_nbucket;\n  if(n>1024 && live<n/4){\n    sx_sb **b;\n    do { n/=2; } while(n>1024 && live<n/4);\n    b=(sx_sb**)calloc(n,sizeof *b);\n    if(b){\n      for(size_t i=0;i<sx_sb_nbucket;i++){\n        sx_sb *h=sx_sb_buckets[i];\n        while(h){ sx_sb *next=h->next; size_t j=sx_sb_hash(h->data)&(n-1);\n          h->next=b[j]; b[j]=h; h=next; }\n      }\n      free(sx_sb_buckets); sx_sb_buckets=b; sx_sb_nbucket=n;\n    }\n  }\n  n=sx_gc_cap;\n  if(n>1024 && live<n/4){\n    sx_sb **a; unsigned char *b;\n    n=live>1024 ? live : 1024;\n    a=(sx_sb**)realloc(sx_gc_arr,n*sizeof *a);\n    if(a){\n      sx_gc_arr=a;\n      /* Set the common capacity before the second realloc: if it fails,\n         the bitmap is larger than this minimum capacity, never smaller. */\n      sx_gc_cap=n;\n      b=(unsigned char*)realloc(sx_gc_bits,n);\n      if(b) sx_gc_bits=b;\n    }\n  }\n}\nstatic void sx_gc_collect(void){\n  size_t n=sx_sb_count, k=0, i, live=0, freed=0;\n  if(!sx_gc_bot) return;                /* no anchor yet: nothing is rooted */\n  if(!n){ sx_gc_freed=0; sx_gc_n+=1; sx_gc_trim(); sx_gc_grow(); return; }\n  if(n>sx_gc_cap){\n    sx_sb **a; unsigned char *b;\n    a=(sx_sb**)realloc(sx_gc_arr,n*sizeof *a);\n    if(!a){ sx_gc_grow(); return; }     /* no room to collect: carry on */\n    sx_gc_arr=a;\n    b=(unsigned char*)realloc(sx_gc_bits,n);\n    if(!b){ sx_gc_grow(); return; }\n    sx_gc_bits=b; sx_gc_cap=n;\n  }\n  for(i=0;i<sx_sb_nbucket;i++){ sx_sb *h=sx_sb_buckets[i]; while(h){ if(k<n) sx_gc_arr[k++]=h; h=h->next; } }\n  qsort(sx_gc_arr,k,sizeof *sx_gc_arr,sx_gc_cmp);\n  memset(sx_gc_bits,0,k);\n  { jmp_buf jb; char *lo, *hi;\n    setjmp(jb);                         /* spill the registers onto the stack */\n    lo=(char*)&jb; hi=sx_gc_bot;\n    if(lo>hi){ char *t=lo; lo=hi; hi=t; }\n    sx_gc_roots(lo,hi,k);\n  }\n  /* Mark each reachable non-string payload once, including cycles. */\n  for(;;){\n    int changed=0;\n    for(i=0;i<k;i++) if(sx_gc_bits[i]==1 && sx_gc_arr[i]->kind){\n      sx_sb *h=sx_gc_arr[i]; sx_gc_bits[i]=2; changed=1;\n      sx_gc_roots(h->data,h->data+h->len,k);\n    }\n    if(!changed) break;\n  }\n  for(i=0;i<sx_sb_nbucket;i++) sx_sb_buckets[i]=0;\n  for(i=0;i<k;i++){\n    sx_sb *h=sx_gc_arr[i];\n    if(sx_gc_bits[i]){ size_t j=sx_sb_hash(h->data)&(sx_sb_nbucket-1); h->next=sx_sb_buckets[j]; sx_sb_buckets[j]=h; live++; }\n    else { freed+=sx_gc_block(h); free(h); }\n  }\n  sx_sb_count=live;\n  sx_gc_bytes = freed<sx_gc_bytes ? sx_gc_bytes-freed : 0;\n  sx_gc_freed=(double)freed; sx_gc_n+=1;\n  sx_gc_trim();\n  sx_gc_grow();\n}\nstatic double sx_gc_run(void){ sx_gc_collect(); return sx_gc_freed; }\nstatic double sx_gc_live(void){ return (double)sx_gc_bytes; }\nstatic double sx_gc_count(void){ return sx_gc_n; }\nstatic char *sx_sb_new(size_t cap){\n  if(cap<32) cap=32;\n  if(cap>SIZE_MAX - offsetof(sx_sb,data) - 1){fputs(\"sx: out of memory\\n\",stderr);exit(1);}\n  size_t need=offsetof(sx_sb,data)+cap+1;\n  if(sx_gc_bytes+need>sx_gc_thresh) sx_gc_collect();\n  sx_sb *h=(sx_sb*)malloc(need);\n  if(!h){ sx_gc_collect(); h=(sx_sb*)malloc(need); }   /* collect before giving up */\n  if(!h){fputs(\"sx: out of memory\\n\",stderr);exit(1);}\n  h->len=0; h->cap=cap; h->kind=0; h->data[0]=0; sx_sb_register(h); sx_gc_bytes+=need; return h->data; }\nstatic char *sx_sb_from(const char *s){ size_t n=strlen(s?s:\"\");\n  size_t cap=n<32?32:n; char *r=sx_sb_new(cap); if(n)memcpy(r,s,n); r[n]=0; sx_sb_hdr(r)->len=n; return r; }\nstatic void sx_sb_free(const char *p){\n  if(!p || !sx_sb_nbucket) return;\n  sx_sb **link=&sx_sb_buckets[sx_sb_hash(p)&(sx_sb_nbucket-1)];\n  while(*link){ sx_sb *h=*link; if(h->data==p){ size_t z=sx_gc_block(h); *link=h->next; sx_sb_count--;\n    sx_gc_bytes = z<sx_gc_bytes ? sx_gc_bytes-z : 0; free(h); return;} link=&h->next; }\n}\nstatic char *sx_sb_app(const char *a,const char *b){\n  const char *aa=a?a:\"\"; const char *bb=b?b:\"\";\n  int ia=sx_sb_is(aa);\n  size_t la=ia?sx_sb_hdr(aa)->len:strlen(aa);\n  size_t lb=strlen(bb);\n  size_t need=la+lb;\n  /* Legacy output helper: immutable fresh allocation, never early free. */\n  size_t cap=ia?sx_sb_hdr(aa)->cap:32; while(cap<need+1)cap*=2;\n  char *r=sx_sb_new(cap); sx_sb *h=sx_sb_hdr(r);\n  if(la)memcpy(r,aa,la); memcpy(r+la,bb,lb); r[need]=0; h->len=need;\n  return r;\n}\n/* The retained C frontend's polymorphic len bridge shares the exact hash\n * registry and header offset; it never walks an append-only list of identities. */\ntypedef sx_sb sx_gcb;\n#define SX_GCH offsetof(sx_sb,data)\nstatic sx_gcb *sx_gc_hash_get(char *p){ return sx_sb_is(p)?sx_sb_hdr(p):NULL; }\nstatic void *sx_gc_alloc(int kind,size_t n){\n  if(kind==0 && SX_SEED_PROFILE) return sx_sb_new(n);\n  char *p=sx_sb_new(n); sx_sb *h=sx_sb_hdr(p);\n  h->kind=(size_t)kind; h->len=n; memset(p,0,n); return p;\n}\n"
}
