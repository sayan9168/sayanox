// for_paren_test.sa -- a parenthesised `for` source is the source inside
// the parens (make test-for-paren). seed-min, gen2 and native must print
// the same bytes. A parenthesised RANGE is not a collection and stays a
// clear error on seed-min and gen2.
struct Label {
  text
}
make walk(s: str) -> num {
  hold n = 0
  for c in (s) {
    hold n = n + 1
  }
  give n
}
hold s = "ab"
for c in (s) {
  show c
}
hold xs = [7, 8]
for v in (xs) {
  show v
}
for c in ((s)) {
  show c
}
hold p = Label { text: "xy" }
for c in (p.text) {
  show c
}
for c in ("zz") {
  show c
}
show walk("abc")
show "paren-done"
