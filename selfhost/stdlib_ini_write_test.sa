// Second half of the INI oracle: the writer's own behaviour -- set, unset and
// drop checked step by step against the same model, a comment marker inside a
// value, and a table that came from the CSV filter layer instead of from ini_new.
// Split out of selfhost/stdlib_ini_test.sa because bounded native_aot counts every
// call site in one program: both halves fit, the single file did not.
//
// Every expected number below was computed by a Python model written from the rule
// text in stdlib/ini.sa's header comment; Sayanox was never consulted for an
// expectation. Values are pinned as (byte length, byte sum) and every document is
// assembled with chr() one line at a time, for the reasons the other half explains.
use "stdlib/csv.sa"
use "stdlib/csv_table.sa"
use "stdlib/hash.sa"
use "stdlib/ini.sa"

hold fail = 0

// ---- set, unset and drop, checked against the same model ----
hold s1 = ini_new()
show ini_count(s1)
show ini_section_count(s1)
show ini_empty(s1)
show len(ini_write(s1))
show sh_sum_bytes(ini_write(s1))
show len(ini_section_at(s1, 0))
show sh_sum_bytes(ini_section_at(s1, 0))
show ini_key_count(s1, "")
hold s2 = ini_set(s1, "a", "k", "1")
show ini_count(s2)
show ini_section_count(s2)
show ini_empty(s2)
show len(ini_write(s2))
show sh_sum_bytes(ini_write(s2))
show len(ini_section_at(s2, 0))
show sh_sum_bytes(ini_section_at(s2, 0))
show ini_key_count(s2, "")
show len(ini_section_at(s2, 1))
show sh_sum_bytes(ini_section_at(s2, 1))
show ini_key_count(s2, "a")
show len(ini_key_at(s2, "a", 0))
show sh_sum_bytes(ini_key_at(s2, "a", 0))
hold s3 = ini_set(s2, "a", "k", "2")
show ini_count(s3)
show ini_section_count(s3)
show ini_empty(s3)
show len(ini_write(s3))
show sh_sum_bytes(ini_write(s3))
show len(ini_section_at(s3, 0))
show sh_sum_bytes(ini_section_at(s3, 0))
show ini_key_count(s3, "")
show len(ini_section_at(s3, 1))
show sh_sum_bytes(ini_section_at(s3, 1))
show ini_key_count(s3, "a")
show len(ini_key_at(s3, "a", 0))
show sh_sum_bytes(ini_key_at(s3, "a", 0))
show ini_count(s2)
show ini_section_count(s2)
show ini_empty(s2)
show len(ini_write(s2))
show sh_sum_bytes(ini_write(s2))
show len(ini_section_at(s2, 0))
show sh_sum_bytes(ini_section_at(s2, 0))
show ini_key_count(s2, "")
show len(ini_section_at(s2, 1))
show sh_sum_bytes(ini_section_at(s2, 1))
show ini_key_count(s2, "a")
show len(ini_key_at(s2, "a", 0))
show sh_sum_bytes(ini_key_at(s2, "a", 0))
hold s4 = ini_set(s3, "b", "k", "3")
show ini_count(s4)
show ini_section_count(s4)
show ini_empty(s4)
show len(ini_write(s4))
show sh_sum_bytes(ini_write(s4))
show len(ini_section_at(s4, 0))
show sh_sum_bytes(ini_section_at(s4, 0))
show ini_key_count(s4, "")
show len(ini_section_at(s4, 1))
show sh_sum_bytes(ini_section_at(s4, 1))
show ini_key_count(s4, "a")
show len(ini_key_at(s4, "a", 0))
show sh_sum_bytes(ini_key_at(s4, "a", 0))
show len(ini_section_at(s4, 2))
show sh_sum_bytes(ini_section_at(s4, 2))
show ini_key_count(s4, "b")
show len(ini_key_at(s4, "b", 0))
show sh_sum_bytes(ini_key_at(s4, "b", 0))
hold s5 = ini_set(s4, "b", "j", "4")
show ini_count(s5)
show ini_section_count(s5)
show ini_empty(s5)
show len(ini_write(s5))
show sh_sum_bytes(ini_write(s5))
show len(ini_section_at(s5, 0))
show sh_sum_bytes(ini_section_at(s5, 0))
show ini_key_count(s5, "")
show len(ini_section_at(s5, 1))
show sh_sum_bytes(ini_section_at(s5, 1))
show ini_key_count(s5, "a")
show len(ini_key_at(s5, "a", 0))
show sh_sum_bytes(ini_key_at(s5, "a", 0))
show len(ini_section_at(s5, 2))
show sh_sum_bytes(ini_section_at(s5, 2))
show ini_key_count(s5, "b")
show len(ini_key_at(s5, "b", 0))
show sh_sum_bytes(ini_key_at(s5, "b", 0))
show len(ini_key_at(s5, "b", 1))
show sh_sum_bytes(ini_key_at(s5, "b", 1))
hold s6 = ini_set(s5, "b", "i", "5")
show ini_count(s6)
show ini_section_count(s6)
show ini_empty(s6)
show len(ini_write(s6))
show sh_sum_bytes(ini_write(s6))
show len(ini_section_at(s6, 0))
show sh_sum_bytes(ini_section_at(s6, 0))
show ini_key_count(s6, "")
show len(ini_section_at(s6, 1))
show sh_sum_bytes(ini_section_at(s6, 1))
show ini_key_count(s6, "a")
show len(ini_key_at(s6, "a", 0))
show sh_sum_bytes(ini_key_at(s6, "a", 0))
show len(ini_section_at(s6, 2))
show sh_sum_bytes(ini_section_at(s6, 2))
show ini_key_count(s6, "b")
show len(ini_key_at(s6, "b", 0))
show sh_sum_bytes(ini_key_at(s6, "b", 0))
show len(ini_key_at(s6, "b", 1))
show sh_sum_bytes(ini_key_at(s6, "b", 1))
show len(ini_key_at(s6, "b", 2))
show sh_sum_bytes(ini_key_at(s6, "b", 2))
show ini_has(s6, "b", "i")
show ini_find(s6, "b", "i")
show ini_find(s6, "b", "zzz")
hold s7 = ini_set(s6, ini_default_section(), "top", "t")
show ini_count(s7)
show ini_section_count(s7)
show ini_empty(s7)
show len(ini_write(s7))
show sh_sum_bytes(ini_write(s7))
show len(ini_section_at(s7, 0))
show sh_sum_bytes(ini_section_at(s7, 0))
show ini_key_count(s7, "")
show len(ini_key_at(s7, "", 0))
show sh_sum_bytes(ini_key_at(s7, "", 0))
show len(ini_section_at(s7, 1))
show sh_sum_bytes(ini_section_at(s7, 1))
show ini_key_count(s7, "a")
show len(ini_key_at(s7, "a", 0))
show sh_sum_bytes(ini_key_at(s7, "a", 0))
show len(ini_section_at(s7, 2))
show sh_sum_bytes(ini_section_at(s7, 2))
show ini_key_count(s7, "b")
show len(ini_key_at(s7, "b", 0))
show sh_sum_bytes(ini_key_at(s7, "b", 0))
show len(ini_key_at(s7, "b", 1))
show sh_sum_bytes(ini_key_at(s7, "b", 1))
show len(ini_key_at(s7, "b", 2))
show sh_sum_bytes(ini_key_at(s7, "b", 2))
show ct_row_count(s7)
show len(ct_cell(s7, 0, 0))
show sh_sum_bytes(ct_cell(s7, 0, 0))
show len(ct_cell(s7, 1, 0))
show sh_sum_bytes(ct_cell(s7, 1, 0))
show len(ct_cell(s7, 1, 1))
show sh_sum_bytes(ct_cell(s7, 1, 1))
show len(ct_cell(s7, 2, 0))
show sh_sum_bytes(ct_cell(s7, 2, 0))
show len(ini_set(s7, "", "", "v"))
show sh_sum_bytes(ini_set(s7, "", "", "v"))
show len(ini_set(s7, "", "k=", "v"))
show sh_sum_bytes(ini_set(s7, "", "k=", "v"))
show len(ini_set(s7, "", concat(concat("k", chr(10)), "k"), "v"))
show sh_sum_bytes(ini_set(s7, "", concat(concat("k", chr(10)), "k"), "v"))
show len(ini_set(s7, "a[b", "k", "v"))
show sh_sum_bytes(ini_set(s7, "a[b", "k", "v"))
show len(ini_set(s7, "a]", "k", "v"))
show sh_sum_bytes(ini_set(s7, "a]", "k", "v"))
show len(ini_set("nope", "a", "k", "v"))
show sh_sum_bytes(ini_set("nope", "a", "k", "v"))
show len(ini_value(ini_set(s7, "a", "kk", concat("v", chr(10))), "a", "kk"))
show sh_sum_bytes(ini_value(ini_set(s7, "a", "kk", concat("v", chr(10))), "a", "kk"))
// one rolling name for the five steps: unset, unset of a member the table does
// not hold, drop a section, drop it again, drop the default section. Each group
// of pins below a step reads the table that step produced, and ini_set/ini_unset
// never modify their input, so the earlier tables stay readable by their own name.
hold s8 = ini_unset(s7, "b", "j")
show ini_count(s8)
show ini_section_count(s8)
show ini_empty(s8)
show len(ini_write(s8))
show sh_sum_bytes(ini_write(s8))
show len(ini_section_at(s8, 0))
show sh_sum_bytes(ini_section_at(s8, 0))
show ini_key_count(s8, "")
show len(ini_key_at(s8, "", 0))
show sh_sum_bytes(ini_key_at(s8, "", 0))
show len(ini_section_at(s8, 1))
show sh_sum_bytes(ini_section_at(s8, 1))
show ini_key_count(s8, "a")
show len(ini_key_at(s8, "a", 0))
show sh_sum_bytes(ini_key_at(s8, "a", 0))
show len(ini_section_at(s8, 2))
show sh_sum_bytes(ini_section_at(s8, 2))
show ini_key_count(s8, "b")
show len(ini_key_at(s8, "b", 0))
show sh_sum_bytes(ini_key_at(s8, "b", 0))
show len(ini_key_at(s8, "b", 1))
show sh_sum_bytes(ini_key_at(s8, "b", 1))
s8 = ini_unset(s8, "b", "absent")
show ini_count(s8)
show ini_section_count(s8)
show ini_empty(s8)
show len(ini_write(s8))
show sh_sum_bytes(ini_write(s8))
show len(ini_section_at(s8, 0))
show sh_sum_bytes(ini_section_at(s8, 0))
show ini_key_count(s8, "")
show len(ini_key_at(s8, "", 0))
show sh_sum_bytes(ini_key_at(s8, "", 0))
show len(ini_section_at(s8, 1))
show sh_sum_bytes(ini_section_at(s8, 1))
show ini_key_count(s8, "a")
show len(ini_key_at(s8, "a", 0))
show sh_sum_bytes(ini_key_at(s8, "a", 0))
show len(ini_section_at(s8, 2))
show sh_sum_bytes(ini_section_at(s8, 2))
show ini_key_count(s8, "b")
show len(ini_key_at(s8, "b", 0))
show sh_sum_bytes(ini_key_at(s8, "b", 0))
show len(ini_key_at(s8, "b", 1))
show sh_sum_bytes(ini_key_at(s8, "b", 1))
s8 = ini_drop_section(s8, "b")
show ini_count(s8)
show ini_section_count(s8)
show ini_empty(s8)
show len(ini_write(s8))
show sh_sum_bytes(ini_write(s8))
show len(ini_section_at(s8, 0))
show sh_sum_bytes(ini_section_at(s8, 0))
show ini_key_count(s8, "")
show len(ini_key_at(s8, "", 0))
show sh_sum_bytes(ini_key_at(s8, "", 0))
show len(ini_section_at(s8, 1))
show sh_sum_bytes(ini_section_at(s8, 1))
show ini_key_count(s8, "a")
show len(ini_key_at(s8, "a", 0))
show sh_sum_bytes(ini_key_at(s8, "a", 0))
// the section is already gone, so this step is pinned as leaving the table alone
s8 = ini_drop_section(s8, "b")
show ini_count(s8)
show ini_section_count(s8)
show ini_empty(s8)
show len(ini_write(s8))
show sh_sum_bytes(ini_write(s8))
show len(ini_section_at(s8, 0))
show sh_sum_bytes(ini_section_at(s8, 0))
show ini_key_count(s8, "")
show len(ini_key_at(s8, "", 0))
show sh_sum_bytes(ini_key_at(s8, "", 0))
show len(ini_section_at(s8, 1))
show sh_sum_bytes(ini_section_at(s8, 1))
show ini_key_count(s8, "a")
show len(ini_key_at(s8, "a", 0))
show sh_sum_bytes(ini_key_at(s8, "a", 0))
s8 = ini_drop_section(s8, ini_default_section())
show ini_count(s8)
show ini_section_count(s8)
show ini_empty(s8)
show len(ini_write(s8))
show sh_sum_bytes(ini_write(s8))
show len(ini_section_at(s8, 0))
show sh_sum_bytes(ini_section_at(s8, 0))
show ini_key_count(s8, "")
show len(ini_section_at(s8, 1))
show sh_sum_bytes(ini_section_at(s8, 1))
show ini_key_count(s8, "a")
show len(ini_key_at(s8, "a", 0))
show sh_sum_bytes(ini_key_at(s8, "a", 0))
show len(ini_unset("nope", "a", "b"))
show sh_sum_bytes(ini_unset("nope", "a", "b"))
show len(ini_drop_section("nope", "a"))
show sh_sum_bytes(ini_drop_section("nope", "a"))
show ini_count(s7)
show ini_valid(s7)
show ini_valid(ini_write(s7))
show ini_round_trips(ini_write(s7))
hold s13 = ini_parse(ini_write(s7))
show ini_count(s13)
show ini_section_count(s13)
show ini_empty(s13)
show len(ini_write(s13))
show sh_sum_bytes(ini_write(s13))
show len(ini_section_at(s13, 0))
show sh_sum_bytes(ini_section_at(s13, 0))
show ini_key_count(s13, "")
show len(ini_section_at(s13, 1))
show sh_sum_bytes(ini_section_at(s13, 1))
show ini_key_count(s13, "a")
show len(ini_key_at(s13, "a", 0))
show sh_sum_bytes(ini_key_at(s13, "a", 0))

// ---- a comment marker inside a value ----
// chr(59) and chr(35) start a comment at the beginning of a line, and nowhere
// else, so a value that begins with one is data, and ini_needs_quote must not
// grow a clause for them: a written member line begins with the key, never with
// the value, so the marker cannot be read as the start of a comment.
hold doc = ""
hold doc = concat(doc, concat("[a]", chr(10)))
hold doc = concat(doc, concat(concat(concat("k = ", chr(59)), "x"), chr(10)))
hold doc = concat(doc, concat(concat(concat("j = ", chr(35)), "y"), chr(10)))
show ini_valid(doc)
hold sem = ini_parse(doc)
show ini_count(sem)
show len(ini_value(sem, "a", "k"))
show sh_sum_bytes(ini_value(sem, "a", "k"))
show len(ini_value(sem, "a", "j"))
show sh_sum_bytes(ini_value(sem, "a", "j"))
show ini_round_trips(doc)
show len(ini_write(sem))
show sh_sum_bytes(ini_write(sem))
show len(ini_write(ini_parse(ini_write(sem))))
show sh_sum_bytes(ini_write(ini_parse(ini_write(sem))))
show ini_has(sem, "a", "k")
show ini_key_count(sem, "a")

// a line that only looks like a member stays a comment, so the writer does not
// reproduce it -- and ini_round_trips is still 1, because what it compares is the
// table parse gives, before and after one write, not the text
hold doc2 = ""
hold doc2 = concat(doc2, concat("[a]", chr(10)))
hold doc2 = concat(doc2, concat(concat(chr(59), " k = v"), chr(10)))
hold doc2 = concat(doc2, concat(concat(chr(35), "also = 1"), chr(10)))
hold doc2 = concat(doc2, concat("k = 1", chr(10)))
show ini_valid(doc2)
hold com = ini_parse(doc2)
show ini_count(com)
show ini_key_count(com, "a")
show len(ini_value(com, "a", "k"))
show sh_sum_bytes(ini_value(com, "a", "k"))
show ini_round_trips(doc2)
show len(ini_write(com))
show sh_sum_bytes(ini_write(com))

// a quoted value whose bytes begin with a marker: the quotes are not part of the
// value, so ini_write puts the bare bytes back and the round trip still holds
hold doc3 = ""
hold doc3 = concat(doc3, concat("[a]", chr(10)))
hold doc3 = concat(doc3, concat(concat(concat(concat(concat("k = ", chr(34)), chr(59)), "x"), chr(34)), chr(10)))
show ini_valid(doc3)
hold quot = ini_parse(doc3)
show len(ini_value(quot, "a", "k"))
show sh_sum_bytes(ini_value(quot, "a", "k"))
show len(ini_write(quot))
show sh_sum_bytes(ini_write(quot))
show ini_round_trips(doc3)
show ini_valid(ini_write(quot))

// and a value that is a lone marker, or ends with one
hold doc4 = ""
hold doc4 = concat(doc4, concat("[a]", chr(10)))
hold doc4 = concat(doc4, concat(concat("k = x", chr(59)), chr(10)))
hold doc4 = concat(doc4, concat(concat("j = ", chr(59)), chr(10)))
hold doc4 = concat(doc4, concat(concat("h = ", chr(35)), chr(10)))
hold lone = ini_parse(doc4)
show ini_count(lone)
show len(ini_value(lone, "a", "k"))
show sh_sum_bytes(ini_value(lone, "a", "k"))
show len(ini_value(lone, "a", "j"))
show sh_sum_bytes(ini_value(lone, "a", "j"))
show len(ini_value(lone, "a", "h"))
show sh_sum_bytes(ini_value(lone, "a", "h"))
show len(ini_write(lone))
show sh_sum_bytes(ini_write(lone))
show ini_round_trips(doc4)

// ---- the rest of s13, the table ini_write printed and ini_parse read back ----
// The default member led the written file, so it leads the table again here: the
// round trip of ini_write keeps the default section at the head of the file,
// which is where ini_set put it in the table.
show len(ini_section_at(s13, 2))
show sh_sum_bytes(ini_section_at(s13, 2))
show ini_key_count(s13, "b")
show len(ini_key_at(s13, "b", 0))
show sh_sum_bytes(ini_key_at(s13, "b", 0))
show len(ini_key_at(s13, "b", 1))
show sh_sum_bytes(ini_key_at(s13, "b", 1))
show len(ini_key_at(s13, "b", 2))
show sh_sum_bytes(ini_key_at(s13, "b", 2))
show ini_find(s13, "", "top")
show ini_find(s13, "b", "i")
show len(ct_cell(s13, 1, 1))
show sh_sum_bytes(ct_cell(s13, 1, 1))
show len(ct_cell(s13, 1, 0))
show sh_sum_bytes(ct_cell(s13, 1, 0))
show ini_find_section(s13, "b")
show ct_row_count(s13)
show ini_count(s13)
show ini_empty(s13)

// ---- a table without the ini header row is enumerated as it stands ----
// ini_section_count puts the default section first for a table that starts with
// the header row ini_new gives it, because that row is what makes the default
// section exist at all. A table handed over by ct_filter_eq starts with a member
// row, and then no section is invented for it.
hold f = ct_filter_eq(sem, 0, "a", 0)
show ini_count(f)
show ini_section_count(f)
show len(ini_section_at(f, 0))
show sh_sum_bytes(ini_section_at(f, 0))
show ini_key_count(f, "a")
show len(ini_value(f, "a", "j"))
show sh_sum_bytes(ini_value(f, "a", "j"))
show ini_has(f, "a", "k")
show ini_find_section(f, "a")
show ini_find_section(f, ini_default_section())
show ini_empty(f)


show fail
show "ini-write-oracle-ok"
