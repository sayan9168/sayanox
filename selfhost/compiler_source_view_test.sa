// Appended to the real compiler's source-view helper prefix by the seed gate.
// Six-byte words must stay exact on native int64 and generated-C double paths.
// Use the legacy-supported checked index trap on failure: exit is intentionally
// outside the frozen seed subset. A mismatch still prints its reason and fails.
hold stop = 0
hold text = ""
hold i = 0
hold words = []
hold size = 0
while size < 20 {
  hold text = ""
  hold i = 0
  while i < size {
    text = concat(text, chr(255 - i))
    i = i + 1
  }
  hold words = sxsource_pack(text)
  when words[0] != len(text) { show "bad packed length"
    hold stop = sx_index("", 1) }
  i = 0
  while i < len(text) {
    when sxsource_get(words, i) != sx_index(text, i) { show "bad partial-word byte"
      hold stop = sx_index("", 1) }
    i = i + 1
  }
  when sxsource_get(words, size) != 0 { show "bad upper bound"
    hold stop = sx_index("", 1) }
  size = size + 1
}
hold text = ""
hold i = 1
while i < 256 {
  text = concat(text, chr(i))
  i = i + 1
}
hold words = sxsource_pack(text)
i = 0
while i < len(text) {
  when sxsource_get(words, i) != sx_index(text, i) { show "bad non-ASCII byte"
    hold stop = sx_index("", 1) }
  i = i + 1
}
text = ""
i = 0
while i < 6 {
  text = concat(text, chr(255))
  i = i + 1
}
words = sxsource_pack(text)
when words[1] != 281474976710655 { show "48-bit precision lost"
  hold stop = sx_index("", 1) }
i = 0
while i < 6 {
  when sxsource_get(words, i) != 255 { show "bad maximum-word byte"
    hold stop = sx_index("", 1) }
  i = i + 1
}
show "source-view-ok"
