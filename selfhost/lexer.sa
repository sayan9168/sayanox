// Sayanox-written lexer for the self-hosting compiler pipeline.
// The lexer emits a deterministic token stream in selfhost/tokens.sxt.
// It uses only the current Sayanox language subset so Stage-2 can bootstrap it.

show "=== Sayanox Self-Hosted Lexer ==="

hold path = "selfhost/hello.sa"
hold source = read_file(path)
hold length = len(source)
hold pos = 0
hold line = 1
hold column = 1
hold output = ""
hold errors = 0
hold token_count = 0

make is_digit(c) {
    give contains("0123456789", c)
}

make is_alpha(c) {
    give contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
}

make is_alnum(c) {
    when is_alpha(c) == 1 {
        give 1
    } otherwise {
        give is_digit(c)
    }
}

make is_space(c) {
    give contains(" \t\r\n", c)
}

make emit(kind, lexeme, at_line, at_column) {
    hold record = concat(kind, "|")
    hold record = concat(record, lexeme)
    hold record = concat(record, "|")
    hold record = concat(record, str(at_line))
    hold record = concat(record, "|")
    hold record = concat(record, str(at_column))
    hold record = concat(record, "\n")
    give record
}

while pos < length {
    hold ch = char_at(source, pos)

    when is_space(ch) == 1 {
        when ch == "\n" {
            hold line = line + 1
            hold column = 1
        } otherwise {
            hold column = column + 1
        }
        hold pos = pos + 1
    } otherwise {
        when ch == "/" {
            hold comment_done = 0
            when pos + 1 < length {
                hold next = char_at(source, pos + 1)
                when next == "/" {
                    hold comment_done = 1
                    hold pos = pos + 2
                    hold column = column + 2
                    hold scanning = 1
                    while scanning == 1 {
                        when pos < length {
                            hold ch = char_at(source, pos)
                            when ch == "\n" {
                                hold scanning = 0
                                hold line = line + 1
                                hold column = 1
                                hold pos = pos + 1
                            } otherwise {
                                hold pos = pos + 1
                                hold column = column + 1
                            }
                        } otherwise {
                            hold scanning = 0
                        }
                    }
                } otherwise {
                    when next == "*" {
                        hold comment_done = 1
                        hold start_line = line
                        hold start_column = column
                        hold pos = pos + 2
                        hold column = column + 2
                        hold closed = 0
                        hold scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                hold ch = char_at(source, pos)
                                when ch == "*" {
                                    when pos + 1 < length {
                                        hold next = char_at(source, pos + 1)
                                        when next == "/" {
                                            hold pos = pos + 2
                                            hold column = column + 2
                                            hold closed = 1
                                            hold scanning = 0
                                        } otherwise {
                                            hold pos = pos + 1
                                            hold column = column + 1
                                        }
                                    } otherwise {
                                        hold pos = pos + 1
                                        hold column = column + 1
                                    }
                                } otherwise {
                                    when ch == "\n" {
                                        hold line = line + 1
                                        hold column = 1
                                    } otherwise {
                                        hold column = column + 1
                                    }
                                    hold pos = pos + 1
                                }
                            } otherwise {
                                hold scanning = 0
                            }
                        }
                        when closed == 0 {
                            hold errors = errors + 1
                            hold output = concat(output, emit("ERROR", "unterminated_block_comment", start_line, start_column))
                        }
                    }
                }
            }
            when comment_done == 0 {
                hold output = concat(output, emit("SLASH", "/", line, column))
                hold token_count = token_count + 1
                hold pos = pos + 1
                hold column = column + 1
            }
        } otherwise {
            when is_alpha(ch) == 1 {
                hold start_line = line
                hold start_column = column
                hold word = ""
                hold scanning = 1
                while scanning == 1 {
                    when pos < length {
                        hold ch = char_at(source, pos)
                        when is_alnum(ch) == 1 {
                            hold word = concat(word, ch)
                            hold pos = pos + 1
                            hold column = column + 1
                        } otherwise {
                            hold scanning = 0
                        }
                    } otherwise {
                        hold scanning = 0
                    }
                }
                hold kind = "IDENT"
                when word == "show" { hold kind = "SHOW" } otherwise {
                    when word == "hold" { hold kind = "HOLD" } otherwise {
                        when word == "make" { hold kind = "MAKE" } otherwise {
                            when word == "give" { hold kind = "GIVE" } otherwise {
                                when word == "when" { hold kind = "WHEN" } otherwise {
                                    when word == "otherwise" { hold kind = "OTHERWISE" } otherwise {
                                        when word == "while" { hold kind = "WHILE" } otherwise {
                                            when word == "struct" { hold kind = "STRUCT" } otherwise {
                                                when word == "use" { hold kind = "USE" } otherwise {
                                                    when word == "export" { hold kind = "EXPORT" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                hold output = concat(output, emit(kind, word, start_line, start_column))
                hold token_count = token_count + 1
            } otherwise {
                when is_digit(ch) == 1 {
                    hold start_line = line
                    hold start_column = column
                    hold number = ""
                    hold scanning = 1
                    hold decimal = 0
                    while scanning == 1 {
                        when pos < length {
                            hold ch = char_at(source, pos)
                            when is_digit(ch) == 1 {
                                hold number = concat(number, ch)
                                hold pos = pos + 1
                                hold column = column + 1
                            } otherwise {
                                when ch == "." {
                                    when decimal == 0 {
                                        hold decimal = 1
                                        hold number = concat(number, ch)
                                        hold pos = pos + 1
                                        hold column = column + 1
                                    } otherwise {
                                        hold scanning = 0
                                    }
                                } otherwise {
                                    hold scanning = 0
                                }
                            }
                        } otherwise {
                            hold scanning = 0
                        }
                    }
                    hold output = concat(output, emit("NUMBER", number, start_line, start_column))
                    hold token_count = token_count + 1
                } otherwise {
                    when ch == "\"" {
                        hold start_line = line
                        hold start_column = column
                        hold value = ""
                        hold closed = 0
                        hold pos = pos + 1
                        hold column = column + 1
                        hold scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                hold ch = char_at(source, pos)
                                when ch == "\"" {
                                    hold closed = 1
                                    hold pos = pos + 1
                                    hold column = column + 1
                                    hold scanning = 0
                                } otherwise {
                                    when ch == "\\" {
                                        when pos + 1 < length {
                                            hold next = char_at(source, pos + 1)
                                            hold value = concat(value, ch)
                                            hold value = concat(value, next)
                                            hold pos = pos + 2
                                            hold column = column + 2
                                        } otherwise {
                                            hold pos = pos + 1
                                            hold column = column + 1
                                        }
                                    } otherwise {
                                        hold value = concat(value, ch)
                                        when ch == "\n" {
                                            hold line = line + 1
                                            hold column = 1
                                        } otherwise {
                                            hold column = column + 1
                                        }
                                        hold pos = pos + 1
                                    }
                                }
                            } otherwise {
                                hold scanning = 0
                            }
                        }
                        when closed == 1 {
                            hold output = concat(output, emit("STRING", value, start_line, start_column))
                            hold token_count = token_count + 1
                        } otherwise {
                            hold errors = errors + 1
                            hold output = concat(output, emit("ERROR", "unterminated_string", start_line, start_column))
                        }
                    } otherwise {
                        hold start_line = line
                        hold start_column = column
                        hold kind = "ERROR"
                        hold width = 1
                        when ch == "(" { hold kind = "LPAREN" } otherwise {
                            when ch == ")" { hold kind = "RPAREN" } otherwise {
                                when ch == "{" { hold kind = "LBRACE" } otherwise {
                                    when ch == "}" { hold kind = "RBRACE" } otherwise {
                                        when ch == "[" { hold kind = "LBRACKET" } otherwise {
                                            when ch == "]" { hold kind = "RBRACKET" } otherwise {
                                                when ch == "," { hold kind = "COMMA" } otherwise {
                                                    when ch == ":" { hold kind = "COLON" } otherwise {
                                                        when ch == ";" { hold kind = "SEMICOLON" } otherwise {
                                                            when ch == "+" { hold kind = "PLUS" } otherwise {
                                                                when ch == "-" { hold kind = "MINUS" } otherwise {
                                                                    when ch == "*" { hold kind = "STAR" } otherwise {
                                                                        when ch == "%" { hold kind = "PERCENT" } otherwise {
                                                                            when ch == "." { hold kind = "DOT" } otherwise {
                                                                                when ch == "=" {
                                                                                    hold kind = "ASSIGN"
                                                                                    when pos + 1 < length {
                                                                                        hold next = char_at(source, pos + 1)
                                                                                        when next == "=" {
                                                                                            hold kind = "EQEQ"
                                                                                            hold width = 2
                                                                                        }
                                                                                    }
                                                                                } otherwise {
                                                                                    when ch == "!" {
                                                                                        hold kind = "BANG"
                                                                                        when pos + 1 < length {
                                                                                            hold next = char_at(source, pos + 1)
                                                                                            when next == "=" {
                                                                                                hold kind = "BANGEQ"
                                                                                                hold width = 2
                                                                                            }
                                                                                        }
                                                                                    } otherwise {
                                                                                        when ch == ">" {
                                                                                            hold kind = "GT"
                                                                                            when pos + 1 < length {
                                                                                                hold next = char_at(source, pos + 1)
                                                                                                when next == "=" {
                                                                                                    hold kind = "GTE"
                                                                                                    hold width = 2
                                                                                                }
                                                                                            }
                                                                                        } otherwise {
                                                                                            when ch == "<" {
                                                                                                hold kind = "LT"
                                                                                                when pos + 1 < length {
                                                                                                    hold next = char_at(source, pos + 1)
                                                                                                    when next == "=" {
                                                                                                        hold kind = "LTE"
                                                                                                        hold width = 2
                                                                                                    }
                                                                                                }
                                                                                            } otherwise {
                                                                                                when ch == "&" {
                                                                                                    when pos + 1 < length {
                                                                                                        hold next = char_at(source, pos + 1)
                                                                                                        when next == "&" {
                                                                                                            hold kind = "ANDAND"
                                                                                                            hold width = 2
                                                                                                        }
                                                                                                    }
                                                                                                } otherwise {
                                                                                                    when ch == "|" {
                                                                                                        when pos + 1 < length {
                                                                                                            hold next = char_at(source, pos + 1)
                                                                                                            when next == "|" {
                                                                                                                hold kind = "OROR"
                                                                                                                hold width = 2
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        when kind == "ERROR" {
                            hold errors = errors + 1
                            hold output = concat(output, emit("ERROR", ch, start_line, start_column))
                        } otherwise {
                            hold output = concat(output, emit(kind, ch, start_line, start_column))
                        }
                        hold token_count = token_count + 1
                        hold pos = pos + width
                        hold column = column + width
                    }
                }
            }
        }
    }
}

hold output = concat(output, emit("EOF", "", line, column))
write_file("selfhost/tokens.sxt", output)
show "Tokens written"
show token_count
show "Lexer errors"
show errors
show "=== Sayanox Self-Hosted Lexer Complete ==="
