// Sayanox self-hosted lexer.
// Input: a Sayanox source file.
// Output: a deterministic token stream in selfhost/tokens.sxt.
// The implementation uses only the current bootstrap language subset.

show "=== Sayanox Self-Hosted Lexer ==="

hold path = "selfhost/hello.sa"
hold source = read_file(path)
hold length = len(source)
hold pos = 0
hold line = 1
hold column = 1
hold output = ""
hold errors = 0
hold token_count = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}

make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make is_alnum(c) {
    when is_alpha(c) == 1 { give 1 } otherwise { give is_digit(c) }
}

make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

make emit(kind, lexeme, at_line, at_column) {
    hold record = concat(kind, "|")
    hold record = concat(record, lexeme)
    hold record = concat(record, "|")
    hold record = concat(record, str(at_line))
    hold record = concat(record, "|")
    hold record = concat(record, str(at_column))
    hold record = concat(record, "\n")
    give record
}

while pos < length {
    hold ch = char_code(source, pos)
    hold text = char_at(source, pos)

    when is_space(ch) == 1 {
        when ch == 10 {
            hold line = line + 1
            hold column = 1
        } otherwise {
            hold column = column + 1
        }
        hold pos = pos + 1
    } otherwise {
        when ch == 47 {
            hold handled = 0
            when pos + 1 < length {
                hold next = char_code(source, pos + 1)
                when next == 47 {
                    hold handled = 1
                    hold pos = pos + 2
                    hold column = column + 2
                    hold scanning = 1
                    while scanning == 1 {
                        when pos < length {
                            hold c = char_code(source, pos)
                            when c == 10 {
                                hold line = line + 1
                                hold column = 1
                                hold pos = pos + 1
                                hold scanning = 0
                            } otherwise {
                                hold pos = pos + 1
                                hold column = column + 1
                            }
                        } otherwise { hold scanning = 0 }
                    }
                } otherwise {
                    when next == 42 {
                        hold handled = 1
                        hold start_line = line
                        hold start_column = column
                        hold pos = pos + 2
                        hold column = column + 2
                        hold closed = 0
                        hold scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                hold c = char_code(source, pos)
                                when c == 42 {
                                    when pos + 1 < length {
                                        hold n2 = char_code(source, pos + 1)
                                        when n2 == 47 {
                                            hold pos = pos + 2
                                            hold column = column + 2
                                            hold closed = 1
                                            hold scanning = 0
                                        } otherwise {
                                            hold pos = pos + 1
                                            hold column = column + 1
                                        }
                                    } otherwise {
                                        hold pos = pos + 1
                                        hold column = column + 1
                                    }
                                } otherwise {
                                    when c == 10 {
                                        hold line = line + 1
                                        hold column = 1
                                    } otherwise {
                                        hold column = column + 1
                                    }
                                    hold pos = pos + 1
                                }
                            } otherwise { hold scanning = 0 }
                        }
                        when closed == 0 {
                            hold errors = errors + 1
                            hold output = concat(output, emit("ERROR", "unterminated_block_comment", start_line, start_column))
                        }
                    }
                }
            }
            when handled == 0 {
                hold output = concat(output, emit("SLASH", "/", line, column))
                hold token_count = token_count + 1
                hold pos = pos + 1
                hold column = column + 1
            }
        } otherwise {
            when is_alpha(ch) == 1 {
                hold start_line = line
                hold start_column = column
                hold word = ""
                hold scanning = 1
                while scanning == 1 {
                    when pos < length {
                        hold c = char_code(source, pos)
                        when is_alnum(c) == 1 {
                            hold word = concat(word, char_at(source, pos))
                            hold pos = pos + 1
                            hold column = column + 1
                        } otherwise { hold scanning = 0 }
                    } otherwise { hold scanning = 0 }
                }
                hold kind = "IDENT"
                when word == "show" { hold kind = "SHOW" } otherwise {
                    when word == "hold" { hold kind = "HOLD" } otherwise {
                        when word == "make" { hold kind = "MAKE" } otherwise {
                            when word == "give" { hold kind = "GIVE" } otherwise {
                                when word == "when" { hold kind = "WHEN" } otherwise {
                                    when word == "otherwise" { hold kind = "OTHERWISE" } otherwise {
                                        when word == "while" { hold kind = "WHILE" } otherwise {
                                            when word == "struct" { hold kind = "STRUCT" } otherwise {
                                                when word == "use" { hold kind = "USE" } otherwise {
                                                    when word == "export" { hold kind = "EXPORT" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                hold output = concat(output, emit(kind, word, start_line, start_column))
                hold token_count = token_count + 1
            } otherwise {
                when is_digit(ch) == 1 {
                    hold start_line = line
                    hold start_column = column
                    hold number = ""
                    hold decimal = 0
                    hold scanning = 1
                    while scanning == 1 {
                        when pos < length {
                            hold c = char_code(source, pos)
                            when is_digit(c) == 1 {
                                hold number = concat(number, char_at(source, pos))
                                hold pos = pos + 1
                                hold column = column + 1
                            } otherwise {
                                when c == 46 {
                                    when decimal == 0 {
                                        hold decimal = 1
                                        hold number = concat(number, ".")
                                        hold pos = pos + 1
                                        hold column = column + 1
                                    } otherwise { hold scanning = 0 }
                                } otherwise { hold scanning = 0 }
                            }
                        } otherwise { hold scanning = 0 }
                    }
                    hold output = concat(output, emit("NUMBER", number, start_line, start_column))
                    hold token_count = token_count + 1
                } otherwise {
                    when ch == 34 {
                        hold start_line = line
                        hold start_column = column
                        hold value = ""
                        hold closed = 0
                        hold pos = pos + 1
                        hold column = column + 1
                        hold scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                hold c = char_code(source, pos)
                                when c == 34 {
                                    hold closed = 1
                                    hold pos = pos + 1
                                    hold column = column + 1
                                    hold scanning = 0
                                } otherwise {
                                    when c == 92 {
                                        when pos + 1 < length {
                                            hold value = concat(value, char_at(source, pos))
                                            hold value = concat(value, char_at(source, pos + 1))
                                            hold pos = pos + 2
                                            hold column = column + 2
                                        } otherwise {
                                            hold pos = pos + 1
                                            hold column = column + 1
                                        }
                                    } otherwise {
                                        hold value = concat(value, char_at(source, pos))
                                        when c == 10 {
                                            hold line = line + 1
                                            hold column = 1
                                        } otherwise { hold column = column + 1 }
                                        hold pos = pos + 1
                                    }
                                }
                            } otherwise { hold scanning = 0 }
                        }
                        when closed == 1 {
                            hold output = concat(output, emit("STRING", value, start_line, start_column))
                            hold token_count = token_count + 1
                        } otherwise {
                            hold errors = errors + 1
                            hold output = concat(output, emit("ERROR", "unterminated_string", start_line, start_column))
                        }
                    } otherwise {
                        hold start_line = line
                        hold start_column = column
                        hold kind = "ERROR"
                        hold width = 1
                        hold lexeme = text
                        when ch == 40 { hold kind = "LPAREN" } otherwise {
                            when ch == 41 { hold kind = "RPAREN" } otherwise {
                                when ch == 123 { hold kind = "LBRACE" } otherwise {
                                    when ch == 125 { hold kind = "RBRACE" } otherwise {
                                        when ch == 91 { hold kind = "LBRACKET" } otherwise {
                                            when ch == 93 { hold kind = "RBRACKET" } otherwise {
                                                when ch == 44 { hold kind = "COMMA" } otherwise {
                                                    when ch == 58 { hold kind = "COLON" } otherwise {
                                                        when ch == 59 { hold kind = "SEMICOLON" } otherwise {
                                                            when ch == 43 { hold kind = "PLUS" } otherwise {
                                                                when ch == 45 { hold kind = "MINUS" } otherwise {
                                                                    when ch == 42 { hold kind = "STAR" } otherwise {
                                                                        when ch == 37 { hold kind = "PERCENT" } otherwise {
                                                                            when ch == 46 { hold kind = "DOT" } otherwise {
                                                                                when ch == 61 {
                                                                                    hold kind = "ASSIGN"
                                                                                    when pos + 1 < length {
                                                                                        hold next = char_code(source, pos + 1)
                                                                                        when next == 61 {
                                                                                            hold kind = "EQEQ"
                                                                                            hold width = 2
                                                                                            hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                        }
                                                                                    }
                                                                                } otherwise {
                                                                                    when ch == 33 {
                                                                                        hold kind = "BANG"
                                                                                        when pos + 1 < length {
                                                                                            hold next = char_code(source, pos + 1)
                                                                                            when next == 61 {
                                                                                                hold kind = "BANGEQ"
                                                                                                hold width = 2
                                                                                                hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                            }
                                                                                        }
                                                                                    } otherwise {
                                                                                        when ch == 62 {
                                                                                            hold kind = "GT"
                                                                                            when pos + 1 < length {
                                                                                                hold next = char_code(source, pos + 1)
                                                                                                when next == 61 {
                                                                                                    hold kind = "GTE"
                                                                                                    hold width = 2
                                                                                                    hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                                }
                                                                                            }
                                                                                        } otherwise {
                                                                                            when ch == 60 {
                                                                                                hold kind = "LT"
                                                                                                when pos + 1 < length {
                                                                                                    hold next = char_code(source, pos + 1)
                                                                                                    when next == 61 {
                                                                                                        hold kind = "LTE"
                                                                                                        hold width = 2
                                                                                                        hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                                    }
                                                                                                }
                                                                                            } otherwise {
                                                                                                when ch == 38 {
                                                                                                    when pos + 1 < length {
                                                                                                        hold next = char_code(source, pos + 1)
                                                                                                        when next == 38 {
                                                                                                            hold kind = "ANDAND"
                                                                                                            hold width = 2
                                                                                                            hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                                        }
                                                                                                    }
                                                                                                } otherwise {
                                                                                                    when ch == 124 {
                                                                                                        when pos + 1 < length {
                                                                                                            hold next = char_code(source, pos + 1)
                                                                                                            when next == 124 {
                                                                                                                hold kind = "OROR"
                                                                                                                hold width = 2
                                                                                                                hold lexeme = concat(lexeme, char_at(source, pos + 1))
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        when kind == "ERROR" { hold errors = errors + 1 }
                        hold output = concat(output, emit(kind, lexeme, start_line, start_column))
                        hold token_count = token_count + 1
                        hold pos = pos + width
                        hold column = column + width
                    }
                }
            }
        }
    }
}

hold output = concat(output, emit("EOF", "", line, column))
write_file("selfhost/tokens.sxt", output)
show "Tokens written"
show token_count
show "Lexer errors"
show errors
show "=== Sayanox Self-Hosted Lexer Complete ==="
