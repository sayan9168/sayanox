// Sayanox-written lexer (Step 1 of moving the compiler into .sa)
// Declares all holds at top level (Stage-2 scope rules).
//
// Build & run:
//   ./selfhost/restore_stage2.sh
//   ./selfhost/stage2 selfhost/lexer.sa selfhost/lexer_out.c
//   clang selfhost/lexer_out.c -o selfhost/lexer_bin && ./selfhost/lexer_bin
//
// Expected on selfhost/hello.sa ("show 42"):
//   IDENT, NUMBER 42, tokens 2

show "=== Sayanox lexer.sa ==="

hold path = "selfhost/hello.sa"
hold source = read_file(path)
hold n = len(source)
hold pos = 0
hold token_count = 0
hold ch = 0
hold ch2 = 0
hold val = 0
hold scanning = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}

make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

while pos < n {
    hold ch = source[pos]

    when is_space(ch) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(ch) == 1 {
            hold val = 0
            hold scanning = 1
            while scanning == 1 {
                when pos < n {
                    hold ch2 = source[pos]
                    when is_digit(ch2) == 1 {
                        hold val = val * 10 + (ch2 - 48)
                        hold pos = pos + 1
                    } otherwise {
                        hold scanning = 0
                    }
                } otherwise {
                    hold scanning = 0
                }
            }
            show "NUMBER"
            show val
            hold token_count = token_count + 1
        } otherwise {
            when is_alpha(ch) == 1 {
                hold scanning = 1
                while scanning == 1 {
                    when pos < n {
                        hold ch2 = source[pos]
                        when is_alpha(ch2) == 1 {
                            hold pos = pos + 1
                        } otherwise {
                            when is_digit(ch2) == 1 {
                                hold pos = pos + 1
                            } otherwise {
                                hold scanning = 0
                            }
                        }
                    } otherwise {
                        hold scanning = 0
                    }
                }
                show "IDENT"
                hold token_count = token_count + 1
            } otherwise {
                show "OTHER"
                show ch
                hold pos = pos + 1
                hold token_count = token_count + 1
            }
        }
    }
}

show "tokens"
show token_count
show "=== lexer done ==="
