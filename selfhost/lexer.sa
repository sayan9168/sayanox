// Complete Sayanox lexer implemented in Sayanox.
// It covers whitespace, comments, identifiers, keywords, numbers, strings,
// operators, punctuation, source locations, and lexical errors.

show "=== Sayanox Self-Hosted Lexer ==="

hold path = "selfhost/hello.sa"
hold source = read_file(path)
hold length = string_len(source)
hold pos = 0
hold line = 1
hold column = 1
hold output = ""
hold errors = 0
hold token_count = 0
hold ch = 0
hold next = 0
hold handled = 0
hold scanning = 0
hold c = 0
hold start_line = 1
hold start_column = 1
hold closed = 0
hold n2 = 0
hold word = ""
hold kind = ""
hold number = ""
hold value = ""
hold after_dot = 0
hold exponent = 0
hold sign = 0
hold first_exp = 0
hold d = 0
hold e = 0
hold h1 = 0
hold h2 = 0
hold code = 0
hold escape_line = 1
hold escape_column = 1

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}

make is_alpha(c) {
    when c == 95 { give 1 } otherwise {
        when c >= 65 {
            when c <= 90 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 122 { give 1 } otherwise {
                        when c >= 128 { give 1 } otherwise { give 0 }
                    }
                } otherwise {
                    when c >= 128 { give 1 } otherwise { give 0 }
                }
            }
        } otherwise {
            when c >= 128 { give 1 } otherwise { give 0 }
        }
    }
}

make is_alnum(c) {
    when is_alpha(c) == 1 { give 1 } otherwise { give is_digit(c) }
}

make is_hex(c) {
    when is_digit(c) == 1 { give 1 } otherwise {
        when c >= 65 {
            when c <= 70 { give 1 } otherwise {
                when c >= 97 {
                    when c <= 102 { give 1 } otherwise { give 0 }
                } otherwise { give 0 }
            }
        } otherwise { give 0 }
    }
}

make hex_value(c) {
    when is_digit(c) == 1 { give c - 48 } otherwise {
        when c >= 65 {
            when c <= 70 { give c - 55 } otherwise { give c - 87 }
        } otherwise { give c - 87 }
    }
}

make emit(kind, lexeme, at_line, at_column) {
    hold record = concat(kind, "|")
    hold record = concat(record, lexeme)
    hold record = concat(record, "|")
    hold record = concat(record, str(at_line))
    hold record = concat(record, "|")
    hold record = concat(record, str(at_column))
    hold record = concat(record, "\n")
    give record
}

make error_record(message, at_line, at_column) {
    give emit("ERROR", message, at_line, at_column)
}

while pos < length {
    ch = char_code(source, pos)
    handled = 0

    when ch == 32 {
        pos = pos + 1
        column = column + 1
        handled = 1
    } otherwise {
        when ch == 9 {
            pos = pos + 1
            column = column + 1
            handled = 1
        } otherwise {
            when ch == 10 {
                pos = pos + 1
                line = line + 1
                column = 1
                handled = 1
            } otherwise {
                when ch == 13 {
                    pos = pos + 1
                    column = column + 1
                    handled = 1
                }
            }
        }
    }

    when handled == 0 {
        when ch == 47 {
            when pos + 1 < length {
                next = char_code(source, pos + 1)
                when next == 47 {
                    handled = 1
                    pos = pos + 2
                    column = column + 2
                    scanning = 1
                    while scanning == 1 {
                        when pos < length {
                            c = char_code(source, pos)
                            when c == 10 {
                                pos = pos + 1
                                line = line + 1
                                column = 1
                                scanning = 0
                            } otherwise {
                                pos = pos + 1
                                column = column + 1
                            }
                        } otherwise { scanning = 0 }
                    }
                } otherwise {
                    when next == 42 {
                        handled = 1
                        start_line = line
                        start_column = column
                        pos = pos + 2
                        column = column + 2
                        closed = 0
                        scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                c = char_code(source, pos)
                                when c == 42 {
                                    when pos + 1 < length {
                                        n2 = char_code(source, pos + 1)
                                        when n2 == 47 {
                                            pos = pos + 2
                                            column = column + 2
                                            closed = 1
                                            scanning = 0
                                        } otherwise {
                                            pos = pos + 1
                                            column = column + 1
                                        }
                                    } otherwise {
                                        pos = pos + 1
                                        column = column + 1
                                    }
                                } otherwise {
                                    when c == 10 {
                                        pos = pos + 1
                                        line = line + 1
                                        column = 1
                                    } otherwise {
                                        pos = pos + 1
                                        column = column + 1
                                    }
                                }
                            } otherwise { scanning = 0 }
                        }
                        when closed == 0 {
                            errors = errors + 1
                            output = concat(output, error_record("unterminated_block_comment", start_line, start_column))
                        }
                    }
                }
            }
            when handled == 0 {
                output = concat(output, emit("SLASH", "/", line, column))
                token_count = token_count + 1
                pos = pos + 1
                column = column + 1
                handled = 1
            }
        }
    }

    when handled == 0 {
        when is_alpha(ch) == 1 {
            start_line = line
            start_column = column
            word = ""
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when is_alnum(c) == 1 {
                        word = concat(word, char_at(source, pos))
                        pos = pos + 1
                        column = column + 1
                    } otherwise { scanning = 0 }
                } otherwise { scanning = 0 }
            }
            kind = "IDENT"
            when word == "show" { kind = "SHOW" } otherwise {
                when word == "hold" { kind = "HOLD" } otherwise {
                    when word == "when" { kind = "WHEN" } otherwise {
                        when word == "otherwise" { kind = "OTHERWISE" } otherwise {
                            when word == "while" { kind = "WHILE" } otherwise {
                                when word == "make" { kind = "MAKE" } otherwise {
                                    when word == "give" { kind = "GIVE" } otherwise {
                                        when word == "struct" { kind = "STRUCT" } otherwise {
                                            when word == "use" { kind = "USE" } otherwise {
                                                when word == "export" { kind = "EXPORT" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            output = concat(output, emit(kind, word, start_line, start_column))
            token_count = token_count + 1
            handled = 1
        }
    }

    when handled == 0 {
        when is_digit(ch) == 1 {
            start_line = line
            start_column = column
            number = ""
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when is_digit(c) == 1 {
                        number = concat(number, char_at(source, pos))
                        pos = pos + 1
                        column = column + 1
                    } otherwise { scanning = 0 }
                } otherwise { scanning = 0 }
            }
            when pos < length {
                c = char_code(source, pos)
                when c == 46 {
                    when pos + 1 < length {
                        after_dot = char_code(source, pos + 1)
                        when is_digit(after_dot) == 1 {
                            number = concat(number, ".")
                            pos = pos + 1
                            column = column + 1
                            scanning = 1
                            while scanning == 1 {
                                when pos < length {
                                    d = char_code(source, pos)
                                    when is_digit(d) == 1 {
                                        number = concat(number, char_at(source, pos))
                                        pos = pos + 1
                                        column = column + 1
                                    } otherwise { scanning = 0 }
                                } otherwise { scanning = 0 }
                            }
                        } otherwise {
                            errors = errors + 1
                            output = concat(output, error_record("invalid_number", start_line, start_column))
                            pos = pos + 1
                            column = column + 1
                        }
                    } otherwise {
                        errors = errors + 1
                        output = concat(output, error_record("invalid_number", start_line, start_column))
                        pos = pos + 1
                        column = column + 1
                    }
                }
            }
            when pos < length {
                exponent = char_code(source, pos)
                when exponent == 101 {
                    number = concat(number, "e")
                    pos = pos + 1
                    column = column + 1
                    sign = 0
                    when pos < length {
                        sign = char_code(source, pos)
                        when sign == 43 {
                            number = concat(number, "+")
                            pos = pos + 1
                            column = column + 1
                        } otherwise {
                            when sign == 45 {
                                number = concat(number, "-")
                                pos = pos + 1
                                column = column + 1
                            }
                        }
                    }
                    first_exp = 0
                    when pos < length { first_exp = char_code(source, pos) }
                    when is_digit(first_exp) == 1 {
                        scanning = 1
                        while scanning == 1 {
                            when pos < length {
                                d = char_code(source, pos)
                                when is_digit(d) == 1 {
                                    number = concat(number, char_at(source, pos))
                                    pos = pos + 1
                                    column = column + 1
                                } otherwise { scanning = 0 }
                            } otherwise { scanning = 0 }
                        }
                    } otherwise {
                        errors = errors + 1
                        output = concat(output, error_record("invalid_exponent", start_line, start_column))
                    }
                } otherwise {
                    when exponent == 69 {
                        number = concat(number, "E")
                        pos = pos + 1
                        column = column + 1
                        sign = 0
                        when pos < length {
                            sign = char_code(source, pos)
                            when sign == 43 {
                                number = concat(number, "+")
                                pos = pos + 1
                                column = column + 1
                            } otherwise {
                                when sign == 45 {
                                    number = concat(number, "-")
                                    pos = pos + 1
                                    column = column + 1
                                }
                            }
                        }
                        first_exp = 0
                        when pos < length { first_exp = char_code(source, pos) }
                        when is_digit(first_exp) == 1 {
                            scanning = 1
                            while scanning == 1 {
                                when pos < length {
                                    d = char_code(source, pos)
                                    when is_digit(d) == 1 {
                                        number = concat(number, char_at(source, pos))
                                        pos = pos + 1
                                        column = column + 1
                                    } otherwise { scanning = 0 }
                                } otherwise { scanning = 0 }
                            }
                        } otherwise {
                            errors = errors + 1
                            output = concat(output, error_record("invalid_exponent", start_line, start_column))
                        }
                    }
                }
            }
            output = concat(output, emit("NUMBER", number, start_line, start_column))
            token_count = token_count + 1
            handled = 1
        }
    }

    when handled == 0 {
        when ch == 34 {
            start_line = line
            start_column = column
            value = ""
            closed = 0
            pos = pos + 1
            column = column + 1
            scanning = 1
            while scanning == 1 {
                when pos < length {
                    c = char_code(source, pos)
                    when c == 34 {
                        closed = 1
                        pos = pos + 1
                        column = column + 1
                        scanning = 0
                    } otherwise {
                        when c == 92 {
                            escape_line = line
                            escape_column = column
                            pos = pos + 1
                            column = column + 1
                            when pos < length {
                                e = char_code(source, pos)
                                when e == 110 { value = concat(value, "\n") } otherwise {
                                    when e == 114 { value = concat(value, "\r") } otherwise {
                                        when e == 116 { value = concat(value, "\t") } otherwise {
                                            when e == 34 { value = concat(value, "\"") } otherwise {
                                                when e == 92 { value = concat(value, "\\") } otherwise {
                                                    when e == 120 {
                                                        when pos + 2 < length {
                                                            h1 = char_code(source, pos + 1)
                                                            h2 = char_code(source, pos + 2)
                                                            when is_hex(h1) == 1 {
                                                                when is_hex(h2) == 1 {
                                                                    code = hex_value(h1) * 16 + hex_value(h2)
                                                                    value = concat(value, char_from_code(code))
                                                                    pos = pos + 2
                                                                    column = column + 2
                                                                } otherwise {
                                                                    errors = errors + 1
                                                                    output = concat(output, error_record("invalid_hex_escape", escape_line, escape_column))
                                                                }
                                                            } otherwise {
                                                                errors = errors + 1
                                                                output = concat(output, error_record("invalid_hex_escape", escape_line, escape_column))
                                                            }
                                                        } otherwise {
                                                            errors = errors + 1
                                                            output = concat(output, error_record("incomplete_hex_escape", escape_line, escape_column))
                                                        }
                                                    } otherwise {
                                                        errors = errors + 1
                                                        output = concat(output, error_record("unknown_escape_sequence", escape_line, escape_column))
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                pos = pos + 1
                                column = column + 1
                            } otherwise {
                                errors = errors + 1
                                output = concat(output, error_record("unterminated_escape_sequence", escape_line, escape_column))
                                scanning = 0
                            }
                        } otherwise {
                            value = concat(value, char_at(source, pos))
                            pos = pos + 1
                            when c == 10 {
                                line = line + 1
                                column = 1
                            } otherwise {
                                column = column + 1
                            }
                        }
                    }
                } otherwise { scanning = 0 }
            }
            when closed == 0 {
                errors = errors + 1
                output = concat(output, error_record("unterminated_string", start_line, start_column))
            }
            output = concat(output, emit("STRING", value, start_line, start_column))
            token_count = token_count + 1
            handled = 1
        }
    }

    when handled == 0 {
        when ch == 43 { output = concat(output, emit("PLUS", "+", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
            when ch == 45 { output = concat(output, emit("MINUS", "-", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                when ch == 42 { output = concat(output, emit("STAR", "*", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                    when ch == 37 { output = concat(output, emit("PERCENT", "%", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                        when ch == 40 { output = concat(output, emit("LPAREN", "(", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                            when ch == 41 { output = concat(output, emit("RPAREN", ")", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                when ch == 123 { output = concat(output, emit("LBRACE", "{", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                    when ch == 125 { output = concat(output, emit("RBRACE", "}", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                        when ch == 91 { output = concat(output, emit("LBRACKET", "[", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                            when ch == 93 { output = concat(output, emit("RBRACKET", "]", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                when ch == 44 { output = concat(output, emit("COMMA", ",", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                    when ch == 58 { output = concat(output, emit("COLON", ":", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                        when ch == 59 { output = concat(output, emit("SEMICOLON", ";", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                            when ch == 46 { output = concat(output, emit("DOT", ".", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                                when ch == 61 {
                                                                    when pos + 1 < length {
                                                                        next = char_code(source, pos + 1)
                                                                        when next == 61 { output = concat(output, emit("EQ", "==", line, column)); pos = pos + 2; column = column + 2 } otherwise { output = concat(output, emit("ASSIGN", "=", line, column)); pos = pos + 1; column = column + 1 }
                                                                    } otherwise { output = concat(output, emit("ASSIGN", "=", line, column)); pos = pos + 1; column = column + 1 }
                                                                    token_count = token_count + 1
                                                                    handled = 1
                                                                } otherwise {
                                                                    when ch == 33 {
                                                                        when pos + 1 < length {
                                                                            next = char_code(source, pos + 1)
                                                                            when next == 61 { output = concat(output, emit("NEQ", "!=", line, column)); pos = pos + 2; column = column + 2; token_count = token_count + 1; handled = 1 } otherwise { errors = errors + 1; output = concat(output, error_record("unexpected_character", line, column)); pos = pos + 1; column = column + 1; handled = 1 }
                                                                        } otherwise { errors = errors + 1; output = concat(output, error_record("unexpected_character", line, column)); pos = pos + 1; column = column + 1; handled = 1 }
                                                                    } otherwise {
                                                                        when ch == 62 { output = concat(output, emit("GT", ">", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 } otherwise {
                                                                            when ch == 60 { output = concat(output, emit("LT", "<", line, column)); pos = pos + 1; column = column + 1; token_count = token_count + 1; handled = 1 }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    when handled == 0 {
        errors = errors + 1
        output = concat(output, error_record("unexpected_character", line, column))
        pos = pos + 1
        column = column + 1
    }
}

output = concat(output, emit("EOF", "", line, column))
write_file("selfhost/lexer_tokens.txt", output)
show "Lexer token count"
show token_count
show "Lexer error count"
show errors
show "=== lexer done ==="
