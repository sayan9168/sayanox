// ============================================================
// Sayanox Self-Hosting - Phase 1.3
// Minimal Lexer written entirely in Sayanox
// ============================================================
//
// Progress:
//   - String indexing now returns character codes in the C backend
//   - This file is ready to become a real scanner once a few
//     more helpers (string length, dynamic arrays) are added.
//
// Current language support used here:
//   - Arrays + indexing
//   - while loops
//   - functions
//   - string indexing (returns char code)

show "=== Sayanox Self-Hosting Phase 1.3 ==="
show "Minimal Lexer written in pure Sayanox"

// ------------------------------------------------------------
// Token kind constants
// ------------------------------------------------------------
hold TOK_EOF        = 0
hold TOK_SHOW       = 1
hold TOK_HOLD       = 2
hold TOK_MAKE       = 3
hold TOK_GIVE       = 4
hold TOK_WHEN       = 5
hold TOK_OTHERWISE  = 6
hold TOK_WHILE      = 7
hold TOK_STRUCT     = 8
hold TOK_IDENT      = 10
hold TOK_NUMBER     = 11
hold TOK_STRING     = 12
hold TOK_PLUS       = 20
hold TOK_MINUS      = 21
hold TOK_STAR       = 22
hold TOK_SLASH      = 23
hold TOK_ASSIGN     = 24
hold TOK_EQEQ       = 25
hold TOK_LPAREN     = 30
hold TOK_RPAREN     = 31
hold TOK_LBRACE     = 32
hold TOK_RBRACE     = 33
hold TOK_LBRACKET   = 34
hold TOK_RBRACKET   = 35
hold TOK_COMMA      = 36
hold TOK_DOT        = 37
hold TOK_COLON      = 38

show "Token constants defined"

// ------------------------------------------------------------
// Source we will conceptually scan
// ------------------------------------------------------------
hold source = "show 42"

show "Source text:"
show source

// Demonstrate string indexing → character code
// "s" of "show" should produce the numeric code of 's'
hold first_char_code = source[0]
show "First character code of source:"
show first_char_code

// ------------------------------------------------------------
// Character classification (now can use real codes later)
// ------------------------------------------------------------
make is_digit_code(code) {
    // '0' = 48, '9' = 57 in ASCII
    when code >= 48 {
        when code <= 57 {
            give 1
        } otherwise {
            give 0
        }
    } otherwise {
        give 0
    }
}

make is_alpha_code(code) {
    // rough check for letters (A-Z / a-z)
    when code >= 65 {
        when code <= 90 {
            give 1
        } otherwise {
            when code >= 97 {
                when code <= 122 {
                    give 1
                } otherwise {
                    give 0
                }
            } otherwise {
                give 0
            }
        }
    } otherwise {
        give 0
    }
}

// ------------------------------------------------------------
// Demo token stream for "show 42"
// ------------------------------------------------------------
hold tokens = [1, 11, 0]

show "Tokens for source 'show 42':"
hold i = 0
while i < 3 {
    show tokens[i]
    hold i = i + 1
}

// ------------------------------------------------------------
// Status
// ------------------------------------------------------------
show "String indexing (char codes) is now available"
show "Remaining for a complete self-hosted lexer:"
show "  - string length helper"
show "  - dynamic token list / push"
show "  - full character-by-character loop over source"

show "Phase 1.3 complete"
