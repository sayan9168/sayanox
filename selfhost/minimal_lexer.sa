// Self-Hosting Phase 1.5 — uses Phase A features
show "=== Self-Hosting Phase 1.5 ==="

hold TOK_SHOW = 1
hold TOK_NUMBER = 11
hold TOK_EOF = 0

hold source = "show 42"
hold source_len = len(source)
show source
show source_len

// Walk characters
hold i = 0
while i < source_len {
    hold code = source[i]
    show code
    hold i = i + 1
}

// Dynamic token list with push
hold tokens = []
push(tokens, TOK_SHOW)
push(tokens, TOK_NUMBER)
push(tokens, TOK_EOF)

show "Tokens:"
hold j = 0
while j < len(tokens) {
    show tokens[j]
    hold j = j + 1
}

show "Phase 1.5 complete — dynamic push + len + string walk"
