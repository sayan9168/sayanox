show lp_num(res_value_or(im_combination(5, 2), lp_n1()))
show lp_num(res_value_or(im_permutation(5, 2), lp_n1()))
show lp_num(res_value_or(im_combination(10, 0), lp_n1()))
show lp_num(res_value_or(im_permutation(10, 0), lp_n1()))
show lp_num(res_value_or(im_combination(10, 10), lp_n1()))
show lp_num(res_value_or(im_permutation(10, 10), lp_n1()))
show lp_num(res_error_or(im_combination(60, 30), 0))
show lp_num(res_error_or(im_permutation(60, 30), 0))
show lp_num(res_error_or(im_combination(100, 50), 0))
show lp_num(res_error_or(im_permutation(100, 50), 0))
show lp_num(res_value_or(im_combination(5, 6), lp_n1()))
show lp_num(res_value_or(im_permutation(5, 6), lp_n1()))
show lp_num(res_error_or(im_combination(lp_n1(), 2), 0))
show lp_num(res_error_or(im_permutation(lp_n1(), 2), 0))
show lp_num(res_error_or(im_combination(67, 33), 0))
show lp_num(res_error_or(im_permutation(67, 33), 0))
show lp_list(im_prime_factors(2))
show lp_list(im_prime_factors(12))
show lp_list(im_prime_factors(97))
show lp_list(im_prime_factors(1000))
show lp_list(im_prime_factors(999983))
show lp_list(im_divisors(1))
show lp_list(im_divisors(2))
show lp_list(im_divisors(12))
show lp_list(im_divisors(36))
show lp_list(im_divisors(97))
show lp_list(im_divisors(1000))
show lp_list(im_prime_factors(1))
show lp_list(im_divisors(0))
show im_digit_char(0)
show im_digit_char(9)
show im_digit_char(10)
show im_digit_char(35)
show lp_num(im_digit_value(48))
show lp_num(im_digit_value(57))
show lp_num(im_digit_value(65))
show lp_num(im_digit_value(90))
show lp_num(im_digit_value(97))
show lp_num(im_digit_value(122))
show lp_num(im_digit_value(64))
show im_to_base(0, 2)
hold lp_h_26 = im_from_base("0", 2)
show lp_num(res_value_or(lp_h_26, lp_n1()))
show im_to_base(255, 16)
hold lp_h_27 = im_from_base("FF", 16)
show lp_num(res_value_or(lp_h_27, lp_n1()))
hold lp_neg_28 = 0 - 255
show im_to_base(lp_neg_28, 16)
hold lp_h_29 = im_from_base("-FF", 16)
show lp_num(res_value_or(lp_h_29, lp_n1()))
show im_to_base(35, 36)
hold lp_h_30 = im_from_base("Z", 36)
show lp_num(res_value_or(lp_h_30, lp_n1()))
show im_to_base(123456789, 36)
hold lp_h_31 = im_from_base("21I3V9", 36)
show lp_num(res_value_or(lp_h_31, lp_n1()))
show im_to_base(10, 2)
hold lp_h_32 = im_from_base("1010", 2)
show lp_num(res_value_or(lp_h_32, lp_n1()))
hold lp_h_33 = im_from_base("zz", 16)
show lp_num(res_error_or(lp_h_33, 0))
hold lp_h_34 = im_from_base("10", 1)
show lp_num(res_error_or(lp_h_34, 0))
hold lp_h_35 = im_from_base("", 16)
show lp_num(res_error_or(lp_h_35, 0))
hold lp_h_36 = im_from_base("1g", 16)
show lp_num(res_error_or(lp_h_36, 0))
  give 0
}

make main_lp() -> num {
  hold call_1 = lp_sec_1()
  show "library-pack-intmath-ok"
  give 0
}

hold run_lp = main_lp()
