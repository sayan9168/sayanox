= 1;
  PH ph; memset(&ph, 0, sizeof ph);
  ph.t = 1; ph.f = 7;
  ph.va = base; ph.pa = base;
  ph.fs = file_sz; ph.ms = file_sz + 256; ph.a = 0x1000;

  FILE *o = fopen(path, "wb");
  if (!o) return 1;
  fwrite(&eh, 1, sizeof eh, o);
  fwrite(&ph, 1, sizeof ph, o);
  fwrite(code, 1, cpos, o);
  size_t zlen = 32 + 64 + NUM_LISTS * 8 + NUM_LISTS * MAX_LIST_ELEMS * 8;
  unsigned char *pad = calloc(1, zlen);
  fwrite(pad, 1, zlen, o);
  free(pad);
  if (pool_n) fwrite(pool, 1, pool_n, o);
  { unsigned char *hz = calloc(1, HEAP_SIZE); fwrite(hz, 1, HEAP_SIZE, o); free(hz); }
  fclose(o);
  chmod(path, 0755);
  printf("Sayanox native: %s (%zu bytes, %d functions)\n", path, cpos, nfuns);
  return 0;
}

int main(int argc, char **argv) {
  if (argc < 3) {
    fprintf(stderr, "Sayanox native compiler (x86_64 Linux)\n");
    fprintf(stderr, "Usage: %s <in.sa> <out>\n", argv[0]);
    fprintf(stderr, "  hold/show, + - * / %%, == != < > <= >=, when/while,\n");
    fprintf(stderr, "  lists, fields, make/call, use \"mod.sa\", write_file, run\n");
    return 1;
  }
  FILE *f = fopen(argv[1], "rb");
  if (!f) { perror(argv[1]); return 1; }
  fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
  char *s = malloc((size_t)n + 1); fread(s, 1, (size_t)n, f); s[n] = 0; fclose(f);
  char *exp = preprocess(s, 0);
  free(s);
  int rc = compile(exp, argv[2]);
  free(exp);
  return rc;
}
