// Boundary/precision fixture for stdlib/json_write.sa + stdlib/json_deep.sa
// (register R07). Every expected line is in selfhost/stdlib_json_boundary.want;
// the three backends must reproduce those bytes, so the oracle does not come
// from any compiler under test.
use "stdlib/json_write.sa"
use "stdlib/json_deep.sa"

// 1. Minify: whitespace between tokens goes, whitespace inside strings stays.
show jw_minify("  { \"a\" : 1 , \"b\" : [ 2 , 3 ] }  ")
show jw_minify("{}")
show jw_minify("[]")
show len(jw_minify("{\"k\": \"v w\"}"))

// 2. Updates on an empty document, and overwriting an existing key.
hold o0 = jw_obj_empty()
show jw_obj_set(o0, "a", jw_num(1))
show jw_obj_set(jw_obj_set(o0, "a", jw_num(1)), "a", jw_num(2))

// 3. A key that is a prefix of another key is never mistaken for it.
show jw_obj_set(o0, "user", jw_num(7))
show jw_obj_set(jw_obj_set(o0, "user", jw_num(7)), "user_id", jw_num(8))

// 4. Deletion: first, last, absent, and the only key.
hold o2 = jw_obj_set(jw_obj_set(o0, "a", jw_num(1)), "b", jw_num(2))
show o2
show jw_obj_del(o2, "a")
show jw_obj_del(o2, "b")
show jw_obj_del(o2, "zz")
show jw_obj_del(jw_obj_set(o0, "only", jw_num(1)), "only")

// 5. A deletion still leaves a well-formed document.
show jd_valid(jw_obj_del(jw_obj_set(o0, "only", jw_num(1)), "only"))
show jd_valid(jw_obj_del(o2, "a"))

// 6. Nested reads: dotted paths, indexes, types, absent paths.
hold doc = "{\"a\":{\"b\":[1,2,3]},\"c\":true,\"d\":{\"e\":{\"f\":\"x\"}}}"
show jd_valid(doc)
show jd_type(doc, "a")
show jd_type(doc, "a.b")
show jd_type(doc, "c")
show jd_type(doc, "d.e.f")
show jd_len(doc, "a.b")
show jd_num(doc, "a.b[2]")
show jd_flag(doc, "c")
show jd_text(doc, "d.e.f")
show jd_has(doc, "a.b[3]")
show jd_has(doc, "d.e")

// 7. Number policy: six fractional digits, trailing zeros trimmed, sign kept.
show jw_num(0)
show jw_num(7)
show jw_num(0 - 3)
show jw_num(0.5)
show jw_num(0.25)
show jw_num(0 - 0.5)
show jw_num(0.1)

// 8. Escaping round-trips through the reader.
hold s = "a\"b\\c"
show jw_str(s)
show jd_text(concat("{\"k\":", concat(jw_str(s), "}")), "k")
show jd_valid(concat("{\"k\":", concat(jw_str(s), "}")))

// 9. Arrays: appending to an empty and a non-empty array.
show jw_arr_add(jw_arr_empty(), jw_num(1))
show jw_arr_add(jw_arr_add(jw_arr_empty(), jw_num(1)), jw_num(2))
show jw_minify("[ 1 , 2 ]")

// 10. Malformed documents stay refused.
show jd_valid("{\"a\":}")
show jd_valid("[1,]")
show jd_valid("{\"a\" 1}")
// 11. Validated nested replacement preserves all unrelated bytes.
hold nested = " {\"a\":[1,{\"b\":2}],\"a\":3} "
show jd_set_raw(nested, "a.1.b", "[true, null]")
show jd_raw(jd_set_raw(nested, "a.1.b", "[true, null]"), "a.1.b")
show jd_set_raw(nested, "a.0", "9007199254740993")
show jd_set_raw("  1  ", "", "{\"x\":2}")
show len(jd_set_raw(nested, "a.2", "0"))
show len(jd_set_raw(nested, "a.1.b.c", "0"))
show len(jd_set_raw(nested, "a.0", "[1,]"))
show len(jd_set_raw("{\"a\":}", "a", "1"))
show jd_valid(jd_set_raw(nested, "a.1.b", "[true, null]"))
// 12. Deleting first, middle, last and only members or array elements.
hold deldoc = " {\"a\":[ 1, 2, 3 ], \"b\":{\"x\":1, \"y\":2}, \"c\":0 } "
show jd_delete_raw(deldoc, "a.0")
show jd_delete_raw(deldoc, "a.1")
show jd_delete_raw(deldoc, "a.2")
show jd_delete_raw(deldoc, "b.x")
show jd_delete_raw(deldoc, "b.y")
show jd_delete_raw("{\"a\":[1]}", "a.0")
show jd_delete_raw("{\"a\":1,\"a\":2}", "a")
show jd_valid(jd_delete_raw(deldoc, "a.1"))
show len(jd_delete_raw(deldoc, ""))
show len(jd_delete_raw(deldoc, "a.9"))
show len(jd_delete_raw("[1,]", "0"))
show jd_delete_raw("{\"\":{\"x\":1,\"y\":2}}", ".x")
show jd_delete_raw("{\"a\":{\"\":1,\"b\":2}}", "a.")
// 13. Insert or replace in an existing nested object, with raw key spelling.
show jd_object_put_raw("{\"a\": { }}", "a", "\"x\"", "[1,2]")
show jd_object_put_raw("{\"a\":{\"x\":1}}", "a", "\"x\"", "true")
show jd_object_put_raw("{\"a\":{\"x\":1}}", "a", "\"x.y\"", "null")
show jd_valid(jd_object_put_raw("{\"a\": { }}", "a", "\"x\"", "[1,2]"))
show len(jd_object_put_raw("{}", "missing", "\"x\"", "1"))
show len(jd_object_put_raw("[]", "", "\"x\"", "1"))
show len(jd_object_put_raw("{}", "", "1", "1"))
show len(jd_object_put_raw("{}", "", "\"x\"", "[1,]"))
// 14. Nested array insertion, including append and all invalid boundaries.
hold arrdoc = " {\"items\": [ 1, 2 ] } "
show jd_array_insert_raw(arrdoc, "items", 0, "true")
show jd_array_insert_raw(arrdoc, "items", 1, "{\"x\":3}")
show jd_array_insert_raw(arrdoc, "items", 2, "null")
show jd_array_insert_raw("[ ]", "", 0, "\"x\"")
show jd_raw(jd_array_insert_raw(arrdoc, "items", 1, "{\"x\":3}"), "items.1.x")
show jd_valid(jd_array_insert_raw(arrdoc, "items", 2, "null"))
show len(jd_array_insert_raw(arrdoc, "items", 0 - 1, "0"))
show len(jd_array_insert_raw(arrdoc, "items", 3, "0"))
show len(jd_array_insert_raw(arrdoc, "items", 0.5, "0"))
show len(jd_array_insert_raw(arrdoc, "items", 2.5, "0"))
show len(jd_array_insert_raw(arrdoc, "missing", 0, "0"))
show len(jd_array_insert_raw("{}", "", 0, "0"))
show len(jd_array_insert_raw("[1,]", "", 0, "0"))
show len(jd_array_insert_raw("[]", "", 0, "[1,]"))
// 15. Creating missing object paths and rejecting destructive traversal.
show jd_object_ensure_raw("{}", "a.b.c", "9007199254740993")
show jd_object_ensure_raw("{\"a\":{\"x\":1}}", "a.b.c", "true")
show jd_object_ensure_raw("{\"a\":{\"b\":1}}", "a.b", "[2]")
show jd_object_ensure_raw("{\"\":{}}", ".x", "null")
show jd_object_ensure_raw("  {}  ", "", "[1]")
show jd_raw(jd_object_ensure_raw("{}", "a.b.c", "9007199254740993"), "a.b.c")
show jd_valid(jd_object_ensure_raw("{}", "a.b.c", "true"))
show len(jd_object_ensure_raw("{\"a\":1}", "a.b", "2"))
show len(jd_object_ensure_raw("{\"a\":[]}", "a.0", "2"))
show len(jd_object_ensure_raw("[]", "a", "2"))
show len(jd_object_ensure_raw("{}", "a.b", "[1,]"))
show len(jd_object_ensure_raw("{", "a", "2"))
show len(jd_object_ensure_raw("{}", "a\"b", "2"))
show jd_object_ensure_raw("{\"a\":{},\"a\":{}}", "a.x", "1")
show jd_object_ensure_raw("{}", "a..b", "0")
show jd_object_ensure_raw("{ }", "x", " null ")
show "stdlib-json-ok"
