// Frozen independent expectations; do not edit by hand.
// Unicode module group: ugraph (UAX #29 extended grapheme clusters).
// Layer 1 is the official Unicode 17.0.0 GraphemeBreakTest.txt conformance file:
// all 766 cases, encoded below as -1, code points, -2, expected UTF-8 byte
// offsets, -3. U+0000 is replaced by U+0001 (same GCB=Control class) because a
// Sayanox string cannot carry byte 0. Layer 2 sweeps the class,
// Extended_Pictographic and InCB lookups over every scalar code point, printing
// transitions only. Layer 3 checks the cluster API against a rule-regex
// reference written from the UAX #29 rule text and validated against all 766
// official cases before use. The generator is a host-side tool and is not
// tracked; the .want bytes are the oracle.

use "stdlib/utf8.sa"
use "stdlib/uwidth.sa"
use "stdlib/ugraph.sa"

make fx_i(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_csv(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    when i > 0 {
      out = concat(out, ",")
    }
    hold piece = fx_i(xs[i])
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num(tag: str, v: num) -> num {
  hold body = fx_i(v)
  give fx_say(tag, body)
}

make fx_two(tag: str, body: str, v: num) -> num {
  hold n = fx_i(v)
  hold p = concat(body, " n=")
  hold q = concat(p, n)
  give fx_say(tag, q)
}

