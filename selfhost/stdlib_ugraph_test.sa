make conf_case(id: num, cps: list, exp: list) -> num {
  hold s = u8_from(cps)
  hold got = ug_breaks(s)
  hold ok = 1
  when len(got) != len(exp) {
    ok = 0
  }
  hold i = 0
  while i < len(exp) {
    when i < len(got) {
      when got[i] != exp[i] {
        ok = 0
      }
    }
    i = i + 1
  }
  hold tag = fx_i(id)
  hold head = concat("case ", tag)
  hold head2 = concat(head, ": ")
  hold body = fx_csv(got)
  hold n = ug_count(s)
  hold z = fx_two(head2, body, n)
  give ok
}

hold cdata = conf_data()
hold ci = 0
hold cid = 0
hold ccps = []
hold cexp = []
hold cmode = 0
hold cfail = 0
while ci < len(cdata) {
  hold tok = cdata[ci]
  when tok == 0 - 1 {
    cid = cid + 1
    ccps = []
    cexp = []
    cmode = 0
  }
  when tok == 0 - 2 {
    cmode = 1
  }
  when tok == 0 - 3 {
    hold ok = conf_case(cid, ccps, cexp)
    when ok == 0 {
      cfail = cfail + 1
    }
  }
  when tok >= 0 {
    when cmode == 0 {
      ccps = push(ccps, tok)
    }
    when cmode == 1 {
      cexp = push(cexp, tok)
    }
  }
  ci = ci + 1
}
hold z = fx_num("conformance cases: ", cid)
hold z = fx_num("conformance failures: ", cfail)


make sweep_emit(a: num, b: num, c: num, d: num, e: num) -> num {
  hold sa = fx_i(a)
  hold sb = fx_i(b)
  hold sc = fx_i(c)
  hold sd = fx_i(d)
  hold se = fx_i(e)
  hold p1 = concat(sa, ",")
  hold p2 = concat(p1, sb)
  hold p3 = concat(p2, ",")
  hold p4 = concat(p3, sc)
  hold p5 = concat(p4, ",")
  hold p6 = concat(p5, sd)
  hold p7 = concat(p6, ",")
  hold line = concat(p7, se)
  hold z = fx_say("props ", line)
  give 0
}

hold pstart = 0
hold pc = ug_class(0)
hold pp = ug_is_extpict(0)
hold pn = ug_incb(0)
hold pcp = 1
while pcp < 1114112 {
  when pcp == 55296 {
    pcp = 57344
  }
  hold c = ug_class(pcp)
  hold p = ug_is_extpict(pcp)
  hold n = ug_incb(pcp)
  when c != pc or p != pp or n != pn {
    hold e = pcp - 1
    hold z = sweep_emit(pstart, e, pc, pp, pn)
    pstart = pcp
    pc = c
    pp = p
    pn = n
  }
  pcp = pcp + 1
}
hold z = sweep_emit(pstart, 1114111, pc, pp, pn)


// ---- cluster API ----

make fx_clusters(s: str) -> str {
  hold n = ug_count(s)
  when n < 0 {
    give "<bad>"
  }
  hold out = ""
  hold i = 0
  while i < n {
    when i > 0 {
      out = concat(out, "|")
    }
    hold piece = ug_at(s, i)
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

