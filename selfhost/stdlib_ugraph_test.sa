// ---- refusals and edges ----
hold mb1 = chr(237)
hold mb2 = chr(160)
hold mb3 = chr(128)
hold mp = concat(mb1, mb2)
hold bad = concat(mp, mb3)
hold z = fx_num("malformed count: ", ug_count(bad))
hold z = fx_say("malformed at: ", ug_at(bad, 0))
hold z = fx_num("malformed width: ", ug_width(bad))
hold z = fx_say("malformed reverse: ", ug_reverse(bad))
hold z = fx_num("empty count: ", ug_count(""))
hold z = fx_say("empty at: ", ug_at("", 0))
hold z = fx_say("reversed slice: ", ug_slice("abc", 5, 1))
hold z = fx_say("clamped slice: ", ug_slice("abc", 0 - 3, 99))
hold z = fx_say("suffix too long: ", ug_truncate("abcd", 1, "..."))
hold z = fx_say("zero budget: ", ug_truncate("abcd", 0, ""))
hold z = fx_say("negative take: ", ug_take("abcd", 0 - 2))
hold z = fx_say("drop past end: ", ug_drop("abcd", 99))
hold z = fx_say("at past end: ", ug_at("abcd", 99))
hold z = fx_num("class L: ", ug_class(4352))
hold z = fx_num("class LV: ", ug_class(44032))
hold z = fx_num("class LVT: ", ug_class(44033))
hold z = fx_num("class other: ", ug_class(65))
hold z = fx_num("class negative: ", ug_class(0 - 1))
hold z = fx_num("class too big: ", ug_class(1114112))
hold z = fx_num("class surrogate: ", ug_class(55296))
hold z = fx_num("extpict thumbsup: ", ug_is_extpict(128077))
hold z = fx_num("extpict black star (17.0 says no): ", ug_is_extpict(9733))
hold z = fx_num("incb linker: ", ug_incb(2381))
hold z = fx_num("incb consonant: ", ug_incb(2325))
hold z = fx_num("incb none: ", ug_incb(65))
show "ugraph-oracle-ok"
