// Anchored match and full match, including fullmatch backtracking.
make rxt_sec_3_1() -> num {
  show rxt_num(rx_match("a+", "aaa"))
  show rxt_num(rx_full("a+", "aaa"))
  show rxt_num(rx_match("a+", "aaab"))
  show rxt_num(rx_full("a+", "aaab"))
  show rxt_num(rx_match("b*", "aaa"))
  show rxt_num(rx_full("b*", "aaa"))
  show rxt_num(rx_match("(a)(b)?", "a"))
  show rxt_num(rx_full("(a)(b)?", "a"))
  show rxt_num(rx_match("^a", "a"))
  show rxt_num(rx_full("^a", "a"))
  show rxt_num(rx_match("a|ab", "ab"))
  show rxt_num(rx_full("a|ab", "ab"))
  show rxt_num(rx_match("\\d{3}", "123"))
  show rxt_num(rx_full("\\d{3}", "123"))
  show rxt_num(rx_match("\\d{3}", "1234"))
  show rxt_num(rx_full("\\d{3}", "1234"))
  show rxt_num(rx_match("(a|ab)c", "abc"))
  show rxt_num(rx_full("(a|ab)c", "abc"))
  give 0
}

make rxt_sec_3_2() -> num {
  show rxt_num(rx_match("x{2,3}", "xx"))
  show rxt_num(rx_full("x{2,3}", "xx"))
  give 0
}

// Non-overlapping matches, including the empty-match advance rule.
make rxt_sec_4_1() -> num {
  show rxt_list(rx_find_all("a", "banana"))
  show rxt_num(rx_count("a", "banana"))
  show rxt_list(rx_find_all("[0-9]+", "a1b22c333"))
  show rxt_num(rx_count("[0-9]+", "a1b22c333"))
  show rxt_list(rx_find_all("x*", "abc"))
  show rxt_num(rx_count("x*", "abc"))
  show rxt_list(rx_find_all("", "abc"))
  show rxt_num(rx_count("", "abc"))
  show rxt_list(rx_find_all("a|b", "cabdab"))
  show rxt_num(rx_count("a|b", "cabdab"))
  show rxt_list(rx_find_all("\\b\\w+\\b", "one two three"))
  show rxt_num(rx_count("\\b\\w+\\b", "one two three"))
  show rxt_list(rx_find_all("(a)(b)?", "ab a ab"))
  show rxt_num(rx_count("(a)(b)?", "ab a ab"))
  show rxt_list(rx_find_all("\\s+", "a b\tc\nd"))
  show rxt_num(rx_count("\\s+", "a b\tc\nd"))
  show rxt_list(rx_find_all("a?", "aaa"))
  show rxt_num(rx_count("a?", "aaa"))
  give 0
}

make rxt_sec_4_2() -> num {
  show rxt_list(rx_find_all("(|a)", "ab"))
  show rxt_num(rx_count("(|a)", "ab"))
  show rxt_list(rx_find_all(".*?", "aab"))
  show rxt_num(rx_count(".*?", "aab"))
  show rxt_list(rx_find_all("[0-9a-f]", "zz1aFz"))
  show rxt_num(rx_count("[0-9a-f]", "zz1aFz"))
  give 0
}

// Replacements: & for the whole match, \1..\9 for groups.
make rxt_sec_5_1() -> num {
  show rx_replace("a", "banana", "o")
  show rx_replace_first("a", "banana", "o")
  show rx_replace("(a)(n)", "banana", "\\2\\1")
  show rx_replace_first("(a)(n)", "banana", "\\2\\1")
  show rx_replace("a+", "caaat", "[&]")
  show rx_replace_first("a+", "caaat", "[&]")
  show rx_replace("", "abc", "-")
  show rx_replace_first("", "abc", "-")
  show rx_replace("[0-9]", "a1b2", "#")
  show rx_replace_first("[0-9]", "a1b2", "#")
  show rx_replace("(\\w+)@(\\w+)", "a@b c@d", "\\2:\\1")
  show rx_replace_first("(\\w+)@(\\w+)", "a@b c@d", "\\2:\\1")
  show rx_replace("x", "abc", "y")
  show rx_replace_first("x", "abc", "y")
  show rx_replace("a*", "baaac", "<&>")
  show rx_replace_first("a*", "baaac", "<&>")
  show rx_replace("(a)?b", "b ab", "\\1")
  show rx_replace_first("(a)?b", "b ab", "\\1")
  give 0
}

make rxt_sec_5_2() -> num {
  show rx_replace("\\s+", " a  b ", "_")
  show rx_replace_first("\\s+", " a  b ", "_")
  show rx_replace("(a|b)", "abc", "&&")
  show rx_replace_first("(a|b)", "abc", "&&")
  show rx_replace("(a)(b)?(c)", "ac", "\\1\\2\\3")
  show rx_replace_first("(a)(b)?(c)", "ac", "\\1\\2\\3")
  show rx_replace("(ab)+", "ababab", "<&>")
  show rx_replace_first("(ab)+", "ababab", "<&>")
  show rx_replace("[aeiou]", "education", "*")
  show rx_replace_first("[aeiou]", "education", "*")
  show rx_replace("\\b(\\w)", "two words", "\\1!")
  show rx_replace_first("\\b(\\w)", "two words", "\\1!")
  show rx_replace("(x)?(y)?", "z", "[\\1\\2]")
  show rx_replace_first("(x)?(y)?", "z", "[\\1\\2]")
  give 0
}

// Literal escaping, and every escaped pattern matching its own text.
make rxt_sec_6_1() -> num {
  show rx_escape("a.b*c")
  show rxt_num(rx_full(rx_escape("a.b*c"), "a.b*c"))
  show rx_escape("[]")
  show rxt_num(rx_full(rx_escape("[]"), "[]"))
  show rx_escape("\\d")
  show rxt_num(rx_full(rx_escape("\\d"), "\\d"))
  show rx_escape("x+y")
  show rxt_num(rx_full(rx_escape("x+y"), "x+y"))
  show rx_escape("(a)")
  show rxt_num(rx_full(rx_escape("(a)"), "(a)"))
  show rx_escape("a b")
  show rxt_num(rx_full(rx_escape("a b"), "a b"))
  show rx_escape("100%")
  show rxt_num(rx_full(rx_escape("100%"), "100%"))
  show rx_escape("^$|?")
  show rxt_num(rx_full(rx_escape("^$|?"), "^$|?"))
  show rx_escape("a{2,3}")
  show rxt_num(rx_full(rx_escape("a{2,3}"), "a{2,3}"))
  give 0
}

make rxt_sec_6_2() -> num {
  show rx_escape("-_=:;,")
  show rxt_num(rx_full(rx_escape("-_=:;,"), "-_=:;,"))
  show rx_escape("a\nb")
  show rxt_num(rx_full(rx_escape("a\nb"), "a\nb"))
  show rx_escape("a\tb")
  show rxt_num(rx_full(rx_escape("a\tb"), "a\tb"))
  give 0
}

// Contract: forms Python accepts that this bounded engine refuses.
make rxt_sec_7_1() -> num {
  show rxt_num(rx_valid("[[:alpha:]]"))
  show rxt_num(rx_valid("(a*)*"))
  show rxt_num(rx_valid("(a?)+"))
  show rxt_num(rx_valid("(a|)+"))
  show rxt_num(rx_valid("(?=a)"))
  show rxt_num(rx_valid("(?!a)"))
  show rxt_num(rx_valid("(?<=a)"))
  show rxt_num(rx_valid("(?i)a"))
  show rxt_num(rx_valid("a*+"))
  show rxt_num(rx_valid("(?P<x>a)"))
  show rxt_num(rx_valid("\\1"))
  show rxt_num(rx_valid("\\q"))
  show rxt_num(rx_valid("a{3,2}"))
  show rxt_num(rx_valid("a{65}"))
  show rxt_num(rx_valid("a{1,2,3}"))
  show rxt_num(rx_valid("a{,3}"))
  show rxt_num(rx_valid(""))
  show rxt_list(rx_find("(", "abc"))
  give 0
}

make rxt_sec_7_2() -> num {
  show rxt_list(rx_find("[z-a]", "abc"))
  show rxt_num(rx_search("\\1", "a"))
  give 0
}

// Contract: input, pattern, match and step limits, pinned.
make rxt_sec_8_1() -> num {
  show rxt_num(len(rxt_rep(1024, "a")))
  show rxt_num(rx_search("a+", rxt_rep(1024, "a")))
  show rxt_num(rx_search("a+", rxt_rep(1025, "a")))
  show rxt_list(rx_find("a+", rxt_rep(1025, "a")))
  show rxt_num(rx_search(rxt_rep(200, "a"), "aaa"))
  show rxt_num(rx_search(rxt_rep(201, "a"), "aaa"))
  show rxt_num(len(rx_find_all("a", rxt_rep(300, "a"))))
  show rxt_num(rx_count("", rxt_rep(4, "b")))
  show rxt_list(rx_find("(a+)+$", concat(rxt_rep(22, "a"), "X")))
  show rxt_num(rx_search("(a+)+$", concat(rxt_rep(22, "a"), "X")))
  show rxt_num(rxt_rep(22, "a") != "")
  show rxt_num(rx_budget() > 0)
  give 0
}

make rxt_suite() -> num {
  hold c_1_1 = rxt_sec_1_1()
  hold c_1_2 = rxt_sec_1_2()
  hold c_1_3 = rxt_sec_1_3()
  hold c_1_4 = rxt_sec_1_4()
  hold c_2_1 = rxt_sec_2_1()
  hold c_2_2 = rxt_sec_2_2()
  hold c_2_3 = rxt_sec_2_3()
  hold c_2_4 = rxt_sec_2_4()
  hold c_2_5 = rxt_sec_2_5()
  hold c_2_6 = rxt_sec_2_6()
  hold c_3_1 = rxt_sec_3_1()
  hold c_3_2 = rxt_sec_3_2()
  hold c_4_1 = rxt_sec_4_1()
  hold c_4_2 = rxt_sec_4_2()
  hold c_5_1 = rxt_sec_5_1()
  hold c_5_2 = rxt_sec_5_2()
  hold c_6_1 = rxt_sec_6_1()
  hold c_6_2 = rxt_sec_6_2()
  hold c_7_1 = rxt_sec_7_1()
  hold c_7_2 = rxt_sec_7_2()
  hold c_8_1 = rxt_sec_8_1()
  show "regex-done"
  give 0
}

hold rxt_run = rxt_suite()
