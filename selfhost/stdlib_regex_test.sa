// First-match spans and captures, Python re.search order.
make rxt_sec_2_1() -> num {
  show rxt_list(rx_find("a", "banana"))
  show rxt_list(rx_find("a+", "caaat"))
  show rxt_list(rx_find("ana", "banana"))
  show rxt_list(rx_find("xyz", "banana"))
  show rxt_list(rx_find("a|ab", "xab"))
  show rxt_list(rx_find("ab|a", "xab"))
  show rxt_list(rx_find("(a)(b)?", "xa"))
  show rxt_list(rx_find("(a)(b)?", "xab"))
  show rxt_list(rx_find("((a)(b))c", "xabc"))
  show rxt_list(rx_find("a{2,3}", "aaaa"))
  show rxt_list(rx_find("a{2,3}?", "aaaa"))
  show rxt_list(rx_find("^a+$", "aaa"))
  show rxt_list(rx_find("^a+$", "baaa"))
  show rxt_list(rx_find("a$", "aba\n"))
  show rxt_list(rx_find("a$", "abab"))
  show rxt_list(rx_find("\\d+", "x42"))
  show rxt_list(rx_find("[^a-z]+", "ab12cd"))
  show rxt_list(rx_find("\\.", "a.b"))
  give 0
}

