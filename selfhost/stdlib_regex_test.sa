// Frozen expectations; do not edit by hand.
// Independent oracle: Python 3.11 `re` in re.ASCII mode decides every
// line except the two contract sections, which pin this module's own
// documented refusals and limits. Regenerated with the retired generator.
use "stdlib/regex.sa"

make rxt_num(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    out = concat(chr(48 + d), out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make rxt_list(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    when i > 0 {
      out = concat(out, ",")
    }
    out = concat(out, rxt_num(xs[i]))
    i = i + 1
  }
  give out
}

// Repeat one byte n times, so the limit section can build a 1024-byte subject
// and a 200-byte pattern without writing either of them out.
make rxt_rep(n: num, ch: str) -> str {
  hold out = ""
  hold i = 0
  while i < n {
    out = concat(out, ch)
    i = i + 1
  }
  give out
}

// Pattern acceptance: every form this module documents as supported.
make rxt_sec_1_1() -> num {
  show rxt_num(rx_valid("a"))
  show rxt_num(rx_valid("ab|cd"))
  show rxt_num(rx_valid("(a|b)+"))
  show rxt_num(rx_valid("a{0,2}"))
  show rxt_num(rx_valid("(ab){1,2}"))
  show rxt_num(rx_valid("[a-c-e]"))
  show rxt_num(rx_valid("[-a]"))
  show rxt_num(rx_valid("[a-]"))
  show rxt_num(rx_valid("[]a]"))
  show rxt_num(rx_valid("[^]a]"))
  show rxt_num(rx_valid("[\\]]"))
  show rxt_num(rx_valid("[a\\]b]"))
  show rxt_num(rx_valid("[!-/]"))
  show rxt_num(rx_valid("[\\d\\s]"))
  show rxt_num(rx_valid("[^\\w]"))
  show rxt_num(rx_valid("[\\x20-\\x7E]+"))
  show rxt_num(rx_valid("\\x41"))
  show rxt_num(rx_valid("\\\\"))
  give 0
}

