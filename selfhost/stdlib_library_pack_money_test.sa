use "stdlib/decimal.sa"
use "stdlib/money.sa"

make lp_num(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    out = concat(chr(48 + d), out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make lp_list(xs: list) -> str {
  hold out = ""
  hold n = len(xs)
  hold i = 0
  while i < n {
    when i > 0 {
      out = concat(out, ",")
    }
    out = concat(out, lp_num(xs[i]))
    i = i + 1
  }
  give out
}

make lp_n1() -> num {
  give 0 - 1
}

