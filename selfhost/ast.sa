// Sayanox AST layer written in Sayanox.
// This bootstrap representation uses parallel arrays and stable integer tags.

show "=== Sayanox AST ==="

hold kinds = []
hold values = []
hold left = []
hold right = []
hold count = 0

make ast_number(value) {
    push(kinds, 1)
    push(values, value)
    push(left, -1)
    push(right, -1)
    hold id = count
    hold count = count + 1
    give id
}

make ast_binary(kind, lhs, rhs) {
    push(kinds, kind)
    push(values, 0)
    push(left, lhs)
    push(right, rhs)
    hold id = count
    hold count = count + 1
    give id
}

hold n = ast_number(42)
hold root = ast_binary(2, n, n)
show "AST nodes"
show count
show "AST root"
show root
show "=== AST done ==="
