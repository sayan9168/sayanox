// ============================================================
// Sayanox self-host compiler
// Stage 1: compile hello.sa -> hello_out.c
//          emit stage2_cc.c (Stage-2 mini compiler in C)
// Stage 2: gcc stage2_cc.c && ./stage2 compiles hello.sa again
// All comments in English.
// ============================================================

show "=== Sayanox Stage-1 self-host compiler ==="

hold input_path = "selfhost/hello.sa"
hold output_path = "selfhost/hello_out.c"

hold source = read_file(input_path)
hold src_len = len(source)
show "Stage1: compiling"
show input_path

hold num_vals = []
hold pos = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

while pos < src_len {
    hold c = source[pos]
    when is_space(c) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(c) == 1 {
            hold val = c - 48
            hold pos = pos + 1
            while pos < src_len {
                hold c2 = source[pos]
                when is_digit(c2) == 1 {
                    hold val = val * 10 + (c2 - 48)
                    hold pos = pos + 1
                } otherwise {
                    hold pos = src_len
                }
            }
            push(num_vals, val)
        } otherwise {
            hold pos = pos + 1
        }
    }
}

hold nval = 0
when len(num_vals) > 0 {
    hold nval = num_vals[0]
} otherwise {
    hold nval = 0
}

hold p1 = "// Generated by Sayanox Stage-1\n#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", "
hold p2 = concat(p1, str(nval))
hold p3 = concat(p2, ");\n  return 0;\n}\n")
write_file(output_path, p3)
show "Stage1: wrote"
show output_path

// Emit Stage-2 mini compiler (C source)
hold s2 = "/* Stage-2 mini compiler generated by Sayanox Stage-1 */\n"
hold s2 = concat(s2, "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n")
hold s2 = concat(s2, "static char *read_file(const char *path) {\n")
hold s2 = concat(s2, "  FILE *f = fopen(path, \"rb\");\n")
hold s2 = concat(s2, "  if (!f) { fprintf(stderr, \"stage2: cannot open %s\\n\", path); exit(1); }\n")
hold s2 = concat(s2, "  fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);\n")
hold s2 = concat(s2, "  char *b = (char*)malloc((size_t)n + 1);\n")
hold s2 = concat(s2, "  if (!b) exit(1);\n")
hold s2 = concat(s2, "  fread(b, 1, (size_t)n, f); b[n] = 0; fclose(f); return b;\n}\n\n")
hold s2 = concat(s2, "int main(void) {\n")
hold s2 = concat(s2, "  const char *in = \"selfhost/hello.sa\";\n")
hold s2 = concat(s2, "  const char *out = \"selfhost/stage2_out.c\";\n")
hold s2 = concat(s2, "  char *src = read_file(in);\n")
hold s2 = concat(s2, "  double nval = 0;\n")
hold s2 = concat(s2, "  for (char *p = src; *p; p++) {\n")
hold s2 = concat(s2, "    if (*p >= '0' && *p <= '9') {\n")
hold s2 = concat(s2, "      nval = 0;\n")
hold s2 = concat(s2, "      while (*p >= '0' && *p <= '9') { nval = nval * 10 + (*p - '0'); p++; }\n")
hold s2 = concat(s2, "      break;\n")
hold s2 = concat(s2, "    }\n")
hold s2 = concat(s2, "  }\n")
hold s2 = concat(s2, "  FILE *o = fopen(out, \"wb\");\n")
hold s2 = concat(s2, "  if (!o) { fprintf(stderr, \"stage2: cannot write\\n\"); exit(1); }\n")
hold s2 = concat(s2, "  fprintf(o, \"/* Generated by Stage-2 mini compiler */\\n\");\n")
hold s2 = concat(s2, "  fprintf(o, \"#include <stdio.h>\\nint main(void){\\n\");\n")
hold s2 = concat(s2, "  fprintf(o, \"  printf(\\\"%g\\\\n\\\", %g);\\n\", nval);\n")
hold s2 = concat(s2, "  fprintf(o, \"  return 0;\\n}\\n\");\n")
hold s2 = concat(s2, "  fclose(o);\n")
hold s2 = concat(s2, "  printf(\"Stage2: compiled %s -> %s (n=%g)\\n\", in, out, nval);\n")
hold s2 = concat(s2, "  free(src);\n")
hold s2 = concat(s2, "  return 0;\n}\n")

write_file("selfhost/stage2_cc.c", s2)
show "Stage1: emitted Stage-2 mini compiler -> selfhost/stage2_cc.c"

hold mark = concat("stage1_ok n=", str(nval))
write_file("selfhost/stage1_ok.txt", mark)
show "Stage1 finished"
