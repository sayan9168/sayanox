// Sayanox Stage-3 compiler entry (written in Sayanox).
// For the focused self-hosted path see also: selfhost/sayanoxc.sa
//
// Pipeline:
//   Stage-2 (C) lowers this file -> C binary
//   That binary is a compiler written in Sayanox logic
//
// Supported subset here: scan + validate + emit simple C for show NUMBER

show "=== Sayanox Stage-3 Compiler ==="

hold input_path = "selfhost/hello.sa"
hold source = read_file(input_path)
hold source_len = len(source)
hold pos = 0
hold token_count = 0
hold number_count = 0
hold parse_ok = 1
hold value = 0

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

while pos < source_len {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < source_len {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      hold number_count = number_count + 1
      hold token_count = token_count + 1
    } otherwise {
      // show / other letters
      when ch >= 97 {
        when ch <= 122 {
          hold pos = pos + 1
          hold token_count = token_count + 1
        } otherwise {
          hold pos = pos + 1
        }
      } otherwise {
        hold pos = pos + 1
      }
    }
  }
}

hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
hold out = concat(out, str(value))
hold out = concat(out, ");\n  return 0;\n}\n")
hold w = write_file("selfhost/hello_out.c", out)

show "Stage3: wrote hello_out.c"
show value
show token_count
