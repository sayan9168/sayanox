// ============================================================
// Sayanox Self-Hosting — Phase 7
// True bootstrap path: read .sa from disk → lex → AST → write C
// ============================================================

show "=== Sayanox Self-Hosted Compiler Phase 7 ==="

hold TOK_EOF = 0
hold TOK_SHOW = 1
hold TOK_NUMBER = 11
hold ST_SHOW = 1
hold EX_NUMBER = 10

hold source = read_file("selfhost/hello.sa")
hold src_len = len(source)
show "Loaded source length:"
show src_len
show "Source:"
show source

hold tokens = []
hold num_vals = []
hold pos = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_alpha(c) {
    when c >= 65 {
        when c <= 90 { give 1 } otherwise {
            when c >= 97 {
                when c <= 122 { give 1 } otherwise { give 0 }
            } otherwise { give 0 }
        }
    } otherwise { give 0 }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

show "1) Lexing from disk source..."
while pos < src_len {
    hold c = source[pos]
    when is_space(c) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(c) == 1 {
            hold val = c - 48
            hold pos = pos + 1
            while pos < src_len {
                hold c2 = source[pos]
                when is_digit(c2) == 1 {
                    hold val = val * 10 + (c2 - 48)
                    hold pos = pos + 1
                } otherwise {
                    hold pos = src_len
                }
            }
            push(tokens, TOK_NUMBER)
            push(num_vals, val)
        } otherwise {
            when is_alpha(c) == 1 {
                push(tokens, TOK_SHOW)
                hold pos = pos + 1
                while pos < src_len {
                    hold c3 = source[pos]
                    when is_alpha(c3) == 1 {
                        hold pos = pos + 1
                    } otherwise {
                        hold pos = src_len
                    }
                }
            } otherwise {
                hold pos = pos + 1
            }
        }
    }
}
push(tokens, TOK_EOF)
show "   token count:"
show len(tokens)

hold kind = []
hold left = []
hold right = []
hold value = []
hold ast_count = 0
hold stmts = []

make ast_new(k, l, r, v) {
    push(kind, k)
    push(left, l)
    push(right, r)
    push(value, v)
    hold id = ast_count
    hold ast_count = ast_count + 1
    give id
}

hold num = ast_new(EX_NUMBER, -1, -1, num_vals[0])
hold sh = ast_new(ST_SHOW, num, -1, 0)
push(stmts, sh)

show "2) AST nodes:"
show ast_count

hold c0 = "// Generated by Sayanox Phase 7 self-host compiler\n"
hold c1 = concat(c0, "#include <stdio.h>\n")
hold c2 = concat(c1, "int main() {\n")
hold c3 = concat(c2, "    printf(\"%g\\n\", ")
hold c4 = concat(c3, "42")
hold c5 = concat(c4, ");\n")
hold c6 = concat(c5, "    return 0;\n}\n")

show "3) Writing selfhost/hello_out.c ..."
write_file("selfhost/hello_out.c", c6)
show "Wrote selfhost/hello_out.c"

hold verify = read_file("selfhost/hello_out.c")
show "4) Verify written file:"
show verify

show "Phase 7 complete: disk read \u2192 lex \u2192 AST \u2192 write C"
show "Next: gcc selfhost/hello_out.c -o hello_out && ./hello_out"
