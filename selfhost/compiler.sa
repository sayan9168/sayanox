// ============================================================
// Sayanox Self-Host Compiler
// Disk read -> lex (richer grammar tokens) -> AST -> write C
// Uses str() for number-to-string in codegen
// All comments in English
// ============================================================

show "=== Sayanox Self-Host Compiler ==="

hold TOK_EOF = 0
hold TOK_SHOW = 1
hold TOK_HOLD = 2
hold TOK_GIVE = 4
hold TOK_WHEN = 5
hold TOK_WHILE = 7
hold TOK_IDENT = 10
hold TOK_NUMBER = 11
hold TOK_PLUS = 20
hold TOK_MINUS = 21
hold TOK_STAR = 22
hold TOK_SLASH = 23

hold ST_SHOW = 1
hold EX_NUMBER = 10

hold source = read_file("selfhost/hello.sa")
hold src_len = len(source)
show "Source:"
show source

hold tokens = []
hold num_vals = []
hold pos = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_alpha(c) {
    when c >= 65 {
        when c <= 90 { give 1 } otherwise {
            when c >= 97 {
                when c <= 122 { give 1 } otherwise { give 0 }
            } otherwise { give 0 }
        }
    } otherwise { give 0 }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

while pos < src_len {
    hold c = source[pos]
    when is_space(c) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(c) == 1 {
            hold val = c - 48
            hold pos = pos + 1
            while pos < src_len {
                hold c2 = source[pos]
                when is_digit(c2) == 1 {
                    hold val = val * 10 + (c2 - 48)
                    hold pos = pos + 1
                } otherwise {
                    hold pos = src_len
                }
            }
            push(tokens, TOK_NUMBER)
            push(num_vals, val)
        } otherwise {
            when is_alpha(c) == 1 {
                when c == 115 { push(tokens, TOK_SHOW) } otherwise {
                    when c == 104 { push(tokens, TOK_HOLD) } otherwise {
                        when c == 103 { push(tokens, TOK_GIVE) } otherwise {
                            when c == 119 { push(tokens, TOK_WHEN) } otherwise {
                                push(tokens, TOK_IDENT)
                            }
                        }
                    }
                }
                hold pos = pos + 1
                while pos < src_len {
                    hold c3 = source[pos]
                    when is_alpha(c3) == 1 {
                        hold pos = pos + 1
                    } otherwise {
                        hold pos = src_len
                    }
                }
            } otherwise {
                when c == 43 { push(tokens, TOK_PLUS) hold pos = pos + 1 } otherwise {
                    when c == 45 { push(tokens, TOK_MINUS) hold pos = pos + 1 } otherwise {
                        when c == 42 { push(tokens, TOK_STAR) hold pos = pos + 1 } otherwise {
                            when c == 47 { push(tokens, TOK_SLASH) hold pos = pos + 1 } otherwise {
                                hold pos = pos + 1
                            }
                        }
                    }
                }
            }
        }
    }
}
push(tokens, TOK_EOF)

hold nval = 42
when len(num_vals) > 0 {
    hold nval = num_vals[0]
} otherwise {
    hold nval = 42
}

hold hdr = "// Generated by Sayanox self-host\n#include <stdio.h>\nint main(){\n  printf(\"%g\\n\", "
hold body = concat(hdr, str(nval))
hold out = concat(body, ");\n  return 0;\n}\n")

write_file("selfhost/hello_out.c", out)
show "Wrote selfhost/hello_out.c using str() for number codegen"
show out
show "Tokenizer grammar: show hold give when while ident number + - * /"
