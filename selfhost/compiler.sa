// Sayanox Stage-3 compiler entry — written in Sayanox.
// Full self-host path: Stage-2 lowers this file to a native binary.
// Local variables now pass through an explicit Sayanox-owned LOAD/STORE boundary.
// Native CPU instruction selection is not implemented here.

show 3

hold input_path = "selfhost/hello.sa"
hold source = read_file(input_path)
hold source_len = len(source)
hold pos = 0
hold token_count = 0
hold value = 0
hold seen = 0
hold left_value = 0
hold right_value = 0
hold expression_seen = 0
hold operator = 0
hold expression_part = 0
hold variable_seen = 0
hold variable_value = 0
hold variable_name = ""

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_alpha(c) {
  when c == 95 { give 1 } otherwise {
    when c >= 65 {
      when c <= 90 { give 1 } otherwise {
        when c >= 97 {
          when c <= 122 { give 1 } otherwise { give 0 }
        } otherwise { give 0 }
      }
    } otherwise { give 0 }
  }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

// Sayanox-owned primitive lowering: canonical backend expression.
make lower_number(number) {
  give str(number)
}

// Sayanox-owned binary-expression lowering.
make lower_binary(left, op, right) {
  hold out = lower_number(left)
  when op == 43 {
    hold out = concat(out, " + ")
  } otherwise {
    when op == 45 {
      hold out = concat(out, " - ")
    } otherwise {
      when op == 42 {
        hold out = concat(out, " * ")
      } otherwise {
        when op == 47 {
          hold out = concat(out, " / ")
        } otherwise {
          hold out = concat(out, " ? ")
        }
      }
    }
  }
  hold out = concat(out, lower_number(right))
  give out
}

// Local-variable lowering boundary.
// STORE materializes a named local in the lowered backend representation.
make lower_store(name, number) {
  hold out = "double "
  hold out = concat(out, name)
  hold out = concat(out, " = ")
  hold out = concat(out, lower_number(number))
  hold out = concat(out, ";\n")
  give out
}

// LOAD materializes a read of an existing local. The backend receives the
// lowered expression instead of re-parsing the source declaration.
make lower_load(name) {
  give name
}

while pos < source_len {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < source_len {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      when expression_part == 0 {
        hold left_value = value
        hold expression_part = 1
      } otherwise {
        hold right_value = value
        hold expression_part = 2
      }
      hold seen = 1
      hold token_count = token_count + 1
    } otherwise {
      // Recognize the simple local declaration form: hold <name> = <number>.
      when ch == 104 {
        hold pos = pos + 1
        when pos < source_len {
          hold ch2 = source[pos]
          when ch2 == 111 {
            hold pos = pos + 1
            when pos < source_len {
              hold ch2 = source[pos]
              when ch2 == 108 {
                hold pos = pos + 1
                when pos < source_len {
                  hold ch2 = source[pos]
                  when ch2 == 100 {
                    hold pos = pos + 1
                    hold variable_name = ""
                    while pos < source_len {
                      hold ch2 = source[pos]
                      when is_space(ch2) {
                        hold pos = pos + 1
                      } otherwise {
                        when is_alpha(ch2) {
                          hold variable_name = char_at(source, pos)
                          hold pos = pos + 1
                        } otherwise {
                          hold pos = pos
                          break
                        }
                      }
                    }
                    hold variable_seen = 1
                    hold token_count = token_count + 1
                  } otherwise {
                    hold token_count = token_count + 1
                  }
                }
              }
            }
          }
        }
      } otherwise {
        when ch == 43 {
          hold operator = ch
          hold expression_seen = 1
          hold pos = pos + 1
          hold token_count = token_count + 1
        } otherwise {
          when ch == 45 {
            hold operator = ch
            hold expression_seen = 1
            hold pos = pos + 1
            hold token_count = token_count + 1
          } otherwise {
            when ch == 42 {
              hold operator = ch
              hold expression_seen = 1
              hold pos = pos + 1
              hold token_count = token_count + 1
            } otherwise {
              when ch == 47 {
                hold operator = ch
                hold expression_seen = 1
                hold pos = pos + 1
                hold token_count = token_count + 1
              } otherwise {
                when ch == 115 {
                  // Simple `show <name>` load marker. The full parser will
                  // replace this scanner shortcut in the next self-host step.
                  hold pos = pos + 1
                  hold token_count = token_count + 1
                } otherwise {
                  hold pos = pos + 1
                  hold token_count = token_count + 1
                }
              }
            }
          }
        }
      }
    }
  }
}

when seen {
  when expression_seen == 1 {
    when expression_part == 2 {
      hold lowered_value = lower_binary(left_value, operator, right_value)
      hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)("
      hold out = concat(out, lowered_value)
      hold out = concat(out, "));\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show right_value
      show token_count
    } otherwise {
      hold lowered_value = lower_number(value)
      hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
      hold out = concat(out, lowered_value)
      hold out = concat(out, ");\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show value
      show token_count
    }
  } otherwise {
    when variable_seen == 1 {
      // Demonstration of the Sayanox-owned STORE -> LOAD path.
      hold stored = lower_store(variable_name, value)
      hold loaded = lower_load(variable_name)
      hold out = "#include <stdio.h>\nint main(void){\n  "
      hold out = concat(out, stored)
      hold out = concat(out, "  printf(\"%g\\n\", (double)(")
      hold out = concat(out, loaded)
      hold out = concat(out, "));\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show value
      show token_count
    } otherwise {
      hold lowered_value = lower_number(value)
      hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
      hold out = concat(out, lowered_value)
      hold out = concat(out, ");\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show value
      show token_count
    }
  }
} otherwise {
  show 0
}
