// Sayanox Stage-3 compiler entry — written in Sayanox.
// Full self-host path: Stage-2 lowers this file to a native binary.
// The compiler now owns a small lowering boundary for primitive constants.
// Native CPU instruction selection is intentionally NOT implemented here.

show 3

hold input_path = "selfhost/hello.sa"
hold source = read_file(input_path)
hold source_len = len(source)
hold pos = 0
hold token_count = 0
hold value = 0
hold seen = 0

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

// First Sayanox-owned lowering step: represent a numeric constant as the
// canonical backend expression. Keeping this decision here means later
// backends can consume the same lowered value without re-scanning source.
make lower_number(number) {
  give str(number)
}

while pos < source_len {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < source_len {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      hold seen = 1
      hold token_count = token_count + 1
    } otherwise {
      hold pos = pos + 1
      hold token_count = token_count + 1
    }
  }
}

when seen {
  hold lowered_value = lower_number(value)
  hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
  hold out = concat(out, lowered_value)
  hold out = concat(out, ");\n  return 0;\n}\n")
  hold w = write_file("selfhost/hello_out.c", out)
  show value
  show token_count
} otherwise {
  show 0
}
