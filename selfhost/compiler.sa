// ============================================================
// Sayanox self-host compiler (Stage 1 binary target)
// All comments in English.
//
// Stage 0: Rust sayanox compiles this file -> stage1 binary
// Stage 1: ./stage1 reads hello.sa, writes hello_out.c
// ============================================================

show "=== Sayanox Stage-1 self-host compiler ==="

hold TOK_EOF = 0
hold TOK_SHOW = 1
hold TOK_HOLD = 2
hold TOK_GIVE = 4
hold TOK_WHEN = 5
hold TOK_WHILE = 7
hold TOK_IDENT = 10
hold TOK_NUMBER = 11
hold TOK_PLUS = 20
hold TOK_MINUS = 21
hold TOK_STAR = 22
hold TOK_SLASH = 23

hold input_path = "selfhost/hello.sa"
hold output_path = "selfhost/hello_out.c"

hold source = read_file(input_path)
hold src_len = len(source)
show "Input path:"
show input_path
show "Source length:"
show src_len

hold tokens = []
hold num_vals = []
hold pos = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_alpha(c) {
    when c >= 65 {
        when c <= 90 { give 1 } otherwise {
            when c >= 97 {
                when c <= 122 { give 1 } otherwise { give 0 }
            } otherwise { give 0 }
        }
    } otherwise { give 0 }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

while pos < src_len {
    hold c = source[pos]
    when is_space(c) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(c) == 1 {
            hold val = c - 48
            hold pos = pos + 1
            while pos < src_len {
                hold c2 = source[pos]
                when is_digit(c2) == 1 {
                    hold val = val * 10 + (c2 - 48)
                    hold pos = pos + 1
                } otherwise {
                    hold pos = src_len
                }
            }
            push(tokens, TOK_NUMBER)
            push(num_vals, val)
        } otherwise {
            when is_alpha(c) == 1 {
                when c == 115 { push(tokens, TOK_SHOW) } otherwise {
                    when c == 104 { push(tokens, TOK_HOLD) } otherwise {
                        when c == 103 { push(tokens, TOK_GIVE) } otherwise {
                            when c == 119 { push(tokens, TOK_WHEN) } otherwise {
                                push(tokens, TOK_IDENT)
                            }
                        }
                    }
                }
                hold pos = pos + 1
                while pos < src_len {
                    hold c3 = source[pos]
                    when is_alpha(c3) == 1 {
                        hold pos = pos + 1
                    } otherwise {
                        hold pos = src_len
                    }
                }
            } otherwise {
                when c == 43 { push(tokens, TOK_PLUS) hold pos = pos + 1 } otherwise {
                    when c == 45 { push(tokens, TOK_MINUS) hold pos = pos + 1 } otherwise {
                        when c == 42 { push(tokens, TOK_STAR) hold pos = pos + 1 } otherwise {
                            when c == 47 { push(tokens, TOK_SLASH) hold pos = pos + 1 } otherwise {
                                hold pos = pos + 1
                            }
                        }
                    }
                }
            }
        }
    }
}
push(tokens, TOK_EOF)

show "Token count:"
show len(tokens)

hold nval = 0
when len(num_vals) > 0 {
    hold nval = num_vals[0]
} otherwise {
    hold nval = 0
}

hold p1 = "// Generated by Sayanox Stage-1 self-host compiler\n"
hold p2 = concat(p1, "#include <stdio.h>\n")
hold p3 = concat(p2, "int main(void) {\n")
hold p4 = concat(p3, "    printf(\"%g\\n\", ")
hold p5 = concat(p4, str(nval))
hold p6 = concat(p5, ");\n")
hold p7 = concat(p6, "    return 0;\n}\n")

write_file(output_path, p7)
show "Wrote output:"
show output_path

hold mark = concat("stage1_ok n=", str(nval))
write_file("selfhost/stage1_ok.txt", mark)
show "Stage-1 compile finished"
