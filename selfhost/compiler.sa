// Sayanox Stage-3 compiler entry — written in Sayanox.
// Full self-host path: Stage-2 lowers this file to a native binary.
// The compiler now owns small lowering boundaries for primitive constants
// and simple binary expressions. Native CPU instruction selection is not here.

show 3

hold input_path = "selfhost/hello.sa"
hold source = read_file(input_path)
hold source_len = len(source)
hold pos = 0
hold token_count = 0
hold value = 0
hold seen = 0
hold left_value = 0
hold right_value = 0
hold expression_seen = 0
hold operator = 0
hold expression_part = 0

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

// Sayanox-owned primitive lowering: canonical backend expression.
make lower_number(number) {
  give str(number)
}

// Sayanox-owned binary-expression lowering. This is deliberately backend
// neutral: it lowers syntax into a canonical expression before C emission.
make lower_binary(left, op, right) {
  hold out = lower_number(left)
  when op == 43 {
    hold out = concat(out, " + ")
  } otherwise {
    when op == 45 {
      hold out = concat(out, " - ")
    } otherwise {
      when op == 42 {
        hold out = concat(out, " * ")
      } otherwise {
        when op == 47 {
          hold out = concat(out, " / ")
        } otherwise {
          hold out = concat(out, " ? ")
        }
      }
    }
  }
  hold out = concat(out, lower_number(right))
  give out
}

while pos < source_len {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < source_len {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      when expression_part == 0 {
        hold left_value = value
        hold expression_part = 1
      } otherwise {
        hold right_value = value
        hold expression_part = 2
      }
      hold seen = 1
      hold token_count = token_count + 1
    } otherwise {
      when ch == 43 {
        hold operator = ch
        hold expression_seen = 1
        hold pos = pos + 1
        hold token_count = token_count + 1
      } otherwise {
        when ch == 45 {
          hold operator = ch
          hold expression_seen = 1
          hold pos = pos + 1
          hold token_count = token_count + 1
        } otherwise {
          when ch == 42 {
            hold operator = ch
            hold expression_seen = 1
            hold pos = pos + 1
            hold token_count = token_count + 1
          } otherwise {
            when ch == 47 {
              hold operator = ch
              hold expression_seen = 1
              hold pos = pos + 1
              hold token_count = token_count + 1
            } otherwise {
              hold pos = pos + 1
              hold token_count = token_count + 1
            }
          }
        }
      }
    }
  }
}

when seen {
  when expression_seen == 1 {
    when expression_part == 2 {
      hold lowered_value = lower_binary(left_value, operator, right_value)
      hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)("
      hold out = concat(out, lowered_value)
      hold out = concat(out, "));\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show right_value
      show token_count
    } otherwise {
      hold lowered_value = lower_number(value)
      hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
      hold out = concat(out, lowered_value)
      hold out = concat(out, ");\n  return 0;\n}\n")
      hold w = write_file("selfhost/hello_out.c", out)
      show value
      show token_count
    }
  } otherwise {
    hold lowered_value = lower_number(value)
    hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
    hold out = concat(out, lowered_value)
    hold out = concat(out, ");\n  return 0;\n}\n")
    hold w = write_file("selfhost/hello_out.c", out)
    show value
    show token_count
  }
} otherwise {
  show 0
}
