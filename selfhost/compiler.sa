// Stage-1 self-host compiler (generic Stage-2 path)
// Emits hello_out.c that prints the real number found in hello.sa
show "=== Sayanox Stage-1 ==="

hold source = read_file("selfhost/hello.sa")
hold src_len = len(source)
hold num_vals = []
hold pos = 0

make is_digit(c) {
    when c >= 48 {
        when c <= 57 { give 1 } otherwise { give 0 }
    } otherwise { give 0 }
}
make is_space(c) {
    when c == 32 { give 1 } otherwise {
        when c == 9 { give 1 } otherwise {
            when c == 10 { give 1 } otherwise {
                when c == 13 { give 1 } otherwise { give 0 }
            }
        }
    }
}

while pos < src_len {
    hold c = source[pos]
    when is_space(c) == 1 {
        hold pos = pos + 1
    } otherwise {
        when is_digit(c) == 1 {
            hold val = c - 48
            hold pos = pos + 1
            while pos < src_len {
                hold c2 = source[pos]
                when is_digit(c2) == 1 {
                    hold val = val * 10 + (c2 - 48)
                    hold pos = pos + 1
                } otherwise {
                    hold pos = src_len
                }
            }
            push(num_vals, val)
        } otherwise {
            hold pos = pos + 1
        }
    }
}

hold nval = 0
when len(num_vals) > 0 {
    hold nval = num_vals[0]
} otherwise {
    hold nval = 0
}

// Build C source: printf("%g\n", <nval>);
hold p1 = "#include <stdio.h>\nint main(void){ printf(\"%g\\n\", "
hold out = concat(p1, str(nval))
hold p2 = "); return 0; }\n"
hold out = concat(out, p2)
write_file("selfhost/hello_out.c", out)
show "Stage1: wrote hello_out.c"
show nval

hold tpl = read_file("selfhost/stage2_template.c")
write_file("selfhost/stage2_cc.c", tpl)
show "Stage1: emitted stage2_cc.c"
show "Stage1 finished"
