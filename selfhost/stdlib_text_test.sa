// Whole CSV documents: multiline fields, blank rows, edits and malformed data.
hold table = ct_parse("name,note\r\na,\"line1\nline2\"\r\nb,\"a,b\"\r\n")
show ct_valid(table)
show ct_row_count(table)
show ct_columns(table, 0)
show ct_cell(table, 1, 0)
show len(ct_cell(table, 1, 1))
show ct_cell(table, 2, 1)
hold table2 = ct_set(table, 1, 1, "changed, quoted")
show ct_cell(table2, 1, 1)
show len(ct_cell(table, 1, 1))
show ct_row_count(ct_parse(ct_write(table2)))
show ct_cell(ct_parse(ct_write(table2)), 1, 1)
show ct_row_count(ct_parse(""))
show ct_row_count(ct_parse("\n"))
show ct_columns(ct_parse("\n"), 0)
show ct_row_count(ct_parse("a\n\nb\n"))
show ct_columns(ct_parse("a\n\nb\n"), 1)
show ct_row_count(ct_parse("a\r\nb"))
show ct_row_count(ct_parse("a\rb"))
show ct_row_count(ct_parse("a,\"bad"))
show ct_row_count(ct_parse("a,\"b\"x"))
show ct_row_count(ct_parse("a\"b,c"))
show ct_row_count("!")
show ct_valid("01:a")
show ct_valid("4:1:a")
show ct_valid("2:0:")
show ct_row_count(ct_parse(ct_write(ct_parse("\n"))))
show ct_valid(ct_set(table, 9, 0, "x"))
show ct_valid(ct_set(table, 0, 9, "x"))
show ct_valid(ct_set(table, 0.5, 0, "x"))
show ct_row_count(ct_append(table, csv_parse_row("x,y")))
show ct_cell(ct_append(table, csv_parse_row("x,y")), 3, 1)
// Preserve final empty records and reserve the error marker.
show ct_row_count(ct_parse(ct_write(ct_parse("a\n\n"))))
show ct_row_count(ct_parse(ct_write(ct_parse("\n\n"))))
show ct_write(ct_parse("!"))
show ct_cell(ct_parse(ct_write(ct_parse("!"))), 0, 0)
show ct_valid(ct_parse("\"x\"\"y\",z"))
show ct_cell(ct_parse("\"x\"\"y\",z"), 0, 0)
show ct_valid(ct_parse("\"a\rb\",z"))
show ct_valid(ct_parse("\"a\r\nb\",z"))
// Header lookup, filtering and ordered column projections.
show ct_header_index(table, "note")
show ct_header_index(table, "missing")
show ct_header_index(ct_parse("x,x"), "x")
hold filtered = ct_filter_eq(table, 0, "a", 1)
show ct_row_count(filtered)
show ct_cell(filtered, 0, 0)
show ct_cell(filtered, 1, 0)
show ct_row_count(ct_filter_eq(table, 0, "name", 0))
show ct_row_count(ct_filter_eq(ct_parse("h,x\na\nb,"), 1, "", 1))
show ct_valid(ct_filter_eq(table, 0, "a", 2))
hold projected = ct_select(table, [1, 0, 1])
show ct_columns(projected, 0)
show ct_cell(projected, 0, 0)
show ct_cell(projected, 0, 1)
show ct_cell(projected, 2, 2)
show ct_valid(ct_select(table, []))
show ct_valid(ct_select(table, [0, 2]))
show ct_valid(ct_select(table, [0.5]))
show ct_row_count(ct_select("", [0]))
// Structural round trips and malformed packed frame controls.
show string_eq(ct_parse(ct_write(table)), table)
show string_eq(ct_parse(ct_write(ct_parse("a\n\n"))), ct_parse("a\n\n"))
show string_eq(ct_parse(ct_write(ct_parse("\"a\r\nb\",\"x\"\"y\""))), ct_parse("\"a\r\nb\",\"x\"\"y\""))
show ct_valid("0:")
show ct_valid("2:01")
show ct_valid("9999999999999999999999999:a")
show ct_valid("2:0:")
show ct_columns(table, 3)
show len(ct_cell(table, 0, 1.5))
show ct_valid(ct_append("!", csv_parse_row("a")))
// Row and field caps: exact boundary accepted, next item refused.
hold many_rows = ""
hold cap_i = 0
while cap_i < 1024 {
  hold many_rows = concat(many_rows, "a\n")
  hold cap_i = cap_i + 1
}
show ct_row_count(ct_parse(many_rows))
show ct_valid(ct_parse(concat(many_rows, "a")))
hold many_cols = "x"
hold cap_j = 1
while cap_j < 1024 {
  hold many_cols = concat(many_cols, ",x")
  hold cap_j = cap_j + 1
}
show ct_columns(ct_parse(many_cols), 0)
show ct_valid(ct_parse(concat(many_cols, ",x")))
show "csv-table-ok"

// Exact aggregation, stable deduplication and joins with duplicate keys.
hold sales = ct_parse("team,amount\nred,0.1\nblue,9007199254740993\nred,0.2\nblue,-1\n")
show cq_sum(sales, 1, 1)
hold grouped = cq_group_sum(sales, 0, 1, 1)
show ct_row_count(grouped)
show ct_cell(grouped, 0, 0)
show ct_cell(grouped, 0, 1)
show ct_cell(grouped, 1, 0)
show ct_cell(grouped, 1, 1)
show ct_cell(grouped, 2, 0)
show ct_cell(grouped, 2, 1)
hold distinct = cq_distinct(sales, 0, 1)
show ct_row_count(distinct)
show ct_cell(distinct, 1, 0)
show ct_cell(distinct, 2, 0)
show len(cq_sum(ct_parse("x\nbad"), 0, 1))
show len(cq_sum(ct_parse("x,y\na"), 1, 1))
show cq_sum("", 0, 0)
show ct_valid(cq_group_sum(ct_parse("x,y\na,bad"), 0, 1, 1))
show ct_valid(cq_group_sum(ct_parse("x,y\na"), 0, 1, 1))
show ct_valid(cq_distinct(ct_parse("a,b\nx"), 1, 1))
// Left-major order, duplicate keys, and a row without its join key.
hold left_table = ct_parse("id,left\na,L1\nb,L2\na,L3\n")
hold right_table = ct_parse("id,right\na,R1\na,R2\nc,R3\n")
hold joined = cq_join(left_table, right_table, 0, 0, 1)
show ct_row_count(joined)
show ct_columns(joined, 0)
show ct_cell(joined, 1, 1)
show ct_cell(joined, 1, 3)
show ct_cell(joined, 2, 3)
show ct_cell(joined, 3, 1)
show ct_cell(joined, 4, 3)
show ct_row_count(cq_join(ct_parse("a\nb"), ct_parse("a\na"), 0, 0, 0))
show ct_row_count(cq_join(ct_parse("x"), ct_parse("y"), 0, 0, 0))
show ct_valid(cq_join("", right_table, 0, 0, 1))
show ct_valid(cq_join(left_table, right_table, 2, 0, 1))
show ct_valid(cq_join(left_table, right_table, 0, 0, 2))
show ct_row_count(sales)
// Stable lexical sorting, header preservation, ties and malformed controls.
hold unsorted = ct_parse("key,id\nb,1\na,2\nb,3\naa,4")
hold sorted = cq_sort(unsorted, 0, 0, 1)
show ct_row_count(sorted)
show ct_cell(sorted, 0, 0)
show ct_cell(sorted, 1, 0)
show ct_cell(sorted, 2, 0)
show ct_cell(sorted, 3, 1)
show ct_cell(sorted, 4, 1)
hold descending = cq_sort(unsorted, 0, 1, 1)
show ct_cell(descending, 1, 1)
show ct_cell(descending, 2, 1)
show ct_cell(descending, 3, 0)
show ct_valid(cq_sort(ct_parse("x,y\na"), 1, 0, 1))
show ct_valid(cq_sort(unsorted, 0, 2, 1))
show cq_compare_bytes("a", "aa")
show cq_compare_bytes("b", "aa")
show cq_compare_bytes("same", "same")
// Empty keys, missing columns, malformed decimals, and unchanged inputs.
hold empty_keys = ct_parse("key,value\n,0.1\n,0.2\nx,1")
show ct_row_count(cq_group_sum(empty_keys, 0, 1, 1))
show ct_cell(cq_group_sum(empty_keys, 0, 1, 1), 1, 1)
show ct_valid(cq_group_sum(ct_parse("a,b\nx,1e2"), 0, 1, 1))
show ct_valid(cq_group_sum("", 0, 1, 1))
show ct_row_count(cq_group_sum("", 0, 1, 0))
show ct_row_count(cq_distinct("", 0, 1))
show ct_valid(cq_distinct("!", 0, 0))
show len(cq_sum(sales, 1, 2))
show ct_valid(cq_join(ct_parse("a,b\nx"), ct_parse("z,q\nr"), 1, 1, 0))
show ct_row_count(cq_join(ct_parse("a,b\nx"), ct_parse("z,q\nr"), 1, 1, 0))
show ct_row_count(unsorted)
show ct_cell(unsorted, 1, 1)
show string_eq(ct_parse(ct_write(grouped)), grouped)
show string_eq(ct_parse(ct_write(joined)), joined)
// Join must refuse expansion beyond the 1024-row cap.
hold repeated = ""
hold join_i = 0
while join_i < 33 {
  hold repeated = concat(repeated, "x\n")
  hold join_i = join_i + 1
}
show ct_valid(cq_join(ct_parse(repeated), ct_parse(repeated), 0, 0, 0))
// Decimal mean is rounded explicitly and never converts through num.
show cq_mean(ct_parse("v\n0.1\n0.2"), 0, 1, 2)
show cq_mean(ct_parse("v\n1\n0\n0"), 0, 1, 4)
show cq_mean(ct_parse("v\n-1\n0"), 0, 1, 0)
show len(cq_mean(ct_parse("v"), 0, 1, 2))
show len(cq_mean(ct_parse("v\nx"), 0, 1, 2))
show len(cq_mean(ct_parse("v\n1"), 0, 1, 1.5))
// Overflowing exact sums are refused, never rounded or silently skipped.
show len(cq_sum(ct_parse("v\n9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999\n1"), 0, 1))
show ct_valid(cq_group_sum(ct_parse("k,v\na,9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999\na,1"), 0, 1, 1))
show len(cq_mean(ct_parse("v\n9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999\n1"), 0, 1, 2))
show "csv-query-ok"
