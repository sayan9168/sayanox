// a key holding a closing bracket is refused
hold doc = ""
hold doc = concat(doc, concat("[a]", chr(10)))
hold doc = concat(doc, concat("k] = v", chr(10)))
show ini_valid(doc)
hold bad = ini_parse(doc)
show len(bad)
show sh_sum_bytes(bad)

// a bracket in a key is refused before the value is read
