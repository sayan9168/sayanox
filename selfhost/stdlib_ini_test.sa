// ---- the caps, pinned at both boundaries ----
// ini_max_bytes() is 65536 and len() counts bytes, so a value spelled in
// UTF-8 costs several bytes to the cap and one character to a reader.  The
// other cap lives one layer down, in the csv_table rows a table can hold
// (1,024, header row included), and ini_parse reports a refusal rather than
// a truncated table when either one is crossed.  Only the byte cap can be
// pinned at its boundary here: reaching the row cap needs a document of
// 1,023 members, and ini_parse costs each member a scan of the table it has
// built so far, which the table-as-a-string representation copies as it
// walks -- measured 0.5 s at 32 members, 3.6 s at 64 and 26 s at 128, so a
// cap-sized document never finishes inside the gate's budget.  The row cap
// is pinned where it is imposed, by selfhost/stdlib_csv_table.want, and the
// defect is recorded in docs/REMAINING_WORK.md; ini keeps the largest
// many-member document the four backends can chew at 32 members, generated
// with distinct keys because a repeated key in one section is itself a
// refusal, so 32 copies of `k = v` would pin nothing.
hold cafe = concat("k = caf", concat(chr(195), chr(169)))
show len(cafe)
show ut_len(cafe)
hold at_rows = ""
hold n = 0
while n < 32 {
  hold q = (n - (n % 26)) / 26
  hold key = concat("k", concat(chr(97 + (n % 26)), concat(chr(97 + (q % 26)), chr(97 + ((q - (q % 26)) / 26)))))
  at_rows = concat(at_rows, concat(key, concat(" = v", chr(10))))
  hold n = n + 1
}
show len(at_rows)
show ini_valid(at_rows)
show ini_count(ini_parse(at_rows))
show ini_round_trips(at_rows)
// ini_max_bytes(): a document of exactly 65536 bytes is accepted and one byte
// more is refused.  The member line comes first and the padding is one run of
// chr(59) bytes with no newline after it, so the padding is a comment line and
// the only difference between the two documents is the byte the cap counts.
// The run is doubled up from a single byte, adding another wherever the binary
// expansion of 65,530 asks for it: one variable, no clamp, and no intermediate
// over 64 KiB -- csv_sub over a string that long copies it once per byte, which
// is what this avoids.
hold pad = ";"
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
pad = concat(pad, pad)
pad = concat(pad, ";")
pad = concat(pad, pad)
hold at_bytes = concat(concat("k = v", chr(10)), pad)
show len(at_bytes)
show ini_valid(at_bytes)
show ini_count(ini_parse(at_bytes))
show ini_round_trips(at_bytes)
hold over_bytes = at_bytes
over_bytes = concat(over_bytes, "x")
show len(over_bytes)
show ini_valid(over_bytes)
show len(ini_parse(over_bytes))
