// Independent INI / TOML-lite configuration oracle for stdlib/ini.sa.  Every
// expected number below was computed by a Python model written from the rule
// text in that module's header comment; Sayanox was never consulted for an
// expectation.  Accepted documents were additionally re-parsed with Python's
// configparser, and the two rule sets differ only where stdlib/ini.sa
// documents a deliberate divergence.  Runs on seed-min, gen2, native_aot and
// gen1_min through ./sx target test-stdlib-next.
//
// This is the first of two halves: selfhost/stdlib_ini_write_test.sa carries the
// writer's mutations.  Bounded native_aot gives a program one variable slot per
// top-level name and one patch slot per call site, and the single fixture passed
// neither limit, so the same checks are cut at a block boundary.
//
// A value is pinned as (byte length, byte sum) and never as printed text: a
// configuration value may hold any byte, and this dialect has no escape for a
// quote or a backslash inside a string literal and no multi-line literal, so
// every document below is assembled with chr() one line at a time.
//
// The pair of this file and selfhost/stdlib_ini.want is the artifact: every value
// in the .want was computed from the rules above by a host-side model, and the
// model was then run against Python's configparser for the accepted documents.
// Nothing here was copied out of a Sayanox run, and a change to the module must be
// re-derived through the rules rather than re-pinned from whatever it prints.
use "stdlib/csv.sa"
use "stdlib/csv_table.sa"
use "stdlib/hash.sa"
use "stdlib/ini.sa"
use "stdlib/utf8.sa"
use "stdlib/utext.sa"

hold fail = 0

// ---- documents: acceptance and refusal, rule by rule ----

// a comment, blanks and one member
hold doc = ""
hold doc = concat(doc, concat("[a]", chr(10)))
hold doc = concat(doc, concat("k = v", chr(10)))
show ini_valid(doc)
hold t = ini_parse(doc)
show ini_count(t)
show ini_empty(t)
show ini_section_count(t)
show ini_has(t, "a", "k")
show ini_find(t, "a", "k")
show len(ini_value(t, "a", "k"))
show sh_sum_bytes(ini_value(t, "a", "k"))
show len(ini_section_at(t, 0))
show sh_sum_bytes(ini_section_at(t, 0))
show len(ini_section_at(t, 1))
show sh_sum_bytes(ini_section_at(t, 1))
show len(ini_section_at(t, 2))
show sh_sum_bytes(ini_section_at(t, 2))
show ini_key_count(t, "")
show ini_key_count(t, "a")
show len(ini_key_at(t, "a", 0))
show sh_sum_bytes(ini_key_at(t, "a", 0))
show len(ini_write(t))
show sh_sum_bytes(ini_write(t))
show ini_round_trips(doc)
show ini_valid(ini_write(t))
hold again = ini_parse(ini_write(t))
show ini_count(again)
show len(ini_value(again, "a", "k"))
show sh_sum_bytes(ini_value(again, "a", "k"))

// hash comments and CRLF
hold doc = ""
hold doc = concat(doc, concat(concat("# one", chr(13)), chr(10)))
hold doc = concat(doc, concat(concat("[a]", chr(13)), chr(10)))
hold doc = concat(doc, concat(concat("k = v", chr(13)), chr(10)))
