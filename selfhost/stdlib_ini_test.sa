show ini_section_count(t)
show ini_has(t, "a", "k")
show ini_find(t, "a", "k")
show len(ini_value(t, "a", "k"))
show sh_sum_bytes(ini_value(t, "a", "k"))
show len(ini_section_at(t, 0))
show sh_sum_bytes(ini_section_at(t, 0))
show len(ini_section_at(t, 1))
show sh_sum_bytes(ini_section_at(t, 1))
show len(ini_section_at(t, 2))
show sh_sum_bytes(ini_section_at(t, 2))
show ini_key_count(t, "")
show ini_key_count(t, "a")
show len(ini_key_at(t, "a", 0))
show sh_sum_bytes(ini_key_at(t, "a", 0))
show len(ini_write(t))
show sh_sum_bytes(ini_write(t))
show ini_round_trips(doc)
show ini_valid(ini_write(t))
hold again = ini_parse(ini_write(t))
show ini_count(again)
show len(ini_value(again, "a", "k"))
show sh_sum_bytes(ini_value(again, "a", "k"))

