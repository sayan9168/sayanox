// Three stdlib modules, one fixture: num_util (untyped numeric helpers),
// list_algo (typed list algorithms) and str_text (typed text helpers).
//
// Every value below is hand-computed; seed-min, gen2 and native must print
// identical bytes (make test-stdlib-modules). The order of the `show` lines is
// the order of the expected output in that target.
use "stdlib/num_util.sa"
use "stdlib/list_algo.sa"
use "stdlib/str_text.sa"

// ---- num_util: truncation is `x % 1e15`, the dialect's only double->int ----
show nu_trunc(2.75)
show nu_trunc(0 - 2.75)
show nu_floor(2.75)
show nu_floor(0 - 2.25)
show nu_floor(3)
show nu_ceil(2.25)
show nu_ceil(0 - 2.75)
show nu_ceil(3)
show nu_round(2.5)
show nu_round(2.4)
show nu_round(0 - 2.5)
show nu_frac(2.25)
show nu_frac(0 - 2.25)
show nu_min(3, 7)
show nu_max(3, 7)
show nu_mod_pos(0 - 7, 3)
show nu_mod_pos(7, 3)
show nu_int_div(7, 2)
show nu_int_div(0 - 7, 2)
show nu_wrap(0 - 1, 3)
show nu_wrap(7, 3)
show nu_map_range(5, 0, 10, 100, 200)
show nu_map_range(3, 5, 5, 1, 2)
show nu_avg(3, 4)
show nu_median3(1, 3, 2)
show nu_deg2rad(180)
hold pi = nu_pi()
show nu_rad2deg(pi)
show nu_turn(0 - 90.5)
show nu_turn(361)

// ---- list_algo: every transform returns a new list ----
hold xs = [3, 1, 4, 1, 5]
hold sorted = la_sort(xs)
show len(sorted)
show sorted[0]
show sorted[1]
show sorted[2]
show sorted[3]
show sorted[4]
show la_sorted(xs)
show la_sorted(sorted)
show len(xs)
show la_index_of(xs, 4)
show la_index_of(xs, 1)
show la_index_of(xs, 9)
hold pair = [1, 2]
hold single = [3]
hold joined = la_append(pair, single)
show len(joined)
show joined[2]
hold mid = la_slice(xs, 1, 3)
show len(mid)
show mid[0]
show mid[2]
hold tail = la_slice(xs, 3, 99)
show len(tail)
hold taken = la_take(xs, 2)
show taken[1]
hold dropped = la_drop(xs, 3)
show dropped[0]
hold trio = [1, 2, 3]
hold running = la_cumsum(trio)
show running[0]
show running[1]
show running[2]
hold copies = la_repeat(7, 3)
show len(copies)
show copies[2]
hold scaled = la_scale(trio, 2)
show scaled[2]
hold shifted = la_offset(trio, 10)
show shifted[0]
hold tens = [10, 20]
hold zipped = la_zip_add(trio, tens)
show len(zipped)
show zipped[1]
show la_count_gt(xs, 1)
hold cut = la_remove_at(xs, 1)
show len(cut)
show cut[1]
hold inserted = la_insert_at(xs, 1, 9)
show len(inserted)
show inserted[1]
hold appended = la_insert_at(xs, 99, 9)
show len(appended)
show appended[5]
hold unique = la_distinct(xs)
show len(unique)
show unique[3]

// ---- str_text: byte-oriented text helpers ----
show t_index_of("banana", 97)
show t_last_index_of("banana", 97)
show t_index_of("banana", 122)
show t_slice("hello", 1, 3)
show t_slice("hello", 3, 99)
show t_slice("hello", 9, 2)
show t_trim("  ab  ")
show t_trim_left("  ab  ")
show t_trim_right("  ab  ")
show t_trim("   ")
show t_cmp("abc", "abd")
show t_cmp("abc", "ab")
show t_cmp("ab", "ab")
show t_is_digits("42")
show t_is_digits("4a")
show t_is_digits("")
show t_pad_left("7", 3, 48)
show t_pad_right("7", 3, 46)
show t_pad_left("1234", 2, 48)
show t_word_count("  a  bb ")
show t_word_count("")
show t_replace("abc", 98, 122)
show t_remove("a-b-c", 45)
show t_hash("")
show t_hash("a")
show t_hash("ab")
show t_parse_uint("42px")
show t_parse_uint("x42")
show t_uint_str(1234)
show t_uint_str(0)
show t_uint_str(7)
show "modules-done"
