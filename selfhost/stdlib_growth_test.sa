// make test-stdlib-growth: the 2026-10-10 additions to stdlib/tiny.sa.
// Expected values are hand-computed; the Makefile target also requires
// seed-min, gen2 and native to print the same bytes.
use "stdlib/tiny.sa"
show tri(10)
show tri(0)
show tri(0 - 3)
show min3(5, 2, 9)
show max3(5, 2, 9)
show min3(0 - 1, 0, 0 - 7)
show ceil_div(7, 2)
show ceil_div(8, 2)
show ceil_div(0, 5)
show ceil_div(1, 5)
show pow_mod(2, 10, 1000)
show pow_mod(3, 4, 5)
show pow_mod(7, 0, 13)
show collatz_steps(1)
show collatz_steps(6)
show collatz_steps(7)
show digit_at(12345, 0)
show digit_at(12345, 4)
show digit_at(12345, 2)
show digit_at(7, 3)
show is_palindrome(12321)
show is_palindrome(12345)
show is_palindrome(1200)
show is_palindrome(7)
show isqrt(0)
show isqrt(15)
show isqrt(16)
show isqrt(17)
show isqrt(1000000)
