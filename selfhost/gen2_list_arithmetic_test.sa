make identity<T>(xs: T) -> T {
  give xs
}
make first(xs: list) -> num {
  give xs[0]
}
make fresh(xs: list) -> num {
  push(xs, 99)
  give len(xs)
}
hold xs = identity([1 + 2 * 3, (1 + 2) * 3, 8 / 3, 08 + 09, -(-2), 10 - 3 - 2, 16 / 4 / 2, 1.5 * (2 + 2)])
show xs[0]
show xs[1]
show xs[2]
show xs[3]
show xs[4]
show xs[5]
show xs[6]
show xs[7]
show first([-(2 + 3) * 4])
show first([1 - -2])
show first([1 + 2, (3 * 4)])
show len(push([1 + 2], 4))
hold count = 0
while fresh([1 + 2]) == 2 {
  count = count + 1
  when count == 3 {
    break
  }
}
show count
show "[1 + 2] stays text"
make givefirst() -> num {
  give first([(1 + 2) * 3 / 2])
}
show givefirst()
when first([(1 + 2) * 3 / 2]) == 4.5 {
  show 7
}
hold divided = 0
while first([8 / 4]) == 2 {
  divided = divided + 1
  break
}
show divided
