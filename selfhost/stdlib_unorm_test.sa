// Frozen independent expectations; do not edit by hand.
// Unicode module group: unorm (UAX #15 canonical NFC/NFD).
// Layer 1 is the official Unicode 17.0.0 NormalizationTest.txt
// conformance file: all 20034 cases, read at run time from
// selfhost/stdlib_unorm_cases.txt (source|nfc|nfd, decimal code
// points) so the compiler never has to chew a 588 KB literal.
// Layer 2 checks the whole module API -- the tables, the list functions,
// the string functions, the predicates, the canonical-equivalence test,
// the failure contract and the Hangul arithmetic -- against an
// independent Python reference that reproduces every column of all
// 20034 official rows before any expectation is frozen. The generator is
// a host-side tool and is not tracked; the .want bytes are the oracle.

use "stdlib/utf8.sa"
use "stdlib/unorm.sa"

make fx_i(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_csv(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    hold piece = fx_i(xs[i])
    when i > 0 {
      out = concat(out, ",")
    }
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num(tag: str, v: num) -> num {
  hold line = concat(tag, fx_i(v))
  show line
  give 0
}

// The text form of a code point list: a leading bar, then the decimal CSV, so
// an empty list still prints one visible character.
make fx_text(xs: list) -> str {
  hold body = fx_csv(xs)
  give concat("|", body)
}

// Layer 1: replay every row of the payload through the real module in one
// pass. Reading the data file at run time keeps the compiler out of it: as a
// literal the same bytes cost minutes of gen2 and seed-min build time for no
// extra coverage. Row format: source|nfc|nfd, decimal code points.
make fx_conformance() -> num {
  hold text = read_file("selfhost/stdlib_unorm_cases.txt")
  hold n = len(text)
  hold i = 0
  hold src = []
  hold want_nfc = []
  hold want_nfd = []
  hold phase = 0
  hold v = 0
  hold innum = 0
  hold cases = 0
  hold nfail = 0
  hold dfail = 0
  while i < n {
    hold ch = sx_index(text, i)
    hold stop = 0
    when ch == 44 {
      stop = 1
    }
    when ch == 124 {
      stop = 2
    }
    when ch == 10 {
      stop = 3
    }
    when stop != 0 {
      when innum == 1 {
        when phase == 0 {
          src = push(src, v)
        }
        when phase == 1 {
          want_nfc = push(want_nfc, v)
        }
        when phase == 2 {
          want_nfd = push(want_nfd, v)
        }
        v = 0
        innum = 0
      }
      when stop == 2 {
        phase = phase + 1
      }
      when stop == 3 {
        cases = cases + 1
        when un_lists_equal(un_nfc_list(src), want_nfc) == 0 {
          nfail = nfail + 1
        }
        when un_lists_equal(un_nfd_list(src), want_nfd) == 0 {
          dfail = dfail + 1
        }
        src = []
        want_nfc = []
        want_nfd = []
        phase = 0
      }
    } otherwise {
      v = v * 10 + (ch - 48)
      innum = 1
    }
    i = i + 1
  }
  hold a = fx_num("cases: ", cases)
  hold b = fx_num("nfc failures: ", nfail)
  hold c = fx_num("nfd failures: ", dfail)
  give cases
}

  hold text = fx_conformance()
  hold z = fx_num("cases ", text)
  hold s0 = u8_from([7690])
