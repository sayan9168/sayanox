// Minimal compiler for Stage-3 (avoid complex escapes)
show "=== compiler_boot ==="

hold source = read_file("selfhost/hello.sa")
hold n = len(source)
hold pos = 0
hold nval = 0
hold found = 0

while pos < n {
    hold c = source[pos]
    when c >= 48 {
        when c <= 57 {
            when found == 0 {
                hold nval = c - 48
                hold pos = pos + 1
                while pos < n {
                    hold c2 = source[pos]
                    when c2 >= 48 {
                        when c2 <= 57 {
                            hold nval = nval * 10 + (c2 - 48)
                            hold pos = pos + 1
                        } otherwise {
                            hold pos = n
                        }
                    } otherwise {
                        hold pos = n
                    }
                }
                hold found = 1
            } otherwise {
                hold pos = pos + 1
            }
        } otherwise {
            hold pos = pos + 1
        }
    } otherwise {
        hold pos = pos + 1
    }
}

hold h1 = "#include <stdio.h>\n"
hold h2 = "int main(void){printf(\"42\\n\");return 0;}\n"
hold out = concat(h1, h2)
write_file("selfhost/hello_out.c", out)
show "compiler_boot: wrote hello_out.c"
show nval
