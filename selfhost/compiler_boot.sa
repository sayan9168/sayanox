// Minimal compiler for Stage-3 — emits real nval via puts
show "=== compiler_boot ==="

hold source = read_file("selfhost/hello.sa")
hold n = len(source)
hold pos = 0
hold nval = 0
hold found = 0

while pos < n {
    hold c = source[pos]
    when c >= 48 {
        when c <= 57 {
            when found == 0 {
                hold nval = c - 48
                hold pos = pos + 1
                while pos < n {
                    hold c2 = source[pos]
                    when c2 >= 48 {
                        when c2 <= 57 {
                            hold nval = nval * 10 + (c2 - 48)
                            hold pos = pos + 1
                        } otherwise {
                            hold pos = n
                        }
                    } otherwise {
                        hold pos = n
                    }
                }
                hold found = 1
            } otherwise {
                hold pos = pos + 1
            }
        } otherwise {
            hold pos = pos + 1
        }
    } otherwise {
        hold pos = pos + 1
    }
}

show nval

// Reliable emit: puts("42") style — no %g inside Sayanox strings
hold a = "#include <stdio.h>\nint main(void){ puts("
hold b = str(nval)
hold c = "); return 0; }\n"
hold out = concat(a, b)
hold out = concat(out, c)
write_file("selfhost/hello_out.c", out)
show "compiler_boot: wrote hello_out.c"
