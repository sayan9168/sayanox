// ============================================================
// Sayanox Self-Hosting — Phase 4
// Tiny end-to-end pipeline: tokens → AST → C emit
// ============================================================

show "=== Self-Host Pipeline Phase 4 ==="

hold TOK_SHOW = 1
hold TOK_NUMBER = 11
hold TOK_EOF = 0
hold ST_SHOW = 1
hold EX_NUMBER = 10

hold tokens = []
push(tokens, TOK_SHOW)
push(tokens, TOK_NUMBER)
push(tokens, TOK_EOF)
hold num_vals = []
push(num_vals, 42)

hold kind = []
hold left = []
hold right = []
hold value = []
hold count = 0

make ast_new(k, l, r, v) {
    push(kind, k)
    push(left, l)
    push(right, r)
    push(value, v)
    hold id = count
    hold count = count + 1
    give id
}

hold num = ast_new(EX_NUMBER, -1, -1, num_vals[0])
hold sh = ast_new(ST_SHOW, num, -1, 0)

show "// Generated by pipeline"
show "#include <stdio.h>"
show "int main() {"
show "    printf(\"%g\\n\", "
show value[num]
show ");"
show "    return 0;"
show "}"

show "Pipeline Phase 4 done (tokens \u2192 AST \u2192 C)"
