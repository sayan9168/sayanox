// Frozen independent expectations; do not edit by hand.
// Unicode module group: utext.
// Expectations were computed outside Sayanox with Python's UTF-8 codec (whose
// errors="replace" implements the Unicode maximal-subpart rule) and the Unicode
// White_Space property, then pinned in the paired .want file. The generator is a
// host-side tool and is not tracked; the .want bytes are the oracle.
use "stdlib/utf8.sa"
use "stdlib/utext.sa"

make fx_num(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_bytes(bs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(bs) {
    hold piece = chr(bs[i])
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_list(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    when i > 0 {
      out = concat(out, ",")
    }
    hold item = fx_num(xs[i])
    out = concat(out, item)
    i = i + 1
  }
  give out
}

make fx_repeat(n: num) -> str {
  hold out = "a"
  hold total = 1
  while total * 2 <= n {
    out = concat(out, out)
    total = total * 2
  }
  while total < n {
    out = concat(out, "a")
    total = total + 1
  }
  give out
}

make fx_chr(b: num) -> str {
  give chr(b)
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num_say(tag: str, v: num) -> num {
  hold body = fx_num(v)
  give fx_say(tag, body)
}

