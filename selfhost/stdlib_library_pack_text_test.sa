// ---- text_wrap ----
make lp_sec_2() -> num {
show tw_normalize("")
show tw_wrap("", 5)
show tw_wrap_indent("", 5, ">> ")
show tw_normalize("hello world again")
show tw_wrap("hello world again", 7)
show tw_wrap_indent("hello world again", 7, ">> ")
show tw_normalize("a b c d")
show tw_wrap("a b c d", 1)
show tw_wrap_indent("a b c d", 1, ">> ")
show tw_normalize("supercalifragilistic expialidocious")
show tw_wrap("supercalifragilistic expialidocious", 5)
show tw_wrap_indent("supercalifragilistic expialidocious", 5, ">> ")
show tw_normalize("  many   spaces\t here \n")
show tw_wrap("  many   spaces\t here \n", 8)
show tw_wrap_indent("  many   spaces\t here \n", 8, ">> ")
show tw_normalize("one two three four five")
show tw_wrap("one two three four five", 10)
show tw_wrap_indent("one two three four five", 10, ">> ")
show tw_normalize("abcdefghij")
show tw_wrap("abcdefghij", 3)
show tw_wrap_indent("abcdefghij", 3, ">> ")
show tw_truncate("hello world", 8, "...")
show tw_truncate("hello", 10, "...")
show tw_truncate("hello", 2, "...")
show tw_truncate("hello", 3, "...")
show tw_truncate("", 0, "")
show tw_truncate("abc", 0, "")
show tw_wrap("abc", 0)
show tw_wrap_indent("abc", 2, "xx")
  give 0
}

make main_lp() -> num {
  hold call_1 = lp_sec_1()
  hold call_2 = lp_sec_2()
  show "library-pack-text-ok"
  give 0
}

hold run_lp = main_lp()
