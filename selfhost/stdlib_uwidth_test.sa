// Frozen independent expectations; do not edit by hand.
// Unicode module group: uwidth (terminal display width).
// Layer 1 sweeps every scalar code point through uw_cp_width and prints only the
// transitions, so all 1114112 code points are checked in about a thousand lines.
// Expectations were computed outside Sayanox by reading DerivedEastAsianWidth.txt
// and DerivedGeneralCategory.txt from the Unicode 17.0.0 UCD directly. The
// generator is a host-side tool and is not tracked; the .want bytes are the oracle.

use "stdlib/utf8.sa"
use "stdlib/uwidth.sa"

make fx_i(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_csv(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    when i > 0 {
      out = concat(out, ",")
    }
    hold piece = fx_i(xs[i])
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num(tag: str, v: num) -> num {
  hold body = fx_i(v)
  give fx_say(tag, body)
}

make fx_two(tag: str, body: str, v: num) -> num {
  hold n = fx_i(v)
  hold p = concat(body, " n=")
  hold q = concat(p, n)
  give fx_say(tag, q)
}


make sweep_emit(a: num, b: num, c: num) -> num {
  hold sa = fx_i(a)
  hold sb = fx_i(b)
  hold sc = fx_i(c)
  hold p1 = concat(sa, ",")
  hold p2 = concat(p1, sb)
  hold p3 = concat(p2, ",")
  hold line = concat(p3, sc)
  hold z = fx_say("width ", line)
  give 0
}

hold pstart = 0
hold prev = uw_cp_width(0)
hold pcp = 1
while pcp < 1114112 {
  when pcp == 55296 {
    pcp = 57344
  }
  hold w = uw_cp_width(pcp)
  when w != prev {
    hold e = pcp - 1
    hold z = sweep_emit(pstart, e, prev)
    pstart = pcp
    prev = w
  }
  pcp = pcp + 1
}
hold z = sweep_emit(pstart, 1114111, prev)


// ---- text API ----
