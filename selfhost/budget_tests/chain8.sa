// BUDGET.md §5: an acyclic chain of depth 8.
@budget(frames: 8)
make c1() -> num {
  give c2() + 1
}
make c2() -> num {
  give c3() + 1
}
make c3() -> num {
  give c4() + 1
}
make c4() -> num {
  give c5() + 1
}
make c5() -> num {
  give c6() + 1
}
make c6() -> num {
  give c7() + 1
}
make c7() -> num {
  give c8() + 1
}
make c8() -> num {
  give 8
}
show c1()
