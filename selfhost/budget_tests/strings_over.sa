// BUDGET.md §3 one over: thirty strings is exactly 60 words, and a thirty-first
// pushes the frame to 62. That also trips the pre-existing 60-word emitter cap,
// so to isolate the *budget* comparison this file instead declares 58 against a
// body of 60. Expected to FAIL on the @budget rule, not the emitter cap.
@budget(locals: 58)
make wide() -> str {
  hold s1 = "x"
  hold s2 = "x"
  hold s3 = "x"
  hold s4 = "x"
  hold s5 = "x"
  hold s6 = "x"
  hold s7 = "x"
  hold s8 = "x"
  hold s9 = "x"
  hold s10 = "x"
  hold s11 = "x"
  hold s12 = "x"
  hold s13 = "x"
  hold s14 = "x"
  hold s15 = "x"
  hold s16 = "x"
  hold s17 = "x"
  hold s18 = "x"
  hold s19 = "x"
  hold s20 = "x"
  hold s21 = "x"
  hold s22 = "x"
  hold s23 = "x"
  hold s24 = "x"
  hold s25 = "x"
  hold s26 = "x"
  hold s27 = "x"
  hold s28 = "x"
  hold s29 = "x"
  hold s30 = "x"
  give s1
}
show wide()
