// sayanoxc.sa — Sayanox compiler written in Sayanox (Stage-2 compatible)
// Compiles: show <number>  ->  C program that prints that number
//
// ./selfhost/sx selfhost/sayanoxc.sa --run
// clang -o selfhost/sayanoxc_out selfhost/sayanoxc_out.c && ./selfhost/sayanoxc_out

show "Sayanoxc: compiler in Sayanox"

hold in_path = "selfhost/hello.sa"
hold out_path = "selfhost/sayanoxc_out.c"
hold source = read_file(in_path)
hold n = len(source)
hold pos = 0
hold value = 0
hold seen_number = 0
hold ok = 1

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

// Scan source: last integer literal is the value to emit (hello.sa is "show 42")
while pos < n {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < n {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      hold seen_number = 1
    } otherwise {
      // letter or other — skip one char
      hold pos = pos + 1
    }
  }
}

when seen_number {
  hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
  hold out = concat(out, str(value))
  hold out = concat(out, ");\n  return 0;\n}\n")
  hold w = write_file(out_path, out)
  show "sayanoxc: wrote"
  show out_path
  show value
} otherwise {
  show "sayanoxc: no number found"
  hold ok = 0
}
