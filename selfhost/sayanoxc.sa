// sayanoxc.sa — Sayanox compiler written in Sayanox
// Input:  selfhost/hello.sa  (expects a number, e.g. show 42)
// Output: selfhost/sayanoxc_out.c
//
// ./selfhost/sx selfhost/sayanoxc.sa --run
// clang selfhost/sayanoxc_out.c -o selfhost/sayanoxc_out && ./selfhost/sayanoxc_out

show 1

hold source = read_file("selfhost/hello.sa")
hold n = len(source)
hold pos = 0
hold value = 0
hold seen_number = 0

make is_digit(c) {
  when c >= 48 {
    when c <= 57 { give 1 } otherwise { give 0 }
  } otherwise { give 0 }
}

make is_space(c) {
  when c == 32 { give 1 } otherwise {
    when c == 9 { give 1 } otherwise {
      when c == 10 { give 1 } otherwise {
        when c == 13 { give 1 } otherwise { give 0 }
      }
    }
  }
}

while pos < n {
  hold ch = source[pos]
  when is_space(ch) {
    hold pos = pos + 1
  } otherwise {
    when is_digit(ch) {
      hold value = 0
      hold scanning = 1
      while scanning {
        when pos < n {
          hold ch2 = source[pos]
          when is_digit(ch2) {
            hold value = value * 10 + (ch2 - 48)
            hold pos = pos + 1
          } otherwise {
            hold scanning = 0
          }
        } otherwise {
          hold scanning = 0
        }
      }
      hold seen_number = 1
    } otherwise {
      hold pos = pos + 1
    }
  }
}

when seen_number {
  hold out = "#include <stdio.h>\nint main(void){\n  printf(\"%g\\n\", (double)"
  hold out = concat(out, str(value))
  hold out = concat(out, ");\n  return 0;\n}\n")
  hold w = write_file("selfhost/sayanoxc_out.c", out)
  show value
} otherwise {
  show 0
}
