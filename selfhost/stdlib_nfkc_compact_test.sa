  hold z = fx_num("compat rows ", u8_div(len(un_compat_index()), 3))
  hold z = fx_num("compat pool ", len(un_compat_pool()))
  hold z = fx_num("compat index ", len(un_compat_index()))
  hold z = fx_num("is_nfkc ligature ", un_is_nfkc(u8_from([64257])))
  hold z = fx_num("is_nfkc folded ", un_is_nfkc(u8_from([102, 105])))
  hold z = fx_num("is_nfkc malformed ", un_is_nfkc(chr(255)))
  hold z = fx_num("is_nfkd composed ", un_is_nfkd(u8_from([233])))
  hold z = fx_num("is_nfkd decomposed ", un_is_nfkd(u8_from([101, 769])))
  hold z = fx_num("compat_equal 1 ", un_compat_equal(u8_from([64257]), u8_from([102, 105])))
  hold z = fx_num("compat_equal 2 ", un_compat_equal(u8_from([64257]), u8_from([102, 73])))
