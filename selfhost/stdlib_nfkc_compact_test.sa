// Frozen independent expectations; do not edit by hand.
// Unicode module group: unorm compatibility forms, bounded-backend companion.
// The same NFKC/NFKD rules as selfhost/stdlib_nfkc_test.sa, cut down to what
// native_aot's 64 globals and 64 locals allow, so no backend is blind to the
// compatibility layer. Every expectation comes from the official Unicode
// 17.0.0 NormalizationTest columns, read through the independent Python
// reference that reproduces all 20034 official rows first.

use "stdlib/utf8.sa"
use "stdlib/unorm.sa"

make fx_i(v: num) -> str {
  when v == 0 {
    give "0"
  }
  hold neg = 0
  hold x = v
  when x < 0 {
    neg = 1
    x = 0 - x
  }
  hold out = ""
  while x > 0 {
    hold d = x % 10
    hold digit = chr(48 + d)
    out = concat(digit, out)
    x = (x - d) / 10
  }
  when neg == 1 {
    out = concat("-", out)
  }
  give out
}

make fx_csv(xs: list) -> str {
  hold out = ""
  hold i = 0
  while i < len(xs) {
    hold piece = fx_i(xs[i])
    when i > 0 {
      out = concat(out, ",")
    }
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

make fx_say(tag: str, body: str) -> num {
  hold line = concat(tag, body)
  show line
  give 0
}

make fx_num(tag: str, v: num) -> num {
  hold line = concat(tag, fx_i(v))
  show line
  give 0
}

// A leading bar, then the decimal CSV, so an empty list still prints one
// visible character.
make fx_text(xs: list) -> str {
  hold body = fx_csv(xs)
  give concat("|", body)
}

  hold z = fx_say("nfkc 0 ", fx_text(un_nfkc_list([])))
  hold z = fx_say("nfkd 0 ", fx_text(un_nfkd_list([])))
