  hold z = fx_num("compat_equal 6 ", un_compat_equal(chr(255), u8_from([102])))
  hold z = fx_say("nfkc malformed ", un_nfkc(chr(255)))
  hold z = fx_say("nfkd malformed ", un_nfkd(chr(255)))
  hold z = fx_say("nfkc nul ", un_nfkc(u8_from([0])))
  hold z = fx_say("nfkc string ", un_nfkc(u8_from([64257, 65313, 178])))
  hold z = fx_say("nfkd string ", un_nfkd(u8_from([64257, 65313, 178])))
  hold z = fx_say("nfkc twice ", un_nfkc(un_nfkc(u8_from([64257, 65313, 178]))))
  hold z = fx_num("nfkc invalid_list ", len(un_nfkc_list([97, 1114112])))
  hold z = fx_num("nfkd invalid_list ", len(un_nfkd_list([1114112])))
  hold z = fx_num("max_bytes ", un_max_bytes())
  show "nfkc-compact-ok"
