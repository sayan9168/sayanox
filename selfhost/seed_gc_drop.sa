// Dropped temporaries, and live data held across the collections they cause.
//
// `scan` allocates one string per iteration and never keeps it: the
// assignment wrapper cannot free it, because nothing is being reassigned.
// That is exactly the garbage the seed used to accumulate until the process
// died. `tag` is a read-only parameter, so the seed borrows the caller's
// string instead of copying it, and the collector must keep a borrowed
// string alive. `keep` is a 512 KiB string that the loop never touches: it
// is reachable only from the frame below, so it survives only if the root
// scan really walks the whole stack. Nothing here moves, so every pointer
// stays valid.
//
// `auto` on line four is the point: gc_runs() is already non-zero before the
// explicit gc(), so the runtime collected without being asked.
//
// All three backends print the same seven lines.

make scan(tag: str, n: num) -> num {
  hold acc = 0
  hold i = 0
  while i < n {
    hold acc = acc + len(concat("drop", "ped"))
    hold acc = acc + sx_index(tag, 0)
    hold i = i + 1
  }
  give acc
}

hold keep = "abcdefghijklmnop"
hold d = 0
while d < 15 {
  hold keep = concat(keep, keep)
  hold d = d + 1
}
show len(keep)

hold tag = "sayanox"
hold total = scan(tag, 4000000)
show total

hold runs0 = gc_runs()
hold freed = gc()
hold runs1 = gc_runs()
show runs1 - runs0
when runs0 > 0 { show "auto" } otherwise { show "manual" }

show len(keep)
show sx_index(keep, 0)
show sx_index(keep, 524287)
