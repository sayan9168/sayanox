            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sxsource_get(source_words,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sxsource_get(source_words,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
