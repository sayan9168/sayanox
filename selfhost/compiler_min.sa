          when sx_eq(nm2, "sx_arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "sx_argc") {
            hold fk = 8
          }
          hold rk = 0
          hold rhs = "0"
          when fk == 1 {
            hold rhs = concat("sx_cat(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 2 {
            hold key = concat("|", argv_c)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = concat("sx_llen(", argv_c)
              hold rhs = concat(rhs, ")")
              hold lt = 1
            } otherwise {
              hold rhs = concat("sx_len(", argv_c)
              hold rhs = concat(rhs, ")")
              hold rt = 1
            }
          }
          when fk == 3 {
            hold rhs = concat("sx_idx(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 4 {
            hold rhs = concat("sx_chr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 5 {
            hold rhs = concat("sx_read(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 20 {
            hold rhs = concat("sx_http(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 6 {
            hold rhs = concat("sx_write(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 7 {
            hold rhs = concat("sx_arg(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 8 {
            hold rhs = "sx_argc()"
            hold rt = 1
          }
          when fk == 9 {
            hold rhs = concat("sx_eq(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 12 {
            hold rhs = "sx_gc_run()"
          }
          when fk == 13 {
            hold rhs = "sx_gc_live()"
          }
          when fk == 14 {
            hold rhs = "sx_gc_count()"
          }
          when fk == 15 {
            hold rhs = "sx_read_line()"
            hold rk = 1
            hold rt = 1
          }
          when fk == 16 {
            hold rhs = concat("sx_read_n(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 17 {
            hold rhs = concat("sx_write_out(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 18 {
            hold rhs = "sx_flush_out()"
            hold rt = 1
          }
          when fk == 21 {
            hold rhs = concat("sx_exit(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 22 {
            hold rhs = concat("sx_read_dir(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 23 {
            hold rhs = concat("sx_path_kind(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 24 {
            hold rhs = concat("sx_path_size(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 25 {
            hold rhs = concat("sx_path_real(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 43 {
            hold rhs = concat("sx_run_command(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 44 {
            hold rhs = concat("sx_getenv(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 26 {
            hold rhs = concat("sx_spawn(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 27 {
            hold rhs = concat("sx_child_send(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 28 {
            hold rhs = concat("sx_child_recv(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 29 {
            hold rhs = concat("sx_child_line(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 30 {
            hold rhs = concat("sx_child_close(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 31 {
            hold rhs = concat("sx_make_dir(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 32 {
            hold rhs = concat("sx_make_link(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 33 {
            hold rhs = concat("sx_remove_path(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 34 {
            hold rhs = concat("sx_write_bytes(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 35 {
            hold rhs = concat("sx_bytes_f64(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 2
            hold lt = 1
          }
          when fk == 42 {
            hold rhs = concat("sx_read_bytes(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 36 {
            hold rhs = concat("sx_bit_and(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 37 {
            hold rhs = concat("sx_bit_or(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 38 {
            hold rhs = concat("sx_bit_xor(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 39 {
            hold rhs = concat("sx_bit_not(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 40 {
            hold rhs = concat("sx_shl(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 41 {
            hold rhs = concat("sx_shr(", argv_c)
            hold rhs = concat(rhs, ")")
          }
          when fk == 19 {
            hold rhs = concat("sx_numstr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 10 {
            // the pushed value must be a number: a plain string, list or
            // struct variable is a clear error (it was invalid C)
            hold pi2 = 0
            hold pa2 = len(argv_c)
            hold pv = 0
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              hold pi2 = pi2 + 1
              when pa3 == 44 {
                hold pv = pi2
                hold pi2 = pa2
              }
            }
            hold el = ""
            hold pv2 = 1
            hold pi2 = pv
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              when (pa3 >= 97 && pa3 <= 122) || (pa3 >= 65 && pa3 <= 90) || (pa3 >= 48 && pa3 <= 57) || pa3 == 95 {
                hold el = concat(el, chr(pa3))
              } otherwise {
                hold pv2 = 0
              }
              hold pi2 = pi2 + 1
            }
            when pv2 == 1 && pv > 0 {
              hold lbad = 0
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = concat("push: '", el)
                  hold permsg = concat(permsg, "' is not a number (a list cannot hold a string, list or struct)")
                }
                hold perr = 1
              }
            }
            hold rhs = concat("sx_lpush(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 2
            hold lt = 1
          }
          when fk == 0 {
            // a generic function: request the specialised copy for the
            // kind of the first argument and call that instead
            hold gkey2 = concat(chr(1), nm2)
            hold gkey2 = concat(gkey2, chr(1))
            hold gk2l = len(gkey2)
            hold gt2l = len(fgtab)
            hold gi2 = 0
            hold gfound = 0
            while gi2 + gk2l <= gt2l {
              hold gok2 = 1
              hold gj2 = 0
              while gj2 < gk2l {
                hold ga2 = sx_index(fgtab, gi2 + gj2)
                hold gb2 = sx_index(gkey2, gj2)
                when ga2 == gb2 {
                  hold gj2 = gj2 + 1
                } otherwise {
                  hold gok2 = 0
                  hold gj2 = gk2l
                }
              }
              when gok2 == 1 {
                hold gfound = 1
                hold gi2 = gt2l
              } otherwise {
                hold gi2 = gi2 + 1
              }
            }
            hold gcall2 = nm2
            when gfound == 1 {
              // kind of the first argument: num unless it is a string
              // literal or a name declared str/list
              hold gkch = 110
              hold gai2 = 0
              hold gal2 = len(argv_c)
              hold gsk2 = 1
              while gsk2 == 1 {
                when gai2 >= gal2 {
                  hold gsk2 = 0
                } otherwise {
                  hold gac = sx_index(argv_c, gai2)
                  when gac == 32 || gac == 9 {
                    hold gai2 = gai2 + 1
                  } otherwise {
                    hold gsk2 = 0
                  }
                }
              }
              hold gac = 0
              when gai2 < gal2 {
                hold gac = sx_index(argv_c, gai2)
              }
              when gac == 34 {
                hold gkch = 115
              }
              when gac == 91 {
                hold gkch = 108
              }
              when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || gac == 95 {
                hold ganm = ""
                hold grun3 = 1
                while grun3 == 1 {
                  when gai2 >= gal2 {
                    hold grun3 = 0
                  } otherwise {
                    hold gac = sx_index(argv_c, gai2)
                    when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || (gac >= 48 && gac <= 57) || gac == 95 {
                      hold ganm = concat(ganm, chr(gac))
                      hold gai2 = gai2 + 1
                    } otherwise {
                      hold grun3 = 0
                    }
                  }
                }
                hold gakey = concat(ganm, "|")
                hold gakl = len(gakey)
                hold ga1 = len(sdecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(sdecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(sdecls, gai3 - 1) == 124) {
                    hold gkch = 115
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
                hold ga1 = len(ldecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(ldecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(ldecls, gai3 - 1) == 124) {
                    hold gkch = 108
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
              }
              hold gcall2 = concat(nm2, "__")
              hold gcall2 = concat(gcall2, chr(gkch))
              // remember the request: the specialised copy is spliced in
              // at the next statement boundary
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, nm2)
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, chr(gkch))
              when gkch == 115 {
                hold rk = 1
                hold rt = 1
              }
              when gkch == 108 {
                hold rk = 2
                hold lt = 1
              }
            }
            hold rhs = concat(gcall2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 117 {
              hold structresultkind = sxelookup(fsret, nm2, "=")
              hold stname = sxeslice(structresultkind, 1, len(structresultkind))
              hold rk = 3
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }

        // ---- plain name, or name + number ----
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          // is nm2 a string variable?
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          hold rk = 0
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain value: `hold l = q` copies it
          // (typed declaration from the svars table)
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            hold rk = 3
            hold stname = bsvnm
          }
          hold rhs = nm2
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sxsource_get(source_words,pos)
          }
          // a list variable as a whole value: `hold ys = xs` aliases it, as
          // in seed-min and native (it used to emit `double ys = xs;`, which
          when c2 != 91 {
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              // pos may already be past the newline (at the next statement),
              // so test for an operator rather than for the end of the line
              hold lop = 0
              when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 || c2 == 46 || c2 == 40 {
                hold lop = 1
              }
              when c2 == 47 {
                hold lop = 1
                when pos + 1 < n {
                  hold pc3 = sxsource_get(source_words, pos + 1)
                  when pc3 == 47 {
                    hold lop = 0
                  }
                }
              }
              when lop == 0 {
                hold rk = 2
              } otherwise {
                when perr == 0 {
                  hold permsg = concat("list '", nm2)
                  hold permsg = concat(permsg, "' can only be held whole (hold ys = xs) or indexed (xs[i]); no operators on a list")
                }
                hold perr = 1
              }
            }
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // remember where the index starts: if the number-or-name parse
            // below fails, the numeric-expression retry restarts from here
            hold iqstart = pos
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sxsource_get(source_words,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sxsource_get(source_words,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sxsource_get(source_words,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an empty index is not an index: force the retry below so the
            // diagnostic is the clear one instead of C's `sx_lget(xs,)`
            hold iqany = 0
            hold iqq = 0
            hold iql2 = len(ix)
            while iqq < iql2 {
              hold iqc = sx_index(ix, iqq)
              when iqc != 32 && iqc != 9 {
                hold iqany = 1
              }
              hold iqq = iqq + 1
            }
            when iqany == 0 {
              hold ixok = 0
            }
            // Second chance: the index may be a whole numeric expression
            // (`xs[i - 1]`, `xs[(a + b) / 2]`, `xs[p.k]`). raw_index copies
            // the text verbatim and returns "" when it cannot lower it.
            when ixok == 0 {
              hold ix = raw_index(source, iqstart, n)
              when len(ix) > 0 {
                hold pos = iqstart + len(ix) + 1
                hold ixok = 1
                // lower len(NAME) and NAME[IDX] inside the index text; a
                // refusal here keeps the existing clear diagnostic
                hold ixl2 = idx_lower(ix, ldecls, sdecls, fsret, fspk)
                when len(ixl2) == 0 {
                  hold ixok = 0
                  hold exbad3 = 1
                } otherwise {
                  when len(ixl2) != len(ix) {
                    hold rt = 1
                  }
                  hold ix = ixl2
                }
              }
            }
            // an index must be a numeric expression closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
          // optional field chain p.x.y (text is walked as-is; when the base
          // is a struct variable the final type is resolved through the
          // svars and ftypes tables, so `l.a.x` and `hold m = l.b` work)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sxsource_get(source_words,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        when fpk == 51 {
                          hold fprv = 3
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  // no literal fixed this field's type: it is a number
                  // (the emitted typedef uses double)
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 3 {
                    hold rk = 2
                  } otherwise {
                    when curty == 1 {
                      hold rk = 1
                    } otherwise {
                      hold rk = 0
                    }
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          // A field-list postfix is reparsed from its original base.  The
          // legacy walker consumes the dotted selectors first, so this keeps
          // `p.xs[i]` in the typed list path instead of leaving '[' behind.
          when chn >= 1 && rk == 2 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 91 {
              hold flenv = concat(decls, chr(1))
              hold flenv = concat(flenv, sdecls)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, ldecls)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, svars)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, fsret)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, fspk)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, inprivate)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, ftypes)
              hold flvalue = sxeparse(source, fieldbaseat, flenv, 7, 0, instate)
              hold flkind = sxesegment(flvalue, 1)
              when sx_eq(flkind, "n") == 1 {
                hold rhs = sxecode(flvalue)
                hold pos = sxepos(flvalue)
                hold rk = 0
                hold lt = 1
              } otherwise {
                hold perr = 1
                when sx_eq(flkind, "e") == 1 {
                  hold permsg = concat("list-field index: ", sxecode(flvalue))
                } otherwise {
                  hold permsg = "list-field index must produce a number"
                }
              }
            }
          }
          // A whole list field can be copied or iterated, but arithmetic on
          // its pointer is never source-level numeric arithmetic.
          when chn >= 1 && rk == 2 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a list field can only be held whole, indexed, or passed to len()"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sxsource_get(source_words,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a list field can only be held whole, indexed, or passed to len()"
              }
            }
          }
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sxsource_get(source_words,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sxsource_get(source_words,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sxsource_get(source_words,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sxsource_get(source_words,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sxsource_get(source_words,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sxsource_get(source_words,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = numtxt
          }
          // string literal operand (copied verbatim, escapes kept)
          when c3 == 34 {
            hold oq = 1
            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sxsource_get(source_words,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sxsource_get(source_words,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
                }
              }
            }
          }
          // name operand
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cn = sxsource_get(source_words,pos)
                when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                  hold nm3 = concat(nm3, chr(cn))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sxsource_get(source_words, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sxsource_get(source_words, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
                        hold ocarg = concat(ocarg, chr(sxsource_get(source_words, pos)))
                        hold pos = pos + 1
                      }
                    } otherwise {
                      when ocx == 34 {
                        hold ocq = 0
                      }
                    }
                  } otherwise {
                    when ocx == 34 {
                      hold ocq = 1
                      hold ocarg = concat(ocarg, chr(ocx))
                      hold pos = pos + 1
                    } otherwise {
                      when ocx == 40 {
                        hold ocdepth = ocdepth + 1
                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
                hold ocmap = "sx_chr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_file") || sx_eq(nm3, "sx_read") {
                hold ocmap = "sx_read"
                hold ocstr = 1
              }
              when sx_eq(nm3, "http_get") || sx_eq(nm3, "sx_http") {
                hold ocmap = "sx_http"
                hold ocstr = 1
              }
              when sx_eq(nm3, "arg") || sx_eq(nm3, "sx_arg") {
                hold ocmap = "sx_arg"
                hold ocstr = 1
              }
              when sx_eq(nm3, "sx_index") || sx_eq(nm3, "sx_idx") {
                hold ocmap = "sx_idx"
              }
              when sx_eq(nm3, "write_file") || sx_eq(nm3, "sx_write") {
                hold ocmap = "sx_write"
              }
              when sx_eq(nm3, "arg_count") || sx_eq(nm3, "sx_argc") {
                hold ocmap = "sx_argc"
              }
              when sx_eq(nm3, "gc") || sx_eq(nm3, "sx_gc_run") {
                hold ocmap = "sx_gc_run"
              }
              when sx_eq(nm3, "gc_live") || sx_eq(nm3, "sx_gc_live") {
                hold ocmap = "sx_gc_live"
              }
              when sx_eq(nm3, "gc_runs") || sx_eq(nm3, "sx_gc_count") {
                hold ocmap = "sx_gc_count"
              }
              when sx_eq(nm3, "read_line") || sx_eq(nm3, "sx_read_line") {
                hold ocmap = "sx_read_line"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_n") || sx_eq(nm3, "sx_read_n") {
                hold ocmap = "sx_read_n"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_dir") || sx_eq(nm3, "sx_read_dir") {
                hold ocmap = "sx_read_dir"
                hold ocstr = 1
              }
              when sx_eq(nm3, "path_kind") || sx_eq(nm3, "sx_path_kind") {
                hold ocmap = "sx_path_kind"
              }
              when sx_eq(nm3, "path_size") || sx_eq(nm3, "sx_path_size") {
                hold ocmap = "sx_path_size"
              }
              when sx_eq(nm3, "path_real") || sx_eq(nm3, "sx_path_real") {
                hold ocmap = "sx_path_real"
                hold ocstr = 1
              }
              when sx_eq(nm3, "run_command") || sx_eq(nm3, "sx_run_command") {
                hold ocmap = "sx_run_command"
              }
              when sx_eq(nm3, "getenv") || sx_eq(nm3, "sx_getenv") {
                hold ocmap = "sx_getenv"
              }
              when sx_eq(nm3, "spawn") || sx_eq(nm3, "sx_spawn") {
                hold ocmap = "sx_spawn"
              }
              when sx_eq(nm3, "child_send") || sx_eq(nm3, "sx_child_send") {
                hold ocmap = "sx_child_send"
              }
              when sx_eq(nm3, "child_recv") || sx_eq(nm3, "sx_child_recv") {
                hold ocmap = "sx_child_recv"
                hold ocstr = 1
              }
              when sx_eq(nm3, "child_line") || sx_eq(nm3, "sx_child_line") {
                hold ocmap = "sx_child_line"
                hold ocstr = 1
              }
              when sx_eq(nm3, "child_close") || sx_eq(nm3, "sx_child_close") {
                hold ocmap = "sx_child_close"
              }
              when sx_eq(nm3, "make_dir") || sx_eq(nm3, "sx_make_dir") {
                hold ocmap = "sx_make_dir"
              }
              when sx_eq(nm3, "make_link") || sx_eq(nm3, "sx_make_link") {
                hold ocmap = "sx_make_link"
              }
              when sx_eq(nm3, "remove_path") || sx_eq(nm3, "sx_remove_path") {
                hold ocmap = "sx_remove_path"
              }
              when sx_eq(nm3, "write_bytes") || sx_eq(nm3, "sx_write_bytes") {
                hold ocmap = "sx_write_bytes"
              }
              when sx_eq(nm3, "bytes_f64") || sx_eq(nm3, "sx_bytes_f64") {
                hold ocmap = "sx_bytes_f64"
              }
              when sx_eq(nm3, "read_bytes") || sx_eq(nm3, "sx_read_bytes") {
                hold ocmap = "sx_read_bytes"
              }
              when sx_eq(nm3, "bit_and") || sx_eq(nm3, "sx_bit_and") {
                hold ocmap = "sx_bit_and"
              }
              when sx_eq(nm3, "bit_or") || sx_eq(nm3, "sx_bit_or") {
                hold ocmap = "sx_bit_or"
              }
              when sx_eq(nm3, "bit_xor") || sx_eq(nm3, "sx_bit_xor") {
                hold ocmap = "sx_bit_xor"
              }
              when sx_eq(nm3, "bit_not") || sx_eq(nm3, "sx_bit_not") {
                hold ocmap = "sx_bit_not"
              }
              when sx_eq(nm3, "shl") || sx_eq(nm3, "sx_shl") {
                hold ocmap = "sx_shl"
              }
              when sx_eq(nm3, "shr") || sx_eq(nm3, "sx_shr") {
                hold ocmap = "sx_shr"
              }
              when sx_eq(nm3, "exit") || sx_eq(nm3, "sx_exit") {
                hold ocmap = "sx_exit"
              }
              when sx_eq(nm3, "write_out") || sx_eq(nm3, "sx_write_out") {
                hold ocmap = "sx_write_out"
              }
              when sx_eq(nm3, "flush_out") || sx_eq(nm3, "sx_flush_out") {
                hold ocmap = "sx_flush_out"
              }
              when sx_eq(nm3, "numstr") || sx_eq(nm3, "sx_numstr") {
                hold ocmap = "sx_numstr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "string_eq") || sx_eq(nm3, "sx_eq") {
                hold ocmap = "sx_eq"
              }
              when sx_eq(nm3, "push") || sx_eq(nm3, "sx_lpush") {
                hold ocmap = "sx_lpush"
                hold oclist = 1
              }
              when sx_eq(nm3, "len") || sx_eq(nm3, "sx_len") || sx_eq(nm3, "sx_llen") {
                // list variable -> sx_llen, otherwise sx_len
                hold ocarg2 = ""
                hold ocai = 0
                hold ocbd = 1
                hold ocw = 1
                while ocw == 1 {
                  when ocai >= len(ocarg) {
                    hold ocw = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg, ocai)
                    when ocx == 40 || ocx == 91 {
                      hold ocbd = ocbd + 1
                    }
                    when ocx == 41 || ocx == 93 {
                      hold ocbd = ocbd - 1
                    }
                    when ocbd == 0 {
                      hold ocw = 0
                    } otherwise {
                      hold ocarg2 = concat(ocarg2, chr(ocx))
                    }
                    hold ocai = ocai + 1
                  }
                }
                hold ocarg3 = ""
                hold ocai = 0
                hold ocl2 = len(ocarg2)
                hold octr = 1
                while octr == 1 {
                  when ocl2 <= 0 {
                    hold octr = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg2, ocl2 - 1)
                    when ocx == 32 || ocx == 9 {
                      hold ocl2 = ocl2 - 1
                    } otherwise {
                      hold octr = 0
                    }
                  }
                }
                while ocai < ocl2 {
                  hold ocarg3 = concat(ocarg3, chr(sx_index(ocarg2, ocai)))
                  hold ocai = ocai + 1
                }
                hold ockey = concat("|", ocarg3)
                hold ockey = concat(ockey, "|")
                hold ockl = len(ockey)
                hold ocll = len(ldecls)
                hold ocli = 0
                hold oclf = 0
                while ocli + ockl <= ocll {
                  hold oclok = 1
                  hold oclj = 0
                  while oclj < ockl {
                    hold ocla = sx_index(ldecls, ocli + oclj)
                    hold oclb = sx_index(ockey, oclj)
                    when ocla == oclb {
                      hold oclj = oclj + 1
                    } otherwise {
                      hold oclok = 0
                      hold oclj = ockl
                    }
                  }
                  when oclok == 1 {
                    hold oclf = 1
                    hold ocli = ocll
                  } otherwise {
                    hold ocli = ocli + 1
                  }
                }
                when oclf == 1 {
                  hold ocmap = "sx_llen"
                  hold oclist = 1
                } otherwise {
                  hold ocmap = "sx_len"
                }
              }
              when sx_eq(ocmap, "") {
                // a user function: the return kind decides the value kind
                hold ocfrk = 0
                hold ocfky = concat("|", nm3)
                hold ocfky = concat(ocfky, "=")
                hold ocfkl = len(fsret)
                hold ocfki = 0
                hold ocfn = len(ocfky)
                while ocfki + ocfn + 1 <= ocfkl {
                  hold ocfok = 1
                  hold ocfj = 0
                  while ocfj < ocfn {
                    hold ocfa = sx_index(fsret, ocfki + ocfj)
                    hold ocfb = sx_index(ocfky, ocfj)
                    when ocfa == ocfb {
                      hold ocfj = ocfj + 1
                    } otherwise {
                      hold ocfok = 0
                      hold ocfj = ocfn
                    }
                  }
                  when ocfok == 1 {
                    hold ocfrk = sx_index(fsret, ocfki + ocfn)
                    hold ocfki = ocfkl
                  } otherwise {
                    hold ocfki = ocfki + 1
                  }
                }
                when ocfrk == 115 {
                  hold ocstr = 1
                }
                when ocfrk == 108 {
                  hold oclist = 1
                }
                hold ocmap = nm3
              }
              // builtin calls nested in the argument text are mapped here too,
              // so `concat(a, numstr(n))` works as a right-hand operand
              hold ocargv = ""
              hold ocak = 0
              hold ocakn = len(ocarg)
              hold ocargq = 0
              while ocak < ocakn {
                hold ocac = sx_index(ocarg, ocak)
                when ocargq == 1 {
                  hold ocargv = concat(ocargv, chr(ocac))
                  when ocac == 34 {
                    hold ocargq = 0
                  }
                  hold ocak = ocak + 1
                } otherwise {
                when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || ocac == 95 {
                  hold ocaw = ""
                  hold ocawr = 1
                  while ocawr == 1 {
                    hold ocac = sx_index(ocarg, ocak)
                    when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || (ocac >= 48 && ocac <= 57) || ocac == 95 {
                      hold ocaw = concat(ocaw, chr(ocac))
                      hold ocak = ocak + 1
                    } otherwise {
                      hold ocawr = 0
                    }
                    when ocak >= ocakn {
                      hold ocawr = 0
                    }
                  }
                  hold ocam = ocaw
                  // A word in argument text is a builtin *call* only when a
                  // `(` follows it: a variable named `index`, `len`, `arg`,
                  hold ocacall = 0
                  hold ocakx = ocak
                  hold ocask = 1
                  while ocask == 1 {
                    when ocakx >= ocakn {
                      hold ocask = 0
                    } otherwise {
                      hold ocacx = sx_index(ocarg, ocakx)
                      when ocacx == 32 || ocacx == 9 || ocacx == 13 {
                        hold ocakx = ocakx + 1
                      } otherwise {
                        hold ocask = 0
                      }
                    }
                  }
                  when ocakx < ocakn {
                    when sx_index(ocarg, ocakx) == 40 {
                      hold ocacall = 1
                    }
                  }
                  when ocacall == 1 {
                    when sx_eq(ocaw, "concat") {
                      hold ocam = "sx_cat"
                    }
                    when sx_eq(ocaw, "len") {
                      hold ocam = "sx_len"
                    }
                    when sx_eq(ocaw, "sx_index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "chr") {
                      hold ocam = "sx_chr"
                    }
                    when sx_eq(ocaw, "read_file") {
                      hold ocam = "sx_read"
                    }
                    when sx_eq(ocaw, "http_get") {
                      hold ocam = "sx_http"
                    }
                    when sx_eq(ocaw, "write_file") {
                      hold ocam = "sx_write"
                    }
                    when sx_eq(ocaw, "arg") {
                      hold ocam = "sx_arg"
                    }
                    when sx_eq(ocaw, "arg_count") {
                      hold ocam = "sx_argc"
                    }
                    when sx_eq(ocaw, "string_eq") {
                      hold ocam = "sx_eq"
                    }
                    when sx_eq(ocaw, "push") {
                      hold ocam = "sx_lpush"
                    }
                    when sx_eq(ocaw, "numstr") {
                      hold ocam = "sx_numstr"
                    }
                    when sx_eq(ocaw, "read_line") {
                      hold ocam = "sx_read_line"
                    }
                    when sx_eq(ocaw, "read_n") {
                      hold ocam = "sx_read_n"
                    }
                    when sx_eq(ocaw, "read_dir") {
                      hold ocam = "sx_read_dir"
                    }
                    when sx_eq(ocaw, "path_kind") {
                      hold ocam = "sx_path_kind"
                    }
                    when sx_eq(ocaw, "path_size") {
                      hold ocam = "sx_path_size"
                    }
                    when sx_eq(ocaw, "path_real") {
                      hold ocam = "sx_path_real"
                    }
                    when sx_eq(ocaw, "run_command") {
                      hold ocam = "sx_run_command"
                    }
                    when sx_eq(ocaw, "getenv") {
                      hold ocam = "sx_getenv"
                    }
                    when sx_eq(ocaw, "spawn") {
                      hold ocam = "sx_spawn"
                    }
                    when sx_eq(ocaw, "child_send") {
                      hold ocam = "sx_child_send"
                    }
                    when sx_eq(ocaw, "child_recv") {
                      hold ocam = "sx_child_recv"
                    }
                    when sx_eq(ocaw, "child_line") {
                      hold ocam = "sx_child_line"
                    }
                    when sx_eq(ocaw, "child_close") {
                      hold ocam = "sx_child_close"
                    }
                    when sx_eq(ocaw, "make_dir") {
                      hold ocam = "sx_make_dir"
                    }
                    when sx_eq(ocaw, "make_link") {
                      hold ocam = "sx_make_link"
                    }
                    when sx_eq(ocaw, "remove_path") {
                      hold ocam = "sx_remove_path"
                    }
                    when sx_eq(ocaw, "write_bytes") {
                      hold ocam = "sx_write_bytes"
                    }
                    when sx_eq(ocaw, "bytes_f64") {
                      hold ocam = "sx_bytes_f64"
                    }
                    when sx_eq(ocaw, "read_bytes") {
                      hold ocam = "sx_read_bytes"
                    }
                    when sx_eq(ocaw, "bit_and") {
                      hold ocam = "sx_bit_and"
                    }
                    when sx_eq(ocaw, "bit_or") {
                      hold ocam = "sx_bit_or"
                    }
                    when sx_eq(ocaw, "bit_xor") {
                      hold ocam = "sx_bit_xor"
                    }
                    when sx_eq(ocaw, "bit_not") {
                      hold ocam = "sx_bit_not"
                    }
                    when sx_eq(ocaw, "shl") {
                      hold ocam = "sx_shl"
                    }
                    when sx_eq(ocaw, "shr") {
                      hold ocam = "sx_shr"
                    }
                    when sx_eq(ocaw, "exit") {
                      hold ocam = "sx_exit"
                    }
                    when sx_eq(ocaw, "write_out") {
                      hold ocam = "sx_write_out"
                    }
                    when sx_eq(ocaw, "flush_out") {
                      hold ocam = "sx_flush_out"
                    }
                    when sx_eq(ocaw, "gc") {
                      hold ocam = "sx_gc_run"
                    }
                    when sx_eq(ocaw, "gc_live") {
                      hold ocam = "sx_gc_live"
                    }
                    when sx_eq(ocaw, "gc_runs") {
                      hold ocam = "sx_gc_count"
                    }
                  }
                  hold ocargv = concat(ocargv, ocam)
                } otherwise {
                  when ocac == 34 {
                    hold ocargq = 1
                  }
                  hold ocargv = concat(ocargv, chr(ocac))
                  hold ocak = ocak + 1
                }
                }
              }
              hold ocarg = ocargv
              hold opnd = concat(ocmap, "(")
              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sxsource_get(source_words,pos)
                  when cs == 32 || cs == 9 || cs == 13 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold c2 = 0
              when pos < n {
                hold c2 = sxsource_get(source_words,pos)
              }
              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sxsource_get(source_words,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          when fpk == 51 {
                            hold fprv = 3
                          } otherwise {
                            hold fprv = 0
                          }
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sxsource_get(source_words,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              // the identifier run below is only the simple case `xs[i]`;
              // opistart is where a numeric-expression retry restarts
              hold opistart = pos
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sxsource_get(source_words,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              hold opibad = 1
              when pos < n {
                hold cn = sxsource_get(source_words,pos)
                when cn == 93 {
                  hold pos = pos + 1
                  hold opibad = 0
                }
              }
              // `xs[i] + xs[i - 1]`: the operand after an operator is parsed
              // here, so this retry is what makes the SECOND index of a chain
              // an expression too (raw_index, same rules as a value position)
              when opibad == 1 {
                hold opix = raw_index(source, opistart, n)
                when len(opix) > 0 {
                  hold pos = opistart + len(opix) + 1
                  // the same lowering for the second index of a chain
                  hold opxl2 = idx_lower(opix, ldecls, sdecls, fsret, fspk)
                  when len(opxl2) == 0 {
                    hold exbad3 = 1
                  } otherwise {
                    when len(opxl2) != len(opix) {
                      hold rt = 1
                    }
                    hold opix = opxl2
                  }
                } otherwise {
                  hold exbad3 = 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      when fsstructactive == 1 && fully_checked_value == 0 && sxfneedscheck(rhs, fsret, fspk, svars) == 1 && sxecontains(rhs, chr(123)) == 0 {
        hold sfenv = sxfenv(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold sfvalue = sxeparse(rhs, 0, sfenv, 0, 0, instate)
        hold sfkind = sxesegment(sfvalue, 1)
        when string_eq(sfkind, "e") || sxflowspace(rhs, sxepos(sfvalue)) != len(rhs) {
          hold perr = 1
          hold permsg = concat("struct expression: ", sxecode(sfvalue))
        } otherwise {
          when len(sfkind) > 1 && sx_index(sfkind, 0) == 117 {
            hold rk = 3
            hold stname = sxeslice(sfkind, 1, len(sfkind))
          }
        }
      }

      // Seed expressions allow string concatenation inside call arguments,
      // not just at the outer assignment level. Re-lower the scalar expression
      // with the typed parser before emitting C pointer arithmetic.
      when len(value_compare_code) > 0 {
        rhs = value_compare_code
        rk = 1
        pos = value_compare_end
      }
      when perr == 0 && (rk == 0 || rk == 1) && sxseed_has_plus(rhs) {
        when inready == 0 {
          while sxecontains(source, inprivate) { inprivate = concat(inprivate, "x") }
          inready = 1
          fsret = concat(fsret, concat(inprivate, "list=l|"))
        }
        hold seed_string_serial = len(instate)
        hold seed_string_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold seed_string_value = sxeparse(rhs, 0, seed_string_env, 0, 0, instate)
        when (string_eq(sxesegment(seed_string_value, 1), "s") || string_eq(sxesegment(seed_string_value, 1), "n")) && sxflowspace(rhs, sxepos(seed_string_value)) == len(rhs) {
          rhs = sxecode(seed_string_value)
          fully_checked_value = 1
          fully_checked_kind = sxesegment(seed_string_value, 1)
          when sxecontains(rhs, "sx_cat(") { rt = 1 }
          while seed_string_serial < len(instate) {
            body = concat(body, concat("  double ", concat(inprivate, concat(sxedigits(seed_string_serial), concat(";", nl)))))
            seed_string_serial = seed_string_serial + 1
          }
        } otherwise {
          when seed_profile == 1 || string_eq(sxecode(seed_string_value), "numeric operator requires numeric operands") {
            perr = 1
            permsg = concat("string expression: ", sxecode(seed_string_value))
          }
        }
      }

      // The minimal seed permits local annotations only in typed makes.
      when seed_profile == 1 && in_fn == 1 && flowtyped == 0 && declk >= 0 {
        perr = 1
        permsg = "seed-min hold annotation requires a typed make signature"
      }
      // ---- declared type check (full language) ----
      when declk >= 0 {
        hold dtok = 0
        when declk == 0 && rk == 0 {
          hold dtok = 1
        }
        when declk == 1 && rk == 1 {
          hold dtok = 1
        }
        when declk == 2 && rk == 2 {
          hold dtok = 1
        }
        when declk == 3 && rk == 3 {
          when sx_eq(declt, stname) {
            hold dtok = 1
          }
        }
        when dtok == 0 {
          hold nerrscop = 1
          when sx_eq(scopmsg, "") {
            hold scopmsg = concat("type error: '", nm)
            when seed_profile == 1 { scopmsg = concat("type mismatch: ", scopmsg) }
            hold scopmsg = concat(scopmsg, "' is declared ")
            hold scopmsg = concat(scopmsg, declt)
            when rk == 0 {
              hold scopmsg = concat(scopmsg, " but the value is a number")
            } otherwise {
              when rk == 1 {
                hold scopmsg = concat(scopmsg, " but the value is a string")
              } otherwise {
                when rk == 2 {
                  hold scopmsg = concat(scopmsg, " but the value is a list")
                } otherwise {
                  hold scopmsg = concat(scopmsg, " but the value is a struct")
                }
              }
            }
          }
        }
      }
      // ---------- emit ----------
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold key = concat("|", nm)
      hold key = concat(key, "|")
      hold found = 0
      hold di = 0
      hold dl = len(decls)
      hold kl = len(key)
      while di + kl <= dl {
        hold ok = 1
        hold j = 0
        while j < kl {
          hold aa = sx_index(decls, di + j)
          hold bb = sx_index(key, j)
          when aa == bb {
            hold j = j + 1
          } otherwise {
            hold ok = 0
            hold j = kl
          }
        }
        when ok == 1 {
          hold found = 1
          hold di = dl
        } otherwise {
          hold di = di + 1
        }
      }
      when seed_profile == 1 && found == 1 && len(sufx) == 0 && liset == 0 {
        hold seed_old_env = sxfenv(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold seed_old_value = sxeparse(nm, 0, seed_old_env, 0, 0, instate)
        hold seed_old_kind = sxesegment(seed_old_value, 1)
        hold seed_new_kind = "n"
        when rk == 1 { seed_new_kind = "s" }
        when rk == 2 { seed_new_kind = "l" }
        when rk == 3 { seed_new_kind = concat("u", stname) }
        when string_eq(seed_old_kind, seed_new_kind) == 0 {
          perr = 1
          permsg = concat(concat(concat("hold/assignment changes the type of ", nm), concat(" from ", seed_old_kind)), concat(" to ", seed_new_kind))
        }
      }
      // an assignment target keeps its `.field` / `[index]` suffix; the
      // table lookup above uses the base name
      hold nm = concat(nm, sufx)
      when found == 1 {
        hold body = concat(body, ind)
        when liset == 1 {
          // list element assignment: NAME = sx_lset(NAME, index, value)
          hold body = concat(body, nm)
          hold body = concat(body, " = sx_lset(")
          hold body = concat(body, nm)
          hold body = concat(body, ", ")
          hold body = concat(body, lidx)
          hold body = concat(body, ", ")
          when cmpop == 0 {
            hold body = concat(body, rhs)
          } otherwise {
            when cmpop == 37 {
              hold body = concat(body, "sx_mod(sx_lget(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, lidx)
              hold body = concat(body, "), ")
              hold body = concat(body, rhs)
              hold body = concat(body, ")")
            } otherwise {
              hold body = concat(body, "(sx_lget(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, lidx)
              hold body = concat(body, ") ")
              hold body = concat(body, chr(cmpop))
              hold body = concat(body, " ")
              hold body = concat(body, rhs)
              hold body = concat(body, ")")
            }
          }
          hold body = concat(body, ");")
        }
        when liset == 0 && cmpop != 0 {
          // compound assignment: NAME op= EXPR (the name is evaluated once)
          when rk == 1 {
            // strings: `+=` concatenates, the other operators are errors
            when cmpop == 43 {
              hold body = concat(body, nm)
              hold body = concat(body, " = sx_cat(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, rhs)
              hold body = concat(body, ");")
              hold rt = 1
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment on a string supports only +="
            }
          } otherwise {
            when rk == 0 {
              hold body = concat(body, nm)
              hold body = concat(body, " = ")
              when cmpop == 37 {
                hold body = concat(body, "sx_mod(")
                hold body = concat(body, nm)
                hold body = concat(body, ", ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              } otherwise {
                hold body = concat(body, "(")
                hold body = concat(body, nm)
                hold body = concat(body, " ")
                hold body = concat(body, chr(cmpop))
                hold body = concat(body, " ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              }
              hold body = concat(body, ";")
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment needs a number or string variable"
            }
          }
        }
        when liset == 0 && cmpop == 0 {
          hold body = concat(body, nm)
          hold body = concat(body, " = ")
          hold body = concat(body, rhs)
          hold body = concat(body, ";")
        }
        hold body = concat(body, nl)
      } otherwise {
        hold body = concat(body, ind)
        when asmode == 1 {
          hold nerrscop = 1
          hold scopmsg = concat("assignment: '", nm)
          hold scopmsg = concat(scopmsg, "' does not exist yet; hold it first")
        }
        when cmpop != 0 {
          hold nerrscop = 1
          hold scopmsg = "compound assignment needs an existing variable; hold it first"
        }
        when rk == 1 {
          hold body = concat(body, "char *")
        } otherwise {
          when rk == 2 {
            hold body = concat(body, "sx_list *")
          } otherwise {
            when rk == 3 {
              hold body = concat(body, stname)
              hold body = concat(body, " ")
            } otherwise {
              hold body = concat(body, "double ")
            }
          }
        }
        hold body = concat(body, nm)
        hold body = concat(body, " = ")
        hold body = concat(body, rhs)
        hold body = concat(body, ";")
        hold body = concat(body, nl)
        hold decls = concat(decls, nm)
        hold decls = concat(decls, "|")
        when rk == 1 {
          hold sdecls = concat(sdecls, nm)
          hold sdecls = concat(sdecls, "|")
        }
        when rk == 2 {
          hold ldecls = concat(ldecls, nm)
          hold ldecls = concat(ldecls, "|")
        }
        when rk == 3 {
          // struct-typed variable: remembered for field-chain resolution
          hold svars = concat(svars, "|")
          hold svars = concat(svars, nm)
          hold svars = concat(svars, "=")
          hold svars = concat(svars, stname)
          hold svars = concat(svars, "|")
        }
      }
      hold holds = holds + 1
    }

    // ================= show EXPR =================
    when act == 2 {
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sxsource_get(source_words,pos)
      }


      // string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sxsource_get(source_words,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // keep the backslash and the escaped char
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sxsource_get(source_words,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
      }


      // number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sxsource_get(source_words,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sxsource_get(source_words,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // name or call
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) || c1 == 95 {
        hold fieldbaseat = pos
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sxsource_get(source_words,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold c2 = 0
        when pos < n {
          hold c2 = sxsource_get(source_words,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
hold argbracket = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sxsource_get(source_words,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sxsource_get(source_words,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 91 {
                    hold argbracket = argbracket + 1
                  }
                  when cn == 93 {
                    hold argbracket = argbracket - 1
                  }
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when (cn == 32 || cn == 9) && argbracket == 0 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          hold fk = 0
          // ---- '%' inside builtin-call argument text: sx_mod(L, R) ----
          // Same rule as the shared condition rewrite: L is the * / %
          hold bxo = ""
          hold bxi = 0
          hold bxbracket = 0
          hold bxn = len(argv_txt)
          hold bxc = 0
          hold bxq = 0
          hold bxal = 0
          hold bxrun = 0
          hold bxd = 0
          hold bxbd = 0
          hold bxe = 0
          hold bxri = 0
          hold bxnb = 0
          hold bxf = 0
          hold bxg = 0
          hold bxL = ""
          hold bxR = ""
          hold bxj = 0
          hold bxP = ""
          while bxi < bxn {
            hold bxc = sx_index(argv_txt, bxi)
            when bxc == 34 {
              // string literal: copy verbatim, escapes kept
              hold bxo = concat(bxo, chr(34))
              hold bxi = bxi + 1
              hold bxq = 1
              while bxq == 1 && bxi < bxn {
                hold bxc = sx_index(argv_txt, bxi)
                hold bxo = concat(bxo, chr(bxc))
                hold bxi = bxi + 1
                when bxc == 92 && bxi < bxn {
                  hold bxo = concat(bxo, chr(sx_index(argv_txt, bxi)))
                  hold bxi = bxi + 1
                } otherwise {
                  when bxc == 34 {
                    hold bxq = 0
                  }
                }
              }
            } otherwise {
              when bxc == 91 {
                hold bxbracket = bxbracket + 1
              }
              when bxc == 93 {
                hold bxbracket = bxbracket - 1
              }
              when bxc == 37 && bxbracket == 0 {
                // left operand: scan back over the chain already in bxo
                hold bxal = len(bxo)
                hold bxrun = 1
                while bxrun == 1 {
                  hold bxrun = 0
                  when bxal > 0 {
                    hold bxd = sx_index(bxo, bxal - 1)
                    when bxd == 41 || bxd == 93 {
                      // skip a balanced (..) or [..] group, then keep going
                      hold bxbd = 1
                      hold bxal = bxal - 1
                      while bxbd > 0 {
                        when bxal <= 0 {
                          hold bxbd = 0
                        } otherwise {
                          hold bxe = sx_index(bxo, bxal - 1)
                          when bxe == 41 || bxe == 93 {
                            hold bxbd = bxbd + 1
                          }
                          when bxe == 40 || bxe == 91 {
                            hold bxbd = bxbd - 1
                          }
                          hold bxal = bxal - 1
                        }
                      }
                      hold bxrun = 1
                    } otherwise {
                      when (bxd >= 97 && bxd <= 122) || (bxd >= 65 && bxd <= 90) || (bxd >= 48 && bxd <= 57) || bxd == 95 || bxd == 46 || bxd == 42 || bxd == 47 {
                        hold bxal = bxal - 1
                        hold bxrun = 1
                      }
                    }
                  }
                }
                // right operand: the next atom in argv_txt
                hold bxri = bxi + 1
                hold bxnb = 1
                while bxnb == 1 && bxri < bxn {
                  hold bxnb = 0
                  hold bxf = sx_index(argv_txt, bxri)
                  when (bxf >= 97 && bxf <= 122) || (bxf >= 65 && bxf <= 90) || (bxf >= 48 && bxf <= 57) || bxf == 95 || bxf == 46 {
                    hold bxri = bxri + 1
                    hold bxnb = 1
                  } otherwise {
                    when bxf == 40 || bxf == 91 {
                      hold bxbd = 1
                      hold bxri = bxri + 1
                      while bxbd > 0 && bxri < bxn {
                        hold bxg = sx_index(argv_txt, bxri)
                        when bxg == 40 || bxg == 91 {
                          hold bxbd = bxbd + 1
                        }
                        when bxg == 41 || bxg == 93 {
                          hold bxbd = bxbd - 1
                        }
                        hold bxri = bxri + 1
                      }
                      hold bxnb = 1
                    }
                  }
                }
                // rebuild: the left chain is replaced by sx_mod(L, R)
                hold bxL = ""
                hold bxj = bxal
                while bxj < len(bxo) {
                  hold bxL = concat(bxL, chr(sx_index(bxo, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxR = ""
                hold bxj = bxi + 1
                while bxj < bxri {
                  hold bxR = concat(bxR, chr(sx_index(argv_txt, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxP = ""
                hold bxj = 0
                while bxj < bxal {
                  hold bxP = concat(bxP, chr(sx_index(bxo, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxo = bxP
                hold bxo = concat(bxo, "sx_mod(")
