              }
              when gac == 91 {
                hold gkch = 108
              }
              when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || gac == 95 {
                hold ganm = ""
                hold grun3 = 1
                while grun3 == 1 {
                  when gai2 >= gal2 {
                    hold grun3 = 0
                  } otherwise {
                    hold gac = sx_index(argv_c, gai2)
                    when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || (gac >= 48 && gac <= 57) || gac == 95 {
                      hold ganm = concat(ganm, chr(gac))
                      hold gai2 = gai2 + 1
                    } otherwise {
                      hold grun3 = 0
                    }
                  }
                }
                hold gakey = concat(ganm, "|")
                hold gakl = len(gakey)
                hold ga1 = len(sdecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(sdecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(sdecls, gai3 - 1) == 124) {
                    hold gkch = 115
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
                hold ga1 = len(ldecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(ldecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(ldecls, gai3 - 1) == 124) {
                    hold gkch = 108
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
              }
              hold gcall2 = concat(nm2, "__")
              hold gcall2 = concat(gcall2, chr(gkch))
              // remember the request: the specialised copy is spliced in
              // at the next statement boundary
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, nm2)
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, chr(gkch))
              when gkch == 115 {
                hold rk = 1
                hold rt = 1
              }
              when gkch == 108 {
                hold rk = 2
                hold lt = 1
              }
            }
            hold rhs = concat(gcall2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          hold rhs = nm2
          hold rk = 0
          // optional field chain p.x.y (resolved like the hold RHS base)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sxsource_get(source_words,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        when fpk == 51 {
                          hold fprv = 3
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 3 {
                    hold rk = 2
                  } otherwise {
                    when curty == 1 {
                      hold rk = 1
                    } otherwise {
                      hold rk = 0
                    }
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          // A field-list postfix is reparsed from its original base.  The
          // legacy walker consumes the dotted selectors first, so this keeps
          // `p.xs[i]` in the typed list path instead of leaving '[' behind.
          when chn >= 1 && rk == 2 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 91 {
              hold flenv = concat(decls, chr(1))
              hold flenv = concat(flenv, sdecls)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, ldecls)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, svars)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, fsret)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, fspk)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, inprivate)
              hold flenv = concat(flenv, chr(1))
              hold flenv = concat(flenv, ftypes)
              hold flvalue = sxeparse(source, fieldbaseat, flenv, 7, 0, instate)
              hold flkind = sxesegment(flvalue, 1)
              when sx_eq(flkind, "n") == 1 {
                hold rhs = sxecode(flvalue)
                hold pos = sxepos(flvalue)
                hold rk = 0
                hold lt = 1
              } otherwise {
                hold perr = 1
                when sx_eq(flkind, "e") == 1 {
                  hold permsg = concat("list-field index: ", sxecode(flvalue))
                } otherwise {
                  hold permsg = "list-field index must produce a number"
                }
              }
            }
          }
          // A whole list field can be copied or iterated, but arithmetic on
          // its pointer is never source-level numeric arithmetic.
          when chn >= 1 && rk == 2 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a list field can only be held whole, indexed, or passed to len()"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sxsource_get(source_words,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a list field can only be held whole, indexed, or passed to len()"
              }
            }
          }
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sxsource_get(source_words,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sxsource_get(source_words,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain show value is an error (caught at
          // emit); remember the type so the message is accurate
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            when chn == 0 {
              hold rk = 3
              hold stname = bsvnm
            }
          }
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sxsource_get(source_words,pos)
          }
          // The outer statement walker historically remembered direct lists
          // only while parsing an index.  Preserve the list kind for a whole
          // direct name too, so `show xs` and `xs + 1` are source refusals
          // rather than pointer-to-double C.  Dotted fields carry rk == 2
          // through the field-chain mapper above.
          when c2 != 91 && chn == 0 && sx_eq(sxelookup(ldecls, nm2, "|"), "yes") == 1 {
            hold lop = 0
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 || c2 == 46 || c2 == 40 {
              hold lop = 1
            }
            when c2 == 47 {
              hold lop = 1
              when pos + 1 < n {
                hold pc3 = sxsource_get(source_words, pos + 1)
                when pc3 == 47 {
                  hold lop = 0
                }
              }
            }
            when lop == 0 {
              hold rk = 2
            } otherwise {
              when perr == 0 {
                hold permsg = concat("list '", nm2)
                hold permsg = concat(permsg, "' can only be held whole (hold ys = xs) or indexed (xs[i]); no operators on a list")
              }
              hold perr = 1
            }
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // remember where the index starts: if the number-or-name parse
            // below fails, the numeric-expression retry restarts from here
            hold iqstart = pos
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sxsource_get(source_words,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sxsource_get(source_words,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sxsource_get(source_words,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an empty index is not an index: force the retry below so the
            // diagnostic is the clear one instead of C's `sx_lget(xs,)`
            hold iqany = 0
            hold iqq = 0
            hold iql2 = len(ix)
            while iqq < iql2 {
              hold iqc = sx_index(ix, iqq)
              when iqc != 32 && iqc != 9 {
                hold iqany = 1
              }
              hold iqq = iqq + 1
            }
            when iqany == 0 {
              hold ixok = 0
            }
            // Second chance: the index may be a whole numeric expression
            // (`xs[i - 1]`, `xs[(a + b) / 2]`, `xs[p.k]`). raw_index copies
            // the text verbatim and returns "" when it cannot lower it.
            when ixok == 0 {
              hold ix = raw_index(source, iqstart, n)
              when len(ix) > 0 {
                hold pos = iqstart + len(ix) + 1
                hold ixok = 1
                // lower len(NAME) and NAME[IDX] inside the index text; a
                // refusal here keeps the existing clear diagnostic
                hold ixl = idx_lower(ix, ldecls, sdecls, fsret, fspk)
                when len(ixl) == 0 {
                  hold ixok = 0
                  hold exbad3 = 1
                } otherwise {
                  when len(ixl) != len(ix) {
                    hold rt = 1
                  }
                  hold ix = ixl
                }
              }
            }
            // an index must be a numeric expression closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sxsource_get(source_words,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sxsource_get(source_words,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sxsource_get(source_words,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sxsource_get(source_words,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sxsource_get(source_words,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
