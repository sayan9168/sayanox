// =====================================================================
// main scan loop
// =====================================================================

// =====================================================================
// use "file.sa" expansion (max depth 8, real statements only)
//   * only a `use "..."` that starts a statement is expanded
//   * strings and // comments are copied verbatim, never scanned for use
//   * a missing file emits #error into the generated C (clear failure)
//   * paths resolve against the CWD first, then next to the input file
//   * output is built in ~300 byte chunks (flat concat would be O(n^2))
// =====================================================================
hold exd = 0
hold exlast = -1
hold exdl = 0
hold exdl = len(in_path)
while exd < exdl {
  hold excd = 0
  hold excd = sx_index(in_path, exd)
  when excd == 47 {
    hold exlast = exd
  }
  hold exd = exd + 1
}
when exlast >= 0 {
  hold exd = 0
  while exd <= exlast {
    hold exdir = concat(exdir, chr(sx_index(in_path, exd)))
    hold exd = exd + 1
  }
}

hold exround = 0
hold exmore = 1
while exmore == 1 {
  hold exmore = 0
  hold exround = exround + 1
  hold exs = ""
  hold exch = ""
  hold exm = ""
  hold exchl = 0
  hold exml = 0
  hold exi = 0
  hold exst = 1
  hold exq = 0
  hold excm = 0
  while exi < n {
    // flush the pending chunk (two-level: exch -> exm -> exs).  A single
    // flat accumulator copies everything appended so far on every flush,
    // which is O(n^2) on the whole input; the mid chunk keeps that to
    // O(n^(4/3)) while the final text is identical.
    when exchl >= 128 {
      hold exm = concat(exm, exch)
      hold exch = ""
      hold exchl = 0
      hold exml = len(exm)
      when exml > 8192 {
        hold exs = concat(exs, exm)
        hold exm = ""
        hold exml = 0
      }
    }
    hold exc = sx_index(source, exi)
    when exq == 1 {
      // inside a string literal: copy verbatim, honour backslash escapes
      hold exch = concat(exch, chr(exc))
      hold exchl = exchl + 1
      hold exi = exi + 1
      when exc == 92 {
        when exi < n {
          hold exch = concat(exch, chr(sx_index(source, exi)))
          hold exchl = exchl + 1
          hold exi = exi + 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 0
        }
      }
    } otherwise {
      when excm == 1 {
        // inside a // comment: copy to end of line
        hold exch = concat(exch, chr(exc))
        hold exchl = exchl + 1
        hold exi = exi + 1
        when exc == 10 {
          hold excm = 0
          hold exst = 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 1
          hold exst = 0
          hold exch = concat(exch, chr(exc))
          hold exchl = exchl + 1
          hold exi = exi + 1
        } otherwise {
          when exst == 1 && exc >= 97 && exc <= 122 {
            // statement word: read it whole
            hold exw = ""
            hold exj = exi
            hold exrun = 1
            while exrun == 1 {
              when exj >= n {
                hold exrun = 0
              } otherwise {
                hold exc2 = sx_index(source, exj)
                when (exc2 >= 97 && exc2 <= 122) || (exc2 >= 65 && exc2 <= 90) || (exc2 >= 48 && exc2 <= 57) || exc2 == 95 {
                  hold exw = concat(exw, chr(exc2))
                  hold exj = exj + 1
                } otherwise {
                  hold exrun = 0
                }
              }
            }
            when sx_eq(exw, "use") {
              // blanks, then expect a quoted path
              hold exk = exj
              hold exrun = 1
              while exrun == 1 {
                when exk >= n {
                  hold exrun = 0
                } otherwise {
                  hold exc2 = sx_index(source, exk)
                  when exc2 == 32 || exc2 == 9 || exc2 == 13 {
                    hold exk = exk + 1
                  } otherwise {
                    hold exrun = 0
                  }
                }
              }
              hold exc2 = 0
              when exk < n {
                hold exc2 = sx_index(source, exk)
              }
              when exc2 == 34 {
                hold exk = exk + 1
                hold exup = ""
                hold exrun = 1
                while exrun == 1 {
                  when exk >= n {
                    hold exrun = 0
                  } otherwise {
                    hold exc2 = sx_index(source, exk)
                    when exc2 == 34 {
                      hold exrun = 0
                    } otherwise {
                      hold exup = concat(exup, chr(exc2))
                      hold exk = exk + 1
                    }
                  }
                }
                when exk < n {
                  hold exk = exk + 1
                }
                when exround <= 8 {
                  hold exsrc = read_file(exup)
                  hold exsl = len(exsrc)
                  when exsl == 0 {
                    hold exdl = len(exdir)
                    when exdl > 0 {
                      hold exsrc = read_file(concat(exdir, exup))
                      hold exsl = len(exsrc)
                    }
                  }
                  when exsl == 0 {
                    hold exmissing = 1
                    hold exmissp = exup
                  } otherwise {
                    // flush, then splice the whole file at once
                    when exchl > 0 {
                      hold exm = concat(exm, exch)
                      hold exch = ""
                      hold exchl = 0
                      hold exml = len(exm)
                    }
                    when exml > 0 {
                      hold exs = concat(exs, exm)
                      hold exm = ""
                      hold exml = 0
                    }
                    hold exs = concat(exs, exsrc)
                    hold exmore = 1
                    hold exst = 1
                  }
                  hold exi = exk
                } otherwise {
                  // deeper than 8: keep the text and report it below
                  hold exdeep = 1
                  hold exst = 0
                  hold exch = concat(exch, chr(exc))
                  hold exchl = exchl + 1
                  hold exi = exi + 1
                }
              } otherwise {
                // `use` not followed by a quoted path: report it rather
                // than letting `use foo.sa` turn into garbage identifiers
                hold exbad5 = 1
                hold exst = 0
                hold exch = concat(exch, chr(exc))
                hold exchl = exchl + 1
                hold exi = exi + 1
              }
            } otherwise {
              hold exst = 0
              hold exch = concat(exch, chr(exc))
              hold exchl = exchl + 1
              hold exi = exi + 1
            }
          } otherwise {
            when exc == 47 {
              hold exc2 = 0
              when exi + 1 < n {
                hold exc2 = sx_index(source, exi + 1)
              }
              when exc2 == 47 {
                hold excm = 1
              }
            }
            when exc == 123 || exc == 125 || exc == 10 {
              hold exst = 1
            } otherwise {
              when exc == 32 || exc == 9 || exc == 13 {
              } otherwise {
                hold exst = 0
              }
            }
            hold exch = concat(exch, chr(exc))
            hold exchl = exchl + 1
            hold exi = exi + 1
          }
        }
      }
    }
  }
  // flush the tail chunk (both levels)
  when exchl > 0 {
    hold exm = concat(exm, exch)
    hold exch = ""
    hold exchl = 0
    hold exml = len(exm)
  }
  when exml > 0 {
    hold exs = concat(exs, exm)
    hold exm = ""
    hold exml = 0
  }
  when exmore == 1 {
    hold source = exs
    hold n = len(source)
  }
}

// ---- malformed number literals (`1.2.3`) are rejected up front ----------
// Every number reader below accepts `.digits` once more each time it sees
// one, so a second fractional part would be copied into the C as `1.2.3`
// (a C compile error).  One scan over the spliced source, skipping strings,
// `//` comments and identifiers (so `p.x1.y` is not a number), catches it.
// (all scan variables are declared here: a first `hold` inside a block
// becomes a C local of that block)
hold nqp = 0
hold nqc = 0
hold nqn = 0
hold nqk = 0
hold nqf = 0
while nqp < n {
  hold nqc = sx_index(source,nqp)
  hold nqn = 0
  when nqp + 1 < n {
    hold nqn = sx_index(source,nqp + 1)
  }
  when nqc == 34 {
    // a string literal: skip to the closing quote, honouring backslashes
    hold nqp = nqp + 1
    hold nqk = 1
    while nqk == 1 {
      when nqp >= n {
        hold nqk = 0
      } otherwise {
        hold nqc = sx_index(source,nqp)
        when nqc == 92 {
          hold nqp = nqp + 2
        } otherwise {
          hold nqp = nqp + 1
          when nqc == 34 {
            hold nqk = 0
          }
        }
      }
    }
  } otherwise {
    when nqc == 47 && nqn == 47 {
      // a line comment: skip to the end of the line
      hold nqk = 1
      while nqk == 1 {
        when nqp >= n {
          hold nqk = 0
        } otherwise {
          hold nqc = sx_index(source,nqp)
          when nqc == 10 {
            hold nqk = 0
          } otherwise {
            hold nqp = nqp + 1
          }
        }
      }
    } otherwise {
      when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || nqc == 95 {
        // an identifier, digits included
        hold nqk = 1
        while nqk == 1 {
          when nqp >= n {
            hold nqk = 0
          } otherwise {
            hold nqc = sx_index(source,nqp)
            when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || (nqc >= 48 && nqc <= 57) || nqc == 95 {
              hold nqp = nqp + 1
            } otherwise {
              hold nqk = 0
            }
          }
        }
      } otherwise {
        when nqc >= 48 && nqc <= 57 {
          // a number: digits, then at most one `.digits`
          hold nqf = 0
          hold nqk = 1
          while nqk == 1 {
            when nqp >= n {
              hold nqk = 0
            } otherwise {
              hold nqc = sx_index(source,nqp)
              hold nqn = 0
              when nqp + 1 < n {
                hold nqn = sx_index(source,nqp + 1)
              }
              when nqc >= 48 && nqc <= 57 {
                hold nqp = nqp + 1
              } otherwise {
                when nqc == 46 && nqn >= 48 && nqn <= 57 {
                  when nqf == 1 {
                    when perr == 0 {
                      hold permsg = "malformed number literal (a number has at most one '.', as in 2.5)"
                    }
                    hold perr = 1
                  }
                  hold nqf = 1
                  hold nqp = nqp + 1
                } otherwise {
                  hold nqk = 0
                }
              }
            }
          }
        } otherwise {
          hold nqp = nqp + 1
        }
      }
    }
  }
}
// =====================================================================
// function signature table (full language)
//
//   make NAME(a, b: str) -> num
//
// Collected in one pass over the spliced source BEFORE the main scan, so a
// call can be typed even when the `make` line appears later in the file
// (forward references are already allowed).  Three flat tables:
//
//   fsret  |name=K|          K is n (num), s (str) or l (list)
//   fsptx  |name=double a, char *b|
//   fspk   |name=ns|
//
// A function with no annotations stays numeric, exactly as before, so the
// pure-min dialect is unchanged.
// =====================================================================
hold fsret = "|"
hold fsptx = "|"
hold fspk = "|"
hold fsi = 0
hold fsstart = 1
hold fsstr = 0
hold fscm = 0
hold fsw = ""
hold fsj = 0
hold fsnx = 0
hold fsp = 0
hold fsname = ""
hold fsrun = 0
hold fsc3 = 0
hold fstx = ""
hold fspks = ""
hold fspfirst = 0
hold fsprun = 0
hold fspn = ""
hold fspk2 = 0
hold fstype = ""
hold fsret2 = 0
hold fsc4 = 0
hold fshave = 0
hold fsrk = ""
hold fsrkl = 0
hold fsrl = 0
hold fsri = 0
hold fsok = 0
hold fsrj = 0
hold fsra = 0
hold fsrb = 0
hold fsc2 = 0
hold fsc = 0
while fsi < n {
  hold fsc = sx_index(source, fsi)
  when fsstr == 1 {
    // inside a string literal
    when fsc == 92 {
      hold fsi = fsi + 2
    } otherwise {
      when fsc == 34 {
        hold fsstr = 0
      }
      hold fsi = fsi + 1
    }
  } otherwise {
    when fscm == 1 {
      // inside a // comment
      when fsc == 10 {
        hold fscm = 0
        hold fsstart = 1
      }
      hold fsi = fsi + 1
    } otherwise {
      when fsc == 34 {
        hold fsstr = 1
        hold fsstart = 0
        hold fsi = fsi + 1
      } otherwise {
        when fsstart == 1 && fsc == 109 && fsi + 4 <= n {
          hold fsw = ""
          hold fsj = 0
          while fsj < 4 {
            hold fsw = concat(fsw, chr(sx_index(source, fsi + fsj)))
            hold fsj = fsj + 1
          }
          hold fsnx = 0
          when fsi + 4 < n {
            hold fsnx = sx_index(source, fsi + 4)
          }
          when sx_eq(fsw, "make") && (fsnx == 32 || fsnx == 9 || fsnx == 40) {
            // ---- parse `make NAME ( params ) -> TYPE` ----
            hold fsp = fsi + 4
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsname = ""
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                  hold fsname = concat(fsname, chr(fsc3))
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsc3 = 0
            when fsp < n {
              hold fsc3 = sx_index(source, fsp)
            }
            when fsc3 == 40 && sx_eq(fsname, "") == 0 {
              hold fsp = fsp + 1
              hold fstx = ""
              hold fspks = ""
              hold fspfirst = 1
              hold fsprun = 1
              while fsprun == 1 {
                hold fsc3 = 0
                when fsp < n {
                  hold fsc3 = sx_index(source, fsp)
                }
                when fsp >= n {
                  hold fsprun = 0
                } otherwise {
                  when fsc3 == 41 {
                    hold fsp = fsp + 1
                    hold fsprun = 0
                  } otherwise {
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 || fsc3 == 44 {
                      hold fsp = fsp + 1
                    } otherwise {
                      when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || fsc3 == 95 {
                        hold fspn = ""
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                              hold fspn = concat(fspn, chr(fsc3))
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fspk2 = 110
                        hold fsc3 = 0
                        when fsp < n {
                          hold fsc3 = sx_index(source, fsp)
                        }
                        when fsc3 == 58 {
                          hold fsp = fsp + 1
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          hold fstype = ""
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) {
                                hold fstype = concat(fstype, chr(fsc3))
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          when sx_eq(fstype, "str") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "string") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "list") {
                            hold fspk2 = 108
                          }
                          when sx_eq(fstype, "num") || sx_eq(fstype, "number") || sx_eq(fstype, "bool") || sx_eq(fstype, "double") {
                            hold fspk2 = 110
                          }
                        }
                        when fspfirst == 0 {
                          hold fstx = concat(fstx, ", ")
                        }
                        when fspk2 == 115 {
                          hold fstx = concat(fstx, "char *")
                        } otherwise {
                          when fspk2 == 108 {
                            hold fstx = concat(fstx, "sx_list *")
                          } otherwise {
                            hold fstx = concat(fstx, "double ")
                          }
                        }
                        hold fstx = concat(fstx, fspn)
                        hold fspks = concat(fspks, chr(fspk2))
                        hold fspfirst = 0
                      } otherwise {
                        hold fsp = fsp + 1
                      }
                    }
                  }
                }
              }
              // optional `-> TYPE`
              hold fsrun = 1
              while fsrun == 1 {
                when fsp >= n {
                  hold fsrun = 0
                } otherwise {
                  hold fsc3 = sx_index(source, fsp)
                  when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                    hold fsp = fsp + 1
                  } otherwise {
                    hold fsrun = 0
                  }
                }
              }
              hold fsret2 = 110
              hold fsc3 = 0
              hold fsc4 = 0
              when fsp < n {
                hold fsc3 = sx_index(source, fsp)
              }
              when fsp + 1 < n {
                hold fsc4 = sx_index(source, fsp + 1)
              }
              when fsc3 == 45 && fsc4 == 62 {
                hold fsp = fsp + 2
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                hold fstype = ""
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) {
                      hold fstype = concat(fstype, chr(fsc3))
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                when sx_eq(fstype, "str") || sx_eq(fstype, "string") {
                  hold fsret2 = 115
                }
                when sx_eq(fstype, "list") {
                  hold fsret2 = 108
                }
              }
              // record it once (a later redefinition keeps the first)
              hold fsrk = concat("|", fsname)
              hold fsrk = concat(fsrk, "=")
              hold fsrkl = len(fsrk)
              hold fsrl = len(fsret)
              hold fsri = 0
              hold fshave = 0
              while fsri + fsrkl <= fsrl {
                hold fsok = 1
                hold fsrj = 0
                while fsrj < fsrkl {
                  hold fsra = sx_index(fsret, fsri + fsrj)
                  hold fsrb = sx_index(fsrk, fsrj)
                  when fsra == fsrb {
                    hold fsrj = fsrj + 1
                  } otherwise {
                    hold fsok = 0
                    hold fsrj = fsrkl
                  }
                }
                when fsok == 1 {
                  hold fshave = 1
                  hold fsri = fsrl
                } otherwise {
                  hold fsri = fsri + 1
                }
              }
              when fshave == 0 {
                hold fsret = concat(fsret, fsname)
                hold fsret = concat(fsret, "=")
                hold fsret = concat(fsret, chr(fsret2))
                hold fsret = concat(fsret, "|")
                hold fsptx = concat(fsptx, fsname)
                hold fsptx = concat(fsptx, "=")
                hold fsptx = concat(fsptx, fstx)
                hold fsptx = concat(fsptx, "|")
                hold fspk = concat(fspk, fsname)
                hold fspk = concat(fspk, "=")
                hold fspk = concat(fspk, fspks)
                hold fspk = concat(fspk, "|")
              }
              hold fsi = fsp
              hold fsstart = 0
            } otherwise {
              hold fsstart = 0
              hold fsi = fsi + 1
            }
          } otherwise {
            when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
              hold fsstart = 1
            } otherwise {
              when fsc == 32 || fsc == 9 || fsc == 13 {
              } otherwise {
                hold fsstart = 0
              }
            }
            hold fsi = fsi + 1
          }
        } otherwise {
          when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
            hold fsstart = 1
          } otherwise {
            when fsc == 32 || fsc == 9 || fsc == 13 {
            } otherwise {
              hold fsstart = 0
            }
          }
          hold fsi = fsi + 1
        }
      }
    }
  }
}
// =====================================================================
// generic function table (full language)
//
//   make NAME<T>(a: T, b: T) -> T { ... }
//   make pair<A, B>(a: A, b: B) -> A { ... }
//
// A generic function is not emitted itself: it is recorded here and
// monomorphised on demand, one specialised copy per *type parameter* kind
// (`NAME__n`, `NAME__s`, `NAME__l`, `pair__ns`, ...).  The specialised
// definition is spliced into the source at the next statement boundary, so
// it is compiled by the ordinary `make`/`hold`/`give` machinery - including
// `hold x: T = ...` inside the body, after every type parameter is replaced
// by its concrete type word.  Entries are delimited by chr(1), which cannot
// appear in a source file.
//
//   fgtab    <1>name<1>TYPES<1>param,param<1>TIDX<1>RETIDX<1>body<1>
//   fgnames  <1>name<1>NTYPES<1>TIDX<1>RETIDX<1>
//
// TYPES is the comma-separated type parameter list ("T", or "A,B"); TIDX is
// one digit per value parameter saying which type parameter it uses; RETIDX
// is the digit of the type parameter the function returns.  Indices are
// stored as '0' + index.
// =====================================================================
hold fgtab = chr(1)
hold fgnames = chr(1)
hold fgcur = ""
// Scratch names shared by the generic pre-pass, the phase-0 splat and the
// phase-1.5 monomorphiser.  They are declared here, at the top of the
// function, because Sayanox scopes a `hold` to the block it first appears
// in: a name first bound inside a nested block is not visible to its
// siblings, and the loops below each need to leave a value behind for the
// code that follows them.
hold fgseen = 0
hold fgts = 0
hold fgtl = 0
hold fgtc = 0
hold fgreti = 0
hold giat = 0
hold gkc = 0
hold gpw = ""
hold zwAt = 0
hold fbgen = 0
hold fgty = ""
hold fgname = ""
hold fgpn = ""
hold fgbody = ""
hold fgallt = 0
hold fgntot = 0
hold fgretT = 0
hold fgi = 0
hold fgstart = 1
hold fgstr = 0
hold fgcm = 0
hold fgw = ""
hold fgj = 0
hold fgnx = 0
hold fgp = 0
hold fgrun = 0
hold fgc = 0
hold fgnm = ""
hold fgpn1 = ""
hold fgtype = ""
hold fgfirst = 0
hold fgprun = 0
hold fgdep = 0
hold fgbd = 0
hold fgq = 0
while fgi < n {
  hold fgc = sx_index(source, fgi)
  when fgstr == 1 {
    when fgc == 92 {
      hold fgi = fgi + 2
    } otherwise {
      when fgc == 34 {
        hold fgstr = 0
      }
      hold fgi = fgi + 1
    }
  } otherwise {
    when fgcm == 1 {
      when fgc == 10 {
        hold fgcm = 0
        hold fgstart = 1
      }
      hold fgi = fgi + 1
    } otherwise {
      when fgc == 34 {
        hold fgstr = 1
        hold fgstart = 0
        hold fgi = fgi + 1
      } otherwise {
        when fgstart == 1 && fgc == 109 && fgi + 4 <= n {
          hold fgw = ""
          hold fgj = 0
          while fgj < 4 {
            hold fgw = concat(fgw, chr(sx_index(source, fgi + fgj)))
            hold fgj = fgj + 1
          }
          hold fgnx = 0
          when fgi + 4 < n {
            hold fgnx = sx_index(source, fgi + 4)
          }
          hold fgok = 0
          when sx_eq(fgw, "make") && (fgnx == 32 || fgnx == 9) {
            hold fgok = 1
          }
          when fgok == 1 {
            hold fgp = fgi + 4
            hold fgrun = 1
            while fgrun == 1 {
              when fgp >= n {
                hold fgrun = 0
              } otherwise {
                hold fgc = sx_index(source, fgp)
                when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                  hold fgp = fgp + 1
                } otherwise {
                  hold fgrun = 0
                }
              }
            }
            hold fgnm = ""
            hold fgrun = 1
            while fgrun == 1 {
              when fgp >= n {
                hold fgrun = 0
              } otherwise {
                hold fgc = sx_index(source, fgp)
                when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || (fgc >= 48 && fgc <= 57) || fgc == 95 {
                  hold fgnm = concat(fgnm, chr(fgc))
                  hold fgp = fgp + 1
                } otherwise {
                  hold fgrun = 0
                }
              }
            }
            hold fgc = 0
            when fgp < n {
              hold fgc = sx_index(source, fgp)
            }
            hold fgbgen = 0
            hold fgty2 = ""
            // One type parameter used to be the whole story (`make NAME<T>`);
            // now the list is comma separated, so `make pair<A, B>(a: A, b: B)`
            // monomorphises on the kind of *every* type parameter.  fgtys is
            // the comma-joined list, fgnty its length, and every parameter
            // records which type parameter it uses (its index) so the
            // specialisation can be keyed per type parameter, not per call.
            hold fgtys = ""
            hold fgnty = 0
            when fgc == 60 {
              hold fgp = fgp + 1
              hold fgtrun = 1
              while fgtrun == 1 {
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgthis = ""
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when (fgc >= 65 && fgc <= 90) || (fgc >= 97 && fgc <= 122) || fgc == 95 {
                      hold fgthis = concat(fgthis, chr(fgc))
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                when sx_eq(fgthis, "") == 0 {
                  when fgnty > 0 {
                    hold fgtys = concat(fgtys, ",")
                  }
                  hold fgtys = concat(fgtys, fgthis)
                  hold fgnty = fgnty + 1
                }
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgc = 0
                when fgp < n {
                  hold fgc = sx_index(source, fgp)
                }
                when fgc == 44 {
                  hold fgp = fgp + 1
                } otherwise {
                  when fgc == 62 {
                    hold fgp = fgp + 1
                  }
                  hold fgtrun = 0
                }
              }
              when fgnty > 0 {
                hold fgty2 = fgtys
                hold fgbgen = 1
              }
            }
            when fgbgen == 1 && sx_eq(fgnm, "") == 0 {
              // params: NAME : TYPE, comma separated
              hold fgrun = 1
              while fgrun == 1 {
                when fgp >= n {
                  hold fgrun = 0
                } otherwise {
                  hold fgc = sx_index(source, fgp)
                  when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                    hold fgp = fgp + 1
                  } otherwise {
                    hold fgrun = 0
                  }
                }
              }
              hold fgc = 0
              when fgp < n {
                hold fgc = sx_index(source, fgp)
              }
              when fgc == 40 {
                hold fgp = fgp + 1
                hold fgpn1 = ""
                hold fgpidx = ""
                hold fgntot = 0
                hold fgallt = 1
                hold fgfirst = 1
                hold fgprun = 1
                while fgprun == 1 {
                  hold fgc = 0
                  when fgp < n {
                    hold fgc = sx_index(source, fgp)
                  }
                  when fgp >= n {
                    hold fgprun = 0
                  } otherwise {
                    when fgc == 41 {
                      hold fgp = fgp + 1
                      hold fgprun = 0
                    } otherwise {
                      when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 || fgc == 44 {
                        hold fgp = fgp + 1
                      } otherwise {
                        when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || fgc == 95 {
                          hold fgpn = ""
                          hold fgrun = 1
                          while fgrun == 1 {
                            when fgp >= n {
                              hold fgrun = 0
                            } otherwise {
                              hold fgc = sx_index(source, fgp)
                              when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || (fgc >= 48 && fgc <= 57) || fgc == 95 {
                                hold fgpn = concat(fgpn, chr(fgc))
                                hold fgp = fgp + 1
                              } otherwise {
                                hold fgrun = 0
                              }
                            }
                          }
                          hold fgrun = 1
                          while fgrun == 1 {
                            when fgp >= n {
                              hold fgrun = 0
                            } otherwise {
                              hold fgc = sx_index(source, fgp)
                              when fgc == 32 || fgc == 9 {
                                hold fgp = fgp + 1
                              } otherwise {
                                hold fgrun = 0
                              }
                            }
                          }
                          hold fgtype = ""
                          hold fgc = 0
                          when fgp < n {
                            hold fgc = sx_index(source, fgp)
                          }
                          when fgc == 58 {
                            hold fgp = fgp + 1
                            hold fgrun = 1
                            while fgrun == 1 {
                              when fgp >= n {
                                hold fgrun = 0
                              } otherwise {
                                hold fgc = sx_index(source, fgp)
                                when fgc == 32 || fgc == 9 {
                                  hold fgp = fgp + 1
                                } otherwise {
                                  hold fgrun = 0
                                }
                              }
                            }
                            hold fgrun = 1
                            while fgrun == 1 {
                              when fgp >= n {
                                hold fgrun = 0
                              } otherwise {
                                hold fgc = sx_index(source, fgp)
                                when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) {
                                  hold fgtype = concat(fgtype, chr(fgc))
                                  hold fgp = fgp + 1
                                } otherwise {
                                  hold fgrun = 0
                                }
                              }
                            }
                          }
                          when fgfirst == 0 {
                            hold fgpn1 = concat(fgpn1, ",")
                          }
                          hold fgpn1 = concat(fgpn1, fgpn)
                          hold fgfirst = 0
                          hold fgntot = fgntot + 1
                          // every parameter must name one of the type
                          // parameters; remember which one, as an index
                          hold fgidx = 0 - 1
                          hold fgseen = 0
                          hold fgcur = ""
                          hold fgts = 0
                          hold fgtl = len(fgtys)
                          while fgts <= fgtl {
                            hold fgtc = 0
                            when fgts < fgtl {
                              hold fgtc = sx_index(fgtys, fgts)
                            }
                            when fgtc == 44 || fgts == fgtl {
                              when sx_eq(fgcur, fgtype) {
                                hold fgidx = fgseen
                              }
                              hold fgcur = ""
                              hold fgseen = fgseen + 1
                            } otherwise {
                              hold fgcur = concat(fgcur, chr(fgtc))
                            }
                            hold fgts = fgts + 1
                          }
                          when fgidx < 0 {
                            hold fgallt = 0
                          } otherwise {
                            hold fgpidx = concat(fgpidx, chr(48 + fgidx))
                          }
                        } otherwise {
                          hold fgp = fgp + 1
                        }
                      }
                    }
                  }
                }
                // optional `-> TYPE`
                hold fgretT = 0
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 || fgc == 13 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgc = 0
                hold fgc2 = 0
                when fgp < n {
                  hold fgc = sx_index(source, fgp)
                }
                when fgp + 1 < n {
                  hold fgc2 = sx_index(source, fgp + 1)
                }
                when fgc == 45 && fgc2 == 62 {
                  hold fgp = fgp + 2
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgc == 32 || fgc == 9 {
                        hold fgp = fgp + 1
                      } otherwise {
                        hold fgrun = 0
                      }
                    }
                  }
                  hold fgtype = ""
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) {
                        hold fgtype = concat(fgtype, chr(fgc))
                        hold fgp = fgp + 1
                      } otherwise {
                        hold fgrun = 0
                      }
                    }
                  }
                  // the return type must name one of the type parameters too
                  hold fgreti = 0 - 1
                  hold fgseen = 0
                  hold fgcur = ""
                  hold fgts = 0
                  hold fgtl = len(fgtys)
                  while fgts <= fgtl {
                    hold fgtc = 0
                    when fgts < fgtl {
                      hold fgtc = sx_index(fgtys, fgts)
                    }
                    when fgtc == 44 || fgts == fgtl {
                      when sx_eq(fgcur, fgtype) {
                        hold fgreti = fgseen
                      }
                      hold fgcur = ""
                      hold fgseen = fgseen + 1
                    } otherwise {
                      hold fgcur = concat(fgcur, chr(fgtc))
                    }
                    hold fgts = fgts + 1
                  }
                  when fgreti >= 0 {
                    hold fgretT = 1
                  }
                }
                // a generic: every parameter and the return are T
                when fgallt == 1 && fgntot > 0 && fgretT == 1 {
                  // capture the body text up to the matching `}`
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                        hold fgp = fgp + 1
                      } otherwise {
                        when fgc == 123 {
                          hold fgp = fgp + 1
                        }
                        hold fgrun = 0
                      }
                    }
                  }
                  hold fgbd = 1
                  hold fgq = 0
                  hold fgb2 = 0
                  hold fgbody = ""
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgq == 1 {
                        hold fgbody = concat(fgbody, chr(fgc))
                        hold fgp = fgp + 1
                        when fgc == 92 {
                          when fgp < n {
                            hold fgbody = concat(fgbody, chr(sx_index(source, fgp)))
                            hold fgp = fgp + 1
                          }
                        } otherwise {
                          when fgc == 34 {
                            hold fgq = 0
                          }
                        }
                      } otherwise {
                        when fgc == 34 {
                          hold fgq = 1
                          hold fgbody = concat(fgbody, chr(fgc))
                          hold fgp = fgp + 1
                        } otherwise {
                          when fgc == 123 {
                            hold fgbd = fgbd + 1
                          }
                          when fgc == 125 {
                            hold fgbd = fgbd - 1
                          }
                          when fgbd == 0 && fgc == 125 {
                            hold fgrun = 0
                          } otherwise {
                            hold fgbody = concat(fgbody, chr(fgc))
                          }
                          hold fgp = fgp + 1
                        }
                      }
                    }
                  }
                  //   fgnames  <1>NAME<1>NTYPES<1>TIDX<1>RETIDX<1>
                  //   fgtab    <1>NAME<1>TYPES<1>PARAMS<1>TIDX<1>RETIDX<1>BODY<1>
                  // NTYPES / RETIDX and the TIDX digits are stored as
                  // characters ('0' + index), so the tables stay flat
                  // chr(1)-delimited strings; a type parameter index above 9
                  // is not a thing any program needs.
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, fgnm)
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, chr(48 + fgnty))
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, fgpidx)
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, chr(48 + fgreti))
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgtab = concat(fgtab, fgnm)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgty2)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgpn1)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgpidx)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, chr(48 + fgreti))
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgbody)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgi = fgp
                } otherwise {
                  hold fgi = fgi + 1
                }
                hold fgstart = 0
              } otherwise {
                hold fgstart = 0
                hold fgi = fgi + 1
              }
            } otherwise {
              when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
                hold fgstart = 1
              } otherwise {
                when fgc == 32 || fgc == 9 || fgc == 13 {
                } otherwise {
                  hold fgstart = 0
                }
              }
              hold fgi = fgi + 1
            }
          } otherwise {
            when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
              hold fgstart = 1
            } otherwise {
              when fgc == 32 || fgc == 9 || fgc == 13 {
              } otherwise {
                hold fgstart = 0
              }
            }
            hold fgi = fgi + 1
          }
        } otherwise {
          when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
            hold fgstart = 1
          } otherwise {
            when fgc == 32 || fgc == 9 || fgc == 13 {
            } otherwise {
              hold fgstart = 0
            }
          }
          hold fgi = fgi + 1
        }
      }
    }
  }
}

while running == 1 {

  // ---- phase 0: splice pending generic specialisations ----
  // Requests come from the statement pass (phase 1.5) and from the
  // specialisation bodies generated below (a generic calling another one).
  when len(gmore) > 0 {
    hold gwant = concat(gwant, gmore)
    hold gmore = ""
  }
  // A `make NAME<T>` call asks for a monomorphised copy; the text is
  // inserted right here, at a statement boundary, so the ordinary
  // function machinery compiles it (a prototype goes into gproto so a
  // forward-referenced call still links).
  // ... and only at function scope: splicing inside a `make` body (a call
  // made there) would cut the body in half, so those requests wait until the
  // enclosing definition has been flushed (`in_fn == 0`).
  when len(gwant) > 0 && in_fn == 0 {
    hold gwtxt = ""
    hold gwi = 1
    hold gwlen = len(gwant)
    while gwi < gwlen {
      hold gwnm = ""
      hold gwrun = 1
      while gwrun == 1 {
        when gwi >= gwlen {
          hold gwrun = 0
        } otherwise {
          hold gwc = sx_index(gwant, gwi)
          when gwc == 1 {
            hold gwi = gwi + 1
            hold gwrun = 0
          } otherwise {
            hold gwnm = concat(gwnm, chr(gwc))
            hold gwi = gwi + 1
          }
        }
      }
      // the request carries one kind character per type parameter
      hold gwks = ""
      hold gwrun = 1
      while gwrun == 1 {
        when gwi >= gwlen {
          hold gwrun = 0
        } otherwise {
          hold gwc = sx_index(gwant, gwi)
          when gwc == 1 {
            hold gwi = gwi + 1
            hold gwrun = 0
          } otherwise {
            hold gwks = concat(gwks, chr(gwc))
            hold gwi = gwi + 1
          }
        }
      }
      // look the generic up:
      //   fgtab <1>name<1>TYPES<1>params<1>TIDX<1>RETIDX<1>body<1>
      hold gkey = concat(chr(1), gwnm)
      hold gkey = concat(gkey, chr(1))
      hold gkl = len(gkey)
      hold gtl = len(fgtab)
      hold gti = 0
      hold gtf = 0
      hold gtstop = 0
      while gti + gkl <= gtl && gtstop == 0 {
        hold gtok = 1
        hold gtj = 0
        while gtj < gkl {
          hold gta = sx_index(fgtab, gti + gtj)
          hold gtb = sx_index(gkey, gtj)
          when gta == gtb {
            hold gtj = gtj + 1
          } otherwise {
            hold gtok = 0
            hold gtj = gkl
          }
        }
        when gtok == 1 {
          hold gtf = 1
          hold gtstop = 1
          hold gti = gti + gkl
        } otherwise {
          hold gti = gti + 1
        }
      }
      when gtf == 1 {
        // read T, params, body
        hold gtyp = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gtyp = concat(gtyp, chr(gtc))
            }
          }
        }
        hold gprm = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gprm = concat(gprm, chr(gtc))
            }
          }
        }
        hold gpid = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gpid = concat(gpid, chr(gtc))
            }
          }
        }
        hold gret = 0
        when gti < gtl {
          hold gret = sx_index(fgtab, gti) - 48
          hold gti = gti + 2
        }
        hold gbdy = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gbdy = concat(gbdy, chr(gtc))
            }
          }
        }
        // `gkindof(j)` is spelt out inline: the kind character the j'th type
        // parameter got from this call, defaulting to the first one when the
        // request is short (a call with too few arguments is diagnosed by the
        // ordinary call machinery, not here).
        hold gklen = len(gwks)
        hold gk0 = 110
        when gklen > 0 {
          hold gk0 = sx_index(gwks, 0)
        }
        hold gretk = gk0
        when gret < gklen {
          hold gretk = sx_index(gwks, gret)
        }
        // concrete type word for the RETURN of this specialisation
        hold gtw = "num"
        hold gtC = "double "
        when gretk == 115 {
          hold gtw = "str"
          hold gtC = "char * "
        }
        when gretk == 108 {
          hold gtw = "list"
          hold gtC = "sx_list * "
        }
        hold gspec = concat(gwnm, "__")
        hold gspec = concat(gspec, gwks)
        // emit every specialisation exactly once: `gdefs` is the registry of
        // definitions that have already been generated
        hold gdone = 0
        hold grb = concat(chr(1), gspec)
        hold grb = concat(grb, chr(1))
        hold grbl = len(grb)
        hold grl = len(gdefs)
        hold gri = 0
        while gri + grbl <= grl {
          hold grok = 1
          hold grj = 0
          while grj < grbl {
            hold gra = sx_index(gdefs, gri + grj)
            hold grc = sx_index(grb, grj)
            when gra == grc {
              hold grj = grj + 1
            } otherwise {
              hold grok = 0
              hold grj = grbl
            }
          }
          when grok == 1 {
            hold gdone = 1
            hold gri = grl
          } otherwise {
            hold gri = gri + 1
          }
        }
        when gdone == 0 {
        hold gpc = ""       // C param list for the prototype
        hold gpc2 = ""      // Sayanox param list for the definition
        hold gp1 = 1
        hold gpi = 0
        hold gpni = 0
        hold gprm = concat(gprm, ",")
        hold gpl = len(gprm)
        while gpi < gpl {
          hold gpn2 = ""
          hold grun = 1
          while grun == 1 {
            when gpi >= gpl {
              hold grun = 0
            } otherwise {
              hold gtc = sx_index(gprm, gpi)
              when gtc == 44 {
                hold gpi = gpi + 1
                hold grun = 0
              } otherwise {
                hold gpn2 = concat(gpn2, chr(gtc))
                hold gpi = gpi + 1
              }
            }
          }
          when sx_eq(gpn2, "") == 0 {
            // this parameter's own type: TIDX[gpni] says which type
            // parameter it uses, and that one got kind gwks[TIDX[gpni]]
            hold gkc = gk0
            when gpni < len(gpid) {
              hold gkj = sx_index(gpid, gpni) - 48
              when gkj < gklen {
                hold gkc = sx_index(gwks, gkj)
              }
            }
            hold gpw = "num"
            hold gpC = "double "
            when gkc == 115 {
              hold gpw = "str"
              hold gpC = "char * "
            }
            when gkc == 108 {
              hold gpw = "list"
              hold gpC = "sx_list * "
            }
            when gp1 == 0 {
              hold gpc = concat(gpc, ", ")
              hold gpc2 = concat(gpc2, ", ")
            }
            hold gpc = concat(gpc, gpC)
            hold gpc = concat(gpc, gpn2)
            hold gpc2 = concat(gpc2, gpn2)
            hold gpc2 = concat(gpc2, ": ")
            hold gpc2 = concat(gpc2, gpw)
            hold gp1 = 0
            hold gpni = gpni + 1
          }
        }
        // body with whole-word `T` replaced by the concrete type word
        hold gnew = ""
        hold gbi = 0
        hold gbl = len(gbdy)
        while gbi < gbl {
          hold gbc = sx_index(gbdy, gbi)
          when (gbc >= 97 && gbc <= 122) || (gbc >= 65 && gbc <= 90) || gbc == 95 {
            hold gwd = ""
            hold grun = 1
            while grun == 1 {
              when gbi >= gbl {
                hold grun = 0
              } otherwise {
                hold gbc = sx_index(gbdy, gbi)
                when (gbc >= 97 && gbc <= 122) || (gbc >= 65 && gbc <= 90) || (gbc >= 48 && gbc <= 57) || gbc == 95 {
                  hold gwd = concat(gwd, chr(gbc))
                  hold gbi = gbi + 1
                } otherwise {
                  hold grun = 0
                }
              }
            }
            // which type parameter (if any) does this word name?
            hold gwi2 = 0 - 1
            hold gseen = 0
            hold gcur2 = ""
            hold gts2 = 0
            hold gtl2 = len(gtyp)
            while gts2 <= gtl2 {
              hold gtc2 = 0
              when gts2 < gtl2 {
                hold gtc2 = sx_index(gtyp, gts2)
              }
              when gtc2 == 44 || gts2 == gtl2 {
                when sx_eq(gcur2, gwd) {
                  hold gwi2 = gseen
                }
                hold gcur2 = ""
                hold gseen = gseen + 1
              } otherwise {
                hold gcur2 = concat(gcur2, chr(gtc2))
              }
              hold gts2 = gts2 + 1
            }
            when gwi2 >= 0 {
              hold gkc = gk0
              when gwi2 < gklen {
                hold gkc = sx_index(gwks, gwi2)
              }
              hold gpw = "num"
              when gkc == 115 {
                hold gpw = "str"
              }
              when gkc == 108 {
                hold gpw = "list"
              }
              hold gnew = concat(gnew, gpw)
            } otherwise {
              // a call to another generic function in the same body: use this
              // specialisation's kind (T is the same type all through)
              hold gihit = 0
              hold ginl = concat(chr(1), gwd)
              hold ginl = concat(ginl, chr(1))
              hold ginll = len(ginl)
              hold gint = len(fgnames)
              hold gini = 0
              while gini + ginll <= gint {
                hold giok = 1
                hold gij = 0
                while gij < ginll {
                  hold gia = sx_index(fgnames, gini + gij)
                  hold gib = sx_index(ginl, gij)
                  when gia == gib {
                    hold gij = gij + 1
                  } otherwise {
                    hold giok = 0
                    hold gij = ginll
                  }
                }
                when giok == 1 {
                  hold gihit = 1
                  hold giat = gini + ginll
                  hold gini = gint
                } otherwise {
                  hold gini = gini + 1
                }
              }
              when gihit == 1 {
                // a generic calling a generic: the callee needs its own
                // kind suffix, one character per *its* type parameters.
                // Take them from this call's kinds, left to right, padding
                // with the first kind when the callee wants more.
                hold gnty2 = 1
                when giat < len(fgnames) {
                  hold gnty2 = sx_index(fgnames, giat) - 48
                }
                hold gsuf = ""
                hold gsc = 0
                while gsc < gnty2 {
                  when gsc < gklen {
                    hold gsuf = concat(gsuf, chr(sx_index(gwks, gsc)))
                  } otherwise {
                    hold gsuf = concat(gsuf, chr(gk0))
                  }
                  hold gsc = gsc + 1
                }
                hold gnew = concat(gnew, gwd)
                hold gnew = concat(gnew, "__")
                hold gnew = concat(gnew, gsuf)
                hold gmore = concat(gmore, chr(1))
                hold gmore = concat(gmore, gwd)
                hold gmore = concat(gmore, chr(1))
                hold gmore = concat(gmore, gsuf)
                hold gmore = concat(gmore, chr(1))
                // The callee's copy is not emitted yet, so its result kind
                // has to be recorded here as well: a `hold v: T = callee(..)`
                // inside this body needs it while it is being compiled.
                // fgnames is <1>NAME<1>NTYPES<1>TIDX<1>RETIDX<1> and giat
                // points at NTYPES, so RETIDX is the character after the
                // delimiter that closes TIDX.
                hold gqxi = giat + 2
                hold gqxrun = 1
                while gqxrun == 1 {
                  when gqxi >= len(fgnames) {
                    hold gqxrun = 0
                  } otherwise {
                    hold gqxc = sx_index(fgnames, gqxi)
                    when gqxc == 1 {
                      hold gqxrun = 0
                    } otherwise {
                      hold gqxi = gqxi + 1
                    }
                  }
                }
                hold gqxri = 0
                when gqxi + 1 < len(fgnames) {
                  hold gqxri = sx_index(fgnames, gqxi + 1) - 48
                }
                hold gqxrk = 110
                when gqxri >= 0 {
                  when gqxri < len(gsuf) {
                    hold gqxrk = sx_index(gsuf, gqxri)
                  }
                }
                hold fsret = concat(fsret, gwd)
                hold fsret = concat(fsret, "__")
                hold fsret = concat(fsret, gsuf)
                hold fsret = concat(fsret, "=")
                hold fsret = concat(fsret, chr(gqxrk))
                hold fsret = concat(fsret, "|")
              } otherwise {
                hold gnew = concat(gnew, gwd)
              }
            }
          } otherwise {
            hold gnew = concat(gnew, chr(gbc))
            hold gbi = gbi + 1
          }
        }
        // definition + prototype + signature tables for the specialised name
        hold gwtxt = concat(gwtxt, "make ")
        hold gwtxt = concat(gwtxt, gspec)
        hold gwtxt = concat(gwtxt, "(")
        hold gwtxt = concat(gwtxt, gpc2)
        hold gwtxt = concat(gwtxt, ") -> ")
        hold gwtxt = concat(gwtxt, gtw)
        hold gwtxt = concat(gwtxt, " {")
        hold gwtxt = concat(gwtxt, gnew)
        hold gwtxt = concat(gwtxt, "}")
        hold gwtxt = concat(gwtxt, nl)
        hold gproto = concat(gproto, "static ")
        hold gproto = concat(gproto, gtC)
        hold gproto = concat(gproto, " ")
        hold gproto = concat(gproto, gspec)
        hold gproto = concat(gproto, "(")
        hold gproto = concat(gproto, gpc)
        hold gproto = concat(gproto, ");")
        hold gproto = concat(gproto, nl)
        hold fsret = concat(fsret, gspec)
        hold fsret = concat(fsret, "=")
        hold fsret = concat(fsret, chr(gretk))
        hold fsret = concat(fsret, "|")
        hold fsptx = concat(fsptx, gspec)
        hold fsptx = concat(fsptx, "=")
        hold fsptx = concat(fsptx, gpc)
        hold fsptx = concat(fsptx, "|")
        hold gdefs = concat(gdefs, chr(1))
        hold gdefs = concat(gdefs, gspec)
        hold gdefs = concat(gdefs, chr(1))
        }
      }
    }
    hold gwant = ""
    // splice the text at the current statement boundary
    hold gsrc = ""
    hold gsi = 0
    while gsi < pos {
      hold gsrc = concat(gsrc, chr(sx_index(source, gsi)))
      hold gsi = gsi + 1
    }
    hold gsrc = concat(gsrc, gwtxt)
    while gsi < n {
      hold gsrc = concat(gsrc, chr(sx_index(source, gsi)))
      hold gsi = gsi + 1
    }
    hold source = gsrc
    hold n = len(source)
  }

  // ---- phase 1: skip blanks and // comments ----
  hold skipw = 1
  while skipw == 1 {
    when pos >= n {
      hold skipw = 0
      hold running = 0
    } otherwise {
      hold c = sx_index(source,pos)
      hold isspace = 0
      when c == 32 || c == 9 || c == 13 || c == 10 {
        hold isspace = 1
      }
      when isspace == 1 {
        hold pos = pos + 1
      } otherwise {
        when c == 47 {
          hold c2 = 0
          when pos + 1 < n {
            hold c2 = sx_index(source,pos + 1)
          }
          when c2 == 47 {
            // line comment: run to the end of the line
            hold pos = pos + 2
            hold skipc = 1
            while skipc == 1 {
              when pos >= n {
                hold skipc = 0
                hold running = 0
              } otherwise {
                hold c3 = sx_index(source,pos)
                when c3 == 10 {
                  hold skipc = 0
                } otherwise {
                  hold pos = pos + 1
                }
              }
            }
          } otherwise {
            hold pos = pos + 1
          }
        } otherwise {
          hold skipw = 0
        }
      }
    }
  }

  // ---- phase 1.5: monomorphise the generic calls of this statement -------
  // `make NAME<T>` is compiled by generating one specialised copy per call.
  // Rewriting `NAME(...)` here, in the statement text itself, means every
  // ordinary call path (hold, show, give, when, ...) only ever sees a plain
  // function call - nested calls included.  The kind of a call is the kind
  // of its own first argument, looked up through string/list literals,
  // declared variables, the builtins and the declared return kinds of the
  // other functions.  The definition is spliced in at the next statement
  // boundary (see phase 0), but the call site already needs to know the kind
  // of the result, so it is registered in fsret right here.
  when running == 1 && len(fgnames) > 1 {
    hold zwEnd = pos
    while zwEnd < n && sx_index(source, zwEnd) != 10 {
      hold zwEnd = zwEnd + 1
    }
    hold zwT = ""
    hold zwI = pos
    while zwI < zwEnd {
      hold zwT = concat(zwT, chr(sx_index(source, zwI)))
      hold zwI = zwI + 1
    }
    hold zwL = len(zwT)
    hold zwOut = ""
    hold zwHit = 0
    hold zwI = 0
    while zwI < zwL {
      hold zwC = sx_index(zwT, zwI)
      when zwC == 34 {
        // a string literal: copy it verbatim, escapes kept
        hold zwOut = concat(zwOut, chr(zwC))
        hold zwI = zwI + 1
        hold zwRun = 1
        while zwRun == 1 {
          when zwI >= zwL {
            hold zwRun = 0
          } otherwise {
            hold zwC = sx_index(zwT, zwI)
            hold zwOut = concat(zwOut, chr(zwC))
            hold zwI = zwI + 1
            when zwC == 92 {
              when zwI < zwL {
                hold zwOut = concat(zwOut, chr(sx_index(zwT, zwI)))
                hold zwI = zwI + 1
              }
            } otherwise {
              when zwC == 34 {
                hold zwRun = 0
              }
            }
          }
        }
      } otherwise {
        when (zwC >= 97 && zwC <= 122) || (zwC >= 65 && zwC <= 90) || zwC == 95 {
          // an identifier: collect it
          hold zwStart = zwI
          hold zwW = ""
          hold zwRun = 1
          while zwRun == 1 {
            when zwI >= zwL {
              hold zwRun = 0
            } otherwise {
              hold zwC = sx_index(zwT, zwI)
              when (zwC >= 97 && zwC <= 122) || (zwC >= 65 && zwC <= 90) || (zwC >= 48 && zwC <= 57) || zwC == 95 {
                hold zwW = concat(zwW, chr(zwC))
                hold zwI = zwI + 1
              } otherwise {
                hold zwRun = 0
              }
            }
          }
          hold zwS = zwI
          hold zwRun = 1
          while zwRun == 1 {
            when zwS >= zwL {
              hold zwRun = 0
            } otherwise {
              hold zwC = sx_index(zwT, zwS)
              when zwC == 32 || zwC == 9 || zwC == 13 {
                hold zwS = zwS + 1
              } otherwise {
                hold zwRun = 0
              }
            }
          }
          hold zwMatch = 0
          when zwS < zwL {
            when sx_index(zwT, zwS) == 40 {
              // is the word a declared generic?
              hold zwKey = concat(chr(1), zwW)
              hold zwKey = concat(zwKey, chr(1))
              hold zwKl = len(zwKey)
              hold zwLl = len(fgnames)
              hold zwAt = 0
              hold zwLi = 0
              while zwLi + zwKl <= zwLl {
                hold zwOk = 1
                hold zwJ = 0
                while zwJ < zwKl {
                  hold zwA = sx_index(fgnames, zwLi + zwJ)
                  hold zwB = sx_index(zwKey, zwJ)
                  when zwA == zwB {
                    hold zwJ = zwJ + 1
                  } otherwise {
                    hold zwOk = 0
                    hold zwJ = zwKl
                  }
                }
                when zwOk == 1 {
                  hold zwMatch = 1
                  hold zwAt = zwLi + zwKl
                  hold zwLi = zwLl
                } otherwise {
                  hold zwLi = zwLi + 1
                }
              }
            }
          }
          when zwMatch == 0 {
            hold zwOut = concat(zwOut, zwW)
          } otherwise {
            // The kind of every type parameter, not just the first.
            // TIDX[p] says which type parameter value parameter p uses, so
            // the kind of argument p is the kind of one type parameter; a
            // generic with a single type parameter still keys on its first
            // argument exactly as it always did, which is why the
            // specialisation names do not change.
            hold zwNl = len(fgnames)
            hold zwNt = 1
            hold zwTidx = ""
            hold zwRi = 0
            when zwAt < zwNl {
              hold zwNt = sx_index(fgnames, zwAt) - 48
            }
            hold zwAi = zwAt + 2
            hold zwArun = 1
            while zwArun == 1 {
              when zwAi >= zwNl {
                hold zwArun = 0
              } otherwise {
                hold zwAc = sx_index(fgnames, zwAi)
                when zwAc == 1 {
                  hold zwArun = 0
                } otherwise {
                  hold zwTidx = concat(zwTidx, chr(zwAc))
                  hold zwAi = zwAi + 1
                }
              }
            }
            when zwAi + 1 < zwNl {
              hold zwRi = sx_index(fgnames, zwAi + 1) - 48
            }
            hold zwAKinds = ""
            hold zwNP = len(zwTidx)
            hold zwP = 0
            while zwP < zwNP {
              // walk to the start of argument zwP: skip zwP depth-0 commas
              hold zwKk = zwS + 1
              hold zwSkip = zwP
              while zwSkip > 0 {
                hold zwD = 0
                hold zwQ = 0
                hold zwSrch = 1
                while zwSrch == 1 {
                  when zwKk >= zwL {
                    hold zwSrch = 0
                  } otherwise {
                    hold zwKc = sx_index(zwT, zwKk)
                    when zwQ == 1 {
                      when zwKc == 92 {
                        hold zwKk = zwKk + 1
                      } otherwise {
                        when zwKc == 34 {
                          hold zwQ = 0
                        }
                      }
                      hold zwKk = zwKk + 1
                    } otherwise {
                      when zwKc == 34 {
                        hold zwQ = 1
                        hold zwKk = zwKk + 1
                      } otherwise {
                        when zwKc == 40 {
                          hold zwD = zwD + 1
                          hold zwKk = zwKk + 1
                        } otherwise {
                          when zwKc == 41 {
                            when zwD == 0 {
                              hold zwSrch = 0
                            } otherwise {
                              hold zwD = zwD - 1
                              hold zwKk = zwKk + 1
                            }
                          } otherwise {
                            when zwKc == 44 {
                              when zwD == 0 {
                                hold zwSrch = 0
                                hold zwKk = zwKk + 1
                              } otherwise {
                                hold zwKk = zwKk + 1
                              }
                            } otherwise {
                              hold zwKk = zwKk + 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
                hold zwSkip = zwSkip - 1
              }
              hold zwKind = 110
              hold zwKdone = 0
              hold zwKgo = 0
              hold zwKlev = 0
              while zwKdone == 0 {
                hold zwKgo = 0
                hold zwKskip = 1
                while zwKskip == 1 {
                  when zwKk >= zwL {
                    hold zwKskip = 0
                  } otherwise {
                    hold zwKc = sx_index(zwT, zwKk)
                    when zwKc == 32 || zwKc == 9 || zwKc == 13 {
                      hold zwKk = zwKk + 1
                    } otherwise {
                      hold zwKskip = 0
                    }
                  }
                }
                when zwKk >= zwL {
                  hold zwKind = 110
                  hold zwKdone = 1
                } otherwise {
                  hold zwKc = sx_index(zwT, zwKk)
                  when zwKc == 34 {
                    hold zwKind = 115
                    hold zwKdone = 1
                  }
                  when zwKc == 91 {
                    hold zwKind = 108
                    hold zwKdone = 1
                  }
                  when (zwKc >= 97 && zwKc <= 122) || (zwKc >= 65 && zwKc <= 90) || zwKc == 95 {
                    hold zwKw = ""
                    hold zwKrun = 1
                    while zwKrun == 1 {
                      when zwKk >= zwL {
                        hold zwKrun = 0
                      } otherwise {
                        hold zwKc = sx_index(zwT, zwKk)
                        when (zwKc >= 97 && zwKc <= 122) || (zwKc >= 65 && zwKc <= 90) || (zwKc >= 48 && zwKc <= 57) || zwKc == 95 {
                          hold zwKw = concat(zwKw, chr(zwKc))
                          hold zwKk = zwKk + 1
                        } otherwise {
                          hold zwKrun = 0
                        }
                      }
                    }
                    hold zwKs = zwKk
                    hold zwKrun = 1
                    while zwKrun == 1 {
                      when zwKs >= zwL {
                        hold zwKrun = 0
                      } otherwise {
                        hold zwKc = sx_index(zwT, zwKs)
                        when zwKc == 32 || zwKc == 9 || zwKc == 13 {
                          hold zwKs = zwKs + 1
                        } otherwise {
                          hold zwKrun = 0
                        }
                      }
                    }
                    hold zwKiscall = 0
                    when zwKs < zwL {
                      when sx_index(zwT, zwKs) == 40 {
                        hold zwKiscall = 1
                      }
                    }
                    // a declared function has a known return kind
                    hold zwKbk = 0
                    hold zwFkey = concat("|", zwKw)
                    hold zwFkey = concat(zwFkey, "=")
                    hold zwFkl = len(zwFkey)
                    hold zwFl = len(fsret)
                    hold zwFi = 0
                    while zwFi + zwFkl + 1 <= zwFl {
                      hold zwFok = 1
                      hold zwFj = 0
                      while zwFj < zwFkl {
                        hold zwFa = sx_index(fsret, zwFi + zwFj)
                        hold zwFb = sx_index(zwFkey, zwFj)
                        when zwFa == zwFb {
                          hold zwFj = zwFj + 1
                        } otherwise {
                          hold zwFok = 0
                          hold zwFj = zwFkl
                        }
                      }
                      when zwFok == 1 {
                        hold zwFk = sx_index(fsret, zwFi + zwFkl)
                        when zwFk == 115 {
                          hold zwKbk = 115
                        }
                        when zwFk == 108 {
                          hold zwKbk = 108
                        }
                        hold zwFi = zwFl
                      } otherwise {
                        hold zwFi = zwFi + 1
                      }
                    }
                    // is the word itself a generic?  its kind must come from
                    // the call's own argument, never from a return annotation
                    hold zwKgn = 0
                    hold zwGkey = concat(chr(1), zwKw)
                    hold zwGkey = concat(zwGkey, chr(1))
                    hold zwGkl = len(zwGkey)
                    hold zwGl = len(fgnames)
                    hold zwGi = 0
                    while zwGi + zwGkl <= zwGl {
                      hold zwGok = 1
                      hold zwGj = 0
                      while zwGj < zwGkl {
                        hold zwGa = sx_index(fgnames, zwGi + zwGj)
                        hold zwGb = sx_index(zwGkey, zwGj)
                        when zwGa == zwGb {
                          hold zwGj = zwGj + 1
                        } otherwise {
                          hold zwGok = 0
                          hold zwGj = zwGkl
                        }
                      }
                      when zwGok == 1 {
                        hold zwKgn = 1
                        hold zwGi = zwGl
                      } otherwise {
                        hold zwGi = zwGi + 1
                      }
                    }
                    when zwKgn == 1 {
                      hold zwKbk = 0
                    }
                    when zwKiscall == 1 {
                      // the builtins' kinds are fixed
                      when sx_eq(zwKw, "concat") || sx_eq(zwKw, "chr") || sx_eq(zwKw, "read_file") || sx_eq(zwKw, "arg") || sx_eq(zwKw, "read_line") || sx_eq(zwKw, "read_n") || sx_eq(zwKw, "numstr") || sx_eq(zwKw, "sx_cat") || sx_eq(zwKw, "sx_chr") || sx_eq(zwKw, "sx_read") || sx_eq(zwKw, "sx_arg") || sx_eq(zwKw, "sx_read_line") || sx_eq(zwKw, "sx_read_n") || sx_eq(zwKw, "sx_numstr") {
                        hold zwKbk = 115
                      }
                      when sx_eq(zwKw, "push") || sx_eq(zwKw, "sx_lpush") {
                        hold zwKbk = 108
                      }
                      when sx_eq(zwKw, "len") || sx_eq(zwKw, "index") || sx_eq(zwKw, "sx_index") || sx_eq(zwKw, "arg_count") || sx_eq(zwKw, "string_eq") || sx_eq(zwKw, "write_file") || sx_eq(zwKw, "write_out") || sx_eq(zwKw, "flush_out") || sx_eq(zwKw, "gc") || sx_eq(zwKw, "gc_live") || sx_eq(zwKw, "gc_runs") || sx_eq(zwKw, "sx_len") || sx_eq(zwKw, "sx_idx") || sx_eq(zwKw, "sx_argc") || sx_eq(zwKw, "sx_eq") || sx_eq(zwKw, "sx_write") || sx_eq(zwKw, "sx_write_out") || sx_eq(zwKw, "sx_flush_out") || sx_eq(zwKw, "sx_gc_run") || sx_eq(zwKw, "sx_gc_live") || sx_eq(zwKw, "sx_gc_count") {
                        hold zwKbk = 110
                      }
                      when zwKbk != 0 {
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      } otherwise {
                        // a generic (or any other call): look at the first
                        // argument of *this* call
                        hold zwKk = zwKs + 1
                        hold zwKlev = zwKlev + 1
                        hold zwKgo = 1
                        when zwKlev >= 12 {
                          hold zwKind = 110
                          hold zwKdone = 1
                        }
                      }
                    } otherwise {
                      when zwKbk != 0 {
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      } otherwise {
                        // a variable: its declared kind, else a number
                        hold zwKbk = 0
                        hold zwVkey = concat("|", zwKw)
                        hold zwVkey = concat(zwVkey, "|")
                        hold zwVkl = len(zwVkey)
                        hold zwVl = len(sdecls)
                        hold zwVi = 0
                        while zwVi + zwVkl <= zwVl {
                          hold zwVok = 1
                          hold zwVj = 0
                          while zwVj < zwVkl {
                            hold zwVa = sx_index(sdecls, zwVi + zwVj)
                            hold zwVb = sx_index(zwVkey, zwVj)
                            when zwVa == zwVb {
                              hold zwVj = zwVj + 1
                            } otherwise {
                              hold zwVok = 0
                              hold zwVj = zwVkl
                            }
                          }
                          when zwVok == 1 {
                            hold zwKbk = 115
                            hold zwVi = zwVl
                          } otherwise {
                            hold zwVi = zwVi + 1
                          }
                        }
                        hold zwVl = len(ldecls)
                        hold zwVi = 0
                        while zwVi + zwVkl <= zwVl {
                          hold zwVok = 1
                          hold zwVj = 0
                          while zwVj < zwVkl {
                            hold zwVa = sx_index(ldecls, zwVi + zwVj)
                            hold zwVb = sx_index(zwVkey, zwVj)
                            when zwVa == zwVb {
                              hold zwVj = zwVj + 1
                            } otherwise {
                              hold zwVok = 0
                              hold zwVj = zwVkl
                            }
                          }
                          when zwVok == 1 {
                            hold zwKbk = 108
                            hold zwVi = zwVl
                          } otherwise {
                            hold zwVi = zwVi + 1
                          }
                        }
                        when zwKbk == 0 {
                          hold zwKbk = 110
                        }
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      }
                    }
                  }
                  when zwKdone == 0 && zwKgo == 0 {
                    // a number, a parenthesized expression, ...: a number
                    hold zwKind = 110
                    hold zwKdone = 1
                  }
                }
              }
              hold zwAKinds = concat(zwAKinds, chr(zwKind))
              hold zwP = zwP + 1
            }
            hold zwKinds = ""
            hold zwTj = 0
            while zwTj < zwNt {
              hold zwTk = 0
              hold zwFound = 0
              hold zwTp = 0
              while zwTp < zwNP {
                hold zwTv = sx_index(zwTidx, zwTp) - 48
                when zwTv == zwTj {
                  when zwFound == 0 {
                    hold zwTk = zwTp
                    hold zwFound = 1
                  }
                }
                hold zwTp = zwTp + 1
              }
              hold zwKc2 = 110
              when zwTk < len(zwAKinds) {
                hold zwKc2 = sx_index(zwAKinds, zwTk)
              }
              hold zwKinds = concat(zwKinds, chr(zwKc2))
              hold zwTj = zwTj + 1
            }
            hold zwRk = 110
            when zwRi < len(zwKinds) {
              hold zwRk = sx_index(zwKinds, zwRi)
            }
            hold zwOut = concat(zwOut, zwW)
            hold zwOut = concat(zwOut, "__")
            hold zwOut = concat(zwOut, zwKinds)
            hold zwHit = 1
            // request the specialised copy and remember its result kind
            hold gmore = concat(gmore, chr(1))
            hold gmore = concat(gmore, zwW)
            hold gmore = concat(gmore, chr(1))
            hold gmore = concat(gmore, zwKinds)
            hold gmore = concat(gmore, chr(1))
            hold fsret = concat(fsret, zwW)
            hold fsret = concat(fsret, "__")
            hold fsret = concat(fsret, zwKinds)
            hold fsret = concat(fsret, "=")
            hold fsret = concat(fsret, chr(zwRk))
            hold fsret = concat(fsret, "|")
          }
        } otherwise {
          hold zwOut = concat(zwOut, chr(zwC))
          hold zwI = zwI + 1
        }
      }
    }
    when zwHit == 1 {
      hold zwSrc = ""
      hold zwI = 0
      while zwI < pos {
        hold zwSrc = concat(zwSrc, chr(sx_index(source, zwI)))
        hold zwI = zwI + 1
      }
      hold zwSrc = concat(zwSrc, zwOut)
      hold zwI = zwEnd
      while zwI < n {
        hold zwSrc = concat(zwSrc, chr(sx_index(source, zwI)))
        hold zwI = zwI + 1
      }
      hold source = zwSrc
      hold n = len(source)
    }
  }

  // ---- phase 2: one statement ----
  when running == 1 {
    hold c = sx_index(source,pos)
    // per-statement assignment state: `NAME = EXPR`, `NAME.f = EXPR` and
    // `NAME[i] = EXPR` reuse the hold parser (act 1) with asmode = 1
    hold asmode = 0
    hold liset = 0
    hold lidx = ""

    // dispatch on the first character; act is 0 for "not a statement"
    hold act = 0
    when c == 104 {
      hold act = 1
    }
    when c == 115 {
      hold kw = ""
      hold ki = 0
      while ki < 6 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      hold act = 2
      when sx_eq(kw, "struct") {
        hold act = 7
      }
    }
    when c == 119 {
      hold act = 3
    }
    when c == 125 {
      hold act = 4
    }
    // make
    when c == 109 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "make") {
        hold act = 5
        // `make NAME<T>(...)` is a generic: act 15 skips the definition
        // (specialisations are spliced in on demand)
        hold mkg = pos + 4
        hold mknm = ""
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sx_index(source, mkg)
            when mkc == 32 || mkc == 9 {
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sx_index(source, mkg)
            when (mkc >= 97 && mkc <= 122) || (mkc >= 65 && mkc <= 90) || (mkc >= 48 && mkc <= 57) || mkc == 95 {
              hold mknm = concat(mknm, chr(mkc))
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sx_index(source, mkg)
            when mkc == 32 || mkc == 9 {
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkc = 0
        when mkg < n {
          hold mkc = sx_index(source, mkg)
        }
        when mkc == 60 {
          hold act = 15
          hold gskipnm = mknm
        }
      }

    }
    // give
    when c == 103 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "give") {
        hold act = 6
      }
    }

    // ---- statement pre-checks (run before the per-statement blocks) ----
    //  * a statement word must be a WHOLE keyword: `hello = 1` is not `hold`
    //    and `write_file(p, s)` is not `while`.  An unknown statement is a
    //    clear error (its line is skipped), never C that fails to compile.
    //  * bare `push(xs, v)` compiles as `hold xs = push(xs, v)` (act 1 with
    //    bpush = 1); xs must already be a list.
    //  * a hold/show expression with a grouping paren, `(a + 3) * 4`, goes
    //    through the same verbatim-C + `%` rewrite as conditions (act 8).
    hold bpush = 0
    hold pmode = 0
    hold pbad = 0
    hold cmpop = 0
    when (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 {
      hold uword = ""
      hold pp = pos
      hold prun = 1
      while prun == 1 {
        when pp >= n {
          hold prun = 0
        } otherwise {
          hold pc = sx_index(source, pp)
          when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
            hold uword = concat(uword, chr(pc))
            hold pp = pp + 1
          } otherwise {
            hold prun = 0
          }
        }
      }
      hold pok2 = 0
      when sx_eq(uword, "hold") || sx_eq(uword, "show") || sx_eq(uword, "when") || sx_eq(uword, "while") {
        hold pok2 = 1
      }
      when sx_eq(uword, "make") || sx_eq(uword, "give") || sx_eq(uword, "struct") {
        hold pok2 = 1
      }
      when sx_eq(uword, "push") {
        hold pok2 = 2
      }
      // full-language statements: for / break / continue
      when sx_eq(uword, "for") {
        hold pok2 = 3
      }
      when sx_eq(uword, "break") || sx_eq(uword, "continue") {
        hold pok2 = 4
      }
      when pok2 == 2 {
        // bare push(NAME, EXPR)
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pc = 0
        when pp < n {
          hold pc = sx_index(source, pp)
        }
        hold pnm = ""
        when pc == 40 {
          hold pp = pp + 1
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold pc = 0
          when pp < n {
            hold pc = sx_index(source, pp)
          }
          when pc != 44 {
            hold pnm = ""
          }
        }
        when sx_eq(pnm, "") {
          hold pmsg = "push statement: expected push(list, value) with a list variable name first, e.g. push(xs, 4)"
          hold pbad = 1
        } otherwise {
          hold psrc = ldecls
          hold pkey = concat("|", pnm)
          hold pkey = concat(pkey, "|")
          hold pfound = 0
          hold pi2 = 0
          hold pa2 = len(psrc)
          hold pb2 = len(pkey)
          while pi2 + pb2 <= pa2 {
            hold pok2 = 1
            hold pj2 = 0
            while pj2 < pb2 {
              hold pa3 = sx_index(psrc, pi2 + pj2)
              hold pb3 = sx_index(pkey, pj2)
              when pa3 == pb3 {
                hold pj2 = pj2 + 1
              } otherwise {
                hold pok2 = 0
                hold pj2 = pb2
              }
            }
            when pok2 == 1 {
              hold pfound = 1
              hold pi2 = pa2
            } otherwise {
              hold pi2 = pi2 + 1
            }
          }
          when pfound == 1 {
            hold act = 1
            hold bpush = 1
            hold nm = pnm
          } otherwise {
            hold pmsg = concat("push statement: '", pnm)
            hold pmsg = concat(pmsg, "' is not a list; hold it as a list first, e.g. hold xs = []")
            hold pbad = 1
          }
        }
      }
      // (pok2 doubles as scratch in the push search above; a push error
      // has already set pbad, and its message must win)
      when pok2 == 0 && pbad == 0 {
        // an assignment statement: NAME = EXPR, NAME.field = EXPR,
        // NAME[i] = EXPR, or a compound `+= -= *= /= %=`
        hold ap = pp
        hold aok = 0
        hold arun = 1
        while arun == 1 {
          when ap >= n {
            hold arun = 0
          } otherwise {
            hold ac1 = sx_index(source, ap)
            when ac1 == 32 || ac1 == 9 || ac1 == 13 {
              hold ap = ap + 1
            } otherwise {
              when ac1 == 61 {
                hold ac2 = 0
                when ap + 1 < n {
                  hold ac2 = sx_index(source, ap + 1)
                }
                when ac2 == 61 {
                  hold arun = 0
                } otherwise {
                  hold aok = 1
                  hold arun = 0
                }
              } otherwise {
                when ac1 == 43 || ac1 == 45 || ac1 == 42 || ac1 == 47 || ac1 == 37 {
                  hold ac2 = 0
                  when ap + 1 < n {
                    hold ac2 = sx_index(source, ap + 1)
                  }
                  when ac2 == 61 {
                    hold aok = 1
                  }
                  hold arun = 0
                } otherwise {
                  when ac1 == 46 {
                    hold ap = ap + 1
                    hold arun2 = 1
                    while arun2 == 1 {
                      when ap >= n {
                        hold arun2 = 0
                      } otherwise {
                        hold ac2 = sx_index(source, ap)
                        when (ac2 >= 97 && ac2 <= 122) || (ac2 >= 65 && ac2 <= 90) || (ac2 >= 48 && ac2 <= 57) || ac2 == 95 {
                          hold ap = ap + 1
                        } otherwise {
                          hold arun2 = 0
                        }
                      }
                    }
                  } otherwise {
                    when ac1 == 91 {
                      hold abd = 0
                      hold arun2 = 1
                      while arun2 == 1 {
                        when ap >= n {
                          hold arun2 = 0
                        } otherwise {
                          hold ac2 = sx_index(source, ap)
                          when ac2 == 91 {
                            hold abd = abd + 1
                          }
                          when ac2 == 93 {
                            hold abd = abd - 1
                          }
                          hold ap = ap + 1
                          when abd == 0 {
                            hold arun2 = 0
                          }
                        }
                      }
                    } otherwise {
                      hold arun = 0
                    }
                  }
                }
              }
            }
          }
        }
        when aok == 1 {
          hold act = 1
          hold asmode = 1
        } otherwise {
          hold pmsg = concat("unknown statement '", uword)
          hold pmsg = concat(pmsg, "' (statements are hold show when while make give struct, for, while and push(xs, v))")
          hold pbad = 1
        }
      }
      when pbad == 1 {
        // skip the rest of the line; the first such error is reported
        hold act = 9
        hold prun = 1
        while prun == 1 {
          when pos >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pos)
            when pc == 10 {
              hold prun = 0
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      // for NAME in A..B { ... }  ->  act 10 (full language)
      when pok2 == 3 && pbad == 0 {
        hold act = 10
        hold pos = pp
      }
      // break / continue -> act 11 / act 12
      when pok2 == 4 && pbad == 0 {
        when sx_eq(uword, "break") {
          hold act = 11
        } otherwise {
          hold act = 12
        }
        hold pos = pp
      }
    }
    when act == 1 || act == 2 {
      when bpush == 0 {
        hold pp = pos + 4
        // an assignment statement keeps the name at pos (no `hold` keyword);
        // a repeated `hold` of an existing name compiles as an assignment
        when act == 1 && asmode == 1 {
          hold pp = pos
        }
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pnm = ""
        when act == 1 {
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          // optional `: TYPE` annotation (full language)
          hold pc = 0
          when pp < n {
            hold pc = sx_index(source, pp)
          }
          when pc == 58 {
            hold pp = pp + 1
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold aword = ""
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                  hold aword = concat(aword, chr(pc))
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold atype = aword
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
          }
          when pp < n {
            hold pc = sx_index(source, pp)
            when pc == 61 {
              hold pp = pp + 1
            } otherwise {
              // compound assignment: NAME += EXPR (also -= *= /= %=)
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sx_index(source, pp + 1)
              }
              when pc2 == 61 {
                when pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
                  hold cmpop = pc
                  hold pp = pp + 2
                }
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
        }
        // the expression text up to the end of the line (or a // comment);
        // a `(` that does not directly follow a name is a grouping paren
        hold pexpr = ""
        hold phas = 0
        hold pq = 0
        hold pprev = 0
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pq == 1 {
              hold pexpr = concat(pexpr, chr(pc))
              hold pp = pp + 1
              when pc == 92 {
                when pp < n {
                  hold pexpr = concat(pexpr, chr(sx_index(source, pp)))
                  hold pp = pp + 1
                }
              } otherwise {
                when pc == 34 {
                  hold pq = 0
                  hold pprev = 34
                }
              }
            } otherwise {
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sx_index(source, pp + 1)
              }
              when pc == 10 || pc == 13 || (pc == 47 && pc2 == 47) {
                hold prun = 0
              } otherwise {
                when pc == 40 {
                  when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || (pprev >= 48 && pprev <= 57) || pprev == 95 {
                  } otherwise {
                    hold phas = 1
                  }
                }
                when pc == 34 {
                  hold pq = 1
                }
                when pc != 32 && pc != 9 {
                  hold pprev = pc
                }
                hold pexpr = concat(pexpr, chr(pc))
                hold pp = pp + 1
              }
            }
          }
        }
        when phas == 1 {
          hold pmode = act
          hold act = 8
          hold pos = pp
          // trim trailing blanks -> ctrim / cl (the rewrite input)
          hold cl = len(pexpr)
          hold trim = 1
          while trim == 1 {
            when cl <= 0 {
              hold trim = 0
            } otherwise {
              hold pc = sx_index(pexpr, cl - 1)
              when pc == 32 || pc == 9 {
                hold cl = cl - 1
              } otherwise {
                hold trim = 0
              }
            }
          }
          hold ctrim = ""
          hold ci = 0
          while ci < cl {
            hold ctrim = concat(ctrim, chr(sx_index(pexpr, ci)))
            hold ci = ci + 1
          }
          // validate: numbers, numeric names, make-function calls,
          // + - * / %, comparisons, && ||, and balanced parens only
          hold pstk = ""
          hold pprev = 0
          hold pv = 0
          while pv < cl {
            hold pc = sx_index(ctrim, pv)
            hold pc2 = 0
            when pv + 1 < cl {
              hold pc2 = sx_index(ctrim, pv + 1)
            }
            hold pstep = 1
            hold pknown = 0
            when pc == 32 || pc == 9 || pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
              hold pknown = 1
            }
            when (pc >= 48 && pc <= 57) || (pc == 46 && pc2 >= 48 && pc2 <= 57) {
              hold pknown = 1
              hold pv2 = pv
              hold pdot = 0
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when pc3 >= 48 && pc3 <= 57 {
                    hold pv2 = pv2 + 1
                  } otherwise {
                    when pc3 == 46 && pdot == 0 {
                      hold pdot = 1
                      hold pv2 = pv2 + 1
                    } otherwise {
                      hold prun = 0
                    }
                  }
                }
              }
              hold pc3 = 0
              when pv2 < cl {
                hold pc3 = sx_index(ctrim, pv2)
              }
              when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || pc3 == 95 || pc3 == 46 {
                hold pmsg = "malformed number literal"
                hold pbad = 1
              }
              hold pstep = pv2 - pv
              hold pc = 48
            }
            when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || pc == 95 {
              hold pknown = 1
              hold pw = ""
              hold pv2 = pv
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || (pc3 >= 48 && pc3 <= 57) || pc3 == 95 {
                    hold pw = concat(pw, chr(pc3))
                    hold pv2 = pv2 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pstep = pv2 - pv
              hold pv3 = pv2
              hold prun = 1
              while prun == 1 {
                when pv3 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv3)
                  when pc3 == 32 || pc3 == 9 {
                    hold pv3 = pv3 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pc3 = 0
              when pv3 < cl {
                hold pc3 = sx_index(ctrim, pv3)
              }
              when pc3 == 40 {
                hold pok2 = 0
                when sx_eq(pw, "concat") || sx_eq(pw, "len") || sx_eq(pw, "chr") || sx_eq(pw, "sx_index") || sx_eq(pw, "index") || sx_eq(pw, "push") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "read_file") || sx_eq(pw, "write_file") || sx_eq(pw, "arg") || sx_eq(pw, "arg_count") || sx_eq(pw, "string_eq") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_cat") || sx_eq(pw, "sx_len") || sx_eq(pw, "sx_chr") || sx_eq(pw, "sx_idx") || sx_eq(pw, "sx_eq") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_read") || sx_eq(pw, "sx_write") || sx_eq(pw, "sx_arg") || sx_eq(pw, "sx_argc") {
                  hold pok2 = 1
                }
                when pok2 == 1 {
                  hold pmsg = concat("builtin '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold its result in a variable first")
                  hold pbad = 1
                } otherwise {
                  hold psrc = fns
                  hold pkey = concat("static double ", pw)
                  hold pkey = concat(pkey, "(")
                  hold pfound = 0
                  hold pi2 = 0
                  hold pa2 = len(psrc)
                  hold pb2 = len(pkey)
                  while pi2 + pb2 <= pa2 {
                    hold pok2 = 1
                    hold pj2 = 0
                    while pj2 < pb2 {
                      hold pa3 = sx_index(psrc, pi2 + pj2)
                      hold pb3 = sx_index(pkey, pj2)
                      when pa3 == pb3 {
                        hold pj2 = pj2 + 1
                      } otherwise {
                        hold pok2 = 0
                        hold pj2 = pb2
                      }
                    }
                    when pok2 == 1 {
                      hold pfound = 1
                      hold pi2 = pa2
                    } otherwise {
                      hold pi2 = pi2 + 1
                    }
                  }
                  when in_fn == 1 {
                    when sx_eq(pw, fn_name) {
                      hold pfound = 1
                    }
                  }
                  when pfound == 0 {
                    hold pmsg = concat("unknown function '", pw)
                    hold pmsg = concat(pmsg, "' in a parenthesized expression (define it with make first)")
                    hold pbad = 1
                  }
                }
              } otherwise {
                when pc3 == 46 || pc3 == 91 {
                  hold pmsg = concat("a field access or index on '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold the value in a variable first")
                  hold pbad = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "|")
                hold psrc = sdecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                hold pok2 = pfound
                hold psrc = ldecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "=")
                hold psrc = svars
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                when pok2 == 1 {
                  hold pmsg = concat("'", pw)
                  hold pmsg = concat(pmsg, "' is a string, list or struct; a parenthesized expression must be numeric")
                  hold pbad = 1
                }
              }
              hold pc = 97
            }
            when pc == 40 {
              hold pknown = 1
              when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || pprev == 95 {
                hold pstk = concat(pstk, "c")
              } otherwise {
                when pprev == 48 || pprev == 41 {
                  hold pmsg = "a '(' directly after a value; write an operator between them"
                  hold pbad = 1
                }
                hold pstk = concat(pstk, "g")
              }
            }
            when pc == 41 {
              hold pknown = 1
              hold pstl = len(pstk)
              when pstl == 0 {
                hold pmsg = "unbalanced ')' in a parenthesized expression"
                hold pbad = 1
              } otherwise {
                hold pw = ""
                hold pv2 = 0
                while pv2 < pstl - 1 {
                  hold pw = concat(pw, chr(sx_index(pstk, pv2)))
                  hold pv2 = pv2 + 1
                }
                hold pstk = pw
              }
            }
            when pc == 44 {
              hold pknown = 1
              hold pstl = len(pstk)
              hold pc3 = 0
              when pstl > 0 {
                hold pc3 = sx_index(pstk, pstl - 1)
              }
              when pc3 != 99 {
                hold pmsg = "a ',' outside a function call in a parenthesized expression"
                hold pbad = 1
              }
            }
            when pc == 61 || pc == 33 || pc == 38 || pc == 124 {
              hold pknown = 1
              hold pc3 = 61
              when pc == 38 || pc == 124 {
                hold pc3 = pc
              }
              when pc2 == pc3 {
                hold pstep = 2
              } otherwise {
                hold pmsg = "unsupported operator in a parenthesized expression (use == != < <= > >= && ||)"
                hold pbad = 1
              }
            }
            when pc == 60 || pc == 62 {
              hold pknown = 1
              when pc2 == 61 {
                hold pstep = 2
              }
            }
            when pknown == 0 {
              hold pmsg = concat("unexpected '", chr(pc))
              hold pmsg = concat(pmsg, "' in a parenthesized expression (strings, lists, fields and struct literals are not supported inside parentheses by this compiler)")
              hold pbad = 1
            }
            when pc != 32 && pc != 9 {
              hold pprev = pc
            }
            hold pv = pv + pstep
            // the first problem found is the one reported
            when pbad == 1 && perr == 0 {
              hold perr = 1
              hold permsg = pmsg
            }
          }
          when sx_eq(pstk, "") {
          } otherwise {
            hold pmsg = "unbalanced '(' in a parenthesized expression"
            hold pbad = 1
          }
        }
      }
    }
    when pbad == 1 {
      when perr == 0 {
        hold permsg = pmsg
      }
      hold perr = 1
    }


    // ================= hold NAME = RHS =================
    when act == 1 {
      hold declk = -1
      hold declt = ""
      // bare push(xs, v): nm is already set and pos sits on `push`
      when bpush == 0 {
        when asmode == 0 {
          hold pos = pos + 4
        }
        // blank skip
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // name
        hold nm = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm = concat(nm, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        // assignment target: an optional `.field` / `[index]` chain is
        // copied verbatim (a pure-min struct field or list element)
        hold sufx = ""
        hold srun = 1
        while srun == 1 {
          hold srun = 0
          when pos < n {
            hold sc = sx_index(source, pos)
            when sc == 46 {
              hold srun2 = 1
              while srun2 == 1 {
                when pos >= n {
                  hold srun2 = 0
                } otherwise {
                  hold sc = sx_index(source, pos)
                  when (sc >= 97 && sc <= 122) || (sc >= 65 && sc <= 90) || (sc >= 48 && sc <= 57) || sc == 95 || sc == 46 {
                    hold sufx = concat(sufx, chr(sc))
                    hold pos = pos + 1
                  } otherwise {
                    hold srun2 = 0
                  }
                }
              }
              hold srun = 1
            } otherwise {
              when sc == 91 {
                // `NAME[i] = v` becomes `NAME = sx_lset(NAME, i, v)`
                hold pos = pos + 1
                hold sbd = 0
                hold srun2 = 1
                while srun2 == 1 {
                  when pos >= n {
                    hold srun2 = 0
                  } otherwise {
                    hold sc = sx_index(source, pos)
                    when sc == 91 {
                      hold sbd = sbd + 1
                    }
                    when sc == 93 {
                      when sbd == 0 {
                        hold srun2 = 0
                      }
                      hold sbd = sbd - 1
                    }
                    when srun2 == 1 {
                      hold lidx = concat(lidx, chr(sc))
                      hold pos = pos + 1
                    }
                  }
                }
                when pos < n {
                  hold pos = pos + 1
                }
                hold liset = 1
                hold srun = 1
              }
            }
          }
        }
        // optional `: TYPE` annotation (full language): the declared kind
        // is checked against the value's kind below
        hold pc = 0
        when pos < n {
          hold pc = sx_index(source,pos)
        }
        when pc == 58 {
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold declt = ""
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || (cs >= 48 && cs <= 57) || cs == 95 {
                hold declt = concat(declt, chr(cs))
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold dtok2 = 0
          when sx_eq(declt, "str") || sx_eq(declt, "string") {
            hold declk = 1
            hold dtok2 = 1
          }
          when sx_eq(declt, "list") {
            hold declk = 2
            hold dtok2 = 1
          }
          when sx_eq(declt, "num") || sx_eq(declt, "number") || sx_eq(declt, "bool") || sx_eq(declt, "double") {
            hold declk = 0
            hold dtok2 = 1
          }
          when dtok2 == 0 {
            // a struct type name
            hold declk = 3
          }
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
        }
        // blanks then '=' (or a compound operator: `+= -= *= /= %=`)
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              when cs == 61 {
                hold pos = pos + 1
              } otherwise {
                hold cs2 = 0
                when pos + 1 < n {
                  hold cs2 = sx_index(source,pos + 1)
                }
                when cs2 == 61 {
                  when cs == 43 || cs == 45 || cs == 42 || cs == 47 || cs == 37 {
                    hold cmpop = cs
                    hold pos = pos + 2
                  }
                }
              }
              hold sk = 0
            }
          }
        }
        // blanks after the assignment operator
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // a compound assignment always targets an existing variable, and
        // the operator itself decides the kind (num vs str) so the shared
        // compound emit below can build `x = x op EXPR`
        when cmpop != 0 {
          hold found2 = 0
          hold k2 = concat("|", nm)
          hold k2 = concat(k2, "|")
          hold d2i = 0
          hold d2l = len(decls)
          hold k2l = len(k2)
          while d2i + k2l <= d2l {
            hold ok2 = 1
            hold j2 = 0
            while j2 < k2l {
              hold aa2 = sx_index(decls, d2i + j2)
              hold bb2 = sx_index(k2, j2)
              when aa2 == bb2 {
                hold j2 = j2 + 1
              } otherwise {
                hold ok2 = 0
                hold j2 = k2l
              }
            }
            when ok2 == 1 {
              hold found2 = 1
              hold d2i = d2l
            } otherwise {
              hold d2i = d2i + 1
            }
          }
          when found2 == 0 {
            hold nerrscop = 1
            when sx_eq(scopmsg, "") {
              hold scopmsg = concat("compound assignment to undeclared '", nm)
              hold scopmsg = concat(scopmsg, "'; declare it with hold first")
            }
          }
        }
        // blanks
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }

      // ---------- right hand side ----------
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }


      // RHS: string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sx_index(source,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // backslash escapes the next char: keep BOTH, so \"
                // does not terminate the literal
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sx_index(source,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
        hold rt = 1
      }


      // list literal [e, e, ...]
      when c1 == 91 {
        hold pos = pos + 1
        hold lelems = ""
        hold nels = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sx_index(source,pos)
          when cs != 93 {
            hold lr = 1
            while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold el = ""
              hold ec = 0
              when pos < n {
                hold ec = sx_index(source,pos)
              }
              when (ec >= 48 && ec <= 57) || ec == 45 {
                when ec == 45 {
                  hold el = "-"
                  hold pos = pos + 1
                }
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cd = sx_index(source,pos)
                    // a `.` followed by a digit continues the number (2.5)
                    hold cdn = 0
                    when pos + 1 < n {
                      hold cdn = sx_index(source,pos + 1)
                    }
                    when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                      hold el = concat(el, chr(cd))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              } otherwise {
                when (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) {
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sx_index(source,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold el = concat(el, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                }
              }
              // list elements are numbers: a string, list or struct variable
              // (or anything that is not a number or a name) is a clear error
              // instead of invalid C such as sx_llit(1,(double)(p))
              hold lbad = 0
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when sx_eq(el, "") {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = "list elements must be numbers or numeric variables (a list cannot hold a string, list or struct)"
                }
                hold perr = 1
              }
              when nels > 0 {
                hold lelems = concat(lelems, ",")
              }
              hold lelems = concat(lelems, "(double)(")
              hold lelems = concat(lelems, el)
              hold lelems = concat(lelems, ")")
              hold nels = nels + 1
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos < n {
                hold cs = sx_index(source,pos)
                when cs == 44 {
                  hold pos = pos + 1
                } otherwise {
                  hold lr = 0
                }
              } otherwise {
                hold lr = 0
              }
            }
          }
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sx_index(source,pos)
          when cs == 93 {
            hold pos = pos + 1
          }
        }
        // the element count in decimal (chr(48 + nels) broke at 10 elements)
        hold lnum = nels
        hold lcount = ""
        when lnum == 0 {
          hold lcount = "0"
        }
        while lnum > 0 {
          hold ldig = lnum % 10
          hold ltmp = chr(48 + ldig)
          hold lcount = concat(ltmp, lcount)
          hold lnum = lnum - ldig
          hold lnum = lnum / 10
        }
        hold rhs = "sx_llit("
        hold rhs = concat(rhs, lcount)
        when nels > 0 {
          hold rhs = concat(rhs, ",")
          hold rhs = concat(rhs, lelems)
        }
        hold rhs = concat(rhs, ")")
        hold rk = 2
        hold lt = 1
      }

      // RHS: number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sx_index(source,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sx_index(source,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // RHS: name, name + number, or call(...)
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) {
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }

        // ---- struct literal Name { vals } ----
        when c2 == 123 {
          // is nm2 a known struct?
          hold sfind2 = 0
          hold di = 0
          hold dl = len(sdefs)
          hold kl = len(nm2)
          while di < dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              when di + j >= dl {
                hold ok = 0
                hold j = kl
              } otherwise {
                hold aa = sx_index(sdefs, di + j)
                hold bb = sx_index(nm2, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
            }
            when ok == 1 {
              when di + kl < dl {
                hold aa = sx_index(sdefs, di + kl)
                when aa == 58 {
                  hold sfind2 = 1
                  hold sfpos = di
                  hold di = dl
                } otherwise {
                  hold di = di + 1
                }
              } otherwise {
                hold di = di + 1
              }
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind2 == 1 {
            hold pos = pos + 1
            hold lelems = ""
            hold nels = 0
            // Field names are walked in sdefs order (fpos..): each value must
            // be given in declaration order, a label (if present) must name
            // that field, and every field must be filled -- a short or
            // reordered literal is reported, never silently reshaped.
            hold fpos = sfpos + kl + 1
            hold fnf = 1
            hold fscan = fpos
            hold fsn = len(sdefs)
            hold frun = 1
            while frun == 1 {
              when fscan >= fsn {
                hold frun = 0
              } otherwise {
                hold fc = sx_index(sdefs, fscan)
                when fc == 59 {
                  hold frun = 0
                } otherwise {
                  when fc == 44 {
                    hold fnf = fnf + 1
                  }
                  hold fscan = fscan + 1
                }
              }
            }
            hold lr = 1
            while lr == 1 {
              // The walk re-enters itself for nested struct literals: each
              // `Name { ... }` value pushes this level's state on nstack and
              // restarts the walk for the inner struct; closing the inner
              // literal pops the frame and hands the text back as the value,
              // so the outer walk continues exactly where it left off.
              hold lr = 1
              while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos >= n {
                hold lr = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                hold savep2 = pos
                when cs == 125 {
                  hold pos = pos + 1
                  hold lr = 0
                } otherwise {
                  // ---- optional field label ----
                  hold lb = ""
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sx_index(source,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold lb = concat(lb, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sx_index(source,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold lbl = 0
                  when pos < n {
                    hold cs2 = sx_index(source,pos)
                    when cs2 == 58 {
                      hold pos = pos + 1
                      hold lbl = 1
                    }
                  }
                  when lbl == 0 {
                    // no label: what was read is the value itself
                    hold pos = savep2
                  }
                  // ---- the field this value has to fill ----
                  hold fname = ""
                  hold fkx = 0
                  hold fscan = fpos
                  hold frun = 1
                  while frun == 1 {
                    when fscan >= fsn {
                      hold frun = 0
                    } otherwise {
                      hold fc = sx_index(sdefs, fscan)
                      when fc == 44 || fc == 59 {
                        when fkx == nels {
                          hold frun = 0
                        } otherwise {
                          hold fkx = fkx + 1
                          hold fscan = fscan + 1
                        }
                      } otherwise {
                        when fkx == nels {
                          hold fname = concat(fname, chr(fc))
                        }
                        hold fscan = fscan + 1
                      }
                    }
                  }
                  when lbl == 1 {
                    hold lsame = sx_eq(lb, fname)
                    when lsame == 0 {
                      hold exbad7 = 1
                    }
                  }
                  // ---- value: number, string literal or a name ----
                  hold el = ""
                  hold ety = 0
                  hold isnest = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sx_index(source,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold ec = 0
                  when pos < n {
                    hold ec = sx_index(source,pos)
                  }
                  when (ec >= 48 && ec <= 57) || ec == 45 {
                    when ec == 45 {
                      hold el = "-"
                      hold pos = pos + 1
                    }
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        // a `.` followed by a digit continues the number (2.5)
                        hold cdn = 0
                        when pos + 1 < n {
                          hold cdn = sx_index(source,pos + 1)
                        }
                        when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                  }
                  // string literal value (escapes kept)
                  when ec == 34 {
                    hold ety = 1
                    hold pos = pos + 1
                    hold el = q
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        when cd == 34 {
                          hold pos = pos + 1
                          hold el = concat(el, q)
                          hold rn = 0
                        } otherwise {
                          when cd == 92 {
                            hold el = concat(el, bs)
                            hold pos = pos + 1
                            when pos < n {
                              hold cd2 = sx_index(source,pos)
                              hold el = concat(el, chr(cd2))
                              hold pos = pos + 1
                            }
                          } otherwise {
                            hold el = concat(el, chr(cd))
                            hold pos = pos + 1
                          }
                        }
                      }
                    }
                  }
                  // name value: a name tracked as a string is a string
                  when (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) {
                    hold el = ""
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        when (cd >= 97 && cd <= 122) || (cd >= 65 && cd <= 90) || (cd >= 48 && cd <= 57) || cd == 95 {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                    hold ety = 0
                    hold nkey = concat("|", el)
                    hold nkey = concat(nkey, "|")
                    hold ndi = 0
                    hold ndl = len(sdecls)
                    hold nkl = len(nkey)
                    while ndi + nkl <= ndl {
                      hold nok = 1
                      hold nj = 0
                      while nj < nkl {
                        hold naa = sx_index(sdecls, ndi + nj)
                        hold nbb = sx_index(nkey, nj)
                        when naa == nbb {
                          hold nj = nj + 1
                        } otherwise {
                          hold nok = 0
                          hold nj = nkl
                        }
                      }
                      when nok == 1 {
                        hold ety = 1
                        hold ndi = ndl
                      } otherwise {
                        hold ndi = ndi + 1
                      }
                    }
                  }
                  // ---- nested struct literal value: Name { ... } ----
                  // When the value is a known struct name followed by '{',
                  // descend into it: push this level's state on nstack and
                  // re-run the same walk for the inner struct.  The inner
                  // level's text is handed back as this value when it closes
                  // (see the pop after the walk).
                  hold etyname = ""
                  hold pushed = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs3 = sx_index(source,pos)
                      when cs3 == 32 || cs3 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold cs3 = 0
                  when pos < n {
                    hold cs3 = sx_index(source,pos)
                  }
                  when cs3 == 123 {
                    // is el a known struct?
                    hold sfind2 = 0
                    hold di = 0
                    hold dl = len(sdefs)
                    hold kl = len(el)
                    while di < dl {
                      hold ok = 1
                      hold j = 0
                      while j < kl {
                        when di + j >= dl {
                          hold ok = 0
                          hold j = kl
                        } otherwise {
                          hold aa = sx_index(sdefs, di + j)
                          hold bb = sx_index(el, j)
                          when aa == bb {
                            hold j = j + 1
                          } otherwise {
                            hold ok = 0
                            hold j = kl
                          }
                        }
                      }
                      when ok == 1 {
                        when di + kl < dl {
                          hold aa = sx_index(sdefs, di + kl)
                          when aa == 58 {
                            hold sfind2 = 1
                            hold sfposin = di
                            hold di = dl
                          } otherwise {
                            hold di = di + 1
                          }
                        } otherwise {
                          hold di = di + 1
                        }
                      } otherwise {
                        hold di = di + 1
                      }
                    }
                    hold doskip = 0
                    when sfind2 == 1 {
                      // dependency order: the nested struct must be declared
                      // before the struct that nests it (typedef order)
                      hold klnm2 = len(nm2)
                        hold sfposcur = fpos - klnm2 - 1
                      when sfposin > sfposcur {
                        hold nerrfwd = 1
                        hold nfwdin = el
                        hold nfwdout = nm2
                        hold doskip = 1
                      }
                    } otherwise {
                      // Name { with an unknown struct name: clear error,
                      // skip the balanced span so the outer walk stays in
                      // sync and no follow-up errors are reported
                      hold nerrunk = 1
                      hold nunknm = el
                      hold doskip = 1
                    }
                    when doskip == 1 {
                      hold isnest = 1
                      hold nst = 1
                      hold ins = 0
                      hold pos = pos + 1
                      while nst > 0 {
                        when pos >= n {
                          hold nst = 0
                        } otherwise {
                          hold cd3 = sx_index(source,pos)
                          when ins == 1 {
                            when cd3 == 92 {
                              hold pos = pos + 1
                            } otherwise {
                              when cd3 == 34 {
                                hold ins = 0
                              }
                            }
                          } otherwise {
                            when cd3 == 34 {
                              hold ins = 1
                            } otherwise {
                              when cd3 == 123 {
                                hold nst = nst + 1
                              } otherwise {
                                when cd3 == 125 {
                                  hold nst = nst - 1
                                }
                              }
                            }
                          }
                          hold pos = pos + 1
                        }
                      }
                    } otherwise {
                      // push this level's frame (nm2, lelems, nels) and
                      // re-enter the walk for the inner struct
                      hold pushed = 1
                      hold dtext = ""
                      hold dd = nels
                      when dd == 0 {
                        hold dtext = "0"
                      }
                      hold drun = 1
                      while drun == 1 {
                        when dd <= 0 {
                          hold drun = 0
                        } otherwise {
                          hold drem = dd % 10
                          hold dtext = concat(chr(48 + drem), dtext)
                          hold dd = dd - drem
                          hold dd = dd / 10
                        }
                      }
                      hold nstack = concat(nstack, nm2)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, lelems)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, dtext)
                      hold nstack = concat(nstack, nsep)
                      hold nm2 = el
                      hold el = ""
                      hold lelems = ""
                      hold nels = 0
                      hold klnm2 = len(nm2)
                      hold fpos = sfposin + klnm2 + 1
                      hold fnf = 1
                      hold fscan = fpos
                      hold fsn = len(sdefs)
                      hold frun = 1
                      while frun == 1 {
                        when fscan >= fsn {
                          hold frun = 0
                        } otherwise {
                          hold fc = sx_index(sdefs, fscan)
                          when fc == 59 {
                            hold frun = 0
                          } otherwise {
                            when fc == 44 {
                              hold fnf = fnf + 1
                            }
                            hold fscan = fscan + 1
                          }
                        }
                      }
                      hold pos = pos + 1
                    }
                  }
                  when pushed == 0 {
                  // ---- record the field type: the first literal wins ----
                  hold fkey = concat("|", nm2)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, fname)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  hold fnamelen = len(fname)
                  when (fnamelen > 0) && (isnest == 0) {
                    when fprv == -1 {
                      hold ftypes = concat(ftypes, fkey)
                      when ety == 2 {
                        hold ftypes = concat(ftypes, "2:")
                        hold ftypes = concat(ftypes, etyname)
                        hold ftypes = concat(ftypes, "|")
                      } otherwise {
                        when ety == 1 {
                          hold ftypes = concat(ftypes, "1|")
                        } otherwise {
                          hold ftypes = concat(ftypes, "0|")
                        }
                      }
                    } otherwise {
                      when fprv != ety {
                        hold exbad6 = 1
                      }
                      when ety == 2 {
                        when fprv == 2 {
                          hold sames = sx_eq(fpname, etyname)
                          when sames == 0 {
                            hold exbad6 = 1
                          }
                        }
                      }
                    }
                    when ety == 1 {
                      // `varname.field` reads as a string from now on
                      // (only for the struct the variable itself is)
                      when sx_eq(nstack, "") == 1 {
                        hold sfnew = concat("|", nm)
                        hold sfnew = concat(sfnew, ".")
                        hold sfnew = concat(sfnew, fname)
                        hold sfnew = concat(sfnew, "|")
                        hold sflds = concat(sflds, sfnew)
                      }
                    }
                  }
                  when nels > 0 {
                    hold lelems = concat(lelems, ",")
                  }
                  hold lelems = concat(lelems, el)
                  hold nels = nels + 1
                  // progress guard: a value must consume at least one char
                  when pos == savep2 {
                    hold exbad = 1
                    hold pos = pos + 1
                  }
                  }
                }
              }
              }
              when nels != fnf {
                hold exbad8 = 1
              }
              // text of the literal at this level
              hold lvtxt = "(("
              hold lvtxt = concat(lvtxt, nm2)
              hold lvtxt = concat(lvtxt, "){")
              hold lvtxt = concat(lvtxt, lelems)
              hold lvtxt = concat(lvtxt, "})")
              when sx_eq(nstack, "") == 0 {
                // this level was nested in another literal: pop the outer
                // frame, record the field type, append this level's text as
                // the value, and continue the outer walk
                hold slen = len(nstack)
                hold pi = slen - 1
                hold p2 = pi - 1
                hold p2stop = -1
                hold dt = ""
                while p2 >= 0 {
                  hold chdv = sx_index(nstack, p2)
                  when chdv >= 48 {
                    when chdv <= 57 {
                      hold dt = concat(chr(chdv), dt)
                      hold p2 = p2 - 1
                    } otherwise {
                      hold p2stop = p2
                      hold p2 = -1
                    }
                  } otherwise {
                    hold p2stop = p2
                    hold p2 = -1
                  }
                }
                hold o_nels = 0
                hold di2 = 0
                hold dl2 = len(dt)
                while di2 < dl2 {
                  hold chdv = sx_index(dt, di2)
                  hold chdv = chdv - 48
                  hold o_nels = o_nels * 10 + chdv
                  hold di2 = di2 + 1
                }
                hold p3 = p2stop - 1
                hold lt2 = ""
                hold p3stop = -1
                while p3 >= 0 {
                  hold chdv = sx_index(nstack, p3)
                  when chdv == 1 {
                    hold p3stop = p3
                    hold p3 = -1
                  } otherwise {
                    hold lt2 = concat(chr(chdv), lt2)
                    hold p3 = p3 - 1
                  }
                }
                hold p4 = p3stop - 1
                hold nt2 = ""
                hold p4stop = -1
                while p4 >= 0 {
                  hold chdv = sx_index(nstack, p4)
                  when chdv == 1 {
                    hold p4stop = p4
                    hold p4 = -1
                  } otherwise {
                    hold nt2 = concat(chr(chdv), nt2)
                    hold p4 = p4 - 1
                  }
                }
                // truncate the popped frame from the stack: keep everything
                // up to (and including) the separator that preceded it
                hold nn = ""
                hold di2 = 0
                while di2 <= p4stop {
                  hold nn = concat(nn, chr(sx_index(nstack, di2)))
                  hold di2 = di2 + 1
                }
                hold nstack = nn
                hold el = lvtxt
                hold ety = 2
                hold etyname = nm2
                hold nm2 = nt2
                hold lelems = lt2
                hold nels = o_nels
                // restore this level's field walk state
                hold sfind2 = 0
                hold di = 0
                hold dl = len(sdefs)
                hold kl = len(nm2)
                while di < dl {
                  hold ok = 1
                  hold j = 0
                  while j < kl {
                    when di + j >= dl {
                      hold ok = 0
                      hold j = kl
                    } otherwise {
                      hold aa = sx_index(sdefs, di + j)
                      hold bb = sx_index(nm2, j)
                      when aa == bb {
                        hold j = j + 1
                      } otherwise {
                        hold ok = 0
                        hold j = kl
                      }
                    }
                  }
                  when ok == 1 {
                    when di + kl < dl {
                      hold aa = sx_index(sdefs, di + kl)
                      when aa == 58 {
                        hold sfind2 = 1
                        hold sfposin = di
                        hold di = dl
                      } otherwise {
                        hold di = di + 1
                      }
                    } otherwise {
                      hold di = di + 1
                    }
                  } otherwise {
                    hold di = di + 1
                  }
                }
                when sfind2 == 1 {
                  hold fpos = sfposin + kl + 1
                } otherwise {
                  hold fpos = len(sdefs)
                }
                hold fnf = 1
                hold fscan = fpos
                hold fsn = len(sdefs)
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 59 {
                      hold frun = 0
                    } otherwise {
                      when fc == 44 {
                        hold fnf = fnf + 1
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                // the field this value fills (index nels)
                hold fname = ""
                hold fkx = 0
                hold fscan = fpos
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 44 || fc == 59 {
                      when fkx == nels {
                        hold frun = 0
                      } otherwise {
                        hold fkx = fkx + 1
                        hold fscan = fscan + 1
                      }
                    } otherwise {
                      when fkx == nels {
                        hold fname = concat(fname, chr(fc))
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                // record |nm2.fname=2:etyname| (the first literal wins)
                hold fkey = concat("|", nm2)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, fname)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  hold ftypes = concat(ftypes, fkey)
                  hold ftypes = concat(ftypes, "2:")
                  hold ftypes = concat(ftypes, etyname)
                  hold ftypes = concat(ftypes, "|")
                } otherwise {
                  when fprv != 2 {
                    hold exbad6 = 1
                  }
                  hold sames = sx_eq(fpname, etyname)
                  when sames == 0 {
                    hold exbad6 = 1
                  }
                }
                when nels > 0 {
                  hold lelems = concat(lelems, ",")
                }
                hold lelems = concat(lelems, el)
                hold nels = nels + 1
                hold lr = 1
              } otherwise {
                hold rhs = lvtxt
                hold rk = 3
                hold stname = nm2
                hold iscall = 2
              }
            }
          }
        }

        // ---- call(...) ----
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sx_index(source,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sx_index(source,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when cn == 32 || cn == 9 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          // which builtin?
          // ---- '%' inside builtin-call argument text: sx_mod(L, R) ----
          // Same rule as the shared condition rewrite: L is the * / %
          // chain to the left (balanced groups included), R is the next
          // atom (name, number, .field, [i], (..)). argv_txt has no blanks
          // outside string literals, so no blank handling is needed here.
          hold axo = ""
          hold axi = 0
          hold axn = len(argv_txt)
          hold axc = 0
          hold axq = 0
          hold axal = 0
          hold axrun = 0
          hold axd = 0
          hold axbd = 0
          hold axe = 0
          hold axri = 0
          hold axnb = 0
          hold axf = 0
          hold axg = 0
          hold axL = ""
          hold axR = ""
          hold axj = 0
          hold axP = ""
          while axi < axn {
            hold axc = sx_index(argv_txt, axi)
            when axc == 34 {
              // string literal: copy verbatim, escapes kept
              hold axo = concat(axo, chr(34))
              hold axi = axi + 1
              hold axq = 1
              while axq == 1 && axi < axn {
                hold axc = sx_index(argv_txt, axi)
                hold axo = concat(axo, chr(axc))
                hold axi = axi + 1
                when axc == 92 && axi < axn {
                  hold axo = concat(axo, chr(sx_index(argv_txt, axi)))
                  hold axi = axi + 1
                } otherwise {
                  when axc == 34 {
                    hold axq = 0
                  }
                }
              }
            } otherwise {
              when axc == 37 {
                // left operand: scan back over the chain already in axo
                hold axal = len(axo)
                hold axrun = 1
                while axrun == 1 {
                  hold axrun = 0
                  when axal > 0 {
                    hold axd = sx_index(axo, axal - 1)
                    when axd == 41 || axd == 93 {
                      // skip a balanced (..) or [..] group, then keep going
                      hold axbd = 1
                      hold axal = axal - 1
                      while axbd > 0 {
                        when axal <= 0 {
                          hold axbd = 0
                        } otherwise {
                          hold axe = sx_index(axo, axal - 1)
                          when axe == 41 || axe == 93 {
                            hold axbd = axbd + 1
                          }
                          when axe == 40 || axe == 91 {
                            hold axbd = axbd - 1
                          }
                          hold axal = axal - 1
                        }
                      }
                      hold axrun = 1
                    } otherwise {
                      when (axd >= 97 && axd <= 122) || (axd >= 65 && axd <= 90) || (axd >= 48 && axd <= 57) || axd == 95 || axd == 46 || axd == 42 || axd == 47 {
                        hold axal = axal - 1
                        hold axrun = 1
                      }
                    }
                  }
                }
                // right operand: the next atom in argv_txt
                hold axri = axi + 1
                hold axnb = 1
                while axnb == 1 && axri < axn {
                  hold axnb = 0
                  hold axf = sx_index(argv_txt, axri)
                  when (axf >= 97 && axf <= 122) || (axf >= 65 && axf <= 90) || (axf >= 48 && axf <= 57) || axf == 95 || axf == 46 {
                    hold axri = axri + 1
                    hold axnb = 1
                  } otherwise {
                    when axf == 40 || axf == 91 {
                      hold axbd = 1
                      hold axri = axri + 1
                      while axbd > 0 && axri < axn {
                        hold axg = sx_index(argv_txt, axri)
                        when axg == 40 || axg == 91 {
                          hold axbd = axbd + 1
                        }
                        when axg == 41 || axg == 93 {
                          hold axbd = axbd - 1
                        }
                        hold axri = axri + 1
                      }
                      hold axnb = 1
                    }
                  }
                }
                // rebuild: the left chain is replaced by sx_mod(L, R)
                hold axL = ""
                hold axj = axal
                while axj < len(axo) {
                  hold axL = concat(axL, chr(sx_index(axo, axj)))
                  hold axj = axj + 1
                }
                hold axR = ""
                hold axj = axi + 1
                while axj < axri {
                  hold axR = concat(axR, chr(sx_index(argv_txt, axj)))
                  hold axj = axj + 1
                }
                hold axP = ""
                hold axj = 0
                while axj < axal {
                  hold axP = concat(axP, chr(sx_index(axo, axj)))
                  hold axj = axj + 1
                }
                hold axo = axP
                hold axo = concat(axo, "sx_mod(")
                hold axo = concat(axo, axL)
                hold axo = concat(axo, ",")
                hold axo = concat(axo, axR)
                hold axo = concat(axo, ")")
                hold axi = axri
              } otherwise {
                hold axo = concat(axo, chr(axc))
                hold axi = axi + 1
              }
            }
          }
          hold argv_txt = axo
          // Normalize builtin identifiers inside argument text for nested calls.
          hold argv_c = ""
          hold ai = 0
          hold al = len(argv_txt)
          hold arun = 1
          hold argv_q = 0
          while arun == 1 {
            when ai >= al {
              hold arun = 0
            } otherwise {
              hold ac = sx_index(argv_txt,ai)
              when argv_q == 1 {
                hold argv_c = concat(argv_c, chr(ac))
                when ac == 34 {
                  hold argv_q = 0
                }
                hold ai = ai + 1
              } otherwise {
              hold islet = 0
              when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || ac == 95 {
                hold islet = 1
              }
              when islet == 1 {
                hold atok = ""
                hold tokrun = 1
                while tokrun == 1 {
                  when ai >= al {
                    hold tokrun = 0
                  } otherwise {
                    hold ac = sx_index(argv_txt,ai)
                    when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || (ac >= 48 && ac <= 57) || ac == 95 {
                      hold atok = concat(atok, chr(ac))
                      hold ai = ai + 1
                    } otherwise {
                      hold tokrun = 0
                    }
                  }
                }
                // Only rewrite a builtin word when it is really a call: a
                // variable named `index`, `len`, `arg`, ... inside argument
                // text must stay a variable.  Without this check
                // `sx_idx(index, ...)` was rewritten to `sx_idx(sx_idx, ...)`
                // and the generated C silently did the wrong thing (it made
                // tools/sxpkg.sa's own `search` never match).
                hold amap = 0
                hold acall = 0
                hold aix = ai
                hold ask = 1
                while ask == 1 {
                  when aix >= al {
                    hold ask = 0
                  } otherwise {
                    hold acx = sx_index(argv_txt, aix)
                    when acx == 32 || acx == 9 || acx == 13 {
                      hold aix = aix + 1
                    } otherwise {
                      hold ask = 0
                    }
                  }
                }
                when aix < al {
                  when sx_index(argv_txt, aix) == 40 {
                    hold acall = 1
                  }
                }
                when acall == 1 {
                  when sx_eq(atok, "concat") {
                    hold argv_c = concat(argv_c, "sx_cat")
                    hold amap = 1
                  }
                  when sx_eq(atok, "len") {
                    hold argv_c = concat(argv_c, "sx_len")
                    hold amap = 1
                  }
                  when sx_eq(atok, "sx_index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "chr") {
                    hold argv_c = concat(argv_c, "sx_chr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_file") {
                    hold argv_c = concat(argv_c, "sx_read")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_file") {
                    hold argv_c = concat(argv_c, "sx_write")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg") {
                    hold argv_c = concat(argv_c, "sx_arg")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg_count") {
                    hold argv_c = concat(argv_c, "sx_argc")
                    hold amap = 1
                  }
                  when sx_eq(atok, "string_eq") {
                    hold argv_c = concat(argv_c, "sx_eq")
                    hold amap = 1
                  }
                  when sx_eq(atok, "push") {
                    hold argv_c = concat(argv_c, "sx_lpush")
                    hold amap = 1
                  }
                  when sx_eq(atok, "numstr") {
                    hold argv_c = concat(argv_c, "sx_numstr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_line") {
                    hold argv_c = concat(argv_c, "sx_read_line")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_n") {
                    hold argv_c = concat(argv_c, "sx_read_n")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_out") {
                    hold argv_c = concat(argv_c, "sx_write_out")
                    hold amap = 1
                  }
                  when sx_eq(atok, "flush_out") {
                    hold argv_c = concat(argv_c, "sx_flush_out")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc") {
                    hold argv_c = concat(argv_c, "sx_gc_run")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc_live") {
                    hold argv_c = concat(argv_c, "sx_gc_live")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc_runs") {
                    hold argv_c = concat(argv_c, "sx_gc_count")
                    hold amap = 1
                  }
                }
                when amap == 0 {
                  hold argv_c = concat(argv_c, atok)
                }
              } otherwise {
                when ac == 34 {
                  hold argv_q = 1
                }
                hold argv_c = concat(argv_c, chr(ac))
                hold ai = ai + 1
              }
              }
            }
          }
          hold fk = 0
          when sx_eq(nm2, "concat") {
            hold fk = 1
          }
          when sx_eq(nm2, "len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_index") {
            hold fk = 3
          }
          when sx_eq(nm2, "chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "read_file") {
            hold fk = 5
          }
          when sx_eq(nm2, "write_file") {
            hold fk = 6
          }
          when sx_eq(nm2, "arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "arg_count") {
            hold fk = 8
          }
          when sx_eq(nm2, "string_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "sx_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "gc") || sx_eq(nm2, "sx_gc_run") {
            hold fk = 12
          }
          when sx_eq(nm2, "gc_live") || sx_eq(nm2, "sx_gc_live") {
            hold fk = 13
          }
          when sx_eq(nm2, "gc_runs") || sx_eq(nm2, "sx_gc_count") {
            hold fk = 14
          }
          when sx_eq(nm2, "read_line") || sx_eq(nm2, "sx_read_line") {
            hold fk = 15
          }
          when sx_eq(nm2, "read_n") || sx_eq(nm2, "sx_read_n") {
            hold fk = 16
          }
          when sx_eq(nm2, "write_out") || sx_eq(nm2, "sx_write_out") {
            hold fk = 17
          }
          when sx_eq(nm2, "flush_out") || sx_eq(nm2, "sx_flush_out") {
            hold fk = 18
          }
          when sx_eq(nm2, "numstr") || sx_eq(nm2, "sx_numstr") {
            hold fk = 19
          }
          when sx_eq(nm2, "push") {
            hold fk = 10
          }
          when sx_eq(nm2, "sx_cat") {
            hold fk = 1
          }
          when sx_eq(nm2, "sx_len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_idx") {
            hold fk = 3
          }
          when sx_eq(nm2, "sx_chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "sx_read") {
            hold fk = 5
          }
          when sx_eq(nm2, "sx_write") {
            hold fk = 6
          }
          when sx_eq(nm2, "sx_arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "sx_argc") {
            hold fk = 8
          }
          hold rk = 0
          hold rhs = "0"
          when fk == 1 {
            hold rhs = concat("sx_cat(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 2 {
            hold key = concat("|", argv_c)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = concat("sx_llen(", argv_c)
              hold rhs = concat(rhs, ")")
              hold lt = 1
            } otherwise {
              hold rhs = concat("sx_len(", argv_c)
              hold rhs = concat(rhs, ")")
              hold rt = 1
            }
          }
          when fk == 3 {
            hold rhs = concat("sx_idx(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 4 {
            hold rhs = concat("sx_chr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 5 {
            hold rhs = concat("sx_read(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 6 {
            hold rhs = concat("sx_write(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 7 {
            hold rhs = concat("sx_arg(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 8 {
            hold rhs = "sx_argc()"
            hold rt = 1
          }
          when fk == 9 {
            hold rhs = concat("sx_eq(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 12 {
            hold rhs = "sx_gc_run()"
          }
          when fk == 13 {
            hold rhs = "sx_gc_live()"
          }
          when fk == 14 {
            hold rhs = "sx_gc_count()"
          }
          when fk == 15 {
            hold rhs = "sx_read_line()"
            hold rk = 1
            hold rt = 1
          }
          when fk == 16 {
            hold rhs = concat("sx_read_n(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 17 {
            hold rhs = concat("sx_write_out(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 18 {
            hold rhs = "sx_flush_out()"
            hold rt = 1
          }
          when fk == 19 {
            hold rhs = concat("sx_numstr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 10 {
            // the pushed value must be a number: a plain string, list or
            // struct variable is a clear error (it was invalid C)
            hold pi2 = 0
            hold pa2 = len(argv_c)
            hold pv = 0
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              hold pi2 = pi2 + 1
              when pa3 == 44 {
                hold pv = pi2
                hold pi2 = pa2
              }
            }
            hold el = ""
            hold pv2 = 1
            hold pi2 = pv
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              when (pa3 >= 97 && pa3 <= 122) || (pa3 >= 65 && pa3 <= 90) || (pa3 >= 48 && pa3 <= 57) || pa3 == 95 {
                hold el = concat(el, chr(pa3))
              } otherwise {
                hold pv2 = 0
              }
              hold pi2 = pi2 + 1
            }
            when pv2 == 1 && pv > 0 {
              hold lbad = 0
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = concat("push: '", el)
                  hold permsg = concat(permsg, "' is not a number (a list cannot hold a string, list or struct)")
                }
                hold perr = 1
              }
            }
            hold rhs = concat("sx_lpush(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 2
            hold lt = 1
          }
          when fk == 0 {
            // a generic function: request the specialised copy for the
            // kind of the first argument and call that instead
            hold gkey2 = concat(chr(1), nm2)
            hold gkey2 = concat(gkey2, chr(1))
            hold gk2l = len(gkey2)
            hold gt2l = len(fgtab)
            hold gi2 = 0
            hold gfound = 0
            while gi2 + gk2l <= gt2l {
              hold gok2 = 1
              hold gj2 = 0
              while gj2 < gk2l {
                hold ga2 = sx_index(fgtab, gi2 + gj2)
                hold gb2 = sx_index(gkey2, gj2)
                when ga2 == gb2 {
                  hold gj2 = gj2 + 1
                } otherwise {
                  hold gok2 = 0
                  hold gj2 = gk2l
                }
              }
              when gok2 == 1 {
                hold gfound = 1
                hold gi2 = gt2l
              } otherwise {
                hold gi2 = gi2 + 1
              }
            }
            hold gcall2 = nm2
            when gfound == 1 {
              // kind of the first argument: num unless it is a string
              // literal or a name declared str/list
              hold gkch = 110
              hold gai2 = 0
              hold gal2 = len(argv_c)
              hold gsk2 = 1
              while gsk2 == 1 {
                when gai2 >= gal2 {
                  hold gsk2 = 0
                } otherwise {
                  hold gac = sx_index(argv_c, gai2)
                  when gac == 32 || gac == 9 {
                    hold gai2 = gai2 + 1
                  } otherwise {
                    hold gsk2 = 0
                  }
                }
              }
              hold gac = 0
              when gai2 < gal2 {
                hold gac = sx_index(argv_c, gai2)
              }
              when gac == 34 {
                hold gkch = 115
              }
              when gac == 91 {
                hold gkch = 108
              }
              when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || gac == 95 {
                hold ganm = ""
                hold grun3 = 1
                while grun3 == 1 {
                  when gai2 >= gal2 {
                    hold grun3 = 0
                  } otherwise {
                    hold gac = sx_index(argv_c, gai2)
                    when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || (gac >= 48 && gac <= 57) || gac == 95 {
                      hold ganm = concat(ganm, chr(gac))
                      hold gai2 = gai2 + 1
                    } otherwise {
                      hold grun3 = 0
                    }
                  }
                }
                hold gakey = concat(ganm, "|")
                hold gakl = len(gakey)
                hold ga1 = len(sdecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(sdecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(sdecls, gai3 - 1) == 124) {
                    hold gkch = 115
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
                hold ga1 = len(ldecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(ldecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(ldecls, gai3 - 1) == 124) {
                    hold gkch = 108
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
              }
              hold gcall2 = concat(nm2, "__")
              hold gcall2 = concat(gcall2, chr(gkch))
              // remember the request: the specialised copy is spliced in
              // at the next statement boundary
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, nm2)
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, chr(gkch))
              when gkch == 115 {
                hold rk = 1
                hold rt = 1
              }
              when gkch == 108 {
                hold rk = 2
                hold lt = 1
              }
            }
            hold rhs = concat(gcall2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }

        // ---- plain name, or name + number ----
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          // is nm2 a string variable?
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          hold rk = 0
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain value: `hold l = q` copies it
          // (typed declaration from the svars table)
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            hold rk = 3
            hold stname = bsvnm
          }
          hold rhs = nm2
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sx_index(source,pos)
          }
          // a list variable as a whole value: `hold ys = xs` aliases it, as
          // in seed-min and native (it used to emit `double ys = xs;`, which
          // is invalid C).  xs[i] (c2 == '[') stays a number below; anything
          // else after a list name (xs + 1) is a clear error.
          when c2 != 91 {
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              // pos may already be past the newline (at the next statement),
              // so test for an operator rather than for the end of the line
              hold lop = 0
              when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 || c2 == 46 || c2 == 40 {
                hold lop = 1
              }
              when c2 == 47 {
                hold lop = 1
                when pos + 1 < n {
                  hold pc3 = sx_index(source, pos + 1)
                  when pc3 == 47 {
                    hold lop = 0
                  }
                }
              }
              when lop == 0 {
                hold rk = 2
              } otherwise {
                when perr == 0 {
                  hold permsg = concat("list '", nm2)
                  hold permsg = concat(permsg, "' can only be held whole (hold ys = xs) or indexed (xs[i]); no operators on a list")
                }
                hold perr = 1
              }
            }
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sx_index(source,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sx_index(source,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an index must be a number or a name closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
          // optional field chain p.x.y (text is walked as-is; when the base
          // is a struct variable the final type is resolved through the
          // svars and ftypes tables, so `l.a.x` and `hold m = l.b` work)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  // no literal fixed this field's type: it is a number
                  // (the emitted typedef uses double)
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 1 {
                    hold rk = 1
                  } otherwise {
                    hold rk = 0
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sx_index(source,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      //   ct     = the mul-level term currently being built
      //   addacc = the reduced add-level value; addop = the pending + or -
      // A single operand still emits the same text as before.
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sx_index(source,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sx_index(source,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sx_index(source,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sx_index(source,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = numtxt
          }
          // string literal operand (copied verbatim, escapes kept)
          when c3 == 34 {
            hold oq = 1
            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sx_index(source,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sx_index(source,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
                }
              }
            }
          }
          // name operand
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cn = sx_index(source,pos)
                when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                  hold nm3 = concat(nm3, chr(cn))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            // user functions were previously left as un-mapped names (and
            // the `(` then failed).  Map the builtin here with the same
            // runtime names the statement-level call path uses; the
            // argument text is copied verbatim (nested builtin calls in an
            // argument are still a documented limitation).
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sx_index(source, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sx_index(source, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
                        hold ocarg = concat(ocarg, chr(sx_index(source, pos)))
                        hold pos = pos + 1
                      }
                    } otherwise {
                      when ocx == 34 {
                        hold ocq = 0
                      }
                    }
                  } otherwise {
                    when ocx == 34 {
                      hold ocq = 1
                      hold ocarg = concat(ocarg, chr(ocx))
                      hold pos = pos + 1
                    } otherwise {
                      when ocx == 40 {
                        hold ocdepth = ocdepth + 1
                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
                hold ocmap = "sx_chr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_file") || sx_eq(nm3, "sx_read") {
                hold ocmap = "sx_read"
                hold ocstr = 1
              }
              when sx_eq(nm3, "arg") || sx_eq(nm3, "sx_arg") {
                hold ocmap = "sx_arg"
                hold ocstr = 1
              }
              when sx_eq(nm3, "sx_index") || sx_eq(nm3, "sx_idx") {
                hold ocmap = "sx_idx"
              }
              when sx_eq(nm3, "write_file") || sx_eq(nm3, "sx_write") {
                hold ocmap = "sx_write"
              }
              when sx_eq(nm3, "arg_count") || sx_eq(nm3, "sx_argc") {
                hold ocmap = "sx_argc"
              }
              when sx_eq(nm3, "gc") || sx_eq(nm3, "sx_gc_run") {
                hold ocmap = "sx_gc_run"
              }
              when sx_eq(nm3, "gc_live") || sx_eq(nm3, "sx_gc_live") {
                hold ocmap = "sx_gc_live"
              }
              when sx_eq(nm3, "gc_runs") || sx_eq(nm3, "sx_gc_count") {
                hold ocmap = "sx_gc_count"
              }
              when sx_eq(nm3, "read_line") || sx_eq(nm3, "sx_read_line") {
                hold ocmap = "sx_read_line"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_n") || sx_eq(nm3, "sx_read_n") {
                hold ocmap = "sx_read_n"
                hold ocstr = 1
              }
              when sx_eq(nm3, "write_out") || sx_eq(nm3, "sx_write_out") {
                hold ocmap = "sx_write_out"
              }
              when sx_eq(nm3, "flush_out") || sx_eq(nm3, "sx_flush_out") {
                hold ocmap = "sx_flush_out"
              }
              when sx_eq(nm3, "numstr") || sx_eq(nm3, "sx_numstr") {
                hold ocmap = "sx_numstr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "string_eq") || sx_eq(nm3, "sx_eq") {
                hold ocmap = "sx_eq"
              }
              when sx_eq(nm3, "push") || sx_eq(nm3, "sx_lpush") {
                hold ocmap = "sx_lpush"
                hold oclist = 1
              }
              when sx_eq(nm3, "len") || sx_eq(nm3, "sx_len") || sx_eq(nm3, "sx_llen") {
                // list variable -> sx_llen, otherwise sx_len
                hold ocarg2 = ""
                hold ocai = 0
                hold ocbd = 1
                hold ocw = 1
                while ocw == 1 {
                  when ocai >= len(ocarg) {
                    hold ocw = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg, ocai)
                    when ocx == 40 || ocx == 91 {
                      hold ocbd = ocbd + 1
                    }
                    when ocx == 41 || ocx == 93 {
                      hold ocbd = ocbd - 1
                    }
                    when ocbd == 0 {
                      hold ocw = 0
                    } otherwise {
                      hold ocarg2 = concat(ocarg2, chr(ocx))
                    }
                    hold ocai = ocai + 1
                  }
                }
                hold ocarg3 = ""
                hold ocai = 0
                hold ocl2 = len(ocarg2)
                hold octr = 1
                while octr == 1 {
                  when ocl2 <= 0 {
                    hold octr = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg2, ocl2 - 1)
                    when ocx == 32 || ocx == 9 {
                      hold ocl2 = ocl2 - 1
                    } otherwise {
                      hold octr = 0
                    }
                  }
                }
                while ocai < ocl2 {
                  hold ocarg3 = concat(ocarg3, chr(sx_index(ocarg2, ocai)))
                  hold ocai = ocai + 1
                }
                hold ockey = concat("|", ocarg3)
                hold ockey = concat(ockey, "|")
                hold ockl = len(ockey)
                hold ocll = len(ldecls)
                hold ocli = 0
                hold oclf = 0
                while ocli + ockl <= ocll {
                  hold oclok = 1
                  hold oclj = 0
                  while oclj < ockl {
                    hold ocla = sx_index(ldecls, ocli + oclj)
                    hold oclb = sx_index(ockey, oclj)
                    when ocla == oclb {
                      hold oclj = oclj + 1
                    } otherwise {
                      hold oclok = 0
                      hold oclj = ockl
                    }
                  }
                  when oclok == 1 {
                    hold oclf = 1
                    hold ocli = ocll
                  } otherwise {
                    hold ocli = ocli + 1
                  }
                }
                when oclf == 1 {
                  hold ocmap = "sx_llen"
                  hold oclist = 1
                } otherwise {
                  hold ocmap = "sx_len"
                }
              }
              when sx_eq(ocmap, "") {
                // a user function: the return kind decides the value kind
                hold ocfrk = 0
                hold ocfky = concat("|", nm3)
                hold ocfky = concat(ocfky, "=")
                hold ocfkl = len(fsret)
                hold ocfki = 0
                hold ocfn = len(ocfky)
                while ocfki + ocfn + 1 <= ocfkl {
                  hold ocfok = 1
                  hold ocfj = 0
                  while ocfj < ocfn {
                    hold ocfa = sx_index(fsret, ocfki + ocfj)
                    hold ocfb = sx_index(ocfky, ocfj)
                    when ocfa == ocfb {
                      hold ocfj = ocfj + 1
                    } otherwise {
                      hold ocfok = 0
                      hold ocfj = ocfn
                    }
                  }
                  when ocfok == 1 {
                    hold ocfrk = sx_index(fsret, ocfki + ocfn)
                    hold ocfki = ocfkl
                  } otherwise {
                    hold ocfki = ocfki + 1
                  }
                }
                when ocfrk == 115 {
                  hold ocstr = 1
                }
                when ocfrk == 108 {
                  hold oclist = 1
                }
                hold ocmap = nm3
              }
              // builtin calls nested in the argument text are mapped here too,
              // so `concat(a, numstr(n))` works as a right-hand operand
              hold ocargv = ""
              hold ocak = 0
              hold ocakn = len(ocarg)
              hold ocargq = 0
              while ocak < ocakn {
                hold ocac = sx_index(ocarg, ocak)
                when ocargq == 1 {
                  hold ocargv = concat(ocargv, chr(ocac))
                  when ocac == 34 {
                    hold ocargq = 0
                  }
                  hold ocak = ocak + 1
                } otherwise {
                when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || ocac == 95 {
                  hold ocaw = ""
                  hold ocawr = 1
                  while ocawr == 1 {
                    hold ocac = sx_index(ocarg, ocak)
                    when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || (ocac >= 48 && ocac <= 57) || ocac == 95 {
                      hold ocaw = concat(ocaw, chr(ocac))
                      hold ocak = ocak + 1
                    } otherwise {
                      hold ocawr = 0
                    }
                    when ocak >= ocakn {
                      hold ocawr = 0
                    }
                  }
                  hold ocam = ocaw
                  // A word in argument text is a builtin *call* only when a
                  // `(` follows it: a variable named `index`, `len`, `arg`,
                  // ... must stay a variable.  Without this check
                  // `sx_idx(s, index)` became `sx_idx(s, sx_idx)` -- the
                  // variable was renamed to the runtime function and the
                  // generated C silently did the wrong thing (it was the
                  // reason tools/sxpkg.sa's own `search` never matched).
                  hold ocacall = 0
                  hold ocakx = ocak
                  hold ocask = 1
                  while ocask == 1 {
                    when ocakx >= ocakn {
                      hold ocask = 0
                    } otherwise {
                      hold ocacx = sx_index(ocarg, ocakx)
                      when ocacx == 32 || ocacx == 9 || ocacx == 13 {
                        hold ocakx = ocakx + 1
                      } otherwise {
                        hold ocask = 0
                      }
                    }
                  }
                  when ocakx < ocakn {
                    when sx_index(ocarg, ocakx) == 40 {
                      hold ocacall = 1
                    }
                  }
                  when ocacall == 1 {
                    when sx_eq(ocaw, "concat") {
                      hold ocam = "sx_cat"
                    }
                    when sx_eq(ocaw, "len") {
                      hold ocam = "sx_len"
                    }
                    when sx_eq(ocaw, "sx_index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "chr") {
                      hold ocam = "sx_chr"
                    }
                    when sx_eq(ocaw, "read_file") {
                      hold ocam = "sx_read"
                    }
                    when sx_eq(ocaw, "write_file") {
                      hold ocam = "sx_write"
                    }
                    when sx_eq(ocaw, "arg") {
                      hold ocam = "sx_arg"
                    }
                    when sx_eq(ocaw, "arg_count") {
                      hold ocam = "sx_argc"
                    }
                    when sx_eq(ocaw, "string_eq") {
                      hold ocam = "sx_eq"
                    }
                    when sx_eq(ocaw, "push") {
                      hold ocam = "sx_lpush"
                    }
                    when sx_eq(ocaw, "numstr") {
                      hold ocam = "sx_numstr"
                    }
                    when sx_eq(ocaw, "read_line") {
                      hold ocam = "sx_read_line"
                    }
                    when sx_eq(ocaw, "read_n") {
                      hold ocam = "sx_read_n"
                    }
                    when sx_eq(ocaw, "write_out") {
                      hold ocam = "sx_write_out"
                    }
                    when sx_eq(ocaw, "flush_out") {
                      hold ocam = "sx_flush_out"
                    }
                    when sx_eq(ocaw, "gc") {
                      hold ocam = "sx_gc_run"
                    }
                    when sx_eq(ocaw, "gc_live") {
                      hold ocam = "sx_gc_live"
                    }
                    when sx_eq(ocaw, "gc_runs") {
                      hold ocam = "sx_gc_count"
                    }
                  }
                  hold ocargv = concat(ocargv, ocam)
                } otherwise {
                  when ocac == 34 {
                    hold ocargq = 1
                  }
                  hold ocargv = concat(ocargv, chr(ocac))
                  hold ocak = ocak + 1
                }
                }
              }
              hold ocarg = ocargv
              hold opnd = concat(ocmap, "(")
              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold c2 = 0
              when pos < n {
                hold c2 = sx_index(source,pos)
              }
              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sx_index(source,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when pos < n {
                hold cn = sx_index(source,pos)
                when cn == 93 {
                  hold pos = pos + 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          // n = 4): now string + number, number + string and - * / % on a
          // string are clear errors (seed-min rejects them the same way)
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      // ---- declared type check (full language) ----
      when declk >= 0 {
        hold dtok = 0
        when declk == 0 && rk == 0 {
          hold dtok = 1
        }
        when declk == 1 && rk == 1 {
          hold dtok = 1
        }
        when declk == 2 && rk == 2 {
          hold dtok = 1
        }
        when declk == 3 && rk == 3 {
          when sx_eq(declt, stname) {
            hold dtok = 1
          }
        }
        when dtok == 0 {
          hold nerrscop = 1
          when sx_eq(scopmsg, "") {
            hold scopmsg = concat("type error: '", nm)
            hold scopmsg = concat(scopmsg, "' is declared ")
            hold scopmsg = concat(scopmsg, declt)
            when rk == 0 {
              hold scopmsg = concat(scopmsg, " but the value is a number")
            } otherwise {
              when rk == 1 {
                hold scopmsg = concat(scopmsg, " but the value is a string")
              } otherwise {
                when rk == 2 {
                  hold scopmsg = concat(scopmsg, " but the value is a list")
                } otherwise {
                  hold scopmsg = concat(scopmsg, " but the value is a struct")
                }
              }
            }
          }
        }
      }
      // ---------- emit ----------
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold key = concat("|", nm)
      hold key = concat(key, "|")
      hold found = 0
      hold di = 0
      hold dl = len(decls)
      hold kl = len(key)
      while di + kl <= dl {
        hold ok = 1
        hold j = 0
        while j < kl {
          hold aa = sx_index(decls, di + j)
          hold bb = sx_index(key, j)
          when aa == bb {
            hold j = j + 1
          } otherwise {
            hold ok = 0
            hold j = kl
          }
        }
        when ok == 1 {
          hold found = 1
          hold di = dl
        } otherwise {
          hold di = di + 1
        }
      }
      // an assignment target keeps its `.field` / `[index]` suffix; the
      // table lookup above uses the base name
      hold nm = concat(nm, sufx)
      when found == 1 {
        hold body = concat(body, ind)
        when liset == 1 {
          // list element assignment: NAME = sx_lset(NAME, index, value)
          hold body = concat(body, nm)
          hold body = concat(body, " = sx_lset(")
          hold body = concat(body, nm)
          hold body = concat(body, ", ")
          hold body = concat(body, lidx)
          hold body = concat(body, ", ")
          when cmpop == 0 {
            hold body = concat(body, rhs)
          } otherwise {
            when cmpop == 37 {
              hold body = concat(body, "sx_mod(sx_lget(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, lidx)
              hold body = concat(body, "), ")
              hold body = concat(body, rhs)
              hold body = concat(body, ")")
            } otherwise {
              hold body = concat(body, "(sx_lget(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, lidx)
              hold body = concat(body, ") ")
              hold body = concat(body, chr(cmpop))
              hold body = concat(body, " ")
              hold body = concat(body, rhs)
              hold body = concat(body, ")")
            }
          }
          hold body = concat(body, ");")
        }
        when liset == 0 && cmpop != 0 {
          // compound assignment: NAME op= EXPR (the name is evaluated once)
          when rk == 1 {
            // strings: `+=` concatenates, the other operators are errors
            when cmpop == 43 {
              hold body = concat(body, nm)
              hold body = concat(body, " = sx_cat(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, rhs)
              hold body = concat(body, ");")
              hold rt = 1
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment on a string supports only +="
            }
          } otherwise {
            when rk == 0 {
              hold body = concat(body, nm)
              hold body = concat(body, " = ")
              when cmpop == 37 {
                hold body = concat(body, "sx_mod(")
                hold body = concat(body, nm)
                hold body = concat(body, ", ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              } otherwise {
                hold body = concat(body, "(")
                hold body = concat(body, nm)
                hold body = concat(body, " ")
                hold body = concat(body, chr(cmpop))
                hold body = concat(body, " ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              }
              hold body = concat(body, ";")
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment needs a number or string variable"
            }
          }
        }
        when liset == 0 && cmpop == 0 {
          hold body = concat(body, nm)
          hold body = concat(body, " = ")
          hold body = concat(body, rhs)
          hold body = concat(body, ";")
        }
        hold body = concat(body, nl)
      } otherwise {
        hold body = concat(body, ind)
        when asmode == 1 {
          hold nerrscop = 1
          hold scopmsg = concat("assignment: '", nm)
          hold scopmsg = concat(scopmsg, "' does not exist yet; hold it first")
        }
        when cmpop != 0 {
          hold nerrscop = 1
          hold scopmsg = "compound assignment needs an existing variable; hold it first"
        }
        when rk == 1 {
          hold body = concat(body, "char *")
        } otherwise {
          when rk == 2 {
            hold body = concat(body, "sx_list *")
          } otherwise {
            when rk == 3 {
              hold body = concat(body, stname)
              hold body = concat(body, " ")
            } otherwise {
              hold body = concat(body, "double ")
            }
          }
        }
        hold body = concat(body, nm)
        hold body = concat(body, " = ")
        hold body = concat(body, rhs)
        hold body = concat(body, ";")
        hold body = concat(body, nl)
        hold decls = concat(decls, nm)
        hold decls = concat(decls, "|")
        when rk == 1 {
          hold sdecls = concat(sdecls, nm)
          hold sdecls = concat(sdecls, "|")
        }
        when rk == 2 {
          hold ldecls = concat(ldecls, nm)
          hold ldecls = concat(ldecls, "|")
        }
        when rk == 3 {
          // struct-typed variable: remembered for field-chain resolution
          hold svars = concat(svars, "|")
          hold svars = concat(svars, nm)
          hold svars = concat(svars, "=")
          hold svars = concat(svars, stname)
          hold svars = concat(svars, "|")
        }
      }
      hold holds = holds + 1
    }

    // ================= show EXPR =================
    when act == 2 {
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }


      // string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sx_index(source,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // keep the backslash and the escaped char
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sx_index(source,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
      }


      // number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sx_index(source,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sx_index(source,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // name or call
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) {
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sx_index(source,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sx_index(source,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when cn == 32 || cn == 9 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          hold fk = 0
          // ---- '%' inside builtin-call argument text: sx_mod(L, R) ----
          // Same rule as the shared condition rewrite: L is the * / %
          // chain to the left (balanced groups included), R is the next
          // atom (name, number, .field, [i], (..)). argv_txt has no blanks
          // outside string literals, so no blank handling is needed here.
          hold bxo = ""
          hold bxi = 0
          hold bxn = len(argv_txt)
          hold bxc = 0
          hold bxq = 0
          hold bxal = 0
          hold bxrun = 0
          hold bxd = 0
          hold bxbd = 0
          hold bxe = 0
          hold bxri = 0
          hold bxnb = 0
          hold bxf = 0
          hold bxg = 0
          hold bxL = ""
          hold bxR = ""
          hold bxj = 0
          hold bxP = ""
          while bxi < bxn {
            hold bxc = sx_index(argv_txt, bxi)
            when bxc == 34 {
              // string literal: copy verbatim, escapes kept
              hold bxo = concat(bxo, chr(34))
              hold bxi = bxi + 1
              hold bxq = 1
              while bxq == 1 && bxi < bxn {
                hold bxc = sx_index(argv_txt, bxi)
                hold bxo = concat(bxo, chr(bxc))
                hold bxi = bxi + 1
                when bxc == 92 && bxi < bxn {
                  hold bxo = concat(bxo, chr(sx_index(argv_txt, bxi)))
                  hold bxi = bxi + 1
                } otherwise {
                  when bxc == 34 {
                    hold bxq = 0
                  }
                }
              }
            } otherwise {
              when bxc == 37 {
                // left operand: scan back over the chain already in bxo
                hold bxal = len(bxo)
                hold bxrun = 1
                while bxrun == 1 {
                  hold bxrun = 0
                  when bxal > 0 {
                    hold bxd = sx_index(bxo, bxal - 1)
                    when bxd == 41 || bxd == 93 {
                      // skip a balanced (..) or [..] group, then keep going
                      hold bxbd = 1
                      hold bxal = bxal - 1
                      while bxbd > 0 {
                        when bxal <= 0 {
                          hold bxbd = 0
                        } otherwise {
                          hold bxe = sx_index(bxo, bxal - 1)
                          when bxe == 41 || bxe == 93 {
                            hold bxbd = bxbd + 1
                          }
                          when bxe == 40 || bxe == 91 {
                            hold bxbd = bxbd - 1
                          }
                          hold bxal = bxal - 1
                        }
                      }
                      hold bxrun = 1
                    } otherwise {
                      when (bxd >= 97 && bxd <= 122) || (bxd >= 65 && bxd <= 90) || (bxd >= 48 && bxd <= 57) || bxd == 95 || bxd == 46 || bxd == 42 || bxd == 47 {
                        hold bxal = bxal - 1
                        hold bxrun = 1
                      }
                    }
                  }
                }
                // right operand: the next atom in argv_txt
                hold bxri = bxi + 1
                hold bxnb = 1
                while bxnb == 1 && bxri < bxn {
                  hold bxnb = 0
                  hold bxf = sx_index(argv_txt, bxri)
                  when (bxf >= 97 && bxf <= 122) || (bxf >= 65 && bxf <= 90) || (bxf >= 48 && bxf <= 57) || bxf == 95 || bxf == 46 {
                    hold bxri = bxri + 1
                    hold bxnb = 1
                  } otherwise {
                    when bxf == 40 || bxf == 91 {
                      hold bxbd = 1
                      hold bxri = bxri + 1
                      while bxbd > 0 && bxri < bxn {
                        hold bxg = sx_index(argv_txt, bxri)
                        when bxg == 40 || bxg == 91 {
                          hold bxbd = bxbd + 1
                        }
                        when bxg == 41 || bxg == 93 {
                          hold bxbd = bxbd - 1
                        }
                        hold bxri = bxri + 1
                      }
                      hold bxnb = 1
                    }
                  }
                }
                // rebuild: the left chain is replaced by sx_mod(L, R)
                hold bxL = ""
                hold bxj = bxal
                while bxj < len(bxo) {
                  hold bxL = concat(bxL, chr(sx_index(bxo, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxR = ""
                hold bxj = bxi + 1
                while bxj < bxri {
                  hold bxR = concat(bxR, chr(sx_index(argv_txt, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxP = ""
                hold bxj = 0
                while bxj < bxal {
                  hold bxP = concat(bxP, chr(sx_index(bxo, bxj)))
                  hold bxj = bxj + 1
                }
                hold bxo = bxP
                hold bxo = concat(bxo, "sx_mod(")
                hold bxo = concat(bxo, bxL)
                hold bxo = concat(bxo, ",")
                hold bxo = concat(bxo, bxR)
                hold bxo = concat(bxo, ")")
                hold bxi = bxri
              } otherwise {
                hold bxo = concat(bxo, chr(bxc))
                hold bxi = bxi + 1
              }
            }
          }
          hold argv_txt = bxo
          // Normalize builtin identifiers inside argument text for nested calls.
          hold argv_c = ""
          hold ai = 0
          hold al = len(argv_txt)
          hold arun = 1
          hold argv_q = 0
          while arun == 1 {
            when ai >= al {
              hold arun = 0
            } otherwise {
              hold ac = sx_index(argv_txt,ai)
              when argv_q == 1 {
                hold argv_c = concat(argv_c, chr(ac))
                when ac == 34 {
                  hold argv_q = 0
                }
                hold ai = ai + 1
              } otherwise {
              hold islet = 0
              when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || ac == 95 {
                hold islet = 1
              }
              when islet == 1 {
                hold atok = ""
                hold tokrun = 1
                while tokrun == 1 {
                  when ai >= al {
                    hold tokrun = 0
                  } otherwise {
                    hold ac = sx_index(argv_txt,ai)
                    when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || (ac >= 48 && ac <= 57) || ac == 95 {
                      hold atok = concat(atok, chr(ac))
                      hold ai = ai + 1
                    } otherwise {
                      hold tokrun = 0
                    }
                  }
                }
                // Only rewrite a builtin word when it is really a call: a
                // variable named `index`, `len`, `arg`, ... inside argument
                // text must stay a variable.  Without this check
                // `sx_idx(index, ...)` was rewritten to `sx_idx(sx_idx, ...)`
                // and the generated C silently did the wrong thing (it made
                // tools/sxpkg.sa's own `search` never match).
                hold amap = 0
                hold acall = 0
                hold aix = ai
                hold ask = 1
                while ask == 1 {
                  when aix >= al {
                    hold ask = 0
                  } otherwise {
                    hold acx = sx_index(argv_txt, aix)
                    when acx == 32 || acx == 9 || acx == 13 {
                      hold aix = aix + 1
                    } otherwise {
                      hold ask = 0
                    }
                  }
                }
                when aix < al {
                  when sx_index(argv_txt, aix) == 40 {
                    hold acall = 1
                  }
                }
                when acall == 1 {
                  when sx_eq(atok, "concat") {
                    hold argv_c = concat(argv_c, "sx_cat")
                    hold amap = 1
                  }
                  when sx_eq(atok, "len") {
                    hold argv_c = concat(argv_c, "sx_len")
                    hold amap = 1
                  }
                  when sx_eq(atok, "sx_index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "chr") {
                    hold argv_c = concat(argv_c, "sx_chr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_file") {
                    hold argv_c = concat(argv_c, "sx_read")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_file") {
                    hold argv_c = concat(argv_c, "sx_write")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg") {
                    hold argv_c = concat(argv_c, "sx_arg")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg_count") {
                    hold argv_c = concat(argv_c, "sx_argc")
                    hold amap = 1
                  }
                  when sx_eq(atok, "string_eq") {
                    hold argv_c = concat(argv_c, "sx_eq")
                    hold amap = 1
                  }
                  when sx_eq(atok, "push") {
                    hold argv_c = concat(argv_c, "sx_lpush")
                    hold amap = 1
                  }
                  when sx_eq(atok, "numstr") {
                    hold argv_c = concat(argv_c, "sx_numstr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_line") {
                    hold argv_c = concat(argv_c, "sx_read_line")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_n") {
                    hold argv_c = concat(argv_c, "sx_read_n")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_out") {
                    hold argv_c = concat(argv_c, "sx_write_out")
                    hold amap = 1
                  }
                  when sx_eq(atok, "flush_out") {
                    hold argv_c = concat(argv_c, "sx_flush_out")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc") {
                    hold argv_c = concat(argv_c, "sx_gc_run")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc_live") {
                    hold argv_c = concat(argv_c, "sx_gc_live")
                    hold amap = 1
                  }
                  when sx_eq(atok, "gc_runs") {
                    hold argv_c = concat(argv_c, "sx_gc_count")
                    hold amap = 1
                  }
                }
                when amap == 0 {
                  hold argv_c = concat(argv_c, atok)
                }
              } otherwise {
                when ac == 34 {
                  hold argv_q = 1
                }
                hold argv_c = concat(argv_c, chr(ac))
                hold ai = ai + 1
              }
              }
            }
          }
          when sx_eq(nm2, "concat") {
            hold fk = 1
          }
          when sx_eq(nm2, "len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_index") {
            hold fk = 3
          }
          when sx_eq(nm2, "chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "read_file") {
            hold fk = 5
          }
          when sx_eq(nm2, "write_file") {
            hold fk = 6
          }
          when sx_eq(nm2, "arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "arg_count") {
            hold fk = 8
          }
          when sx_eq(nm2, "string_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "sx_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "gc") || sx_eq(nm2, "sx_gc_run") {
            hold fk = 12
          }
          when sx_eq(nm2, "gc_live") || sx_eq(nm2, "sx_gc_live") {
            hold fk = 13
          }
          when sx_eq(nm2, "gc_runs") || sx_eq(nm2, "sx_gc_count") {
            hold fk = 14
          }
          when sx_eq(nm2, "read_line") || sx_eq(nm2, "sx_read_line") {
            hold fk = 15
          }
          when sx_eq(nm2, "read_n") || sx_eq(nm2, "sx_read_n") {
            hold fk = 16
          }
          when sx_eq(nm2, "write_out") || sx_eq(nm2, "sx_write_out") {
            hold fk = 17
          }
          when sx_eq(nm2, "flush_out") || sx_eq(nm2, "sx_flush_out") {
            hold fk = 18
          }
          when sx_eq(nm2, "numstr") || sx_eq(nm2, "sx_numstr") {
            hold fk = 19
          }
          when sx_eq(nm2, "sx_cat") {
            hold fk = 1
          }
          when sx_eq(nm2, "sx_len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_idx") {
            hold fk = 3
          }
          when sx_eq(nm2, "sx_chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "sx_read") {
            hold fk = 5
          }
          when sx_eq(nm2, "sx_write") {
            hold fk = 6
          }
          when sx_eq(nm2, "sx_arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "sx_argc") {
            hold fk = 8
          }
          hold rhs = "0"
          when fk == 1 {
            hold rhs = concat("sx_cat(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 2 {
            hold key = concat("|", argv_c)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = concat("sx_llen(", argv_c)
              hold rhs = concat(rhs, ")")
              hold lt = 1
            } otherwise {
              hold rhs = concat("sx_len(", argv_c)
              hold rhs = concat(rhs, ")")
              hold rt = 1
            }
          }
          when fk == 3 {
            hold rhs = concat("sx_idx(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 4 {
            hold rhs = concat("sx_chr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 5 {
            hold rhs = concat("sx_read(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 6 {
            hold rhs = concat("sx_write(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 7 {
            hold rhs = concat("sx_arg(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 8 {
            hold rhs = "sx_argc()"
            hold rt = 1
          }
          when fk == 9 {
            hold rhs = concat("sx_eq(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 12 {
            hold rhs = "sx_gc_run()"
          }
          when fk == 13 {
            hold rhs = "sx_gc_live()"
          }
          when fk == 14 {
            hold rhs = "sx_gc_count()"
          }
          when fk == 15 {
            hold rhs = "sx_read_line()"
            hold rk = 1
            hold rt = 1
          }
          when fk == 16 {
            hold rhs = concat("sx_read_n(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 17 {
            hold rhs = concat("sx_write_out(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 18 {
            hold rhs = "sx_flush_out()"
            hold rt = 1
          }
          when fk == 19 {
            hold rhs = concat("sx_numstr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 0 {
            // user-defined function call: forward the text as-is
            // a generic function: request the specialised copy for the
            // kind of the first argument and call that instead
            hold gkey2 = concat(chr(1), nm2)
            hold gkey2 = concat(gkey2, chr(1))
            hold gk2l = len(gkey2)
            hold gt2l = len(fgtab)
            hold gi2 = 0
            hold gfound = 0
            while gi2 + gk2l <= gt2l {
              hold gok2 = 1
              hold gj2 = 0
              while gj2 < gk2l {
                hold ga2 = sx_index(fgtab, gi2 + gj2)
                hold gb2 = sx_index(gkey2, gj2)
                when ga2 == gb2 {
                  hold gj2 = gj2 + 1
                } otherwise {
                  hold gok2 = 0
                  hold gj2 = gk2l
                }
              }
              when gok2 == 1 {
                hold gfound = 1
                hold gi2 = gt2l
              } otherwise {
                hold gi2 = gi2 + 1
              }
            }
            hold gcall2 = nm2
            when gfound == 1 {
              // kind of the first argument: num unless it is a string
              // literal or a name declared str/list
              hold gkch = 110
              hold gai2 = 0
              hold gal2 = len(argv_c)
              hold gsk2 = 1
              while gsk2 == 1 {
                when gai2 >= gal2 {
                  hold gsk2 = 0
                } otherwise {
                  hold gac = sx_index(argv_c, gai2)
                  when gac == 32 || gac == 9 {
                    hold gai2 = gai2 + 1
                  } otherwise {
                    hold gsk2 = 0
                  }
                }
              }
              hold gac = 0
              when gai2 < gal2 {
                hold gac = sx_index(argv_c, gai2)
              }
              when gac == 34 {
                hold gkch = 115
              }
              when gac == 91 {
                hold gkch = 108
              }
              when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || gac == 95 {
                hold ganm = ""
                hold grun3 = 1
                while grun3 == 1 {
                  when gai2 >= gal2 {
                    hold grun3 = 0
                  } otherwise {
                    hold gac = sx_index(argv_c, gai2)
                    when (gac >= 97 && gac <= 122) || (gac >= 65 && gac <= 90) || (gac >= 48 && gac <= 57) || gac == 95 {
                      hold ganm = concat(ganm, chr(gac))
                      hold gai2 = gai2 + 1
                    } otherwise {
                      hold grun3 = 0
                    }
                  }
                }
                hold gakey = concat(ganm, "|")
                hold gakl = len(gakey)
                hold ga1 = len(sdecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(sdecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(sdecls, gai3 - 1) == 124) {
                    hold gkch = 115
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
                hold ga1 = len(ldecls)
                hold gai3 = 0
                while gai3 + gakl <= ga1 {
                  hold gaok = 1
                  hold gaj3 = 0
                  while gaj3 < gakl {
                    hold gaa = sx_index(ldecls, gai3 + gaj3)
                    hold gab = sx_index(gakey, gaj3)
                    when gaa == gab {
                      hold gaj3 = gaj3 + 1
                    } otherwise {
                      hold gaok = 0
                      hold gaj3 = gakl
                    }
                  }
                  when gaok == 1 && (gai3 == 0 || sx_index(ldecls, gai3 - 1) == 124) {
                    hold gkch = 108
                    hold gai3 = ga1
                  } otherwise {
                    hold gai3 = gai3 + 1
                  }
                }
              }
              hold gcall2 = concat(nm2, "__")
              hold gcall2 = concat(gcall2, chr(gkch))
              // remember the request: the specialised copy is spliced in
              // at the next statement boundary
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, nm2)
              hold gwant = concat(gwant, chr(1))
              hold gwant = concat(gwant, chr(gkch))
              when gkch == 115 {
                hold rk = 1
                hold rt = 1
              }
              when gkch == 108 {
                hold rk = 2
                hold lt = 1
              }
            }
            hold rhs = concat(gcall2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          hold rhs = nm2
          hold rk = 0
          // optional field chain p.x.y (resolved like the hold RHS base)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 1 {
                    hold rk = 1
                  } otherwise {
                    hold rk = 0
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sx_index(source,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain show value is an error (caught at
          // emit); remember the type so the message is accurate
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            when chn == 0 {
              hold rk = 3
              hold stname = bsvnm
            }
          }
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sx_index(source,pos)
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sx_index(source,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sx_index(source,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an index must be a number or a name closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      //   ct     = the mul-level term currently being built
      //   addacc = the reduced add-level value; addop = the pending + or -
      // A single operand still emits the same text as before.
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sx_index(source,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sx_index(source,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sx_index(source,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sx_index(source,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = numtxt
          }
          // string literal operand (copied verbatim, escapes kept)
          when c3 == 34 {
            hold oq = 1
            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sx_index(source,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sx_index(source,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
                }
              }
            }
          }
          // name operand
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cn = sx_index(source,pos)
                when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                  hold nm3 = concat(nm3, chr(cn))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            // user functions were previously left as un-mapped names (and
            // the `(` then failed).  Map the builtin here with the same
            // runtime names the statement-level call path uses; the
            // argument text is copied verbatim (nested builtin calls in an
            // argument are still a documented limitation).
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sx_index(source, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sx_index(source, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
                        hold ocarg = concat(ocarg, chr(sx_index(source, pos)))
                        hold pos = pos + 1
                      }
                    } otherwise {
                      when ocx == 34 {
                        hold ocq = 0
                      }
                    }
                  } otherwise {
                    when ocx == 34 {
                      hold ocq = 1
                      hold ocarg = concat(ocarg, chr(ocx))
                      hold pos = pos + 1
                    } otherwise {
                      when ocx == 40 {
                        hold ocdepth = ocdepth + 1
                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
                hold ocmap = "sx_chr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_file") || sx_eq(nm3, "sx_read") {
                hold ocmap = "sx_read"
                hold ocstr = 1
              }
              when sx_eq(nm3, "arg") || sx_eq(nm3, "sx_arg") {
                hold ocmap = "sx_arg"
                hold ocstr = 1
              }
              when sx_eq(nm3, "sx_index") || sx_eq(nm3, "sx_idx") {
                hold ocmap = "sx_idx"
              }
              when sx_eq(nm3, "write_file") || sx_eq(nm3, "sx_write") {
                hold ocmap = "sx_write"
              }
              when sx_eq(nm3, "arg_count") || sx_eq(nm3, "sx_argc") {
                hold ocmap = "sx_argc"
              }
              when sx_eq(nm3, "gc") || sx_eq(nm3, "sx_gc_run") {
                hold ocmap = "sx_gc_run"
              }
              when sx_eq(nm3, "gc_live") || sx_eq(nm3, "sx_gc_live") {
                hold ocmap = "sx_gc_live"
              }
              when sx_eq(nm3, "gc_runs") || sx_eq(nm3, "sx_gc_count") {
                hold ocmap = "sx_gc_count"
              }
              when sx_eq(nm3, "read_line") || sx_eq(nm3, "sx_read_line") {
                hold ocmap = "sx_read_line"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_n") || sx_eq(nm3, "sx_read_n") {
                hold ocmap = "sx_read_n"
                hold ocstr = 1
              }
              when sx_eq(nm3, "write_out") || sx_eq(nm3, "sx_write_out") {
                hold ocmap = "sx_write_out"
              }
              when sx_eq(nm3, "flush_out") || sx_eq(nm3, "sx_flush_out") {
                hold ocmap = "sx_flush_out"
              }
              when sx_eq(nm3, "numstr") || sx_eq(nm3, "sx_numstr") {
                hold ocmap = "sx_numstr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "string_eq") || sx_eq(nm3, "sx_eq") {
                hold ocmap = "sx_eq"
              }
              when sx_eq(nm3, "push") || sx_eq(nm3, "sx_lpush") {
                hold ocmap = "sx_lpush"
                hold oclist = 1
              }
              when sx_eq(nm3, "len") || sx_eq(nm3, "sx_len") || sx_eq(nm3, "sx_llen") {
                // list variable -> sx_llen, otherwise sx_len
                hold ocarg2 = ""
                hold ocai = 0
                hold ocbd = 1
                hold ocw = 1
                while ocw == 1 {
                  when ocai >= len(ocarg) {
                    hold ocw = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg, ocai)
                    when ocx == 40 || ocx == 91 {
                      hold ocbd = ocbd + 1
                    }
                    when ocx == 41 || ocx == 93 {
                      hold ocbd = ocbd - 1
                    }
                    when ocbd == 0 {
                      hold ocw = 0
                    } otherwise {
                      hold ocarg2 = concat(ocarg2, chr(ocx))
                    }
                    hold ocai = ocai + 1
                  }
                }
                hold ocarg3 = ""
                hold ocai = 0
                hold ocl2 = len(ocarg2)
                hold octr = 1
                while octr == 1 {
                  when ocl2 <= 0 {
                    hold octr = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg2, ocl2 - 1)
                    when ocx == 32 || ocx == 9 {
                      hold ocl2 = ocl2 - 1
                    } otherwise {
                      hold octr = 0
                    }
                  }
                }
                while ocai < ocl2 {
                  hold ocarg3 = concat(ocarg3, chr(sx_index(ocarg2, ocai)))
                  hold ocai = ocai + 1
                }
                hold ockey = concat("|", ocarg3)
                hold ockey = concat(ockey, "|")
                hold ockl = len(ockey)
                hold ocll = len(ldecls)
                hold ocli = 0
                hold oclf = 0
                while ocli + ockl <= ocll {
                  hold oclok = 1
                  hold oclj = 0
                  while oclj < ockl {
                    hold ocla = sx_index(ldecls, ocli + oclj)
                    hold oclb = sx_index(ockey, oclj)
                    when ocla == oclb {
                      hold oclj = oclj + 1
                    } otherwise {
                      hold oclok = 0
                      hold oclj = ockl
                    }
                  }
                  when oclok == 1 {
                    hold oclf = 1
                    hold ocli = ocll
                  } otherwise {
                    hold ocli = ocli + 1
                  }
                }
                when oclf == 1 {
                  hold ocmap = "sx_llen"
                  hold oclist = 1
                } otherwise {
                  hold ocmap = "sx_len"
                }
              }
              when sx_eq(ocmap, "") {
                // a user function: the return kind decides the value kind
                hold ocfrk = 0
                hold ocfky = concat("|", nm3)
                hold ocfky = concat(ocfky, "=")
                hold ocfkl = len(fsret)
                hold ocfki = 0
                hold ocfn = len(ocfky)
                while ocfki + ocfn + 1 <= ocfkl {
                  hold ocfok = 1
                  hold ocfj = 0
                  while ocfj < ocfn {
                    hold ocfa = sx_index(fsret, ocfki + ocfj)
                    hold ocfb = sx_index(ocfky, ocfj)
                    when ocfa == ocfb {
                      hold ocfj = ocfj + 1
                    } otherwise {
                      hold ocfok = 0
                      hold ocfj = ocfn
                    }
                  }
                  when ocfok == 1 {
                    hold ocfrk = sx_index(fsret, ocfki + ocfn)
                    hold ocfki = ocfkl
                  } otherwise {
                    hold ocfki = ocfki + 1
                  }
                }
                when ocfrk == 115 {
                  hold ocstr = 1
                }
                when ocfrk == 108 {
                  hold oclist = 1
                }
                hold ocmap = nm3
              }
              // builtin calls nested in the argument text are mapped here too,
              // so `concat(a, numstr(n))` works as a right-hand operand
              hold ocargv = ""
              hold ocak = 0
              hold ocakn = len(ocarg)
              hold ocargq = 0
              while ocak < ocakn {
                hold ocac = sx_index(ocarg, ocak)
                when ocargq == 1 {
                  hold ocargv = concat(ocargv, chr(ocac))
                  when ocac == 34 {
                    hold ocargq = 0
                  }
                  hold ocak = ocak + 1
                } otherwise {
                when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || ocac == 95 {
                  hold ocaw = ""
                  hold ocawr = 1
                  while ocawr == 1 {
                    hold ocac = sx_index(ocarg, ocak)
                    when (ocac >= 97 && ocac <= 122) || (ocac >= 65 && ocac <= 90) || (ocac >= 48 && ocac <= 57) || ocac == 95 {
                      hold ocaw = concat(ocaw, chr(ocac))
                      hold ocak = ocak + 1
                    } otherwise {
                      hold ocawr = 0
                    }
                    when ocak >= ocakn {
                      hold ocawr = 0
                    }
                  }
                  hold ocam = ocaw
                  // A word in argument text is a builtin *call* only when a
                  // `(` follows it: a variable named `index`, `len`, `arg`,
                  // ... must stay a variable.  Without this check
                  // `sx_idx(s, index)` became `sx_idx(s, sx_idx)` -- the
                  // variable was renamed to the runtime function and the
                  // generated C silently did the wrong thing (it was the
                  // reason tools/sxpkg.sa's own `search` never matched).
                  hold ocacall = 0
                  hold ocakx = ocak
                  hold ocask = 1
                  while ocask == 1 {
                    when ocakx >= ocakn {
                      hold ocask = 0
                    } otherwise {
                      hold ocacx = sx_index(ocarg, ocakx)
                      when ocacx == 32 || ocacx == 9 || ocacx == 13 {
                        hold ocakx = ocakx + 1
                      } otherwise {
                        hold ocask = 0
                      }
                    }
                  }
                  when ocakx < ocakn {
                    when sx_index(ocarg, ocakx) == 40 {
                      hold ocacall = 1
                    }
                  }
                  when ocacall == 1 {
                    when sx_eq(ocaw, "concat") {
                      hold ocam = "sx_cat"
                    }
                    when sx_eq(ocaw, "len") {
                      hold ocam = "sx_len"
                    }
                    when sx_eq(ocaw, "sx_index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "index") {
                      hold ocam = "sx_idx"
                    }
                    when sx_eq(ocaw, "chr") {
                      hold ocam = "sx_chr"
                    }
                    when sx_eq(ocaw, "read_file") {
                      hold ocam = "sx_read"
                    }
                    when sx_eq(ocaw, "write_file") {
                      hold ocam = "sx_write"
                    }
                    when sx_eq(ocaw, "arg") {
                      hold ocam = "sx_arg"
                    }
                    when sx_eq(ocaw, "arg_count") {
                      hold ocam = "sx_argc"
                    }
                    when sx_eq(ocaw, "string_eq") {
                      hold ocam = "sx_eq"
                    }
                    when sx_eq(ocaw, "push") {
                      hold ocam = "sx_lpush"
                    }
                    when sx_eq(ocaw, "numstr") {
                      hold ocam = "sx_numstr"
                    }
                    when sx_eq(ocaw, "read_line") {
                      hold ocam = "sx_read_line"
                    }
                    when sx_eq(ocaw, "read_n") {
                      hold ocam = "sx_read_n"
                    }
                    when sx_eq(ocaw, "write_out") {
                      hold ocam = "sx_write_out"
                    }
                    when sx_eq(ocaw, "flush_out") {
                      hold ocam = "sx_flush_out"
                    }
                    when sx_eq(ocaw, "gc") {
                      hold ocam = "sx_gc_run"
                    }
                    when sx_eq(ocaw, "gc_live") {
                      hold ocam = "sx_gc_live"
                    }
                    when sx_eq(ocaw, "gc_runs") {
                      hold ocam = "sx_gc_count"
                    }
                  }
                  hold ocargv = concat(ocargv, ocam)
                } otherwise {
                  when ocac == 34 {
                    hold ocargq = 1
                  }
                  hold ocargv = concat(ocargv, chr(ocac))
                  hold ocak = ocak + 1
                }
                }
              }
              hold ocarg = ocargv
              hold opnd = concat(ocmap, "(")
              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold c2 = 0
              when pos < n {
                hold c2 = sx_index(source,pos)
              }
              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sx_index(source,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when pos < n {
                hold cn = sx_index(source,pos)
                when cn == 93 {
                  hold pos = pos + 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          // n = 4): now string + number, number + string and - * / % on a
          // string are clear errors (seed-min rejects them the same way)
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      // emit
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when rk == 3 {
        hold nerrscop = 1
        hold scopmsg = "show value cannot be a struct"
      }
      when rk == 1 {
        hold body = concat(body, "puts(")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      when rk == 0 || rk == 2 {
        hold body = concat(body, "printf(\"%g\\n\", (double)")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      hold shows = shows + 1
    }

    // ================= while/when condition =================
    // Preserve the pure-min expression grammar as valid C expression text.
    // This covers NAME OP NAME, NAME + NUMBER OP NUMBER, and && / || chains.
    when act == 3 {
      hold pos = pos + 1
      hold iswhile = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }

      when c1 == 104 {
        hold c2 = 0
        when pos + 1 < n {
          hold c2 = sx_index(source,pos + 1)
        }
        when c2 == 105 {
          hold iswhile = 1
        }
      }
      when iswhile == 1 {
        hold pos = pos + 4
      } otherwise {
        hold pos = pos + 3
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold cond = ""
      hold cr = 1
      while cr == 1 {
        when pos >= n {
          hold cr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 123 {
            hold cr = 0
          } otherwise {
            hold cond = concat(cond, chr(cs))
            hold pos = pos + 1
          }
        }
      }
      hold cl = len(cond)
      hold trim = 1
      while trim == 1 {
        when cl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(cond, cl - 1)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold cl = cl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold ctrim = ""
      hold ci = 0
      while ci < cl {
        hold ctrim = concat(ctrim, chr(sx_index(cond,ci)))
        hold ci = ci + 1
      }
    }

    // ================= give EXPR =================
    when act == 6 {
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold gexpr = ""
      hold gr = 1
      while gr == 1 {
        when pos >= n {
          hold gr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 10 || cs == 13 {
            hold gr = 0
          } otherwise {
            when cs == 47 {
              hold c2 = 0
              when pos + 1 < n {
                hold c2 = sx_index(source, pos + 1)
              }
              when c2 == 47 {
                hold gr = 0
              } otherwise {
                hold gexpr = concat(gexpr, chr(cs))
                hold pos = pos + 1
              }
            } otherwise {
              // `}` on a give line means the block brace was swallowed:
              // statements are newline-terminated in pure-min
              when cs == 125 {
                hold exbad4 = 1
              }
              hold gexpr = concat(gexpr, chr(cs))
              hold pos = pos + 1
            }
          }
        }
      }
      hold gl = len(gexpr)
      hold trim = 1
      while trim == 1 {
        when gl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(gexpr, gl - 1)
          when cs == 32 || cs == 9 {
            hold gl = gl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold gtrim = ""
      hold gi = 0
      while gi < gl {
        hold gtrim = concat(gtrim, chr(sx_index(gexpr, gi)))
        hold gi = gi + 1
      }
      hold ctrim = gtrim
      hold cl = gl
      // a list index in a give expression (`give xs[i]`): the postfix [index]
      // rewrite lives in the hold/show operand parser and never sees a give
      // expression, so lower name[idx] to sx_lget(name, idx) here for every
      // name in ldecls (string literals are copied verbatim)
      hold lxo = ""
      hold lxi = 0
      while lxi < cl {
        hold lxc = sx_index(ctrim, lxi)
        when lxc == 34 {
          hold lxo = concat(lxo, chr(34))
          hold lxi = lxi + 1
          hold lxq = 1
          while lxq == 1 && lxi < cl {
            hold lxsd = sx_index(ctrim, lxi)
            hold lxo = concat(lxo, chr(lxsd))
            hold lxi = lxi + 1
            when lxsd == 92 && lxi < cl {
              hold lxo = concat(lxo, chr(sx_index(ctrim, lxi)))
              hold lxi = lxi + 1
            } otherwise {
              when lxsd == 34 {
                hold lxq = 0
              }
            }
          }
        } otherwise {
          when (lxc >= 97 && lxc <= 122) || (lxc >= 65 && lxc <= 90) || lxc == 95 {
            hold lxe = lxi
            hold lxr = 1
            while lxr == 1 && lxe < cl {
              hold lxid = sx_index(ctrim, lxe)
              when (lxid >= 97 && lxid <= 122) || (lxid >= 65 && lxid <= 90) || lxid == 95 || (lxid >= 48 && lxid <= 57) {
                hold lxe = lxe + 1
              } otherwise {
                hold lxr = 0
              }
            }
            hold lxw = ""
            hold lxk = lxi
            while lxk < lxe {
              hold lxw = concat(lxw, chr(sx_index(ctrim, lxk)))
              hold lxk = lxk + 1
            }
            hold lxb = 0
            when lxe < cl && sx_index(ctrim, lxe) == 91 {
              hold lxp = concat("|", lxw)
              hold lxp = concat(lxp, "|")
              hold lxpn = len(lxp)
              hold lxdn = len(ldecls)
              hold lxd0 = 0
              while lxd0 + lxpn <= lxdn {
                hold lxok = 1
                hold lxj = 0
                while lxj < lxpn {
                  when sx_index(ldecls, lxd0 + lxj) == sx_index(lxp, lxj) {
                    hold lxj = lxj + 1
                  } otherwise {
                    hold lxok = 0
                    hold lxj = lxpn
                  }
                }
                when lxok == 1 {
                  hold lxb = 1
                  hold lxd0 = lxdn
                } otherwise {
                  hold lxd0 = lxd0 + 1
                }
              }
            }
            when lxb == 1 {
              // find the closing ] (no nested [ inside the index)
              hold lxq2 = lxe + 1
              hold lxf = 0 - 1
              hold lxnest = 0
              while lxq2 < cl && lxf < 0 {
                hold lxcd = sx_index(ctrim, lxq2)
                when lxcd == 91 {
                  hold lxnest = 1
                }
                when lxcd == 93 {
                  hold lxf = lxq2
                }
                hold lxq2 = lxq2 + 1
              }
              when lxf >= 0 && lxnest == 0 {
                hold lxo = concat(lxo, "sx_lget(")
                hold lxo = concat(lxo, lxw)
                hold lxo = concat(lxo, ",")
                hold lxk2 = lxe + 1
                while lxk2 < lxf {
                  hold lxo = concat(lxo, chr(sx_index(ctrim, lxk2)))
                  hold lxk2 = lxk2 + 1
                }
                hold lxo = concat(lxo, ")")
                hold lxi = lxf + 1
              } otherwise {
                hold lxo = concat(lxo, lxw)
                hold lxi = lxe
              }
            } otherwise {
              hold lxo = concat(lxo, lxw)
              hold lxi = lxe
            }
          } otherwise {
            hold lxo = concat(lxo, chr(lxc))
            hold lxi = lxi + 1
          }
        }
      }
      hold ctrim = lxo
      hold cl = len(ctrim)
    }

    // ---- shared rewrite: conditions (act 3), give (act 6) and
    //      parenthesized hold/show expressions (act 8) are verbatim C in
    //      ctrim/cl; lower `%` through checked sx_mod and make `/` a double
    //      division. Result in crepl. ----
    when act == 3 || act == 6 || act == 8 {
      // ---- string == != < <= > >= ----
      // In C, `a == b` and `a < b` on two char* compare addresses, so two
      // equal strings built at run time compare unequal and ordering is
      // arbitrary. For `A op B` where A is a declared string (|A| in sdecls)
      // and B is a declared string or a quoted literal, emit sx_eq (strcmp)
      // for == and != and sx_cmp (strcmp) for the orderings. Anything else is
      // copied as it was.
      hold seo = ""
      hold seoi = 0
      hold seoc = 0
      hold seoq = 0
      hold seop = 0
      hold seolen = 1
      hold seonx = 0
      hold seoneg = 0
      hold seoj = 0
      hold seoe = 0
      hold seoin = 0
      hold seoc2 = 0
      hold seoc3 = 0
      hold seol = ""
      hold ser = ""
      hold seoquo = 0
      hold seorj = 0
      hold seols = 0
      hold seors = 0
      hold seolk = ""
      hold seork = ""
      hold seoli = 0
      hold seomt = 0
      hold seoj2 = 0
      hold seonew = ""
      hold seoq3 = 0
      hold seopc = 0
      hold seopt = ""
      hold seolq = 0
      while seoi < cl {
        hold seoc = sx_index(ctrim, seoi)
        when seoc == 34 {
          // string literal: copy verbatim, escapes kept
          hold seo = concat(seo, chr(34))
          hold seoi = seoi + 1
          hold seoq = 1
          while seoq == 1 && seoi < cl {
            hold seoc = sx_index(ctrim, seoi)
            hold seo = concat(seo, chr(seoc))
            hold seoi = seoi + 1
            when seoc == 92 && seoi < cl {
              hold seo = concat(seo, chr(sx_index(ctrim, seoi)))
              hold seoi = seoi + 1
            } otherwise {
              when seoc == 34 {
                hold seoq = 0
              }
            }
          }
        } otherwise {
          hold seonx = 0
          when seoi + 1 < cl {
            hold seonx = sx_index(ctrim, seoi + 1)
          }
          hold seop = 0
          hold seolen = 1
          hold seopt = ""
          when seoc == 61 && seonx == 61 {
            hold seop = 1
            hold seolen = 2
            hold seopt = "=="
          }
          when seoc == 33 && seonx == 61 {
            hold seop = 2
            hold seolen = 2
            hold seopt = "!="
          }
          when seoc == 60 && seonx == 61 {
            hold seop = 3
            hold seolen = 2
            hold seopt = "<="
          }
          when seoc == 62 && seonx == 61 {
            hold seop = 4
            hold seolen = 2
            hold seopt = ">="
          }
          when seoc == 60 && seonx != 61 {
            hold seop = 5
            hold seolen = 1
            hold seopt = "<"
          }
          when seoc == 62 && seonx != 61 {
            hold seop = 6
            hold seolen = 1
            hold seopt = ">"
          }
          // a == that is part of <= >= or != is not an equality test
          when seop == 1 && seoi > 0 {
            hold seopc = sx_index(ctrim, seoi - 1)
            when seopc == 60 || seopc == 62 || seopc == 61 || seopc == 33 {
              hold seop = 0
            }
          }
          when seop == 0 {
            hold seo = concat(seo, chr(seoc))
            hold seoi = seoi + 1
          } otherwise {
            // left operand: the identifier just before the operator
            hold seoe = len(seo)
            hold seoj = seoe
            while seoj > 0 && sx_index(seo, seoj - 1) == 32 {
              hold seoj = seoj - 1
            }
            hold seoe = seoj
            hold seolq = 0
            // a quoted literal on the left: back to its opening quote
            when seoj > 0 && sx_index(seo, seoj - 1) == 34 {
              hold seolq = 1
              hold seoj = seoj - 1
              hold seoin = 1
              while seoin == 1 {
                hold seoin = 0
                when seoj > 0 {
                  hold seoc2 = sx_index(seo, seoj - 1)
                  hold seoj = seoj - 1
                  when seoc2 == 34 {
                    when seoj > 0 && sx_index(seo, seoj - 1) == 92 {
                      hold seoin = 1
                    }
                  } otherwise {
                    hold seoin = 1
                  }
                }
              }
            }
            // an identifier on the left
            when seolq == 0 {
              hold seoin = 1
            }
            while seoin == 1 {
              hold seoin = 0
              when seoj > 0 {
                hold seoc2 = sx_index(seo, seoj - 1)
                when (seoc2 >= 97 && seoc2 <= 122) || (seoc2 >= 65 && seoc2 <= 90) || (seoc2 >= 48 && seoc2 <= 57) || seoc2 == 95 {
                  hold seoj = seoj - 1
                  hold seoin = 1
                }
              }
            }
            hold seol = ""
            hold seoq3 = seoj
            while seoq3 < seoe {
              hold seol = concat(seol, chr(sx_index(seo, seoq3)))
              hold seoq3 = seoq3 + 1
            }
            // right operand: a quoted literal or an identifier
            hold seorj = seoi + seolen
            while seorj < cl && sx_index(ctrim, seorj) == 32 {
              hold seorj = seorj + 1
            }
            hold ser = ""
            hold seoquo = 0
            when seorj < cl && sx_index(ctrim, seorj) == 34 {
              hold seoquo = 1
              hold ser = chr(34)
              hold seorj = seorj + 1
              hold seoq = 1
              while seoq == 1 && seorj < cl {
                hold seoc3 = sx_index(ctrim, seorj)
                hold ser = concat(ser, chr(seoc3))
                hold seorj = seorj + 1
                when seoc3 == 92 && seorj < cl {
                  hold ser = concat(ser, chr(sx_index(ctrim, seorj)))
                  hold seorj = seorj + 1
                } otherwise {
                  when seoc3 == 34 {
                    hold seoq = 0
                  }
                }
              }
            } otherwise {
              hold seoin = 1
              while seoin == 1 {
                hold seoin = 0
                when seorj < cl {
                  hold seoc2 = sx_index(ctrim, seorj)
                  when (seoc2 >= 97 && seoc2 <= 122) || (seoc2 >= 65 && seoc2 <= 90) || (seoc2 >= 48 && seoc2 <= 57) || seoc2 == 95 {
                    hold ser = concat(ser, chr(seoc2))
                    hold seorj = seorj + 1
                    hold seoin = 1
                  }
                }
              }
            }
            // both sides must be strings: the left is declared, the right is
            // a quoted literal or a declared string
            hold seols = 0
            hold seors = 0
            when seolq == 1 {
              hold seols = 1
            }
            when seolq == 0 && len(seol) > 0 {
              hold seolk = concat(concat("|", seol), "|")
              hold seoli = 0
              while seoli + len(seolk) <= len(sdecls) {
                hold seomt = 1
                hold seoj2 = 0
                while seoj2 < len(seolk) {
                  when sx_index(sdecls, seoli + seoj2) == sx_index(seolk, seoj2) {
                    hold seoj2 = seoj2 + 1
                  } otherwise {
                    hold seomt = 0
                    hold seoj2 = len(seolk)
                  }
                }
                when seomt == 1 {
                  hold seols = 1
                  hold seoli = len(sdecls)
                } otherwise {
                  hold seoli = seoli + 1
                }
              }
            }
            when seoquo == 0 && len(ser) > 0 {
              hold seork = concat(concat("|", ser), "|")
              hold seoli = 0
              while seoli + len(seork) <= len(sdecls) {
                hold seomt = 1
                hold seoj2 = 0
                while seoj2 < len(seork) {
                  when sx_index(sdecls, seoli + seoj2) == sx_index(seork, seoj2) {
                    hold seoj2 = seoj2 + 1
                  } otherwise {
                    hold seomt = 0
                    hold seoj2 = len(seork)
                  }
                }
                when seomt == 1 {
                  hold seors = 1
                  hold seoli = len(sdecls)
                } otherwise {
                  hold seoli = seoli + 1
                }
              }
            }
            when seols == 1 && (seoquo == 1 || seors == 1) {
              // rebuild the output without the left operand, then the strcmp
              hold seonew = ""
              hold seoq3 = 0
              while seoq3 < seoj {
                hold seonew = concat(seonew, chr(sx_index(seo, seoq3)))
                hold seoq3 = seoq3 + 1
              }
              hold seo = concat(seonew, "sx_eq(")
              when seop >= 3 {
                hold seo = concat(seonew, "sx_cmp(")
              }
              hold seo = concat(seo, seol)
              hold seo = concat(seo, ", ")
              hold seo = concat(seo, ser)
              hold seo = concat(seo, ")")
              when seop == 1 {
                hold seo = concat(seo, " == 1.0")
              }
              when seop == 2 {
                hold seo = concat(seo, " == 0.0")
              }
              when seop >= 3 {
                hold seo = concat(seo, " ")
                hold seo = concat(seo, seopt)
                hold seo = concat(seo, " 0.0")
              }
              hold seoi = seorj
            } otherwise {
              hold seo = concat(seo, chr(seoc))
              when seolen == 2 {
                hold seo = concat(seo, chr(seonx))
              }
              hold seoi = seoi + seolen
            }
          }
        }
      }
      hold ctrim = seo
      // ---- parenthesise the operand of `not` ------------------------
      // In Sayanox `not` binds looser than a comparison, so `not a == 2`
      // is `!(a == 2)`; C's `!` binds tighter than `==`, which would make
      // it `(!a) == 2`.  Wrap the operand: everything from `not` up to the
      // next top-level `and` / `or`, or to the end of the condition.
      hold npin = ctrim
      hold npout = ""
      hold npi = 0
      hold npl = len(npin)
      hold npq = 0
      // declared here, not in the innermost block that first needs them:
      // Sayanox scopes a `hold` to the block it first appears in.
      hold npc2 = 0
      hold nprun = 0
      while npi < npl {
        hold npc = sx_index(npin, npi)
        when npq == 1 {
          hold npout = concat(npout, chr(npc))
          when npc == 92 {
            when npi + 1 < npl {
              hold npout = concat(npout, chr(sx_index(npin, npi + 1)))
              hold npi = npi + 1
            }
          } otherwise {
            when npc == 34 {
              hold npq = 0
            }
          }
          hold npi = npi + 1
        } otherwise {
          when npc == 34 {
            hold npq = 1
            hold npout = concat(npout, chr(npc))
            hold npi = npi + 1
          } otherwise {
            when (npc >= 97 && npc <= 122) || (npc >= 65 && npc <= 90) || npc == 95 {
              // read the whole word
              hold npw = ""
              hold npj = npi
              hold nprun = 1
              while nprun == 1 {
                when npj >= npl {
                  hold nprun = 0
                } otherwise {
                  hold npc2 = sx_index(npin, npj)
                  when (npc2 >= 97 && npc2 <= 122) || (npc2 >= 65 && npc2 <= 90) || (npc2 >= 48 && npc2 <= 57) || npc2 == 95 {
                    hold npw = concat(npw, chr(npc2))
                    hold npj = npj + 1
                  } otherwise {
                    hold nprun = 0
                  }
                }
              }
              hold npout = concat(npout, npw)
              hold npi = npj
              when sx_eq(npw, "not") {
                // blanks after the keyword
                hold nprun = 1
                while nprun == 1 {
                  when npi >= npl {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npi)
                    when npc2 == 32 || npc2 == 9 || npc2 == 13 {
                      hold npi = npi + 1
                    } otherwise {
                      hold nprun = 0
                    }
                  }
                }
                hold nps = npi
                // the end of the operand: the next top-level `and` / `or`
                hold npd = 0
                hold npq2 = 0
                hold npe = npl
                hold npi2 = nps
                hold nprun = 1
                while nprun == 1 {
                  when npi2 >= npl {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npi2)
                    when npq2 == 1 {
                      when npc2 == 92 {
                        hold npi2 = npi2 + 1
                      } otherwise {
                        when npc2 == 34 {
                          hold npq2 = 0
                        }
                      }
                      hold npi2 = npi2 + 1
                    } otherwise {
                      when npc2 == 34 {
                        hold npq2 = 1
                        hold npi2 = npi2 + 1
                      } otherwise {
                        when npc2 == 40 {
                          hold npd = npd + 1
                          hold npi2 = npi2 + 1
                        } otherwise {
                          when npc2 == 41 {
                            hold npd = npd - 1
                            hold npi2 = npi2 + 1
                          } otherwise {
                            when (npc2 >= 97 && npc2 <= 122) || (npc2 >= 65 && npc2 <= 90) || npc2 == 95 {
                              hold npw2 = ""
                              hold npj2 = npi2
                              hold nprun2 = 1
                              while nprun2 == 1 {
                                when npj2 >= npl {
                                  hold nprun2 = 0
                                } otherwise {
                                  hold npc3 = sx_index(npin, npj2)
                                  when (npc3 >= 97 && npc3 <= 122) || (npc3 >= 65 && npc3 <= 90) || (npc3 >= 48 && npc3 <= 57) || npc3 == 95 {
                                    hold npw2 = concat(npw2, chr(npc3))
                                    hold npj2 = npj2 + 1
                                  } otherwise {
                                    hold nprun2 = 0
                                  }
                                }
                              }
                              when npd == 0 && (sx_eq(npw2, "and") || sx_eq(npw2, "or")) {
                                hold npe = npi2
                                hold nprun = 0
                              } otherwise {
                                hold npi2 = npj2
                              }
                            } otherwise {
                              hold npi2 = npi2 + 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
                // drop trailing blanks and wrap, when there is an operand
                hold nprun = 1
                while nprun == 1 {
                  when npe <= nps {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npe - 1)
                    when npc2 == 32 || npc2 == 9 || npc2 == 13 {
                      hold npe = npe - 1
                    } otherwise {
                      hold nprun = 0
                    }
                  }
                }
                when npe > nps {
                  hold npout = concat(npout, "(")
                  hold npk = nps
                  while npk < npe {
                    hold npout = concat(npout, chr(sx_index(npin, npk)))
                    hold npk = npk + 1
                  }
                  hold npout = concat(npout, ")")
                  hold npi = npe
                }
              }
            } otherwise {
              hold npout = concat(npout, chr(npc))
              hold npi = npi + 1
            }
          }
        }
      }
      hold ctrim = npout
      hold cl = len(ctrim)
      // ---- rewrite '%' to the checked helper ----
      // C precedence already matches pure-min for + - * / and the
      // comparisons, so only '%' needs work here:
      //   L % R   ->   sx_mod(L, R)
      // L is the maximal * / % chain to the left, R is the next atom.
      hold crepl = ""
      hold cwi = 0
      while cwi < cl {
        hold ccx = sx_index(ctrim, cwi)
        when ccx == 34 {
          // string literal: copy verbatim, escapes kept
          hold crepl = concat(crepl, chr(ccx))
          hold cwi = cwi + 1
          hold cwrun = 1
          while cwrun == 1 {
            when cwi >= cl {
              hold cwrun = 0
            } otherwise {
              hold ccx = sx_index(ctrim, cwi)
              hold crepl = concat(crepl, chr(ccx))
              hold cwi = cwi + 1
              when ccx == 92 {
                when cwi < cl {
                  hold crepl = concat(crepl, chr(sx_index(ctrim, cwi)))
                  hold cwi = cwi + 1
                }
              } otherwise {
                when ccx == 34 {
                  hold cwrun = 0
                }
              }
            }
          }
        } otherwise {
          when ccx == 37 {
            // ---- left operand: scan back over the mul-level chain ----
            hold cwal = len(crepl)
            hold cwrun = 1
            while cwrun == 1 {
              hold cwrun = 0
              when cwal > 0 {
                hold ccx = sx_index(crepl, cwal - 1)
                when ccx == 41 || ccx == 93 {
                  // skip a balanced (..) / [..] group, then keep going
                  hold cwbd = 1
                  hold cwal = cwal - 1
                  while cwbd > 0 {
                    when cwal <= 0 {
                      hold cwbd = 0
                    } otherwise {
                      hold ccx = sx_index(crepl, cwal - 1)
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwal = cwal - 1
                    }
                  }
                  hold cwrun = 1
                } otherwise {
                  when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 || ccx == 42 || ccx == 47 || ccx == 32 || ccx == 9 {
                    hold cwal = cwal - 1
                    hold cwrun = 1
                  }
                }
              }
            }
            // ---- right operand: the next atom (with .field / [i] / (..)) ----
            hold cwri = cwi + 1
            hold cwnb = 1
            while cwnb == 1 {
              when cwri >= cl {
                hold cwnb = 0
              } otherwise {
                hold ccx = sx_index(ctrim, cwri)
                when ccx == 32 || ccx == 9 {
                  hold cwri = cwri + 1
                } otherwise {
                  hold cwnb = 0
                }
              }
            }
            hold cwre = cwri
            when cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when ccx == 45 || ccx == 43 {
                hold cwre = cwre + 1
              }
            }
            when cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                hold cwnb = 1
                while cwnb == 1 {
                  when cwre >= cl {
                    hold cwnb = 0
                  } otherwise {
                    hold ccx = sx_index(ctrim, cwre)
                    when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                      hold cwre = cwre + 1
                    } otherwise {
                      hold cwnb = 0
                    }
                  }
                }
              }
            }
            // postfix groups and .field, repeated
            hold cwnb = 1
            while cwnb == 1 {
              hold cwnb = 0
              when cwre < cl {
                hold ccx = sx_index(ctrim, cwre)
                when ccx == 40 || ccx == 91 {
                  hold cwbd = 0
                  hold cwrun = 1
                  while cwrun == 1 {
                    when cwre >= cl {
                      hold cwrun = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwre)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwre = cwre + 1
                      when cwbd <= 0 {
                        hold cwrun = 0
                      }
                    }
                  }
                  hold cwnb = 1
                } otherwise {
                  when ccx == 46 {
                    hold cwre = cwre + 1
                    hold cwrun = 1
                    while cwrun == 1 {
                      when cwre >= cl {
                        hold cwrun = 0
                      } otherwise {
                        hold ccx = sx_index(ctrim, cwre)
                        when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                          hold cwre = cwre + 1
                        } otherwise {
                          hold cwrun = 0
                        }
                      }
                    }
                    hold cwnb = 1
                  }
                }
              }
            }
            // ---- L, R, and cut crepl back to the start of L ----
            hold cwl = ""
            hold cwn = len(crepl)
            hold cwj = cwal
            while cwj < cwn {
              hold cwl = concat(cwl, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            hold cwr = ""
            hold cwj = cwri
            while cwj < cwre {
              hold cwr = concat(cwr, chr(sx_index(ctrim, cwj)))
              hold cwj = cwj + 1
            }
            hold cwnew = ""
            hold cwj = 0
            while cwj < cwal {
              hold cwnew = concat(cwnew, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            hold cwnew = concat(cwnew, "sx_mod((double)(")
            hold cwnew = concat(cwnew, cwl)
            hold cwnew = concat(cwnew, "),(double)(")
            hold cwnew = concat(cwnew, cwr)
            hold cwnew = concat(cwnew, "))")
            hold crepl = cwnew
            hold cwi = cwre
          } otherwise {
            when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || ccx == 95 {
              // ---- an identifier: lower a builtin call to its runtime
              //      helper, so a `give`, a condition or a parenthesized
              //      expression may call concat/len/chr/... directly ----
              hold cwid = ""
              hold cwj2 = cwi
              hold cww = 1
              while cww == 1 {
                when cwj2 >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwj2)
                  when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                    hold cwid = concat(cwid, chr(ccx))
                    hold cwj2 = cwj2 + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwnx = cwj2
              hold cww = 1
              while cww == 1 {
                when cwnx >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwnx)
                  when ccx == 32 || ccx == 9 {
                    hold cwnx = cwnx + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwcall = 0
              when cwnx < cl {
                hold ccx = sx_index(ctrim, cwnx)
                when ccx == 40 {
                  hold cwcall = 1
                }
              }
              hold cwmap = ""
              // word operators and boolean literals (full language)
              when sx_eq(cwid, "and") {
                hold cwmap = "&&"
              }
              when sx_eq(cwid, "or") {
                hold cwmap = "||"
              }
              when sx_eq(cwid, "not") {
                hold cwmap = "!"
              }
              when sx_eq(cwid, "true") {
                hold cwmap = "1"
              }
              when sx_eq(cwid, "false") {
                hold cwmap = "0"
              }
              when cwcall == 1 && sx_eq(cwmap, "") {
                when sx_eq(cwid, "concat") {
                  hold cwmap = "sx_cat"
                  hold rt = 1
                }
                when sx_eq(cwid, "chr") {
                  hold cwmap = "sx_chr"
                  hold rt = 1
                }
                when sx_eq(cwid, "sx_index") {
                  hold cwmap = "sx_idx"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_file") {
                  hold cwmap = "sx_read"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_file") {
                  hold cwmap = "sx_write"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg") {
                  hold cwmap = "sx_arg"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg_count") {
                  hold cwmap = "sx_argc"
                  hold rt = 1
                }
                when sx_eq(cwid, "gc") || sx_eq(cwid, "sx_gc_run") {
                  hold cwmap = "sx_gc_run"
                }
                when sx_eq(cwid, "gc_live") || sx_eq(cwid, "sx_gc_live") {
                  hold cwmap = "sx_gc_live"
                }
                when sx_eq(cwid, "gc_runs") || sx_eq(cwid, "sx_gc_count") {
                  hold cwmap = "sx_gc_count"
                }
                when sx_eq(cwid, "read_line") {
                  hold cwmap = "sx_read_line"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_n") {
                  hold cwmap = "sx_read_n"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_out") {
                  hold cwmap = "sx_write_out"
                  hold rt = 1
                }
                when sx_eq(cwid, "flush_out") {
                  hold cwmap = "sx_flush_out"
                  hold rt = 1
                }
                when sx_eq(cwid, "numstr") {
                  hold cwmap = "sx_numstr"
                  hold rt = 1
                }
                when sx_eq(cwid, "string_eq") {
                  hold cwmap = "sx_eq"
                  hold rt = 1
                }
                when sx_eq(cwid, "push") {
                  hold cwmap = "sx_lpush"
                  hold lt = 1
                }
                when sx_eq(cwid, "len") {
                  // len(xs) on a list variable is sx_llen, otherwise sx_len
                  hold cwarg = ""
                  hold cwai = cwnx + 1
                  hold cwbd = 1
                  hold cww = 1
                  while cww == 1 {
                    when cwai >= cl {
                      hold cww = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwai)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      when cwbd == 0 {
                        hold cww = 0
                      } otherwise {
                        hold cwarg = concat(cwarg, chr(ccx))
                      }
                      hold cwai = cwai + 1
                    }
                  }
                  hold cwal2 = len(cwarg)
                  hold cwt = 1
                  while cwt == 1 {
                    when cwal2 <= 0 {
                      hold cwt = 0
                    } otherwise {
                      hold ccx = sx_index(cwarg, cwal2 - 1)
                      when ccx == 32 || ccx == 9 {
                        hold cwal2 = cwal2 - 1
                      } otherwise {
                        hold cwt = 0
                      }
                    }
                  }
                  hold cwarg2 = ""
                  hold cwa2 = 0
                  while cwa2 < cwal2 {
                    hold cwarg2 = concat(cwarg2, chr(sx_index(cwarg, cwa2)))
                    hold cwa2 = cwa2 + 1
                  }
                  hold cwlkey = concat("|", cwarg2)
                  hold cwlkey = concat(cwlkey, "|")
                  hold cwlkl = len(cwlkey)
                  hold cwll = len(ldecls)
                  hold cwli = 0
                  hold cwlf = 0
                  while cwli + cwlkl <= cwll {
                    hold cwlok = 1
                    hold cwlj = 0
                    while cwlj < cwlkl {
                      hold cwla = sx_index(ldecls, cwli + cwlj)
                      hold cwlb = sx_index(cwlkey, cwlj)
                      when cwla == cwlb {
                        hold cwlj = cwlj + 1
                      } otherwise {
                        hold cwlok = 0
                        hold cwlj = cwlkl
                      }
                    }
                    when cwlok == 1 {
                      hold cwlf = 1
                      hold cwli = cwll
                    } otherwise {
                      hold cwli = cwli + 1
                    }
                  }
                  when cwlf == 1 {
                    hold cwmap = "sx_llen"
                    hold lt = 1
                  } otherwise {
                    hold cwmap = "sx_len"
                    hold rt = 1
                  }
                }
              }
              when sx_eq(cwmap, "") {
                hold crepl = concat(crepl, cwid)
              } otherwise {
                // keep the call's own spacing: only the name is replaced
                hold crepl = concat(crepl, cwmap)
              }
              hold cwi = cwj2
            } otherwise {
              hold crepl = concat(crepl, chr(ccx))
              // `/` always divides doubles (10 / 4 is 2.5, never C's 2)
              when ccx == 47 {
                hold crepl = concat(crepl, "(double)")
              }
              hold cwi = cwi + 1
            }
          }
        }
      }
    }

    // ---- while/when: emit ----
    when act == 3 {
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when iswhile == 1 {
        hold body = concat(body, "while (")
        hold whiles = whiles + 1
      } otherwise {
        hold body = concat(body, "if (")
        hold whens = whens + 1
      }
      hold body = concat(body, crepl)
      hold body = concat(body, ") {")
      hold body = concat(body, nl)
      hold depth = depth + 1
      when iswhile == 1 {
        hold blk = concat(blk, "w")
        hold loopd = loopd + 1
      } otherwise {
        hold blk = concat(blk, "i")
      }
    }

    // ---- give: emit ----
    when act == 6 {
      hold body = concat(body, "  return ")
      hold body = concat(body, crepl)
      hold body = concat(body, ";")
      hold body = concat(body, nl)
    }

    // ================= hold/show with a parenthesized expression =================
    // ctrim was validated in the pre-checks and rewritten into crepl
    when act == 8 {
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when pmode == 2 {
        hold body = concat(body, ind)
        hold body = concat(body, "printf(\"%g\\n\", (double)(")
        hold body = concat(body, crepl)
        hold body = concat(body, "));")
        hold body = concat(body, nl)
        hold shows = shows + 1
      } otherwise {
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = sdecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold pok2 = pfound
        hold psrc = ldecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "=")
        hold psrc = svars
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        when pok2 == 1 {
          when perr == 0 {
            hold permsg = concat("cannot hold a number in '", pnm)
            hold permsg = concat(permsg, "', which already holds a string, list or struct")
          }
          hold perr = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = decls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold body = concat(body, ind)
        when pfound == 0 {
          hold body = concat(body, "double ")
          hold decls = concat(decls, pnm)
          hold decls = concat(decls, "|")
        }
        hold body = concat(body, pnm)
        hold body = concat(body, " = (")
        hold body = concat(body, crepl)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
        hold holds = holds + 1
      }
    }

    // ================= } and } otherwise { and } elif =================
    when act == 4 {
      hold pos = pos + 1
      // close bookkeeping: what kind of block does this `}` end?
      // ('w' while, 'f' for, 'i' when, 'e' else, 'E' elif-chain else,
      //  'm' make)  A closed loop lowers loopd, which is what makes
      // `break`/`continue` outside a loop a compile-time error.
      hold bkc = 0
      hold bkn = len(blk)
      when bkn > 0 {
        hold bkc = sx_index(blk, bkn - 1)
        hold bkt = ""
        hold bki = 0
        while bki + 1 < bkn {
          hold bkt = concat(bkt, chr(sx_index(blk, bki)))
          hold bki = bki + 1
        }
        hold blk = bkt
      }
      when bkc == 119 || bkc == 102 {
        when loopd > 0 {
          hold loopd = loopd - 1
        }
      }
      when bkc == 109 {
        // end of a make body: the enclosing code's variables are visible again
        hold decls = savdecls
        hold sdecls = savsdecls
        hold ldecls = savldecls
        hold svars = savsvars
      }
      // look ahead over blanks for the word "otherwise"
      hold wi = pos
      hold wsc = 1
      while wsc == 1 {
        when wi >= n {
          hold wsc = 0
        } otherwise {
          hold cw = sx_index(source,wi)
          when cw == 32 || cw == 9 || cw == 13 || cw == 10 {
            hold wi = wi + 1
          } otherwise {
            hold wsc = 0
          }
        }
      }
      hold wfound = 0
      hold wlen = 0
      when wi + 9 <= n {
        hold w9 = ""
        hold wk = 0
        while wk < 9 {
          hold w9 = concat(w9, chr(sx_index(source,wi + wk)))
          hold wk = wk + 1
        }
        hold wfound = sx_eq(w9, "otherwise")
        when wfound == 1 {
          hold wlen = 9
        }
      }
      // "else" is an alias of "otherwise" (must be the whole keyword)
      when wfound == 0 {
        when wi + 4 <= n {
          hold w4 = ""
          hold wk = 0
          while wk < 4 {
            hold w4 = concat(w4, chr(sx_index(source,wi + wk)))
            hold wk = wk + 1
          }
          when sx_eq(w4, "else") {
            hold wok = 1
            when wi + 4 < n {
              hold we = sx_index(source,wi + 4)
              when (we >= 97 && we <= 122) || (we >= 65 && we <= 90) || (we >= 48 && we <= 57) || we == 95 {
                hold wok = 0
              }
            }
            when wok == 1 {
              hold wfound = 1
              hold wlen = 4
            }
          }
        }
      }
      // ---- `} elif COND {` / `} else if COND {` (full language) ----
      // Both are compiled without a second parser: `} else {` is emitted
      // here and the keyword itself is rewritten to `when` in the source
      // (same byte count), so the ordinary `when` statement compiles the
      // condition - including the checked `%` rewrite - and opens a block
      // that the chain's closing `}` ends.  The chain's extra `else` level
      // is remembered as 'E' in blk and closed with the extra `}` when the
      // chain ends.
      hold iselif = 0
      hold elen = 0
      when wi + 4 <= n {
        hold ekw = ""
        hold eki = 0
        while eki < 4 {
          hold ekw = concat(ekw, chr(sx_index(source, wi + eki)))
          hold eki = eki + 1
        }
        when sx_eq(ekw, "elif") {
          hold enx = 0
          when wi + 4 < n {
            hold enx = sx_index(source, wi + 4)
          }
          hold eident = 0
          when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
            hold eident = 1
          }
          when eident == 0 {
            hold iselif = 1
            hold elen = 4
          }
        }
      }
      when iselif == 0 {
        hold ew4 = ""
        hold eki = 0
        while eki < 4 {
          when wi + eki < n {
            hold ew4 = concat(ew4, chr(sx_index(source, wi + eki)))
          }
          hold eki = eki + 1
        }
        // `else` and `otherwise` (wfound, length wlen) both start a chain
        when wfound == 1 {
          hold ep = wi + wlen
          hold eskip = 1
          while eskip == 1 {
            hold eskip = 0
            when ep < n {
              hold ec2 = sx_index(source, ep)
              when ec2 == 32 || ec2 == 9 || ec2 == 13 {
                hold ep = ep + 1
                hold eskip = 1
              }
            }
          }
          hold eif = ""
          hold eki = 0
          while eki < 2 {
            when ep + eki < n {
              hold eif = concat(eif, chr(sx_index(source, ep + eki)))
            }
            hold eki = eki + 1
          }
          when sx_eq(eif, "if") {
            hold enx = 0
            when ep + 2 < n {
              hold enx = sx_index(source, ep + 2)
            }
            hold eident = 0
            when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
              hold eident = 1
            }
            when eident == 0 {
              hold iselif = 1
              hold elen = ep + 2 - wi
            }
          }
          // `} else when COND {` is the same chain as `else if`: the 4-byte
          // keyword "when" is already in place, so the rewrite below only
          // blanks the `else ` prefix (same byte count, same chain close).
          when sx_eq(eif, "wh") && ep + 4 <= n {
            hold ewh = ""
            hold ewk = 0
            while ewk < 4 {
              hold ewh = concat(ewh, chr(sx_index(source, ep + ewk)))
              hold ewk = ewk + 1
            }
            hold enx = 0
            when ep + 4 < n {
              hold enx = sx_index(source, ep + 4)
            }
            hold eident = 0
            when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
              hold eident = 1
            }
            when sx_eq(ewh, "when") && eident == 0 {
              hold iselif = 1
              hold elen = ep + 4 - wi
            }
          }
        }
      }
      when iselif == 1 {
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
        // rewrite the keyword in place: `elif` -> `when`,
        // `else if` -> `when` + blanks (identical byte count)
        hold src2 = ""
        hold si = 0
        while si < wi {
          hold src2 = concat(src2, chr(sx_index(source, si)))
          hold si = si + 1
        }
        hold src2 = concat(src2, "when")
        hold si = wi + 4
        while si < wi + elen {
          hold src2 = concat(src2, " ")
          hold si = si + 1
        }
        while si < n {
          hold src2 = concat(src2, chr(sx_index(source, si)))
          hold si = si + 1
        }
        hold source = src2
        hold pos = wi
        hold blk = concat(blk, "E")
      }
      hold enormal = 1
      when iselif == 1 {
        hold enormal = 0
      }
      when wfound == 1 {
        hold enormal = 0
      }
      // A chain (`} else if COND {`, `} else when COND {`) was already
      // rewritten to `when` above and emits its own `} else {`: skip the
      // plain-else emission here, or the chain gets two else levels.
      when wfound == 1 && iselif == 0 {
        // "} otherwise {" and "} else {" both become "} else {"
        hold pos = wi + wlen
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 123 {
          hold pos = pos + 1
        }
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
        // keep the block kind: inside an `elif` chain this else is the
        // chain's else ('E'), otherwise a plain one ('e')
        hold bkt2 = ""
        hold bkl2 = len(blk)
        when bkl2 > 0 {
          hold bkt2 = chr(sx_index(blk, bkl2 - 1))
        }
        when bkt2 == "E" {
          hold blk = concat(blk, "E")
        } otherwise {
          hold blk = concat(blk, "e")
        }
      }
      when enormal == 1 {
        // Does this `}` end an `elif` chain?  Then the chain's extra
        // `else {` level ('E' in blk) also closes here, with one more `}`.
        hold eclose = 0
        hold eck = len(blk)
        hold edone = 0
        while edone == 0 {
          when eck > 0 {
            hold ecc = sx_index(blk, eck - 1)
            when ecc == 69 {
              hold eclose = eclose + 1
              hold ekt = ""
              hold eki2 = 0
              while eki2 + 1 < eck {
                hold ekt = concat(ekt, chr(sx_index(blk, eki2)))
                hold eki2 = eki2 + 1
              }
              hold blk = ekt
              hold eck = eck - 1
            } otherwise {
              hold edone = 1
            }
          } otherwise {
            hold edone = 1
          }
        }
        when depth > 0 {
          hold depth = depth - 1
        }
        when in_fn == 1 {
          when depth == 0 {
            hold body = concat(body, "}\n\n")
            hold fns = concat(fns, body)
            hold body = saved_body
            hold in_fn = 0
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
        } otherwise {
          hold ind = "  "
          hold wk = 0
          while wk < depth {
            hold ind = concat(ind, "  ")
            hold wk = wk + 1
          }
          hold body = concat(body, ind)
          hold body = concat(body, "}")
          hold body = concat(body, nl)
        }
        // the extra closes of an `elif` chain: one per `else {` level the
        // chain opened (see the note in act 4)
        hold eci = 0
        while eci < eclose {
          when depth > 0 {
            hold depth = depth - 1
          }
          when in_fn == 1 && depth == 0 {
            // the function body was just flushed; the extra brace still
            // belongs to the function text
            hold fns = concat(fns, "}\n")
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
          hold eci = eci + 1
        }
      }
    }

    // ================= make NAME ( params ) { =================
    when act == 5 {
      hold pos = pos + 4
      hold firstp = 1
      hold fn_params = ""
      hold fn_retkind = 110
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fn_name = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sx_index(source,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold fn_name = concat(fn_name, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 40 {
          hold pos = pos + 1
        }
      }
      hold fn_params = ""
      hold firstp = 1
      hold pr = 1
      while pr == 1 {
        when pos >= n {
          hold pr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 41 {
            hold pos = pos + 1
            hold pr = 0
          } otherwise {
            when cs == 44 || cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || cs == 95 {
                hold pn = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold pn = concat(pn, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when firstp == 0 {
                  hold fn_params = concat(fn_params, ", ")
                }
                hold fn_params = concat(fn_params, "double ")
                hold fn_params = concat(fn_params, pn)
                hold firstp = 0
              } otherwise {
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // optional `-> TYPE` (full language): the return type is recorded by
      // the signature pre-pass, so this only has to be skipped here
      hold cs = 0
      hold cs2 = 0
      when pos < n {
        hold cs = sx_index(source,pos)
      }
      when pos + 1 < n {
        hold cs2 = sx_index(source,pos + 1)
      }
      when cs == 45 && cs2 == 62 {
        hold pos = pos + 2
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold rtword = ""
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) {
              hold rtword = concat(rtword, chr(cs))
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold fnnx = 0
        when pos < n {
          hold fnnx = sx_index(source,pos)
        }
        hold fnnx2 = 0
        when pos + 1 < n {
          hold fnnx2 = sx_index(source,pos + 1)
        }
        when sx_eq(rtword, "str") && fnnx != 45 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "str") && fnnx == 45 && fnnx2 != 62 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "list") {
          hold fn_retkind = 108
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold saved_body = body
      hold body = ""
      when fn_retkind == 115 {
        hold body = concat(body, "static char *")
      } otherwise {
        when fn_retkind == 108 {
          hold body = concat(body, "static sx_list *")
        } otherwise {
          hold body = concat(body, "static double ")
        }
      }
      hold body = concat(body, fn_name)
      hold body = concat(body, "(")
      // the parameter list comes from the signature pre-pass:
      // `double a, char *b` for `make f(a, b: str)`
      hold fpt2 = ""
      hold fky = concat("|", fn_name)
      hold fky = concat(fky, "=")
      hold fkl = len(fky)
      hold fksrc = fsptx
      hold fki = 0
      hold fkln = len(fksrc)
      hold fkfound = 0
      while fki + fkl <= fkln {
        hold fkok = 1
        hold fkj = 0
        while fkj < fkl {
          hold fka = sx_index(fksrc, fki + fkj)
          hold fkb = sx_index(fky, fkj)
          when fka == fkb {
            hold fkj = fkj + 1
          } otherwise {
            hold fkok = 0
            hold fkj = fkl
          }
        }
        when fkok == 1 {
          hold fkfound = 1
          hold fkend = fki + fkl
          hold fkrun = 1
          while fkrun == 1 {
            when fkend >= fkln {
              hold fkrun = 0
            } otherwise {
              hold fka = sx_index(fksrc, fkend)
              when fka == 124 {
                hold fkrun = 0
              } otherwise {
                hold fpt2 = concat(fpt2, chr(fka))
                hold fkend = fkend + 1
              }
            }
          }
          hold fki = fkln
        } otherwise {
          hold fki = fki + 1
        }
      }
      when fkfound == 1 {
        hold fn_params = fpt2
      }
      hold body = concat(body, fn_params)
      hold body = concat(body, ") {")
      hold body = concat(body, nl)
      // Variables are scoped to their function: save the tables of the
      // enclosing (top level) code and start the body with an empty set, so
      // a `hold n = ...` in one function never turns into an assignment
      // because another function has a parameter or variable named `n`.
      hold savdecls = decls
      hold savsdecls = sdecls
      hold savldecls = ldecls
      hold savsvars = svars
      // Remember the parameter kinds.  `show name` and `hold name = ...`
      // inside the body must see a `str`/`list` parameter as the existing
      // variable it is (a numeric parameter stays numeric).
      hold ppi = 0
      hold ppl = len(fn_params)
      hold ppstart = 0
      hold ppname = ""
      hold ppkind = 0
      while ppi <= ppl {
        hold ppc = 0
        when ppi < ppl {
          hold ppc = sx_index(fn_params, ppi)
        }
        when ppi == ppl || ppc == 44 {
          hold ppj = ppi - 1
          hold ppname = ""
          hold ppstop = ppstart - 1
          while ppj >= ppstart {
            hold ppk = sx_index(fn_params, ppj)
            when (ppk >= 97 && ppk <= 122) || (ppk >= 65 && ppk <= 90) || (ppk >= 48 && ppk <= 57) || ppk == 95 {
              hold ppname = concat(chr(ppk), ppname)
              hold ppj = ppj - 1
            } otherwise {
              hold ppj = ppstop
            }
          }
          hold ppkind = 0
          hold ppj = ppstart
          while ppj + 7 <= ppi {
            when sx_index(fn_params, ppj) == 115 && sx_index(fn_params, ppj + 1) == 120 && sx_index(fn_params, ppj + 2) == 95 && sx_index(fn_params, ppj + 3) == 108 && sx_index(fn_params, ppj + 4) == 105 && sx_index(fn_params, ppj + 5) == 115 && sx_index(fn_params, ppj + 6) == 116 {
              hold ppkind = 2
            }
            hold ppj = ppj + 1
          }
          hold ppj = ppstart
          while ppj + 4 <= ppi {
            when sx_index(fn_params, ppj) == 99 && sx_index(fn_params, ppj + 1) == 104 && sx_index(fn_params, ppj + 2) == 97 && sx_index(fn_params, ppj + 3) == 114 {
              hold ppkind = 1
            }
            hold ppj = ppj + 1
          }
          when len(ppname) > 0 {
            hold decls = concat(decls, ppname)
            hold decls = concat(decls, "|")
            when ppkind == 1 {
              hold sdecls = concat(sdecls, ppname)
              hold sdecls = concat(sdecls, "|")
            }
            when ppkind == 2 {
              hold ldecls = concat(ldecls, ppname)
              hold ldecls = concat(ldecls, "|")
            }
          }
          hold ppstart = ppi + 1
        }
        hold ppi = ppi + 1
      }
      hold in_fn = 1
      hold depth = depth + 1
      hold blk = concat(blk, "m")
    }

    // ================= for NAME in A..B { =================
    // full-language statement (gen2 and later; the C seed never reads it):
    //   for i in 0..10 { ... }        counts A, A+1, ... while i < B
    // The counter is declared as a normal numeric variable the first time,
    // so it keeps the flat pure-min scoping rules; a later `for i in ...`
    // reuses it.  A and B are copied as C expressions (no `%`, which would
    // need the checked sx_mod rewrite) and are validated so nothing can
    // reach the output that is not a number, name, field, index or
    // + - * / ( ) chain.
    when act == 10 {
      // `pos` already points just past the word `for`
      hold fvstart = pos - 3
      hold fvspl = 0
      hold fvname = ""
      hold fva = ""
      hold fvb = ""
      hold fvok = 0
      hold ferr = 0
      hold fmsg = ""
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // the counter name
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 {
            hold fvname = concat(fvname, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fvname, "") {
        hold ferr = 1
        hold fmsg = "for loop: expected a counter name, e.g. for i in 0..10 {"
      }
      // blanks, then the word `in`
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fwin = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) {
            hold fwin = concat(fwin, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fwin, "in") {
      } otherwise {
        hold ferr = 1
        hold fmsg = "for loop: expected `in` after the counter name, e.g. for i in 0..10 {"
      }
      // blanks before A
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // A (or the list, for `for v in xs {`): text up to `..` or `{`
      hold fvmode = 0
      // fvstr = 1: `for c in s {` walks a declared string byte by byte (fvmode 1)
      hold fvstr = 0
      hold fvdup = 0
      hold fvrun = 1
      while fvrun == 1 {
        when pos >= n {
          hold fvrun = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 123 {
            // no `..`: this is `for V in LIST {`
            hold pos = pos + 1
            hold fvmode = 1
            hold fvrun = 0
          } otherwise {
            when fc == 46 {
              hold fc2 = 0
              when pos + 1 < n {
                hold fc2 = sx_index(source, pos + 1)
              }
              when fc2 == 46 {
                hold fvrun = 0
              } otherwise {
                hold fva = concat(fva, chr(fc))
                hold pos = pos + 1
              }
            } otherwise {
              when fc == 10 || fc == 13 {
                hold fvrun = 0
                hold ferr = 1
                hold fmsg = "for loop: expected `A..B` or a list name before the `{`"
              } otherwise {
                hold fva = concat(fva, chr(fc))
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold fc = 0
      when pos < n {
        hold fc = sx_index(source, pos)
      }
      when fvmode == 1 {
        hold pos = pos
      } otherwise {
        when fc == 46 {
          hold pos = pos + 2
        } otherwise {
          when ferr == 0 {
            hold ferr = 1
            hold fmsg = "for loop: expected `A..B` (two dots) before the `{`"
          }
        }
      }
      // ---- `for V in EXPR {` where EXPR is not a plain name ----------------
      // Bind the value to a hidden variable first and re-read the header as
      // `for V in __sx_fv.. {`.  The `hold` statement already knows how to
      // lower a list literal, a string literal, a call, a field or an index,
      // so `for` inherits all of it instead of growing its own copy.
      when fvmode == 1 && ferr == 0 {
        // the parsed text still carries the blanks before the `{`
        hold fvatr = fva
        hold fvtr2 = 1
        while fvtr2 == 1 {
          hold fvan = len(fvatr)
          when fvan <= 0 {
            hold fvtr2 = 0
          } otherwise {
            hold fvtc = sx_index(fvatr, fvan - 1)
            when fvtc == 32 || fvtc == 9 || fvtc == 13 {
              hold fvatr2 = ""
              hold fvi3 = 0
              while fvi3 < fvan - 1 {
                hold fvatr2 = concat(fvatr2, chr(sx_index(fvatr, fvi3)))
                hold fvi3 = fvi3 + 1
              }
              hold fvatr = fvatr2
            } otherwise {
              hold fvtr2 = 0
            }
          }
        }
        hold fvsimple = 1
        hold fvsi3 = 0
        hold fvsn = len(fvatr)
        while fvsi3 < fvsn {
          hold fvsc = sx_index(fvatr, fvsi3)
          when (fvsc >= 97 && fvsc <= 122) || (fvsc >= 65 && fvsc <= 90) || (fvsc >= 48 && fvsc <= 57) || fvsc == 95 {
            hold fvsi3 = fvsi3 + 1
          } otherwise {
            hold fvsimple = 0
            hold fvsi3 = fvsn
          }
        }
        when fvsimple == 0 && fvsn > 0 {
          hold forcnt = forcnt + 1
          hold fvtmp = "__sx_fv"
          hold fvt = forcnt
          while fvt > 0 {
            hold fvtmp = concat(fvtmp, "x")
            hold fvt = fvt - 1
          }
          hold fvnew = "hold "
          hold fvnew = concat(fvnew, fvtmp)
          hold fvnew = concat(fvnew, " = ")
          hold fvnew = concat(fvnew, fvatr)
          hold fvnew = concat(fvnew, nl)
          hold fvnew = concat(fvnew, "for ")
          hold fvnew = concat(fvnew, fvname)
          hold fvnew = concat(fvnew, " in ")
          hold fvnew = concat(fvnew, fvtmp)
          hold fvnew = concat(fvnew, " {")
          hold fvsrc = ""
          hold fvk = 0
          while fvk < fvstart {
            hold fvsrc = concat(fvsrc, chr(sx_index(source, fvk)))
            hold fvk = fvk + 1
          }
          hold fvsrc = concat(fvsrc, fvnew)
          hold fvk = pos
          while fvk < n {
            hold fvsrc = concat(fvsrc, chr(sx_index(source, fvk)))
            hold fvk = fvk + 1
          }
          hold source = fvsrc
          hold n = len(source)
          hold fvspl = 1
        }
      }
      // B: text up to the `{` (range mode only)
      hold fvrun2 = 1
      while fvrun2 == 1 && fvmode == 0 {
        when pos >= n {
          hold fvrun2 = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 123 {
            hold pos = pos + 1
            hold fvrun2 = 0
          } otherwise {
            when fc == 10 || fc == 13 {
              hold fvrun2 = 0
              hold ferr = 1
              hold fmsg = "for loop: expected `{` at the end of the for line"
            } otherwise {
              hold fvb = concat(fvb, chr(fc))
              hold pos = pos + 1
            }
          }
        }
      }
      // trim both range expressions (range mode; list mode trims A below)
      hold fl = len(fva)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fva, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fva2 = ""
      hold fi = 0
      while fi < fl {
        hold fva2 = concat(fva2, chr(sx_index(fva, fi)))
        hold fi = fi + 1
      }
      hold fva = fva2
      hold fl = len(fvb)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fvb, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fvb2 = ""
      hold fi = 0
      while fi < fl {
        hold fvb2 = concat(fvb2, chr(sx_index(fvb, fi)))
        hold fi = fi + 1
      }
      hold fvb = fvb2
      when fvmode == 1 {
        hold fvb = "1"
      }
      when sx_eq(fva, "") || sx_eq(fvb, "") {
        when ferr == 0 {
          hold ferr = 1
          hold fmsg = "for loop: the range is empty; write `for i in 0..10 {`"
        }
      }
      // validate: only characters that are safe C text for a numeric range
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fva)
      while fvi < fvln {
        hold fc = sx_index(fva, fvi)
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 && fvspl == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the start expression may use numbers, names, fields, indexes and + - * / ( ) only"
      }
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fvb)
      while fvi < fvln {
        hold fc = sx_index(fvb, fvi)
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 && fvspl == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the end expression may use numbers, names, fields, indexes and + - * / ( ) only"
      }
      // list mode: the iterated expression must be a list variable
      when fvmode == 1 && ferr == 0 {
        hold fvlkey = concat("|", fva)
        hold fvlkey = concat(fvlkey, "|")
        hold fvlkl = len(fvlkey)
        hold fvll = len(ldecls)
        hold fvli2 = 0
        hold fvlf = 0
        while fvli2 + fvlkl <= fvll {
          hold fvlok = 1
          hold fvlj = 0
          while fvlj < fvlkl {
            hold fvla = sx_index(ldecls, fvli2 + fvlj)
            hold fvlb = sx_index(fvlkey, fvlj)
            when fvla == fvlb {
              hold fvlj = fvlj + 1
            } otherwise {
              hold fvlok = 0
              hold fvlj = fvlkl
            }
          }
          when fvlok == 1 {
            hold fvlf = 1
            hold fvli2 = fvll
          } otherwise {
            hold fvli2 = fvli2 + 1
          }
        }
        // not a list: a declared string is walked byte by byte
        when fvlf == 0 {
          hold fvsf = 0
          hold fvsl = concat(concat("|", fva), "|")
          hold fvsl2 = len(fvsl)
          hold fvss = len(sdecls)
          hold fvsi2 = 0
          while fvsi2 + fvsl2 <= fvss {
            hold fvsok = 1
            hold fvsj = 0
            while fvsj < fvsl2 {
              hold fvsa = sx_index(sdecls, fvsi2 + fvsj)
              hold fvsb = sx_index(fvsl, fvsj)
              when fvsa == fvsb {
                hold fvsj = fvsj + 1
              } otherwise {
                hold fvsok = 0
                hold fvsj = fvsl2
              }
            }
            when fvsok == 1 {
              hold fvsf = 1
              hold fvsi2 = fvss
            } otherwise {
              hold fvsi2 = fvsi2 + 1
            }
          }
          when fvsf == 1 {
            hold fvstr = 1
          } otherwise {
            hold ferr = 1
            // a hidden `__sx_fv..` name was introduced for `for V in EXPR {`:
            // describe the form instead of naming the generated variable
            hold fvhid = 1
            hold fvhl = len(fva)
            when fvhl < 7 {
              hold fvhid = 0
            }
            when fvhid == 1 {
              hold fvhh = "__sx_fv"
              hold fvhi = 0
              while fvhi < 7 {
                when sx_index(fva, fvhi) == sx_index(fvhh, fvhi) {
                  hold fvhi = fvhi + 1
                } otherwise {
                  hold fvhid = 0
                  hold fvhi = 7
                }
              }
            }
            when fvhid == 1 {
              hold fmsg = "for loop: the expression after `in` is not a list or a string; write `for i in 0..N {` to count"
            } otherwise {
              hold fmsg = concat("for loop: '", fva)
              hold fmsg = concat(fmsg, "' is not a list or a string; write `for i in 0..N {` to count")
            }
          }
        }
      }
      // the counter must not already be a string or list
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = sdecls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            // a string loop may rebind a name that is already a string
            when fvstr == 1 {
              hold fvdup = 1
            } otherwise {
              hold ferr = 1
            }
            hold fvli = fvi
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
        when ferr == 1 {
          hold fmsg = concat("for loop: '", fvname)
          hold fmsg = concat(fmsg, "' is already a string or list; pick another counter name")
        }
      }
      // is the counter already declared as a number?
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = decls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        hold fvok = 1
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            hold fvok = 0
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
        // a string loop declares a new `char *` counter; a number of that name is an error
        when fvstr == 1 && fvok == 0 {
          hold ferr = 1
          hold fmsg = concat("for loop: '", fvname)
          hold fmsg = concat(fmsg, "' is already a number or a list; a string loop needs a new counter name")
        }
      }
      when fvspl == 1 {
        hold pos = fvstart
      } otherwise {
        when ferr == 1 {
          hold nerrscop = 1
          when sx_eq(scopmsg, "") {
            hold scopmsg = fmsg
          }
        } otherwise {
          hold ind = "  "
          hold wk = 0
          while wk < depth {
            hold ind = concat(ind, "  ")
            hold wk = wk + 1
          }
          when fvok == 1 && fvstr == 1 && fvdup == 0 {
            // for c in s { ... }: the counter is a string, assigned per byte below
            hold body = concat(body, ind)
            hold body = concat(body, "char *")
            hold body = concat(body, fvname)
            hold body = concat(body, " = \"\";")
            hold body = concat(body, nl)
            hold sdecls = concat(sdecls, fvname)
            hold sdecls = concat(sdecls, "|")
          }
          when fvok == 1 && fvstr == 0 {
            hold body = concat(body, ind)
            hold body = concat(body, "double ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            when fvmode == 1 {
              hold body = concat(body, "0.0")
            } otherwise {
              hold body = concat(body, fva)
            }
            hold body = concat(body, ";")
            hold body = concat(body, nl)
            hold decls = concat(decls, fvname)
            hold decls = concat(decls, "|")
          }
          when fvmode == 1 {
            when fvstr == 1 {
            // for c in s { ... }  ->  byte walk over the string: c is the one-byte
            // string at index __sx_ix (sx_idx is the byte, sx_chr makes a 1-char string)
            hold fvix = "__sx_ix"
            hold body = concat(body, ind)
            hold body = concat(body, "for (double ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = 0.0; ")
            hold body = concat(body, fvix)
            hold body = concat(body, " < sx_len(")
            hold body = concat(body, fva)
            hold body = concat(body, "); ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = ")
            hold body = concat(body, fvix)
            hold body = concat(body, " + 1.0) {")
            hold body = concat(body, nl)
            hold body = concat(body, ind)
            hold body = concat(body, "  ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = sx_chr(sx_idx(")
            hold body = concat(body, fva)
            hold body = concat(body, ", ")
            hold body = concat(body, fvix)
            hold body = concat(body, "));")
            hold body = concat(body, nl)
            } otherwise {
            // for v in xs { ... }  ->  index walk over the list
            // the walk index lives in the for-init, so C scoping gives every
            // nested list loop its own copy
            hold fvix = "__sx_ix"
            hold body = concat(body, ind)
            hold body = concat(body, "for (double ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = 0.0; ")
            hold body = concat(body, fvix)
            hold body = concat(body, " < sx_llen(")
            hold body = concat(body, fva)
            hold body = concat(body, "); ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = ")
            hold body = concat(body, fvix)
            hold body = concat(body, " + 1.0) {")
            hold body = concat(body, nl)
            hold lt = 1
            hold body = concat(body, ind)
            hold body = concat(body, "  ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = sx_lget(")
            hold body = concat(body, fva)
            hold body = concat(body, ", ")
            hold body = concat(body, fvix)
            hold body = concat(body, ");")
            hold body = concat(body, nl)
            }
          } otherwise {
            // The bound B may call len(NAME), the same builtin a `when`
            // condition accepts: map it to sx_llen for a declared list and to
            // sx_len otherwise (same lookup as the condition rewrite). Only the
            // emitted bound changes; the text is copied unchanged elsewhere.
            hold fvbc = ""
            hold fvbn = len(fvb)
            hold fvbi = 0
            while fvbi < fvbn {
              hold fvbhit = 0
              when fvbi + 3 < fvbn && sx_index(fvb, fvbi) == 108 && sx_index(fvb, fvbi + 1) == 101 && sx_index(fvb, fvbi + 2) == 110 && sx_index(fvb, fvbi + 3) == 40 {
                hold fvbhit = 1
                when fvbi > 0 {
                  hold fvbpc = sx_index(fvb, fvbi - 1)
                  when (fvbpc >= 97 && fvbpc <= 122) || (fvbpc >= 65 && fvbpc <= 90) || (fvbpc >= 48 && fvbpc <= 57) || fvbpc == 95 {
                    hold fvbhit = 0
                  }
                }
              }
              when fvbhit == 1 {
                // NAME is the text up to the closing ')' (identifiers only)
                hold fvbnm = ""
                hold fvbj = fvbi + 4
                while fvbj < fvbn && sx_index(fvb, fvbj) != 41 {
                  hold fvbnm = concat(fvbnm, chr(sx_index(fvb, fvbj)))
                  hold fvbj = fvbj + 1
                }
                hold fvbkey = concat(concat("|", fvbnm), "|")
                hold fvbkl = len(fvbkey)
                hold fvbll = len(ldecls)
                hold fvblf = 0
                hold fvbli = 0
                while fvbli + fvbkl <= fvbll {
                  hold fvbok = 1
                  hold fvblj = 0
                  while fvblj < fvbkl {
                    when sx_index(ldecls, fvbli + fvblj) == sx_index(fvbkey, fvblj) {
                      hold fvblj = fvblj + 1
                    } otherwise {
                      hold fvbok = 0
                      hold fvblj = fvbkl
                    }
                  }
                  when fvbok == 1 {
                    hold fvblf = 1
                    hold fvbli = fvbll
                  } otherwise {
                    hold fvbli = fvbli + 1
                  }
                }
                when fvblf == 1 {
                  hold fvbc = concat(fvbc, "sx_llen(")
                } otherwise {
                  hold fvbc = concat(fvbc, "sx_len(")
                }
                hold fvbc = concat(fvbc, fvbnm)
                hold fvbc = concat(fvbc, ")")
                when fvbj < fvbn {
                  hold fvbi = fvbj + 1
                } otherwise {
                  hold fvbi = fvbn
                }
              } otherwise {
                hold fvbc = concat(fvbc, chr(sx_index(fvb, fvbi)))
                hold fvbi = fvbi + 1
              }
            }
            hold body = concat(body, ind)
            hold body = concat(body, "for (")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            hold body = concat(body, fva)
            hold body = concat(body, "; ")
            hold body = concat(body, fvname)
            hold body = concat(body, " < ")
            hold body = concat(body, fvbc)
            hold body = concat(body, "; ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            hold body = concat(body, fvname)
            hold body = concat(body, " + 1) {")
            hold body = concat(body, nl)
          }
          hold depth = depth + 1
          hold blk = concat(blk, "f")
          hold loopd = loopd + 1
        }
      }
    }

    // ================= make NAME<T> ... { } (generic: skip, act 15) =====
    // A generic definition is not compiled here; the pre-pass stored its
    // body, and it is monomorphised on demand (see gwant below).
    when act == 15 {
      // skip from the current position up to the matching `}` of the header
      hold pos = pos + 4
      hold gdep = 0
      hold gq = 0
      hold grun = 1
      while grun == 1 {
        when pos >= n {
          hold grun = 0
        } otherwise {
          hold gc = sx_index(source, pos)
          when gq == 1 {
            hold pos = pos + 1
            when gc == 92 {
              when pos < n {
                hold pos = pos + 1
              }
            } otherwise {
              when gc == 34 {
                hold gq = 0
              }
            }
          } otherwise {
            when gc == 34 {
              hold gq = 1
              hold pos = pos + 1
            } otherwise {
              when gc == 123 {
                hold gdep = gdep + 1
              }
              when gc == 125 {
                hold gdep = gdep - 1
              }
              hold pos = pos + 1
              when gdep == 0 && gc == 125 {
                hold grun = 0
              }
            }
          }
        }
      }
      // the body of a generic is only kept when every parameter and the
      // return type name one of its type parameters
      hold gskipok = 0
      hold gskipk = concat(chr(1), gskipnm)
      hold gskipk = concat(gskipk, chr(1))
      hold gskipkl = len(gskipk)
      hold gskipl = len(fgnames)
      hold gskipi = 0
      while gskipi + gskipkl <= gskipl {
        hold gskipm = 1
        hold gskipj = 0
        while gskipj < gskipkl {
          hold gskipa = sx_index(fgnames, gskipi + gskipj)
          hold gskipb = sx_index(gskipk, gskipj)
          when gskipa == gskipb {
            hold gskipj = gskipj + 1
          } otherwise {
            hold gskipm = 0
            hold gskipj = gskipkl
          }
        }
        when gskipm == 1 {
          hold gskipok = 1
          hold gskipi = gskipl
        } otherwise {
          hold gskipi = gskipi + 1
        }
      }
      when gskipok == 0 {
        when perr == 0 {
          hold permsg = concat("generic '", gskipnm)
          hold permsg = concat(permsg, "' must be written with type parameters used by every parameter and the return type, as in `make ")
          hold permsg = concat(permsg, gskipnm)
          hold permsg = concat(permsg, "<T>(a: T, b: T) -> T` or `make ")
          hold permsg = concat(permsg, gskipnm)
          hold permsg = concat(permsg, "<A, B>(a: A, b: B) -> A`")
        }
        hold perr = 1
      }
    }

    // ================= break / continue =================
    when act == 11 || act == 12 {
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when loopd == 0 {
        hold nerrscop = 1
        when sx_eq(scopmsg, "") {
          hold scopmsg = "break/continue outside a loop"
        }
      } otherwise {
        hold body = concat(body, ind)
        when act == 11 {
          hold body = concat(body, "break;")
        } otherwise {
          hold body = concat(body, "continue;")
        }
        hold body = concat(body, nl)
      }
    }

    // not a statement character: skip it


    // ================= struct Name { fields } =================
    when act == 7 {
      hold pos = pos + 6
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold stname = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sx_index(source,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold stname = concat(stname, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold sfields = ""
      hold firstp = 1
      hold tdskip = 1
      hold rn = 1
      while rn == 1 {
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 125 {
            hold pos = pos + 1
            hold rn = 0
          } otherwise {
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) {
              hold sf = ""
              hold rn2 = 1
              while rn2 == 1 {
                when pos >= n {
                  hold rn2 = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold sf = concat(sf, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn2 = 0
                  }
                }
              }
              when firstp == 0 {
                hold sfields = concat(sfields, ",")
              }
              hold sfields = concat(sfields, sf)
              hold firstp = 0
              hold sfields2 = concat(sfields2, sf)
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      hold sdefs = concat(sdefs, stname)
      hold sdefs = concat(sdefs, ":")
      hold sdefs = concat(sdefs, sfields)
      hold sdefs = concat(sdefs, ";")
    }

    // not the start of any statement: a stray character left over after a
    // statement (`hold x = 2.`, `show a b`) is a clear error, never skipped
    when act == 0 {
      when c != 47 {
        when perr == 0 {
          hold permsg = concat("unexpected '", chr(c))
          hold permsg = concat(permsg, "' (expected the end of the statement or a new statement)")
        }
        hold perr = 1
      }
      hold pos = pos + 1
    }

    // ---- flush completed output into obody (memory bound) -------------
    // A flat accumulator would copy the whole body on every append, which is
    // O(n^2): compiling this file used to allocate ~2.5 GB and get Killed on
    // low-RAM hosts.  Keep `body` under ~1 KB and append it to `obody` in
    // that unit instead.  `obody` is only appended at the end, so the emitted
    // text and its order are byte-for-byte unchanged.  Never flush while a
    // function body is being collected (`body` belongs to `fns` until the
    // matching `}` restores it).
    when in_fn == 0 {
      hold blen = len(body)
      when blen > 1024 {
        hold obody = concat(obody, body)
        hold body = ""
      }
    }
  }
}

// =====================================================================
// emit the C translation unit
// =====================================================================
hold out = ""
when rt == 1 {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <string.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n#include <setjmp.h>\n")
  hold out = concat(out, "typedef struct sx_list { double *d; long n; long cap; } sx_list;\ntypedef struct sx_gcb {\n  struct sx_gcb *next;      /* every live block, for the sweep */\n  size_t cls;               /* size class: the free list it goes back to */\n  size_t kind;              /* 0 raw bytes, 1 sx_list, 2 double array */\n  size_t mark;\n} sx_gcb;\n#define SX_GCH ((size_t)32)\n#define SX_NCLS 26\nstatic sx_gcb *sx_gcall = 0;\nstatic sx_gcb *sx_gfree[SX_NCLS];\nstatic char **sx_ghash = 0;               /* payload address -> block */\nstatic sx_gcb **sx_gblk = 0;\nstatic sx_gcb **sx_gsort = 0;             /* blocks by address, for interiors */\nstatic size_t sx_ghcap = 0, sx_ghlive = 0, sx_gsort_n = 0;\nstatic char *sx_stack_bot = 0;\nstatic double sx_gc_n = 0, sx_gc_freed = 0, sx_gc_thresh = 0, sx_gc_bytes = 0;\n\nstatic size_t sx_gc_class_size(size_t c){ return (size_t)32 << c; }\nstatic size_t sx_gc_cls(size_t need){\n")
  hold out = concat(out, "  size_t c = 0, sz = 32;\n  while (sz < need && c + 1 < SX_NCLS){ sz <<= 1; c += 1; }\n  return c;\n}\n\nstatic void sx_gc_rehash(size_t cap){\n  char **nh;\n  sx_gcb **nb;\n  sx_gcb *b;\n  if (cap < 4096) cap = 4096;\n  while (cap < (sx_ghlive + 1) * 4) cap <<= 1;\n  nh = (char**)calloc(cap, sizeof(char*));\n  nb = (sx_gcb**)calloc(cap, sizeof(sx_gcb*));\n  b = sx_gcall;\n  while (b){\n    char *pay = (char*)b + SX_GCH;\n    size_t h = ((size_t)pay >> 4) & (cap - 1);\n    while (nh[h]) h = (h + 1) & (cap - 1);\n    nh[h] = pay; nb[h] = b;\n    b = b->next;\n  }\n  free(sx_ghash); free(sx_gblk);\n  sx_ghash = nh; sx_gblk = nb; sx_ghcap = cap;\n}\n\nstatic void sx_gc_hash_put(char *pay, sx_gcb *b){\n  size_t h;\n  if (!sx_ghcap) sx_gc_rehash(1u << 12);\n  if ((sx_ghlive + 1) * 4 > sx_ghcap){ sx_gc_rehash(sx_ghcap * 2); return; }\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n")
  hold out = concat(out, "  while (sx_ghash[h]) h = (h + 1) & (sx_ghcap - 1);\n  sx_ghash[h] = pay; sx_gblk[h] = b;\n}\n\nstatic sx_gcb *sx_gc_hash_get(char *pay){\n  size_t h;\n  if (!sx_ghcap) return 0;\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n  while (sx_ghash[h] && sx_ghash[h] != pay) h = (h + 1) & (sx_ghcap - 1);\n  return sx_ghash[h] ? sx_gblk[h] : 0;\n}\n\nstatic int sx_gc_cmp(const void *a, const void *b){\n  char *pa = (char*)(*(sx_gcb* const*)a) + SX_GCH;\n  char *pb = (char*)(*(sx_gcb* const*)b) + SX_GCH;\n  return pa < pb ? -1 : (pa > pb ? 1 : 0);\n}\nstatic void sx_gc_sorted(void){\n  size_t i = 0;\n  sx_gcb *b = sx_gcall;\n  if (sx_gsort_n != sx_ghlive){\n    free(sx_gsort);\n    sx_gsort = (sx_gcb**)malloc((sx_ghlive + 1) * sizeof(sx_gcb*));\n  }\n  while (b && i < sx_ghlive){ sx_gsort[i] = b; i += 1; b = b->next; }\n  sx_gsort_n = i;\n  qsort(sx_gsort, i, sizeof(sx_gcb*), sx_gc_cmp);\n}\n")
  hold out = concat(out, "static sx_gcb *sx_gc_containing(char *p){\n  size_t lo = 0, hi = sx_gsort_n;\n  while (lo < hi){\n    size_t mid = (lo + hi) / 2;\n    char *pay = (char*)sx_gsort[mid] + SX_GCH;\n    size_t sz = sx_gc_class_size(sx_gsort[mid]->cls);\n    if (p < pay) hi = mid;\n    else if (p >= pay + sz) lo = mid + 1;\n    else return sx_gsort[mid];\n  }\n  return 0;\n}\n\nstatic void sx_gc_mark(void *p){\n  sx_gcb *b;\n  if (!p) return;\n  b = sx_gc_hash_get((char*)p);\n  if (!b) b = sx_gc_containing((char*)p);\n  if (!b || b->mark) return;\n  b->mark = 1;\n  if (b->kind == 1){\n    sx_list *L = (sx_list*)((char*)b + SX_GCH);\n    if (L->d) sx_gc_mark((char*)L->d);\n  }\n}\n\nstatic void sx_gc_scan(char *lo, char *hi){\n  lo = (char*)(((size_t)lo + 7u) & ~(size_t)7u);\n  while (lo + 8 <= hi){\n    sx_gc_mark(*(char**)lo);\n    lo += 8;\n  }\n}\n\nstatic void sx_gc_init(void *anchor){\n  sx_stack_bot = (char*)anchor;\n")
  hold out = concat(out, "  if (!sx_gc_thresh) sx_gc_thresh = (double)(8u << 20);\n}\n\nstatic void sx_gc_collect(void){\n  double before = sx_gc_bytes;\n  sx_gcb **pp;\n  if (!sx_gcall || !sx_stack_bot) return;\n  sx_gc_sorted();\n  {\n    jmp_buf jb;\n    setjmp(jb);\n    sx_gc_scan((char*)&jb, (char*)&jb + sizeof(jb));\n    sx_gc_scan((char*)&jb, sx_stack_bot);\n  }\n  pp = &sx_gcall;\n  while (*pp){\n    sx_gcb *b = *pp;\n    if (b->mark){\n      b->mark = 0;\n      pp = &b->next;\n    } else {\n      size_t c = b->cls;\n      *pp = b->next;\n      sx_gc_bytes -= (double)sx_gc_class_size(c);\n      sx_ghlive -= 1;\n      b->next = sx_gfree[c];\n      sx_gfree[c] = b;\n    }\n  }\n  sx_gc_n += 1.0;\n  sx_gc_freed = before - sx_gc_bytes;\n  sx_gsort_n = 0;\n  sx_gc_rehash(4096);\n  sx_gc_thresh = sx_gc_bytes * 1.5 + (double)(4u << 20);\n}\n\nstatic void *sx_gc_alloc(int kind, size_t payload){\n  size_t need = payload + SX_GCH;\n")
  hold out = concat(out, "  size_t c = sx_gc_cls(need);\n  sx_gcb *b;\n  if (sx_gc_bytes >= sx_gc_thresh) sx_gc_collect();\n  b = sx_gfree[c];\n  if (b) sx_gfree[c] = b->next;\n  else b = (sx_gcb*)malloc(sx_gc_class_size(c));\n  b->cls = c;\n  b->kind = (size_t)kind;\n  b->mark = 0;\n  b->next = sx_gcall;\n  sx_gcall = b;\n  sx_ghlive += 1;\n  sx_gc_hash_put((char*)b + SX_GCH, b);\n  sx_gc_bytes += (double)sx_gc_class_size(c);\n  return (char*)b + SX_GCH;\n}\n\nstatic double sx_gc_run(void){ sx_gc_collect(); return sx_gc_freed; }\nstatic double sx_gc_live(void){ return sx_gc_bytes; }\nstatic double sx_gc_count(void){ return sx_gc_n; }\n\n\n")
  hold out = concat(out, "static int sx_argn=0; static char **sx_argv_p=0;\n")
  hold out = concat(out, "static double sx_argc(void){ return (double)sx_argn; }\n")
  hold out = concat(out, "static char *sx_arg(double v){ long i=(long)v; if(i<0||i>=sx_argn) return \"\"; return sx_argv_p[i]; }\n")
  hold out = concat(out, "static char *sx_chr(double v){ char *b=(char*)sx_gc_alloc(0,2); b[0]=(char)(long)v; b[1]=0; return b; }\n")
  hold out = concat(out, "static char *sx_cat(const char *a,const char *b){ size_t la=strlen(a), lb=strlen(b); char *r=(char*)sx_gc_alloc(0,la+lb+1); memcpy(r,a,la); memcpy(r+la,b,lb); r[la+lb]=0; return r; }\n")
  hold out = concat(out, "static double sx_len(const void *s){ sx_gcb *b = sx_gc_hash_get((char*)s); if (b && b->kind == 1) return (double)((sx_list*)((char*)b + SX_GCH))->n; return (double)strlen((const char*)s); }\n")
  hold out = concat(out, "static double sx_idx(const char *s,double v){ long i=(long)v; long L=(long)strlen(s); if(i<0) i=i+L; if(i<0||i>=L){ fputs(\"sx: string index out of range\",stderr); exit(1); } return (double)(unsigned char)s[i]; }\n")
  hold out = concat(out, "static char *sx_read(const char *p){ FILE *f=fopen(p,\"rb\"); if(!f) return \"\"; fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char *b=(char*)sx_gc_alloc(0,(size_t)sz+1); size_t rd=fread(b,1,(size_t)sz,f); b[rd]=0; fclose(f); return b; }\n")
  hold out = concat(out, "static char *sx_read_line(void){ char b[4096]; if(!fgets(b,sizeof b,stdin)) return \"\"; size_t n=strlen(b); if(n&&b[n-1]==10) b[n-1]=0; n=strlen(b); if(n&&b[n-1]==13) b[n-1]=0; char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n+1); return r; }\n")
  hold out = concat(out, "static char *sx_read_n(double v){ long n=(long)v; if(n<0) return \"\"; char *b=(char*)sx_gc_alloc(0,(size_t)n+1); size_t rd=fread(b,1,(size_t)n,stdin); b[rd]=0; return b; }\n")
  hold out = concat(out, "static double sx_write_out(const char *s){ fputs(s,stdout); return 1.0; }\n")
  hold out = concat(out, "static double sx_flush_out(void){ fflush(stdout); return 1.0; }\n")
  hold out = concat(out, "static char *sx_numstr(double v){ char b[64]; snprintf(b,sizeof b,\"%g\",v); size_t n=strlen(b); char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n+1); return r; }\n")
  hold out = concat(out, "static double sx_write(const char *p,const char *s){ FILE *f=fopen(p,\"wb\"); if(!f) return 0.0; fputs(s,f); return fclose(f)==0?1.0:0.0; }\n")
  hold out = concat(out, "static double sx_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "static double sx_cmp(const char *a,const char *b){ return (double)strcmp(a,b); }\n")
  hold out = concat(out, "static double string_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static double sx_lset_idx(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return (double)i; }\n")
  hold out = concat(out, "static sx_list *sx_lset(sx_list *L,double v,double x){ L->d[(long)sx_lset_idx(L,v)]=x; return L; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)sx_gc_alloc(2,sizeof(double)*4);} if(L->n>=L->cap){ double *nd=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)(L->cap*2)); memcpy(nd,L->d,sizeof(double)*(size_t)L->n); L->d=nd; L->cap*=2;} L->d[L->n++]=v; return L; }\n")
  hold out = concat(out, "\n")
} otherwise {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n#include <string.h>\n#include <setjmp.h>\n\n")
  hold out = concat(out, "typedef struct sx_list { double *d; long n; long cap; } sx_list;\ntypedef struct sx_gcb {\n  struct sx_gcb *next;      /* every live block, for the sweep */\n  size_t cls;               /* size class: the free list it goes back to */\n  size_t kind;              /* 0 raw bytes, 1 sx_list, 2 double array */\n  size_t mark;\n} sx_gcb;\n#define SX_GCH ((size_t)32)\n#define SX_NCLS 26\nstatic sx_gcb *sx_gcall = 0;\nstatic sx_gcb *sx_gfree[SX_NCLS];\nstatic char **sx_ghash = 0;               /* payload address -> block */\nstatic sx_gcb **sx_gblk = 0;\nstatic sx_gcb **sx_gsort = 0;             /* blocks by address, for interiors */\nstatic size_t sx_ghcap = 0, sx_ghlive = 0, sx_gsort_n = 0;\nstatic char *sx_stack_bot = 0;\nstatic double sx_gc_n = 0, sx_gc_freed = 0, sx_gc_thresh = 0, sx_gc_bytes = 0;\n\nstatic size_t sx_gc_class_size(size_t c){ return (size_t)32 << c; }\nstatic size_t sx_gc_cls(size_t need){\n")
  hold out = concat(out, "  size_t c = 0, sz = 32;\n  while (sz < need && c + 1 < SX_NCLS){ sz <<= 1; c += 1; }\n  return c;\n}\n\nstatic void sx_gc_rehash(size_t cap){\n  char **nh;\n  sx_gcb **nb;\n  sx_gcb *b;\n  if (cap < 4096) cap = 4096;\n  while (cap < (sx_ghlive + 1) * 4) cap <<= 1;\n  nh = (char**)calloc(cap, sizeof(char*));\n  nb = (sx_gcb**)calloc(cap, sizeof(sx_gcb*));\n  b = sx_gcall;\n  while (b){\n    char *pay = (char*)b + SX_GCH;\n    size_t h = ((size_t)pay >> 4) & (cap - 1);\n    while (nh[h]) h = (h + 1) & (cap - 1);\n    nh[h] = pay; nb[h] = b;\n    b = b->next;\n  }\n  free(sx_ghash); free(sx_gblk);\n  sx_ghash = nh; sx_gblk = nb; sx_ghcap = cap;\n}\n\nstatic void sx_gc_hash_put(char *pay, sx_gcb *b){\n  size_t h;\n  if (!sx_ghcap) sx_gc_rehash(1u << 12);\n  if ((sx_ghlive + 1) * 4 > sx_ghcap){ sx_gc_rehash(sx_ghcap * 2); return; }\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n")
  hold out = concat(out, "  while (sx_ghash[h]) h = (h + 1) & (sx_ghcap - 1);\n  sx_ghash[h] = pay; sx_gblk[h] = b;\n}\n\nstatic sx_gcb *sx_gc_hash_get(char *pay){\n  size_t h;\n  if (!sx_ghcap) return 0;\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n  while (sx_ghash[h] && sx_ghash[h] != pay) h = (h + 1) & (sx_ghcap - 1);\n  return sx_ghash[h] ? sx_gblk[h] : 0;\n}\n\nstatic int sx_gc_cmp(const void *a, const void *b){\n  char *pa = (char*)(*(sx_gcb* const*)a) + SX_GCH;\n  char *pb = (char*)(*(sx_gcb* const*)b) + SX_GCH;\n  return pa < pb ? -1 : (pa > pb ? 1 : 0);\n}\nstatic void sx_gc_sorted(void){\n  size_t i = 0;\n  sx_gcb *b = sx_gcall;\n  if (sx_gsort_n != sx_ghlive){\n    free(sx_gsort);\n    sx_gsort = (sx_gcb**)malloc((sx_ghlive + 1) * sizeof(sx_gcb*));\n  }\n  while (b && i < sx_ghlive){ sx_gsort[i] = b; i += 1; b = b->next; }\n  sx_gsort_n = i;\n  qsort(sx_gsort, i, sizeof(sx_gcb*), sx_gc_cmp);\n}\n")
  hold out = concat(out, "static sx_gcb *sx_gc_containing(char *p){\n  size_t lo = 0, hi = sx_gsort_n;\n  while (lo < hi){\n    size_t mid = (lo + hi) / 2;\n    char *pay = (char*)sx_gsort[mid] + SX_GCH;\n    size_t sz = sx_gc_class_size(sx_gsort[mid]->cls);\n    if (p < pay) hi = mid;\n    else if (p >= pay + sz) lo = mid + 1;\n    else return sx_gsort[mid];\n  }\n  return 0;\n}\n\nstatic void sx_gc_mark(void *p){\n  sx_gcb *b;\n  if (!p) return;\n  b = sx_gc_hash_get((char*)p);\n  if (!b) b = sx_gc_containing((char*)p);\n  if (!b || b->mark) return;\n  b->mark = 1;\n  if (b->kind == 1){\n    sx_list *L = (sx_list*)((char*)b + SX_GCH);\n    if (L->d) sx_gc_mark((char*)L->d);\n  }\n}\n\nstatic void sx_gc_scan(char *lo, char *hi){\n  lo = (char*)(((size_t)lo + 7u) & ~(size_t)7u);\n  while (lo + 8 <= hi){\n    sx_gc_mark(*(char**)lo);\n    lo += 8;\n  }\n}\n\nstatic void sx_gc_init(void *anchor){\n  sx_stack_bot = (char*)anchor;\n")
  hold out = concat(out, "  if (!sx_gc_thresh) sx_gc_thresh = (double)(8u << 20);\n}\n\nstatic void sx_gc_collect(void){\n  double before = sx_gc_bytes;\n  sx_gcb **pp;\n  if (!sx_gcall || !sx_stack_bot) return;\n  sx_gc_sorted();\n  {\n    jmp_buf jb;\n    setjmp(jb);\n    sx_gc_scan((char*)&jb, (char*)&jb + sizeof(jb));\n    sx_gc_scan((char*)&jb, sx_stack_bot);\n  }\n  pp = &sx_gcall;\n  while (*pp){\n    sx_gcb *b = *pp;\n    if (b->mark){\n      b->mark = 0;\n      pp = &b->next;\n    } else {\n      size_t c = b->cls;\n      *pp = b->next;\n      sx_gc_bytes -= (double)sx_gc_class_size(c);\n      sx_ghlive -= 1;\n      b->next = sx_gfree[c];\n      sx_gfree[c] = b;\n    }\n  }\n  sx_gc_n += 1.0;\n  sx_gc_freed = before - sx_gc_bytes;\n  sx_gsort_n = 0;\n  sx_gc_rehash(4096);\n  sx_gc_thresh = sx_gc_bytes * 1.5 + (double)(4u << 20);\n}\n\nstatic void *sx_gc_alloc(int kind, size_t payload){\n  size_t need = payload + SX_GCH;\n")
  hold out = concat(out, "  size_t c = sx_gc_cls(need);\n  sx_gcb *b;\n  if (sx_gc_bytes >= sx_gc_thresh) sx_gc_collect();\n  b = sx_gfree[c];\n  if (b) sx_gfree[c] = b->next;\n  else b = (sx_gcb*)malloc(sx_gc_class_size(c));\n  b->cls = c;\n  b->kind = (size_t)kind;\n  b->mark = 0;\n  b->next = sx_gcall;\n  sx_gcall = b;\n  sx_ghlive += 1;\n  sx_gc_hash_put((char*)b + SX_GCH, b);\n  sx_gc_bytes += (double)sx_gc_class_size(c);\n  return (char*)b + SX_GCH;\n}\n\nstatic double sx_gc_run(void){ sx_gc_collect(); return sx_gc_freed; }\nstatic double sx_gc_live(void){ return sx_gc_bytes; }\nstatic double sx_gc_count(void){ return sx_gc_n; }\n\n\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static double sx_lset_idx(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return (double)i; }\n")
  hold out = concat(out, "static sx_list *sx_lset(sx_list *L,double v,double x){ L->d[(long)sx_lset_idx(L,v)]=x; return L; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)sx_gc_alloc(2,sizeof(double)*4);} if(L->n>=L->cap){ double *nd=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)(L->cap*2)); memcpy(nd,L->d,sizeof(double)*(size_t)L->n); L->d=nd; L->cap*=2;} L->d[L->n++]=v; return L; }\n\n")
}
hold fixfrom = len(out)
hold out = concat(out, gproto)
hold out = concat(out, fns)
// ---------------- struct typedefs (field types come from literals) ----------------
hold tdi = 0
hold tdn = len(sdefs)
while tdi < tdn {
  hold tdname = ""
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 58 {
        hold tdrun = 0
      } otherwise {
        hold tdname = concat(tdname, chr(tdc))
      }
      hold tdi = tdi + 1
    }
  }
  hold out = concat(out, "typedef struct {")
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 59 {
        hold tdrun = 0
        hold tdi = tdi + 1
      } otherwise {
        when tdc == 44 {
          hold tdi = tdi + 1
        } otherwise {
          hold tdfld = ""
          hold tdf = 1
          while tdf == 1 {
            when tdi >= tdn {
              hold tdf = 0
            } otherwise {
              hold tdc = sx_index(sdefs, tdi)
              when tdc == 44 || tdc == 59 {
                hold tdf = 0
              } otherwise {
                hold tdfld = concat(tdfld, chr(tdc))
                hold tdi = tdi + 1
              }
            }
          }
          hold tdclass = 0
          hold tdinn = ""
          hold tdkey = concat("|", tdname)
          hold tdkey = concat(tdkey, ".")
          hold tdkey = concat(tdkey, tdfld)
          hold tdkey = concat(tdkey, "=")
          hold tdk = len(tdkey)
          hold tdl = len(ftypes)
          hold tdhit = 0
          hold tdp = 0
          while tdp + tdk < tdl {
            hold tdeq = 1
            hold tdj = 0
            while tdj < tdk {
              hold tda = sx_index(ftypes, tdp + tdj)
              hold tdb = sx_index(tdkey, tdj)
              when tda == tdb {
                hold tdj = tdj + 1
              } otherwise {
                hold tdeq = 0
                hold tdj = tdk
              }
            }
            when tdeq == 1 {
              hold tdpk = sx_index(ftypes, tdp + tdk)
              when tdpk == 49 {
                hold tdclass = 1
              }
              when tdpk == 50 {
                // struct-typed field: the inner struct name follows
                hold tdclass = 2
                hold tdi2 = tdp + tdk + 2
                hold tdrun2 = 1
                while tdrun2 == 1 {
                  when tdi2 >= tdl {
                    hold tdrun2 = 0
                  } otherwise {
                    hold tdc2 = sx_index(ftypes, tdi2)
                    when tdc2 == 124 {
                      hold tdrun2 = 0
                    } otherwise {
                      hold tdinn = concat(tdinn, chr(tdc2))
                      hold tdi2 = tdi2 + 1
                    }
                  }
                }
              }
              hold tdp = tdl
            } otherwise {
              hold tdp = tdp + 1
            }
          }
          when tdclass == 2 {
            hold out = concat(out, " ")
            hold out = concat(out, tdinn)
            hold out = concat(out, " ")
          } otherwise {
            when tdclass == 1 {
              hold out = concat(out, " char *")
            } otherwise {
              hold out = concat(out, " double ")
            }
          }
          hold out = concat(out, tdfld)
          hold out = concat(out, ";")
        }
      }
    }
  }
  hold out = concat(out, " } ")
  hold out = concat(out, tdname)
  hold out = concat(out, ";")
  hold out = concat(out, nl)
}
when rt == 1 {
  hold out = concat(out, "int main(int argc,char**argv){\n  char sx_gcanchor=0; (void)sx_gcanchor; sx_gc_init(&sx_gcanchor);\n")
  hold out = concat(out, "  sx_argn=argc; sx_argv_p=argv;\n")
} otherwise {
  hold out = concat(out, "int main(void){\n  double sx_gcanchor=0; (void)sx_gcanchor; sx_gc_init(&sx_gcanchor);\n")
}
hold out = concat(out, obody)
hold out = concat(out, body)
hold out = concat(out, "  return 0;\n")
hold out = concat(out, "}\n")
// ---------------- module errors (clear, never silent) ----------------
when exmissing == 1 {
  hold exerr = concat("#error sayanox-min: cannot open use file: ", exmissp)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: cannot open use file: ", exmissp)
  show shmsg
}
when exdeep == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use nesting deeper than 8")
  hold exerr = concat(exerr, nl)
  show "min: use nesting deeper than 8"
}
when exbad == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct/list literal value must be a number, string, name, or nested struct")
  hold exerr = concat(exerr, nl)
  show "min: struct/list literal value must be a number, string, name, or nested struct"
}
when exbad5 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use must be followed by a quoted path, e.g. use \"lib.sa\"")
  hold exerr = concat(exerr, nl)
  show "min: use must be followed by a quoted path, e.g. use \"lib.sa\""
}
when exbad6 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct field is used with two different types (string vs number)")
  hold exerr = concat(exerr, nl)
  show "min: struct field used with two different types (string vs number)"
}
when exbad7 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal fields must be given in declaration order")
  hold exerr = concat(exerr, nl)
  show "min: struct literal fields must be given in declaration order"
}
when exbad8 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal must fill every field")
  hold exerr = concat(exerr, nl)
  show "min: struct literal must fill every field"
}
when nerrfwd == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct '")
  hold exerr = concat(exerr, nfwdout)
  hold exerr = concat(exerr, "' nests struct '")
  hold exerr = concat(exerr, nfwdin)
  hold exerr = concat(exerr, "' which is declared later; declare the nested struct first")
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: struct '", nfwdout)
  hold shmsg = concat(shmsg, "' nests struct '")
  hold shmsg = concat(shmsg, nfwdin)
  hold shmsg = concat(shmsg, "' declared later; declare the nested struct first")
  show shmsg
}
when nerrunk == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal for unknown struct '")
  hold exerr = concat(exerr, nunknm)
  hold exerr = concat(exerr, "'")
  hold exerr = concat(exerr, nl)
  hold shmsg = "min: struct literal for unknown struct '"
  hold shmsg = concat(shmsg, nunknm)
  hold shmsg = concat(shmsg, "'")
  show shmsg
}
when nerrchain == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, chainmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", chainmsg)
  show shmsg
}
when nerrscop == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, scopmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", scopmsg)
  show shmsg
}
when exbad4 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: a '}' ended up inside a give expression; put one statement per line")
  hold exerr = concat(exerr, nl)
  show "min: a '}' ended up inside a give expression; put one statement per line"
}
when perr == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, permsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", permsg)
  show shmsg
}
when exbad3 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: unsupported index expression (number or name only)")
  hold exerr = concat(exerr, nl)
  show "min: unsupported index expression (number or name only)"
}
// Rewrite every generated C integer token in user code to a double token.
// `fixfrom` is the end of the runtime preamble; that preamble intentionally
// keeps its integer constants, while function/main expressions become `N.0`.
// String literals are copied without inspection, and digits inside C names
// are left alone. Output is appended after at most 512 input bytes per chunk
// (plus any `.0` expansions), bounding the temporary builder and avoiding a
// full-prefix copy for every character. This keeps C's integer folding from
// diverging from Sayanox's IEEE-double arithmetic.
hold fixn = len(out)
hold fixi = 0
hold fixout = ""
while fixi < fixfrom {
  hold fixchunk = concat(fixchunk, chr(sx_index(out,fixi)))
  hold fixi = fixi + 1
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
hold fixquote = 0
hold fixes = 0
hold fixprev = 0
while fixi < fixn {
  hold fixc = sx_index(out,fixi)
  when fixquote == 1 {
    hold fixchunk = concat(fixchunk, chr(fixc))
    hold fixi = fixi + 1
    when fixes == 1 {
      hold fixes = 0
    } otherwise {
      when fixc == 92 {
        hold fixes = 1
      } otherwise {
        when fixc == 34 {
          hold fixquote = 0
        }
      }
    }
    hold fixprev = fixc
  } otherwise {
    when fixc == 34 {
      hold fixchunk = concat(fixchunk, chr(fixc))
      hold fixquote = 1
      hold fixprev = fixc
      hold fixi = fixi + 1
    } otherwise {
      when fixc >= 48 && fixc <= 57 {
        hold fixident = 0
        when (fixprev >= 48 && fixprev <= 57) || (fixprev >= 65 && fixprev <= 90) || (fixprev >= 97 && fixprev <= 122) || fixprev == 95 {
          hold fixident = 1
        }
        when fixident == 1 {
          hold fixchunk = concat(fixchunk, chr(fixc))
          hold fixprev = fixc
          hold fixi = fixi + 1
        } otherwise {
          hold fixnum = ""
          hold fixdot = 0
          hold fixrun = 1
          while fixrun == 1 {
            when fixi >= fixn {
              hold fixrun = 0
            } otherwise {
              hold fixd = sx_index(out,fixi)
              when fixd >= 48 && fixd <= 57 {
                hold fixnum = concat(fixnum, chr(fixd))
                hold fixprev = fixd
                hold fixi = fixi + 1
              } otherwise {
                when fixd == 46 {
                  hold fixnext = 0
                  when fixi + 1 < fixn {
                    hold fixnext = sx_index(out,fixi + 1)
                  }
                  when fixnext >= 48 && fixnext <= 57 {
                    hold fixnum = concat(fixnum, chr(fixd))
                    hold fixdot = 1
                    hold fixprev = fixd
                    hold fixi = fixi + 1
                  } otherwise {
                    hold fixrun = 0
                  }
                } otherwise {
                  hold fixrun = 0
                }
              }
            }
          }
          when fixdot == 0 {
            hold fixnum = concat(fixnum, ".0")
            hold fixprev = 48
          }
          hold fixchunk = concat(fixchunk, fixnum)
        }
      } otherwise {
        hold fixchunk = concat(fixchunk, chr(fixc))
        hold fixprev = fixc
        hold fixi = fixi + 1
      }
    }
  }
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
when fixi > fixflush {
  hold fixout = concat(fixout, fixchunk)
  hold fixchunk = ""
  hold fixflush = fixi
}
hold out = fixout
hold out = concat(exerr, out)
hold w = write_file(out_path, out)

// counters go to stdout (they are the compiler's own output, not the target's)
