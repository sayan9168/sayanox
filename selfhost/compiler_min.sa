              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sxsource_get(source_words,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          when fpk == 51 {
                            hold fprv = 3
                          } otherwise {
                            hold fprv = 0
                          }
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sxsource_get(source_words,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              // the identifier run below is only the simple case `xs[i]`;
              // opistart is where a numeric-expression retry restarts
              hold opistart = pos
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sxsource_get(source_words,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              hold opibad = 1
              when pos < n {
                hold cn = sxsource_get(source_words,pos)
                when cn == 93 {
                  hold pos = pos + 1
                  hold opibad = 0
                }
              }
              // `xs[i] + xs[i - 1]`: the operand after an operator is parsed
              // here, so this retry is what makes the SECOND index of a chain
              // an expression too (raw_index, same rules as a value position)
              when opibad == 1 {
                hold opix = raw_index(source, opistart, n)
                when len(opix) > 0 {
                  hold pos = opistart + len(opix) + 1
                  // the same lowering for the second index of a chain
                  hold opxl = idx_lower(opix, ldecls, sdecls, fsret, fspk)
                  when len(opxl) == 0 {
                    hold exbad3 = 1
                  } otherwise {
                    when len(opxl) != len(opix) {
                      hold rt = 1
                    }
                    hold opix = opxl
                  }
                } otherwise {
                  hold exbad3 = 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      when fsstructactive == 1 && fully_checked_value == 0 && sxfneedscheck(rhs, fsret, fspk, svars) == 1 && sxecontains(rhs, chr(123)) == 0 {
        hold sfenv = sxfenv(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold sfvalue = sxeparse(rhs, 0, sfenv, 0, 0, instate)
        hold sfkind = sxesegment(sfvalue, 1)
        when string_eq(sfkind, "e") || sxflowspace(rhs, sxepos(sfvalue)) != len(rhs) {
          hold perr = 1
          hold permsg = concat("struct expression: ", sxecode(sfvalue))
        } otherwise {
          when len(sfkind) > 1 && sx_index(sfkind, 0) == 117 {
            hold rk = 3
            hold stname = sxeslice(sfkind, 1, len(sfkind))
          }
        }
      }

      when len(value_compare_code) > 0 {
        rhs = value_compare_code
        rk = 1
        pos = value_compare_end
      }
      when perr == 0 && (rk == 0 || rk == 1) && sxseed_has_plus(rhs) {
        when inready == 0 {
          while sxecontains(source, inprivate) { inprivate = concat(inprivate, "x") }
          inready = 1
          fsret = concat(fsret, concat(inprivate, "list=l|"))
        }
        hold seed_show_serial = len(instate)
        hold seed_show_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold seed_show_value = sxeparse(rhs, 0, seed_show_env, 0, 0, instate)
        when (string_eq(sxesegment(seed_show_value, 1), "s") || string_eq(sxesegment(seed_show_value, 1), "n")) && sxflowspace(rhs, sxepos(seed_show_value)) == len(rhs) {
          rhs = sxecode(seed_show_value)
          fully_checked_value = 1
          fully_checked_kind = sxesegment(seed_show_value, 1)
          when sxecontains(rhs, "sx_cat(") { rt = 1 }
          while seed_show_serial < len(instate) {
            body = concat(body, concat("  double ", concat(inprivate, concat(sxedigits(seed_show_serial), concat(";", nl)))))
            seed_show_serial = seed_show_serial + 1
          }
        } otherwise {
          when seed_profile == 1 || string_eq(sxecode(seed_show_value), "numeric operator requires numeric operands") {
            perr = 1
            permsg = concat("show expression: ", sxecode(seed_show_value))
          }
        }
      }

      // emit
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when rk == 3 {
        hold nerrscop = 1
        hold scopmsg = "show value cannot be a struct"
      }
      when rk == 2 && nerrscop == 0 && seed_profile == 0 {
        // A list is a pointer-valued runtime object, not a number to cast for
        // printf.  Require an observable scalar operation such as len(xs) or
        // xs[i], which also keeps list-valued struct fields from reaching C as
        // an invalid pointer-to-double conversion.
        hold nerrscop = 1
        hold scopmsg = "show value cannot be a list; use len(xs) or xs[i]"
      }
      when rk == 2 && seed_profile == 1 {
        hold body = concat(body, "printf(\"[list len=%g]\\n\", sx_llen(")
        hold body = concat(body, rhs)
        hold body = concat(body, "));")
        hold body = concat(body, nl)
        hold rt = 1
      }
      when rk == 1 {
        hold body = concat(body, "puts(")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      when rk == 0 {
        hold body = concat(body, "printf(\"%g\\n\", (double)")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      hold shows = shows + 1
    }

    // ================= while/when condition =================
    // Preserve the pure-min expression grammar as valid C expression text.
    // This covers NAME OP NAME, NAME + NUMBER OP NUMBER, and && / || chains.
    when act == 3 {
      hold pos = pos + 1
      hold iswhile = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sxsource_get(source_words,pos)
      }

      when c1 == 104 {
        hold c2 = 0
        when pos + 1 < n {
          hold c2 = sxsource_get(source_words,pos + 1)
        }
        when c2 == 105 {
          hold iswhile = 1
        }
      }
      when iswhile == 1 {
        hold pos = pos + 4
      } otherwise {
        hold pos = pos + 3
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold cond = ""
      hold cr = 1
      hold condquote = 0
      hold condescape = 0
      while cr == 1 {
        when pos >= n {
          hold cr = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          // Only an unquoted brace opens the control body. Keep escaped
          // quotes/backslashes verbatim for the shared expression mapper.
          when condquote == 1 {
            hold cond = concat(cond, chr(cs))
            hold pos = pos + 1
            when condescape == 1 {
              hold condescape = 0
            } otherwise {
              when cs == 92 {
                hold condescape = 1
              } otherwise {
                when cs == 34 { hold condquote = 0 }
              }
            }
          } otherwise {
            when cs == 123 {
              hold cr = 0
            } otherwise {
              when cs == 47 && pos + 1 < n && sxsource_get(source_words,pos + 1) == 47 {
                // A comment is whitespace, including any braces/quotes in it.
                while pos < n && sxsource_get(source_words,pos) != 10 {
                  hold pos = pos + 1
                }
                hold cond = concat(cond, " ")
              } otherwise {
                when cs == 34 { hold condquote = 1 }
                hold cond = concat(cond, chr(cs))
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold cl = len(cond)
      hold trim = 1
      while trim == 1 {
        when cl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(cond, cl - 1)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold cl = cl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold ctrim = ""
      hold ci = 0
      while ci < cl {
        hold ctrim = concat(ctrim, chr(sx_index(cond,ci)))
        hold ci = ci + 1
      }
      hold checked_condition_source = ctrim
      // Field-list condition values must be proven numeric before reaching C.
      // In particular, lower a typed field index through sx_lget; a whole
      // list or any unproven list-field operator is a source-level refusal,
      // never C's pointer truthiness/arithmetic.  A decimal point is not a
      // field selector: only a dot followed by an identifier starts this pass.
      hold fcdot = 0
      hold fcdi = 0
      while fcdi + 1 < len(ctrim) && fcdot == 0 {
        hold fcdc = sx_index(ctrim, fcdi)
        when fcdc == 46 {
          hold fcdn = sx_index(ctrim, fcdi + 1)
          when (fcdn >= 65 && fcdn <= 90) || (fcdn >= 97 && fcdn <= 122) || fcdn == 95 {
            hold fcdot = 1
          }
        }
        hold fcdi = fcdi + 1
      }
      when fcdot == 1 {
        hold flenv = concat(decls, chr(1))
        hold flenv = concat(flenv, sdecls)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, ldecls)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, svars)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, fsret)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, fspk)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, inprivate)
        hold flenv = concat(flenv, chr(1))
        hold flenv = concat(flenv, ftypes)
        // Keep speculative condition parsing out of instate: an unrelated
        // inline list must never reserve a C temporary that this path does not
        // declare.  Such a mixed form is refused below instead.
        hold flstate = []
        hold flvalue = sxeparse(ctrim, 0, flenv, 0, 0, flstate)
        hold flkind = sxesegment(flvalue, 1)
        hold flend = sxflowspace(ctrim, sxepos(flvalue))
        // This is deliberately a *list-field* pass, not a replacement for
        // the mature general condition mapper.  Calls such as
        // string_eq(p.name, "x") are left to that mapper if sxeparse does not
        // know their source alias.  Identify list participation from the
        // typed result/lowered code, and use a primary-only retry for `p.xs +
        // 1`, whose full expression correctly reports a numeric-kind error.
        hold fcinline = len(flstate)
        hold fclist = 0
        when sx_eq(flkind, "l") == 1 {
          hold fclist = 1
        }
        when sxecontains(sxecode(flvalue), "sx_lget(") == 1 || sxecontains(sxecode(flvalue), "sx_llen(") == 1 {
          hold fclist = 1
        }
        when sx_eq(flkind, "e") == 1 {
          hold flstate = []
          hold flprimary = sxeparse(ctrim, 0, flenv, 7, 0, flstate)
          when sx_eq(sxesegment(flprimary, 1), "l") == 1 {
            hold fclist = 1
          }
        }
        when fclist == 1 {
          when fcinline > 0 || len(flstate) > 0 {
            hold perr = 1
            hold permsg = "field condition: an inline list in a list-field condition is not supported"
          } otherwise {
            when sx_eq(flkind, "l") == 1 {
              hold perr = 1
              hold permsg = "a list-valued struct field cannot be a condition; use len(p.xs) or p.xs[i]"
            } otherwise {
              when sx_eq(flkind, "e") == 1 {
                hold perr = 1
                hold permsg = concat("field condition: ", sxecode(flvalue))
              } otherwise {
                when flend >= len(ctrim) && sxecontains(ctrim, "[") == 1 {
                  hold ctrim = sxecode(flvalue)
                  hold cl = len(ctrim)
                }
              }
            }
          }
        }
      }
      // item 9: a string or list used as an operand of and/or/not (or as the
      // whole condition) is refused, as in the value-position check; a
      hold cwi = 0
      hold cwq = 0
      hold cwbad = 0
      hold cwc = 0
      hold cwj = 0
      hold cwrun = 0
      hold cwtok = ""
      hold cwd = 0
      hold cwkw = 0
      hold cwp = 0
      hold cwpok = 0
      hold cwpc = 0
      hold cwk = 0
      hold cwe = 0
      hold cwpw = ""
      hold cwn = 0
      hold cwnok = 0
      hold cwnc = 0
      hold cwm = 0
      hold cwnw = ""
      hold cwkey = ""
      hold cwhit = 0
      hold cwlist = 0
      hold cwsrc = ""
      hold cwi2 = 0
      hold cwa2 = 0
      hold cwb2 = 0
      hold cwok2 = 0
      hold cwj2 = 0
      while cwi < cl && cwbad == 0 {
        hold cwc = sx_index(ctrim, cwi)
        when cwq == 1 {
          when cwc == 34 {
            hold cwq = 0
          }
          hold cwi = cwi + 1
        } otherwise {
          when cwc == 34 {
            hold cwq = 1
            hold cwi = cwi + 1
          } otherwise {
            when (cwc >= 97 && cwc <= 122) || (cwc >= 65 && cwc <= 90) || cwc == 95 {
              hold cwj = cwi
              hold cwrun = 1
              hold cwtok = ""
              while cwrun == 1 {
                when cwj >= cl {
                  hold cwrun = 0
                } otherwise {
                  hold cwd = sx_index(ctrim, cwj)
                  when (cwd >= 97 && cwd <= 122) || (cwd >= 65 && cwd <= 90) || (cwd >= 48 && cwd <= 57) || cwd == 95 {
                    hold cwtok = concat(cwtok, chr(cwd))
                    hold cwj = cwj + 1
                  } otherwise {
                    hold cwrun = 0
                  }
                }
              }
              hold cwkw = 0
              when sx_eq(cwtok, "and") || sx_eq(cwtok, "or") || sx_eq(cwtok, "not") {
                hold cwkw = 1
              }
              // the significant character before the name: none, ( & | or a keyword
              hold cwp = cwi - 1
              while cwp >= 0 && sx_index(ctrim, cwp) == 32 {
                hold cwp = cwp - 1
              }
              hold cwpok = 0
              when cwp < 0 {
                hold cwpok = 1
              }
              when cwp >= 0 {
                hold cwpc = sx_index(ctrim, cwp)
                when cwpc == 38 || cwpc == 124 {
                  hold cwpok = 1
                }
                when cwpc == 40 {
                  // a ( that follows a name is a call's own paren: the name is an argument
                  hold cwpok = 1
                  when cwp >= 1 {
                    hold cwe = sx_index(ctrim, cwp - 1)
                    when (cwe >= 97 && cwe <= 122) || (cwe >= 65 && cwe <= 90) || (cwe >= 48 && cwe <= 57) || cwe == 95 {
                      hold cwpok = 0
                    }
                  }
                }
                when (cwpc >= 97 && cwpc <= 122) || (cwpc >= 65 && cwpc <= 90) || (cwpc >= 48 && cwpc <= 57) || cwpc == 95 {
                  hold cwk = cwp
                  hold cwrun = 1
                  hold cwpw = ""
                  while cwrun == 1 {
                    when cwk >= 0 {
                      hold cwe = sx_index(ctrim, cwk)
                      when (cwe >= 97 && cwe <= 122) || (cwe >= 65 && cwe <= 90) || (cwe >= 48 && cwe <= 57) || cwe == 95 {
                        hold cwpw = concat(chr(cwe), cwpw)
                        hold cwk = cwk - 1
                      } otherwise {
                        hold cwrun = 0
                      }
                    } otherwise {
                      hold cwrun = 0
                    }
                  }
                  when sx_eq(cwpw, "and") || sx_eq(cwpw, "or") || sx_eq(cwpw, "not") {
                    hold cwpok = 1
                  }
                }
              }
              // the significant character after the name: none, ) & | or a keyword
              hold cwn = cwj
              while cwn < cl && sx_index(ctrim, cwn) == 32 {
                hold cwn = cwn + 1
              }
              hold cwnok = 0
              when cwn >= cl {
                hold cwnok = 1
              }
              when cwn < cl {
                hold cwnc = sx_index(ctrim, cwn)
                when cwnc == 41 || cwnc == 38 || cwnc == 124 {
                  hold cwnok = 1
                }
                when (cwnc >= 97 && cwnc <= 122) || (cwnc >= 65 && cwnc <= 90) || cwnc == 95 {
                  hold cwm = cwn
                  hold cwrun = 1
                  hold cwnw = ""
                  while cwrun == 1 {
                    when cwm >= cl {
                      hold cwrun = 0
                    } otherwise {
                      hold cwe = sx_index(ctrim, cwm)
                      when (cwe >= 97 && cwe <= 122) || (cwe >= 65 && cwe <= 90) || (cwe >= 48 && cwe <= 57) || cwe == 95 {
                        hold cwnw = concat(cwnw, chr(cwe))
                        hold cwm = cwm + 1
                      } otherwise {
                        hold cwrun = 0
                      }
                    }
                  }
                  when sx_eq(cwnw, "and") || sx_eq(cwnw, "or") || sx_eq(cwnw, "not") {
                    hold cwnok = 1
                  }
                }
              }
              // a string or list name in such an operand position is refused
              when cwkw == 0 && cwpok == 1 && cwnok == 1 {
                hold cwkey = concat("|", cwtok)
                hold cwkey = concat(cwkey, "|")
                hold cwhit = 0
                hold cwlist = 0
                while cwlist < 2 {
                  when cwlist == 0 {
                    hold cwsrc = sdecls
                  } otherwise {
                    hold cwsrc = ldecls
                  }
                  hold cwi2 = 0
                  hold cwa2 = len(cwsrc)
                  hold cwb2 = len(cwkey)
                  while cwi2 + cwb2 <= cwa2 {
                    hold cwok2 = 1
                    hold cwj2 = 0
                    while cwj2 < cwb2 {
                      when sx_index(cwsrc, cwi2 + cwj2) == sx_index(cwkey, cwj2) {
                        hold cwj2 = cwj2 + 1
                      } otherwise {
                        hold cwok2 = 0
                        hold cwj2 = cwb2
                      }
                    }
                    when cwok2 == 1 {
                      hold cwhit = 1
                      hold cwi2 = cwa2
                    } otherwise {
                      hold cwi2 = cwi2 + 1
                    }
                  }
                  hold cwlist = cwlist + 1
                }
                when cwhit == 1 {
                  hold cwbad = 1
                  when perr == 0 {
                    hold permsg = concat("'", cwtok)
                    hold permsg = concat(permsg, "' is a string, list or struct; a condition must be numeric")
                  }
                  hold perr = 1
                }
              }
              hold cwi = cwj
            } otherwise {
              hold cwi = cwi + 1
            }
          }
        }
      }

    }

    // ================= give EXPR =================
    when act == 6 {
      hold list_return_start = pos
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold gexpr = ""
      hold gr = 1
      while gr == 1 {
        when pos >= n {
          hold gr = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 10 || cs == 13 {
            hold gr = 0
          } otherwise {
            when cs == 34 {
              hold gexpr = concat(gexpr, chr(cs))
              hold pos = pos + 1
              hold gquoted = 1
              while pos < n && gquoted == 1 {
                hold gqc = sxsource_get(source_words, pos)
                hold gexpr = concat(gexpr, chr(gqc))
                hold pos = pos + 1
                when gqc == 92 && pos < n {
                  hold gexpr = concat(gexpr, chr(sxsource_get(source_words, pos)))
                  hold pos = pos + 1
                } otherwise {
                  when gqc == 34 {
                    hold gquoted = 0
                  }
                }
              }
            } otherwise {
            when cs == 47 {
              hold c2 = 0
              when pos + 1 < n {
                hold c2 = sxsource_get(source_words, pos + 1)
              }
              when c2 == 47 {
                hold gr = 0
              } otherwise {
                hold gexpr = concat(gexpr, chr(cs))
                hold pos = pos + 1
              }
            } otherwise {
              // `}` on a give line means the block brace was swallowed:
              // statements are newline-terminated in pure-min
              when cs == 125 {
                hold exbad4 = 1
              }
              hold gexpr = concat(gexpr, chr(cs))
              hold pos = pos + 1
            }
            }
          }
        }
      }
      hold gl = len(gexpr)
      hold trim = 1
      while trim == 1 {
        when gl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(gexpr, gl - 1)
          when cs == 32 || cs == 9 {
            hold gl = gl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold gtrim = ""
      hold gi = 0
      while gi < gl {
        hold gtrim = concat(gtrim, chr(sx_index(gexpr, gi)))
        hold gi = gi + 1
      }
      when seed_profile == 1 && in_fn == 1 {
        hold seed_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold seed_return = sxeparse(gtrim, 0, seed_env, 0, 0, instate)
        hold seed_kind = sxesegment(seed_return, 1)
        when string_eq(seed_kind, "n") || string_eq(seed_kind, "s") || string_eq(seed_kind, "l") {
          when sx_index(seed_kind, 0) != fn_retkind {
            perr = 1
            permsg = "function give type mismatch"
          }
        }
      }
      // A complete list literal return reuses the checked hold-expression
      // parser. Insert the temporary at the return itself, never outside its
      // branch/loop: element evaluation and early-return timing stay intact.
      hold list_return_literal = 0
      when gl > 0 {
        when sx_index(gtrim, 0) == 91 {
          hold list_return_literal = 1
        }
      }
      when list_return_literal == 1 {
        hold lrdepth = 0
        hold lrquote = 0
        hold lrescape = 0
        hold lrend = 0 - 1
        hold lri = 0
        while lri < gl && lrend < 0 {
          hold lrc = sx_index(gtrim, lri)
          when lrquote == 1 {
            when lrescape == 1 {
              hold lrescape = 0
            } otherwise {
              when lrc == 92 {
                hold lrescape = 1
              } otherwise {
                when lrc == 34 {
                  hold lrquote = 0
                }
              }
            }
          } otherwise {
            when lrc == 34 {
              hold lrquote = 1
            } otherwise {
              when lrc == 91 {
                hold lrdepth = lrdepth + 1
              }
              when lrc == 93 {
                hold lrdepth = lrdepth - 1
                when lrdepth == 0 {
                  hold lrend = lri
                }
              }
            }
          }
          hold lri = lri + 1
        }
        when lrend != gl - 1 || in_fn == 0 || fn_retkind != 108 {
          hold perr = 1
          hold permsg = "a direct list return needs one complete list literal and a -> list function"
        } otherwise {
          // Pick a name absent from the entire source, including existing
          // generated temporaries. No user namespace needs to be reserved.
          hold lrname = "__sx_return_list"
          hold lrunique = 0
          while lrunique == 0 {
            hold lrunique = 1
            hold lrj = 0
            hold lrnl = len(lrname)
            while lrj + lrnl <= n && lrunique == 1 {
              hold lrok = 1
              hold lrk = 0
              while lrk < lrnl && lrok == 1 {
                when sxsource_get(source_words, lrj + lrk) != sx_index(lrname, lrk) {
                  hold lrok = 0
                }
                hold lrk = lrk + 1
              }
              when lrok == 1 {
                hold lrunique = 0
              }
              hold lrj = lrj + 1
            }
            when lrunique == 0 {
              hold lrname = concat(lrname, "x")
            }
          }
          hold lrsource = sxseed_slice(source, 0, list_return_start)
          hold lrsource = concat(lrsource, "hold ")
          hold lrsource = concat(lrsource, lrname)
          hold lrsource = concat(lrsource, " = ")
          hold lrsource = concat(lrsource, gtrim)
          hold lrsource = concat(lrsource, nl)
          hold lrsource = concat(lrsource, "give ")
          hold lrsource = concat(lrsource, lrname)
          hold lrsource = concat(lrsource, nl)
          hold lrsource = concat(lrsource, sxseed_slice(source, pos, n))
          hold source = lrsource
          hold source_words = sxsource_pack(source)
          hold n = len(source)
          hold pos = list_return_start
          hold act = 16 // internal retry: do not emit give or consume the inserted hold
        }
      }
      hold ctrim = gtrim
      hold cl = gl
      // a list index in a give expression (`give xs[i]`): the postfix [index]
      // rewrite lives in the hold/show operand parser and never sees a give
      hold lxo = ""
      hold lxi = 0
      while lxi < cl {
        hold lxc = sx_index(ctrim, lxi)
        when lxc == 34 {
          hold lxo = concat(lxo, chr(34))
          hold lxi = lxi + 1
          hold lxq = 1
          while lxq == 1 && lxi < cl {
            hold lxsd = sx_index(ctrim, lxi)
            hold lxo = concat(lxo, chr(lxsd))
            hold lxi = lxi + 1
            when lxsd == 92 && lxi < cl {
              hold lxo = concat(lxo, chr(sx_index(ctrim, lxi)))
              hold lxi = lxi + 1
            } otherwise {
              when lxsd == 34 {
                hold lxq = 0
              }
            }
          }
        } otherwise {
          when (lxc >= 97 && lxc <= 122) || (lxc >= 65 && lxc <= 90) || lxc == 95 {
            hold lxe = lxi
            hold lxr = 1
            while lxr == 1 && lxe < cl {
              hold lxid = sx_index(ctrim, lxe)
              when (lxid >= 97 && lxid <= 122) || (lxid >= 65 && lxid <= 90) || lxid == 95 || (lxid >= 48 && lxid <= 57) {
                hold lxe = lxe + 1
              } otherwise {
                hold lxr = 0
              }
            }
            hold lxw = ""
            hold lxk = lxi
            while lxk < lxe {
              hold lxw = concat(lxw, chr(sx_index(ctrim, lxk)))
              hold lxk = lxk + 1
            }
            hold lxb = 0
            when lxe < cl && sx_index(ctrim, lxe) == 91 {
              hold lxp = concat("|", lxw)
              hold lxp = concat(lxp, "|")
              hold lxpn = len(lxp)
              hold lxdn = len(ldecls)
              hold lxd0 = 0
              while lxd0 + lxpn <= lxdn {
                hold lxok = 1
                hold lxj = 0
                while lxj < lxpn {
                  when sx_index(ldecls, lxd0 + lxj) == sx_index(lxp, lxj) {
                    hold lxj = lxj + 1
                  } otherwise {
                    hold lxok = 0
                    hold lxj = lxpn
                  }
                }
                when lxok == 1 {
                  hold lxb = 1
                  hold lxd0 = lxdn
                } otherwise {
                  hold lxd0 = lxd0 + 1
                }
              }
            }
            when lxb == 1 {
              // find the closing ] (no nested [ inside the index)
              hold lxq2 = lxe + 1
              hold lxf = 0 - 1
              hold lxnest = 0
              while lxq2 < cl && lxf < 0 {
                hold lxcd = sx_index(ctrim, lxq2)
                when lxcd == 91 {
                  hold lxnest = 1
                }
                when lxcd == 93 {
                  hold lxf = lxq2
                }
                hold lxq2 = lxq2 + 1
              }
              when lxf >= 0 && lxnest == 0 {
                hold lxo = concat(lxo, "sx_lget(")
                hold lxo = concat(lxo, lxw)
                hold lxo = concat(lxo, ",")
                hold lxk2 = lxe + 1
                while lxk2 < lxf {
                  hold lxo = concat(lxo, chr(sx_index(ctrim, lxk2)))
                  hold lxk2 = lxk2 + 1
                }
                hold lxo = concat(lxo, ")")
                hold lxi = lxf + 1
              } otherwise {
                hold lxo = concat(lxo, lxw)
                hold lxi = lxe
              }
            } otherwise {
              hold lxo = concat(lxo, lxw)
              hold lxi = lxe
            }
          } otherwise {
            hold lxo = concat(lxo, chr(lxc))
            hold lxi = lxi + 1
          }
        }
      }
      hold ctrim = lxo
      hold cl = len(ctrim)
    }

    // ---- shared rewrite: conditions (act 3), give (act 6) and
    //      parenthesized hold/show expressions (act 8) are verbatim C in
    when act == 3 || act == 6 || act == 8 {
      when act == 6 || act == 8 { checked_condition_source = ctrim }
      // ---- string == != < <= > >= ----
      // In C, `a == b` and `a < b` on two char* compare addresses, so two
      hold seo = ""
      hold seoi = 0
      hold seoc = 0
      hold seoq = 0
      hold seop = 0
      hold seolen = 1
      hold seonx = 0
      hold seoneg = 0
      hold seoj = 0
      hold seoe = 0
      hold seoin = 0
      hold seoc2 = 0
      hold seoc3 = 0
      hold seol = ""
      hold ser = ""
      hold seoquo = 0
      hold seorj = 0
      hold seols = 0
      hold seors = 0
      hold seolk = ""
      hold seork = ""
      hold seoli = 0
      hold seomt = 0
      hold seoj2 = 0
      hold seonew = ""
      hold seoq3 = 0
      hold seopc = 0
      hold seopt = ""
      hold seolq = 0
      while seoi < cl {
        hold seoc = sx_index(ctrim, seoi)
        when seoc == 34 {
          // string literal: copy verbatim, escapes kept
          hold seo = concat(seo, chr(34))
          hold seoi = seoi + 1
          hold seoq = 1
          while seoq == 1 && seoi < cl {
            hold seoc = sx_index(ctrim, seoi)
            hold seo = concat(seo, chr(seoc))
            hold seoi = seoi + 1
            when seoc == 92 && seoi < cl {
              hold seo = concat(seo, chr(sx_index(ctrim, seoi)))
              hold seoi = seoi + 1
            } otherwise {
              when seoc == 34 {
                hold seoq = 0
              }
            }
          }
        } otherwise {
          hold seonx = 0
          when seoi + 1 < cl {
            hold seonx = sx_index(ctrim, seoi + 1)
          }
          hold seop = 0
          hold seolen = 1
          hold seopt = ""
          when seoc == 61 && seonx == 61 {
            hold seop = 1
            hold seolen = 2
            hold seopt = "=="
          }
          when seoc == 33 && seonx == 61 {
            hold seop = 2
            hold seolen = 2
            hold seopt = "!="
          }
          when seoc == 60 && seonx == 61 {
            hold seop = 3
            hold seolen = 2
            hold seopt = "<="
          }
          when seoc == 62 && seonx == 61 {
            hold seop = 4
            hold seolen = 2
            hold seopt = ">="
          }
          when seoc == 60 && seonx != 61 {
            hold seop = 5
            hold seolen = 1
            hold seopt = "<"
          }
          when seoc == 62 && seonx != 61 {
            hold seop = 6
            hold seolen = 1
            hold seopt = ">"
          }
          // a == that is part of <= >= or != is not an equality test
          when seop == 1 && seoi > 0 {
            hold seopc = sx_index(ctrim, seoi - 1)
            when seopc == 60 || seopc == 62 || seopc == 61 || seopc == 33 {
              hold seop = 0
            }
          }
          when seop == 0 {
            hold seo = concat(seo, chr(seoc))
            hold seoi = seoi + 1
          } otherwise {
            // left operand: the identifier just before the operator
            hold seoe = len(seo)
            hold seoj = seoe
            while seoj > 0 && sx_index(seo, seoj - 1) == 32 {
              hold seoj = seoj - 1
            }
            hold seoe = seoj
            hold seolq = 0
            // a quoted literal on the left: back to its opening quote
            when seoj > 0 && sx_index(seo, seoj - 1) == 34 {
              hold seolq = 1
              hold seoj = seoj - 1
              hold seoin = 1
              while seoin == 1 {
                hold seoin = 0
                when seoj > 0 {
                  hold seoc2 = sx_index(seo, seoj - 1)
                  hold seoj = seoj - 1
                  when seoc2 == 34 {
                    when seoj > 0 && sx_index(seo, seoj - 1) == 92 {
                      hold seoin = 1
                    }
                  } otherwise {
                    hold seoin = 1
                  }
                }
              }
            }
            // an identifier on the left
            when seolq == 0 {
              hold seoin = 1
            }
            while seoin == 1 {
              hold seoin = 0
              when seoj > 0 {
                hold seoc2 = sx_index(seo, seoj - 1)
                when (seoc2 >= 97 && seoc2 <= 122) || (seoc2 >= 65 && seoc2 <= 90) || (seoc2 >= 48 && seoc2 <= 57) || seoc2 == 95 {
                  hold seoj = seoj - 1
                  hold seoin = 1
                }
              }
            }
            hold seol = ""
            hold seoq3 = seoj
            while seoq3 < seoe {
              hold seol = concat(seol, chr(sx_index(seo, seoq3)))
              hold seoq3 = seoq3 + 1
            }
            // right operand: a quoted literal or an identifier
            hold seorj = seoi + seolen
            while seorj < cl && sx_index(ctrim, seorj) == 32 {
              hold seorj = seorj + 1
            }
            hold ser = ""
            hold seoquo = 0
            when seorj < cl && sx_index(ctrim, seorj) == 34 {
              hold seoquo = 1
              hold ser = chr(34)
              hold seorj = seorj + 1
              hold seoq = 1
              while seoq == 1 && seorj < cl {
                hold seoc3 = sx_index(ctrim, seorj)
                hold ser = concat(ser, chr(seoc3))
                hold seorj = seorj + 1
                when seoc3 == 92 && seorj < cl {
                  hold ser = concat(ser, chr(sx_index(ctrim, seorj)))
                  hold seorj = seorj + 1
                } otherwise {
                  when seoc3 == 34 {
                    hold seoq = 0
                  }
                }
              }
            } otherwise {
              hold seoin = 1
              while seoin == 1 {
                hold seoin = 0
                when seorj < cl {
                  hold seoc2 = sx_index(ctrim, seorj)
                  when (seoc2 >= 97 && seoc2 <= 122) || (seoc2 >= 65 && seoc2 <= 90) || (seoc2 >= 48 && seoc2 <= 57) || seoc2 == 95 {
                    hold ser = concat(ser, chr(seoc2))
                    hold seorj = seorj + 1
                    hold seoin = 1
                  }
                }
              }
            }
            // both sides must be strings: the left is declared, the right is
            // a quoted literal or a declared string
            hold seols = 0
            hold seors = 0
            when seolq == 1 {
              hold seols = 1
            }
            when seolq == 0 && len(seol) > 0 {
              hold seolk = concat(concat("|", seol), "|")
              hold seoli = 0
              while seoli + len(seolk) <= len(sdecls) {
                hold seomt = 1
                hold seoj2 = 0
                while seoj2 < len(seolk) {
                  when sx_index(sdecls, seoli + seoj2) == sx_index(seolk, seoj2) {
                    hold seoj2 = seoj2 + 1
                  } otherwise {
                    hold seomt = 0
                    hold seoj2 = len(seolk)
                  }
                }
                when seomt == 1 {
                  hold seols = 1
                  hold seoli = len(sdecls)
                } otherwise {
                  hold seoli = seoli + 1
                }
              }
            }
            when seoquo == 0 && len(ser) > 0 {
              hold seork = concat(concat("|", ser), "|")
              hold seoli = 0
              while seoli + len(seork) <= len(sdecls) {
                hold seomt = 1
                hold seoj2 = 0
                while seoj2 < len(seork) {
                  when sx_index(sdecls, seoli + seoj2) == sx_index(seork, seoj2) {
                    hold seoj2 = seoj2 + 1
                  } otherwise {
                    hold seomt = 0
                    hold seoj2 = len(seork)
                  }
                }
                when seomt == 1 {
                  hold seors = 1
                  hold seoli = len(sdecls)
                } otherwise {
                  hold seoli = seoli + 1
                }
              }
            }
            when seols == 1 && (seoquo == 1 || seors == 1) {
              // rebuild the output without the left operand, then the strcmp
              hold seonew = ""
              hold seoq3 = 0
              while seoq3 < seoj {
                hold seonew = concat(seonew, chr(sx_index(seo, seoq3)))
                hold seoq3 = seoq3 + 1
              }
              hold seo = concat(seonew, "sx_eq(")
              when seop >= 3 {
                hold seo = concat(seonew, "sx_cmp(")
              }
              hold seo = concat(seo, seol)
              hold seo = concat(seo, ", ")
              hold seo = concat(seo, ser)
              hold seo = concat(seo, ")")
              when seop == 1 {
                hold seo = concat(seo, " == 1.0")
              }
              when seop == 2 {
                hold seo = concat(seo, " == 0.0")
              }
              when seop >= 3 {
                hold seo = concat(seo, " ")
                hold seo = concat(seo, seopt)
                hold seo = concat(seo, " 0.0")
              }
              hold seoi = seorj
            } otherwise {
              hold seo = concat(seo, chr(seoc))
              when seolen == 2 {
                hold seo = concat(seo, chr(seonx))
              }
              hold seoi = seoi + seolen
            }
          }
        }
      }
      hold ctrim = seo
      // ---- parenthesise the operand of `not` ------------------------
      // In Sayanox `not` binds looser than a comparison, so `not a == 2`
      hold npin = ctrim
      hold npout = ""
      hold npi = 0
      hold npl = len(npin)
      hold npq = 0
      // declared here, not in the innermost block that first needs them:
      // Sayanox scopes a `hold` to the block it first appears in.
      hold npc2 = 0
      hold nprun = 0
      while npi < npl {
        hold npc = sx_index(npin, npi)
        when npq == 1 {
          hold npout = concat(npout, chr(npc))
          when npc == 92 {
            when npi + 1 < npl {
              hold npout = concat(npout, chr(sx_index(npin, npi + 1)))
              hold npi = npi + 1
            }
          } otherwise {
            when npc == 34 {
              hold npq = 0
            }
          }
          hold npi = npi + 1
        } otherwise {
          when npc == 34 {
            hold npq = 1
            hold npout = concat(npout, chr(npc))
            hold npi = npi + 1
          } otherwise {
            when (npc >= 97 && npc <= 122) || (npc >= 65 && npc <= 90) || npc == 95 {
              // read the whole word
              hold npw = ""
              hold npj = npi
              hold nprun = 1
              while nprun == 1 {
                when npj >= npl {
                  hold nprun = 0
                } otherwise {
                  hold npc2 = sx_index(npin, npj)
                  when (npc2 >= 97 && npc2 <= 122) || (npc2 >= 65 && npc2 <= 90) || (npc2 >= 48 && npc2 <= 57) || npc2 == 95 {
                    hold npw = concat(npw, chr(npc2))
                    hold npj = npj + 1
                  } otherwise {
                    hold nprun = 0
                  }
                }
              }
              hold npout = concat(npout, npw)
              hold npi = npj
              when sx_eq(npw, "not") {
                // blanks after the keyword
                hold nprun = 1
                while nprun == 1 {
                  when npi >= npl {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npi)
                    when npc2 == 32 || npc2 == 9 || npc2 == 13 {
                      hold npi = npi + 1
                    } otherwise {
                      hold nprun = 0
                    }
                  }
                }
                hold nps = npi
                // the end of the operand: the next top-level `and` / `or`
                hold npd = 0
                hold npq2 = 0
                hold npe = npl
                hold npi2 = nps
                hold nprun = 1
                while nprun == 1 {
                  when npi2 >= npl {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npi2)
                    when npq2 == 1 {
                      when npc2 == 92 {
                        hold npi2 = npi2 + 1
                      } otherwise {
                        when npc2 == 34 {
                          hold npq2 = 0
                        }
                      }
                      hold npi2 = npi2 + 1
                    } otherwise {
                      when npc2 == 34 {
                        hold npq2 = 1
                        hold npi2 = npi2 + 1
                      } otherwise {
                        when npc2 == 40 {
                          hold npd = npd + 1
                          hold npi2 = npi2 + 1
                        } otherwise {
                          when npc2 == 41 {
                            hold npd = npd - 1
                            hold npi2 = npi2 + 1
                          } otherwise {
                            when (npc2 >= 97 && npc2 <= 122) || (npc2 >= 65 && npc2 <= 90) || npc2 == 95 {
                              hold npw2 = ""
                              hold npj2 = npi2
                              hold nprun2 = 1
                              while nprun2 == 1 {
                                when npj2 >= npl {
                                  hold nprun2 = 0
                                } otherwise {
                                  hold npc3 = sx_index(npin, npj2)
                                  when (npc3 >= 97 && npc3 <= 122) || (npc3 >= 65 && npc3 <= 90) || (npc3 >= 48 && npc3 <= 57) || npc3 == 95 {
                                    hold npw2 = concat(npw2, chr(npc3))
                                    hold npj2 = npj2 + 1
                                  } otherwise {
                                    hold nprun2 = 0
                                  }
                                }
                              }
                              when npd == 0 && (sx_eq(npw2, "and") || sx_eq(npw2, "or")) {
                                hold npe = npi2
                                hold nprun = 0
                              } otherwise {
                                hold npi2 = npj2
                              }
                            } otherwise {
                              hold npi2 = npi2 + 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
                // drop trailing blanks and wrap, when there is an operand
                hold nprun = 1
                while nprun == 1 {
                  when npe <= nps {
                    hold nprun = 0
                  } otherwise {
                    hold npc2 = sx_index(npin, npe - 1)
                    when npc2 == 32 || npc2 == 9 || npc2 == 13 {
                      hold npe = npe - 1
                    } otherwise {
                      hold nprun = 0
                    }
                  }
                }
                when npe > nps {
                  hold npout = concat(npout, "(")
                  hold npk = nps
                  while npk < npe {
                    hold npout = concat(npout, chr(sx_index(npin, npk)))
                    hold npk = npk + 1
                  }
                  hold npout = concat(npout, ")")
                  hold npi = npe
                }
              }
            } otherwise {
              hold npout = concat(npout, chr(npc))
              hold npi = npi + 1
            }
          }
        }
      }
      hold ctrim = npout
      hold cl = len(ctrim)
      // ---- rewrite '%' to the checked helper ----
      // C precedence already matches pure-min for + - * / and the
      hold crepl = ""
      hold cwi = 0
      hold cwbracket = 0
      while cwi < cl {
        hold ccx = sx_index(ctrim, cwi)
        when ccx == 34 {
          // string literal: copy verbatim, escapes kept
          hold crepl = concat(crepl, chr(ccx))
          hold cwi = cwi + 1
          hold cwrun = 1
          while cwrun == 1 {
            when cwi >= cl {
              hold cwrun = 0
            } otherwise {
              hold ccx = sx_index(ctrim, cwi)
              hold crepl = concat(crepl, chr(ccx))
              hold cwi = cwi + 1
              when ccx == 92 {
                when cwi < cl {
                  hold crepl = concat(crepl, chr(sx_index(ctrim, cwi)))
                  hold cwi = cwi + 1
                }
              } otherwise {
                when ccx == 34 {
                  hold cwrun = 0
                }
              }
            }
          }
        } otherwise {
          when ccx == 91 {
            hold cwbracket = cwbracket + 1
          }
          when ccx == 93 {
            hold cwbracket = cwbracket - 1
          }
          when (ccx == 37 || ccx == 43) && cwbracket == 0 {
            // '%' and '+' both need their operands: the scans below clobber
            // ccx, so the operator is kept here
            hold cwop = ccx
            // ---- left operand: scan back over the mul-level chain ----
            hold cwal = len(crepl)
            hold cwrun = 1
            while cwrun == 1 {
              hold cwrun = 0
              when cwal > 0 {
                hold ccx = sx_index(crepl, cwal - 1)
                when ccx == 41 || ccx == 93 {
                  // skip a balanced (..) / [..] group, then keep going
                  hold cwbd = 1
                  hold cwal = cwal - 1
                  while cwbd > 0 {
                    when cwal <= 0 {
                      hold cwbd = 0
                    } otherwise {
                      hold ccx = sx_index(crepl, cwal - 1)
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwal = cwal - 1
                    }
                  }
                  hold cwrun = 1
                } otherwise {
                  when ccx == 34 {
                    // a quoted literal: cwal sits just after its CLOSING
                    // quote, so step over that one and then walk back to the
                    hold cwal = cwal - 1
                    hold cwqb = 1
                    while cwqb == 1 {
                      when cwal <= 0 {
                        hold cwqb = 0
                      } otherwise {
                        hold cwqc = sx_index(crepl, cwal - 1)
                        hold cwal = cwal - 1
                        when cwqc == 34 {
                          // an escaped quote does not open the literal: an odd
                          // run of backslashes before it means it is escaped
                          hold cwesc = 0
                          hold cwbk = cwal
                          hold cwbb = 1
                          while cwbb == 1 {
                            when cwbk > 0 {
                              when sx_index(crepl, cwbk - 1) == 92 {
                                hold cwbk = cwbk - 1
                                when cwesc == 0 {
                                  hold cwesc = 1
                                } otherwise {
                                  hold cwesc = 0
                                }
                              } otherwise {
                                hold cwbb = 0
                              }
                            } otherwise {
                              hold cwbb = 0
                            }
                          }
                          when cwesc == 0 {
                            hold cwqb = 0
                          }
                        }
                      }
                    }
                    hold cwrun = 1
                  } otherwise {
                    when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 || ccx == 42 || ccx == 47 || ccx == 32 || ccx == 9 {
                      hold cwal = cwal - 1
                      hold cwrun = 1
                    }
                  }
                }
              }
            }
            // ---- right operand: the next atom (with .field / [i] / (..)) ----
            hold cwri = cwi + 1
            hold cwnb = 1
            while cwnb == 1 {
              when cwri >= cl {
                hold cwnb = 0
              } otherwise {
                hold ccx = sx_index(ctrim, cwri)
                when ccx == 32 || ccx == 9 {
                  hold cwri = cwri + 1
                } otherwise {
                  hold cwnb = 0
                }
              }
            }
            hold cwre = cwri
            when cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when ccx == 45 || ccx == 43 {
                hold cwre = cwre + 1
              }
            }
            // a quoted literal is a whole operand: `name + "tail"`
            hold cwq3 = 0
            when cwre < cl {
              when sx_index(ctrim, cwre) == 34 {
                hold cwq3 = 1
                hold cwre = cwre + 1
                hold cwr2 = 1
                while cwr2 == 1 {
                  when cwre >= cl {
                    hold cwr2 = 0
                  } otherwise {
                    hold cwqd = sx_index(ctrim, cwre)
                    hold cwre = cwre + 1
                    when cwqd == 92 {
                      when cwre < cl {
                        hold cwre = cwre + 1
                      }
                    }
                    when cwqd == 34 {
                      hold cwr2 = 0
                    }
                  }
                }
              }
            }
            when cwq3 == 0 && cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                hold cwnb = 1
                while cwnb == 1 {
                  when cwre >= cl {
                    hold cwnb = 0
                  } otherwise {
                    hold ccx = sx_index(ctrim, cwre)
                    when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                      hold cwre = cwre + 1
                    } otherwise {
                      hold cwnb = 0
                    }
                  }
                }
              }
            }
            // postfix groups and .field, repeated (never after a literal)
            hold cwnb = 1
            when cwq3 == 1 {
              hold cwnb = 0
            }
            while cwnb == 1 {
              hold cwnb = 0
              when cwre < cl {
                hold ccx = sx_index(ctrim, cwre)
                when ccx == 40 || ccx == 91 {
                  hold cwbd = 0
                  hold cwrun = 1
                  while cwrun == 1 {
                    when cwre >= cl {
                      hold cwrun = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwre)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwre = cwre + 1
                      when cwbd <= 0 {
                        hold cwrun = 0
                      }
                    }
                  }
                  hold cwnb = 1
                } otherwise {
                  when ccx == 46 {
                    hold cwre = cwre + 1
                    hold cwrun = 1
                    while cwrun == 1 {
                      when cwre >= cl {
                        hold cwrun = 0
                      } otherwise {
                        hold ccx = sx_index(ctrim, cwre)
                        when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                          hold cwre = cwre + 1
                        } otherwise {
                          hold cwrun = 0
                        }
                      }
                    }
                    hold cwnb = 1
                  }
                }
              }
            }
            // ---- L, R, and cut crepl back to the start of L ----
            hold cwl = ""
            hold cwn = len(crepl)
            hold cwj = cwal
            while cwj < cwn {
              hold cwl = concat(cwl, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            hold cwr = ""
            hold cwj = cwri
            while cwj < cwre {
              hold cwr = concat(cwr, chr(sx_index(ctrim, cwj)))
              hold cwj = cwj + 1
            }
            hold cwnew = ""
            hold cwj = 0
            while cwj < cwal {
              hold cwnew = concat(cwnew, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            when cwop == 37 {
              when str_operand(cwl, sdecls) == 1 || str_operand(cwr, sdecls) == 1 {
                when perr == 0 {
                  hold permsg = "'%' truncates two numbers; one of its operands is a string"
                }
                hold perr = 1
              }
              hold cwnew = concat(cwnew, "sx_mod((double)(")
              hold cwnew = concat(cwnew, cwl)
              hold cwnew = concat(cwnew, "),(double)(")
              hold cwnew = concat(cwnew, cwr)
              hold cwnew = concat(cwnew, "))")
              hold crepl = cwnew
              hold cwi = cwre
            }
            when cwop == 43 {
              // '+' joins two strings through sx_cat and adds two numbers
              // with C's own '+', which is what the value-position parser
              hold cwls = str_operand(cwl, sdecls)
              hold cwrs = str_operand(cwr, sdecls)
              when cwls == 1 && cwrs == 1 {
                hold cwnew = concat(cwnew, "sx_cat(")
                hold cwnew = concat(cwnew, cwl)
                hold cwnew = concat(cwnew, ", ")
                hold cwnew = concat(cwnew, cwr)
                hold cwnew = concat(cwnew, ")")
                hold crepl = cwnew
                hold rt = 1
                hold cwi = cwre
              }
              when cwls + cwrs == 1 {
                when perr == 0 {
                  hold cwmix = cwr
                  when cwrs == 1 {
                    hold cwmix = cwl
                  }
                  hold permsg = concat("+ joins two strings or adds two numbers; the other side of '", cwmix)
                  hold permsg = concat(permsg, "' is not a string (bind it with hold first)")
                }
                hold perr = 1
                hold crepl = concat(crepl, chr(cwop))
                hold cwi = cwi + 1
              }
              when cwls == 0 && cwrs == 0 {
                hold crepl = concat(crepl, chr(cwop))
                hold cwi = cwi + 1
              }
            }
          } otherwise {
            when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || ccx == 95 {
              // ---- an identifier: lower a builtin call to its runtime
              //      helper, so a `give`, a condition or a parenthesized
              //      expression may call concat/len/chr/... directly ----
              hold cwid = ""
              hold cwj2 = cwi
              hold cww = 1
              while cww == 1 {
                when cwj2 >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwj2)
                  when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                    hold cwid = concat(cwid, chr(ccx))
                    hold cwj2 = cwj2 + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwnx = cwj2
              hold cww = 1
              while cww == 1 {
                when cwnx >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwnx)
                  when ccx == 32 || ccx == 9 {
                    hold cwnx = cwnx + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwcall = 0
              when cwnx < cl {
                hold ccx = sx_index(ctrim, cwnx)
                when ccx == 40 {
                  hold cwcall = 1
                }
              }
              hold cwmap = ""
              // word operators and boolean literals (full language)
              when sx_eq(cwid, "and") {
                hold cwmap = "&&"
              }
              when sx_eq(cwid, "or") {
                hold cwmap = "||"
              }
              when sx_eq(cwid, "not") {
                hold cwmap = "!"
              }
              when sx_eq(cwid, "true") {
                hold cwmap = "1"
              }
              when sx_eq(cwid, "false") {
                hold cwmap = "0"
              }
              when cwcall == 1 && sx_eq(cwmap, "") {
                when sx_eq(cwid, "concat") {
                  hold cwmap = "sx_cat"
                  hold rt = 1
                }
                when sx_eq(cwid, "chr") {
                  hold cwmap = "sx_chr"
                  hold rt = 1
                }
                when sx_eq(cwid, "sx_index") {
                  hold cwmap = "sx_idx"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_file") {
                  hold cwmap = "sx_read"
                  hold rt = 1
                }
                when sx_eq(cwid, "http_get") {
                  hold cwmap = "sx_http"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_file") {
                  hold cwmap = "sx_write"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg") {
                  hold cwmap = "sx_arg"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg_count") {
                  hold cwmap = "sx_argc"
                  hold rt = 1
                }
                when sx_eq(cwid, "gc") || sx_eq(cwid, "sx_gc_run") {
                  hold cwmap = "sx_gc_run"
                }
                when sx_eq(cwid, "gc_live") || sx_eq(cwid, "sx_gc_live") {
                  hold cwmap = "sx_gc_live"
                }
                when sx_eq(cwid, "gc_runs") || sx_eq(cwid, "sx_gc_count") {
                  hold cwmap = "sx_gc_count"
                }
                when sx_eq(cwid, "read_line") {
                  hold cwmap = "sx_read_line"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_n") {
                  hold cwmap = "sx_read_n"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_dir") {
                  hold cwmap = "sx_read_dir"
                  hold rt = 1
                }
                when sx_eq(cwid, "path_kind") {
                  hold cwmap = "sx_path_kind"
                  hold rt = 1
                }
                when sx_eq(cwid, "path_size") {
                  hold cwmap = "sx_path_size"
                  hold rt = 1
                }
                when sx_eq(cwid, "path_real") {
                  hold cwmap = "sx_path_real"
                  hold rt = 1
                }
                when sx_eq(cwid, "run_command") {
                  hold cwmap = "sx_run_command"
                  hold rt = 1
                }
                when sx_eq(cwid, "getenv") {
                  hold cwmap = "sx_getenv"
                  hold rt = 1
                }
                when sx_eq(cwid, "spawn") {
                  hold cwmap = "sx_spawn"
                  hold rt = 1
                }
                when sx_eq(cwid, "child_send") {
                  hold cwmap = "sx_child_send"
                  hold rt = 1
                }
                when sx_eq(cwid, "child_recv") {
                  hold cwmap = "sx_child_recv"
                  hold rt = 1
                }
                when sx_eq(cwid, "child_line") {
                  hold cwmap = "sx_child_line"
                  hold rt = 1
                }
                when sx_eq(cwid, "child_close") {
                  hold cwmap = "sx_child_close"
                  hold rt = 1
                }
                when sx_eq(cwid, "make_dir") {
                  hold cwmap = "sx_make_dir"
                  hold rt = 1
                }
                when sx_eq(cwid, "make_link") {
                  hold cwmap = "sx_make_link"
                  hold rt = 1
                }
                when sx_eq(cwid, "remove_path") {
                  hold cwmap = "sx_remove_path"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_bytes") {
                  hold cwmap = "sx_write_bytes"
                }
                when sx_eq(cwid, "bytes_f64") {
                  hold cwmap = "sx_bytes_f64"
                }
                when sx_eq(cwid, "read_bytes") {
                  hold cwmap = "sx_read_bytes"
                }
                when sx_eq(cwid, "bit_and") {
                  hold cwmap = "sx_bit_and"
                }
                when sx_eq(cwid, "bit_or") {
                  hold cwmap = "sx_bit_or"
                }
                when sx_eq(cwid, "bit_xor") {
                  hold cwmap = "sx_bit_xor"
                }
                when sx_eq(cwid, "bit_not") {
                  hold cwmap = "sx_bit_not"
                }
                when sx_eq(cwid, "shl") {
                  hold cwmap = "sx_shl"
                }
                when sx_eq(cwid, "shr") {
                  hold cwmap = "sx_shr"
                }
                when sx_eq(cwid, "exit") {
                  hold cwmap = "sx_exit"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_out") {
                  hold cwmap = "sx_write_out"
                  hold rt = 1
                }
                when sx_eq(cwid, "flush_out") {
                  hold cwmap = "sx_flush_out"
                  hold rt = 1
                }
                when sx_eq(cwid, "numstr") {
                  hold cwmap = "sx_numstr"
                  hold rt = 1
                }
                when sx_eq(cwid, "string_eq") {
                  hold cwmap = "sx_eq"
                  hold rt = 1
                }
                when sx_eq(cwid, "push") {
                  hold cwmap = "sx_lpush"
                  hold lt = 1
                }
                when sx_eq(cwid, "len") {
                  // len(xs) on a list variable is sx_llen, otherwise sx_len
                  hold cwarg = ""
                  hold cwai = cwnx + 1
                  hold cwbd = 1
                  hold cww = 1
                  while cww == 1 {
                    when cwai >= cl {
                      hold cww = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwai)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      when cwbd == 0 {
                        hold cww = 0
                      } otherwise {
                        hold cwarg = concat(cwarg, chr(ccx))
                      }
                      hold cwai = cwai + 1
                    }
                  }
                  hold cwal2 = len(cwarg)
                  hold cwt = 1
                  while cwt == 1 {
                    when cwal2 <= 0 {
                      hold cwt = 0
                    } otherwise {
                      hold ccx = sx_index(cwarg, cwal2 - 1)
                      when ccx == 32 || ccx == 9 {
                        hold cwal2 = cwal2 - 1
                      } otherwise {
                        hold cwt = 0
                      }
                    }
                  }
                  hold cwarg2 = ""
                  hold cwa2 = 0
                  while cwa2 < cwal2 {
                    hold cwarg2 = concat(cwarg2, chr(sx_index(cwarg, cwa2)))
                    hold cwa2 = cwa2 + 1
                  }
                  hold cwlkey = concat("|", cwarg2)
                  hold cwlkey = concat(cwlkey, "|")
                  hold cwlkl = len(cwlkey)
                  hold cwll = len(ldecls)
                  hold cwli = 0
                  hold cwlf = 0
                  while cwli + cwlkl <= cwll {
                    hold cwlok = 1
                    hold cwlj = 0
                    while cwlj < cwlkl {
                      hold cwla = sx_index(ldecls, cwli + cwlj)
                      hold cwlb = sx_index(cwlkey, cwlj)
                      when cwla == cwlb {
                        hold cwlj = cwlj + 1
                      } otherwise {
                        hold cwlok = 0
                        hold cwlj = cwlkl
                      }
                    }
                    when cwlok == 1 {
                      hold cwlf = 1
                      hold cwli = cwll
                    } otherwise {
                      hold cwli = cwli + 1
                    }
                  }
                  when cwlf == 1 {
                    hold cwmap = "sx_llen"
                    hold lt = 1
                  } otherwise {
                    hold cwmap = "sx_len"
                    hold rt = 1
                  }
                }
              }
              // ---- an indexed list or string inside a condition ----------
              // `when xs[i] > 0` and `while s[i] != 34` used to be copied
              hold cqdone = 0
              hold cqbrk = 0
              when cwcall == 0 && sx_eq(cwmap, "") && cwnx < cl {
                hold ccx = sx_index(ctrim, cwnx)
                when ccx == 91 {
                  hold cqbrk = 1
                }
              }
              when cqbrk == 1 {
                hold cqkey = concat("|", cwid)
                hold cqkey = concat(cqkey, "|")
                hold cqkl = len(cqkey)
                hold cqlst = 0
                hold cqstr = 0
                hold cqk = 0
                while cqk < 2 {
                  hold cqsrc = ldecls
                  when cqk == 1 {
                    hold cqsrc = sdecls
                  }
                  hold cqdi = 0
                  hold cqdl = len(cqsrc)
                  while cqdi + cqkl <= cqdl {
                    hold cqok2 = 1
                    hold cqj = 0
                    while cqj < cqkl {
                      when sx_index(cqsrc, cqdi + cqj) == sx_index(cqkey, cqj) {
                        hold cqj = cqj + 1
                      } otherwise {
                        hold cqok2 = 0
                        hold cqj = cqkl
                      }
                    }
                    when cqok2 == 1 {
                      when cqk == 0 {
                        hold cqlst = 1
                      } otherwise {
                        hold cqstr = 1
                      }
                      hold cqdi = cqdl
                    } otherwise {
                      hold cqdi = cqdi + 1
                    }
                  }
                  hold cqk = cqk + 1
                }
                when cqlst == 1 || cqstr == 1 {
                  hold cqix = ""
                  hold cqai = cwnx + 1
                  hold cqq = 1
                  hold cqok = 1
                  hold cqdep = 0
                  while cqq == 1 {
                    when cqai >= cl {
                      hold cqq = 0
                      hold cqok = 0
                    } otherwise {
                      hold cqcd = sx_index(ctrim, cqai)
                      when cqcd == 93 && cqdep == 0 {
                        hold cqq = 0
                      } otherwise {
                        // a nested index is copied with its brackets, and
                        // idx_lower below decides what is lowerable
                        when cqcd == 91 {
                          hold cqdep = cqdep + 1
                        }
                        when cqcd == 93 {
                          hold cqdep = cqdep - 1
                        }
                        hold cqix = concat(cqix, chr(cqcd))
                        hold cqai = cqai + 1
                      }
                    }
                  }
                  when cqok == 1 {
                    hold cqxl = idx_lower(cqix, ldecls, sdecls, fsret, fspk)
                    when len(cqxl) == 0 {
                      hold cqok = 0
                    } otherwise {
                      when len(cqxl) != len(cqix) {
                        hold rt = 1
                      }
                      hold cqix = cqxl
                    }
                  }
                  when cqok == 0 {
                    when perr == 0 {
                      hold permsg = concat("an index inside a condition must be a numeric expression over numbers, names, fields, len(), indexes and + - * /; '", cwid)
                      hold permsg = concat(permsg, "' is indexed with something else (bind it with hold first)")
                    }
                    hold perr = 1
                  } otherwise {
                    hold cqfn = "sx_idx"
                    when cqlst == 1 {
                      hold cqfn = "sx_lget"
                      hold lt = 1
                    } otherwise {
                      hold rt = 1
                    }
                    hold crepl = concat(crepl, cqfn)
                    hold crepl = concat(crepl, "(")
                    hold crepl = concat(crepl, cwid)
                    hold crepl = concat(crepl, ",")
                    hold crepl = concat(crepl, cqix)
                    hold crepl = concat(crepl, ")")
                    hold cwi = cqai + 1
                    hold cqdone = 1
                  }
                }
              }
              when cqdone == 0 {
                when sx_eq(cwmap, "") {
                  hold crepl = concat(crepl, cwid)
                } otherwise {
                  // keep the call's own spacing: only the name is replaced
                  hold crepl = concat(crepl, cwmap)
                }
                hold cwi = cwj2
              }
            } otherwise {
              hold crepl = concat(crepl, chr(ccx))
              // `/` always divides doubles (10 / 4 is 2.5, never C's 2)
              when ccx == 47 && cwbracket == 0 {
                hold crepl = concat(crepl, "(double)")
              }
              hold cwi = cwi + 1
            }
          }
        }
      }
      when (act == 3 || act == 6 || act == 8) && perr == 0 {
        // Parse the original condition, before legacy comparison rewriting
        // can split a string operand at +. Public calls lower to sx_* names.
        hold scprivate = inprivate
        when inready == 0 {
          when len(condition_private) == 0 {
            hold condition_private = inprivate
            while sxecontains(source, condition_private) { condition_private = concat(condition_private, "x") }
          }
          hold scprivate = condition_private
        }
        hold scenv = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, scprivate)
        hold scstate = []
        hold scfirst = len(instate)
        hold scserial = 0
        while scserial < scfirst {
          push(scstate, 0)
          scserial = scserial + 1
        }
        hold scinput = checked_condition_source
        hold scvalue = sxeparse(scinput, 0, scenv, 0, 0, scstate)
        when (sx_eq(sxesegment(scvalue, 1), "n") == 1 || (act == 6 && sx_eq(sxesegment(scvalue, 1), "s") == 1)) && sxflowspace(scinput, sxepos(scvalue)) == len(scinput) {
          when sxecontains(sxecode(scvalue), "sx_cmp(") == 1 || (act == 6 && sxecontains(sxecode(scvalue), "sx_cat(") == 1) || (act == 8 && checked_value == 1) {
            hold crepl = sxecode(scvalue)
            fully_checked_value = 1
            fully_checked_kind = sxesegment(scvalue, 1)
            hold rt = 1
            when len(scstate) > scfirst || sxecontains(crepl, concat(scprivate, "list(")) == 1 {
              hold inprivate = scprivate
              when inready == 0 {
                hold inready = 1
                hold fsret = concat(fsret, concat(inprivate, "list=l|"))
              }
              hold lt = 1
              hold scdecls = ""
              hold scserial = scfirst
              while scserial < len(scstate) {
                push(instate, 0)
                hold scdecls = concat(scdecls, "  double ")
                hold scdecls = concat(scdecls, inprivate)
                hold scdecls = concat(scdecls, sxedigits(scserial))
                hold scdecls = concat(scdecls, ";\n")
                hold scserial = scserial + 1
              }
              // Hoist declarations ONLY, not evaluations. Function locals
              // survive recursion; main locals also work across else-if.
              when in_fn == 1 {
                hold condition_fn_decls = concat(condition_fn_decls, scdecls)
              } otherwise {
                hold condition_main_decls = concat(condition_main_decls, scdecls)
              }
            }
          }
        } otherwise {
          hold scerror = sxecode(scvalue)
          when sx_eq(sxesegment(scvalue, 1), "e") == 1 && (sx_eq(scerror, "numeric operator requires numeric operands") || sx_eq(scerror, "call argument type mismatch") || sx_eq(scerror, "too many call arguments") || sx_eq(scerror, "call argument count mismatch") || sx_eq(scerror, "unary operator requires a number") || sx_eq(scerror, "interpolation requires a string or number") || sx_eq(scerror, "length/index requires a string or list") || sxecontains(scerror, "' is not a list")) {
            hold perr = 1
            hold permsg = concat("condition expression: ", scerror)
          }
          when act == 3 && sx_eq(sxesegment(scvalue, 1), "e") == 0 && sx_eq(sxesegment(scvalue, 1), "n") == 0 && sxflowspace(scinput, sxepos(scvalue)) == len(scinput) {
            hold perr = 1
            hold permsg = "condition expression requires a numeric result"
          }
        }
      }
    }

    // ---- while/when: emit ----
    when act == 3 {
      when pos < n {
        hold cs = sxsource_get(source_words,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when iswhile == 1 {
        hold body = concat(body, "while (")
        hold whiles = whiles + 1
      } otherwise {
        hold body = concat(body, "if (")
        hold whens = whens + 1
      }
      hold body = concat(body, crepl)
      hold body = concat(body, ") {")
      hold body = concat(body, nl)
      // Snapshot after any binder declaration, before parsing this body.
      when in_fn == 1 {
        push(scope_marks, scope_head)
        push(scope_marks, len(decls))
        push(scope_marks, len(sdecls))
        push(scope_marks, len(ldecls))
        push(scope_marks, len(svars))
        hold scope_head = len(scope_marks) - 5
      }
      hold depth = depth + 1
      when iswhile == 1 {
        hold blk = concat(blk, "w")
        hold loopd = loopd + 1
      } otherwise {
        hold blk = concat(blk, "i")
      }
    }

    // ---- give: emit ----
    when act == 6 {
      when fully_checked_value == 1 && in_fn == 1 {
        hold checked_return_kind = sxelookup(fsret, fn_name, "=")
        when len(checked_return_kind) > 0 && sx_eq(checked_return_kind, fully_checked_kind) == 0 {
          perr = 1
          permsg = "function give type mismatch: expression kind differs from declared return"
        }
      }
      when fsstructactive == 1 && in_fn == 1 {
        hold sfenv = sxfenv(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold sfkind = fully_checked_kind
        hold sfcomplete = 1
        when fully_checked_value == 0 {
          hold sfreturn = sxeparse(crepl, 0, sfenv, 0, 0, instate)
          sfkind = sxesegment(sfreturn, 1)
          when sxflowspace(crepl, sxepos(sfreturn)) != len(crepl) { sfcomplete = 0 }
        }
        hold sfexpected = sxelookup(fsret, fn_name, "=")
        when string_eq(sfkind, sfexpected) == 0 || sfcomplete == 0 {
          hold perr = 1
          hold permsg = "function give type mismatch (named struct identity must match)"
        }
      }
      hold body = concat(body, "  return ")
      hold body = concat(body, crepl)
      hold body = concat(body, ";")
      hold body = concat(body, nl)
    }

    // ================= hold/show with a parenthesized expression =================
    // ctrim was validated in the pre-checks and rewritten into crepl
    when act == 8 {
      when pmode == 1 && len(atype) > 0 && sx_eq(atype, "num") == 0 && sx_eq(atype, "number") == 0 && sx_eq(atype, "bool") == 0 && sx_eq(atype, "double") == 0 {
        perr = 1
        permsg = "type mismatch: a numeric comparison/group cannot initialize the declared non-numeric kind"
      }
      when fsstructactive == 1 && fully_checked_value == 0 && sxfneedscheck(crepl, fsret, fspk, svars) == 1 {
        hold sfenv = sxfenv(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
        hold sfvalue = sxeparse(crepl, 0, sfenv, 0, 0, instate)
        hold sfkind = sxesegment(sfvalue, 1)
        when string_eq(sfkind, "e") || sxflowspace(crepl, sxepos(sfvalue)) != len(crepl) {
          hold perr = 1
          hold permsg = "unsupported grouped struct expression"
        }
        when len(sfkind) > 1 && sx_index(sfkind, 0) == 117 {
          hold perr = 1
          hold permsg = "grouped struct value unsupported; bind a direct call first"
        }
      }
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when pmode == 2 {
        hold body = concat(body, ind)
        hold body = concat(body, "printf(\"%g\\n\", (double)(")
        hold body = concat(body, crepl)
        hold body = concat(body, "));")
        hold body = concat(body, nl)
        hold shows = shows + 1
      } otherwise {
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = sdecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold pok2 = pfound
        hold psrc = ldecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "=")
        hold psrc = svars
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        when pok2 == 1 {
          when perr == 0 {
            hold permsg = concat("cannot hold a number in '", pnm)
            hold permsg = concat(permsg, "', which already holds a string, list or struct")
          }
          hold perr = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = decls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold body = concat(body, ind)
        when pfound == 0 {
          hold body = concat(body, "double ")
          hold decls = concat(decls, pnm)
          hold decls = concat(decls, "|")
        }
        hold body = concat(body, pnm)
        hold body = concat(body, " = (")
        hold body = concat(body, crepl)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
        hold holds = holds + 1
      }
    }

    // ================= } and } otherwise { and } elif =================
    when act == 4 {
      hold pos = pos + 1
      // close bookkeeping: what kind of block does this `}` end?
      // ('w' while, 'f' for, 'i' when, 'e' else, 'E' elif-chain else,
      hold bkc = 0
      hold bkn = len(blk)
      when bkn > 0 {
        hold bkc = sx_index(blk, bkn - 1)
        hold bkt = ""
        hold bki = 0
        while bki + 1 < bkn {
          hold bkt = concat(bkt, chr(sx_index(blk, bki)))
          hold bki = bki + 1
        }
        hold blk = bkt
      }
      when bkc == 119 || bkc == 102 {
        when loopd > 0 {
          hold loopd = loopd - 1
        }
      }
      // A source block ends here. Synthetic elif wrapper blocks contain no
      // declarations and therefore do not add/pop scope records.
      when in_fn == 1 && bkc != 109 && scope_head >= 0 {
        hold scpos = scope_head + 1
        hold scope_length = scope_marks[scpos]
        hold scope_text = ""
        hold scope_i = 0
        while scope_i < scope_length {
          hold scope_text = concat(scope_text, chr(sx_index(decls, scope_i)))
          hold scope_i = scope_i + 1
        }
        hold decls = scope_text
        hold scpos = scope_head + 2
        hold scope_length = scope_marks[scpos]
        hold scope_text = ""
        hold scope_i = 0
        while scope_i < scope_length {
          hold scope_text = concat(scope_text, chr(sx_index(sdecls, scope_i)))
          hold scope_i = scope_i + 1
        }
        hold sdecls = scope_text
        hold scpos = scope_head + 3
        hold scope_length = scope_marks[scpos]
        hold scope_text = ""
        hold scope_i = 0
        while scope_i < scope_length {
          hold scope_text = concat(scope_text, chr(sx_index(ldecls, scope_i)))
          hold scope_i = scope_i + 1
        }
        hold ldecls = scope_text
        hold scpos = scope_head + 4
        hold scope_length = scope_marks[scpos]
        hold scope_text = ""
        hold scope_i = 0
        while scope_i < scope_length {
          hold scope_text = concat(scope_text, chr(sx_index(svars, scope_i)))
          hold scope_i = scope_i + 1
        }
        hold svars = scope_text
        hold scpos = scope_head
        hold scope_head = scope_marks[scpos]
      }
      when bkc == 109 {
        // end of a make body: the enclosing code's variables are visible again
        hold decls = savdecls
        hold sdecls = savsdecls
        hold ldecls = savldecls
        hold svars = savsvars
      }
      // look ahead over blanks for the word "otherwise"
      hold wi = pos
      hold wsc = 1
      while wsc == 1 {
        when wi >= n {
          hold wsc = 0
        } otherwise {
          hold cw = sxsource_get(source_words,wi)
          when cw == 32 || cw == 9 || cw == 13 || cw == 10 {
            hold wi = wi + 1
          } otherwise {
            hold wsc = 0
          }
        }
      }
      hold wfound = 0
      hold wlen = 0
      when wi + 9 <= n {
        hold w9 = ""
        hold wk = 0
        while wk < 9 {
          hold w9 = concat(w9, chr(sxsource_get(source_words,wi + wk)))
          hold wk = wk + 1
        }
        hold wfound = sx_eq(w9, "otherwise")
        when wfound == 1 {
          hold wlen = 9
        }
      }
      // "else" is an alias of "otherwise" (must be the whole keyword)
      when wfound == 0 {
        when wi + 4 <= n {
          hold w4 = ""
          hold wk = 0
          while wk < 4 {
            hold w4 = concat(w4, chr(sxsource_get(source_words,wi + wk)))
            hold wk = wk + 1
          }
          when sx_eq(w4, "else") {
            hold wok = 1
            when wi + 4 < n {
              hold we = sxsource_get(source_words,wi + 4)
              when (we >= 97 && we <= 122) || (we >= 65 && we <= 90) || (we >= 48 && we <= 57) || we == 95 {
                hold wok = 0
              }
            }
            when wok == 1 {
              hold wfound = 1
              hold wlen = 4
            }
          }
        }
      }
      // ---- `} elif COND {` / `} else if COND {` (full language) ----
      // Both are compiled without a second parser: `} else {` is emitted
      hold iselif = 0
      hold elen = 0
      when wi + 4 <= n {
        hold ekw = ""
        hold eki = 0
        while eki < 4 {
          hold ekw = concat(ekw, chr(sxsource_get(source_words, wi + eki)))
          hold eki = eki + 1
        }
        when sx_eq(ekw, "elif") {
          hold enx = 0
          when wi + 4 < n {
            hold enx = sxsource_get(source_words, wi + 4)
          }
          hold eident = 0
          when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
            hold eident = 1
          }
          when eident == 0 {
            hold iselif = 1
            hold elen = 4
          }
        }
      }
      when iselif == 0 {
        hold ew4 = ""
        hold eki = 0
        while eki < 4 {
          when wi + eki < n {
            hold ew4 = concat(ew4, chr(sxsource_get(source_words, wi + eki)))
          }
          hold eki = eki + 1
        }
        // `else` and `otherwise` (wfound, length wlen) both start a chain
        when wfound == 1 {
          hold ep = wi + wlen
          hold eskip = 1
          while eskip == 1 {
            hold eskip = 0
            when ep < n {
              hold ec2 = sxsource_get(source_words, ep)
              when ec2 == 32 || ec2 == 9 || ec2 == 13 {
                hold ep = ep + 1
                hold eskip = 1
              }
            }
          }
          hold eif = ""
          hold eki = 0
          while eki < 2 {
            when ep + eki < n {
              hold eif = concat(eif, chr(sxsource_get(source_words, ep + eki)))
            }
            hold eki = eki + 1
          }
          when sx_eq(eif, "if") {
            hold enx = 0
            when ep + 2 < n {
              hold enx = sxsource_get(source_words, ep + 2)
            }
            hold eident = 0
            when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
              hold eident = 1
            }
            when eident == 0 {
              hold iselif = 1
              hold elen = ep + 2 - wi
            }
          }
          // `} else when COND {` is the same chain as `else if`: the 4-byte
          // keyword "when" is already in place, so the rewrite below only
          // blanks the `else ` prefix (same byte count, same chain close).
          when sx_eq(eif, "wh") && ep + 4 <= n {
            hold ewh = ""
            hold ewk = 0
            while ewk < 4 {
              hold ewh = concat(ewh, chr(sxsource_get(source_words, ep + ewk)))
              hold ewk = ewk + 1
            }
            hold enx = 0
            when ep + 4 < n {
              hold enx = sxsource_get(source_words, ep + 4)
            }
            hold eident = 0
            when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
              hold eident = 1
            }
            when sx_eq(ewh, "when") && eident == 0 {
              hold iselif = 1
              hold elen = ep + 4 - wi
            }
          }
        }
      }
      when iselif == 1 {
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
        // rewrite the keyword in place: `elif` -> `when`,
        // `else if` -> `when` + blanks (identical byte count)
        hold src2 = sxseed_slice(source, 0, wi)
        hold src2 = concat(src2, "when")
        hold si = wi + 4
        while si < wi + elen {
          hold src2 = concat(src2, " ")
          hold si = si + 1
        }
        hold src2 = concat(src2, sxseed_slice(source, si, n))
        hold source = src2
        hold source_words = sxsource_pack(source)
        hold pos = wi
        hold blk = concat(blk, "E")
      }
      hold enormal = 1
      when iselif == 1 {
        hold enormal = 0
      }
      when wfound == 1 {
        hold enormal = 0
      }
      // A chain (`} else if COND {`, `} else when COND {`) was already
      // rewritten to `when` above and emits its own `} else {`: skip the
      // plain-else emission here, or the chain gets two else levels.
      when wfound == 1 && iselif == 0 {
        // "} otherwise {" and "} else {" both become "} else {"
        hold pos = wi + wlen
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sxsource_get(source_words,pos)
        }
        when c2 == 123 {
          hold pos = pos + 1
        }
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
      // Snapshot after any binder declaration, before parsing this body.
      when in_fn == 1 {
        push(scope_marks, scope_head)
        push(scope_marks, len(decls))
        push(scope_marks, len(sdecls))
        push(scope_marks, len(ldecls))
        push(scope_marks, len(svars))
        hold scope_head = len(scope_marks) - 5
      }
        // Only synthetic else wrappers use E. A real else body must be
        // an e barrier, even inside a chain, or a nested else closes its
        // enclosing chain early and leaks a brace into the top-level body.
        hold blk = concat(blk, "e")
      }
      when enormal == 1 {
        // Does this `}` end an `elif` chain?  Then the chain's extra
        // `else {` level ('E' in blk) also closes here, with one more `}`.
        hold eclose = 0
        hold eck = len(blk)
        hold edone = 0
        while edone == 0 {
          when eck > 0 {
            hold ecc = sx_index(blk, eck - 1)
            when ecc == 69 {
              hold eclose = eclose + 1
              hold ekt = ""
              hold eki2 = 0
              while eki2 + 1 < eck {
                hold ekt = concat(ekt, chr(sx_index(blk, eki2)))
                hold eki2 = eki2 + 1
              }
              hold blk = ekt
              hold eck = eck - 1
            } otherwise {
              hold edone = 1
            }
          } otherwise {
            hold edone = 1
          }
        }
        when depth > 0 {
          hold depth = depth - 1
        }
        when in_fn == 1 {
          when depth == 0 {
            hold body = concat(body, "}\n\n")
            when len(condition_fn_decls) > 0 {
              hold scbrace = 0
              while scbrace < len(body) && sx_index(body, scbrace) != 123 { scbrace = scbrace + 1 }
              hold body = concat(sxeslice(body, 0, scbrace + 1), concat("\n", concat(condition_fn_decls, sxeslice(body, scbrace + 1, len(body)))))
            }
            hold fns = concat(fns, body)
            hold body = saved_body
            hold in_fn = 0
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
        } otherwise {
          hold ind = "  "
          hold wk = 0
          while wk < depth {
            hold ind = concat(ind, "  ")
            hold wk = wk + 1
          }
          hold body = concat(body, ind)
          hold body = concat(body, "}")
          hold body = concat(body, nl)
        }
        // the extra closes of an `elif` chain: one per `else {` level the
        // chain opened (see the note in act 4)
        hold eci = 0
        while eci < eclose {
          when depth > 0 {
            hold depth = depth - 1
          }
          when in_fn == 1 && depth == 0 {
            // the function body was just flushed; the extra brace still
            // belongs to the function text
            hold fns = concat(fns, "}\n")
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
          hold eci = eci + 1
        }
      }
    }

    // ================= make NAME ( params ) { =================
    when act == 5 {
      hold pos = pos + 4
      hold firstp = 1
      hold fn_params = ""
      hold fn_retkind = 110
      hold flowtyped = 0
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fn_name = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sxsource_get(source_words,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold fn_name = concat(fn_name, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sxsource_get(source_words,pos)
        when cs == 40 {
          hold pos = pos + 1
        }
      }
      hold fn_params = ""
      hold firstp = 1
      hold pr = 1
      while pr == 1 {
        when pos >= n {
          hold pr = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 41 {
            hold pos = pos + 1
            hold pr = 0
          } otherwise {
            when cs == 44 || cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || cs == 95 {
                hold pn = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sxsource_get(source_words,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold pn = concat(pn, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when firstp == 0 {
                  hold fn_params = concat(fn_params, ", ")
                }
                hold fn_params = concat(fn_params, "double ")
                hold fn_params = concat(fn_params, pn)
                hold firstp = 0
              } otherwise {
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // optional `-> TYPE` (full language): the return type is recorded by
      // the signature pre-pass, so this only has to be skipped here
      hold cs = 0
      hold cs2 = 0
      when pos < n {
        hold cs = sxsource_get(source_words,pos)
      }
      when pos + 1 < n {
        hold cs2 = sxsource_get(source_words,pos + 1)
      }
      when cs == 45 && cs2 == 62 {
        hold flowtyped = 1
        hold pos = pos + 2
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold rtword = ""
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || (cs >= 48 && cs <= 57) || cs == 95 {
              hold rtword = concat(rtword, chr(cs))
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold fnnx = 0
        when pos < n {
          hold fnnx = sxsource_get(source_words,pos)
        }
        hold fnnx2 = 0
        when pos + 1 < n {
          hold fnnx2 = sxsource_get(source_words,pos + 1)
        }
        when sx_eq(rtword, "str") && fnnx != 45 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "str") && fnnx == 45 && fnnx2 != 62 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "list") {
          hold fn_retkind = 108
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sxsource_get(source_words,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      when flowtyped == 1 {
        hold flowresult = sxflowblock(source, pos - 1, 0)
        hold flowreturns = flowresult[1]
        when flowreturns == 0 {
          hold perr = 1
          hold permsg = concat("typed function may fall through without give: ", fn_name)
        }
      }
      hold fnstructkind = sxelookup(fsret, fn_name, "=")
      when len(fnstructkind) > 1 && sx_index(fnstructkind, 0) == 117 {
        hold fn_retkind = 117
      }
      hold saved_body = body
      hold body = ""
      hold condition_fn_decls = ""
      when fn_retkind == 115 {
        hold body = concat(body, "static char *")
      } otherwise {
        when fn_retkind == 108 {
          hold body = concat(body, "static sx_list *")
        } otherwise {
          when fn_retkind == 117 {
            hold body = concat(body, "static ")
            hold body = concat(body, sxeslice(fnstructkind, 1, len(fnstructkind)))
            hold body = concat(body, " ")
          } otherwise {
            hold body = concat(body, "static double ")
          }
        }
      }
      hold body = concat(body, fn_name)
      hold body = concat(body, "(")
      // the parameter list comes from the signature pre-pass:
      // `double a, char *b` for `make f(a, b: str)`
      hold fpt2 = ""
      hold fky = concat("|", fn_name)
      hold fky = concat(fky, "=")
      hold fkl = len(fky)
      hold fksrc = fsptx
      hold fki = 0
      hold fkln = len(fksrc)
      hold fkfound = 0
      while fki + fkl <= fkln {
        hold fkok = 1
        hold fkj = 0
        while fkj < fkl {
          hold fka = sx_index(fksrc, fki + fkj)
          hold fkb = sx_index(fky, fkj)
          when fka == fkb {
            hold fkj = fkj + 1
          } otherwise {
            hold fkok = 0
            hold fkj = fkl
          }
        }
        when fkok == 1 {
          hold fkfound = 1
          hold fkend = fki + fkl
          hold fkrun = 1
          while fkrun == 1 {
            when fkend >= fkln {
              hold fkrun = 0
            } otherwise {
              hold fka = sx_index(fksrc, fkend)
              when fka == 124 {
                hold fkrun = 0
              } otherwise {
                hold fpt2 = concat(fpt2, chr(fka))
                hold fkend = fkend + 1
              }
            }
          }
          hold fki = fkln
        } otherwise {
          hold fki = fki + 1
        }
      }
      when fkfound == 1 {
        hold fn_params = fpt2
      }
      when len(fn_params) == 0 {
        hold body = concat(body, "void")
      } otherwise {
        hold body = concat(body, fn_params)
      }
      // All definitions contribute a prototype before any bodies are emitted.
      // Generic instances may already have one from specialization; retain
      // that spelling and avoid duplicate declarations by whole-name lookup.
      hold fpkey = concat(fn_name, "(")
      hold fpi = 0
      hold fpl = len(gproto)
      hold fpkl = len(fpkey)
      hold fpfound = 0
      while fpi + fpkl <= fpl {
        hold fpok = 1
        when fpi > 0 {
          hold fpc = sx_index(gproto, fpi - 1)
          when (fpc >= 65 && fpc <= 90) || (fpc >= 97 && fpc <= 122) || (fpc >= 48 && fpc <= 57) || fpc == 95 {
            hold fpok = 0
          }
        }
        hold fpj = 0
        while fpj < fpkl && fpok == 1 {
          when sx_index(gproto, fpi + fpj) != sx_index(fpkey, fpj) {
            hold fpok = 0
          }
          hold fpj = fpj + 1
        }
        when fpok == 1 {
          hold fpfound = 1
          hold fpi = fpl
        }
        hold fpi = fpi + 1
      }
      when fpfound == 0 {
        hold gproto = concat(gproto, body)
        hold gproto = concat(gproto, ");")
        hold gproto = concat(gproto, nl)
      }
      when seed_profile == 1 { hold body = concat(body, "){") } otherwise { hold body = concat(body, ") {") }
      hold body = concat(body, nl)
      // Variables are scoped to their function: save the tables of the
      // enclosing (top level) code and start the body with an empty set, so
      hold savdecls = decls
      hold savsdecls = sdecls
      hold savldecls = ldecls
      hold savsvars = svars
      hold decls = "|"
      hold sdecls = "|"
      hold ldecls = "|"
      hold svars = ""
      hold scope_head = -1
      // Remember the parameter kinds.  `show name` and `hold name = ...`
      // inside the body must see a `str`/`list` parameter as the existing
      // variable it is (a numeric parameter stays numeric).
      hold ppi = 0
      hold ppl = len(fn_params)
      hold ppordinal = 0
      hold ppsignature = sxelookup(fspk, fn_name, "=")
      hold ppstart = 0
      hold ppname = ""
      hold ppkind = 0
      while ppi <= ppl {
        hold ppc = 0
        when ppi < ppl {
          hold ppc = sx_index(fn_params, ppi)
        }
        when ppi == ppl || ppc == 44 {
          hold ppj = ppi - 1
          hold ppname = ""
          hold ppstop = ppstart - 1
          while ppj >= ppstart {
            hold ppk = sx_index(fn_params, ppj)
            when (ppk >= 97 && ppk <= 122) || (ppk >= 65 && ppk <= 90) || (ppk >= 48 && ppk <= 57) || ppk == 95 {
              hold ppname = concat(chr(ppk), ppname)
              hold ppj = ppj - 1
            } otherwise {
              hold ppj = ppstop
            }
          }
          hold ppkind = 0
          hold ppj = ppstart
          while ppj + 7 <= ppi {
            when sx_index(fn_params, ppj) == 115 && sx_index(fn_params, ppj + 1) == 120 && sx_index(fn_params, ppj + 2) == 95 && sx_index(fn_params, ppj + 3) == 108 && sx_index(fn_params, ppj + 4) == 105 && sx_index(fn_params, ppj + 5) == 115 && sx_index(fn_params, ppj + 6) == 116 {
              hold ppkind = 2
            }
            hold ppj = ppj + 1
          }
          hold ppj = ppstart
          while ppj + 4 <= ppi {
            when sx_index(fn_params, ppj) == 99 && sx_index(fn_params, ppj + 1) == 104 && sx_index(fn_params, ppj + 2) == 97 && sx_index(fn_params, ppj + 3) == 114 {
              hold ppkind = 1
            }
            hold ppj = ppj + 1
          }
          hold ppstructkind = sxfpkget(ppsignature, ppordinal)
          hold ppordinal = ppordinal + 1
          when len(ppname) > 0 {
            when len(ppstructkind) > 1 && sx_index(ppstructkind, 0) == 117 {
              hold ppkind = 0
              hold ppstructname = sxeslice(ppstructkind, 1, len(ppstructkind))
              hold svars = concat(svars, "|")
              hold svars = concat(svars, ppname)
              hold svars = concat(svars, "=")
              hold svars = concat(svars, ppstructname)
              hold svars = concat(svars, "|")
            }
            hold decls = concat(decls, ppname)
            hold decls = concat(decls, "|")
            when ppkind == 1 {
              hold sdecls = concat(sdecls, ppname)
              hold sdecls = concat(sdecls, "|")
            }
            when ppkind == 2 {
              hold ldecls = concat(ldecls, ppname)
              hold ldecls = concat(ldecls, "|")
            }
          }
          hold ppstart = ppi + 1
        }
        hold ppi = ppi + 1
      }
      hold in_fn = 1
      hold depth = depth + 1
      hold blk = concat(blk, "m")
    }

    // ================= for NAME in A..B { =================
    // full-language statement (gen2 and later; the C seed never reads it):
    when act == 10 {
      // `pos` already points just past the word `for`
      hold fvstart = pos - 3
      hold fvspl = 0
      hold fvname = ""
      hold fva = ""
      hold fvb = ""
      hold fvok = 0
      hold ferr = 0
      hold fmsg = ""
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // the counter name
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 {
            hold fvname = concat(fvname, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fvname, "") {
        hold ferr = 1
        hold fmsg = "for loop: expected a counter name, e.g. for i in 0..10 {"
      }
      // blanks, then the word `in`
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fwin = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) {
            hold fwin = concat(fwin, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fwin, "in") {
      } otherwise {
        hold ferr = 1
        hold fmsg = "for loop: expected `in` after the counter name, e.g. for i in 0..10 {"
      }
      // blanks before A
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // A (or the list, for `for v in xs {`): text up to `..` or `{`
      hold fvmode = 0
      // fvstr = 1: `for c in s {` walks a declared string byte by byte (fvmode 1)
      hold fvstr = 0
      hold fvdup = 0
      hold fvaquote = 0
      hold fvaescape = 0
      hold fvrun = 1
      while fvrun == 1 {
        when pos >= n {
          hold fvrun = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          // Delimiters in a quoted source are bytes, not range/body syntax.
          when fvaquote == 1 || fc == 34 {
            hold fva = concat(fva, chr(fc))
            hold pos = pos + 1
            when fvaquote == 0 {
              hold fvaquote = 1
            } otherwise {
              when fvaescape == 1 {
                hold fvaescape = 0
              } otherwise {
                when fc == 92 {
                  hold fvaescape = 1
                } otherwise {
                  when fc == 34 { hold fvaquote = 0 }
                }
              }
            }
          } otherwise {
            when fc == 123 {
              // no `..`: this is `for V in LIST {`
              hold pos = pos + 1
              hold fvmode = 1
              hold fvrun = 0
            } otherwise {
              when fc == 46 {
                hold fc2 = 0
                when pos + 1 < n {
                  hold fc2 = sxsource_get(source_words, pos + 1)
                }
                when fc2 == 46 {
                  hold fvrun = 0
                } otherwise {
                  hold fva = concat(fva, chr(fc))
                  hold pos = pos + 1
                }
              } otherwise {
                when fc == 10 || fc == 13 {
                  hold fvrun = 0
                  hold ferr = 1
                  hold fmsg = "for loop: expected `A..B` or a list name before the `{`"
                } otherwise {
                  hold fva = concat(fva, chr(fc))
                  hold pos = pos + 1
                }
              }
            }
          }
        }
      }
      hold fc = 0
      when pos < n {
        hold fc = sxsource_get(source_words, pos)
      }
      when fvmode == 1 {
        hold pos = pos
      } otherwise {
        when fc == 46 {
          hold pos = pos + 2
        } otherwise {
          when ferr == 0 {
            hold ferr = 1
            hold fmsg = "for loop: expected `A..B` (two dots) before the `{`"
          }
        }
      }
      // ---- `for V in EXPR {` where EXPR is not a plain name ----------------
      // Bind the value to a hidden variable first and re-read the header as
      when fvmode == 1 && ferr == 0 {
        // the parsed text still carries the blanks before the `{`
        hold fvatr = fva
        hold fvtr2 = 1
        while fvtr2 == 1 {
          hold fvan = len(fvatr)
          when fvan <= 0 {
            hold fvtr2 = 0
          } otherwise {
            hold fvtc = sx_index(fvatr, fvan - 1)
            when fvtc == 32 || fvtc == 9 || fvtc == 13 {
              hold fvatr2 = ""
              hold fvi3 = 0
              while fvi3 < fvan - 1 {
                hold fvatr2 = concat(fvatr2, chr(sx_index(fvatr, fvi3)))
                hold fvi3 = fvi3 + 1
              }
              hold fvatr = fvatr2
            } otherwise {
              hold fvtr2 = 0
            }
          }
        }
        // `for c in (s)`: strip parens that wrap the WHOLE source (repeatedly),
        // so the name/literal/call/field inside takes its normal path below
        hold fvuw = 1
        while fvuw == 1 {
          hold fvuw = 0
          when len(fvatr) > 2 && sx_index(fvatr, 0) == 40 && sx_index(fvatr, len(fvatr) - 1) == 41 {
            hold fvudep = 0
            hold fvuwrap = 1
            hold fvui = 0
            hold fvun2 = len(fvatr)
            while fvui < fvun2 - 1 && fvuwrap == 1 {
              hold fvuc = sx_index(fvatr, fvui)
              when fvuc == 40 {
                hold fvudep = fvudep + 1
              }
              when fvuc == 41 {
                hold fvudep = fvudep - 1
                when fvudep == 0 {
                  hold fvuwrap = 0
                }
              }
              hold fvui = fvui + 1
            }
            when fvuwrap == 1 && fvudep == 1 {
              hold fvatr3 = ""
              hold fvi4 = 1
              while fvi4 < fvun2 - 1 {
                hold fvatr3 = concat(fvatr3, chr(sx_index(fvatr, fvi4)))
                hold fvi4 = fvi4 + 1
              }
              hold fvatr = fvatr3
              hold fva = fvatr
              hold fvuw = 1
            }
          }
        }
        hold fvsimple = 1
        hold fvsi3 = 0
        hold fvsn = len(fvatr)
        while fvsi3 < fvsn {
          hold fvsc = sx_index(fvatr, fvsi3)
          when (fvsc >= 97 && fvsc <= 122) || (fvsc >= 65 && fvsc <= 90) || (fvsc >= 48 && fvsc <= 57) || fvsc == 95 {
            hold fvsi3 = fvsi3 + 1
          } otherwise {
            hold fvsimple = 0
            hold fvsi3 = fvsn
          }
        }
        when fvsimple == 0 && fvsn > 0 {
          hold forcnt = forcnt + 1
          hold fvtmp = "__sx_fv"
          hold fvt = forcnt
          while fvt > 0 {
            hold fvtmp = concat(fvtmp, "x")
            hold fvt = fvt - 1
          }
          hold fvnew = "hold "
          hold fvnew = concat(fvnew, fvtmp)
          hold fvnew = concat(fvnew, " = ")
          hold fvnew = concat(fvnew, fvatr)
          hold fvnew = concat(fvnew, nl)
          hold fvnew = concat(fvnew, "for ")
          hold fvnew = concat(fvnew, fvname)
          hold fvnew = concat(fvnew, " in ")
          hold fvnew = concat(fvnew, fvtmp)
          hold fvnew = concat(fvnew, " {")
          hold fvsrc = sxseed_slice(source, 0, fvstart)
          hold fvsrc = concat(fvsrc, fvnew)
          hold fvsrc = concat(fvsrc, sxseed_slice(source, pos, n))
          hold source = fvsrc
          hold source_words = sxsource_pack(source)
          hold n = len(source)
          hold fvspl = 1
        }
      }
      // B: text up to the `{` (range mode only)
      hold fvrun2 = 1
      while fvrun2 == 1 && fvmode == 0 {
        when pos >= n {
          hold fvrun2 = 0
        } otherwise {
          hold fc = sxsource_get(source_words, pos)
          when fc == 123 {
            hold pos = pos + 1
            hold fvrun2 = 0
          } otherwise {
            when fc == 10 || fc == 13 {
              hold fvrun2 = 0
              hold ferr = 1
              hold fmsg = "for loop: expected `{` at the end of the for line"
            } otherwise {
              hold fvb = concat(fvb, chr(fc))
              hold pos = pos + 1
            }
          }
        }
      }
      // trim both range expressions (range mode; list mode trims A below)
      hold fl = len(fva)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fva, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fva2 = ""
      hold fi = 0
      while fi < fl {
        hold fva2 = concat(fva2, chr(sx_index(fva, fi)))
        hold fi = fi + 1
      }
      hold fva = fva2
      hold fl = len(fvb)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fvb, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fvb2 = ""
      hold fi = 0
      while fi < fl {
        hold fvb2 = concat(fvb2, chr(sx_index(fvb, fi)))
        hold fi = fi + 1
      }
      hold fvb = fvb2
      when fvmode == 1 {
        hold fvb = "1"
      }
      when sx_eq(fva, "") || sx_eq(fvb, "") {
        when ferr == 0 {
          hold ferr = 1
          hold fmsg = "for loop: the range is empty; write `for i in 0..10 {`"
        }
      }
      // `(0..3)`: the header scan stopped at the dots INSIDE the parens, so
      // the start text has an unclosed '('. A balanced parenthesised bound
      // such as `(lo + 1)..(hi * 2)` is a range and stays supported.
      when fvmode == 0 && ferr == 0 && len(fva) > 0 && sx_index(fva, 0) == 40 {
        hold fvubal = 0
        hold fvui2 = 0
        while fvui2 < len(fva) {
          when sx_index(fva, fvui2) == 40 {
            hold fvubal = fvubal + 1
          }
          when sx_index(fva, fvui2) == 41 {
            hold fvubal = fvubal - 1
          }
          hold fvui2 = fvui2 + 1
        }
        when fvubal > 0 {
          hold ferr = 1
          hold fmsg = "for loop: a parenthesised range is not a collection; write `for i in 0..N {`, or put a list/string inside the parens"
        }
      }
      // validate: only characters that are safe C text for a numeric range
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fva)
      hold fvbrk = 0
      while fvi < fvln {
        hold fc = sx_index(fva, fvi)
        when fc == 91 {
          hold fvbrk = fvbrk + 1
        }
        when fc == 93 {
          hold fvbrk = fvbrk - 1
        }
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 || (fc == 37 && fvbrk > 0) {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 && fvspl == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the start expression may use numbers, names, fields, indexes and + - * / ( ) only (% only inside an index)"
      }
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fvb)
      hold fvbrk = 0
      while fvi < fvln {
        hold fc = sx_index(fvb, fvi)
        when fc == 91 {
          hold fvbrk = fvbrk + 1
        }
        when fc == 93 {
          hold fvbrk = fvbrk - 1
        }
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 || (fc == 37 && fvbrk > 0) {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 && fvspl == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the end expression may use numbers, names, fields, indexes and + - * / ( ) only (% only inside an index)"
      }
      // list mode: the iterated expression must be a list variable
      when fvmode == 1 && ferr == 0 {
        hold fvlkey = concat("|", fva)
        hold fvlkey = concat(fvlkey, "|")
        hold fvlkl = len(fvlkey)
        hold fvll = len(ldecls)
        hold fvli2 = 0
        hold fvlf = 0
        while fvli2 + fvlkl <= fvll {
          hold fvlok = 1
          hold fvlj = 0
          while fvlj < fvlkl {
            hold fvla = sx_index(ldecls, fvli2 + fvlj)
            hold fvlb = sx_index(fvlkey, fvlj)
            when fvla == fvlb {
              hold fvlj = fvlj + 1
            } otherwise {
              hold fvlok = 0
              hold fvlj = fvlkl
            }
          }
          when fvlok == 1 {
            hold fvlf = 1
            hold fvli2 = fvll
          } otherwise {
            hold fvli2 = fvli2 + 1
          }
        }
        // not a list: a declared string is walked byte by byte
        when fvlf == 0 {
          hold fvsf = 0
          hold fvsl = concat(concat("|", fva), "|")
          hold fvsl2 = len(fvsl)
          hold fvss = len(sdecls)
          hold fvsi2 = 0
          while fvsi2 + fvsl2 <= fvss {
            hold fvsok = 1
            hold fvsj = 0
            while fvsj < fvsl2 {
              hold fvsa = sx_index(sdecls, fvsi2 + fvsj)
              hold fvsb = sx_index(fvsl, fvsj)
              when fvsa == fvsb {
                hold fvsj = fvsj + 1
              } otherwise {
                hold fvsok = 0
                hold fvsj = fvsl2
              }
            }
            when fvsok == 1 {
              hold fvsf = 1
              hold fvsi2 = fvss
            } otherwise {
              hold fvsi2 = fvsi2 + 1
            }
          }
          when fvsf == 1 {
            hold fvstr = 1
          } otherwise {
            hold ferr = 1
            // a hidden `__sx_fv..` name was introduced for `for V in EXPR {`:
            // describe the form instead of naming the generated variable
            hold fvhid = 1
            hold fvhl = len(fva)
            when fvhl < 7 {
              hold fvhid = 0
            }
            when fvhid == 1 {
              hold fvhh = "__sx_fv"
              hold fvhi = 0
              while fvhi < 7 {
                when sx_index(fva, fvhi) == sx_index(fvhh, fvhi) {
                  hold fvhi = fvhi + 1
                } otherwise {
                  hold fvhid = 0
                  hold fvhi = 7
                }
              }
            }
            when fvhid == 1 {
              hold fmsg = "for loop: the expression after `in` is not a list or a string; write `for i in 0..N {` to count"
            } otherwise {
              hold fmsg = concat("for loop: '", fva)
              hold fmsg = concat(fmsg, "' is not a list or a string; write `for i in 0..N {` to count")
            }
          }
        }
      }
      // the counter must not already be a string or list
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = sdecls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            // a string loop may rebind a name that is already a string
            when fvstr == 1 {
              hold fvdup = 1
            } otherwise {
              hold ferr = 1
            }
            hold fvli = fvi
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
        when ferr == 1 {
          hold fmsg = concat("for loop: '", fvname)
          hold fmsg = concat(fmsg, "' is already a string or list; pick another counter name")
        }
      }
      // A list counter cannot be rebound as either a list or a string loop
      // binder.  Lists live in ldecls (not necessarily decls), so check their
      // distinct kind table explicitly instead of letting a later `show c`
      // fail as a pointer-to-double expression.
      when ferr == 0 && sx_eq(sxelookup(ldecls, fvname, "|"), "yes") == 1 {
        hold ferr = 1
        hold fmsg = concat("for loop: '", fvname)
        // Keep the long-standing string-loop diagnostic stable: a preexisting
        // list counter is just as incompatible as a number counter.
        hold fmsg = concat(fmsg, "' is already a number or a list; a string loop needs a new counter name")
      }
      // is the counter already declared as a number?
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = decls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        hold fvok = 1
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            hold fvok = 0
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
        // a string loop declares a new `char *` counter; a number of that name is an error
        when fvstr == 1 && fvok == 0 && (seed_profile == 0 || fvdup == 0) {
          hold ferr = 1
          hold fmsg = concat("for loop: '", fvname)
          hold fmsg = concat(fmsg, "' is already a number or a list; a string loop needs a new counter name")
        }
      }
      when fvspl == 1 {
        hold pos = fvstart
      } otherwise {
        when ferr == 1 {
          hold nerrscop = 1
          when sx_eq(scopmsg, "") {
            hold scopmsg = fmsg
          }
        } otherwise {
          hold ind = "  "
          hold wk = 0
          while wk < depth {
            hold ind = concat(ind, "  ")
            hold wk = wk + 1
          }
          when fvok == 1 && fvstr == 1 && fvdup == 0 {
            // for c in s { ... }: the counter is a string, assigned per byte below
            hold body = concat(body, ind)
            hold body = concat(body, "char *")
            hold body = concat(body, fvname)
            hold body = concat(body, " = \"\";")
            hold body = concat(body, nl)
            hold sdecls = concat(sdecls, fvname)
            hold sdecls = concat(sdecls, "|")
          }
          when fvok == 1 && fvstr == 0 {
            hold body = concat(body, ind)
            hold body = concat(body, "double ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            when fvmode == 1 {
              hold body = concat(body, "0.0")
            } otherwise {
              hold body = concat(body, fva)
            }
            hold body = concat(body, ";")
            hold body = concat(body, nl)
            hold decls = concat(decls, fvname)
            hold decls = concat(decls, "|")
          }
          when fvmode == 1 {
            when fvstr == 1 {
            // for c in s { ... }  ->  byte walk over the string: c is the one-byte
            // string at index __sx_ix (sx_idx is the byte, sx_chr makes a 1-char string)
            hold rt = 1
            hold fvix = "__sx_ix"
            hold body = concat(body, ind)
            hold body = concat(body, "for (double ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = 0.0; ")
            hold body = concat(body, fvix)
            hold body = concat(body, " < sx_len(")
            hold body = concat(body, fva)
            hold body = concat(body, "); ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = ")
            hold body = concat(body, fvix)
            hold body = concat(body, " + 1.0) {")
            hold body = concat(body, nl)
            hold body = concat(body, ind)
            hold body = concat(body, "  ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = sx_chr(sx_idx(")
            hold body = concat(body, fva)
            hold body = concat(body, ", ")
            hold body = concat(body, fvix)
            hold body = concat(body, "));")
            hold body = concat(body, nl)
            } otherwise {
            // for v in xs { ... }  ->  index walk over the list
            // the walk index lives in the for-init, so C scoping gives every
            // nested list loop its own copy
            hold fvix = "__sx_ix"
            hold body = concat(body, ind)
            hold body = concat(body, "for (double ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = 0.0; ")
            hold body = concat(body, fvix)
            hold body = concat(body, " < sx_llen(")
            hold body = concat(body, fva)
            hold body = concat(body, "); ")
            hold body = concat(body, fvix)
            hold body = concat(body, " = ")
            hold body = concat(body, fvix)
            hold body = concat(body, " + 1.0) {")
            hold body = concat(body, nl)
            hold lt = 1
            hold body = concat(body, ind)
            hold body = concat(body, "  ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = sx_lget(")
            hold body = concat(body, fva)
            hold body = concat(body, ", ")
            hold body = concat(body, fvix)
            hold body = concat(body, ");")
            hold body = concat(body, nl)
            }
          } otherwise {
            // The bound B may call len(NAME), the same builtin a `when`
            // condition accepts: map it to sx_llen for a declared list and to
            hold fvbc = ""
            hold fvbn = len(fvb)
            hold fvbi = 0
            while fvbi < fvbn {
              hold fvbhit = 0
              when fvbi + 3 < fvbn && sx_index(fvb, fvbi) == 108 && sx_index(fvb, fvbi + 1) == 101 && sx_index(fvb, fvbi + 2) == 110 && sx_index(fvb, fvbi + 3) == 40 {
                hold fvbhit = 1
                when fvbi > 0 {
                  hold fvbpc = sx_index(fvb, fvbi - 1)
                  when (fvbpc >= 97 && fvbpc <= 122) || (fvbpc >= 65 && fvbpc <= 90) || (fvbpc >= 48 && fvbpc <= 57) || fvbpc == 95 {
                    hold fvbhit = 0
                  }
                }
              }
              when fvbhit == 1 {
                // NAME is the text up to the closing ')' (identifiers only)
                hold fvbnm = ""
                hold fvbj = fvbi + 4
                while fvbj < fvbn && sx_index(fvb, fvbj) != 41 {
                  hold fvbnm = concat(fvbnm, chr(sx_index(fvb, fvbj)))
                  hold fvbj = fvbj + 1
                }
                hold fvbkey = concat(concat("|", fvbnm), "|")
                hold fvbkl = len(fvbkey)
                hold fvbll = len(ldecls)
                hold fvblf = 0
                hold fvbli = 0
                while fvbli + fvbkl <= fvbll {
                  hold fvbok = 1
                  hold fvblj = 0
                  while fvblj < fvbkl {
                    when sx_index(ldecls, fvbli + fvblj) == sx_index(fvbkey, fvblj) {
                      hold fvblj = fvblj + 1
                    } otherwise {
                      hold fvbok = 0
                      hold fvblj = fvbkl
                    }
                  }
                  when fvbok == 1 {
                    hold fvblf = 1
                    hold fvbli = fvbll
                  } otherwise {
                    hold fvbli = fvbli + 1
                  }
                }
                when fvblf == 1 {
                  hold fvbc = concat(fvbc, "sx_llen(")
                } otherwise {
                  hold fvbc = concat(fvbc, "sx_len(")
                }
                hold fvbc = concat(fvbc, fvbnm)
                hold fvbc = concat(fvbc, ")")
                when fvbj < fvbn {
                  hold fvbi = fvbj + 1
                } otherwise {
                  hold fvbi = fvbn
                }
              } otherwise {
                // An indexed list or string may also appear in a BOUND:
                // `for k in 0..xs[1]` used to be copied verbatim, so the
                hold fvbidone = 0
                hold fvbich = sx_index(fvb, fvbi)
                when (fvbich >= 97 && fvbich <= 122) || (fvbich >= 65 && fvbich <= 90) || fvbich == 95 {
                  hold fvbinm = ""
                  hold fvbii = fvbi
                  hold fvbir = 1
                  while fvbir == 1 {
                    when fvbii >= fvbn {
                      hold fvbir = 0
                    } otherwise {
                      hold fvbic = sx_index(fvb, fvbii)
                      when (fvbic >= 97 && fvbic <= 122) || (fvbic >= 65 && fvbic <= 90) || (fvbic >= 48 && fvbic <= 57) || fvbic == 95 {
                        hold fvbinm = concat(fvbinm, chr(fvbic))
                        hold fvbii = fvbii + 1
                      } otherwise {
                        hold fvbir = 0
                      }
                    }
                  }
                  hold fvbis = 1
                  while fvbis == 1 {
                    when fvbii >= fvbn {
                      hold fvbis = 0
                    } otherwise {
                      hold fvbic = sx_index(fvb, fvbii)
                      when fvbic == 32 || fvbic == 9 {
                        hold fvbii = fvbii + 1
                      } otherwise {
                        hold fvbis = 0
                      }
                    }
                  }
                  hold fvbibrk = 0
                  when fvbii < fvbn {
                    hold fvbic = sx_index(fvb, fvbii)
                    when fvbic == 91 {
                      hold fvbibrk = 1
                    }
                  }
                  when fvbibrk == 1 {
                    hold fvbkey2 = concat(concat("|", fvbinm), "|")
                    hold fvbkl2 = len(fvbkey2)
                    hold fvblf2 = 0
                    hold fvbli2 = 0
                    hold fvbll2 = len(ldecls)
                    while fvbli2 + fvbkl2 <= fvbll2 {
                      hold fvbok2 = 1
                      hold fvblj2 = 0
                      while fvblj2 < fvbkl2 {
                        when sx_index(ldecls, fvbli2 + fvblj2) == sx_index(fvbkey2, fvblj2) {
                          hold fvblj2 = fvblj2 + 1
                        } otherwise {
                          hold fvbok2 = 0
                          hold fvblj2 = fvbkl2
                        }
                      }
                      when fvbok2 == 1 {
                        hold fvblf2 = 1
                        hold fvbli2 = fvbll2
                      } otherwise {
                        hold fvbli2 = fvbli2 + 1
                      }
                    }
                    hold fvbstr2 = 0
                    hold fvbsi2 = 0
                    hold fvbsl2 = len(sdecls)
                    while fvbsi2 + fvbkl2 <= fvbsl2 {
                      hold fvbsok = 1
                      hold fvbsj = 0
                      while fvbsj < fvbkl2 {
                        when sx_index(sdecls, fvbsi2 + fvbsj) == sx_index(fvbkey2, fvbsj) {
                          hold fvbsj = fvbsj + 1
                        } otherwise {
                          hold fvbsok = 0
                          hold fvbsj = fvbkl2
                        }
                      }
                      when fvbsok == 1 {
                        hold fvbstr2 = 1
                        hold fvbsi2 = fvbsl2
                      } otherwise {
                        hold fvbsi2 = fvbsi2 + 1
                      }
                    }
                    when fvblf2 == 1 || fvbstr2 == 1 {
                      hold fvbixt = ""
                      hold fvbij2 = fvbii + 1
                      hold fvbiok = 1
                      hold fvbir2 = 1
                      hold fvbdep = 0
                      while fvbir2 == 1 {
                        when fvbij2 >= fvbn {
                          hold fvbir2 = 0
                          hold fvbiok = 0
                        } otherwise {
                          hold fvbic2 = sx_index(fvb, fvbij2)
                          when fvbic2 == 93 && fvbdep == 0 {
                            hold fvbir2 = 0
                          } otherwise {
                            // a nested index is copied with its brackets and
                            // idx_lower below decides what is lowerable
                            when fvbic2 == 91 {
                              hold fvbdep = fvbdep + 1
                            }
                            when fvbic2 == 93 {
                              hold fvbdep = fvbdep - 1
                            }
                            hold fvbixt = concat(fvbixt, chr(fvbic2))
                            hold fvbij2 = fvbij2 + 1
                          }
                        }
                      }
                      when fvbiok == 1 {
                        // len(NAME) and NAME[IDX] lower in a for bound exactly
                        // as they do in a value position
                        hold fvbxl = idx_lower(fvbixt, ldecls, sdecls, fsret, fspk)
                        when len(fvbxl) == 0 {
                          hold fvbiok = 0
                        } otherwise {
                          when len(fvbxl) != len(fvbixt) {
                            hold rt = 1
                          }
                          hold fvbixt = fvbxl
                        }
                      }
                      when fvbiok == 0 {
                        when perr == 0 {
                          hold permsg = concat("an index in a for bound must be a numeric expression over numbers, names, fields, len(), indexes and + - * /; '", fvbinm)
                          hold permsg = concat(permsg, "' is indexed with something else (bind it with hold first)")
                        }
                        hold perr = 1
                      } otherwise {
                        when fvblf2 == 1 {
                          hold fvbc = concat(fvbc, "sx_lget(")
                          hold lt = 1
                        } otherwise {
                          hold fvbc = concat(fvbc, "sx_idx(")
                          hold rt = 1
                        }
                        hold fvbc = concat(fvbc, fvbinm)
                        hold fvbc = concat(fvbc, ",")
                        hold fvbc = concat(fvbc, fvbixt)
                        hold fvbc = concat(fvbc, ")")
                        hold fvbi = fvbij2 + 1
                        hold fvbidone = 1
                      }
                    }
                  }
                }
                when fvbidone == 0 {
                  hold fvbc = concat(fvbc, chr(sx_index(fvb, fvbi)))
                  hold fvbi = fvbi + 1
                }
              }
            }
            hold body = concat(body, ind)
            hold body = concat(body, "for (")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            hold body = concat(body, fva)
            hold body = concat(body, "; ")
            hold body = concat(body, fvname)
            hold body = concat(body, " < ")
            hold body = concat(body, fvbc)
            hold body = concat(body, "; ")
            hold body = concat(body, fvname)
            hold body = concat(body, " = ")
            hold body = concat(body, fvname)
            hold body = concat(body, " + 1) {")
            hold body = concat(body, nl)
          }
      // Snapshot after any binder declaration, before parsing this body.
      when in_fn == 1 {
        push(scope_marks, scope_head)
        push(scope_marks, len(decls))
        push(scope_marks, len(sdecls))
        push(scope_marks, len(ldecls))
        push(scope_marks, len(svars))
        hold scope_head = len(scope_marks) - 5
      }
          hold depth = depth + 1
          hold blk = concat(blk, "f")
          hold loopd = loopd + 1
        }
      }
    }

    // ================= make NAME<T> ... { } (generic: skip, act 15) =====
    // A generic definition is not compiled here; the pre-pass stored its
    // body, and it is monomorphised on demand (see gwant below).
    when act == 15 {
      // skip from the current position up to the matching `}` of the header
      hold pos = pos + 4
      hold gdep = 0
      hold gq = 0
      hold grun = 1
      while grun == 1 {
        when pos >= n {
          hold grun = 0
        } otherwise {
          hold gc = sxsource_get(source_words, pos)
          when gq == 1 {
            hold pos = pos + 1
            when gc == 92 {
              when pos < n {
                hold pos = pos + 1
              }
            } otherwise {
              when gc == 34 {
                hold gq = 0
              }
            }
          } otherwise {
            when gc == 34 {
              hold gq = 1
              hold pos = pos + 1
            } otherwise {
              when gc == 123 {
                hold gdep = gdep + 1
              }
              when gc == 125 {
                hold gdep = gdep - 1
              }
              hold pos = pos + 1
              when gdep == 0 && gc == 125 {
                hold grun = 0
              }
            }
          }
        }
      }
      // the body of a generic is only kept when every parameter and the
      // return type name one of its type parameters
      hold gskipok = 0
      hold gskipk = concat(chr(1), gskipnm)
      hold gskipk = concat(gskipk, chr(1))
      hold gskipkl = len(gskipk)
      hold gskipl = len(fgnames)
      hold gskipi = 0
      while gskipi + gskipkl <= gskipl {
        hold gskipm = 1
        hold gskipj = 0
        while gskipj < gskipkl {
          hold gskipa = sx_index(fgnames, gskipi + gskipj)
          hold gskipb = sx_index(gskipk, gskipj)
          when gskipa == gskipb {
            hold gskipj = gskipj + 1
          } otherwise {
            hold gskipm = 0
            hold gskipj = gskipkl
          }
        }
        when gskipm == 1 {
          hold gskipok = 1
          hold gskipi = gskipl
        } otherwise {
          hold gskipi = gskipi + 1
        }
      }
      when gskipok == 0 {
        when perr == 0 {
          hold permsg = concat("generic '", gskipnm)
          hold permsg = concat(permsg, "' must be written with type parameters used by every parameter and the return type, as in `make ")
          hold permsg = concat(permsg, gskipnm)
          hold permsg = concat(permsg, "<T>(a: T, b: T) -> T` or `make ")
          hold permsg = concat(permsg, gskipnm)
          hold permsg = concat(permsg, "<A, B>(a: A, b: B) -> A`")
        }
        hold perr = 1
      }
    }

    // ================= break / continue =================
    when act == 11 || act == 12 {
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when loopd == 0 {
        hold nerrscop = 1
        when sx_eq(scopmsg, "") {
          hold scopmsg = "break/continue outside a loop"
        }
      } otherwise {
        hold body = concat(body, ind)
        when act == 11 {
          hold body = concat(body, "break;")
        } otherwise {
          hold body = concat(body, "continue;")
        }
        hold body = concat(body, nl)
      }
    }

    // not a statement character: skip it


    // ================= struct Name { fields } =================
    when act == 7 {
      hold pos = pos + 6
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold stname = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sxsource_get(source_words,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold stname = concat(stname, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // A template declaration: gxscan recorded it and gxpass already
      // registered one concrete struct per instantiation, so the walker only
      gxtpl = 0
      when pos < n {
        when sxsource_get(source_words,pos) == 60 {
          when len(sxelookup(gsdefs, stname, ":")) > 0 {
            gxtpl = 1
            hold gxq = pos + 1
            while gxq < n && sxsource_get(source_words,gxq) != 62 {
              hold gxq = gxq + 1
            }
            hold pos = sxflowspace(source, gxq + 1)
          } otherwise {
            hold exerr = concat(exerr, "#error sayanox-min: a struct type parameter list is not num, str or list at every use")
            hold exerr = concat(exerr, nl)
            show "min: a struct type argument must be num, str or list, and every instantiation must be spelled the same way (docs/TYPES_ROADMAP.md)"
          }
        }
      }
      when pos < n {
        hold cs = sxsource_get(source_words,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold sfields = ""
      hold firstp = 1
      hold tdskip = 1
      hold rn = 1
      while rn == 1 {
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cs = sxsource_get(source_words,pos)
          when cs == 125 {
            hold pos = pos + 1
            hold rn = 0
          } otherwise {
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) {
              hold sf = ""
              hold rn2 = 1
              while rn2 == 1 {
                when pos >= n {
                  hold rn2 = 0
                } otherwise {
                  hold cn = sxsource_get(source_words,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold sf = concat(sf, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn2 = 0
                  }
                }
              }
              // A `name: Type` field is an annotation, and no backend checks
              // a field's type: refuse it instead of registering the type
              // name as another field (which silently changed the arity).
              hold sk2 = pos
              while sk2 < n && (sxsource_get(source_words,sk2) == 32 || sxsource_get(source_words,sk2) == 9) {
                hold sk2 = sk2 + 1
              }
              when sk2 < n {
                when sxsource_get(source_words,sk2) == 58 {
                  // `k: 2` (a literal after the colon) is the tolerated old
                  // spelling and keeps working; `p: Pt` (a NAME after the
                  // colon) reads as a type annotation, which no backend
                  // checks -- it used to register Pt as an extra field.
                  hold sk3 = sk2 + 1
                  while sk3 < n && (sxsource_get(source_words,sk3) == 32 || sxsource_get(source_words,sk3) == 9) {
                    hold sk3 = sk3 + 1
                  }
                  when sk3 < n {
                    hold cc3 = sxsource_get(source_words,sk3)
                    when (cc3 >= 97 && cc3 <= 122) || (cc3 >= 65 && cc3 <= 90) || cc3 == 95 {
                      hold exerr = concat(exerr, "#error sayanox-min: struct field annotations are not supported")
                      hold exerr = concat(exerr, nl)
                      show "min: struct field annotations are not supported: write just the field name (docs/TYPES_ROADMAP.md)"
                      hold rn = 0
                    }
                  }
                }
              }
              when firstp == 0 {
                hold sfields = concat(sfields, ",")
              }
              hold sfields = concat(sfields, sf)
              hold firstp = 0
              hold sfields2 = concat(sfields2, sf)
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      when gxtpl == 0 {
        hold sdefs = concat(sdefs, stname)
        hold sdefs = concat(sdefs, ":")
        hold sdefs = concat(sdefs, sfields)
        hold sdefs = concat(sdefs, ";")
      }
    }

    // not the start of any statement: a stray character left over after a
    // statement (`hold x = 2.`, `show a b`) is a clear error, never skipped
    when act == 0 {
      when c != 47 {
        when perr == 0 {
          hold permsg = concat("unexpected '", chr(c))
          hold permsg = concat(permsg, "' (expected the end of the statement or a new statement)")
        }
        hold perr = 1
      }
      hold pos = pos + 1
    }

    // Lower only the newly emitted statement while lexical kind tables live.
    // This keeps allocations inside expressions, including loop conditions.
    when (act == 1 || act == 2 || act == 3 || act == 6 || act == 8) && fully_checked_value == 0 {
      hold inpos = instart
      hold inquote = 0
      hold inprev = 0
      hold intext = ""
      hold inchanged = 0
      hold inenv = ""
      hold instop = len(body)
      hold inserialstart = len(instate)
      hold inprobe = instart
      hold inprobequote = 0
      hold inhasbracket = 0
      while inprobe < instop {
        hold inpc = sx_index(body, inprobe)
        hold inprobe = inprobe + 1
        when inprobequote == 1 {
          when inpc == 92 && inprobe < instop {
            hold inprobe = inprobe + 1
          } otherwise {
            when inpc == 34 {
              hold inprobequote = 0
            }
          }
        } otherwise {
          when inpc == 34 {
            hold inprobequote = 1
          }
          when inpc == 91 {
            hold inhasbracket = 1
          }
        }
      }
      when inhasbracket == 1 || fsstructactive == 1 || interpactive == 1 {
            when len(inenv) == 0 {
              when inready == 0 {
                while sxecontains(source, inprivate) == 1 {
                  hold inprivate = concat(inprivate, "x")
                }
                hold inready = 1
                hold fsret = concat(fsret, inprivate)
                hold fsret = concat(fsret, "list=l|")
              }
              hold inenv = concat(decls, chr(1))
              hold inenv = concat(inenv, sdecls)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, ldecls)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, svars)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, fsret)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, fspk)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, inprivate)
              hold inenv = concat(inenv, chr(1))
              hold inenv = concat(inenv, ftypes)
            }
        hold incallnames = concat(fsret, "|sx_cat=s|sx_len=n|sx_idx=n|sx_lget=n|sx_llen=n|sx_lpush=l|sx_chr=s|sx_numstr=s|sx_eq=n|sx_mod=n|sx_arg=s|sx_argc=n|sx_read=s|sx_write=n|sx_read_line=s|sx_read_n=s|sx_write_out=n|sx_flush_out=n|sx_gc_run=n|sx_gc_live=n|sx_gc_count=n|sx_exit=n|sx_http=s|sx_read_dir=s|sx_path_kind=n|sx_path_size=n|sx_path_real=s|sx_run_command=n|sx_getenv=s|sx_spawn=n|sx_child_send=n|sx_child_recv=s|sx_child_line=s|sx_child_close=n|sx_make_dir=n|sx_make_link=n|sx_remove_path=n|sx_write_bytes=n|sx_bytes_f64=l|sx_read_bytes=n|sx_bit_and=n|sx_bit_or=n|sx_bit_xor=n|sx_bit_not=n|sx_shl=n|sx_shr=n|")
      while inpos < instop {
        hold inc = sx_index(body, inpos)
        when inquote == 1 {
          hold intext = concat(intext, chr(inc))
          hold inpos = inpos + 1
          when inc == 92 && inpos < instop {
            hold intext = concat(intext, chr(sx_index(body, inpos)))
            hold inpos = inpos + 1
          } otherwise {
            when inc == 34 {
              hold inquote = 0
            }
          }
        } otherwise {
          when (inc >= 65 && inc <= 90) || (inc >= 97 && inc <= 122) || inc == 95 {
            hold inword = sxflowword(body, inpos)
            hold innext = sxflowspace(body, inpos + len(inword))
            hold incandidate = 0
            when innext < instop && sx_index(body, innext) == 40 {
              hold inreturn = sxelookup(incallnames, inword, "=")
              when len(inreturn) > 0 && (sxehaslist(body, innext) == 1 || fsstructactive == 1 || interpactive == 1) {
                hold incandidate = 1
              }
            }
            when len(sxelookup(svars, inword, "=")) > 0 && innext < instop && sx_index(body, innext) == 46 {
              hold incandidate = 1
            }
            when incandidate == 1 {
              hold incall = sxeparse(body, inpos, inenv, 0, 0, instate)
              when string_eq(sxesegment(incall, 1), "e") {
                when perr == 0 {
                  hold permsg = concat("inline list arguments: ", sxecode(incall))
                }
                hold perr = 1
                hold intext = concat(intext, inword)
                hold inpos = inpos + len(inword)
              } otherwise {
                hold intext = concat(intext, sxecode(incall))
                hold inpos = sxepos(incall)
                hold inchanged = 1
              }
            } otherwise {
              hold intext = concat(intext, inword)
              hold inpos = inpos + len(inword)
            }
            hold inprev = 65
          } otherwise {
          when inc == 91 && (inprev == 40 || inprev == 44) {
            hold inresult = sxeparse(body, inpos, inenv, 0, 0, instate)
            hold inkind = sxesegment(inresult, 1)
            hold inend = sxepos(inresult)
            hold inafter = sxflowspace(body, inend)
            hold inbad = 0
            when string_eq(inkind, "l") == 0 {
              hold inbad = 1
            }
            when inafter >= instop {
              hold inbad = 1
            } otherwise {
              hold inchar = sx_index(body, inafter)
              when inchar != 44 && inchar != 41 {
                hold inbad = 1
              }
            }
            when inbad == 1 {
              when perr == 0 {
                hold permsg = "inline list arguments: unsupported list expression"
                when string_eq(inkind, "e") {
                  hold permsg = concat("inline list arguments: ", sxecode(inresult))
                }
              }
              hold perr = 1
              hold intext = concat(intext, "[]")
              hold inpos = inpos + 1
            } otherwise {
              hold intext = concat(intext, sxecode(inresult))
              hold inpos = inend
              hold inchanged = 1
            }
            hold inprev = 41
          } otherwise {
            hold intext = concat(intext, chr(inc))
            hold inpos = inpos + 1
            when inc == 34 {
              hold inquote = 1
            }
            when inc != 32 && inc != 9 && inc != 10 && inc != 13 {
              hold inprev = inc
            }
          }
        }
      }
        }
      when inchanged == 1 {
        // Checked inline elements may introduce string/list builtins even
        // when there are no ordinary string or list declarations in source.
        hold rt = 1
        hold lt = 1
        hold inprefix = sxeslice(body, 0, instart)
        hold inserialend = len(instate)
        while inserialstart < inserialend {
          hold inprefix = concat(inprefix, "  double ")
          hold inprefix = concat(inprefix, inprivate)
          hold inprefix = concat(inprefix, sxedigits(inserialstart))
          hold inprefix = concat(inprefix, ";")
          hold inprefix = concat(inprefix, nl)
          hold inserialstart = inserialstart + 1
        }
        hold body = concat(inprefix, intext)
      }
      }
    }

    // ---- flush completed output into obody (memory bound) -------------
    // A flat accumulator would copy the whole body on every append, which is
    when in_fn == 0 {
      hold blen = len(body)
      when blen > 1024 {
        hold obody = concat(obody, body)
        hold body = ""
      }
    }
  }
}

// =====================================================================
// emit the C translation unit
// =====================================================================
hold out = ""
when rt == 1 {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <string.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n#include <setjmp.h>\n")
  hold out = concat(out, "typedef struct sx_list { double *d; long n; long cap; } sx_list;\ntypedef struct sx_gcb {\n  struct sx_gcb *next;      /* every live block, for the sweep */\n  size_t cls;               /* size class: the free list it goes back to */\n  size_t kind;              /* 0 raw bytes, 1 sx_list, 2 double array */\n  size_t mark;\n} sx_gcb;\n#define SX_GCH ((size_t)32)\n#define SX_NCLS 26\nstatic sx_gcb *sx_gcall = 0;\nstatic sx_gcb *sx_gfree[SX_NCLS];\nstatic char **sx_ghash = 0;               /* payload address -> block */\nstatic sx_gcb **sx_gblk = 0;\nstatic sx_gcb **sx_gsort = 0;             /* blocks by address, for interiors */\nstatic size_t sx_ghcap = 0, sx_ghlive = 0, sx_gsort_n = 0;\nstatic char *sx_stack_bot = 0;\nstatic double sx_gc_n = 0, sx_gc_freed = 0, sx_gc_thresh = 0, sx_gc_bytes = 0;\n\nstatic size_t sx_gc_class_size(size_t c){ return (size_t)32 << c; }\nstatic size_t sx_gc_cls(size_t need){\n")
  hold out = concat(out, "  size_t c = 0, sz = 32;\n  while (sz < need && c + 1 < SX_NCLS){ sz <<= 1; c += 1; }\n  return c;\n}\n\nstatic void sx_gc_rehash(size_t cap){\n  char **nh;\n  sx_gcb **nb;\n  sx_gcb *b;\n  if (cap < 4096) cap = 4096;\n  while (cap < (sx_ghlive + 1) * 4) cap <<= 1;\n  nh = (char**)calloc(cap, sizeof(char*));\n  nb = (sx_gcb**)calloc(cap, sizeof(sx_gcb*));\n  if (!nh || !nb) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  b = sx_gcall;\n  while (b){\n    char *pay = (char*)b + SX_GCH;\n    size_t h = ((size_t)pay >> 4) & (cap - 1);\n    while (nh[h]) h = (h + 1) & (cap - 1);\n    nh[h] = pay; nb[h] = b;\n    b = b->next;\n  }\n  free(sx_ghash); free(sx_gblk);\n  sx_ghash = nh; sx_gblk = nb; sx_ghcap = cap;\n}\n\nstatic void sx_gc_hash_put(char *pay, sx_gcb *b){\n  size_t h;\n  if (!sx_ghcap) sx_gc_rehash(1u << 12);\n  if ((sx_ghlive + 1) * 4 > sx_ghcap){ sx_gc_rehash(sx_ghcap * 2); return; }\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n")
  hold out = concat(out, "  while (sx_ghash[h]) h = (h + 1) & (sx_ghcap - 1);\n  sx_ghash[h] = pay; sx_gblk[h] = b;\n}\n\nstatic sx_gcb *sx_gc_hash_get(char *pay){\n  size_t h;\n  if (!sx_ghcap) return 0;\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n  while (sx_ghash[h] && sx_ghash[h] != pay) h = (h + 1) & (sx_ghcap - 1);\n  return sx_ghash[h] ? sx_gblk[h] : 0;\n}\n\nstatic int sx_gc_cmp(const void *a, const void *b){\n  char *pa = (char*)(*(sx_gcb* const*)a) + SX_GCH;\n  char *pb = (char*)(*(sx_gcb* const*)b) + SX_GCH;\n  return pa < pb ? -1 : (pa > pb ? 1 : 0);\n}\nstatic void sx_gc_sorted(void){\n  size_t i = 0;\n  sx_gcb *b = sx_gcall;\n  if (sx_gsort_n != sx_ghlive){\n    free(sx_gsort);\n    sx_gsort = (sx_gcb**)malloc((sx_ghlive + 1) * sizeof(sx_gcb*));\n    if (!sx_gsort) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  }\n  while (b && i < sx_ghlive){ sx_gsort[i] = b; i += 1; b = b->next; }\n  sx_gsort_n = i;\n  qsort(sx_gsort, i, sizeof(sx_gcb*), sx_gc_cmp);\n}\n")
  hold out = concat(out, "static sx_gcb *sx_gc_containing(char *p){\n  size_t lo = 0, hi = sx_gsort_n;\n  while (lo < hi){\n    size_t mid = (lo + hi) / 2;\n    char *pay = (char*)sx_gsort[mid] + SX_GCH;\n    size_t sz = sx_gc_class_size(sx_gsort[mid]->cls);\n    if (p < pay) hi = mid;\n    else if (p >= pay + sz) lo = mid + 1;\n    else return sx_gsort[mid];\n  }\n  return 0;\n}\n\nstatic void sx_gc_mark(void *p){\n  sx_gcb *b;\n  if (!p) return;\n  b = sx_gc_hash_get((char*)p);\n  if (!b) b = sx_gc_containing((char*)p);\n  if (!b || b->mark) return;\n  b->mark = 1;\n  if (b->kind == 1){\n    sx_list *L = (sx_list*)((char*)b + SX_GCH);\n    if (L->d) sx_gc_mark((char*)L->d);\n  }\n}\n\n#ifndef __has_feature\n#define __has_feature(x) 0\n#endif\n#if defined(__SANITIZE_ADDRESS__) || __has_feature(address_sanitizer)\n#include <sanitizer/asan_interface.h>\n#define SX_GC_WORD_OK(p) (!__asan_region_is_poisoned((p), sizeof(void*)))\n#else\n#define SX_GC_WORD_OK(p) 1\n#endif\n/* Conservative stack traversal skips ASan redzones; all actual loads remain instrumented. */\nstatic void sx_gc_scan(char *lo, char *hi){\n  lo = (char*)(((size_t)lo + 7u) & ~(size_t)7u);\n  while (lo + 8 <= hi){\n    if (SX_GC_WORD_OK(lo)) sx_gc_mark(*(char**)lo);\n    lo += 8;\n  }\n}\n\nstatic void sx_gc_init(void *anchor){\n  sx_stack_bot = (char*)anchor;\n")
  hold out = concat(out, "  if (!sx_gc_thresh) sx_gc_thresh = (double)(8u << 20);\n}\n\nstatic void sx_gc_collect(void){\n  double before = sx_gc_bytes;\n  sx_gcb **pp;\n  if (!sx_gcall || !sx_stack_bot) return;\n  sx_gc_sorted();\n  {\n    jmp_buf jb;\n    setjmp(jb);\n    sx_gc_scan((char*)&jb, (char*)&jb + sizeof(jb));\n    sx_gc_scan((char*)&jb, sx_stack_bot);\n  }\n  pp = &sx_gcall;\n  while (*pp){\n    sx_gcb *b = *pp;\n    if (b->mark){\n      b->mark = 0;\n      pp = &b->next;\n    } else {\n      size_t c = b->cls;\n      *pp = b->next;\n      sx_gc_bytes -= (double)sx_gc_class_size(c);\n      sx_ghlive -= 1;\n      b->next = sx_gfree[c];\n      sx_gfree[c] = b;\n    }\n  }\n  sx_gc_n += 1.0;\n  sx_gc_freed = before - sx_gc_bytes;\n  sx_gsort_n = 0;\n  sx_gc_rehash(4096);\n  sx_gc_thresh = sx_gc_bytes * 1.5 + (double)(4u << 20);\n}\n\nstatic void *sx_gc_alloc(int kind, size_t payload){\n  size_t need = payload + SX_GCH;\n")
  hold out = concat(out, "  size_t c = sx_gc_cls(need);\n  sx_gcb *b;\n  if (sx_gc_bytes >= sx_gc_thresh) sx_gc_collect();\n  b = sx_gfree[c];\n  if (b) sx_gfree[c] = b->next;\n  else b = (sx_gcb*)malloc(sx_gc_class_size(c));\n  if (!b) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  b->cls = c;\n  b->kind = (size_t)kind;\n  b->mark = 0;\n  b->next = sx_gcall;\n  sx_gcall = b;\n  sx_ghlive += 1;\n  sx_gc_hash_put((char*)b + SX_GCH, b);\n  sx_gc_bytes += (double)sx_gc_class_size(c);\n  return (char*)b + SX_GCH;\n}\n\nstatic double sx_gc_run(void){ sx_gc_collect(); return sx_gc_freed; }\nstatic double sx_gc_live(void){ return sx_gc_bytes; }\nstatic double sx_gc_count(void){ return sx_gc_n; }\n\n\n")
  hold out = concat(out, "static int sx_argn=0; static char **sx_argv_p=0;\n")
  hold out = concat(out, "static double sx_argc(void){ return (double)sx_argn; }\n")
  hold out = concat(out, "static char *sx_arg(double v){ long i=(long)v; if(i<0||i>=sx_argn) return \"\"; return sx_argv_p[i]; }\n")
  hold out = concat(out, "static char *sx_chr(double v){ char *b=(char*)sx_gc_alloc(0,2); b[0]=(char)(long)v; b[1]=0; return b; }\n")
  hold out = concat(out, "static char *sx_cat(const char *a,const char *b){ size_t la=strlen(a), lb=strlen(b); char *r=(char*)sx_gc_alloc(0,la+lb+1); memcpy(r,a,la); memcpy(r+la,b,lb); r[la+lb]=0; return r; }\n")
  hold out = concat(out, "static double sx_len(const void *s){ sx_gcb *b = sx_gc_hash_get((char*)s); if (b && b->kind == 1) return (double)((sx_list*)((char*)b + SX_GCH))->n; return (double)strlen((const char*)s); }\n")
  hold out = concat(out, "static double sx_idx(const char *s,double v){ long i=(long)v; long L=(long)strlen(s); if(i<0) i=i+L; if(i<0||i>=L){ fputs(\"sx: string index out of range\",stderr); exit(1); } return (double)(unsigned char)s[i]; }\n")
  hold out = concat(out, "static char *sx_read(const char *p){ FILE *f=fopen(p,\"rb\"); if(!f) return \"\"; fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char *b=(char*)sx_gc_alloc(0,(size_t)sz+1); size_t rd=fread(b,1,(size_t)sz,f); b[rd]=0; fclose(f); return b; }\n")
  hold out = concat(out, "#include <dirent.h>\n#include <sys/stat.h>\n#include <limits.h>\n")
  hold out = concat(out, "static char *sx_read_dir(const char *p){ DIR *d=opendir(p); if(!d) return \"\"; size_t cap=4096,n=0; unsigned cnt=0; char *b=(char*)malloc(cap); if(!b){ closedir(d); return \"\"; } struct dirent *e; while((e=readdir(d)) && cnt<4096){ const char *nm=e->d_name; if(nm[0]==46 && (nm[1]==0 || (nm[1]==46 && nm[2]==0))) continue; size_t L=strlen(nm), i; int bad=0; for(i=0;i<L;i++){ if(nm[i]==10 || nm[i]==13) bad=1; } if(bad) continue; if(n+L+2>cap){ cap*=2; char *nb=(char*)realloc(b,cap); if(!nb){ free(b); closedir(d); return \"\"; } b=nb; } memcpy(b+n,nm,L); n+=L; b[n++]=10; cnt+=1; if(n>=(4u<<20)) break; } closedir(d); char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n); r[n]=0; free(b); return r; }\n")
  hold out = concat(out, "static double sx_path_kind(const char *p){ struct stat st; if(lstat(p,&st)) return 0.0; if(S_ISREG(st.st_mode)) return 1.0; if(S_ISDIR(st.st_mode)) return 2.0; return 3.0; }\n")
  hold out = concat(out, "static double sx_path_size(const char *p){ struct stat st; if(lstat(p,&st)||!S_ISREG(st.st_mode)) return 0.0; return (double)st.st_size; }\n")
  hold out = concat(out, "extern char *realpath(const char *path, char *resolved_path);\n")
  hold out = concat(out, "static char *sx_path_real(const char *p){ char b[PATH_MAX]; if(!realpath(p,b)) return \"\"; size_t n=strlen(b); char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n+1); return r; }\n")
  hold out = concat(out, "#include <unistd.h>\n#include <fcntl.h>\n#include <errno.h>\n#include <sys/wait.h>\n#include <signal.h>\ntypedef struct sx_proc { pid_t pid; int in; int out; int live; } sx_proc;\nstatic sx_proc sx_procs[8];\nstatic int sx_proc_slot(double h){ long i; if(!(h>=1.0 && h<=8.0)) return -1; i=(long)h-1; if(h!=(double)(i+1)||!sx_procs[i].live) return -1; return (int)i; }\nstatic double sx_spawn(const char *path){ int i,pin[2],pout[2]; pid_t pid; signal(SIGPIPE,SIG_IGN); for(i=0;i<8;i++){ if(!sx_procs[i].live) break; } if(i>=8) return 0.0; if(pipe(pin)) return 0.0; if(pipe(pout)){ close(pin[0]);close(pin[1]); return 0.0; } if(fcntl(pin[0],F_SETFD,FD_CLOEXEC)<0 || fcntl(pin[1],F_SETFD,FD_CLOEXEC)<0 || fcntl(pout[0],F_SETFD,FD_CLOEXEC)<0 || fcntl(pout[1],F_SETFD,FD_CLOEXEC)<0){ close(pin[0]);close(pin[1]);close(pout[0]);close(pout[1]); return 0.0; } pid=fork(); if(pid<0){ close(pin[0]);close(pin[1]);close(pout[0]);close(pout[1]); return 0.0; } if(pid==0){ dup2(pin[0],0); dup2(pout[1],1); close(pin[0]);close(pin[1]);close(pout[0]);close(pout[1]); execl(path,path,(char*)0); _exit(127); } close(pin[0]); close(pout[1]); sx_procs[i].pid=pid; sx_procs[i].in=pin[1]; sx_procs[i].out=pout[0]; sx_procs[i].live=1; return (double)(i+1); }\nstatic double sx_child_send(double h,const char *s){ int i=sx_proc_slot(h); size_t n=strlen(s),off=0; if(i<0) return 0.0; while(off<n){ ssize_t w=write(sx_procs[i].in,s+off,n-off); if(w<=0) return 0.0; off+=(size_t)w; } return 1.0; }\nstatic char *sx_child_recv(double h,double v){ int i=sx_proc_slot(h); long n=(long)v; char *b; size_t got=0; if(i<0||n<0) return \"\"; b=(char*)sx_gc_alloc(0,(size_t)n+1); while(got<(size_t)n){ ssize_t rd=read(sx_procs[i].out,b+got,(size_t)n-got); if(rd<=0) break; got+=(size_t)rd; } b[got]=0; return b; }\nstatic char *sx_child_line(double h){ int i=sx_proc_slot(h); char buf[4096]; size_t n=0; char *r; if(i<0) return \"\"; for(;;){ ssize_t rd=read(sx_procs[i].out,buf+n,1); if(rd<=0) break; if(buf[n]==10) break; n+=1; if(n+2>sizeof buf) break; } buf[n]=0; if(n&&buf[n-1]==13) buf[n-1]=0; r=(char*)sx_gc_alloc(0,n+1); memcpy(r,buf,n+1); return r; }\nstatic double sx_child_close(double h){ int i=sx_proc_slot(h); int status=0; pid_t r; if(i<0) return -1.0; close(sx_procs[i].in); do { r=waitpid(sx_procs[i].pid,&status,0); } while(r<0 && errno==EINTR); close(sx_procs[i].out); sx_procs[i].live=0; if(r<0) return -1.0; if(WIFEXITED(status)) return (double)WEXITSTATUS(status); return -1.0; }\nstatic double sx_run_command(const char *cmd){ int st=system(cmd); if(st<0) return -1.0; if(WIFEXITED(st)) return (double)WEXITSTATUS(st); return -1.0; }\nstatic char *sx_getenv(const char *n){ const char *v=getenv(n); return v?(char*)v:\"\"; }\nstatic double sx_make_dir(const char *p){ return mkdir(p,0700)==0?1.0:0.0; }\nstatic double sx_make_link(const char *target,const char *path){ return symlink(target,path)==0?1.0:0.0; }\nstatic double sx_remove_path(const char *p){ if(!unlink(p)) return 1.0; return rmdir(p)==0?1.0:0.0; }\n")
  hold out = concat(out, "#include <time.h>\nstatic struct timespec sx_http_last; static int sx_http_seen=0;\nstatic char *sx_http(const char *u){ size_t L=strlen(u); if(L>3000) return \"\"; if(strncmp(u,\"http://\",7)&&strncmp(u,\"https://\",8)) return \"\"; for(size_t i=0;i<L;i++){ unsigned char c=(unsigned char)u[i]; int ok=(c>=97&&c<=122)||(c>=65&&c<=90)||(c>=48&&c<=57)||(c!=0&&strchr(\"-._~:/?&=%+#@,;\",c)); if(!ok) return \"\"; } if(sx_http_seen){ struct timespec now; clock_gettime(CLOCK_MONOTONIC,&now); double el=(double)(now.tv_sec-sx_http_last.tv_sec)+(double)(now.tv_nsec-sx_http_last.tv_nsec)/1e9; if(el<1.0){ struct timespec w; w.tv_sec=0; w.tv_nsec=(long)((1.0-el)*1e9); nanosleep(&w,NULL); } } sx_http_seen=1; clock_gettime(CLOCK_MONOTONIC,&sx_http_last); char cmd[4096]; snprintf(cmd,sizeof cmd,\"curl -sS -f -m 10 --max-filesize 1000000 -A sayanox-http/0.1 '%s' 2>/dev/null\",u); FILE *p=popen(cmd,\"r\"); if(!p) return \"\"; char *b=(char*)sx_gc_alloc(0,1000002); size_t rd=fread(b,1,1000001,p); int st=pclose(p); if(st!=0 || rd>1000000) return \"\"; b[rd]=0; return b; }\n")
  hold out = concat(out, "static char *sx_read_line(void){ char b[4096]; if(!fgets(b,sizeof b,stdin)) return \"\"; size_t n=strlen(b); if(n&&b[n-1]==10) b[n-1]=0; n=strlen(b); if(n&&b[n-1]==13) b[n-1]=0; char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n+1); return r; }\n")
  hold out = concat(out, "static char *sx_read_n(double v){ long n=(long)v; if(n<0) return \"\"; char *b=(char*)sx_gc_alloc(0,(size_t)n+1); size_t rd=fread(b,1,(size_t)n,stdin); b[rd]=0; return b; }\n")
  hold out = concat(out, "static double sx_write_out(const char *s){ fputs(s,stdout); return 1.0; }\n")
  hold out = concat(out, "static double sx_flush_out(void){ fflush(stdout); return 1.0; }\nstatic double sx_exit(double v){ fflush(stdout); exit((int)(long)v); return 0.0; }\n")
  hold out = concat(out, "static char *sx_numstr(double v){ char b[64]; snprintf(b,sizeof b,\"%g\",v); size_t n=strlen(b); char *r=(char*)sx_gc_alloc(0,n+1); memcpy(r,b,n+1); return r; }\n")
  // Keep C99 minimum bootstrap string-only; the full profile uses C11.
  hold cat_identity = "__sx_cat_text"
  while sxecontains(source, cat_identity) { cat_identity = concat(cat_identity, "x") }
  hold out = concat(out, concat("#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L\nstatic char *", concat(cat_identity, "(const char *v){return (char*)v;}\n#define sx_cat(a,b) sx_cat((a),_Generic((b),char*: ")))
  hold out = concat(out, concat(cat_identity, concat(",const char*: ", concat(cat_identity, ",default: sx_numstr)(b))\n#endif\n"))))
  when interpactive == 1 {
    hold out = concat(out, "static char *")
    hold out = concat(out, interpprivate)
    hold out = concat(out, "_str(const char *v){ return (char*)v; }\n#define ")
    hold out = concat(out, interpprivate)
    hold out = concat(out, "(v) _Generic((v), char*: ")
    hold out = concat(out, interpprivate)
    hold out = concat(out, "_str, const char*: ")
    hold out = concat(out, interpprivate)
    hold out = concat(out, "_str, default: sx_numstr)(v)\n")
  }
  hold out = concat(out, "static double sx_write(const char *p,const char *s){ FILE *f=fopen(p,\"wb\"); if(!f) return 0.0; fputs(s,f); return fclose(f)==0?1.0:0.0; }\n")
  hold out = concat(out, "static double sx_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "static double sx_cmp(const char *a,const char *b){ return (double)strcmp(a,b); }\n")
  hold out = concat(out, "static double string_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static double sx_lset_idx(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return (double)i; }\n")
  hold out = concat(out, "static sx_list *sx_lset(sx_list *L,double v,double x){ L->d[(long)sx_lset_idx(L,v)]=x; return L; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)sx_gc_alloc(2,sizeof(double)*4);} if(L->n>=L->cap){ double *nd=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)(L->cap*2)); memcpy(nd,L->d,sizeof(double)*(size_t)L->n); L->d=nd; L->cap*=2;} L->d[L->n++]=v; return L; }\n")
  hold out = concat(out, "\n")
} otherwise {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n#include <string.h>\n#include <setjmp.h>\n\n")
  hold out = concat(out, "typedef struct sx_list { double *d; long n; long cap; } sx_list;\ntypedef struct sx_gcb {\n  struct sx_gcb *next;      /* every live block, for the sweep */\n  size_t cls;               /* size class: the free list it goes back to */\n  size_t kind;              /* 0 raw bytes, 1 sx_list, 2 double array */\n  size_t mark;\n} sx_gcb;\n#define SX_GCH ((size_t)32)\n#define SX_NCLS 26\nstatic sx_gcb *sx_gcall = 0;\nstatic sx_gcb *sx_gfree[SX_NCLS];\nstatic char **sx_ghash = 0;               /* payload address -> block */\nstatic sx_gcb **sx_gblk = 0;\nstatic sx_gcb **sx_gsort = 0;             /* blocks by address, for interiors */\nstatic size_t sx_ghcap = 0, sx_ghlive = 0, sx_gsort_n = 0;\nstatic char *sx_stack_bot = 0;\nstatic double sx_gc_n = 0, sx_gc_freed = 0, sx_gc_thresh = 0, sx_gc_bytes = 0;\n\nstatic size_t sx_gc_class_size(size_t c){ return (size_t)32 << c; }\nstatic size_t sx_gc_cls(size_t need){\n")
  hold out = concat(out, "  size_t c = 0, sz = 32;\n  while (sz < need && c + 1 < SX_NCLS){ sz <<= 1; c += 1; }\n  return c;\n}\n\nstatic void sx_gc_rehash(size_t cap){\n  char **nh;\n  sx_gcb **nb;\n  sx_gcb *b;\n  if (cap < 4096) cap = 4096;\n  while (cap < (sx_ghlive + 1) * 4) cap <<= 1;\n  nh = (char**)calloc(cap, sizeof(char*));\n  nb = (sx_gcb**)calloc(cap, sizeof(sx_gcb*));\n  if (!nh || !nb) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  b = sx_gcall;\n  while (b){\n    char *pay = (char*)b + SX_GCH;\n    size_t h = ((size_t)pay >> 4) & (cap - 1);\n    while (nh[h]) h = (h + 1) & (cap - 1);\n    nh[h] = pay; nb[h] = b;\n    b = b->next;\n  }\n  free(sx_ghash); free(sx_gblk);\n  sx_ghash = nh; sx_gblk = nb; sx_ghcap = cap;\n}\n\nstatic void sx_gc_hash_put(char *pay, sx_gcb *b){\n  size_t h;\n  if (!sx_ghcap) sx_gc_rehash(1u << 12);\n  if ((sx_ghlive + 1) * 4 > sx_ghcap){ sx_gc_rehash(sx_ghcap * 2); return; }\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n")
  hold out = concat(out, "  while (sx_ghash[h]) h = (h + 1) & (sx_ghcap - 1);\n  sx_ghash[h] = pay; sx_gblk[h] = b;\n}\n\nstatic sx_gcb *sx_gc_hash_get(char *pay){\n  size_t h;\n  if (!sx_ghcap) return 0;\n  h = ((size_t)pay >> 4) & (sx_ghcap - 1);\n  while (sx_ghash[h] && sx_ghash[h] != pay) h = (h + 1) & (sx_ghcap - 1);\n  return sx_ghash[h] ? sx_gblk[h] : 0;\n}\n\nstatic int sx_gc_cmp(const void *a, const void *b){\n  char *pa = (char*)(*(sx_gcb* const*)a) + SX_GCH;\n  char *pb = (char*)(*(sx_gcb* const*)b) + SX_GCH;\n  return pa < pb ? -1 : (pa > pb ? 1 : 0);\n}\nstatic void sx_gc_sorted(void){\n  size_t i = 0;\n  sx_gcb *b = sx_gcall;\n  if (sx_gsort_n != sx_ghlive){\n    free(sx_gsort);\n    sx_gsort = (sx_gcb**)malloc((sx_ghlive + 1) * sizeof(sx_gcb*));\n    if (!sx_gsort) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  }\n  while (b && i < sx_ghlive){ sx_gsort[i] = b; i += 1; b = b->next; }\n  sx_gsort_n = i;\n  qsort(sx_gsort, i, sizeof(sx_gcb*), sx_gc_cmp);\n}\n")
  hold out = concat(out, "static sx_gcb *sx_gc_containing(char *p){\n  size_t lo = 0, hi = sx_gsort_n;\n  while (lo < hi){\n    size_t mid = (lo + hi) / 2;\n    char *pay = (char*)sx_gsort[mid] + SX_GCH;\n    size_t sz = sx_gc_class_size(sx_gsort[mid]->cls);\n    if (p < pay) hi = mid;\n    else if (p >= pay + sz) lo = mid + 1;\n    else return sx_gsort[mid];\n  }\n  return 0;\n}\n\nstatic void sx_gc_mark(void *p){\n  sx_gcb *b;\n  if (!p) return;\n  b = sx_gc_hash_get((char*)p);\n  if (!b) b = sx_gc_containing((char*)p);\n  if (!b || b->mark) return;\n  b->mark = 1;\n  if (b->kind == 1){\n    sx_list *L = (sx_list*)((char*)b + SX_GCH);\n    if (L->d) sx_gc_mark((char*)L->d);\n  }\n}\n\n#ifndef __has_feature\n#define __has_feature(x) 0\n#endif\n#if defined(__SANITIZE_ADDRESS__) || __has_feature(address_sanitizer)\n#include <sanitizer/asan_interface.h>\n#define SX_GC_WORD_OK(p) (!__asan_region_is_poisoned((p), sizeof(void*)))\n#else\n#define SX_GC_WORD_OK(p) 1\n#endif\n/* Conservative stack traversal skips ASan redzones; all actual loads remain instrumented. */\nstatic void sx_gc_scan(char *lo, char *hi){\n  lo = (char*)(((size_t)lo + 7u) & ~(size_t)7u);\n  while (lo + 8 <= hi){\n    if (SX_GC_WORD_OK(lo)) sx_gc_mark(*(char**)lo);\n    lo += 8;\n  }\n}\n\nstatic void sx_gc_init(void *anchor){\n  sx_stack_bot = (char*)anchor;\n")
  hold out = concat(out, "  if (!sx_gc_thresh) sx_gc_thresh = (double)(8u << 20);\n}\n\nstatic void sx_gc_collect(void){\n  double before = sx_gc_bytes;\n  sx_gcb **pp;\n  if (!sx_gcall || !sx_stack_bot) return;\n  sx_gc_sorted();\n  {\n    jmp_buf jb;\n    setjmp(jb);\n    sx_gc_scan((char*)&jb, (char*)&jb + sizeof(jb));\n    sx_gc_scan((char*)&jb, sx_stack_bot);\n  }\n  pp = &sx_gcall;\n  while (*pp){\n    sx_gcb *b = *pp;\n    if (b->mark){\n      b->mark = 0;\n      pp = &b->next;\n    } else {\n      size_t c = b->cls;\n      *pp = b->next;\n      sx_gc_bytes -= (double)sx_gc_class_size(c);\n      sx_ghlive -= 1;\n      b->next = sx_gfree[c];\n      sx_gfree[c] = b;\n    }\n  }\n  sx_gc_n += 1.0;\n  sx_gc_freed = before - sx_gc_bytes;\n  sx_gsort_n = 0;\n  sx_gc_rehash(4096);\n  sx_gc_thresh = sx_gc_bytes * 1.5 + (double)(4u << 20);\n}\n\nstatic void *sx_gc_alloc(int kind, size_t payload){\n  size_t need = payload + SX_GCH;\n")
  hold out = concat(out, "  size_t c = sx_gc_cls(need);\n  sx_gcb *b;\n  if (sx_gc_bytes >= sx_gc_thresh) sx_gc_collect();\n  b = sx_gfree[c];\n  if (b) sx_gfree[c] = b->next;\n  else b = (sx_gcb*)malloc(sx_gc_class_size(c));\n  if (!b) { fputs(\"sx: out of memory\", stderr); exit(1); }\n  b->cls = c;\n  b->kind = (size_t)kind;\n  b->mark = 0;\n  b->next = sx_gcall;\n  sx_gcall = b;\n  sx_ghlive += 1;\n  sx_gc_hash_put((char*)b + SX_GCH, b);\n  sx_gc_bytes += (double)sx_gc_class_size(c);\n  return (char*)b + SX_GCH;\n}\n\nstatic double sx_gc_run(void){ sx_gc_collect(); return sx_gc_freed; }\nstatic double sx_gc_live(void){ return sx_gc_bytes; }\nstatic double sx_gc_count(void){ return sx_gc_n; }\n\n\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static double sx_lset_idx(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return (double)i; }\n")
  hold out = concat(out, "static sx_list *sx_lset(sx_list *L,double v,double x){ L->d[(long)sx_lset_idx(L,v)]=x; return L; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)sx_gc_alloc(1,sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)sx_gc_alloc(2,sizeof(double)*4);} if(L->n>=L->cap){ double *nd=(double*)sx_gc_alloc(2,sizeof(double)*(size_t)(L->cap*2)); memcpy(nd,L->d,sizeof(double)*(size_t)L->n); L->d=nd; L->cap*=2;} L->d[L->n++]=v; return L; }\n\n")
}
// Byte-buffer and bitwise surface for the native-AOT port. It is emitted after
// both runtime variants because sx_bytes_f64 needs sx_lpush from either one.
hold out = concat(out, "static unsigned long long sx_u64(double v){ if(!(v>=0.0)){ fputs(\"sx: bitwise operand out of range\\n\",stderr); exit(1); } if(v>18446744073709551616.0){ fputs(\"sx: bitwise operand out of range\\n\",stderr); exit(1); } if(v==18446744073709551616.0) return 18446744073709551615ULL; return (unsigned long long)v; }\nstatic double sx_bit_and(double a,double b){ return (double)(sx_u64(a) & sx_u64(b)); }\nstatic double sx_bit_or(double a,double b){ return (double)(sx_u64(a) | sx_u64(b)); }\nstatic double sx_bit_xor(double a,double b){ return (double)(sx_u64(a) ^ sx_u64(b)); }\nstatic double sx_bit_not(double a){ return (double)(~sx_u64(a)); }\nstatic double sx_shl(double a,double b){ long n=0; if(!(b>=0.0 && b<=63.0)){ fputs(\"sx: shift count out of range\\n\",stderr); exit(1); } n=(long)b; return (double)(sx_u64(a) << n); }\nstatic double sx_shr(double a,double b){ long n=0; if(!(b>=0.0 && b<=63.0)){ fputs(\"sx: shift count out of range\\n\",stderr); exit(1); } n=(long)b; return (double)(sx_u64(a) >> n); }\nstatic double sx_write_bytes(const char *p,sx_list *L){ FILE *f; if(L){ for(long k=0;k<L->n;k++){ if(!(L->d[k]>=0.0 && L->d[k]<=255.0)) return 0.0; } } f=fopen(p,\"wb\"); unsigned char buf[4096]; size_t n=0; long i; if(!f) return 0.0; if(L){ for(i=0;i<L->n;i++){ double d=L->d[i]; if(!(d>=0.0 && d<=255.0)){ fclose(f); return 0.0; } buf[n++]=(unsigned char)(long)d; if(n==sizeof buf){ if(fwrite(buf,1,n,f)!=n){ fclose(f); return 0.0; } n=0; } } } if(n && fwrite(buf,1,n,f)!=n){ fclose(f); return 0.0; } return fclose(f)==0?1.0:0.0; }\nstatic sx_list *sx_bytes_f64(sx_list *L,double v){ unsigned long long b; int i; memcpy(&b,&v,8); for(i=0;i<8;i++) L=sx_lpush(L,(double)(unsigned char)(b>>(8*i))); return L; }\nstatic double sx_read_bytes(const char *p,sx_list *L){ FILE *f=fopen(p,\"rb\"); unsigned char buf[8192]; double n=0.0; long i; sx_list *pending=NULL; if(!f) return -1.0; if(!L){ fclose(f); return -1.0; } for(;;){ size_t r=fread(buf,1,sizeof buf,f); if(r==0) break; for(i=0;i<(long)r;i++) pending=sx_lpush(pending,(double)buf[i]); n+=(double)r; } if(ferror(f)){ fclose(f); return -1.0; } if(fclose(f)!=0) return -1.0; if(pending){ for(i=0;i<pending->n;i++) L=sx_lpush(L,pending->d[i]); } return n; }\n")
when inready == 1 {
  hold out = concat(out, "static sx_list *")
  hold out = concat(out, inprivate)
  hold out = concat(out, "list(sx_list *value){return value;}\n")
}
// ---------------- struct typedefs (field types come from literals) ----------------
hold tdi = 0
hold tdn = len(sdefs)
while tdi < tdn {
  hold tdname = ""
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 58 {
        hold tdrun = 0
      } otherwise {
        hold tdname = concat(tdname, chr(tdc))
      }
      hold tdi = tdi + 1
    }
  }
  hold out = concat(out, "typedef struct {")
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 59 {
        hold tdrun = 0
        hold tdi = tdi + 1
      } otherwise {
        when tdc == 44 {
          hold tdi = tdi + 1
        } otherwise {
          hold tdfld = ""
          hold tdf = 1
          while tdf == 1 {
            when tdi >= tdn {
              hold tdf = 0
            } otherwise {
              hold tdc = sx_index(sdefs, tdi)
              when tdc == 44 || tdc == 59 {
                hold tdf = 0
              } otherwise {
                hold tdfld = concat(tdfld, chr(tdc))
                hold tdi = tdi + 1
              }
            }
          }
          hold tdclass = 0
          hold tdinn = ""
          hold tdkey = concat("|", tdname)
          hold tdkey = concat(tdkey, ".")
          hold tdkey = concat(tdkey, tdfld)
          hold tdkey = concat(tdkey, "=")
          hold tdk = len(tdkey)
          hold tdl = len(ftypes)
          hold tdhit = 0
          hold tdp = 0
          while tdp + tdk < tdl {
            hold tdeq = 1
            hold tdj = 0
            while tdj < tdk {
              hold tda = sx_index(ftypes, tdp + tdj)
              hold tdb = sx_index(tdkey, tdj)
              when tda == tdb {
                hold tdj = tdj + 1
              } otherwise {
                hold tdeq = 0
                hold tdj = tdk
              }
            }
            when tdeq == 1 {
              hold tdpk = sx_index(ftypes, tdp + tdk)
              when tdpk == 49 {
                hold tdclass = 1
              }
              when tdpk == 50 {
                // struct-typed field: the inner struct name follows
                hold tdclass = 2
                hold tdi2 = tdp + tdk + 2
                hold tdrun2 = 1
                while tdrun2 == 1 {
                  when tdi2 >= tdl {
                    hold tdrun2 = 0
                  } otherwise {
                    hold tdc2 = sx_index(ftypes, tdi2)
                    when tdc2 == 124 {
                      hold tdrun2 = 0
                    } otherwise {
                      hold tdinn = concat(tdinn, chr(tdc2))
                      hold tdi2 = tdi2 + 1
                    }
                  }
                }
              }
              when tdpk == 51 {
                // list-typed fields store the list object pointer.  The list
                // runtime owns the backing array, so copying this field keeps
                // alias/growth semantics rather than copying numeric cells.
                hold tdclass = 3
              }
              hold tdp = tdl
            } otherwise {
              hold tdp = tdp + 1
            }
          }
          when tdclass == 2 {
            hold out = concat(out, " ")
            hold out = concat(out, tdinn)
            hold out = concat(out, " ")
          } otherwise {
            when tdclass == 3 {
              hold out = concat(out, " sx_list *")
            } otherwise {
              when tdclass == 1 {
                hold out = concat(out, " char *")
              } otherwise {
                hold out = concat(out, " double ")
              }
            }
          }
          hold out = concat(out, tdfld)
          hold out = concat(out, ";")
        }
      }
    }
  }
  hold out = concat(out, " } ")
  hold out = concat(out, tdname)
  hold out = concat(out, ";")
  hold out = concat(out, nl)
}
hold fixfrom = len(out)
hold out = concat(out, gproto)
hold out = concat(out, fns)
// Keep the stack anchor in a caller frame, above EVERY generated-program
// local at both O0 and O2. An anchor beside those locals can be laid out
hold main_inner = "_sx_gc_program"
hold main_unique = 0
while main_unique == 0 {
  hold main_unique = 1
  hold main_scan = 0
  hold main_nlen = len(main_inner)
  while main_scan + main_nlen <= n && main_unique == 1 {
    hold main_match = 1
    hold main_char = 0
    while main_char < main_nlen && main_match == 1 {
      when sxsource_get(source_words, main_scan + main_char) != sx_index(main_inner, main_char) {
        hold main_match = 0
      }
      hold main_char = main_char + 1
    }
    when main_match == 1 {
      hold main_unique = 0
    }
    hold main_scan = main_scan + 1
  }
  when main_unique == 0 {
    hold main_inner = concat(main_inner, "x")
  }
}
hold out = concat(out, "static int ")
hold out = concat(out, main_inner)
hold out = concat(out, "(void);\n")
when rt == 1 {
  hold out = concat(out, "int main(int argc,char**argv){\n")
  hold out = concat(out, "  sx_argn=argc; sx_argv_p=argv;\n")
} otherwise {
  hold out = concat(out, "int main(void){\n")
}
hold out = concat(out, "  volatile unsigned char sx_gcanchor=0;\n  int (*volatile sx_entry)(void)=")
hold out = concat(out, main_inner)
hold out = concat(out, ";\n  sx_gc_init((void*)&sx_gcanchor);\n  int sx_status=sx_entry();\n  sx_gcanchor=0;\n  return sx_status;\n}\nstatic int ")
hold out = concat(out, main_inner)
hold out = concat(out, "(void){\n")
hold out = concat(out, condition_main_decls)
hold out = concat(out, sx_hoist_main(concat(obody, body), concat(decls, concat(sdecls, ldecls)), svars))
hold out = concat(out, "  return 0;\n")
hold out = concat(out, "}\n")
// ---------------- module errors (clear, never silent) ----------------
when exmissing == 1 {
  hold exerr = concat("#error sayanox-min: cannot open use file: ", exmissp)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: cannot open use file: ", exmissp)
  show shmsg
}
when exdeep == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use nesting deeper than 8")
  hold exerr = concat(exerr, nl)
  show "min: use nesting deeper than 8"
}
when len(seed_generic_error) > 0 {
  exerr = concat(concat("#error sayanox-min: ", concat(seed_generic_error, nl)), exerr)
}
when exbad == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct/list literal value must be a number, string, name, or nested struct")
  hold exerr = concat(exerr, nl)
  show "min: struct/list literal value must be a number, string, name, or nested struct"
}
when exbad5 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use must be followed by a quoted path, e.g. use \"lib.sa\"")
  hold exerr = concat(exerr, nl)
  show "min: use must be followed by a quoted path, e.g. use \"lib.sa\""
}
when exbad6 == 1 {
  when seed_profile == 1 {
    hold exerr = concat(exerr, "#error sayanox-min: struct field value kind conflicts with an earlier literal (number, string, list, or concrete struct)")
  } otherwise {
  hold exerr = concat(exerr, "#error sayanox-min: struct field is used with two different value kinds (number, string, list, or concrete struct)")
  }
  hold exerr = concat(exerr, nl)
  show "min: struct field used with two different value kinds (number, string, list, or concrete struct)"
}
when exbad7 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal fields must be given in declaration order")
  hold exerr = concat(exerr, nl)
  show "min: struct literal fields must be given in declaration order"
}
when exbad8 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal must fill every field")
  hold exerr = concat(exerr, nl)
  show "min: struct literal must fill every field"
}
when nerrfwd == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct '")
  hold exerr = concat(exerr, nfwdout)
  hold exerr = concat(exerr, "' nests struct '")
  hold exerr = concat(exerr, nfwdin)
  hold exerr = concat(exerr, "' which is declared later; declare the nested struct first")
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: struct '", nfwdout)
  hold shmsg = concat(shmsg, "' nests struct '")
  hold shmsg = concat(shmsg, nfwdin)
  hold shmsg = concat(shmsg, "' declared later; declare the nested struct first")
  show shmsg
}
when nerrunk == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal for unknown struct '")
  hold exerr = concat(exerr, nunknm)
  hold exerr = concat(exerr, "'")
  hold exerr = concat(exerr, nl)
  hold shmsg = "min: struct literal for unknown struct '"
  hold shmsg = concat(shmsg, nunknm)
  hold shmsg = concat(shmsg, "'")
  show shmsg
}
when nerrchain == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, chainmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", chainmsg)
  show shmsg
}
when nerrscop == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, scopmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", scopmsg)
  show shmsg
}
when exbad4 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: a '}' ended up inside a give expression; put one statement per line")
  hold exerr = concat(exerr, nl)
  show "min: a '}' ended up inside a give expression; put one statement per line"
}
when perr == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, permsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", permsg)
  show shmsg
}
when exbad3 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: unsupported index expression (expected a numeric expression: numbers, names, fields, len(), indexes, + - * / % and parentheses; a call other than len() and a quoted string need a hold first)")
  hold exerr = concat(exerr, nl)
  show "min: unsupported index expression (expected a numeric expression: numbers, names, fields, len(), indexes, + - * / % and parentheses; a call other than len() and a quoted string need a hold first)"
}
// Rewrite every generated C integer token in user code to a double token.
// `fixfrom` is the end of the runtime preamble; that preamble intentionally
hold llc = 0
hold llpc = 0
hold llskip = 0
hold fixn = len(out)
hold fixi = 0
hold fixout = ""
while fixi < fixfrom {
  hold fixchunk = concat(fixchunk, chr(sx_index(out,fixi)))
  hold fixi = fixi + 1
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
hold fixquote = 0
hold fixes = 0
hold fixprev = 0
while fixi < fixn {
  hold fixc = sx_index(out,fixi)
  hold llhandled = 0
  when fixquote == 0 && fixc == 91 {
    hold llprevpos = fixi - 1
    hold llprev = 0
    hold llseek = 1
    while llprevpos >= fixfrom && llseek == 1 {
      hold llprev = sx_index(out, llprevpos)
      when llprev == 32 || llprev == 9 || llprev == 10 || llprev == 13 {
        hold llprevpos = llprevpos - 1
      } otherwise {
        hold llseek = 0
      }
    }
    when llprev == 40 || llprev == 44 {
      // Literal call arguments are inline allocations, never hoisted. This
      // bounded path accepts decimal constant arithmetic and parentheses;
      // names/calls still use the ordinary checked hold/list parser.
      hold llhandled = 1
      hold llpos = fixi + 1
      hold llend = 0
      hold llbad = 0
      hold llneed = 0
      hold llcount = 0
      hold llelems = ""
      while llend == 0 && llpos < fixn {
        hold llskip = 1
        while llskip == 1 && llpos < fixn {
          hold llc = sx_index(out, llpos)
          when llc == 32 || llc == 9 || llc == 10 || llc == 13 {
            hold llpos = llpos + 1
          } otherwise {
              hold llskip = 0
            }
        }
        hold llc = 0
        when llpos < fixn {
              hold llc = sx_index(out, llpos)
            }
        when llc == 93 {
          when llneed == 1 {
              hold llbad = 1
            }
          hold llpos = llpos + 1
          hold llend = 1
        } otherwise {
          hold llvalue = ""
          hold llparen = 0
          hold lloperand = 1
          hold llexrun = 1
          while llexrun == 1 && llpos < fixn {
            hold llc = sx_index(out, llpos)
            when llc == 32 || llc == 9 || llc == 10 || llc == 13 {
              hold llpos = llpos + 1
            } otherwise {
              when lloperand == 1 {
                when llc == 43 || llc == 45 {
                  // Separate unary operators: -- must not become C decrement.
                  hold llvalue = concat(llvalue, chr(llc))
                  hold llvalue = concat(llvalue, " ")
                  hold llpos = llpos + 1
                } otherwise {
                  when llc == 40 {
                    hold llvalue = concat(llvalue, "(")
                    hold llparen = llparen + 1
                    hold llpos = llpos + 1
                  } otherwise {
                    when llc >= 48 && llc <= 57 {
                      hold lldot = 0
                      hold lldigits = 0
                      hold llrun = 1
                      while llpos < fixn && llrun == 1 {
                        hold llc = sx_index(out, llpos)
                        when llc >= 48 && llc <= 57 {
                          hold llvalue = concat(llvalue, chr(llc))
                          hold llpos = llpos + 1
                          hold lldigits = lldigits + 1
                        } otherwise {
                          hold llrun = 0
                        }
                      }
                      when lldigits == 0 {
                          hold llbad = 1
                        }
                      hold llc = 0
                      when llpos < fixn {
                          hold llc = sx_index(out, llpos)
                        }
                      when llc == 46 {
                        hold lldot = 1
                        hold llvalue = concat(llvalue, ".")
                        hold llpos = llpos + 1
                        hold lldigits = 0
                        hold llrun = 1
                        while llpos < fixn && llrun == 1 {
                          hold llc = sx_index(out, llpos)
                          when llc >= 48 && llc <= 57 {
                            hold llvalue = concat(llvalue, chr(llc))
                            hold llpos = llpos + 1
                            hold lldigits = lldigits + 1
                          } otherwise {
                          hold llrun = 0
                        }
                        }
                        when lldigits == 0 {
                          hold llbad = 1
                        }
                      }
                      when lldot == 0 {
                        hold llvalue = concat(llvalue, ".0")
                      }
                      hold lloperand = 0
                    } otherwise {
                      hold llbad = 1
                      hold llexrun = 0
                    }
                  }
                }
              } otherwise {
                when llc == 43 || llc == 45 || llc == 42 || llc == 47 {
                  hold llvalue = concat(llvalue, " ")
                  hold llvalue = concat(llvalue, chr(llc))
                  hold llvalue = concat(llvalue, " ")
                  hold llpos = llpos + 1
                  hold lloperand = 1
                } otherwise {
                  when llc == 41 && llparen > 0 {
                    hold llvalue = concat(llvalue, ")")
                    hold llparen = llparen - 1
                    hold llpos = llpos + 1
                  } otherwise {
                    hold llexrun = 0
                  }
                }
              }
            }
            when llbad == 1 {
              hold llexrun = 0
            }
          }
          when lloperand == 1 || llparen != 0 {
            hold llbad = 1
          }
          when llcount > 0 {
              hold llelems = concat(llelems, ",")
            }
          hold llelems = concat(llelems, "(double)(")
          hold llelems = concat(llelems, llvalue)
          hold llelems = concat(llelems, ")")
          hold llcount = llcount + 1
          hold llskip = 1
          while llpos < fixn && llskip == 1 {
            hold llc = sx_index(out, llpos)
            when llc == 32 || llc == 9 || llc == 10 || llc == 13 {
              hold llpos = llpos + 1
            } otherwise {
              hold llskip = 0
            }
          }
          hold llc = 0
          when llpos < fixn {
              hold llc = sx_index(out, llpos)
            }
          when llc == 44 {
            hold llpos = llpos + 1
            hold llneed = 1
          } otherwise {
            when llc == 93 {
              hold llpos = llpos + 1
              hold llend = 1
            } otherwise {
              hold llbad = 1
            }
          }
          when llbad == 1 {
              hold llend = 1
            }
        }
      }
      when llend == 0 {
              hold llbad = 1
            }
      hold llafter = llpos
      hold llskip = 1
      while llafter < fixn && llskip == 1 {
        hold llc = sx_index(out, llafter)
        when llc == 32 || llc == 9 || llc == 10 || llc == 13 {
          hold llafter = llafter + 1
        } otherwise {
              hold llskip = 0
            }
      }
      hold llc = 0
      when llafter < fixn {
              hold llc = sx_index(out, llafter)
            }
      when llc != 44 && llc != 41 {
              hold llbad = 1
            }
      when llbad == 1 {
        hold exerr = concat(exerr, "#error sayanox-min: inline list arguments require numeric constant arithmetic; use hold for names or calls")
        hold exerr = concat(exerr, nl)
        show "min: inline list arguments require numeric constant arithmetic; use hold for names or calls"
      }
      hold lltextcount = ""
      hold llnum = llcount
      when llnum == 0 {
              hold lltextcount = "0"
            }
      while llnum > 0 {
        hold lldigit = llnum % 10
        hold lltextcount = concat(chr(48 + lldigit), lltextcount)
        hold llnum = (llnum - lldigit) / 10
      }
      hold fixchunk = concat(fixchunk, "sx_llit(")
      hold fixchunk = concat(fixchunk, lltextcount)
      when llcount > 0 {
        hold fixchunk = concat(fixchunk, ",")
        hold fixchunk = concat(fixchunk, llelems)
      }
      hold fixchunk = concat(fixchunk, ")")
      hold fixi = llpos
      hold fixprev = 41
    }
  }
  when llhandled == 0 {
  when fixquote == 1 {
    hold fixchunk = concat(fixchunk, chr(fixc))
    hold fixi = fixi + 1
    when fixes == 1 {
      hold fixes = 0
    } otherwise {
      when fixc == 92 {
        hold fixes = 1
      } otherwise {
        when fixc == 34 {
          hold fixquote = 0
        }
      }
    }
    hold fixprev = fixc
  } otherwise {
    when fixc == 34 {
      hold fixchunk = concat(fixchunk, chr(fixc))
      hold fixquote = 1
      hold fixprev = fixc
      hold fixi = fixi + 1
    } otherwise {
      when (fixc >= 65 && fixc <= 90) || (fixc >= 97 && fixc <= 122) || fixc == 95 {
        // Some call-argument paths preserve literal words. Normalize whole
        // tokens in expression positions, never string contents, field names,
        // declaration names, or a longer identifier such as true_value.
        hold fixbefore = fixi - 1
        hold fixbc = 0
        hold fixseek = 1
        while fixbefore >= fixfrom && fixseek == 1 {
          hold fixbc = sx_index(out, fixbefore)
          when fixbc == 32 || fixbc == 9 || fixbc == 10 || fixbc == 13 {
            hold fixbefore = fixbefore - 1
          } otherwise {
            hold fixseek = 0
          }
        }
        hold fixword = ""
        hold fixrun = 1
        while fixi < fixn && fixrun == 1 {
          hold fixd = sx_index(out, fixi)
          when (fixd >= 65 && fixd <= 90) || (fixd >= 97 && fixd <= 122) || (fixd >= 48 && fixd <= 57) || fixd == 95 {
            hold fixword = concat(fixword, chr(fixd))
            hold fixprev = fixd
            hold fixi = fixi + 1
          } otherwise {
            hold fixrun = 0
          }
        }
        when fixbc == 40 || fixbc == 44 || fixbc == 61 || fixbc == 43 || fixbc == 45 || fixbc == 42 || fixbc == 47 || fixbc == 37 || fixbc == 33 || fixbc == 60 || fixbc == 62 || fixbc == 38 || fixbc == 124 || fixbc == 63 || fixbc == 58 || fixbc == 91 {
          when sx_eq(fixword, "true") {
            hold fixword = "1.0"
            hold fixprev = 48
          }
          when sx_eq(fixword, "false") {
            hold fixword = "0.0"
            hold fixprev = 48
          }
        }
        when sx_eq(fixword, "sx_len") || sx_eq(fixword, "sx_idx") {
          hold llpeek = fixi
          hold llgo = 1
          while llpeek < fixn && llgo == 1 {
            hold llpc = sx_index(out, llpeek)
            when llpc == 32 || llpc == 9 {
                hold llpeek = llpeek + 1
              }
            otherwise {
                hold llgo = 0
              }
          }
          hold llpc = 0
          when llpeek < fixn {
                hold llpc = sx_index(out, llpeek)
              }
          when llpc == 40 {
            hold llpeek = llpeek + 1
            hold llgo = 1
            while llpeek < fixn && llgo == 1 {
              hold llpc = sx_index(out, llpeek)
              when llpc == 32 || llpc == 9 {
                hold llpeek = llpeek + 1
              }
              otherwise {
                hold llgo = 0
              }
            }
            hold llislist = 0
            hold llpc = 0
            when llpeek < fixn {
                hold llpc = sx_index(out, llpeek)
              }
            when llpc == 91 {
                hold llislist = 1
              }
            hold llcallee = ""
            hold llgo = 1
            while llpeek < fixn && llgo == 1 {
              hold llpc = sx_index(out, llpeek)
              when (llpc >= 65 && llpc <= 90) || (llpc >= 97 && llpc <= 122) || (llpc >= 48 && llpc <= 57) || llpc == 95 {
                hold llcallee = concat(llcallee, chr(llpc))
                hold llpeek = llpeek + 1
              } otherwise {
                hold llgo = 0
              }
            }
            when llpeek < fixn {
              when sx_index(out, llpeek) == 40 {
                when sx_eq(llcallee, "sx_lpush") || sx_eq(llcallee, "sx_llit") {
                hold llislist = 1
              }
                hold llkey = concat("|", llcallee)
                hold llkey = concat(llkey, "=l|")
                hold llki = 0
                hold llkl = len(llkey)
                hold llfl = len(fsret)
                while llki + llkl <= llfl {
                  hold llok = 1
                  hold llkj = 0
                  while llkj < llkl && llok == 1 {
                    when sx_index(fsret, llki + llkj) != sx_index(llkey, llkj) {
                hold llok = 0
              }
                    hold llkj = llkj + 1
                  }
                  when llok == 1 {
                hold llislist = 1
              }
                  hold llki = llki + 1
                }
              }
            }
            when llislist == 1 {
              when sx_eq(fixword, "sx_len") {
                hold fixword = "sx_llen"
              }
              otherwise {
                hold fixword = "sx_lget"
              }
            }
          }
        }
        hold fixchunk = concat(fixchunk, fixword)
      } otherwise {
      when fixc >= 48 && fixc <= 57 {
        hold fixident = 0
        when (fixprev >= 48 && fixprev <= 57) || (fixprev >= 65 && fixprev <= 90) || (fixprev >= 97 && fixprev <= 122) || fixprev == 95 {
          hold fixident = 1
        }
        when fixident == 1 {
          hold fixchunk = concat(fixchunk, chr(fixc))
          hold fixprev = fixc
          hold fixi = fixi + 1
        } otherwise {
          hold fixnum = ""
          hold fixdot = 0
          hold fixrun = 1
          while fixrun == 1 {
            when fixi >= fixn {
              hold fixrun = 0
            } otherwise {
              hold fixd = sx_index(out,fixi)
              when fixd >= 48 && fixd <= 57 {
                hold fixnum = concat(fixnum, chr(fixd))
                hold fixprev = fixd
                hold fixi = fixi + 1
              } otherwise {
                when fixd == 46 {
                  hold fixnext = 0
                  when fixi + 1 < fixn {
                    hold fixnext = sx_index(out,fixi + 1)
                  }
                  when fixnext >= 48 && fixnext <= 57 {
                    hold fixnum = concat(fixnum, chr(fixd))
                    hold fixdot = 1
                    hold fixprev = fixd
                    hold fixi = fixi + 1
                  } otherwise {
                    hold fixrun = 0
                  }
                } otherwise {
                  hold fixrun = 0
                }
              }
            }
          }
          when fixdot == 0 {
            hold fixnum = concat(fixnum, ".0")
            hold fixprev = 48
          }
          hold fixchunk = concat(fixchunk, fixnum)
        }
      } otherwise {
        hold fixchunk = concat(fixchunk, chr(fixc))
        hold fixprev = fixc
        hold fixi = fixi + 1
      }
      }
    }
  }
  }
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
when fixi > fixflush {
  hold fixout = concat(fixout, fixchunk)
  hold fixchunk = ""
  hold fixflush = fixi
}
hold out = fixout
when seed_profile == 1 && len(gdefs) > 0 { out = sxseed_c_symbols(out, gdefs) }
hold out = concat(exerr, out)
hold w = write_file(compiler_paths.output, out)

// counters go to stdout (they are the compiler's own output, not the target's)

