// =====================================================================
// main scan loop
// =====================================================================

// =====================================================================
// use "file.sa" expansion (max depth 8, real statements only)
//   * only a `use "..."` that starts a statement is expanded
//   * strings and // comments are copied verbatim, never scanned for use
//   * a missing file emits #error into the generated C (clear failure)
//   * paths resolve against the CWD first, then next to the input file
//   * output is built in ~300 byte chunks (flat concat would be O(n^2))
// =====================================================================
hold exd = 0
hold exlast = -1
hold exdl = 0
hold exdl = len(in_path)
while exd < exdl {
  hold excd = 0
  hold excd = sx_index(in_path, exd)
  when excd == 47 {
    hold exlast = exd
  }
  hold exd = exd + 1
}
when exlast >= 0 {
  hold exd = 0
  while exd <= exlast {
    hold exdir = concat(exdir, chr(sx_index(in_path, exd)))
    hold exd = exd + 1
  }
}

hold exround = 0
hold exmore = 1
while exmore == 1 {
  hold exmore = 0
  hold exround = exround + 1
  hold exs = ""
  hold exch = ""
  hold exm = ""
  hold exchl = 0
  hold exml = 0
  hold exi = 0
  hold exst = 1
  hold exq = 0
  hold excm = 0
  while exi < n {
    // flush the pending chunk (two-level: exch -> exm -> exs).  A single
    // flat accumulator copies everything appended so far on every flush,
    // which is O(n^2) on the whole input; the mid chunk keeps that to
    // O(n^(4/3)) while the final text is identical.
    when exchl >= 128 {
      hold exm = concat(exm, exch)
      hold exch = ""
      hold exchl = 0
      hold exml = len(exm)
      when exml > 8192 {
        hold exs = concat(exs, exm)
        hold exm = ""
        hold exml = 0
      }
    }
    hold exc = sx_index(source, exi)
    when exq == 1 {
      // inside a string literal: copy verbatim, honour backslash escapes
      hold exch = concat(exch, chr(exc))
      hold exchl = exchl + 1
      hold exi = exi + 1
      when exc == 92 {
        when exi < n {
          hold exch = concat(exch, chr(sx_index(source, exi)))
          hold exchl = exchl + 1
          hold exi = exi + 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 0
        }
      }
    } otherwise {
      when excm == 1 {
        // inside a // comment: copy to end of line
        hold exch = concat(exch, chr(exc))
        hold exchl = exchl + 1
        hold exi = exi + 1
        when exc == 10 {
          hold excm = 0
          hold exst = 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 1
          hold exst = 0
          hold exch = concat(exch, chr(exc))
          hold exchl = exchl + 1
          hold exi = exi + 1
        } otherwise {
          when exst == 1 && exc >= 97 && exc <= 122 {
            // statement word: read it whole
            hold exw = ""
            hold exj = exi
            hold exrun = 1
            while exrun == 1 {
              when exj >= n {
                hold exrun = 0
              } otherwise {
                hold exc2 = sx_index(source, exj)
                when (exc2 >= 97 && exc2 <= 122) || (exc2 >= 65 && exc2 <= 90) || (exc2 >= 48 && exc2 <= 57) || exc2 == 95 {
                  hold exw = concat(exw, chr(exc2))
                  hold exj = exj + 1
                } otherwise {
                  hold exrun = 0
                }
              }
            }
            when sx_eq(exw, "use") {
              // blanks, then expect a quoted path
              hold exk = exj
              hold exrun = 1
              while exrun == 1 {
                when exk >= n {
                  hold exrun = 0
                } otherwise {
                  hold exc2 = sx_index(source, exk)
                  when exc2 == 32 || exc2 == 9 || exc2 == 13 {
                    hold exk = exk + 1
                  } otherwise {
                    hold exrun = 0
                  }
                }
              }
              hold exc2 = 0
              when exk < n {
                hold exc2 = sx_index(source, exk)
              }
              when exc2 == 34 {
                hold exk = exk + 1
                hold exup = ""
                hold exrun = 1
                while exrun == 1 {
                  when exk >= n {
                    hold exrun = 0
                  } otherwise {
                    hold exc2 = sx_index(source, exk)
                    when exc2 == 34 {
                      hold exrun = 0
                    } otherwise {
                      hold exup = concat(exup, chr(exc2))
                      hold exk = exk + 1
                    }
                  }
                }
                when exk < n {
                  hold exk = exk + 1
                }
                when exround <= 8 {
                  hold exsrc = read_file(exup)
                  hold exsl = len(exsrc)
                  when exsl == 0 {
                    hold exdl = len(exdir)
                    when exdl > 0 {
                      hold exsrc = read_file(concat(exdir, exup))
                      hold exsl = len(exsrc)
                    }
                  }
                  when exsl == 0 {
                    hold exmissing = 1
                    hold exmissp = exup
                  } otherwise {
                    // flush, then splice the whole file at once
                    when exchl > 0 {
                      hold exm = concat(exm, exch)
                      hold exch = ""
                      hold exchl = 0
                      hold exml = len(exm)
                    }
                    when exml > 0 {
                      hold exs = concat(exs, exm)
                      hold exm = ""
                      hold exml = 0
                    }
                    hold exs = concat(exs, exsrc)
                    hold exmore = 1
                    hold exst = 1
                  }
                  hold exi = exk
                } otherwise {
                  // deeper than 8: keep the text and report it below
                  hold exdeep = 1
                  hold exst = 0
                  hold exch = concat(exch, chr(exc))
                  hold exchl = exchl + 1
                  hold exi = exi + 1
                }
              } otherwise {
                // `use` not followed by a quoted path: report it rather
                // than letting `use foo.sa` turn into garbage identifiers
                hold exbad5 = 1
                hold exst = 0
                hold exch = concat(exch, chr(exc))
                hold exchl = exchl + 1
                hold exi = exi + 1
              }
            } otherwise {
              hold exst = 0
              hold exch = concat(exch, chr(exc))
              hold exchl = exchl + 1
              hold exi = exi + 1
            }
          } otherwise {
            when exc == 47 {
              hold exc2 = 0
              when exi + 1 < n {
                hold exc2 = sx_index(source, exi + 1)
              }
              when exc2 == 47 {
                hold excm = 1
              }
            }
            when exc == 123 || exc == 125 || exc == 10 {
              hold exst = 1
            } otherwise {
              when exc == 32 || exc == 9 || exc == 13 {
              } otherwise {
                hold exst = 0
              }
            }
            hold exch = concat(exch, chr(exc))
            hold exchl = exchl + 1
            hold exi = exi + 1
          }
        }
      }
    }
  }
  // flush the tail chunk (both levels)
  when exchl > 0 {
    hold exm = concat(exm, exch)
    hold exch = ""
    hold exchl = 0
    hold exml = len(exm)
  }
  when exml > 0 {
    hold exs = concat(exs, exm)
    hold exm = ""
    hold exml = 0
  }
  when exmore == 1 {
    hold source = exs
    hold n = len(source)
  }
}

// ---- malformed number literals (`1.2.3`) are rejected up front ----------
// Every number reader below accepts `.digits` once more each time it sees
// one, so a second fractional part would be copied into the C as `1.2.3`
// (a C compile error).  One scan over the spliced source, skipping strings,
// `//` comments and identifiers (so `p.x1.y` is not a number), catches it.
// (all scan variables are declared here: a first `hold` inside a block
// becomes a C local of that block)
hold nqp = 0
hold nqc = 0
hold nqn = 0
hold nqk = 0
hold nqf = 0
while nqp < n {
  hold nqc = sx_index(source,nqp)
  hold nqn = 0
  when nqp + 1 < n {
    hold nqn = sx_index(source,nqp + 1)
  }
  when nqc == 34 {
    // a string literal: skip to the closing quote, honouring backslashes
    hold nqp = nqp + 1
    hold nqk = 1
    while nqk == 1 {
      when nqp >= n {
        hold nqk = 0
      } otherwise {
        hold nqc = sx_index(source,nqp)
        when nqc == 92 {
          hold nqp = nqp + 2
        } otherwise {
          hold nqp = nqp + 1
          when nqc == 34 {
            hold nqk = 0
          }
        }
      }
    }
  } otherwise {
    when nqc == 47 && nqn == 47 {
      // a line comment: skip to the end of the line
      hold nqk = 1
      while nqk == 1 {
        when nqp >= n {
          hold nqk = 0
        } otherwise {
          hold nqc = sx_index(source,nqp)
          when nqc == 10 {
            hold nqk = 0
          } otherwise {
            hold nqp = nqp + 1
          }
        }
      }
    } otherwise {
      when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || nqc == 95 {
        // an identifier, digits included
        hold nqk = 1
        while nqk == 1 {
          when nqp >= n {
            hold nqk = 0
          } otherwise {
            hold nqc = sx_index(source,nqp)
            when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || (nqc >= 48 && nqc <= 57) || nqc == 95 {
              hold nqp = nqp + 1
            } otherwise {
              hold nqk = 0
            }
          }
        }
      } otherwise {
        when nqc >= 48 && nqc <= 57 {
          // a number: digits, then at most one `.digits`
          hold nqf = 0
          hold nqk = 1
          while nqk == 1 {
            when nqp >= n {
              hold nqk = 0
            } otherwise {
              hold nqc = sx_index(source,nqp)
              hold nqn = 0
              when nqp + 1 < n {
                hold nqn = sx_index(source,nqp + 1)
              }
              when nqc >= 48 && nqc <= 57 {
                hold nqp = nqp + 1
              } otherwise {
                when nqc == 46 && nqn >= 48 && nqn <= 57 {
                  when nqf == 1 {
                    when perr == 0 {
                      hold permsg = "malformed number literal (a number has at most one '.', as in 2.5)"
                    }
                    hold perr = 1
                  }
                  hold nqf = 1
                  hold nqp = nqp + 1
                } otherwise {
                  hold nqk = 0
                }
              }
            }
          }
        } otherwise {
          hold nqp = nqp + 1
        }
      }
    }
  }
}
// =====================================================================
// function signature table (full language)
//
//   make NAME(a, b: str) -> num
//
// Collected in one pass over the spliced source BEFORE the main scan, so a
// call can be typed even when the `make` line appears later in the file
// (forward references are already allowed).  Three flat tables:
//
//   fsret  |name=K|          K is n (num), s (str) or l (list)
//   fsptx  |name=double a, char *b|
//   fspk   |name=ns|
//
// A function with no annotations stays numeric, exactly as before, so the
// pure-min dialect is unchanged.
// =====================================================================
hold fsret = "|"
hold fsptx = "|"
hold fspk = "|"
hold fsi = 0
hold fsstart = 1
hold fsstr = 0
hold fscm = 0
hold fsw = ""
hold fsj = 0
hold fsnx = 0
hold fsp = 0
hold fsname = ""
hold fsrun = 0
hold fsc3 = 0
hold fstx = ""
hold fspks = ""
hold fspfirst = 0
hold fsprun = 0
hold fspn = ""
hold fspk2 = 0
hold fstype = ""
hold fsret2 = 0
hold fsc4 = 0
hold fshave = 0
hold fsrk = ""
hold fsrkl = 0
hold fsrl = 0
hold fsri = 0
hold fsok = 0
hold fsrj = 0
hold fsra = 0
hold fsrb = 0
hold fsc2 = 0
hold fsc = 0
while fsi < n {
  hold fsc = sx_index(source, fsi)
  when fsstr == 1 {
    // inside a string literal
    when fsc == 92 {
      hold fsi = fsi + 2
    } otherwise {
      when fsc == 34 {
        hold fsstr = 0
      }
      hold fsi = fsi + 1
    }
  } otherwise {
    when fscm == 1 {
      // inside a // comment
      when fsc == 10 {
        hold fscm = 0
        hold fsstart = 1
      }
      hold fsi = fsi + 1
    } otherwise {
      when fsc == 34 {
        hold fsstr = 1
        hold fsstart = 0
        hold fsi = fsi + 1
      } otherwise {
        when fsstart == 1 && fsc == 109 && fsi + 4 <= n {
          hold fsw = ""
          hold fsj = 0
          while fsj < 4 {
            hold fsw = concat(fsw, chr(sx_index(source, fsi + fsj)))
            hold fsj = fsj + 1
          }
          hold fsnx = 0
          when fsi + 4 < n {
            hold fsnx = sx_index(source, fsi + 4)
          }
          when sx_eq(fsw, "make") && (fsnx == 32 || fsnx == 9 || fsnx == 40) {
            // ---- parse `make NAME ( params ) -> TYPE` ----
            hold fsp = fsi + 4
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsname = ""
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                  hold fsname = concat(fsname, chr(fsc3))
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsc3 = 0
            when fsp < n {
              hold fsc3 = sx_index(source, fsp)
            }
            when fsc3 == 40 && sx_eq(fsname, "") == 0 {
              hold fsp = fsp + 1
              hold fstx = ""
              hold fspks = ""
              hold fspfirst = 1
              hold fsprun = 1
              while fsprun == 1 {
                hold fsc3 = 0
                when fsp < n {
                  hold fsc3 = sx_index(source, fsp)
                }
                when fsp >= n {
                  hold fsprun = 0
                } otherwise {
                  when fsc3 == 41 {
                    hold fsp = fsp + 1
                    hold fsprun = 0
                  } otherwise {
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 || fsc3 == 44 {
                      hold fsp = fsp + 1
                    } otherwise {
                      when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || fsc3 == 95 {
                        hold fspn = ""
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                              hold fspn = concat(fspn, chr(fsc3))
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fspk2 = 110
                        hold fsc3 = 0
                        when fsp < n {
                          hold fsc3 = sx_index(source, fsp)
                        }
                        when fsc3 == 58 {
                          hold fsp = fsp + 1
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          hold fstype = ""
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) {
                                hold fstype = concat(fstype, chr(fsc3))
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          when sx_eq(fstype, "str") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "string") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "list") {
                            hold fspk2 = 108
                          }
                          when sx_eq(fstype, "num") || sx_eq(fstype, "number") || sx_eq(fstype, "bool") || sx_eq(fstype, "double") {
                            hold fspk2 = 110
                          }
                        }
                        when fspfirst == 0 {
                          hold fstx = concat(fstx, ", ")
                        }
                        when fspk2 == 115 {
                          hold fstx = concat(fstx, "char *")
                        } otherwise {
                          when fspk2 == 108 {
                            hold fstx = concat(fstx, "sx_list *")
                          } otherwise {
                            hold fstx = concat(fstx, "double ")
                          }
                        }
                        hold fstx = concat(fstx, fspn)
                        hold fspks = concat(fspks, chr(fspk2))
                        hold fspfirst = 0
                      } otherwise {
                        hold fsp = fsp + 1
                      }
                    }
                  }
                }
              }
              // optional `-> TYPE`
              hold fsrun = 1
              while fsrun == 1 {
                when fsp >= n {
                  hold fsrun = 0
                } otherwise {
                  hold fsc3 = sx_index(source, fsp)
                  when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                    hold fsp = fsp + 1
                  } otherwise {
                    hold fsrun = 0
                  }
                }
              }
              hold fsret2 = 110
              hold fsc3 = 0
              hold fsc4 = 0
              when fsp < n {
                hold fsc3 = sx_index(source, fsp)
              }
              when fsp + 1 < n {
                hold fsc4 = sx_index(source, fsp + 1)
              }
              when fsc3 == 45 && fsc4 == 62 {
                hold fsp = fsp + 2
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                hold fstype = ""
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) {
                      hold fstype = concat(fstype, chr(fsc3))
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                when sx_eq(fstype, "str") || sx_eq(fstype, "string") {
                  hold fsret2 = 115
                }
                when sx_eq(fstype, "list") {
                  hold fsret2 = 108
                }
              }
              // record it once (a later redefinition keeps the first)
              hold fsrk = concat("|", fsname)
              hold fsrk = concat(fsrk, "=")
              hold fsrkl = len(fsrk)
              hold fsrl = len(fsret)
              hold fsri = 0
              hold fshave = 0
              while fsri + fsrkl <= fsrl {
                hold fsok = 1
                hold fsrj = 0
                while fsrj < fsrkl {
                  hold fsra = sx_index(fsret, fsri + fsrj)
                  hold fsrb = sx_index(fsrk, fsrj)
                  when fsra == fsrb {
                    hold fsrj = fsrj + 1
                  } otherwise {
                    hold fsok = 0
                    hold fsrj = fsrkl
                  }
                }
                when fsok == 1 {
                  hold fshave = 1
                  hold fsri = fsrl
                } otherwise {
                  hold fsri = fsri + 1
                }
              }
              when fshave == 0 {
                hold fsret = concat(fsret, fsname)
                hold fsret = concat(fsret, "=")
                hold fsret = concat(fsret, chr(fsret2))
                hold fsret = concat(fsret, "|")
                hold fsptx = concat(fsptx, fsname)
                hold fsptx = concat(fsptx, "=")
                hold fsptx = concat(fsptx, fstx)
                hold fsptx = concat(fsptx, "|")
                hold fspk = concat(fspk, fsname)
                hold fspk = concat(fspk, "=")
                hold fspk = concat(fspk, fspks)
                hold fspk = concat(fspk, "|")
              }
              hold fsi = fsp
              hold fsstart = 0
            } otherwise {
              hold fsstart = 0
              hold fsi = fsi + 1
            }
          } otherwise {
            when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
              hold fsstart = 1
            } otherwise {
              when fsc == 32 || fsc == 9 || fsc == 13 {
              } otherwise {
                hold fsstart = 0
              }
            }
            hold fsi = fsi + 1
          }
        } otherwise {
          when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
            hold fsstart = 1
          } otherwise {
            when fsc == 32 || fsc == 9 || fsc == 13 {
            } otherwise {
              hold fsstart = 0
            }
          }
          hold fsi = fsi + 1
        }
      }
    }
  }
}
while running == 1 {

  // ---- phase 1: skip blanks and // comments ----
  hold skipw = 1
  while skipw == 1 {
    when pos >= n {
      hold skipw = 0
      hold running = 0
    } otherwise {
      hold c = sx_index(source,pos)
      hold isspace = 0
      when c == 32 || c == 9 || c == 13 || c == 10 {
        hold isspace = 1
      }
      when isspace == 1 {
        hold pos = pos + 1
      } otherwise {
        when c == 47 {
          hold c2 = 0
          when pos + 1 < n {
            hold c2 = sx_index(source,pos + 1)
          }
          when c2 == 47 {
            // line comment: run to the end of the line
            hold pos = pos + 2
            hold skipc = 1
            while skipc == 1 {
              when pos >= n {
                hold skipc = 0
                hold running = 0
              } otherwise {
                hold c3 = sx_index(source,pos)
                when c3 == 10 {
                  hold skipc = 0
                } otherwise {
                  hold pos = pos + 1
                }
              }
            }
          } otherwise {
            hold pos = pos + 1
          }
        } otherwise {
          hold skipw = 0
        }
      }
    }
  }

  // ---- phase 2: one statement ----
  when running == 1 {
    hold c = sx_index(source,pos)

    // dispatch on the first character; act is 0 for "not a statement"
    hold act = 0
    when c == 104 {
      hold act = 1
    }
    when c == 115 {
      hold kw = ""
      hold ki = 0
      while ki < 6 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      hold act = 2
      when sx_eq(kw, "struct") {
        hold act = 7
      }
    }
    when c == 119 {
      hold act = 3
    }
    when c == 125 {
      hold act = 4
    }
    // make
    when c == 109 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "make") {
        hold act = 5
      }
    }
    // give
    when c == 103 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sx_index(source, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "give") {
        hold act = 6
      }
    }

    // ---- statement pre-checks (run before the per-statement blocks) ----
    //  * a statement word must be a WHOLE keyword: `hello = 1` is not `hold`
    //    and `write_file(p, s)` is not `while`.  An unknown statement is a
    //    clear error (its line is skipped), never C that fails to compile.
    //  * bare `push(xs, v)` compiles as `hold xs = push(xs, v)` (act 1 with
    //    bpush = 1); xs must already be a list.
    //  * a hold/show expression with a grouping paren, `(a + 3) * 4`, goes
    //    through the same verbatim-C + `%` rewrite as conditions (act 8).
    hold bpush = 0
    hold pmode = 0
    hold pbad = 0
    hold cmpop = 0
    when (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 {
      hold uword = ""
      hold pp = pos
      hold prun = 1
      while prun == 1 {
        when pp >= n {
          hold prun = 0
        } otherwise {
          hold pc = sx_index(source, pp)
          when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
            hold uword = concat(uword, chr(pc))
            hold pp = pp + 1
          } otherwise {
            hold prun = 0
          }
        }
      }
      hold pok2 = 0
      when sx_eq(uword, "hold") || sx_eq(uword, "show") || sx_eq(uword, "when") || sx_eq(uword, "while") {
        hold pok2 = 1
      }
      when sx_eq(uword, "make") || sx_eq(uword, "give") || sx_eq(uword, "struct") {
        hold pok2 = 1
      }
      when sx_eq(uword, "push") {
        hold pok2 = 2
      }
      // full-language statements: for / break / continue
      when sx_eq(uword, "for") {
        hold pok2 = 3
      }
      when sx_eq(uword, "break") || sx_eq(uword, "continue") {
        hold pok2 = 4
      }
      when pok2 == 2 {
        // bare push(NAME, EXPR)
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pc = 0
        when pp < n {
          hold pc = sx_index(source, pp)
        }
        hold pnm = ""
        when pc == 40 {
          hold pp = pp + 1
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold pc = 0
          when pp < n {
            hold pc = sx_index(source, pp)
          }
          when pc != 44 {
            hold pnm = ""
          }
        }
        when sx_eq(pnm, "") {
          hold pmsg = "push statement: expected push(list, value) with a list variable name first, e.g. push(xs, 4)"
          hold pbad = 1
        } otherwise {
          hold psrc = ldecls
          hold pkey = concat("|", pnm)
          hold pkey = concat(pkey, "|")
          hold pfound = 0
          hold pi2 = 0
          hold pa2 = len(psrc)
          hold pb2 = len(pkey)
          while pi2 + pb2 <= pa2 {
            hold pok2 = 1
            hold pj2 = 0
            while pj2 < pb2 {
              hold pa3 = sx_index(psrc, pi2 + pj2)
              hold pb3 = sx_index(pkey, pj2)
              when pa3 == pb3 {
                hold pj2 = pj2 + 1
              } otherwise {
                hold pok2 = 0
                hold pj2 = pb2
              }
            }
            when pok2 == 1 {
              hold pfound = 1
              hold pi2 = pa2
            } otherwise {
              hold pi2 = pi2 + 1
            }
          }
          when pfound == 1 {
            hold act = 1
            hold bpush = 1
            hold nm = pnm
          } otherwise {
            hold pmsg = concat("push statement: '", pnm)
            hold pmsg = concat(pmsg, "' is not a list; hold it as a list first, e.g. hold xs = []")
            hold pbad = 1
          }
        }
      }
      // (pok2 doubles as scratch in the push search above; a push error
      // has already set pbad, and its message must win)
      when pok2 == 0 && pbad == 0 {
        hold pmsg = concat("unknown statement '", uword)
        hold pmsg = concat(pmsg, "' (statements are hold show when while make give struct, and push(xs, v))")
        hold pbad = 1
      }
      when pbad == 1 {
        // skip the rest of the line; the first such error is reported
        hold act = 9
        hold prun = 1
        while prun == 1 {
          when pos >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pos)
            when pc == 10 {
              hold prun = 0
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      // for NAME in A..B { ... }  ->  act 10 (full language)
      when pok2 == 3 && pbad == 0 {
        hold act = 10
        hold pos = pp
      }
      // break / continue -> act 11 / act 12
      when pok2 == 4 && pbad == 0 {
        when sx_eq(uword, "break") {
          hold act = 11
        } otherwise {
          hold act = 12
        }
        hold pos = pp
      }
    }
    when act == 1 || act == 2 {
      when bpush == 0 {
        hold pp = pos + 4
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pnm = ""
        when act == 1 {
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          // optional `: TYPE` annotation (full language)
          hold pc = 0
          when pp < n {
            hold pc = sx_index(source, pp)
          }
          when pc == 58 {
            hold pp = pp + 1
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold aword = ""
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                  hold aword = concat(aword, chr(pc))
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold atype = aword
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sx_index(source, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
          }
          when pp < n {
            hold pc = sx_index(source, pp)
            when pc == 61 {
              hold pp = pp + 1
            } otherwise {
              // compound assignment: NAME += EXPR (also -= *= /= %=)
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sx_index(source, pp + 1)
              }
              when pc2 == 61 {
                when pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
                  hold cmpop = pc
                  hold pp = pp + 2
                }
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sx_index(source, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
        }
        // the expression text up to the end of the line (or a // comment);
        // a `(` that does not directly follow a name is a grouping paren
        hold pexpr = ""
        hold phas = 0
        hold pq = 0
        hold pprev = 0
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sx_index(source, pp)
            when pq == 1 {
              hold pexpr = concat(pexpr, chr(pc))
              hold pp = pp + 1
              when pc == 92 {
                when pp < n {
                  hold pexpr = concat(pexpr, chr(sx_index(source, pp)))
                  hold pp = pp + 1
                }
              } otherwise {
                when pc == 34 {
                  hold pq = 0
                  hold pprev = 34
                }
              }
            } otherwise {
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sx_index(source, pp + 1)
              }
              when pc == 10 || pc == 13 || (pc == 47 && pc2 == 47) {
                hold prun = 0
              } otherwise {
                when pc == 40 {
                  when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || (pprev >= 48 && pprev <= 57) || pprev == 95 {
                  } otherwise {
                    hold phas = 1
                  }
                }
                when pc == 34 {
                  hold pq = 1
                }
                when pc != 32 && pc != 9 {
                  hold pprev = pc
                }
                hold pexpr = concat(pexpr, chr(pc))
                hold pp = pp + 1
              }
            }
          }
        }
        when phas == 1 {
          hold pmode = act
          hold act = 8
          hold pos = pp
          // trim trailing blanks -> ctrim / cl (the rewrite input)
          hold cl = len(pexpr)
          hold trim = 1
          while trim == 1 {
            when cl <= 0 {
              hold trim = 0
            } otherwise {
              hold pc = sx_index(pexpr, cl - 1)
              when pc == 32 || pc == 9 {
                hold cl = cl - 1
              } otherwise {
                hold trim = 0
              }
            }
          }
          hold ctrim = ""
          hold ci = 0
          while ci < cl {
            hold ctrim = concat(ctrim, chr(sx_index(pexpr, ci)))
            hold ci = ci + 1
          }
          // validate: numbers, numeric names, make-function calls,
          // + - * / %, comparisons, && ||, and balanced parens only
          hold pstk = ""
          hold pprev = 0
          hold pv = 0
          while pv < cl {
            hold pc = sx_index(ctrim, pv)
            hold pc2 = 0
            when pv + 1 < cl {
              hold pc2 = sx_index(ctrim, pv + 1)
            }
            hold pstep = 1
            hold pknown = 0
            when pc == 32 || pc == 9 || pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
              hold pknown = 1
            }
            when (pc >= 48 && pc <= 57) || (pc == 46 && pc2 >= 48 && pc2 <= 57) {
              hold pknown = 1
              hold pv2 = pv
              hold pdot = 0
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when pc3 >= 48 && pc3 <= 57 {
                    hold pv2 = pv2 + 1
                  } otherwise {
                    when pc3 == 46 && pdot == 0 {
                      hold pdot = 1
                      hold pv2 = pv2 + 1
                    } otherwise {
                      hold prun = 0
                    }
                  }
                }
              }
              hold pc3 = 0
              when pv2 < cl {
                hold pc3 = sx_index(ctrim, pv2)
              }
              when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || pc3 == 95 || pc3 == 46 {
                hold pmsg = "malformed number literal"
                hold pbad = 1
              }
              hold pstep = pv2 - pv
              hold pc = 48
            }
            when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || pc == 95 {
              hold pknown = 1
              hold pw = ""
              hold pv2 = pv
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || (pc3 >= 48 && pc3 <= 57) || pc3 == 95 {
                    hold pw = concat(pw, chr(pc3))
                    hold pv2 = pv2 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pstep = pv2 - pv
              hold pv3 = pv2
              hold prun = 1
              while prun == 1 {
                when pv3 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv3)
                  when pc3 == 32 || pc3 == 9 {
                    hold pv3 = pv3 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pc3 = 0
              when pv3 < cl {
                hold pc3 = sx_index(ctrim, pv3)
              }
              when pc3 == 40 {
                hold pok2 = 0
                when sx_eq(pw, "concat") || sx_eq(pw, "len") || sx_eq(pw, "chr") || sx_eq(pw, "sx_index") || sx_eq(pw, "index") || sx_eq(pw, "push") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "read_file") || sx_eq(pw, "write_file") || sx_eq(pw, "arg") || sx_eq(pw, "arg_count") || sx_eq(pw, "string_eq") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_cat") || sx_eq(pw, "sx_len") || sx_eq(pw, "sx_chr") || sx_eq(pw, "sx_idx") || sx_eq(pw, "sx_eq") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_read") || sx_eq(pw, "sx_write") || sx_eq(pw, "sx_arg") || sx_eq(pw, "sx_argc") {
                  hold pok2 = 1
                }
                when pok2 == 1 {
                  hold pmsg = concat("builtin '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold its result in a variable first")
                  hold pbad = 1
                } otherwise {
                  hold psrc = fns
                  hold pkey = concat("static double ", pw)
                  hold pkey = concat(pkey, "(")
                  hold pfound = 0
                  hold pi2 = 0
                  hold pa2 = len(psrc)
                  hold pb2 = len(pkey)
                  while pi2 + pb2 <= pa2 {
                    hold pok2 = 1
                    hold pj2 = 0
                    while pj2 < pb2 {
                      hold pa3 = sx_index(psrc, pi2 + pj2)
                      hold pb3 = sx_index(pkey, pj2)
                      when pa3 == pb3 {
                        hold pj2 = pj2 + 1
                      } otherwise {
                        hold pok2 = 0
                        hold pj2 = pb2
                      }
                    }
                    when pok2 == 1 {
                      hold pfound = 1
                      hold pi2 = pa2
                    } otherwise {
                      hold pi2 = pi2 + 1
                    }
                  }
                  when in_fn == 1 {
                    when sx_eq(pw, fn_name) {
                      hold pfound = 1
                    }
                  }
                  when pfound == 0 {
                    hold pmsg = concat("unknown function '", pw)
                    hold pmsg = concat(pmsg, "' in a parenthesized expression (define it with make first)")
                    hold pbad = 1
                  }
                }
              } otherwise {
                when pc3 == 46 || pc3 == 91 {
                  hold pmsg = concat("a field access or index on '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold the value in a variable first")
                  hold pbad = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "|")
                hold psrc = sdecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                hold pok2 = pfound
                hold psrc = ldecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "=")
                hold psrc = svars
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                when pok2 == 1 {
                  hold pmsg = concat("'", pw)
                  hold pmsg = concat(pmsg, "' is a string, list or struct; a parenthesized expression must be numeric")
                  hold pbad = 1
                }
              }
              hold pc = 97
            }
            when pc == 40 {
              hold pknown = 1
              when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || pprev == 95 {
                hold pstk = concat(pstk, "c")
              } otherwise {
                when pprev == 48 || pprev == 41 {
                  hold pmsg = "a '(' directly after a value; write an operator between them"
                  hold pbad = 1
                }
                hold pstk = concat(pstk, "g")
              }
            }
            when pc == 41 {
              hold pknown = 1
              hold pstl = len(pstk)
              when pstl == 0 {
                hold pmsg = "unbalanced ')' in a parenthesized expression"
                hold pbad = 1
              } otherwise {
                hold pw = ""
                hold pv2 = 0
                while pv2 < pstl - 1 {
                  hold pw = concat(pw, chr(sx_index(pstk, pv2)))
                  hold pv2 = pv2 + 1
                }
                hold pstk = pw
              }
            }
            when pc == 44 {
              hold pknown = 1
              hold pstl = len(pstk)
              hold pc3 = 0
              when pstl > 0 {
                hold pc3 = sx_index(pstk, pstl - 1)
              }
              when pc3 != 99 {
                hold pmsg = "a ',' outside a function call in a parenthesized expression"
                hold pbad = 1
              }
            }
            when pc == 61 || pc == 33 || pc == 38 || pc == 124 {
              hold pknown = 1
              hold pc3 = 61
              when pc == 38 || pc == 124 {
                hold pc3 = pc
              }
              when pc2 == pc3 {
                hold pstep = 2
              } otherwise {
                hold pmsg = "unsupported operator in a parenthesized expression (use == != < <= > >= && ||)"
                hold pbad = 1
              }
            }
            when pc == 60 || pc == 62 {
              hold pknown = 1
              when pc2 == 61 {
                hold pstep = 2
              }
            }
            when pknown == 0 {
              hold pmsg = concat("unexpected '", chr(pc))
              hold pmsg = concat(pmsg, "' in a parenthesized expression (strings, lists, fields and struct literals are not supported inside parentheses by this compiler)")
              hold pbad = 1
            }
            when pc != 32 && pc != 9 {
              hold pprev = pc
            }
            hold pv = pv + pstep
            // the first problem found is the one reported
            when pbad == 1 && perr == 0 {
              hold perr = 1
              hold permsg = pmsg
            }
          }
          when sx_eq(pstk, "") {
          } otherwise {
            hold pmsg = "unbalanced '(' in a parenthesized expression"
            hold pbad = 1
          }
        }
      }
    }
    when pbad == 1 {
      when perr == 0 {
        hold permsg = pmsg
      }
      hold perr = 1
    }


    // ================= hold NAME = RHS =================
    when act == 1 {
      hold declk = -1
      hold declt = ""
      // bare push(xs, v): nm is already set and pos sits on `push`
      when bpush == 0 {
        hold pos = pos + 4
        // blank skip
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // name
        hold nm = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm = concat(nm, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        // optional `: TYPE` annotation (full language): the declared kind
        // is checked against the value's kind below
        hold pc = 0
        when pos < n {
          hold pc = sx_index(source,pos)
        }
        when pc == 58 {
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold declt = ""
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || (cs >= 48 && cs <= 57) || cs == 95 {
                hold declt = concat(declt, chr(cs))
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold dtok2 = 0
          when sx_eq(declt, "str") || sx_eq(declt, "string") {
            hold declk = 1
            hold dtok2 = 1
          }
          when sx_eq(declt, "list") {
            hold declk = 2
            hold dtok2 = 1
          }
          when sx_eq(declt, "num") || sx_eq(declt, "number") || sx_eq(declt, "bool") || sx_eq(declt, "double") {
            hold declk = 0
            hold dtok2 = 1
          }
          when dtok2 == 0 {
            // a struct type name
            hold declk = 3
          }
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
        }
        // blanks then '=' (or a compound operator: `+= -= *= /= %=`)
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              when cs == 61 {
                hold pos = pos + 1
              } otherwise {
                hold cs2 = 0
                when pos + 1 < n {
                  hold cs2 = sx_index(source,pos + 1)
                }
                when cs2 == 61 {
                  when cs == 43 || cs == 45 || cs == 42 || cs == 47 || cs == 37 {
                    hold cmpop = cs
                    hold pos = pos + 2
                  }
                }
              }
              hold sk = 0
            }
          }
        }
        // blanks after the assignment operator
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // a compound assignment always targets an existing variable, and
        // the operator itself decides the kind (num vs str) so the shared
        // compound emit below can build `x = x op EXPR`
        when cmpop != 0 {
          hold found2 = 0
          hold k2 = concat("|", nm)
          hold k2 = concat(k2, "|")
          hold d2i = 0
          hold d2l = len(decls)
          hold k2l = len(k2)
          while d2i + k2l <= d2l {
            hold ok2 = 1
            hold j2 = 0
            while j2 < k2l {
              hold aa2 = sx_index(decls, d2i + j2)
              hold bb2 = sx_index(k2, j2)
              when aa2 == bb2 {
                hold j2 = j2 + 1
              } otherwise {
                hold ok2 = 0
                hold j2 = k2l
              }
            }
            when ok2 == 1 {
              hold found2 = 1
              hold d2i = d2l
            } otherwise {
              hold d2i = d2i + 1
            }
          }
          when found2 == 0 {
            hold nerrscop = 1
            when sx_eq(scopmsg, "") {
              hold scopmsg = concat("compound assignment to undeclared '", nm)
              hold scopmsg = concat(scopmsg, "'; declare it with hold first")
            }
          }
        }
        // blanks
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }

      // ---------- right hand side ----------
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }


      // RHS: string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sx_index(source,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // backslash escapes the next char: keep BOTH, so \"
                // does not terminate the literal
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sx_index(source,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
        hold rt = 1
      }


      // list literal [e, e, ...]
      when c1 == 91 {
        hold pos = pos + 1
        hold lelems = ""
        hold nels = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sx_index(source,pos)
          when cs != 93 {
            hold lr = 1
            while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold el = ""
              hold ec = 0
              when pos < n {
                hold ec = sx_index(source,pos)
              }
              when (ec >= 48 && ec <= 57) || ec == 45 {
                when ec == 45 {
                  hold el = "-"
                  hold pos = pos + 1
                }
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cd = sx_index(source,pos)
                    // a `.` followed by a digit continues the number (2.5)
                    hold cdn = 0
                    when pos + 1 < n {
                      hold cdn = sx_index(source,pos + 1)
                    }
                    when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                      hold el = concat(el, chr(cd))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              } otherwise {
                when (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) {
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sx_index(source,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold el = concat(el, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                }
              }
              // list elements are numbers: a string, list or struct variable
              // (or anything that is not a number or a name) is a clear error
              // instead of invalid C such as sx_llit(1,(double)(p))
              hold lbad = 0
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when sx_eq(el, "") {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = "list elements must be numbers or numeric variables (a list cannot hold a string, list or struct)"
                }
                hold perr = 1
              }
              when nels > 0 {
                hold lelems = concat(lelems, ",")
              }
              hold lelems = concat(lelems, "(double)(")
              hold lelems = concat(lelems, el)
              hold lelems = concat(lelems, ")")
              hold nels = nels + 1
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos < n {
                hold cs = sx_index(source,pos)
                when cs == 44 {
                  hold pos = pos + 1
                } otherwise {
                  hold lr = 0
                }
              } otherwise {
                hold lr = 0
              }
            }
          }
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sx_index(source,pos)
          when cs == 93 {
            hold pos = pos + 1
          }
        }
        // the element count in decimal (chr(48 + nels) broke at 10 elements)
        hold lnum = nels
        hold lcount = ""
        when lnum == 0 {
          hold lcount = "0"
        }
        while lnum > 0 {
          hold ldig = lnum % 10
          hold ltmp = chr(48 + ldig)
          hold lcount = concat(ltmp, lcount)
          hold lnum = lnum - ldig
          hold lnum = lnum / 10
        }
        hold rhs = "sx_llit("
        hold rhs = concat(rhs, lcount)
        when nels > 0 {
          hold rhs = concat(rhs, ",")
          hold rhs = concat(rhs, lelems)
        }
        hold rhs = concat(rhs, ")")
        hold rk = 2
        hold lt = 1
      }

      // RHS: number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sx_index(source,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sx_index(source,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // RHS: name, name + number, or call(...)
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) {
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }

        // ---- struct literal Name { vals } ----
        when c2 == 123 {
          // is nm2 a known struct?
          hold sfind2 = 0
          hold di = 0
          hold dl = len(sdefs)
          hold kl = len(nm2)
          while di < dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              when di + j >= dl {
                hold ok = 0
                hold j = kl
              } otherwise {
                hold aa = sx_index(sdefs, di + j)
                hold bb = sx_index(nm2, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
            }
            when ok == 1 {
              when di + kl < dl {
                hold aa = sx_index(sdefs, di + kl)
                when aa == 58 {
                  hold sfind2 = 1
                  hold sfpos = di
                  hold di = dl
                } otherwise {
                  hold di = di + 1
                }
              } otherwise {
                hold di = di + 1
              }
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind2 == 1 {
            hold pos = pos + 1
            hold lelems = ""
            hold nels = 0
            // Field names are walked in sdefs order (fpos..): each value must
            // be given in declaration order, a label (if present) must name
            // that field, and every field must be filled -- a short or
            // reordered literal is reported, never silently reshaped.
            hold fpos = sfpos + kl + 1
            hold fnf = 1
            hold fscan = fpos
            hold fsn = len(sdefs)
            hold frun = 1
            while frun == 1 {
              when fscan >= fsn {
                hold frun = 0
              } otherwise {
                hold fc = sx_index(sdefs, fscan)
                when fc == 59 {
                  hold frun = 0
                } otherwise {
                  when fc == 44 {
                    hold fnf = fnf + 1
                  }
                  hold fscan = fscan + 1
                }
              }
            }
            hold lr = 1
            while lr == 1 {
              // The walk re-enters itself for nested struct literals: each
              // `Name { ... }` value pushes this level's state on nstack and
              // restarts the walk for the inner struct; closing the inner
              // literal pops the frame and hands the text back as the value,
              // so the outer walk continues exactly where it left off.
              hold lr = 1
              while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos >= n {
                hold lr = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                hold savep2 = pos
                when cs == 125 {
                  hold pos = pos + 1
                  hold lr = 0
                } otherwise {
                  // ---- optional field label ----
                  hold lb = ""
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sx_index(source,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold lb = concat(lb, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sx_index(source,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold lbl = 0
                  when pos < n {
                    hold cs2 = sx_index(source,pos)
                    when cs2 == 58 {
                      hold pos = pos + 1
                      hold lbl = 1
                    }
                  }
                  when lbl == 0 {
                    // no label: what was read is the value itself
                    hold pos = savep2
                  }
                  // ---- the field this value has to fill ----
                  hold fname = ""
                  hold fkx = 0
                  hold fscan = fpos
                  hold frun = 1
                  while frun == 1 {
                    when fscan >= fsn {
                      hold frun = 0
                    } otherwise {
                      hold fc = sx_index(sdefs, fscan)
                      when fc == 44 || fc == 59 {
                        when fkx == nels {
                          hold frun = 0
                        } otherwise {
                          hold fkx = fkx + 1
                          hold fscan = fscan + 1
                        }
                      } otherwise {
                        when fkx == nels {
                          hold fname = concat(fname, chr(fc))
                        }
                        hold fscan = fscan + 1
                      }
                    }
                  }
                  when lbl == 1 {
                    hold lsame = sx_eq(lb, fname)
                    when lsame == 0 {
                      hold exbad7 = 1
                    }
                  }
                  // ---- value: number, string literal or a name ----
                  hold el = ""
                  hold ety = 0
                  hold isnest = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sx_index(source,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold ec = 0
                  when pos < n {
                    hold ec = sx_index(source,pos)
                  }
                  when (ec >= 48 && ec <= 57) || ec == 45 {
                    when ec == 45 {
                      hold el = "-"
                      hold pos = pos + 1
                    }
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        // a `.` followed by a digit continues the number (2.5)
                        hold cdn = 0
                        when pos + 1 < n {
                          hold cdn = sx_index(source,pos + 1)
                        }
                        when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                  }
                  // string literal value (escapes kept)
                  when ec == 34 {
                    hold ety = 1
                    hold pos = pos + 1
                    hold el = q
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        when cd == 34 {
                          hold pos = pos + 1
                          hold el = concat(el, q)
                          hold rn = 0
                        } otherwise {
                          when cd == 92 {
                            hold el = concat(el, bs)
                            hold pos = pos + 1
                            when pos < n {
                              hold cd2 = sx_index(source,pos)
                              hold el = concat(el, chr(cd2))
                              hold pos = pos + 1
                            }
                          } otherwise {
                            hold el = concat(el, chr(cd))
                            hold pos = pos + 1
                          }
                        }
                      }
                    }
                  }
                  // name value: a name tracked as a string is a string
                  when (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) {
                    hold el = ""
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sx_index(source,pos)
                        when (cd >= 97 && cd <= 122) || (cd >= 65 && cd <= 90) || (cd >= 48 && cd <= 57) || cd == 95 {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                    hold ety = 0
                    hold nkey = concat("|", el)
                    hold nkey = concat(nkey, "|")
                    hold ndi = 0
                    hold ndl = len(sdecls)
                    hold nkl = len(nkey)
                    while ndi + nkl <= ndl {
                      hold nok = 1
                      hold nj = 0
                      while nj < nkl {
                        hold naa = sx_index(sdecls, ndi + nj)
                        hold nbb = sx_index(nkey, nj)
                        when naa == nbb {
                          hold nj = nj + 1
                        } otherwise {
                          hold nok = 0
                          hold nj = nkl
                        }
                      }
                      when nok == 1 {
                        hold ety = 1
                        hold ndi = ndl
                      } otherwise {
                        hold ndi = ndi + 1
                      }
                    }
                  }
                  // ---- nested struct literal value: Name { ... } ----
                  // When the value is a known struct name followed by '{',
                  // descend into it: push this level's state on nstack and
                  // re-run the same walk for the inner struct.  The inner
                  // level's text is handed back as this value when it closes
                  // (see the pop after the walk).
                  hold etyname = ""
                  hold pushed = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs3 = sx_index(source,pos)
                      when cs3 == 32 || cs3 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold cs3 = 0
                  when pos < n {
                    hold cs3 = sx_index(source,pos)
                  }
                  when cs3 == 123 {
                    // is el a known struct?
                    hold sfind2 = 0
                    hold di = 0
                    hold dl = len(sdefs)
                    hold kl = len(el)
                    while di < dl {
                      hold ok = 1
                      hold j = 0
                      while j < kl {
                        when di + j >= dl {
                          hold ok = 0
                          hold j = kl
                        } otherwise {
                          hold aa = sx_index(sdefs, di + j)
                          hold bb = sx_index(el, j)
                          when aa == bb {
                            hold j = j + 1
                          } otherwise {
                            hold ok = 0
                            hold j = kl
                          }
                        }
                      }
                      when ok == 1 {
                        when di + kl < dl {
                          hold aa = sx_index(sdefs, di + kl)
                          when aa == 58 {
                            hold sfind2 = 1
                            hold sfposin = di
                            hold di = dl
                          } otherwise {
                            hold di = di + 1
                          }
                        } otherwise {
                          hold di = di + 1
                        }
                      } otherwise {
                        hold di = di + 1
                      }
                    }
                    hold doskip = 0
                    when sfind2 == 1 {
                      // dependency order: the nested struct must be declared
                      // before the struct that nests it (typedef order)
                      hold klnm2 = len(nm2)
                        hold sfposcur = fpos - klnm2 - 1
                      when sfposin > sfposcur {
                        hold nerrfwd = 1
                        hold nfwdin = el
                        hold nfwdout = nm2
                        hold doskip = 1
                      }
                    } otherwise {
                      // Name { with an unknown struct name: clear error,
                      // skip the balanced span so the outer walk stays in
                      // sync and no follow-up errors are reported
                      hold nerrunk = 1
                      hold nunknm = el
                      hold doskip = 1
                    }
                    when doskip == 1 {
                      hold isnest = 1
                      hold nst = 1
                      hold ins = 0
                      hold pos = pos + 1
                      while nst > 0 {
                        when pos >= n {
                          hold nst = 0
                        } otherwise {
                          hold cd3 = sx_index(source,pos)
                          when ins == 1 {
                            when cd3 == 92 {
                              hold pos = pos + 1
                            } otherwise {
                              when cd3 == 34 {
                                hold ins = 0
                              }
                            }
                          } otherwise {
                            when cd3 == 34 {
                              hold ins = 1
                            } otherwise {
                              when cd3 == 123 {
                                hold nst = nst + 1
                              } otherwise {
                                when cd3 == 125 {
                                  hold nst = nst - 1
                                }
                              }
                            }
                          }
                          hold pos = pos + 1
                        }
                      }
                    } otherwise {
                      // push this level's frame (nm2, lelems, nels) and
                      // re-enter the walk for the inner struct
                      hold pushed = 1
                      hold dtext = ""
                      hold dd = nels
                      when dd == 0 {
                        hold dtext = "0"
                      }
                      hold drun = 1
                      while drun == 1 {
                        when dd <= 0 {
                          hold drun = 0
                        } otherwise {
                          hold drem = dd % 10
                          hold dtext = concat(chr(48 + drem), dtext)
                          hold dd = dd - drem
                          hold dd = dd / 10
                        }
                      }
                      hold nstack = concat(nstack, nm2)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, lelems)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, dtext)
                      hold nstack = concat(nstack, nsep)
                      hold nm2 = el
                      hold el = ""
                      hold lelems = ""
                      hold nels = 0
                      hold klnm2 = len(nm2)
                      hold fpos = sfposin + klnm2 + 1
                      hold fnf = 1
                      hold fscan = fpos
                      hold fsn = len(sdefs)
                      hold frun = 1
                      while frun == 1 {
                        when fscan >= fsn {
                          hold frun = 0
                        } otherwise {
                          hold fc = sx_index(sdefs, fscan)
                          when fc == 59 {
                            hold frun = 0
                          } otherwise {
                            when fc == 44 {
                              hold fnf = fnf + 1
                            }
                            hold fscan = fscan + 1
                          }
                        }
                      }
                      hold pos = pos + 1
                    }
                  }
                  when pushed == 0 {
                  // ---- record the field type: the first literal wins ----
                  hold fkey = concat("|", nm2)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, fname)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  hold fnamelen = len(fname)
                  when (fnamelen > 0) && (isnest == 0) {
                    when fprv == -1 {
                      hold ftypes = concat(ftypes, fkey)
                      when ety == 2 {
                        hold ftypes = concat(ftypes, "2:")
                        hold ftypes = concat(ftypes, etyname)
                        hold ftypes = concat(ftypes, "|")
                      } otherwise {
                        when ety == 1 {
                          hold ftypes = concat(ftypes, "1|")
                        } otherwise {
                          hold ftypes = concat(ftypes, "0|")
                        }
                      }
                    } otherwise {
                      when fprv != ety {
                        hold exbad6 = 1
                      }
                      when ety == 2 {
                        when fprv == 2 {
                          hold sames = sx_eq(fpname, etyname)
                          when sames == 0 {
                            hold exbad6 = 1
                          }
                        }
                      }
                    }
                    when ety == 1 {
                      // `varname.field` reads as a string from now on
                      // (only for the struct the variable itself is)
                      when sx_eq(nstack, "") == 1 {
                        hold sfnew = concat("|", nm)
                        hold sfnew = concat(sfnew, ".")
                        hold sfnew = concat(sfnew, fname)
                        hold sfnew = concat(sfnew, "|")
                        hold sflds = concat(sflds, sfnew)
                      }
                    }
                  }
                  when nels > 0 {
                    hold lelems = concat(lelems, ",")
                  }
                  hold lelems = concat(lelems, el)
                  hold nels = nels + 1
                  // progress guard: a value must consume at least one char
                  when pos == savep2 {
                    hold exbad = 1
                    hold pos = pos + 1
                  }
                  }
                }
              }
              }
              when nels != fnf {
                hold exbad8 = 1
              }
              // text of the literal at this level
              hold lvtxt = "(("
              hold lvtxt = concat(lvtxt, nm2)
              hold lvtxt = concat(lvtxt, "){")
              hold lvtxt = concat(lvtxt, lelems)
              hold lvtxt = concat(lvtxt, "})")
              when sx_eq(nstack, "") == 0 {
                // this level was nested in another literal: pop the outer
                // frame, record the field type, append this level's text as
                // the value, and continue the outer walk
                hold slen = len(nstack)
                hold pi = slen - 1
                hold p2 = pi - 1
                hold p2stop = -1
                hold dt = ""
                while p2 >= 0 {
                  hold chdv = sx_index(nstack, p2)
                  when chdv >= 48 {
                    when chdv <= 57 {
                      hold dt = concat(chr(chdv), dt)
                      hold p2 = p2 - 1
                    } otherwise {
                      hold p2stop = p2
                      hold p2 = -1
                    }
                  } otherwise {
                    hold p2stop = p2
                    hold p2 = -1
                  }
                }
                hold o_nels = 0
                hold di2 = 0
                hold dl2 = len(dt)
                while di2 < dl2 {
                  hold chdv = sx_index(dt, di2)
                  hold chdv = chdv - 48
                  hold o_nels = o_nels * 10 + chdv
                  hold di2 = di2 + 1
                }
                hold p3 = p2stop - 1
                hold lt2 = ""
                hold p3stop = -1
                while p3 >= 0 {
                  hold chdv = sx_index(nstack, p3)
                  when chdv == 1 {
                    hold p3stop = p3
                    hold p3 = -1
                  } otherwise {
                    hold lt2 = concat(chr(chdv), lt2)
                    hold p3 = p3 - 1
                  }
                }
                hold p4 = p3stop - 1
                hold nt2 = ""
                hold p4stop = -1
                while p4 >= 0 {
                  hold chdv = sx_index(nstack, p4)
                  when chdv == 1 {
                    hold p4stop = p4
                    hold p4 = -1
                  } otherwise {
                    hold nt2 = concat(chr(chdv), nt2)
                    hold p4 = p4 - 1
                  }
                }
                // truncate the popped frame from the stack: keep everything
                // up to (and including) the separator that preceded it
                hold nn = ""
                hold di2 = 0
                while di2 <= p4stop {
                  hold nn = concat(nn, chr(sx_index(nstack, di2)))
                  hold di2 = di2 + 1
                }
                hold nstack = nn
                hold el = lvtxt
                hold ety = 2
                hold etyname = nm2
                hold nm2 = nt2
                hold lelems = lt2
                hold nels = o_nels
                // restore this level's field walk state
                hold sfind2 = 0
                hold di = 0
                hold dl = len(sdefs)
                hold kl = len(nm2)
                while di < dl {
                  hold ok = 1
                  hold j = 0
                  while j < kl {
                    when di + j >= dl {
                      hold ok = 0
                      hold j = kl
                    } otherwise {
                      hold aa = sx_index(sdefs, di + j)
                      hold bb = sx_index(nm2, j)
                      when aa == bb {
                        hold j = j + 1
                      } otherwise {
                        hold ok = 0
                        hold j = kl
                      }
                    }
                  }
                  when ok == 1 {
                    when di + kl < dl {
                      hold aa = sx_index(sdefs, di + kl)
                      when aa == 58 {
                        hold sfind2 = 1
                        hold sfposin = di
                        hold di = dl
                      } otherwise {
                        hold di = di + 1
                      }
                    } otherwise {
                      hold di = di + 1
                    }
                  } otherwise {
                    hold di = di + 1
                  }
                }
                when sfind2 == 1 {
                  hold fpos = sfposin + kl + 1
                } otherwise {
                  hold fpos = len(sdefs)
                }
                hold fnf = 1
                hold fscan = fpos
                hold fsn = len(sdefs)
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 59 {
                      hold frun = 0
                    } otherwise {
                      when fc == 44 {
                        hold fnf = fnf + 1
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                // the field this value fills (index nels)
                hold fname = ""
                hold fkx = 0
                hold fscan = fpos
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 44 || fc == 59 {
                      when fkx == nels {
                        hold frun = 0
                      } otherwise {
                        hold fkx = fkx + 1
                        hold fscan = fscan + 1
                      }
                    } otherwise {
                      when fkx == nels {
                        hold fname = concat(fname, chr(fc))
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                // record |nm2.fname=2:etyname| (the first literal wins)
                hold fkey = concat("|", nm2)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, fname)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  hold ftypes = concat(ftypes, fkey)
                  hold ftypes = concat(ftypes, "2:")
                  hold ftypes = concat(ftypes, etyname)
                  hold ftypes = concat(ftypes, "|")
                } otherwise {
                  when fprv != 2 {
                    hold exbad6 = 1
                  }
                  hold sames = sx_eq(fpname, etyname)
                  when sames == 0 {
                    hold exbad6 = 1
                  }
                }
                when nels > 0 {
                  hold lelems = concat(lelems, ",")
                }
                hold lelems = concat(lelems, el)
                hold nels = nels + 1
                hold lr = 1
              } otherwise {
                hold rhs = lvtxt
                hold rk = 3
                hold stname = nm2
                hold iscall = 2
              }
            }
          }
        }

        // ---- call(...) ----
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sx_index(source,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sx_index(source,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when cn == 32 || cn == 9 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          // which builtin?
          // Normalize builtin identifiers inside argument text for nested calls.
          hold argv_c = ""
          hold ai = 0
          hold al = len(argv_txt)
          hold arun = 1
          while arun == 1 {
            when ai >= al {
              hold arun = 0
            } otherwise {
              hold ac = sx_index(argv_txt,ai)
              hold islet = 0
              when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || ac == 95 {
                hold islet = 1
              }
              when islet == 1 {
                hold atok = ""
                hold tokrun = 1
                while tokrun == 1 {
                  when ai >= al {
                    hold tokrun = 0
                  } otherwise {
                    hold ac = sx_index(argv_txt,ai)
                    when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || (ac >= 48 && ac <= 57) || ac == 95 {
                      hold atok = concat(atok, chr(ac))
                      hold ai = ai + 1
                    } otherwise {
                      hold tokrun = 0
                    }
                  }
                }
                when sx_eq(atok, "concat") {
                  hold argv_c = concat(argv_c, "sx_cat")
                } otherwise {
                  when sx_eq(atok, "len") {
                    hold argv_c = concat(argv_c, "sx_len")
                  } otherwise {
                    when sx_eq(atok, "sx_index") {
                      hold argv_c = concat(argv_c, "sx_idx")
                    } otherwise {
                      when sx_eq(atok, "chr") {
                        hold argv_c = concat(argv_c, "sx_chr")
                      } otherwise {
                        when sx_eq(atok, "read_file") {
                          hold argv_c = concat(argv_c, "sx_read")
                        } otherwise {
                          when sx_eq(atok, "write_file") {
                            hold argv_c = concat(argv_c, "sx_write")
                          } otherwise {
                            when sx_eq(atok, "arg") {
                              hold argv_c = concat(argv_c, "sx_arg")
                            } otherwise {
                              when sx_eq(atok, "arg_count") {
                                hold argv_c = concat(argv_c, "sx_argc")
                              } otherwise {
                                hold argv_c = concat(argv_c, atok)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } otherwise {
                hold argv_c = concat(argv_c, chr(ac))
                hold ai = ai + 1
              }
            }
          }
          hold fk = 0
          when sx_eq(nm2, "concat") {
            hold fk = 1
          }
          when sx_eq(nm2, "len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_index") {
            hold fk = 3
          }
          when sx_eq(nm2, "chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "read_file") {
            hold fk = 5
          }
          when sx_eq(nm2, "write_file") {
            hold fk = 6
          }
          when sx_eq(nm2, "arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "arg_count") {
            hold fk = 8
          }
          when sx_eq(nm2, "string_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "sx_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "push") {
            hold fk = 10
          }
          when sx_eq(nm2, "sx_cat") {
            hold fk = 1
          }
          when sx_eq(nm2, "sx_len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_idx") {
            hold fk = 3
          }
          when sx_eq(nm2, "sx_chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "sx_read") {
            hold fk = 5
          }
          when sx_eq(nm2, "sx_write") {
            hold fk = 6
          }
          when sx_eq(nm2, "sx_arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "sx_argc") {
            hold fk = 8
          }
          hold rk = 0
          hold rhs = "0"
          when fk == 1 {
            hold rhs = concat("sx_cat(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 2 {
            hold key = concat("|", argv_c)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = concat("sx_llen(", argv_c)
              hold rhs = concat(rhs, ")")
              hold lt = 1
            } otherwise {
              hold rhs = concat("sx_len(", argv_c)
              hold rhs = concat(rhs, ")")
              hold rt = 1
            }
          }
          when fk == 3 {
            hold rhs = concat("sx_idx(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 4 {
            hold rhs = concat("sx_chr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 5 {
            hold rhs = concat("sx_read(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 6 {
            hold rhs = concat("sx_write(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 7 {
            hold rhs = concat("sx_arg(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 8 {
            hold rhs = "sx_argc()"
            hold rt = 1
          }
          when fk == 9 {
            hold rhs = concat("sx_eq(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 10 {
            // the pushed value must be a number: a plain string, list or
            // struct variable is a clear error (it was invalid C)
            hold pi2 = 0
            hold pa2 = len(argv_c)
            hold pv = 0
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              hold pi2 = pi2 + 1
              when pa3 == 44 {
                hold pv = pi2
                hold pi2 = pa2
              }
            }
            hold el = ""
            hold pv2 = 1
            hold pi2 = pv
            while pi2 < pa2 {
              hold pa3 = sx_index(argv_c, pi2)
              when (pa3 >= 97 && pa3 <= 122) || (pa3 >= 65 && pa3 <= 90) || (pa3 >= 48 && pa3 <= 57) || pa3 == 95 {
                hold el = concat(el, chr(pa3))
              } otherwise {
                hold pv2 = 0
              }
              hold pi2 = pi2 + 1
            }
            when pv2 == 1 && pv > 0 {
              hold lbad = 0
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = concat("push: '", el)
                  hold permsg = concat(permsg, "' is not a number (a list cannot hold a string, list or struct)")
                }
                hold perr = 1
              }
            }
            hold rhs = concat("sx_lpush(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 2
            hold lt = 1
          }
          when fk == 0 {
            hold rhs = concat(nm2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }

        // ---- plain name, or name + number ----
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          // is nm2 a string variable?
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          hold rk = 0
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain value: `hold l = q` copies it
          // (typed declaration from the svars table)
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            hold rk = 3
            hold stname = bsvnm
          }
          hold rhs = nm2
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sx_index(source,pos)
          }
          // a list variable as a whole value: `hold ys = xs` aliases it, as
          // in seed-min and native (it used to emit `double ys = xs;`, which
          // is invalid C).  xs[i] (c2 == '[') stays a number below; anything
          // else after a list name (xs + 1) is a clear error.
          when c2 != 91 {
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              // pos may already be past the newline (at the next statement),
              // so test for an operator rather than for the end of the line
              hold lop = 0
              when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 || c2 == 46 || c2 == 40 {
                hold lop = 1
              }
              when c2 == 47 {
                hold lop = 1
                when pos + 1 < n {
                  hold pc3 = sx_index(source, pos + 1)
                  when pc3 == 47 {
                    hold lop = 0
                  }
                }
              }
              when lop == 0 {
                hold rk = 2
              } otherwise {
                when perr == 0 {
                  hold permsg = concat("list '", nm2)
                  hold permsg = concat(permsg, "' can only be held whole (hold ys = xs) or indexed (xs[i]); no operators on a list")
                }
                hold perr = 1
              }
            }
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sx_index(source,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sx_index(source,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an index must be a number or a name closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
          // optional field chain p.x.y (text is walked as-is; when the base
          // is a struct variable the final type is resolved through the
          // svars and ftypes tables, so `l.a.x` and `hold m = l.b` work)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  // no literal fixed this field's type: it is a number
                  // (the emitted typedef uses double)
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 1 {
                    hold rk = 1
                  } otherwise {
                    hold rk = 0
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 13 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sx_index(source,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      //   ct     = the mul-level term currently being built
      //   addacc = the reduced add-level value; addop = the pending + or -
      // A single operand still emits the same text as before.
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sx_index(source,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sx_index(source,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sx_index(source,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sx_index(source,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = numtxt
          }
          // string literal operand (copied verbatim, escapes kept)
          when c3 == 34 {
            hold oq = 1
            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sx_index(source,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sx_index(source,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
                }
              }
            }
          }
          // name operand
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cn = sx_index(source,pos)
                when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                  hold nm3 = concat(nm3, chr(cn))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            // user functions were previously left as un-mapped names (and
            // the `(` then failed).  Map the builtin here with the same
            // runtime names the statement-level call path uses; the
            // argument text is copied verbatim (nested builtin calls in an
            // argument are still a documented limitation).
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sx_index(source, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sx_index(source, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
                        hold ocarg = concat(ocarg, chr(sx_index(source, pos)))
                        hold pos = pos + 1
                      }
                    } otherwise {
                      when ocx == 34 {
                        hold ocq = 0
                      }
                    }
                  } otherwise {
                    when ocx == 34 {
                      hold ocq = 1
                      hold ocarg = concat(ocarg, chr(ocx))
                      hold pos = pos + 1
                    } otherwise {
                      when ocx == 40 {
                        hold ocdepth = ocdepth + 1
                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
                hold ocmap = "sx_chr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_file") || sx_eq(nm3, "sx_read") {
                hold ocmap = "sx_read"
                hold ocstr = 1
              }
              when sx_eq(nm3, "arg") || sx_eq(nm3, "sx_arg") {
                hold ocmap = "sx_arg"
                hold ocstr = 1
              }
              when sx_eq(nm3, "sx_index") || sx_eq(nm3, "sx_idx") {
                hold ocmap = "sx_idx"
              }
              when sx_eq(nm3, "write_file") || sx_eq(nm3, "sx_write") {
                hold ocmap = "sx_write"
              }
              when sx_eq(nm3, "arg_count") || sx_eq(nm3, "sx_argc") {
                hold ocmap = "sx_argc"
              }
              when sx_eq(nm3, "string_eq") || sx_eq(nm3, "sx_eq") {
                hold ocmap = "sx_eq"
              }
              when sx_eq(nm3, "push") || sx_eq(nm3, "sx_lpush") {
                hold ocmap = "sx_lpush"
                hold oclist = 1
              }
              when sx_eq(nm3, "len") || sx_eq(nm3, "sx_len") || sx_eq(nm3, "sx_llen") {
                // list variable -> sx_llen, otherwise sx_len
                hold ocarg2 = ""
                hold ocai = 0
                hold ocbd = 1
                hold ocw = 1
                while ocw == 1 {
                  when ocai >= len(ocarg) {
                    hold ocw = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg, ocai)
                    when ocx == 40 || ocx == 91 {
                      hold ocbd = ocbd + 1
                    }
                    when ocx == 41 || ocx == 93 {
                      hold ocbd = ocbd - 1
                    }
                    when ocbd == 0 {
                      hold ocw = 0
                    } otherwise {
                      hold ocarg2 = concat(ocarg2, chr(ocx))
                    }
                    hold ocai = ocai + 1
                  }
                }
                hold ocarg3 = ""
                hold ocai = 0
                hold ocl2 = len(ocarg2)
                hold octr = 1
                while octr == 1 {
                  when ocl2 <= 0 {
                    hold octr = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg2, ocl2 - 1)
                    when ocx == 32 || ocx == 9 {
                      hold ocl2 = ocl2 - 1
                    } otherwise {
                      hold octr = 0
                    }
                  }
                }
                while ocai < ocl2 {
                  hold ocarg3 = concat(ocarg3, chr(sx_index(ocarg2, ocai)))
                  hold ocai = ocai + 1
                }
                hold ockey = concat("|", ocarg3)
                hold ockey = concat(ockey, "|")
                hold ockl = len(ockey)
                hold ocll = len(ldecls)
                hold ocli = 0
                hold oclf = 0
                while ocli + ockl <= ocll {
                  hold oclok = 1
                  hold oclj = 0
                  while oclj < ockl {
                    hold ocla = sx_index(ldecls, ocli + oclj)
                    hold oclb = sx_index(ockey, oclj)
                    when ocla == oclb {
                      hold oclj = oclj + 1
                    } otherwise {
                      hold oclok = 0
                      hold oclj = ockl
                    }
                  }
                  when oclok == 1 {
                    hold oclf = 1
                    hold ocli = ocll
                  } otherwise {
                    hold ocli = ocli + 1
                  }
                }
                when oclf == 1 {
                  hold ocmap = "sx_llen"
                  hold oclist = 1
                } otherwise {
                  hold ocmap = "sx_len"
                }
              }
              when sx_eq(ocmap, "") {
                // a user function: the return kind decides the value kind
                hold ocfrk = 0
                hold ocfky = concat("|", nm3)
                hold ocfky = concat(ocfky, "=")
                hold ocfkl = len(fsret)
                hold ocfki = 0
                hold ocfn = len(ocfky)
                while ocfki + ocfn + 1 <= ocfkl {
                  hold ocfok = 1
                  hold ocfj = 0
                  while ocfj < ocfn {
                    hold ocfa = sx_index(fsret, ocfki + ocfj)
                    hold ocfb = sx_index(ocfky, ocfj)
                    when ocfa == ocfb {
                      hold ocfj = ocfj + 1
                    } otherwise {
                      hold ocfok = 0
                      hold ocfj = ocfn
                    }
                  }
                  when ocfok == 1 {
                    hold ocfrk = sx_index(fsret, ocfki + ocfn)
                    hold ocfki = ocfkl
                  } otherwise {
                    hold ocfki = ocfki + 1
                  }
                }
                when ocfrk == 115 {
                  hold ocstr = 1
                }
                when ocfrk == 108 {
                  hold oclist = 1
                }
                hold ocmap = nm3
              }
              hold opnd = concat(ocmap, "(")
              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold c2 = 0
              when pos < n {
                hold c2 = sx_index(source,pos)
              }
              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sx_index(source,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when pos < n {
                hold cn = sx_index(source,pos)
                when cn == 93 {
                  hold pos = pos + 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          // n = 4): now string + number, number + string and - * / % on a
          // string are clear errors (seed-min rejects them the same way)
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      // ---- declared type check (full language) ----
      when declk >= 0 {
        hold dtok = 0
        when declk == 0 && rk == 0 {
          hold dtok = 1
        }
        when declk == 1 && rk == 1 {
          hold dtok = 1
        }
        when declk == 2 && rk == 2 {
          hold dtok = 1
        }
        when declk == 3 && rk == 3 {
          when sx_eq(declt, stname) {
            hold dtok = 1
          }
        }
        when dtok == 0 {
          hold nerrscop = 1
          when sx_eq(scopmsg, "") {
            hold scopmsg = concat("type error: '", nm)
            hold scopmsg = concat(scopmsg, "' is declared ")
            hold scopmsg = concat(scopmsg, declt)
            when rk == 0 {
              hold scopmsg = concat(scopmsg, " but the value is a number")
            } otherwise {
              when rk == 1 {
                hold scopmsg = concat(scopmsg, " but the value is a string")
              } otherwise {
                when rk == 2 {
                  hold scopmsg = concat(scopmsg, " but the value is a list")
                } otherwise {
                  hold scopmsg = concat(scopmsg, " but the value is a struct")
                }
              }
            }
          }
        }
      }
      // ---------- emit ----------
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold key = concat("|", nm)
      hold key = concat(key, "|")
      hold found = 0
      hold di = 0
      hold dl = len(decls)
      hold kl = len(key)
      while di + kl <= dl {
        hold ok = 1
        hold j = 0
        while j < kl {
          hold aa = sx_index(decls, di + j)
          hold bb = sx_index(key, j)
          when aa == bb {
            hold j = j + 1
          } otherwise {
            hold ok = 0
            hold j = kl
          }
        }
        when ok == 1 {
          hold found = 1
          hold di = dl
        } otherwise {
          hold di = di + 1
        }
      }
      when found == 1 {
        hold body = concat(body, ind)
        when cmpop != 0 {
          // compound assignment: NAME op= EXPR (the name is evaluated once)
          when rk == 1 {
            // strings: `+=` concatenates, the other operators are errors
            when cmpop == 43 {
              hold body = concat(body, nm)
              hold body = concat(body, " = sx_cat(")
              hold body = concat(body, nm)
              hold body = concat(body, ", ")
              hold body = concat(body, rhs)
              hold body = concat(body, ");")
              hold rt = 1
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment on a string supports only +="
            }
          } otherwise {
            when rk == 0 {
              hold body = concat(body, nm)
              hold body = concat(body, " = ")
              when cmpop == 37 {
                hold body = concat(body, "sx_mod(")
                hold body = concat(body, nm)
                hold body = concat(body, ", ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              } otherwise {
                hold body = concat(body, "(")
                hold body = concat(body, nm)
                hold body = concat(body, " ")
                hold body = concat(body, chr(cmpop))
                hold body = concat(body, " ")
                hold body = concat(body, rhs)
                hold body = concat(body, ")")
              }
              hold body = concat(body, ";")
            } otherwise {
              hold nerrscop = 1
              hold scopmsg = "compound assignment needs a number or string variable"
            }
          }
        } otherwise {
          hold body = concat(body, nm)
          hold body = concat(body, " = ")
          hold body = concat(body, rhs)
          hold body = concat(body, ";")
        }
        hold body = concat(body, nl)
      } otherwise {
        hold body = concat(body, ind)
        when cmpop != 0 {
          hold nerrscop = 1
          hold scopmsg = "compound assignment needs an existing variable; hold it first"
        }
        when rk == 1 {
          hold body = concat(body, "char *")
        } otherwise {
          when rk == 2 {
            hold body = concat(body, "sx_list *")
          } otherwise {
            when rk == 3 {
              hold body = concat(body, stname)
              hold body = concat(body, " ")
            } otherwise {
              hold body = concat(body, "double ")
            }
          }
        }
        hold body = concat(body, nm)
        hold body = concat(body, " = ")
        hold body = concat(body, rhs)
        hold body = concat(body, ";")
        hold body = concat(body, nl)
        hold decls = concat(decls, nm)
        hold decls = concat(decls, "|")
        when rk == 1 {
          hold sdecls = concat(sdecls, nm)
          hold sdecls = concat(sdecls, "|")
        }
        when rk == 2 {
          hold ldecls = concat(ldecls, nm)
          hold ldecls = concat(ldecls, "|")
        }
        when rk == 3 {
          // struct-typed variable: remembered for field-chain resolution
          hold svars = concat(svars, "|")
          hold svars = concat(svars, nm)
          hold svars = concat(svars, "=")
          hold svars = concat(svars, stname)
          hold svars = concat(svars, "|")
        }
      }
      hold holds = holds + 1
    }

    // ================= show EXPR =================
    when act == 2 {
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }


      // string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sx_index(source,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // keep the backslash and the escaped char
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sx_index(source,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
      }


      // number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sx_index(source,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sx_index(source,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // name or call
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) {
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sx_index(source,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sx_index(source,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sx_index(source,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when cn == 32 || cn == 9 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          hold fk = 0
          // Normalize builtin identifiers inside argument text for nested calls.
          hold argv_c = ""
          hold ai = 0
          hold al = len(argv_txt)
          hold arun = 1
          while arun == 1 {
            when ai >= al {
              hold arun = 0
            } otherwise {
              hold ac = sx_index(argv_txt,ai)
              hold islet = 0
              when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || ac == 95 {
                hold islet = 1
              }
              when islet == 1 {
                hold atok = ""
                hold tokrun = 1
                while tokrun == 1 {
                  when ai >= al {
                    hold tokrun = 0
                  } otherwise {
                    hold ac = sx_index(argv_txt,ai)
                    when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || (ac >= 48 && ac <= 57) || ac == 95 {
                      hold atok = concat(atok, chr(ac))
                      hold ai = ai + 1
                    } otherwise {
                      hold tokrun = 0
                    }
                  }
                }
                when sx_eq(atok, "concat") {
                  hold argv_c = concat(argv_c, "sx_cat")
                } otherwise {
                  when sx_eq(atok, "len") {
                    hold argv_c = concat(argv_c, "sx_len")
                  } otherwise {
                    when sx_eq(atok, "sx_index") {
                      hold argv_c = concat(argv_c, "sx_idx")
                    } otherwise {
                      when sx_eq(atok, "chr") {
                        hold argv_c = concat(argv_c, "sx_chr")
                      } otherwise {
                        when sx_eq(atok, "read_file") {
                          hold argv_c = concat(argv_c, "sx_read")
                        } otherwise {
                          when sx_eq(atok, "write_file") {
                            hold argv_c = concat(argv_c, "sx_write")
                          } otherwise {
                            when sx_eq(atok, "arg") {
                              hold argv_c = concat(argv_c, "sx_arg")
                            } otherwise {
                              when sx_eq(atok, "arg_count") {
                                hold argv_c = concat(argv_c, "sx_argc")
                              } otherwise {
                                hold argv_c = concat(argv_c, atok)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              } otherwise {
                hold argv_c = concat(argv_c, chr(ac))
                hold ai = ai + 1
              }
            }
          }
          when sx_eq(nm2, "concat") {
            hold fk = 1
          }
          when sx_eq(nm2, "len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_index") {
            hold fk = 3
          }
          when sx_eq(nm2, "chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "read_file") {
            hold fk = 5
          }
          when sx_eq(nm2, "write_file") {
            hold fk = 6
          }
          when sx_eq(nm2, "arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "arg_count") {
            hold fk = 8
          }
          when sx_eq(nm2, "string_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "sx_eq") {
            hold fk = 9
          }
          when sx_eq(nm2, "sx_cat") {
            hold fk = 1
          }
          when sx_eq(nm2, "sx_len") {
            hold fk = 2
          }
          when sx_eq(nm2, "sx_idx") {
            hold fk = 3
          }
          when sx_eq(nm2, "sx_chr") {
            hold fk = 4
          }
          when sx_eq(nm2, "sx_read") {
            hold fk = 5
          }
          when sx_eq(nm2, "sx_write") {
            hold fk = 6
          }
          when sx_eq(nm2, "sx_arg") {
            hold fk = 7
          }
          when sx_eq(nm2, "sx_argc") {
            hold fk = 8
          }
          hold rhs = "0"
          when fk == 1 {
            hold rhs = concat("sx_cat(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 2 {
            hold key = concat("|", argv_c)
            hold key = concat(key, "|")
            hold lfind = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = concat("sx_llen(", argv_c)
              hold rhs = concat(rhs, ")")
              hold lt = 1
            } otherwise {
              hold rhs = concat("sx_len(", argv_c)
              hold rhs = concat(rhs, ")")
              hold rt = 1
            }
          }
          when fk == 3 {
            hold rhs = concat("sx_idx(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 4 {
            hold rhs = concat("sx_chr(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 5 {
            hold rhs = concat("sx_read(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 6 {
            hold rhs = concat("sx_write(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 7 {
            hold rhs = concat("sx_arg(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rk = 1
            hold rt = 1
          }
          when fk == 8 {
            hold rhs = "sx_argc()"
            hold rt = 1
          }
          when fk == 9 {
            hold rhs = concat("sx_eq(", argv_c)
            hold rhs = concat(rhs, ")")
            hold rt = 1
          }
          when fk == 0 {
            // user-defined function call: forward the text as-is
            hold rhs = concat(nm2, "(")
            hold rhs = concat(rhs, argv_c)
            hold rhs = concat(rhs, ")")
            // a `-> str` function yields a string value
            hold frk2 = 0
            hold frky = concat("|", nm2)
            hold frky = concat(frky, "=")
            hold frky2 = len(frky)
            hold frkl = len(fsret)
            hold frki = 0
            while frki + frky2 + 1 <= frkl {
              hold frkok = 1
              hold frkj = 0
              while frkj < frky2 {
                hold frka = sx_index(fsret, frki + frkj)
                hold frkb = sx_index(frky, frkj)
                when frka == frkb {
                  hold frkj = frkj + 1
                } otherwise {
                  hold frkok = 0
                  hold frkj = frky2
                }
              }
              when frkok == 1 {
                hold frk2 = sx_index(fsret, frki + frky2)
                hold frki = frkl
              } otherwise {
                hold frki = frki + 1
              }
            }
            when frk2 == 115 {
              hold rk = 1
              hold rt = 1
            }
            when frk2 == 108 {
              hold rk = 2
              hold lt = 1
            }
          }
        }
        when iscall == 0 {
          // boolean literals (full language)
          when sx_eq(nm2, "true") {
            hold nm2 = "1"
          }
          when sx_eq(nm2, "false") {
            hold nm2 = "0"
          }
          hold rhs = nm2
          hold rk = 0
          // optional field chain p.x.y (resolved like the hold RHS base)
          hold chn = 0
          hold chfields = ""
          hold chrun = 1
          while chrun == 1 {
            hold chrun = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 46 {
              hold pos = pos + 1
              hold chfld = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold chfld = concat(chfld, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when sx_eq(chfld, "") == 1 {
                hold nerrchain = 1
                hold chainmsg = "missing field name after '.'"
              }
              when chn > 0 {
                hold chfields = concat(chfields, nsep)
              }
              hold chfields = concat(chfields, chfld)
              hold rhs = concat(rhs, ".")
              hold rhs = concat(rhs, chfld)
              hold chn = chn + 1
              hold chrun = 1
            }
          }
          when chn >= 1 {
            // which struct (if any) does the base name denote?
            hold svkey = concat("|", nm2)
            hold svkey = concat(svkey, "=")
            hold svk = len(svkey)
            hold svl = len(svars)
            hold svhit = 0
            hold svnm = ""
            hold svi = 0
            while svi + svk < svl {
              hold sveq = 1
              hold svj = 0
              while svj < svk {
                hold sva = sx_index(svars, svi + svj)
                hold svb = sx_index(svkey, svj)
                when sva == svb {
                  hold svj = svj + 1
                } otherwise {
                  hold sveq = 0
                  hold svj = svk
                }
              }
              when sveq == 1 {
                hold svhit = 1
                hold svi2 = svi + svk
                hold svrun = 1
                while svrun == 1 {
                  when svi2 >= svl {
                    hold svrun = 0
                  } otherwise {
                    hold sva = sx_index(svars, svi2)
                    when sva == 124 {
                      hold svrun = 0
                    } otherwise {
                      hold svnm = concat(svnm, chr(sva))
                      hold svi2 = svi2 + 1
                    }
                  }
                }
                hold svi = svl
              } otherwise {
                hold svi = svi + 1
              }
            }
            when svhit == 1 {
              hold curst = svnm
              hold curty = 0
              hold chi = 0
              hold chl = len(chfields)
              hold chrun = 1
              while chrun == 1 {
                hold chrun = 0
                hold chtok = ""
                hold chi2 = chi
                hold chtokrun = 1
                while chtokrun == 1 {
                  when chi2 >= chl {
                    hold chtokrun = 0
                  } otherwise {
                    hold chdv = sx_index(chfields, chi2)
                    when chdv == 1 {
                      hold chtokrun = 0
                    } otherwise {
                      hold chtok = concat(chtok, chr(chdv))
                      hold chi2 = chi2 + 1
                    }
                  }
                }
                hold chi = chi2 + 1
                hold chlast = 0
                when chi >= chl {
                  hold chlast = 1
                }
                hold fkey = concat("|", curst)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, chtok)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        hold fprv = 0
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  when chlast == 1 {
                    hold curty = 0
                  } otherwise {
                    hold nerrchain = 1
                    hold chainmsg = concat("field '", chtok)
                    hold chainmsg = concat(chainmsg, "' of struct '")
                    hold chainmsg = concat(chainmsg, curst)
                    hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                  }
                } otherwise {
                  when fprv == 2 {
                    when chlast == 1 {
                      hold curty = 2
                      hold curst = fpname
                    } otherwise {
                      hold curst = fpname
                    }
                  } otherwise {
                    when chlast == 1 {
                      hold curty = fprv
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                    }
                  }
                }
                when nerrchain == 0 {
                  when chi < chl {
                    hold chrun = 1
                  }
                }
              }
              when nerrchain == 0 {
                when curty == 2 {
                  hold rk = 3
                  hold stname = curst
                } otherwise {
                  when curty == 1 {
                    hold rk = 1
                  } otherwise {
                    hold rk = 0
                  }
                }
              }
            } otherwise {
              // base is not a struct variable: keep the old single-field
              // behaviour (string-field table, numeric otherwise)
              when chn == 1 {
                hold rk = 0
                hold sfkey = concat("|", nm2)
                hold sfkey = concat(sfkey, ".")
                hold sfkey = concat(sfkey, chfields)
                hold sfkey = concat(sfkey, "|")
                hold sfk = len(sfkey)
                hold sfl = len(sflds)
                hold sfhit = 0
                hold sfi = 0
                while sfi + sfk <= sfl {
                  hold sfeq = 1
                  hold sfj = 0
                  while sfj < sfk {
                    hold sfa = sx_index(sflds, sfi + sfj)
                    hold sfb = sx_index(sfkey, sfj)
                    when sfa == sfb {
                      hold sfj = sfj + 1
                    } otherwise {
                      hold sfeq = 0
                      hold sfj = sfk
                    }
                  }
                  when sfeq == 1 {
                    hold sfhit = 1
                    hold sfi = sfl
                  } otherwise {
                    hold sfi = sfi + 1
                  }
                }
                when sfhit == 1 {
                  hold rk = 1
                }
              } otherwise {
                hold nerrchain = 1
                hold chainmsg = concat("chaining through a non-struct value '", nm2)
                hold chainmsg = concat(chainmsg, "'")
              }
            }
          }
          // a struct result cannot enter a + - * / % chain
          when rk == 3 {
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold c2 = 0
            when pos < n {
              hold c2 = sx_index(source,pos)
            }
            when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 37 {
              hold nerrscop = 1
              hold scopmsg = "a struct value cannot be used with a + - * / % operator"
            }
            when c2 == 47 {
              hold c3 = 0
              when pos + 1 < n {
                hold c3 = sx_index(source,pos + 1)
              }
              when c3 != 47 {
                hold nerrscop = 1
                hold scopmsg = "a struct value cannot be used with a + - * / % operator"
              }
            }
          }
          hold key = concat("|", nm2)
          hold key = concat(key, "|")
          hold sfind = 0
          hold di = 0
          hold dl = len(sdecls)
          hold kl = len(key)
          while di + kl <= dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              hold aa = sx_index(sdecls, di + j)
              hold bb = sx_index(key, j)
              when aa == bb {
                hold j = j + 1
              } otherwise {
                hold ok = 0
                hold j = kl
              }
            }
            when ok == 1 {
              hold sfind = 1
              hold di = dl
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind == 1 {
            hold rk = 1
          }
          // a struct variable as a plain show value is an error (caught at
          // emit); remember the type so the message is accurate
          hold bsvkey = concat("|", nm2)
          hold bsvkey = concat(bsvkey, "=")
          hold bsvk = len(bsvkey)
          hold bsvl = len(svars)
          hold bsvhit = 0
          hold bsvnm = ""
          hold bsvi = 0
          while bsvi + bsvk < bsvl {
            hold bsvj = 0
            hold bso = 1
            while bsvj < bsvk {
              hold bsa = sx_index(svars, bsvi + bsvj)
              hold bsb = sx_index(bsvkey, bsvj)
              when bsa == bsb {
                hold bsvj = bsvj + 1
              } otherwise {
                hold bso = 0
                hold bsvj = bsvk
              }
            }
            when bso == 1 {
              hold bsvhit = 1
              hold bsvi2 = bsvi + bsvk
              hold bsvrun = 1
              while bsvrun == 1 {
                when bsvi2 >= bsvl {
                  hold bsvrun = 0
                } otherwise {
                  hold bsa = sx_index(svars, bsvi2)
                  when bsa == 124 {
                    hold bsvrun = 0
                  } otherwise {
                    hold bsvnm = concat(bsvnm, chr(bsa))
                    hold bsvi2 = bsvi2 + 1
                  }
                }
              }
              hold bsvi = bsvl
            } otherwise {
              hold bsvi = bsvi + 1
            }
          }
          when bsvhit == 1 {
            when chn == 0 {
              hold rk = 3
              hold stname = bsvnm
            }
          }
          // optional index xs[i]
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold c2 = 0
          when pos < n {
            hold c2 = sx_index(source,pos)
          }
          when c2 == 91 {
            hold pos = pos + 1
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 {
                  hold pos = pos + 1
                } otherwise {
                  hold sk = 0
                }
              }
            }
            hold ix = ""
            hold c1 = 0
            when pos < n {
              hold c1 = sx_index(source,pos)
            }
            when (c1 >= 48 && c1 <= 57) {
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cd = sx_index(source,pos)
                  when cd >= 48 && cd <= 57 {
                    hold ix = concat(ix, chr(cd))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
            } otherwise {
              when (c1 >= 97 && c1 <= 122) {
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 48 && cn <= 57) {
                      hold ix = concat(ix, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              }
            }
            hold ixok = 0
            hold sk = 1
            while sk == 1 {
              when pos >= n {
                hold sk = 0
              } otherwise {
                hold cs = sx_index(source,pos)
                when cs == 32 || cs == 9 || cs == 93 {
                  when cs == 93 {
                    hold pos = pos + 1
                    hold sk = 0
                    hold ixok = 1
                  } otherwise {
                    hold pos = pos + 1
                  }
                } otherwise {
                  hold sk = 0
                }
              }
            }
            // an index must be a number or a name closed by ']'
            when ixok == 0 {
              hold exbad3 = 1
            }
            // list or string index
            hold key = concat("|", nm2)
            hold key = concat(key, "|")
            hold lfind = 0
hold ec = 0
            hold di = 0
            hold dl = len(ldecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(ldecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold lfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
            when lfind == 1 {
              hold rhs = "sx_lget("
              hold rhs = concat(rhs, nm2)
              hold rhs = concat(rhs, ",")
              hold rhs = concat(rhs, ix)
              hold rhs = concat(rhs, ")")
              hold rk = 0
              hold lt = 1
            } otherwise {
              when sfind == 1 {
                hold rhs = "sx_idx("
                hold rhs = concat(rhs, nm2)
                hold rhs = concat(rhs, ",")
                hold rhs = concat(rhs, ix)
                hold rhs = concat(rhs, ")")
                hold rk = 0
                hold rt = 1
              }
            }
          }
        }
      }
      // ---- chained binary operands: + - * / % (* / % bind tighter) ----
      // Two registers keep precedence and left-associativity straight:
      //   ct     = the mul-level term currently being built
      //   addacc = the reduced add-level value; addop = the pending + or -
      // A single operand still emits the same text as before.
      hold ct = rhs
      hold addacc = ""
      hold addop = 0
      hold isstr = rk
      hold moreop = 1
      while moreop == 1 {
        hold moreop = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        // a '/' that starts a // comment is not division
        when c2 == 47 {
          when pos + 1 < n {
            hold cs = sx_index(source,pos + 1)
            when cs == 47 {
              hold c2 = 0
            }
          }
        }
        when c2 == 43 || c2 == 45 || c2 == 42 || c2 == 47 || c2 == 37 {
          hold opch = c2
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sx_index(source,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold numtxt = ""
          hold nm3 = ""
          hold opnd = ""
          hold opfldstr = 0
          hold c3 = 0
          when pos < n {
            hold c3 = sx_index(source,pos)
          }
          hold oq = 0
          // number operand
          when (c3 >= 48 && c3 <= 57) || c3 == 45 {
            when c3 == 45 {
              hold numtxt = "-"
              hold pos = pos + 1
            }
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cd = sx_index(source,pos)
                // a `.` followed by a digit continues the number (2.5)
                hold cdn = 0
                when pos + 1 < n {
                  hold cdn = sx_index(source,pos + 1)
                }
                when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                  hold numtxt = concat(numtxt, chr(cd))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = numtxt
          }
          // string literal operand (copied verbatim, escapes kept)
          when c3 == 34 {
            hold oq = 1
            hold pos = pos + 1
            hold opnd = q
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cq = sx_index(source,pos)
                when cq == 34 {
                  hold pos = pos + 1
                  hold opnd = concat(opnd, q)
                  hold rn = 0
                } otherwise {
                  when cq == 92 {
                    hold opnd = concat(opnd, bs)
                    hold pos = pos + 1
                    when pos < n {
                      hold cq2 = sx_index(source,pos)
                      hold opnd = concat(opnd, chr(cq2))
                      hold pos = pos + 1
                    }
                  } otherwise {
                    hold opnd = concat(opnd, chr(cq))
                    hold pos = pos + 1
                  }
                }
              }
            }
          }
          // name operand
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold rn = 1
            while rn == 1 {
              when pos >= n {
                hold rn = 0
              } otherwise {
                hold cn = sx_index(source,pos)
                when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                  hold nm3 = concat(nm3, chr(cn))
                  hold pos = pos + 1
                } otherwise {
                  hold rn = 0
                }
              }
            }
            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            // user functions were previously left as un-mapped names (and
            // the `(` then failed).  Map the builtin here with the same
            // runtime names the statement-level call path uses; the
            // argument text is copied verbatim (nested builtin calls in an
            // argument are still a documented limitation).
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sx_index(source, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sx_index(source, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
                        hold ocarg = concat(ocarg, chr(sx_index(source, pos)))
                        hold pos = pos + 1
                      }
                    } otherwise {
                      when ocx == 34 {
                        hold ocq = 0
                      }
                    }
                  } otherwise {
                    when ocx == 34 {
                      hold ocq = 1
                      hold ocarg = concat(ocarg, chr(ocx))
                      hold pos = pos + 1
                    } otherwise {
                      when ocx == 40 {
                        hold ocdepth = ocdepth + 1
                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
                hold ocmap = "sx_chr"
                hold ocstr = 1
              }
              when sx_eq(nm3, "read_file") || sx_eq(nm3, "sx_read") {
                hold ocmap = "sx_read"
                hold ocstr = 1
              }
              when sx_eq(nm3, "arg") || sx_eq(nm3, "sx_arg") {
                hold ocmap = "sx_arg"
                hold ocstr = 1
              }
              when sx_eq(nm3, "sx_index") || sx_eq(nm3, "sx_idx") {
                hold ocmap = "sx_idx"
              }
              when sx_eq(nm3, "write_file") || sx_eq(nm3, "sx_write") {
                hold ocmap = "sx_write"
              }
              when sx_eq(nm3, "arg_count") || sx_eq(nm3, "sx_argc") {
                hold ocmap = "sx_argc"
              }
              when sx_eq(nm3, "string_eq") || sx_eq(nm3, "sx_eq") {
                hold ocmap = "sx_eq"
              }
              when sx_eq(nm3, "push") || sx_eq(nm3, "sx_lpush") {
                hold ocmap = "sx_lpush"
                hold oclist = 1
              }
              when sx_eq(nm3, "len") || sx_eq(nm3, "sx_len") || sx_eq(nm3, "sx_llen") {
                // list variable -> sx_llen, otherwise sx_len
                hold ocarg2 = ""
                hold ocai = 0
                hold ocbd = 1
                hold ocw = 1
                while ocw == 1 {
                  when ocai >= len(ocarg) {
                    hold ocw = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg, ocai)
                    when ocx == 40 || ocx == 91 {
                      hold ocbd = ocbd + 1
                    }
                    when ocx == 41 || ocx == 93 {
                      hold ocbd = ocbd - 1
                    }
                    when ocbd == 0 {
                      hold ocw = 0
                    } otherwise {
                      hold ocarg2 = concat(ocarg2, chr(ocx))
                    }
                    hold ocai = ocai + 1
                  }
                }
                hold ocarg3 = ""
                hold ocai = 0
                hold ocl2 = len(ocarg2)
                hold octr = 1
                while octr == 1 {
                  when ocl2 <= 0 {
                    hold octr = 0
                  } otherwise {
                    hold ocx = sx_index(ocarg2, ocl2 - 1)
                    when ocx == 32 || ocx == 9 {
                      hold ocl2 = ocl2 - 1
                    } otherwise {
                      hold octr = 0
                    }
                  }
                }
                while ocai < ocl2 {
                  hold ocarg3 = concat(ocarg3, chr(sx_index(ocarg2, ocai)))
                  hold ocai = ocai + 1
                }
                hold ockey = concat("|", ocarg3)
                hold ockey = concat(ockey, "|")
                hold ockl = len(ockey)
                hold ocll = len(ldecls)
                hold ocli = 0
                hold oclf = 0
                while ocli + ockl <= ocll {
                  hold oclok = 1
                  hold oclj = 0
                  while oclj < ockl {
                    hold ocla = sx_index(ldecls, ocli + oclj)
                    hold oclb = sx_index(ockey, oclj)
                    when ocla == oclb {
                      hold oclj = oclj + 1
                    } otherwise {
                      hold oclok = 0
                      hold oclj = ockl
                    }
                  }
                  when oclok == 1 {
                    hold oclf = 1
                    hold ocli = ocll
                  } otherwise {
                    hold ocli = ocli + 1
                  }
                }
                when oclf == 1 {
                  hold ocmap = "sx_llen"
                  hold oclist = 1
                } otherwise {
                  hold ocmap = "sx_len"
                }
              }
              when sx_eq(ocmap, "") {
                // a user function: the return kind decides the value kind
                hold ocfrk = 0
                hold ocfky = concat("|", nm3)
                hold ocfky = concat(ocfky, "=")
                hold ocfkl = len(fsret)
                hold ocfki = 0
                hold ocfn = len(ocfky)
                while ocfki + ocfn + 1 <= ocfkl {
                  hold ocfok = 1
                  hold ocfj = 0
                  while ocfj < ocfn {
                    hold ocfa = sx_index(fsret, ocfki + ocfj)
                    hold ocfb = sx_index(ocfky, ocfj)
                    when ocfa == ocfb {
                      hold ocfj = ocfj + 1
                    } otherwise {
                      hold ocfok = 0
                      hold ocfj = ocfn
                    }
                  }
                  when ocfok == 1 {
                    hold ocfrk = sx_index(fsret, ocfki + ocfn)
                    hold ocfki = ocfkl
                  } otherwise {
                    hold ocfki = ocfki + 1
                  }
                }
                when ocfrk == 115 {
                  hold ocstr = 1
                }
                when ocfrk == 108 {
                  hold oclist = 1
                }
                hold ocmap = nm3
              }
              hold opnd = concat(ocmap, "(")
              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sx_index(source,pos)
                  when cs == 32 || cs == 9 || cs == 13 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold c2 = 0
              when pos < n {
                hold c2 = sx_index(source,pos)
              }
              when c2 == 46 {
                hold pos = pos + 1
                hold chfld = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold chfld = concat(chfld, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when sx_eq(chfld, "") == 1 {
                  hold nerrchain = 1
                  hold chainmsg = "missing field name after '.'"
                }
                when chn > 0 {
                  hold chfields = concat(chfields, nsep)
                }
                hold chfields = concat(chfields, chfld)
                hold opnd = concat(opnd, ".")
                hold opnd = concat(opnd, chfld)
                hold chn = chn + 1
                hold chrun = 1
              }
            }
            when chn >= 1 {
              hold svkey = concat("|", nm3)
              hold svkey = concat(svkey, "=")
              hold svk = len(svkey)
              hold svl = len(svars)
              hold svhit = 0
              hold svnm = ""
              hold svi = 0
              while svi + svk < svl {
                hold sveq = 1
                hold svj = 0
                while svj < svk {
                  hold sva = sx_index(svars, svi + svj)
                  hold svb = sx_index(svkey, svj)
                  when sva == svb {
                    hold svj = svj + 1
                  } otherwise {
                    hold sveq = 0
                    hold svj = svk
                  }
                }
                when sveq == 1 {
                  hold svhit = 1
                  hold svi2 = svi + svk
                  hold svrun = 1
                  while svrun == 1 {
                    when svi2 >= svl {
                      hold svrun = 0
                    } otherwise {
                      hold sva = sx_index(svars, svi2)
                      when sva == 124 {
                        hold svrun = 0
                      } otherwise {
                        hold svnm = concat(svnm, chr(sva))
                        hold svi2 = svi2 + 1
                      }
                    }
                  }
                  hold svi = svl
                } otherwise {
                  hold svi = svi + 1
                }
              }
              when svhit == 1 {
                hold curst = svnm
                hold curty = 0
                hold chi = 0
                hold chl = len(chfields)
                hold chrun = 1
                while chrun == 1 {
                  hold chrun = 0
                  hold chtok = ""
                  hold chi2 = chi
                  hold chtokrun = 1
                  while chtokrun == 1 {
                    when chi2 >= chl {
                      hold chtokrun = 0
                    } otherwise {
                      hold chdv = sx_index(chfields, chi2)
                      when chdv == 1 {
                        hold chtokrun = 0
                      } otherwise {
                        hold chtok = concat(chtok, chr(chdv))
                        hold chi2 = chi2 + 1
                      }
                    }
                  }
                  hold chi = chi2 + 1
                  hold chlast = 0
                  when chi >= chl {
                    hold chlast = 1
                  }
                  hold fkey = concat("|", curst)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, chtok)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  when fprv == -1 {
                    when chlast == 1 {
                      hold curty = 0
                    } otherwise {
                      hold nerrchain = 1
                      hold chainmsg = concat("field '", chtok)
                      hold chainmsg = concat(chainmsg, "' of struct '")
                      hold chainmsg = concat(chainmsg, curst)
                      hold chainmsg = concat(chainmsg, "' has no type; the chain must end there")
                    }
                  } otherwise {
                    when fprv == 2 {
                      when chlast == 1 {
                        hold curty = 2
                        hold curst = fpname
                      } otherwise {
                        hold curst = fpname
                      }
                    } otherwise {
                      when chlast == 1 {
                        hold curty = fprv
                      } otherwise {
                        hold nerrchain = 1
                        hold chainmsg = concat("field '", chtok)
                        hold chainmsg = concat(chainmsg, "' of struct '")
                        hold chainmsg = concat(chainmsg, curst)
                        hold chainmsg = concat(chainmsg, "' is not a struct; the chain must end there")
                      }
                    }
                  }
                  when nerrchain == 0 {
                    when chi < chl {
                      hold chrun = 1
                    }
                  }
                }
                when nerrchain == 0 {
                  when curty == 1 {
                    hold opfldstr = 1
                  }
                  when curty == 2 {
                    hold nerrscop = 1
                    hold scopmsg = "a struct value cannot be used with a + - * / % operator"
                  }
                }
              } otherwise {
                when chn == 1 {
                  hold opfldstr = 0
                  hold sfkey = concat("|", nm3)
                  hold sfkey = concat(sfkey, ".")
                  hold sfkey = concat(sfkey, chfields)
                  hold sfkey = concat(sfkey, "|")
                  hold sfk = len(sfkey)
                  hold sfl = len(sflds)
                  hold sfhit = 0
                  hold sfi = 0
                  while sfi + sfk <= sfl {
                    hold sfeq = 1
                    hold sfj = 0
                    while sfj < sfk {
                      hold sfa = sx_index(sflds, sfi + sfj)
                      hold sfb = sx_index(sfkey, sfj)
                      when sfa == sfb {
                        hold sfj = sfj + 1
                      } otherwise {
                        hold sfeq = 0
                        hold sfj = sfk
                      }
                    }
                    when sfeq == 1 {
                      hold sfhit = 1
                      hold sfi = sfl
                    } otherwise {
                      hold sfi = sfi + 1
                    }
                  }
                  when sfhit == 1 {
                    hold opfldstr = 1
                  }
                } otherwise {
                  hold nerrchain = 1
                  hold chainmsg = concat("chaining through a non-struct value '", nm3)
                hold chainmsg = concat(chainmsg, "'")
                }
              }
            }
            hold opcq = 0
            when pos < n {
              hold opcq = sx_index(source,pos)
            }
            // postfix [index]            // postfix [index]
            when opcq == 91 {
              hold pos = pos + 1
              hold opix = ""
              hold rn = 1
              while rn == 1 {
                when pos >= n {
                  hold rn = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 48 && cn <= 57) || (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || cn == 95 {
                    hold opix = concat(opix, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn = 0
                  }
                }
              }
              when pos < n {
                hold cn = sx_index(source,pos)
                when cn == 93 {
                  hold pos = pos + 1
                }
              }
              // list or string index (by declaration table)
              hold opk3 = concat("|", nm3)
              hold opk3 = concat(opk3, "|")
              hold opfd = 0
              hold opd3 = 0
              hold opl3 = len(ldecls)
              hold opn3 = len(opk3)
              while opd3 + opn3 <= opl3 {
                hold opok = 1
                hold opj3 = 0
                while opj3 < opn3 {
                  hold opa3 = sx_index(ldecls, opd3 + opj3)
                  hold opb3 = sx_index(opk3, opj3)
                  when opa3 == opb3 {
                    hold opj3 = opj3 + 1
                  } otherwise {
                    hold opok = 0
                    hold opj3 = opn3
                  }
                }
                when opok == 1 {
                  hold opfd = 1
                  hold opd3 = opl3
                } otherwise {
                  hold opd3 = opd3 + 1
                }
              }
              when opfd == 0 {
                hold opd3 = 0
                hold opl3 = len(sdecls)
                while opd3 + opn3 <= opl3 {
                  hold opok = 1
                  hold opj3 = 0
                  while opj3 < opn3 {
                    hold opa3 = sx_index(sdecls, opd3 + opj3)
                    hold opb3 = sx_index(opk3, opj3)
                    when opa3 == opb3 {
                      hold opj3 = opj3 + 1
                    } otherwise {
                      hold opok = 0
                      hold opj3 = opn3
                    }
                  }
                  when opok == 1 {
                    hold opfd = 2
                    hold opd3 = opl3
                  } otherwise {
                    hold opd3 = opd3 + 1
                  }
                }
              }
              when opfd == 1 {
                hold opnd = concat("sx_lget(", opnd)
                hold opnd = concat(opnd, ",")
                hold opnd = concat(opnd, opix)
                hold opnd = concat(opnd, ")")
              } otherwise {
                when opfd == 2 {
                  hold opnd = concat("sx_idx(", opnd)
                  hold opnd = concat(opnd, ",")
                  hold opnd = concat(opnd, opix)
                  hold opnd = concat(opnd, ")")
                }
              }
            }
          }
          // is the operand a string value? (string literal, or a name whose
          // base name is tracked as a string)
          hold osfind = 0
          when oq == 1 {
            hold osfind = 1
          }
          when opfldstr == 1 {
            hold osfind = 1
          }
          when (c3 >= 97 && c3 <= 122) || (c3 >= 65 && c3 <= 90) {
            hold key = concat("|", nm3)
            hold key = concat(key, "|")
            hold di = 0
            hold dl = len(sdecls)
            hold kl = len(key)
            while di + kl <= dl {
              hold ok = 1
              hold j = 0
              while j < kl {
                hold aa = sx_index(sdecls, di + j)
                hold bb = sx_index(key, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
              when ok == 1 {
                hold osfind = 1
                hold di = dl
              } otherwise {
                hold di = di + 1
              }
            }
          }
          // string chains join strings only.  A number or numeric name used
          // to be quoted as text, so `s + n` printed the NAME ("an" for
          // n = 4): now string + number, number + string and - * / % on a
          // string are clear errors (seed-min rejects them the same way)
          hold oterm = opnd
          when isstr == 1 {
            when opch != 43 {
              when perr == 0 {
                hold permsg = concat("only + works on strings (found '", chr(opch))
                hold permsg = concat(permsg, "')")
              }
              hold perr = 1
            }
            when osfind == 0 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings; '", opnd)
                hold permsg = concat(permsg, "' is not a string (a string + a number is not in the pure-min subset)")
              }
              hold perr = 1
            }
          }
          when isstr == 0 {
            when osfind == 1 {
              when perr == 0 {
                hold permsg = concat("+ joins two strings or adds two numbers; '", opnd)
                hold permsg = concat(permsg, "' is a string but the left side is not")
              }
              hold perr = 1
            }
          }
          hold moreop = 1
          when opch == 43 || opch == 45 {
            // flush the mul-level term built so far into the add accumulator
            when addop == 0 {
              hold addacc = ct
            } otherwise {
              when isstr == 1 {
                hold addacc = concat("sx_cat(", addacc)
                hold addacc = concat(addacc, ", ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              } otherwise {
                hold addacc = concat("(", addacc)
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, chr(addop))
                hold addacc = concat(addacc, " ")
                hold addacc = concat(addacc, ct)
                hold addacc = concat(addacc, ")")
              }
            }
            hold addop = opch
            hold ct = oterm
          } otherwise {
            // mul level: combine straight into the current term
            when isstr == 1 {
              hold ct = concat("sx_cat(", ct)
              hold ct = concat(ct, ", ")
              hold ct = concat(ct, oterm)
              hold ct = concat(ct, ")")
            } otherwise {
              when opch == 37 {
                // modulo truncates both operands and diagnoses a zero divisor.
                hold ct = concat("sx_mod((double)(", ct)
                hold ct = concat(ct, "),(double)(")
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, "))")
              } otherwise {
                hold ct = concat("(", ct)
                hold ct = concat(ct, " ")
                hold ct = concat(ct, chr(opch))
                hold ct = concat(ct, " ")
                // `/` always divides doubles: 10 / 4 is 2.5, never C's 2
                when opch == 47 {
                  hold ct = concat(ct, "(double)")
                }
                hold ct = concat(ct, oterm)
                hold ct = concat(ct, ")")
              }
            }
          }
        }
      }
      // flush a pending + / - at the end of the chain
      hold rhs = ct
      when addop != 0 {
        when isstr == 1 {
          hold rhs = concat("sx_cat(", addacc)
          hold rhs = concat(rhs, ", ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
          // sx_cat lives in the runtime prelude: request it (a chain that
          // starts at a struct string field set nothing else that does)
          hold rt = 1
        } otherwise {
          hold rhs = concat("(", addacc)
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, chr(addop))
          hold rhs = concat(rhs, " ")
          hold rhs = concat(rhs, ct)
          hold rhs = concat(rhs, ")")
        }
      }
      hold rk = isstr

      // emit
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when rk == 3 {
        hold nerrscop = 1
        hold scopmsg = "show value cannot be a struct"
      }
      when rk == 1 {
        hold body = concat(body, "puts(")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      when rk == 0 || rk == 2 {
        hold body = concat(body, "printf(\"%g\\n\", (double)")
        hold body = concat(body, rhs)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
      }
      hold shows = shows + 1
    }

    // ================= while/when condition =================
    // Preserve the pure-min expression grammar as valid C expression text.
    // This covers NAME OP NAME, NAME + NUMBER OP NUMBER, and && / || chains.
    when act == 3 {
      hold pos = pos + 1
      hold iswhile = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sx_index(source,pos)
      }

      when c1 == 104 {
        hold c2 = 0
        when pos + 1 < n {
          hold c2 = sx_index(source,pos + 1)
        }
        when c2 == 105 {
          hold iswhile = 1
        }
      }
      when iswhile == 1 {
        hold pos = pos + 4
      } otherwise {
        hold pos = pos + 3
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold cond = ""
      hold cr = 1
      while cr == 1 {
        when pos >= n {
          hold cr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 123 {
            hold cr = 0
          } otherwise {
            hold cond = concat(cond, chr(cs))
            hold pos = pos + 1
          }
        }
      }
      hold cl = len(cond)
      hold trim = 1
      while trim == 1 {
        when cl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(cond, cl - 1)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold cl = cl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold ctrim = ""
      hold ci = 0
      while ci < cl {
        hold ctrim = concat(ctrim, chr(sx_index(cond,ci)))
        hold ci = ci + 1
      }
    }

    // ================= give EXPR =================
    when act == 6 {
      hold pos = pos + 4
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold gexpr = ""
      hold gr = 1
      while gr == 1 {
        when pos >= n {
          hold gr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 10 || cs == 13 {
            hold gr = 0
          } otherwise {
            when cs == 47 {
              hold c2 = 0
              when pos + 1 < n {
                hold c2 = sx_index(source, pos + 1)
              }
              when c2 == 47 {
                hold gr = 0
              } otherwise {
                hold gexpr = concat(gexpr, chr(cs))
                hold pos = pos + 1
              }
            } otherwise {
              // `}` on a give line means the block brace was swallowed:
              // statements are newline-terminated in pure-min
              when cs == 125 {
                hold exbad4 = 1
              }
              hold gexpr = concat(gexpr, chr(cs))
              hold pos = pos + 1
            }
          }
        }
      }
      hold gl = len(gexpr)
      hold trim = 1
      while trim == 1 {
        when gl <= 0 {
          hold trim = 0
        } otherwise {
          hold cs = sx_index(gexpr, gl - 1)
          when cs == 32 || cs == 9 {
            hold gl = gl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold gtrim = ""
      hold gi = 0
      while gi < gl {
        hold gtrim = concat(gtrim, chr(sx_index(gexpr, gi)))
        hold gi = gi + 1
      }
      hold ctrim = gtrim
      hold cl = gl
    }

    // ---- shared rewrite: conditions (act 3), give (act 6) and
    //      parenthesized hold/show expressions (act 8) are verbatim C in
    //      ctrim/cl; lower `%` through checked sx_mod and make `/` a double
    //      division. Result in crepl. ----
    when act == 3 || act == 6 || act == 8 {
      // ---- rewrite '%' to the checked helper ----
      // C precedence already matches pure-min for + - * / and the
      // comparisons, so only '%' needs work here:
      //   L % R   ->   sx_mod(L, R)
      // L is the maximal * / % chain to the left, R is the next atom.
      hold crepl = ""
      hold cwi = 0
      while cwi < cl {
        hold ccx = sx_index(ctrim, cwi)
        when ccx == 34 {
          // string literal: copy verbatim, escapes kept
          hold crepl = concat(crepl, chr(ccx))
          hold cwi = cwi + 1
          hold cwrun = 1
          while cwrun == 1 {
            when cwi >= cl {
              hold cwrun = 0
            } otherwise {
              hold ccx = sx_index(ctrim, cwi)
              hold crepl = concat(crepl, chr(ccx))
              hold cwi = cwi + 1
              when ccx == 92 {
                when cwi < cl {
                  hold crepl = concat(crepl, chr(sx_index(ctrim, cwi)))
                  hold cwi = cwi + 1
                }
              } otherwise {
                when ccx == 34 {
                  hold cwrun = 0
                }
              }
            }
          }
        } otherwise {
          when ccx == 37 {
            // ---- left operand: scan back over the mul-level chain ----
            hold cwal = len(crepl)
            hold cwrun = 1
            while cwrun == 1 {
              hold cwrun = 0
              when cwal > 0 {
                hold ccx = sx_index(crepl, cwal - 1)
                when ccx == 41 || ccx == 93 {
                  // skip a balanced (..) / [..] group, then keep going
                  hold cwbd = 1
                  hold cwal = cwal - 1
                  while cwbd > 0 {
                    when cwal <= 0 {
                      hold cwbd = 0
                    } otherwise {
                      hold ccx = sx_index(crepl, cwal - 1)
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwal = cwal - 1
                    }
                  }
                  hold cwrun = 1
                } otherwise {
                  when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 || ccx == 42 || ccx == 47 || ccx == 32 || ccx == 9 {
                    hold cwal = cwal - 1
                    hold cwrun = 1
                  }
                }
              }
            }
            // ---- right operand: the next atom (with .field / [i] / (..)) ----
            hold cwri = cwi + 1
            hold cwnb = 1
            while cwnb == 1 {
              when cwri >= cl {
                hold cwnb = 0
              } otherwise {
                hold ccx = sx_index(ctrim, cwri)
                when ccx == 32 || ccx == 9 {
                  hold cwri = cwri + 1
                } otherwise {
                  hold cwnb = 0
                }
              }
            }
            hold cwre = cwri
            when cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when ccx == 45 || ccx == 43 {
                hold cwre = cwre + 1
              }
            }
            when cwre < cl {
              hold ccx = sx_index(ctrim, cwre)
              when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                hold cwnb = 1
                while cwnb == 1 {
                  when cwre >= cl {
                    hold cwnb = 0
                  } otherwise {
                    hold ccx = sx_index(ctrim, cwre)
                    when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 || ccx == 46 {
                      hold cwre = cwre + 1
                    } otherwise {
                      hold cwnb = 0
                    }
                  }
                }
              }
            }
            // postfix groups and .field, repeated
            hold cwnb = 1
            while cwnb == 1 {
              hold cwnb = 0
              when cwre < cl {
                hold ccx = sx_index(ctrim, cwre)
                when ccx == 40 || ccx == 91 {
                  hold cwbd = 0
                  hold cwrun = 1
                  while cwrun == 1 {
                    when cwre >= cl {
                      hold cwrun = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwre)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      hold cwre = cwre + 1
                      when cwbd <= 0 {
                        hold cwrun = 0
                      }
                    }
                  }
                  hold cwnb = 1
                } otherwise {
                  when ccx == 46 {
                    hold cwre = cwre + 1
                    hold cwrun = 1
                    while cwrun == 1 {
                      when cwre >= cl {
                        hold cwrun = 0
                      } otherwise {
                        hold ccx = sx_index(ctrim, cwre)
                        when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                          hold cwre = cwre + 1
                        } otherwise {
                          hold cwrun = 0
                        }
                      }
                    }
                    hold cwnb = 1
                  }
                }
              }
            }
            // ---- L, R, and cut crepl back to the start of L ----
            hold cwl = ""
            hold cwn = len(crepl)
            hold cwj = cwal
            while cwj < cwn {
              hold cwl = concat(cwl, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            hold cwr = ""
            hold cwj = cwri
            while cwj < cwre {
              hold cwr = concat(cwr, chr(sx_index(ctrim, cwj)))
              hold cwj = cwj + 1
            }
            hold cwnew = ""
            hold cwj = 0
            while cwj < cwal {
              hold cwnew = concat(cwnew, chr(sx_index(crepl, cwj)))
              hold cwj = cwj + 1
            }
            hold cwnew = concat(cwnew, "sx_mod((double)(")
            hold cwnew = concat(cwnew, cwl)
            hold cwnew = concat(cwnew, "),(double)(")
            hold cwnew = concat(cwnew, cwr)
            hold cwnew = concat(cwnew, "))")
            hold crepl = cwnew
            hold cwi = cwre
          } otherwise {
            when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || ccx == 95 {
              // ---- an identifier: lower a builtin call to its runtime
              //      helper, so a `give`, a condition or a parenthesized
              //      expression may call concat/len/chr/... directly ----
              hold cwid = ""
              hold cwj2 = cwi
              hold cww = 1
              while cww == 1 {
                when cwj2 >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwj2)
                  when (ccx >= 97 && ccx <= 122) || (ccx >= 65 && ccx <= 90) || (ccx >= 48 && ccx <= 57) || ccx == 95 {
                    hold cwid = concat(cwid, chr(ccx))
                    hold cwj2 = cwj2 + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwnx = cwj2
              hold cww = 1
              while cww == 1 {
                when cwnx >= cl {
                  hold cww = 0
                } otherwise {
                  hold ccx = sx_index(ctrim, cwnx)
                  when ccx == 32 || ccx == 9 {
                    hold cwnx = cwnx + 1
                  } otherwise {
                    hold cww = 0
                  }
                }
              }
              hold cwcall = 0
              when cwnx < cl {
                hold ccx = sx_index(ctrim, cwnx)
                when ccx == 40 {
                  hold cwcall = 1
                }
              }
              hold cwmap = ""
              // word operators and boolean literals (full language)
              when sx_eq(cwid, "and") {
                hold cwmap = "&&"
              }
              when sx_eq(cwid, "or") {
                hold cwmap = "||"
              }
              when sx_eq(cwid, "not") {
                hold cwmap = "!"
              }
              when sx_eq(cwid, "true") {
                hold cwmap = "1"
              }
              when sx_eq(cwid, "false") {
                hold cwmap = "0"
              }
              when cwcall == 1 && sx_eq(cwmap, "") {
                when sx_eq(cwid, "concat") {
                  hold cwmap = "sx_cat"
                  hold rt = 1
                }
                when sx_eq(cwid, "chr") {
                  hold cwmap = "sx_chr"
                  hold rt = 1
                }
                when sx_eq(cwid, "sx_index") {
                  hold cwmap = "sx_idx"
                  hold rt = 1
                }
                when sx_eq(cwid, "read_file") {
                  hold cwmap = "sx_read"
                  hold rt = 1
                }
                when sx_eq(cwid, "write_file") {
                  hold cwmap = "sx_write"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg") {
                  hold cwmap = "sx_arg"
                  hold rt = 1
                }
                when sx_eq(cwid, "arg_count") {
                  hold cwmap = "sx_argc"
                  hold rt = 1
                }
                when sx_eq(cwid, "string_eq") {
                  hold cwmap = "sx_eq"
                  hold rt = 1
                }
                when sx_eq(cwid, "push") {
                  hold cwmap = "sx_lpush"
                  hold lt = 1
                }
                when sx_eq(cwid, "len") {
                  // len(xs) on a list variable is sx_llen, otherwise sx_len
                  hold cwarg = ""
                  hold cwai = cwnx + 1
                  hold cwbd = 1
                  hold cww = 1
                  while cww == 1 {
                    when cwai >= cl {
                      hold cww = 0
                    } otherwise {
                      hold ccx = sx_index(ctrim, cwai)
                      when ccx == 40 || ccx == 91 {
                        hold cwbd = cwbd + 1
                      }
                      when ccx == 41 || ccx == 93 {
                        hold cwbd = cwbd - 1
                      }
                      when cwbd == 0 {
                        hold cww = 0
                      } otherwise {
                        hold cwarg = concat(cwarg, chr(ccx))
                      }
                      hold cwai = cwai + 1
                    }
                  }
                  hold cwal2 = len(cwarg)
                  hold cwt = 1
                  while cwt == 1 {
                    when cwal2 <= 0 {
                      hold cwt = 0
                    } otherwise {
                      hold ccx = sx_index(cwarg, cwal2 - 1)
                      when ccx == 32 || ccx == 9 {
                        hold cwal2 = cwal2 - 1
                      } otherwise {
                        hold cwt = 0
                      }
                    }
                  }
                  hold cwarg2 = ""
                  hold cwa2 = 0
                  while cwa2 < cwal2 {
                    hold cwarg2 = concat(cwarg2, chr(sx_index(cwarg, cwa2)))
                    hold cwa2 = cwa2 + 1
                  }
                  hold cwlkey = concat("|", cwarg2)
                  hold cwlkey = concat(cwlkey, "|")
                  hold cwlkl = len(cwlkey)
                  hold cwll = len(ldecls)
                  hold cwli = 0
                  hold cwlf = 0
                  while cwli + cwlkl <= cwll {
                    hold cwlok = 1
                    hold cwlj = 0
                    while cwlj < cwlkl {
                      hold cwla = sx_index(ldecls, cwli + cwlj)
                      hold cwlb = sx_index(cwlkey, cwlj)
                      when cwla == cwlb {
                        hold cwlj = cwlj + 1
                      } otherwise {
                        hold cwlok = 0
                        hold cwlj = cwlkl
                      }
                    }
                    when cwlok == 1 {
                      hold cwlf = 1
                      hold cwli = cwll
                    } otherwise {
                      hold cwli = cwli + 1
                    }
                  }
                  when cwlf == 1 {
                    hold cwmap = "sx_llen"
                    hold lt = 1
                  } otherwise {
                    hold cwmap = "sx_len"
                    hold rt = 1
                  }
                }
              }
              when sx_eq(cwmap, "") {
                hold crepl = concat(crepl, cwid)
              } otherwise {
                // keep the call's own spacing: only the name is replaced
                hold crepl = concat(crepl, cwmap)
              }
              hold cwi = cwj2
            } otherwise {
              hold crepl = concat(crepl, chr(ccx))
              // `/` always divides doubles (10 / 4 is 2.5, never C's 2)
              when ccx == 47 {
                hold crepl = concat(crepl, "(double)")
              }
              hold cwi = cwi + 1
            }
          }
        }
      }
    }

    // ---- while/when: emit ----
    when act == 3 {
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      hold body = concat(body, ind)
      when iswhile == 1 {
        hold body = concat(body, "while (")
        hold whiles = whiles + 1
      } otherwise {
        hold body = concat(body, "if (")
        hold whens = whens + 1
      }
      hold body = concat(body, crepl)
      hold body = concat(body, ") {")
      hold body = concat(body, nl)
      hold depth = depth + 1
      when iswhile == 1 {
        hold blk = concat(blk, "w")
        hold loopd = loopd + 1
      } otherwise {
        hold blk = concat(blk, "i")
      }
    }

    // ---- give: emit ----
    when act == 6 {
      hold body = concat(body, "  return ")
      hold body = concat(body, crepl)
      hold body = concat(body, ";")
      hold body = concat(body, nl)
    }

    // ================= hold/show with a parenthesized expression =================
    // ctrim was validated in the pre-checks and rewritten into crepl
    when act == 8 {
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when pmode == 2 {
        hold body = concat(body, ind)
        hold body = concat(body, "printf(\"%g\\n\", (double)(")
        hold body = concat(body, crepl)
        hold body = concat(body, "));")
        hold body = concat(body, nl)
        hold shows = shows + 1
      } otherwise {
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = sdecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold pok2 = pfound
        hold psrc = ldecls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "=")
        hold psrc = svars
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        when pfound == 1 {
          hold pok2 = 1
        }
        when pok2 == 1 {
          when perr == 0 {
            hold permsg = concat("cannot hold a number in '", pnm)
            hold permsg = concat(permsg, "', which already holds a string, list or struct")
          }
          hold perr = 1
        }
        hold pkey = concat("|", pnm)
        hold pkey = concat(pkey, "|")
        hold psrc = decls
        hold pfound = 0
        hold pi2 = 0
        hold pa2 = len(psrc)
        hold pb2 = len(pkey)
        while pi2 + pb2 <= pa2 {
          hold pok2 = 1
          hold pj2 = 0
          while pj2 < pb2 {
            hold pa3 = sx_index(psrc, pi2 + pj2)
            hold pb3 = sx_index(pkey, pj2)
            when pa3 == pb3 {
              hold pj2 = pj2 + 1
            } otherwise {
              hold pok2 = 0
              hold pj2 = pb2
            }
          }
          when pok2 == 1 {
            hold pfound = 1
            hold pi2 = pa2
          } otherwise {
            hold pi2 = pi2 + 1
          }
        }
        hold body = concat(body, ind)
        when pfound == 0 {
          hold body = concat(body, "double ")
          hold decls = concat(decls, pnm)
          hold decls = concat(decls, "|")
        }
        hold body = concat(body, pnm)
        hold body = concat(body, " = (")
        hold body = concat(body, crepl)
        hold body = concat(body, ");")
        hold body = concat(body, nl)
        hold holds = holds + 1
      }
    }

    // ================= } and } otherwise { and } elif =================
    when act == 4 {
      hold pos = pos + 1
      // close bookkeeping: what kind of block does this `}` end?
      // ('w' while, 'f' for, 'i' when, 'e' else, 'E' elif-chain else,
      //  'm' make)  A closed loop lowers loopd, which is what makes
      // `break`/`continue` outside a loop a compile-time error.
      hold bkc = 0
      hold bkn = len(blk)
      when bkn > 0 {
        hold bkc = sx_index(blk, bkn - 1)
        hold bkt = ""
        hold bki = 0
        while bki + 1 < bkn {
          hold bkt = concat(bkt, chr(sx_index(blk, bki)))
          hold bki = bki + 1
        }
        hold blk = bkt
      }
      when bkc == 119 || bkc == 102 {
        when loopd > 0 {
          hold loopd = loopd - 1
        }
      }
      // look ahead over blanks for the word "otherwise"
      hold wi = pos
      hold wsc = 1
      while wsc == 1 {
        when wi >= n {
          hold wsc = 0
        } otherwise {
          hold cw = sx_index(source,wi)
          when cw == 32 || cw == 9 || cw == 13 || cw == 10 {
            hold wi = wi + 1
          } otherwise {
            hold wsc = 0
          }
        }
      }
      hold wfound = 0
      hold wlen = 0
      when wi + 9 <= n {
        hold w9 = ""
        hold wk = 0
        while wk < 9 {
          hold w9 = concat(w9, chr(sx_index(source,wi + wk)))
          hold wk = wk + 1
        }
        hold wfound = sx_eq(w9, "otherwise")
        when wfound == 1 {
          hold wlen = 9
        }
      }
      // "else" is an alias of "otherwise" (must be the whole keyword)
      when wfound == 0 {
        when wi + 4 <= n {
          hold w4 = ""
          hold wk = 0
          while wk < 4 {
            hold w4 = concat(w4, chr(sx_index(source,wi + wk)))
            hold wk = wk + 1
          }
          when sx_eq(w4, "else") {
            hold wok = 1
            when wi + 4 < n {
              hold we = sx_index(source,wi + 4)
              when (we >= 97 && we <= 122) || (we >= 65 && we <= 90) || (we >= 48 && we <= 57) || we == 95 {
                hold wok = 0
              }
            }
            when wok == 1 {
              hold wfound = 1
              hold wlen = 4
            }
          }
        }
      }
      // ---- `} elif COND {` / `} else if COND {` (full language) ----
      // Both are compiled without a second parser: `} else {` is emitted
      // here and the keyword itself is rewritten to `when` in the source
      // (same byte count), so the ordinary `when` statement compiles the
      // condition - including the checked `%` rewrite - and opens a block
      // that the chain's closing `}` ends.  The chain's extra `else` level
      // is remembered as 'E' in blk and closed with the extra `}` when the
      // chain ends.
      hold iselif = 0
      hold elen = 0
      when wi + 4 <= n {
        hold ekw = ""
        hold eki = 0
        while eki < 4 {
          hold ekw = concat(ekw, chr(sx_index(source, wi + eki)))
          hold eki = eki + 1
        }
        when sx_eq(ekw, "elif") {
          hold enx = 0
          when wi + 4 < n {
            hold enx = sx_index(source, wi + 4)
          }
          hold eident = 0
          when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
            hold eident = 1
          }
          when eident == 0 {
            hold iselif = 1
            hold elen = 4
          }
        }
      }
      when iselif == 0 {
        hold ew4 = ""
        hold eki = 0
        while eki < 4 {
          when wi + eki < n {
            hold ew4 = concat(ew4, chr(sx_index(source, wi + eki)))
          }
          hold eki = eki + 1
        }
        when sx_eq(ew4, "else") {
          hold ep = wi + 4
          hold eskip = 1
          while eskip == 1 {
            hold eskip = 0
            when ep < n {
              hold ec2 = sx_index(source, ep)
              when ec2 == 32 || ec2 == 9 || ec2 == 13 {
                hold ep = ep + 1
                hold eskip = 1
              }
            }
          }
          hold eif = ""
          hold eki = 0
          while eki < 2 {
            when ep + eki < n {
              hold eif = concat(eif, chr(sx_index(source, ep + eki)))
            }
            hold eki = eki + 1
          }
          when sx_eq(eif, "if") {
            hold enx = 0
            when ep + 2 < n {
              hold enx = sx_index(source, ep + 2)
            }
            hold eident = 0
            when (enx >= 97 && enx <= 122) || (enx >= 65 && enx <= 90) || (enx >= 48 && enx <= 57) || enx == 95 {
              hold eident = 1
            }
            when eident == 0 {
              hold iselif = 1
              hold elen = ep + 2 - wi
            }
          }
        }
      }
      when iselif == 1 {
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
        // rewrite the keyword in place: `elif` -> `when`,
        // `else if` -> `when` + blanks (identical byte count)
        hold src2 = ""
        hold si = 0
        while si < wi {
          hold src2 = concat(src2, chr(sx_index(source, si)))
          hold si = si + 1
        }
        hold src2 = concat(src2, "when")
        hold si = wi + 4
        while si < wi + elen {
          hold src2 = concat(src2, " ")
          hold si = si + 1
        }
        while si < n {
          hold src2 = concat(src2, chr(sx_index(source, si)))
          hold si = si + 1
        }
        hold source = src2
        hold pos = wi
        hold blk = concat(blk, "E")
      }
      hold enormal = 1
      when iselif == 1 {
        hold enormal = 0
      }
      when wfound == 1 {
        hold enormal = 0
      }
      when wfound == 1 {
        // "} otherwise {" and "} else {" both become "} else {"
        hold pos = wi + wlen
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sx_index(source,pos)
        }
        when c2 == 123 {
          hold pos = pos + 1
        }
        hold ind = "  "
        hold wk = 0
        hold d2 = depth - 1
        while wk < d2 {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        hold body = concat(body, ind)
        hold body = concat(body, "} else {")
        hold body = concat(body, nl)
        // keep the block kind: inside an `elif` chain this else is the
        // chain's else ('E'), otherwise a plain one ('e')
        hold bkt2 = ""
        hold bkl2 = len(blk)
        when bkl2 > 0 {
          hold bkt2 = chr(sx_index(blk, bkl2 - 1))
        }
        when bkt2 == "E" {
          hold blk = concat(blk, "E")
        } otherwise {
          hold blk = concat(blk, "e")
        }
      }
      when enormal == 1 {
        // Does this `}` end an `elif` chain?  Then the chain's extra
        // `else {` level ('E' in blk) also closes here, with one more `}`.
        hold eclose = 0
        hold eck = len(blk)
        hold edone = 0
        while edone == 0 {
          when eck > 0 {
            hold ecc = sx_index(blk, eck - 1)
            when ecc == 69 {
              hold eclose = eclose + 1
              hold ekt = ""
              hold eki2 = 0
              while eki2 + 1 < eck {
                hold ekt = concat(ekt, chr(sx_index(blk, eki2)))
                hold eki2 = eki2 + 1
              }
              hold blk = ekt
              hold eck = eck - 1
            } otherwise {
              hold edone = 1
            }
          } otherwise {
            hold edone = 1
          }
        }
        when depth > 0 {
          hold depth = depth - 1
        }
        when in_fn == 1 {
          when depth == 0 {
            hold body = concat(body, "}\n\n")
            hold fns = concat(fns, body)
            hold body = saved_body
            hold in_fn = 0
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
        } otherwise {
          hold ind = "  "
          hold wk = 0
          while wk < depth {
            hold ind = concat(ind, "  ")
            hold wk = wk + 1
          }
          hold body = concat(body, ind)
          hold body = concat(body, "}")
          hold body = concat(body, nl)
        }
        // the extra closes of an `elif` chain: one per `else {` level the
        // chain opened (see the note in act 4)
        hold eci = 0
        while eci < eclose {
          when depth > 0 {
            hold depth = depth - 1
          }
          when in_fn == 1 && depth == 0 {
            // the function body was just flushed; the extra brace still
            // belongs to the function text
            hold fns = concat(fns, "}\n")
          } otherwise {
            hold ind = "  "
            hold wk = 0
            while wk < depth {
              hold ind = concat(ind, "  ")
              hold wk = wk + 1
            }
            hold body = concat(body, ind)
            hold body = concat(body, "}")
            hold body = concat(body, nl)
          }
          hold eci = eci + 1
        }
      }
    }

    // ================= make NAME ( params ) { =================
    when act == 5 {
      hold pos = pos + 4
      hold firstp = 1
      hold fn_params = ""
      hold fn_retkind = 110
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fn_name = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sx_index(source,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold fn_name = concat(fn_name, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 40 {
          hold pos = pos + 1
        }
      }
      hold fn_params = ""
      hold firstp = 1
      hold pr = 1
      while pr == 1 {
        when pos >= n {
          hold pr = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 41 {
            hold pos = pos + 1
            hold pr = 0
          } otherwise {
            when cs == 44 || cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || cs == 95 {
                hold pn = ""
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cn = sx_index(source,pos)
                    when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                      hold pn = concat(pn, chr(cn))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
                when firstp == 0 {
                  hold fn_params = concat(fn_params, ", ")
                }
                hold fn_params = concat(fn_params, "double ")
                hold fn_params = concat(fn_params, pn)
                hold firstp = 0
              } otherwise {
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // optional `-> TYPE` (full language): the return type is recorded by
      // the signature pre-pass, so this only has to be skipped here
      hold cs = 0
      hold cs2 = 0
      when pos < n {
        hold cs = sx_index(source,pos)
      }
      when pos + 1 < n {
        hold cs2 = sx_index(source,pos + 1)
      }
      when cs == 45 && cs2 == 62 {
        hold pos = pos + 2
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold rtword = ""
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) {
              hold rtword = concat(rtword, chr(cs))
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold fnnx = 0
        when pos < n {
          hold fnnx = sx_index(source,pos)
        }
        hold fnnx2 = 0
        when pos + 1 < n {
          hold fnnx2 = sx_index(source,pos + 1)
        }
        when sx_eq(rtword, "str") && fnnx != 45 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "str") && fnnx == 45 && fnnx2 != 62 {
          hold fn_retkind = 115
        }
        when sx_eq(rtword, "list") {
          hold fn_retkind = 108
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold saved_body = body
      hold body = ""
      when fn_retkind == 115 {
        hold body = concat(body, "static char *")
      } otherwise {
        when fn_retkind == 108 {
          hold body = concat(body, "static sx_list *")
        } otherwise {
          hold body = concat(body, "static double ")
        }
      }
      hold body = concat(body, fn_name)
      hold body = concat(body, "(")
      // the parameter list comes from the signature pre-pass:
      // `double a, char *b` for `make f(a, b: str)`
      hold fpt2 = ""
      hold fky = concat("|", fn_name)
      hold fky = concat(fky, "=")
      hold fkl = len(fky)
      hold fksrc = fsptx
      hold fki = 0
      hold fkln = len(fksrc)
      hold fkfound = 0
      while fki + fkl <= fkln {
        hold fkok = 1
        hold fkj = 0
        while fkj < fkl {
          hold fka = sx_index(fksrc, fki + fkj)
          hold fkb = sx_index(fky, fkj)
          when fka == fkb {
            hold fkj = fkj + 1
          } otherwise {
            hold fkok = 0
            hold fkj = fkl
          }
        }
        when fkok == 1 {
          hold fkfound = 1
          hold fkend = fki + fkl
          hold fkrun = 1
          while fkrun == 1 {
            when fkend >= fkln {
              hold fkrun = 0
            } otherwise {
              hold fka = sx_index(fksrc, fkend)
              when fka == 124 {
                hold fkrun = 0
              } otherwise {
                hold fpt2 = concat(fpt2, chr(fka))
                hold fkend = fkend + 1
              }
            }
          }
          hold fki = fkln
        } otherwise {
          hold fki = fki + 1
        }
      }
      when fkfound == 1 {
        hold fn_params = fpt2
      }
      hold body = concat(body, fn_params)
      hold body = concat(body, ") {")
      hold body = concat(body, nl)
      hold in_fn = 1
      hold depth = depth + 1
      hold blk = concat(blk, "m")
    }

    // ================= for NAME in A..B { =================
    // full-language statement (gen2 and later; the C seed never reads it):
    //   for i in 0..10 { ... }        counts A, A+1, ... while i < B
    // The counter is declared as a normal numeric variable the first time,
    // so it keeps the flat pure-min scoping rules; a later `for i in ...`
    // reuses it.  A and B are copied as C expressions (no `%`, which would
    // need the checked sx_mod rewrite) and are validated so nothing can
    // reach the output that is not a number, name, field, index or
    // + - * / ( ) chain.
    when act == 10 {
      // `pos` already points just past the word `for`
      hold fvname = ""
      hold fva = ""
      hold fvb = ""
      hold fvok = 0
      hold ferr = 0
      hold fmsg = ""
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // the counter name
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 {
            hold fvname = concat(fvname, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fvname, "") {
        hold ferr = 1
        hold fmsg = "for loop: expected a counter name, e.g. for i in 0..10 {"
      }
      // blanks, then the word `in`
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold fwin = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) {
            hold fwin = concat(fwin, chr(fc))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      when sx_eq(fwin, "in") {
      } otherwise {
        hold ferr = 1
        hold fmsg = "for loop: expected `in` after the counter name, e.g. for i in 0..10 {"
      }
      // blanks before A
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 32 || fc == 9 || fc == 13 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      // A (or the list, for `for v in xs {`): text up to `..` or `{`
      hold fvmode = 0
      hold fvrun = 1
      while fvrun == 1 {
        when pos >= n {
          hold fvrun = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 123 {
            // no `..`: this is `for V in LIST {`
            hold pos = pos + 1
            hold fvmode = 1
            hold fvrun = 0
          } otherwise {
            when fc == 46 {
              hold fc2 = 0
              when pos + 1 < n {
                hold fc2 = sx_index(source, pos + 1)
              }
              when fc2 == 46 {
                hold fvrun = 0
              } otherwise {
                hold fva = concat(fva, chr(fc))
                hold pos = pos + 1
              }
            } otherwise {
              when fc == 10 || fc == 13 {
                hold fvrun = 0
                hold ferr = 1
                hold fmsg = "for loop: expected `A..B` or a list name before the `{`"
              } otherwise {
                hold fva = concat(fva, chr(fc))
                hold pos = pos + 1
              }
            }
          }
        }
      }
      hold fc = 0
      when pos < n {
        hold fc = sx_index(source, pos)
      }
      when fvmode == 1 {
        hold pos = pos
      } otherwise {
        when fc == 46 {
          hold pos = pos + 2
        } otherwise {
          when ferr == 0 {
            hold ferr = 1
            hold fmsg = "for loop: expected `A..B` (two dots) before the `{`"
          }
        }
      }
      // B: text up to the `{` (range mode only)
      hold fvrun2 = 1
      while fvrun2 == 1 && fvmode == 0 {
        when pos >= n {
          hold fvrun2 = 0
        } otherwise {
          hold fc = sx_index(source, pos)
          when fc == 123 {
            hold pos = pos + 1
            hold fvrun2 = 0
          } otherwise {
            when fc == 10 || fc == 13 {
              hold fvrun2 = 0
              hold ferr = 1
              hold fmsg = "for loop: expected `{` at the end of the for line"
            } otherwise {
              hold fvb = concat(fvb, chr(fc))
              hold pos = pos + 1
            }
          }
        }
      }
      // trim both range expressions (range mode; list mode trims A below)
      hold fl = len(fva)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fva, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fva2 = ""
      hold fi = 0
      while fi < fl {
        hold fva2 = concat(fva2, chr(sx_index(fva, fi)))
        hold fi = fi + 1
      }
      hold fva = fva2
      hold fl = len(fvb)
      hold trim = 1
      while trim == 1 {
        when fl <= 0 {
          hold trim = 0
        } otherwise {
          hold fc = sx_index(fvb, fl - 1)
          when fc == 32 || fc == 9 || fc == 13 {
            hold fl = fl - 1
          } otherwise {
            hold trim = 0
          }
        }
      }
      hold fvb2 = ""
      hold fi = 0
      while fi < fl {
        hold fvb2 = concat(fvb2, chr(sx_index(fvb, fi)))
        hold fi = fi + 1
      }
      hold fvb = fvb2
      when fvmode == 1 {
        hold fvb = "1"
      }
      when sx_eq(fva, "") || sx_eq(fvb, "") {
        when ferr == 0 {
          hold ferr = 1
          hold fmsg = "for loop: the range is empty; write `for i in 0..10 {`"
        }
      }
      // validate: only characters that are safe C text for a numeric range
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fva)
      while fvi < fvln {
        hold fc = sx_index(fva, fvi)
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the start expression may use numbers, names, fields, indexes and + - * / ( ) only"
      }
      hold fvchk = 0
      hold fvi = 0
      hold fvln = len(fvb)
      while fvi < fvln {
        hold fc = sx_index(fvb, fvi)
        when (fc >= 48 && fc <= 57) || (fc >= 97 && fc <= 122) || (fc >= 65 && fc <= 90) || fc == 95 || fc == 46 {
          hold fvchk = 1
        } otherwise {
          when fc == 32 || fc == 9 || fc == 43 || fc == 45 || fc == 42 || fc == 47 || fc == 40 || fc == 41 || fc == 91 || fc == 93 {
            hold fvchk = 1
          } otherwise {
            hold fvchk = 0
            hold fvi = fvln
          }
        }
        when fvchk == 1 {
          hold fvi = fvi + 1
        } otherwise {
          hold fvi = fvln
        }
      }
      when fvchk == 0 && ferr == 0 {
        hold ferr = 1
        hold fmsg = "for loop: the end expression may use numbers, names, fields, indexes and + - * / ( ) only"
      }
      // list mode: the iterated expression must be a list variable
      when fvmode == 1 && ferr == 0 {
        hold fvlkey = concat("|", fva)
        hold fvlkey = concat(fvlkey, "|")
        hold fvlkl = len(fvlkey)
        hold fvll = len(ldecls)
        hold fvli2 = 0
        hold fvlf = 0
        while fvli2 + fvlkl <= fvll {
          hold fvlok = 1
          hold fvlj = 0
          while fvlj < fvlkl {
            hold fvla = sx_index(ldecls, fvli2 + fvlj)
            hold fvlb = sx_index(fvlkey, fvlj)
            when fvla == fvlb {
              hold fvlj = fvlj + 1
            } otherwise {
              hold fvlok = 0
              hold fvlj = fvlkl
            }
          }
          when fvlok == 1 {
            hold fvlf = 1
            hold fvli2 = fvll
          } otherwise {
            hold fvli2 = fvli2 + 1
          }
        }
        when fvlf == 0 {
          hold ferr = 1
          hold fmsg = concat("for loop: '", fva)
          hold fmsg = concat(fmsg, "' is not a list; write `for i in 0..N {` to count")
        }
      }
      // the counter must not already be a string or list
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = sdecls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            hold ferr = 1
            hold fvli = fvi
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
        when ferr == 1 {
          hold fmsg = concat("for loop: '", fvname)
          hold fmsg = concat(fmsg, "' is not a number; pick another counter name")
        }
      }
      // is the counter already declared as a number?
      when ferr == 0 {
        hold fvkey = concat("|", fvname)
        hold fvkey = concat(fvkey, "|")
        hold fvsrc = decls
        hold fvi = 0
        hold fvln = len(fvsrc)
        hold fvkl = len(fvkey)
        hold fvok = 1
        while fvi + fvkl <= fvln {
          hold fvok2 = 1
          hold fvj = 0
          while fvj < fvkl {
            hold fva3 = sx_index(fvsrc, fvi + fvj)
            hold fvb3 = sx_index(fvkey, fvj)
            when fva3 == fvb3 {
              hold fvj = fvj + 1
            } otherwise {
              hold fvok2 = 0
              hold fvj = fvkl
            }
          }
          when fvok2 == 1 {
            hold fvok = 0
            hold fvi = fvln
          } otherwise {
            hold fvi = fvi + 1
          }
        }
      }
      when ferr == 1 {
        hold nerrscop = 1
        when sx_eq(scopmsg, "") {
          hold scopmsg = fmsg
        }
      } otherwise {
        hold ind = "  "
        hold wk = 0
        while wk < depth {
          hold ind = concat(ind, "  ")
          hold wk = wk + 1
        }
        when fvok == 1 {
          hold body = concat(body, ind)
          hold body = concat(body, "double ")
          hold body = concat(body, fvname)
          hold body = concat(body, " = ")
          when fvmode == 1 {
            hold body = concat(body, "0.0")
          } otherwise {
            hold body = concat(body, fva)
          }
          hold body = concat(body, ";")
          hold body = concat(body, nl)
          hold decls = concat(decls, fvname)
          hold decls = concat(decls, "|")
        }
        when fvmode == 1 {
          // for v in xs { ... }  ->  index walk over the list
          // the walk index lives in the for-init, so C scoping gives every
          // nested list loop its own copy
          hold fvix = "__sx_ix"
          hold body = concat(body, ind)
          hold body = concat(body, "for (double ")
          hold body = concat(body, fvix)
          hold body = concat(body, " = 0.0; ")
          hold body = concat(body, fvix)
          hold body = concat(body, " < sx_llen(")
          hold body = concat(body, fva)
          hold body = concat(body, "); ")
          hold body = concat(body, fvix)
          hold body = concat(body, " = ")
          hold body = concat(body, fvix)
          hold body = concat(body, " + 1.0) {")
          hold body = concat(body, nl)
          hold lt = 1
          hold body = concat(body, ind)
          hold body = concat(body, "  ")
          hold body = concat(body, fvname)
          hold body = concat(body, " = sx_lget(")
          hold body = concat(body, fva)
          hold body = concat(body, ", ")
          hold body = concat(body, fvix)
          hold body = concat(body, ");")
          hold body = concat(body, nl)
        } otherwise {
          hold body = concat(body, ind)
          hold body = concat(body, "for (")
          hold body = concat(body, fvname)
          hold body = concat(body, " = ")
          hold body = concat(body, fva)
          hold body = concat(body, "; ")
          hold body = concat(body, fvname)
          hold body = concat(body, " < ")
          hold body = concat(body, fvb)
          hold body = concat(body, "; ")
          hold body = concat(body, fvname)
          hold body = concat(body, " = ")
          hold body = concat(body, fvname)
          hold body = concat(body, " + 1) {")
          hold body = concat(body, nl)
        }
        hold depth = depth + 1
        hold blk = concat(blk, "f")
        hold loopd = loopd + 1
      }
    }

    // ================= break / continue =================
    when act == 11 || act == 12 {
      hold ind = "  "
      hold wk = 0
      while wk < depth {
        hold ind = concat(ind, "  ")
        hold wk = wk + 1
      }
      when loopd == 0 {
        hold nerrscop = 1
        when sx_eq(scopmsg, "") {
          hold scopmsg = "break/continue outside a loop"
        }
      } otherwise {
        hold body = concat(body, ind)
        when act == 11 {
          hold body = concat(body, "break;")
        } otherwise {
          hold body = concat(body, "continue;")
        }
        hold body = concat(body, nl)
      }
    }

    // not a statement character: skip it


    // ================= struct Name { fields } =================
    when act == 7 {
      hold pos = pos + 6
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      hold stname = ""
      hold rn = 1
      while rn == 1 {
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cn = sx_index(source,pos)
          when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
            hold stname = concat(stname, chr(cn))
            hold pos = pos + 1
          } otherwise {
            hold rn = 0
          }
        }
      }
      hold sk = 1
      while sk == 1 {
        when pos >= n {
          hold sk = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
            hold pos = pos + 1
          } otherwise {
            hold sk = 0
          }
        }
      }
      when pos < n {
        hold cs = sx_index(source,pos)
        when cs == 123 {
          hold pos = pos + 1
        }
      }
      hold sfields = ""
      hold firstp = 1
      hold tdskip = 1
      hold rn = 1
      while rn == 1 {
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sx_index(source,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos >= n {
          hold rn = 0
        } otherwise {
          hold cs = sx_index(source,pos)
          when cs == 125 {
            hold pos = pos + 1
            hold rn = 0
          } otherwise {
            when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) {
              hold sf = ""
              hold rn2 = 1
              while rn2 == 1 {
                when pos >= n {
                  hold rn2 = 0
                } otherwise {
                  hold cn = sx_index(source,pos)
                  when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                    hold sf = concat(sf, chr(cn))
                    hold pos = pos + 1
                  } otherwise {
                    hold rn2 = 0
                  }
                }
              }
              when firstp == 0 {
                hold sfields = concat(sfields, ",")
              }
              hold sfields = concat(sfields, sf)
              hold firstp = 0
              hold sfields2 = concat(sfields2, sf)
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      hold sdefs = concat(sdefs, stname)
      hold sdefs = concat(sdefs, ":")
      hold sdefs = concat(sdefs, sfields)
      hold sdefs = concat(sdefs, ";")
    }

    // not the start of any statement: a stray character left over after a
    // statement (`hold x = 2.`, `show a b`) is a clear error, never skipped
    when act == 0 {
      when c != 47 {
        when perr == 0 {
          hold permsg = concat("unexpected '", chr(c))
          hold permsg = concat(permsg, "' (expected the end of the statement or a new statement)")
        }
        hold perr = 1
      }
      hold pos = pos + 1
    }

    // ---- flush completed output into obody (memory bound) -------------
    // A flat accumulator would copy the whole body on every append, which is
    // O(n^2): compiling this file used to allocate ~2.5 GB and get Killed on
    // low-RAM hosts.  Keep `body` under ~1 KB and append it to `obody` in
    // that unit instead.  `obody` is only appended at the end, so the emitted
    // text and its order are byte-for-byte unchanged.  Never flush while a
    // function body is being collected (`body` belongs to `fns` until the
    // matching `}` restores it).
    when in_fn == 0 {
      hold blen = len(body)
      when blen > 1024 {
        hold obody = concat(obody, body)
        hold body = ""
      }
    }
  }
}

// =====================================================================
// emit the C translation unit
// =====================================================================
hold out = ""
when rt == 1 {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <string.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n")
  hold out = concat(out, "static int sx_argn=0; static char **sx_argv_p=0;\n")
  hold out = concat(out, "static double sx_argc(void){ return (double)sx_argn; }\n")
  hold out = concat(out, "static char *sx_arg(double v){ long i=(long)v; if(i<0||i>=sx_argn) return \"\"; return sx_argv_p[i]; }\n")
  hold out = concat(out, "static char *sx_chr(double v){ char *b=(char*)malloc(2); b[0]=(char)(long)v; b[1]=0; return b; }\n")
  hold out = concat(out, "static char *sx_cat(const char *a,const char *b){ size_t la=strlen(a), lb=strlen(b); char *r=(char*)malloc(la+lb+1); memcpy(r,a,la); memcpy(r+la,b,lb); r[la+lb]=0; return r; }\n")
  hold out = concat(out, "static double sx_len(const char *s){ return (double)strlen(s); }\n")
  hold out = concat(out, "static double sx_idx(const char *s,double v){ long i=(long)v; long L=(long)strlen(s); if(i<0) i=i+L; if(i<0||i>=L){ fputs(\"sx: string index out of range\",stderr); exit(1); } return (double)(unsigned char)s[i]; }\n")
  hold out = concat(out, "static char *sx_read(const char *p){ FILE *f=fopen(p,\"rb\"); if(!f) return \"\"; fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char *b=(char*)malloc((size_t)sz+1); size_t rd=fread(b,1,(size_t)sz,f); b[rd]=0; fclose(f); return b; }\n")
  hold out = concat(out, "static double sx_write(const char *p,const char *s){ FILE *f=fopen(p,\"wb\"); if(!f) return 0.0; fputs(s,f); return fclose(f)==0?1.0:0.0; }\n")
  hold out = concat(out, "static double sx_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "static double string_eq(const char *a,const char *b){ return strcmp(a,b)==0 ? 1.0 : 0.0; }\n")
  hold out = concat(out, "typedef struct { double *d; long n; long cap; } sx_list;\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)malloc(sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)malloc(sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)malloc(sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)malloc(sizeof(double)*4);} if(L->n>=L->cap){ L->cap*=2; L->d=(double*)realloc(L->d,sizeof(double)*(size_t)L->cap);} L->d[L->n++]=v; return L; }\n")
  hold out = concat(out, "\n")
} otherwise {
  hold out = concat(out, "#include <stdio.h>\n")
  hold out = concat(out, "#include <stdlib.h>\n")
  hold out = concat(out, "#include <stdarg.h>\n\n")
  hold out = concat(out, "typedef struct { double *d; long n; long cap; } sx_list;\n")
  hold out = concat(out, "static double sx_mod(double a,double b){ long x=(long)a, y=(long)b; if(!y){fputs(\"division by zero\\n\",stderr);exit(1);} return (double)(x%y); }\n")
  hold out = concat(out, "static sx_list *sx_llit(int n,...){ sx_list *L=(sx_list*)malloc(sizeof(sx_list)); L->n=n; L->cap=n<4?4:n; L->d=(double*)malloc(sizeof(double)*(size_t)L->cap); va_list ap; va_start(ap,n); for(int i=0;i<n;i++) L->d[i]=va_arg(ap,double); va_end(ap); return L; }\n")
  hold out = concat(out, "static double sx_lget(sx_list *L,double v){ long i=(long)v; if(!L){fputs(\"sx: null list\",stderr);exit(1);} if(i<0)i+=L->n; if(i<0||i>=L->n){fputs(\"sx: list index\",stderr);exit(1);} return L->d[i]; }\n")
  hold out = concat(out, "static double sx_llen(sx_list *L){ return L?(double)L->n:0.0; }\n")
  hold out = concat(out, "static sx_list *sx_lpush(sx_list *L,double v){ if(!L){L=(sx_list*)malloc(sizeof(sx_list)); L->n=0; L->cap=4; L->d=(double*)malloc(sizeof(double)*4);} if(L->n>=L->cap){ L->cap*=2; L->d=(double*)realloc(L->d,sizeof(double)*(size_t)L->cap);} L->d[L->n++]=v; return L; }\n\n")
}
hold fixfrom = len(out)
hold out = concat(out, fns)
// ---------------- struct typedefs (field types come from literals) ----------------
hold tdi = 0
hold tdn = len(sdefs)
while tdi < tdn {
  hold tdname = ""
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 58 {
        hold tdrun = 0
      } otherwise {
        hold tdname = concat(tdname, chr(tdc))
      }
      hold tdi = tdi + 1
    }
  }
  hold out = concat(out, "typedef struct {")
  hold tdrun = 1
  while tdrun == 1 {
    when tdi >= tdn {
      hold tdrun = 0
    } otherwise {
      hold tdc = sx_index(sdefs, tdi)
      when tdc == 59 {
        hold tdrun = 0
        hold tdi = tdi + 1
      } otherwise {
        when tdc == 44 {
          hold tdi = tdi + 1
        } otherwise {
          hold tdfld = ""
          hold tdf = 1
          while tdf == 1 {
            when tdi >= tdn {
              hold tdf = 0
            } otherwise {
              hold tdc = sx_index(sdefs, tdi)
              when tdc == 44 || tdc == 59 {
                hold tdf = 0
              } otherwise {
                hold tdfld = concat(tdfld, chr(tdc))
                hold tdi = tdi + 1
              }
            }
          }
          hold tdclass = 0
          hold tdinn = ""
          hold tdkey = concat("|", tdname)
          hold tdkey = concat(tdkey, ".")
          hold tdkey = concat(tdkey, tdfld)
          hold tdkey = concat(tdkey, "=")
          hold tdk = len(tdkey)
          hold tdl = len(ftypes)
          hold tdhit = 0
          hold tdp = 0
          while tdp + tdk < tdl {
            hold tdeq = 1
            hold tdj = 0
            while tdj < tdk {
              hold tda = sx_index(ftypes, tdp + tdj)
              hold tdb = sx_index(tdkey, tdj)
              when tda == tdb {
                hold tdj = tdj + 1
              } otherwise {
                hold tdeq = 0
                hold tdj = tdk
              }
            }
            when tdeq == 1 {
              hold tdpk = sx_index(ftypes, tdp + tdk)
              when tdpk == 49 {
                hold tdclass = 1
              }
              when tdpk == 50 {
                // struct-typed field: the inner struct name follows
                hold tdclass = 2
                hold tdi2 = tdp + tdk + 2
                hold tdrun2 = 1
                while tdrun2 == 1 {
                  when tdi2 >= tdl {
                    hold tdrun2 = 0
                  } otherwise {
                    hold tdc2 = sx_index(ftypes, tdi2)
                    when tdc2 == 124 {
                      hold tdrun2 = 0
                    } otherwise {
                      hold tdinn = concat(tdinn, chr(tdc2))
                      hold tdi2 = tdi2 + 1
                    }
                  }
                }
              }
              hold tdp = tdl
            } otherwise {
              hold tdp = tdp + 1
            }
          }
          when tdclass == 2 {
            hold out = concat(out, " ")
            hold out = concat(out, tdinn)
            hold out = concat(out, " ")
          } otherwise {
            when tdclass == 1 {
              hold out = concat(out, " char *")
            } otherwise {
              hold out = concat(out, " double ")
            }
          }
          hold out = concat(out, tdfld)
          hold out = concat(out, ";")
        }
      }
    }
  }
  hold out = concat(out, " } ")
  hold out = concat(out, tdname)
  hold out = concat(out, ";")
  hold out = concat(out, nl)
}
when rt == 1 {
  hold out = concat(out, "int main(int argc,char**argv){\n")
  hold out = concat(out, "  sx_argn=argc; sx_argv_p=argv;\n")
} otherwise {
  hold out = concat(out, "int main(void){\n")
}
hold out = concat(out, obody)
hold out = concat(out, body)
hold out = concat(out, "  return 0;\n")
hold out = concat(out, "}\n")
// ---------------- module errors (clear, never silent) ----------------
when exmissing == 1 {
  hold exerr = concat("#error sayanox-min: cannot open use file: ", exmissp)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: cannot open use file: ", exmissp)
  show shmsg
}
when exdeep == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use nesting deeper than 8")
  hold exerr = concat(exerr, nl)
  show "min: use nesting deeper than 8"
}
when exbad == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct/list literal value must be a number, string, name, or nested struct")
  hold exerr = concat(exerr, nl)
  show "min: struct/list literal value must be a number, string, name, or nested struct"
}
when exbad5 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: use must be followed by a quoted path, e.g. use \"lib.sa\"")
  hold exerr = concat(exerr, nl)
  show "min: use must be followed by a quoted path, e.g. use \"lib.sa\""
}
when exbad6 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct field is used with two different types (string vs number)")
  hold exerr = concat(exerr, nl)
  show "min: struct field used with two different types (string vs number)"
}
when exbad7 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal fields must be given in declaration order")
  hold exerr = concat(exerr, nl)
  show "min: struct literal fields must be given in declaration order"
}
when exbad8 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal must fill every field")
  hold exerr = concat(exerr, nl)
  show "min: struct literal must fill every field"
}
when nerrfwd == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct '")
  hold exerr = concat(exerr, nfwdout)
  hold exerr = concat(exerr, "' nests struct '")
  hold exerr = concat(exerr, nfwdin)
  hold exerr = concat(exerr, "' which is declared later; declare the nested struct first")
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: struct '", nfwdout)
  hold shmsg = concat(shmsg, "' nests struct '")
  hold shmsg = concat(shmsg, nfwdin)
  hold shmsg = concat(shmsg, "' declared later; declare the nested struct first")
  show shmsg
}
when nerrunk == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: struct literal for unknown struct '")
  hold exerr = concat(exerr, nunknm)
  hold exerr = concat(exerr, "'")
  hold exerr = concat(exerr, nl)
  hold shmsg = "min: struct literal for unknown struct '"
  hold shmsg = concat(shmsg, nunknm)
  hold shmsg = concat(shmsg, "'")
  show shmsg
}
when nerrchain == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, chainmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", chainmsg)
  show shmsg
}
when nerrscop == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, scopmsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", scopmsg)
  show shmsg
}
when exbad4 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: a '}' ended up inside a give expression; put one statement per line")
  hold exerr = concat(exerr, nl)
  show "min: a '}' ended up inside a give expression; put one statement per line"
}
when perr == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: ")
  hold exerr = concat(exerr, permsg)
  hold exerr = concat(exerr, nl)
  hold shmsg = concat("min: ", permsg)
  show shmsg
}
when exbad3 == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: unsupported index expression (number or name only)")
  hold exerr = concat(exerr, nl)
  show "min: unsupported index expression (number or name only)"
}
// Rewrite every generated C integer token in user code to a double token.
// `fixfrom` is the end of the runtime preamble; that preamble intentionally
// keeps its integer constants, while function/main expressions become `N.0`.
// String literals are copied without inspection, and digits inside C names
// are left alone. Output is appended after at most 512 input bytes per chunk
// (plus any `.0` expansions), bounding the temporary builder and avoiding a
// full-prefix copy for every character. This keeps C's integer folding from
// diverging from Sayanox's IEEE-double arithmetic.
hold fixn = len(out)
hold fixi = 0
hold fixout = ""
while fixi < fixfrom {
  hold fixchunk = concat(fixchunk, chr(sx_index(out,fixi)))
  hold fixi = fixi + 1
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
hold fixquote = 0
hold fixes = 0
hold fixprev = 0
while fixi < fixn {
  hold fixc = sx_index(out,fixi)
  when fixquote == 1 {
    hold fixchunk = concat(fixchunk, chr(fixc))
    hold fixi = fixi + 1
    when fixes == 1 {
      hold fixes = 0
    } otherwise {
      when fixc == 92 {
        hold fixes = 1
      } otherwise {
        when fixc == 34 {
          hold fixquote = 0
        }
      }
    }
    hold fixprev = fixc
  } otherwise {
    when fixc == 34 {
      hold fixchunk = concat(fixchunk, chr(fixc))
      hold fixquote = 1
      hold fixprev = fixc
      hold fixi = fixi + 1
    } otherwise {
      when fixc >= 48 && fixc <= 57 {
        hold fixident = 0
        when (fixprev >= 48 && fixprev <= 57) || (fixprev >= 65 && fixprev <= 90) || (fixprev >= 97 && fixprev <= 122) || fixprev == 95 {
          hold fixident = 1
        }
        when fixident == 1 {
          hold fixchunk = concat(fixchunk, chr(fixc))
          hold fixprev = fixc
          hold fixi = fixi + 1
        } otherwise {
          hold fixnum = ""
          hold fixdot = 0
          hold fixrun = 1
          while fixrun == 1 {
            when fixi >= fixn {
              hold fixrun = 0
            } otherwise {
              hold fixd = sx_index(out,fixi)
              when fixd >= 48 && fixd <= 57 {
                hold fixnum = concat(fixnum, chr(fixd))
                hold fixprev = fixd
                hold fixi = fixi + 1
              } otherwise {
                when fixd == 46 {
                  hold fixnext = 0
                  when fixi + 1 < fixn {
                    hold fixnext = sx_index(out,fixi + 1)
                  }
                  when fixnext >= 48 && fixnext <= 57 {
                    hold fixnum = concat(fixnum, chr(fixd))
                    hold fixdot = 1
                    hold fixprev = fixd
                    hold fixi = fixi + 1
                  } otherwise {
                    hold fixrun = 0
                  }
                } otherwise {
                  hold fixrun = 0
                }
              }
            }
          }
          when fixdot == 0 {
            hold fixnum = concat(fixnum, ".0")
            hold fixprev = 48
          }
          hold fixchunk = concat(fixchunk, fixnum)
        }
      } otherwise {
        hold fixchunk = concat(fixchunk, chr(fixc))
        hold fixprev = fixc
        hold fixi = fixi + 1
      }
    }
  }
  when fixi - fixflush >= 512 {
    hold fixout = concat(fixout, fixchunk)
    hold fixchunk = ""
    hold fixflush = fixi
  }
}
when fixi > fixflush {
  hold fixout = concat(fixout, fixchunk)
  hold fixchunk = ""
  hold fixflush = fixi
}
hold out = fixout
hold out = concat(exerr, out)
hold w = write_file(out_path, out)

// counters go to stdout (they are the compiler's own output, not the target's)
