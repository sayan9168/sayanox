use "selfhost/modules/compiler_text.sa"

// A compact numeric source view avoids hidden whole-string length scans in
// native sx_index when the runtime's two large-string cache slots alternate.
// Six bytes fit exactly in both the native integer and C double number models.
make sxsource_pack(text: str) -> list {
  hold size = len(text)
  hold words = [size]
  hold i = 0
  while i < size {
    hold value = 0
    hold power = 1
    hold count = 0
    while count < 6 && i < size {
      value = value + sx_index(text, i) * power
      power = power * 256
      count = count + 1
      i = i + 1
    }
    words = push(words, value)
  }
  give words
}
make sxsource_get(words: list, at: num) -> num {
  hold size = words[0]
  when at < 0 || at >= size { give 0
  }
  hold skip = at % 6
  hold value = words[1 + (at - skip) / 6]
  while skip > 0 {
    value = (value - value % 256) / 256
    skip = skip - 1
  }
  give value % 256
}

// Recognize only top-level C designators, not fields inside nested values.
make sxseed_designator(text: str, field: str) -> num {
  hold size = len(text)
  hold key = concat(".", concat(field, "="))
  hold i = 0
  hold depth = 0
  hold quote = 0
  while i < size {
    hold c = sx_index(text, i)
    when quote == 1 {
      when c == 92 { i = i + 1 } otherwise { when c == 34 { quote = 0 } }
    } otherwise {
      when c == 34 { quote = 1 } otherwise {
        when depth == 0 && (i == 0 || sx_index(text, i - 1) == 44) && c == 46 {
          hold j = 0
          while j < len(key) && i + j < size && sx_index(text, i + j) == sx_index(key, j) { j = j + 1 }
          when j == len(key) { give 1
          }
        }
        when c == 40 || c == 91 || c == 123 { depth = depth + 1 }
        when c == 41 || c == 93 || c == 125 { depth = depth - 1 }
      }
    }
    i = i + 1
  }
  give 0
}
make sxseed_pending_field(text: str) -> str {
  hold end = len(text) - 1
  hold i = end - 1
  while i >= 0 && sxseed_id(sx_index(text, i)) { i = i - 1 }
  give sxseed_slice(text, i + 1, end)
}

make sxesegment(text: str, slot: num) -> str {
  hold cached_size_text = len(text)
  hold start = 0
  hold i = 0
  hold part = 0
  while i < cached_size_text {
    when sx_index(text, i) == 1 {
      when part == slot {
        give sxeslice(text, start, i)
      }
      part = part + 1
      start = i + 1
    }
    i = i + 1
  }
  when part == slot {
    give sxeslice(text, start, i)
  }
  give ""
}
make sxerecord(at: num, kind: str, code: str) -> str {
  hold record = concat(sxedigits(at), chr(1))
  record = concat(record, kind)
  record = concat(record, chr(1))
  give concat(record, code)
}
make sxepos(record: str) -> num {
  hold cached_size_record = len(record)
  hold i = 0
  hold value = 0
  while i < cached_size_record && sx_index(record, i) != 1 {
    value = value * 10 + sx_index(record, i) - 48
    i = i + 1
  }
  give value
}
make sxecode(record: str) -> str {
  hold cached_size_record = len(record)
  hold i = 0
  hold separators = 0
  while i < cached_size_record && separators < 2 {
    when sx_index(record, i) == 1 {
      separators = separators + 1
    }
    i = i + 1
  }
  give sxeslice(record, i, cached_size_record)
}
make sxelookup_span(table: str, name: str, end: str, begin: num, limit: num) -> str {
  hold cached_size_table = limit
  hold key = concat("|", name)
  key = concat(key, end)
  hold i = begin
  while i + len(key) <= cached_size_table {
    hold j = 0
    hold match = 1
    while j < len(key) && match == 1 {
      when sx_index(table, i + j) != sx_index(key, j) {
        match = 0
      }
      j = j + 1
    }
    when match == 1 {
      when string_eq(end, "|") {
        give "yes"
      }
      hold start = i + len(key)
      hold stop = start
      while stop < cached_size_table && sx_index(table, stop) != 124 {
        stop = stop + 1
      }
      give sxeslice(table, start, stop)
    }
    i = i + 1
  }
  give ""
}
// Look up directly in an encoded environment segment. Copying the complete
// declarations table for every identifier made own-source checking quadratic
// in allocated bytes, even though the parser only needs one tiny value.
make sxelookup(table: str, name: str, end: str) -> str {
  give sxelookup_span(table, name, end, 0, len(table))
}
make sxeenvlookup(env: str, slot: num, name: str, end: str) -> str {
  hold size = len(env)
  hold i = 0
  hold part = 0
  while i < size && part < slot {
    when sx_index(env, i) == 1 { part = part + 1 }
    i = i + 1
  }
  when part != slot { give ""
  }
  hold stop = i
  while stop < size && sx_index(env, stop) != 1 { stop = stop + 1 }
  give sxelookup_span(env, name, end, i, stop)
}
make sxecontains(text: str, word: str) -> num {
  hold cached_size_text = len(text)
  hold cached_size_word = len(word)
  hold i = 0
  while i + cached_size_word <= cached_size_text {
    hold j = 0
    hold match = 1
    while j < cached_size_word && match == 1 {
      when sx_index(text, i + j) != sx_index(word, j) {
        match = 0
      }
      j = j + 1
    }
    when match == 1 {
      give 1
    }
    i = i + 1
  }
  give 0
}
// ---- generic structs ------------------------------------------------------
// `struct Box<T> { v }` is a TEMPLATE: parameter names and field names, no
make gxisid(c: num) -> num {
  when (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 {
    give 1
  }
  give 0
}
make gxkind(word: str) -> str {
  when string_eq(word, "num") {
    give "n"
  }
  when string_eq(word, "str") {
    give "s"
  }
  when string_eq(word, "list") {
    give "l"
  }
  give ""
}
// Whitespace and `// ...` comments inside a type-argument list: seed-min's
// skip() has always allowed a list to be written across lines with a note
// between the arguments, so the pre-pass has to allow it too.
make gxskip(text: str, at: num) -> num {
  hold cached_size_text = len(text)
  hold i = at
  hold n = cached_size_text
  hold run = 1
  while run == 1 {
    while i < n && (sx_index(text, i) == 32 || sx_index(text, i) == 9 || sx_index(text, i) == 10 || sx_index(text, i) == 13) {
      i = i + 1
    }
    when i + 1 < n && sx_index(text, i) == 47 && sx_index(text, i + 1) == 47 {
      while i < n && sx_index(text, i) != 10 {
        i = i + 1
      }
    } otherwise {
      run = 0
    }
  }
  give i
}
// Add `Name:f1,f2;` records to the running instantiation list, skipping the
// names already there. Returns NAMES chr(1) DEFS.
make gxmerge(names: str, defs: str, add: str) -> str {
  hold cached_size_add = len(add)
  hold outn = names
  hold outd = defs
  hold cur = ""
  hold i = 0
  while i < cached_size_add {
    hold c = sx_index(add, i)
    when c == 59 {
      hold cn = ""
      hold k = 0
      while k < len(cur) && sx_index(cur, k) != 58 {
        cn = concat(cn, chr(sx_index(cur, k)))
        k = k + 1
      }
      when len(cn) > 0 {
        when tbl_has(outn, cn) == 0 {
          outn = concat(outn, concat(cn, "|"))
          outd = concat(outd, concat(cur, ";"))
        }
      }
      cur = ""
    } otherwise {
      cur = concat(cur, chr(c))
    }
    i = i + 1
  }
  give concat(outn, concat(chr(1), outd))
}
// One type-argument list: `<num>`, `<num, str>`, `<list>`, or a nested
// instantiation such as `<Box<num>>`. `at` is the index of the opening '<'.
// The record is ENDPOS chr(1) CODE chr(1) COUNT chr(1) DEFS.
//   CODE  is the mangled suffix: one letter for a primitive argument
//         (num->n, str->s, list->l) and the inner mangled name for a nested
//         instantiation. Arguments are concatenated while every one of them
//         is a single letter -- so `Pair<num, str>` stays `Pair__ns` -- and
//         separated by '_' as soon as one is nested, which is what makes
//         `Pair<Box<num>, str>` (`Pair__Box__n_s`) readable and unambiguous.
//   COUNT is the argument count as one digit, for the arity check.
//   DEFS  carries `Name:f1,f2;` for every nested instantiation, innermost
//         first, so the C typedef order a struct-typed field needs falls out
//         of the walk instead of a second sort.
// CODE is empty when this is not a type-argument list this compiler accepts;
// the caller then leaves the text alone and the ordinary diagnostics run.
make gxargs(text: str, at: num, gsdefs: str, level: num) -> str {
  hold cached_size_text = len(text)
  hold n = cached_size_text
  hold p = at + 1
  hold flat = ""
  hold joined = ""
  hold defs = ""
  hold nested = 0
  hold count = 0
  hold ok = 1
  hold run = 1
  when level > 8 {
    ok = 0
    run = 0
  }
  while run == 1 {
    when p >= n {
      ok = 0
      run = 0
    } otherwise {
      hold c = sx_index(text, p)
      when c == 32 || c == 9 || c == 10 || c == 13 || (c == 47 && p + 1 < n && sx_index(text, p + 1) == 47) {
        p = gxskip(text, p)
      } otherwise {
        when c == 62 {
          p = p + 1
          run = 0
        } otherwise {
          when c == 44 {
            p = p + 1
          } otherwise {
            hold as = p
            while p < n && gxisid(sx_index(text, p)) == 1 {
              p = p + 1
            }
            when p == as {
              ok = 0
              run = 0
            } otherwise {
              hold word = sxeslice(text, as, p)
              hold q = gxskip(text, p)
              hold code = ""
              hold isnested = 0
              when q < n && sx_index(text, q) == 60 {
                isnested = 1
                hold rec = sxelookup(gsdefs, word, ":")
                when len(rec) == 0 {
                  ok = 0
                  run = 0
                } otherwise {
                  hold sub = gxargs(text, q, gsdefs, level + 1)
                  hold subcode = sxesegment(sub, 1)
                  hold subcnt = sxesegment(sub, 2)
                  hold subnp = 0
                  when len(subcnt) > 0 {
                    subnp = sx_index(subcnt, 0) - 48
                  }
                  when len(subcode) == 0 || subnp != sx_index(rec, 0) - 48 {
                    ok = 0
                    run = 0
                  } otherwise {
                    code = concat(word, concat("__", subcode))
                    defs = concat(defs, sxesegment(sub, 3))
                    defs = concat(defs, concat(code, concat(":", concat(sxeslice(rec, 2, len(rec)), ";"))))
                    p = sxepos(sub)
                  }
                }
              } otherwise {
                code = gxkind(word)
                when len(code) == 0 {
                  ok = 0
                  run = 0
                }
              }
              when ok == 1 {
                when isnested == 1 {
                  nested = 1
                }
                when count > 0 {
                  joined = concat(joined, "_")
                }
                flat = concat(flat, code)
                joined = concat(joined, code)
                count = count + 1
              }
            }
          }
        }
      }
    }
  }
  hold outcode = flat
  when nested == 1 {
    outcode = joined
  }
  when ok == 0 || count == 0 || count > 8 {
    outcode = ""
    count = 0
    defs = ""
  }
  hold out = sxedigits(p)
  out = concat(out, chr(1))
  out = concat(out, outcode)
  out = concat(out, chr(1))
  out = concat(out, chr(48 + count))
  out = concat(out, chr(1))
  give concat(out, defs)
}
// every template in the source, as |Name:np:f1,f2| records
make gxscan(text: str) -> str {
  hold cached_size_text = len(text)
  hold out = "|"
  hold n = cached_size_text
  hold i = 0
  while i < n {
    hold c = sx_index(text, i)
    when c == 34 {
      i = i + 1
      while i < n && sx_index(text, i) != 34 {
        when sx_index(text, i) == 92 && i + 1 < n {
          i = i + 1
        }
        i = i + 1
      }
      i = i + 1
    } otherwise {
      when c == 47 && i + 1 < n && sx_index(text, i + 1) == 47 {
        while i < n && sx_index(text, i) != 10 {
          i = i + 1
        }
      } otherwise {
        hold iskw = 0
        when c == 115 && i + 6 <= n && sx_index(text, i + 1) == 116 && sx_index(text, i + 2) == 114 && sx_index(text, i + 3) == 117 && sx_index(text, i + 4) == 99 && sx_index(text, i + 5) == 116 {
          iskw = 1
          when i > 0 {
            when gxisid(sx_index(text, i - 1)) == 1 {
              iskw = 0
            }
          }
          when i + 6 < n {
            when gxisid(sx_index(text, i + 6)) == 1 {
              iskw = 0
            }
          }
        }
        when iskw == 1 {
          hold j = i + 6
          while j < n && (sx_index(text, j) == 32 || sx_index(text, j) == 9 || sx_index(text, j) == 10 || sx_index(text, j) == 13) {
            j = j + 1
          }
          hold e = j
          while e < n && gxisid(sx_index(text, e)) == 1 {
            e = e + 1
          }
          hold k = e
          while k < n && (sx_index(text, k) == 32 || sx_index(text, k) == 9 || sx_index(text, k) == 10 || sx_index(text, k) == 13) {
            k = k + 1
          }
          when e > j && k < n && sx_index(text, k) == 60 {
            hold np = 1
            hold p = k + 1
            while p < n && sx_index(text, p) != 62 {
              when sx_index(text, p) == 44 {
                np = np + 1
              }
              p = p + 1
            }
            hold fields = ""
            p = p + 1
            while p < n && sx_index(text, p) != 125 {
              while p < n && (sx_index(text, p) == 32 || sx_index(text, p) == 9 || sx_index(text, p) == 10 || sx_index(text, p) == 13) {
                p = p + 1
              }
              hold fs = p
              while p < n && gxisid(sx_index(text, p)) == 1 {
                p = p + 1
              }
              when p > fs {
                when len(fields) > 0 {
                  fields = concat(fields, ",")
                }
                fields = concat(fields, sxeslice(text, fs, p))
              } otherwise {
                when p < n && sx_index(text, p) != 125 {
                  p = p + 1
                }
              }
            }
            when len(fields) > 0 && np <= 8 {
              out = concat(out, concat(sxeslice(text, j, e), concat(":", concat(chr(48 + np), concat(":", concat(fields, "|"))))))
            }
          }
          i = i + 6
        } otherwise {
          i = i + 1
        }
      }
    }
  }
  give out
}
// Find the end of a malformed generic head without consuming a following
// statement. This diagnostic-only recovery is bounded; the walker remains
// responsible for longer or incomplete syntax. Numeric '<' is not a head.
make gxerrorhead(text: str, at: num) -> num {
  hold p = at
  hold size = len(text)
  hold level = 0
  while p < size && p - at < 4096 {
    p = gxskip(text, p)
    when p < size && p - at < 4096 {
      hold c = sx_index(text, p)
      when c == 123 || c == 125 || c == 59 || c == 34 {
        give 0
      }
      when c == 60 { level = level + 1 }
      when c == 62 {
        level = level - 1
        when level == 0 {
          give p + 1
        }
      }
      p = p + 1
    }
  }
  give 0
}
// One pass: each instantiation `Box<num> {` becomes `Box__n {`. Gives the
// mangled structs as sdefs records in first-use order, chr(1), rewritten
// source, chr(1), expected generic field kinds, chr(1), then a head error.
make gxpass(text: str, gsdefs: str) -> str {
  hold cached_size_text = len(text)
  hold defs = ""
  hold names = "|"
  hold expected_types = "|"
  hold generic_error = ""
  hold previous = ""
  hold condition = 0
  hold brace_depth = 0
  hold generic_depth = 0
  hold generic_pending = 0
  hold out = ""
  hold n = cached_size_text
  hold i = 0
  hold cp = 0
  while i < n {
    hold c = sx_index(text, i)
    when c == 123 {
      condition = 0
      brace_depth = brace_depth + 1
      when generic_pending == 1 {
        generic_depth = brace_depth
        generic_pending = 0
      }
    }
    when c == 125 {
      condition = 0
      when brace_depth == generic_depth { generic_depth = 0 }
      brace_depth = brace_depth - 1
    }
    when c == 34 {
      i = i + 1
      while i < n && sx_index(text, i) != 34 {
        when sx_index(text, i) == 92 && i + 1 < n {
          i = i + 1
        }
        i = i + 1
      }
      i = i + 1
    } otherwise {
      when c == 47 && i + 1 < n && sx_index(text, i + 1) == 47 {
        while i < n && sx_index(text, i) != 10 {
          i = i + 1
        }
      } otherwise {
        hold startok = 0
        when gxisid(c) == 1 {
          when i == 0 {
            startok = 1
          } otherwise {
            when gxisid(sx_index(text, i - 1)) == 0 {
              startok = 1
            }
          }
        }
        when startok == 1 {
          hold e = i
          while e < n && gxisid(sx_index(text, e)) == 1 {
            e = e + 1
          }
          hold j = e
          while j < n && (sx_index(text, j) == 32 || sx_index(text, j) == 9 || sx_index(text, j) == 10 || sx_index(text, j) == 13) {
            j = j + 1
          }
          hold hit = 0
          hold nm = sxeslice(text, i, e)
          when string_eq(nm, "when") || string_eq(nm, "while") { condition = 1 }
          // Uninstantiated generic function bodies are checked on demand by
          // the walker. A bound T there is not an escaped type argument.
          when string_eq(previous, "make") && j < n {
            when sx_index(text, j) == 60 { generic_pending = 1 }
          }
          hold rec = ""
          when j < n && (sx_index(text, j) == 60 || sx_index(text, j) == 123) {
            rec = sxelookup(gsdefs, nm, ":")
          }
          // A bare template is not a concrete struct. Ignore declarations;
          // inspect only this head, preserving the walker's existing errors.
          when len(rec) > 0 && string_eq(previous, "struct") == 0 && generic_depth == 0 && generic_pending == 0 && len(generic_error) == 0 && j < n {
            when sx_index(text, j) == 123 && condition == 0 {
              hold info = sxseed_generic_info(sxeslice(text, i, j + 1), gsdefs)
              generic_error = sxesegment(info, 0)
            }
          }
          when j < n && sx_index(text, j) == 60 {
            when len(rec) > 0 {
              hold ar = gxargs(text, j, gsdefs, 0)
              hold args = sxesegment(ar, 1)
              hold acs = sxesegment(ar, 2)
              hold acount = 0
              when len(acs) > 0 {
                acount = sx_index(acs, 0) - 48
              }
              hold p = sxepos(ar)
              when (len(args) == 0 || acount != sx_index(rec, 0) - 48) && string_eq(previous, "struct") == 0 && generic_depth == 0 && generic_pending == 0 && len(generic_error) == 0 {
                hold end = p
                when len(args) == 0 { end = gxerrorhead(text, j) }
                when end > i {
                  hold after = gxskip(text, end)
                  when after < n && sx_index(text, after) == 123 {
                    hold info = sxseed_generic_info(sxeslice(text, i, end), gsdefs)
                    generic_error = sxesegment(info, 0)
                  }
                }
              }
              when len(args) > 0 && acount == sx_index(rec, 0) - 48 {
                hold after = gxskip(text, p)
                when after < n && sx_index(text, after) == 123 {
                  hold mn = concat(nm, concat("__", args))
                  out = concat(out, sxeslice(text, cp, i))
                  out = concat(out, mn)
                  // Inspect only this already-parsed head, not the whole source.
                  // The bounded scan also records nested type arguments.
                  when tbl_has(names, mn) == 0 {
                    hold info = sxseed_generic_info(sxeslice(text, i, p), gsdefs)
                    expected_types = concat(expected_types, sxesegment(info, 1))
                  }
                  cp = p
                  i = p
                  hit = 1
                  hold add = sxesegment(ar, 3)
                  add = concat(add, concat(mn, concat(":", concat(sxeslice(rec, 2, len(rec)), ";"))))
                  hold merged = gxmerge(names, defs, add)
                  names = sxesegment(merged, 0)
                  defs = sxesegment(merged, 1)
                }
              }
            }
          }
          previous = nm
          when hit == 0 {
            i = e
          }
        } otherwise {
          i = i + 1
        }
      }
    }
  }
  out = concat(out, sxeslice(text, cp, n))
  give concat(concat(defs, chr(1)), concat(out, concat(chr(1), concat(expected_types, concat(chr(1), generic_error)))))
}
// Identify calls with list/index syntax, without treating quoted '[' as code.
make sxehaslist(text: str, open: num) -> num {
  hold cached_size_text = len(text)
  hold i = open + 1
  hold depth = 1
  hold quote = 0
  hold found = 0
  while i < cached_size_text && depth > 0 {
    hold c = sx_index(text, i)
    i = i + 1
    when quote == 1 {
      when c == 92 && i < cached_size_text {
        i = i + 1
      } otherwise {
        when c == 34 {
          quote = 0
        }
      }
    } otherwise {
      when c == 34 {
        quote = 1
      }
      when c == 40 {
        depth = depth + 1
      }
      when c == 41 {
        depth = depth - 1
      }
      when c == 91 {
        found = 1
      }
    }
  }
  i = sxflowspace(text, i)
  when i < cached_size_text && sx_index(text, i) == 91 {
    found = 1
  }
  give found
}
// Pratt parser: scalar operators, typed calls, numeric lists and indexing.
// env: numeric/all bindings, strings, lists, struct names, returns, signatures.
make sxeparse(text: str, at: num, env: str, minimum: num, level: num, state: list) -> str {
  hold cached_size_text = len(text)
  when level > 96 {
    give sxerecord(at, "e", "expression nesting exceeds 96")
  }
  hold i = sxflowspace(text, at)
  hold c = 0
  when i < cached_size_text {
    c = sx_index(text, i)
  }
  hold kind = "e"
  hold code = "expected an expression"
  hold unary_width = 1
  when c == 110 && string_eq(sxflowword(text, i), "not") { c = 33
    unary_width = 3 }
  when c == 43 || c == 45 || c == 33 {
    hold unary_precedence = 7
    // Word `not` negates a comparison, but stops before and/or.
    when unary_width == 3 { unary_precedence = 3 }
    hold unary = sxeparse(text, i + unary_width, env, unary_precedence, level + 1, state)
    when string_eq(sxesegment(unary, 1), "n") == 0 {
      give sxerecord(i, "e", "unary operator requires a number")
    }
    i = sxepos(unary)
    code = concat("(", chr(c))
    code = concat(code, " ")
    code = concat(code, sxecode(unary))
    code = concat(code, ")")
    kind = "n"
  } otherwise {
    when c == 40 {
      // A double cast may have been inserted by condition division lowering.
      hold cast = sxeslice(text, i, i + 8)
      when string_eq(cast, "(double)") {
        hold casted = sxeparse(text, i + 8, env, 7, level + 1, state)
        when string_eq(sxesegment(casted, 1), "n") == 0 {
          give sxerecord(i, "e", "numeric cast requires a number")
        }
        i = sxepos(casted)
        code = sxecode(casted)
        kind = "n"
      } otherwise {
        hold grouped = sxeparse(text, i + 1, env, 0, level + 1, state)
        kind = sxesegment(grouped, 1)
        when string_eq(kind, "e") {
          give grouped
        }
        i = sxflowspace(text, sxepos(grouped))
        when i >= cached_size_text || sx_index(text, i) != 41 {
          give sxerecord(i, "e", "unbalanced parentheses")
        }
        code = concat("(", sxecode(grouped))
        code = concat(code, ")")
        i = i + 1
      }
    } otherwise {
      when c >= 48 && c <= 57 {
        hold start = i
        while i < cached_size_text && sx_index(text, i) >= 48 && sx_index(text, i) <= 57 {
          i = i + 1
        }
        hold decimal = 0
        when i < cached_size_text && sx_index(text, i) == 46 {
          decimal = 1
          i = i + 1
          hold digits = i
          while i < cached_size_text && sx_index(text, i) >= 48 && sx_index(text, i) <= 57 {
            i = i + 1
          }
          when i == digits {
            give sxerecord(i, "e", "malformed decimal literal")
          }
        }
        code = sxeslice(text, start, i)
        when decimal == 0 {
          code = concat(code, ".0")
        }
        kind = "n"
      } otherwise {
        when c == 34 {
          hold start = i
          i = i + 1
          hold quoted = 1
          while i < cached_size_text && quoted == 1 {
            hold ch = sx_index(text, i)
            i = i + 1
            when ch == 92 && i < cached_size_text {
              i = i + 1
            } otherwise {
              when ch == 34 {
                quoted = 0
              }
            }
          }
          when quoted == 1 {
            give sxerecord(i, "e", "unterminated string")
          }
          code = sxeslice(text, start, i)
          kind = "s"
        } otherwise {
          when c == 91 {
            i = sxflowspace(text, i + 1)
            hold elements = ""
            hold effects = ""
            hold count = 0
            hold more = 1
            when i < cached_size_text && sx_index(text, i) == 93 {
              more = 0
            }
            while more == 1 {
              hold element = sxeparse(text, i, env, 0, level + 1, state)
              when string_eq(sxesegment(element, 1), "n") == 0 {
                give sxerecord(i, "e", "list elements must have numeric type")
              }
              hold serial = len(state)
              push(state, 0)
              hold temporary = concat(sxesegment(env, 6), sxedigits(serial))
              effects = concat(effects, temporary)
              effects = concat(effects, "=(double)(")
              effects = concat(effects, sxecode(element))
              effects = concat(effects, "),")
              elements = concat(elements, ",")
              elements = concat(elements, temporary)
              count = count + 1
              i = sxflowspace(text, sxepos(element))
              when i < cached_size_text && sx_index(text, i) == 44 {
                i = sxflowspace(text, i + 1)
              } otherwise {
                more = 0
              }
            }
            when i >= cached_size_text || sx_index(text, i) != 93 {
              give sxerecord(i, "e", "expected comma or closing list bracket")
            }
            i = i + 1
            code = concat(sxesegment(env, 6), "list((")
            code = concat(code, effects)
            code = concat(code, "sx_llit(")
            code = concat(code, sxedigits(count))
            code = concat(code, elements)
            code = concat(code, ")))")
            kind = "l"
          } otherwise {
            when (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
              hold name = sxflowword(text, i)
              i = sxflowspace(text, i + len(name))
              when i < cached_size_text && sx_index(text, i) == 40 {
                hold returns = ""
                hold signatures = ""
                returns = concat(returns, "|run_command=n|getenv=s|len=n|index=n|concat=s|chr=s|numstr=s|sx_index=n|push=l|string_eq=n|arg=s|arg_count=n|read_file=s|write_file=n|read_line=s|read_n=s|write_out=n|flush_out=n|gc=n|gc_live=n|gc_runs=n|exit=n|http_get=s|read_dir=s|path_kind=n|path_size=n|path_real=s||sx_cat=s|sx_len=n|sx_idx=n|sx_chr=s|sx_read=s|sx_write=n|sx_http=s|sx_arg=s|sx_argc=n|sx_eq=n|sx_cmp=n|sx_numstr=s|sx_read_line=s|sx_read_n=s|sx_write_out=n|sx_flush_out=n|sx_gc_run=n|sx_gc_live=n|sx_gc_count=n|sx_exit=n|sx_mod=n|sx_lget=n|sx_llen=n|sx_lpush=l|spawn=n|sx_spawn=n|child_send=n|sx_child_send=n|child_recv=s|sx_child_recv=s|child_line=s|sx_child_line=s|child_close=n|sx_child_close=n|make_dir=n|sx_make_dir=n|make_link=n|sx_make_link=n|remove_path=n|sx_remove_path=n|read_bytes=n|sx_read_bytes=n|write_bytes=n|sx_write_bytes=n|bytes_f64=l|sx_bytes_f64=l|bit_and=n|sx_bit_and=n|bit_or=n|sx_bit_or=n|bit_xor=n|sx_bit_xor=n|bit_not=n|sx_bit_not=n|shl=n|sx_shl=n|shr=n|sx_shr=n|sx_getenv=s|sx_read_dir=s|sx_path_kind=n|sx_path_size=n|sx_path_real=s|sx_cmp=n|")
                signatures = concat(signatures, "|run_command=s|getenv=s|len=a|index=an|concat=sv|chr=n|numstr=n|sx_index=sn|push=ln|string_eq=ss|arg=n|arg_count=|read_file=s|write_file=ss|read_line=|read_n=n|write_out=s|flush_out=|gc=|gc_live=|gc_runs=|exit=n|http_get=s|read_dir=s|path_kind=s|path_size=s|path_real=s||sx_cat=sv|sx_len=a|sx_idx=sn|sx_chr=n|sx_read=s|sx_write=ss|sx_http=s|sx_arg=n|sx_argc=|sx_eq=ss|sx_cmp=ss|sx_numstr=n|sx_read_line=|sx_read_n=n|sx_write_out=s|sx_flush_out=|sx_gc_run=|sx_gc_live=|sx_gc_count=|sx_exit=n|sx_mod=nn|sx_lget=ln|sx_llen=l|sx_lpush=ln|spawn=s|sx_spawn=s|child_send=ns|sx_child_send=ns|child_recv=nn|sx_child_recv=nn|child_line=n|sx_child_line=n|child_close=n|sx_child_close=n|make_dir=s|sx_make_dir=s|make_link=ss|sx_make_link=ss|remove_path=s|sx_remove_path=s|read_bytes=sl|sx_read_bytes=sl|write_bytes=sl|sx_write_bytes=sl|bytes_f64=ln|sx_bytes_f64=ln|bit_and=nn|sx_bit_and=nn|bit_or=nn|sx_bit_or=nn|bit_xor=nn|sx_bit_xor=nn|bit_not=n|sx_bit_not=n|shl=nn|sx_shl=nn|shr=nn|sx_shr=nn|sx_getenv=s|sx_read_dir=s|sx_path_kind=s|sx_path_size=s|sx_path_real=s|sx_cmp=ss|")
                kind = sxeenvlookup(env, 4, name, "=")
                when len(kind) == 0 { kind = sxelookup(returns, name, "=") }
                when len(kind) == 0 {
                  give sxerecord(i, "e", concat("unknown function ", concat(name, ": call has no checked return signature")))
                }
                hold parameters = sxeenvlookup(env, 5, name, "=")
                when len(parameters) == 0 { parameters = sxelookup(signatures, name, "=") }
                hold args = ""
                hold count = 0
                i = sxflowspace(text, i + 1)
                hold more = 1
                when i < cached_size_text && sx_index(text, i) == 41 {
                  more = 0
                }
                while more == 1 {
                  hold argument = sxeparse(text, i, env, 0, level + 1, state)
                  hold actual = sxesegment(argument, 1)
                  when string_eq(actual, "e") {
                    give argument
                  }
                  when count >= sxfpkcount(parameters) {
                    give sxerecord(i, "e", "too many call arguments")
                  }
                  hold expected = sxfpkget(parameters, count)
                  when string_eq(expected, "v") {
                    when string_eq(actual, "s") == 0 && string_eq(actual, "n") == 0 {
                      give sxerecord(i, "e", "interpolation requires a string or number")
                    }
                  } otherwise {
                  when string_eq(expected, "a") {
                    when string_eq(actual, "s") == 0 && string_eq(actual, "l") == 0 {
                      give sxerecord(i, "e", "length/index requires a string or list")
                    }
                    when string_eq(actual, "l") {
                      when string_eq(name, "sx_len") || string_eq(name, "len") {
                        name = "sx_llen"
                      }
                      when string_eq(name, "sx_idx") || string_eq(name, "index") {
                        name = "sx_lget"
                      }
                    }
                  } otherwise {
                    when string_eq(expected, actual) == 0 {
                      when count == 0 && (string_eq(name, "push") || string_eq(name, "sx_lpush")) {
                        give sxerecord(i, "e", concat("'", concat(sxecode(argument), "' is not a list")))
                      }
                      give sxerecord(i, "e", "call argument type mismatch")
                    }
                  }
                  }
                  when count > 0 {
                    args = concat(args, ",")
                  }
                  args = concat(args, sxecode(argument))
                  count = count + 1
                  i = sxflowspace(text, sxepos(argument))
                  when i < cached_size_text && sx_index(text, i) == 44 {
                    i = sxflowspace(text, i + 1)
                  } otherwise {
                    more = 0
                  }
                }
                when i >= cached_size_text || sx_index(text, i) != 41 || count != sxfpkcount(parameters) {
                  give sxerecord(i, "e", "call argument count mismatch")
                }
                i = i + 1
                // Source aliases are accepted by this checked parser too.
                // Most callers hand us already-normalized sx_* names, but
                // field-list lowering starts from source text (for example
                // p.xs[len(p.xs) - 1]) and must not leave a bare C `len`.
                when string_eq(name, "len") {
                  name = "sx_len"
                }
                when string_eq(name, "index") {
                  name = "sx_idx"
                }
                // Checked source expressions must emit runtime names even
                // inside another lowered call (not just at the outer call).
                when string_eq(name, "concat") { name = "sx_cat" }
                when string_eq(name, "sx_index") { name = "sx_idx" }
                when string_eq(name, "string_eq") { name = "sx_eq" }
                when string_eq(name, "arg_count") { name = "sx_argc" }
                when string_eq(name, "read_file") { name = "sx_read" }
                when string_eq(name, "write_file") { name = "sx_write" }
                when string_eq(name, "http_get") { name = "sx_http" }
                when string_eq(name, "push") { name = "sx_lpush" }
                when string_eq(name, "gc") { name = "sx_gc_run" }
                when string_eq(name, "gc_runs") { name = "sx_gc_count" }
                when sxseed_csv_has("chr,arg,numstr,read_line,read_n,write_out,flush_out,gc_live,exit,read_dir,path_kind,path_size,path_real,run_command,getenv,spawn,child_send,child_recv,child_line,child_close,make_dir,make_link,remove_path,write_bytes,bytes_f64,read_bytes,bit_and,bit_or,bit_xor,bit_not,shl,shr", name) == 1 {
                  name = concat("sx_", name)
                }
                code = concat(name, "(")
                code = concat(code, args)
                code = concat(code, ")")
              } otherwise {
                code = name
                kind = "n"
                when string_eq(name, "true") || string_eq(name, "false") {
                  code = "0.0"
                  when string_eq(name, "true") {
                    code = "1.0"
                  }
                } otherwise {
                  hold numeric = sxeenvlookup(env, 0, name, "|")
                  hold strings = sxeenvlookup(env, 1, name, "|")
                  hold lists = sxeenvlookup(env, 2, name, "|")
                  hold structs = sxeenvlookup(env, 3, name, "=")
                  when len(numeric) == 0 && len(strings) == 0 && len(lists) == 0 && len(structs) == 0 {
                    give sxerecord(i, "e", concat("unbound expression name: ", name))
                  }
                  when len(strings) > 0 {
                    kind = "s"
                  }
                  when len(lists) > 0 {
                    kind = "l"
                  }
                  when len(structs) > 0 {
                    kind = concat("u", structs)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  when string_eq(kind, "e") {
    give sxerecord(i, kind, code)
  }
  hold running = 1
  while running == 1 {
    i = sxflowspace(text, i)
    hold op = ""
    hold precedence = 0
    hold width = 1
    hold c = 0
    when i < cached_size_text {
      c = sx_index(text, i)
    }
    when c == 46 {
      when len(kind) < 2 || sx_index(kind, 0) != 117 {
        give sxerecord(i, "e", "field selector requires a struct")
      }
      i = sxflowspace(text, i + 1)
      hold field = sxflowword(text, i)
      hold typename = sxeslice(kind, 1, len(kind))
      hold fieldkey = concat(typename, ".")
      fieldkey = concat(fieldkey, field)
      hold fieldkind = sxeenvlookup(env, 7, fieldkey, "=")
      when len(fieldkind) == 0 {
        give sxerecord(i, "e", "unknown or unresolved struct field")
      }
      kind = "n"
      when string_eq(fieldkind, "1") {
        kind = "s"
      }
      // Field tag 3 is an owning alias to a numeric-list object.  It is
      // distinct from tag 2 (an inline concrete struct), so postfix indexing
      // and len() choose the list runtime rather than treating the pointer as
      // a numeric C field.
      when string_eq(fieldkind, "3") {
        kind = "l"
      }
      when sx_index(fieldkind, 0) == 50 {
        kind = concat("u", sxeslice(fieldkind, 2, len(fieldkind)))
      }
      code = concat("(", code)
      code = concat(code, ").")
      code = concat(code, field)
      i = i + len(field)
    } otherwise {
    when c == 91 && (string_eq(kind, "l") || string_eq(kind, "s")) {
      hold index = sxeparse(text, i + 1, env, 0, level + 1, state)
      when string_eq(sxesegment(index, 1), "n") == 0 {
        give sxerecord(i, "e", "index must be numeric")
      }
      i = sxflowspace(text, sxepos(index))
      when i >= cached_size_text || sx_index(text, i) != 93 {
        give sxerecord(i, "e", "unbalanced index")
      }
      hold indexed = "sx_lget("
      when string_eq(kind, "s") {
        indexed = "sx_idx("
      }
      indexed = concat(indexed, code)
      indexed = concat(indexed, ",")
      indexed = concat(indexed, sxecode(index))
      code = concat(indexed, ")")
      kind = "n"
      i = i + 1
    } otherwise {
      hold pair = sxeslice(text, i, i + 2)
      when string_eq(pair, "||") {
        precedence = 1
        width = 2
      }
      when string_eq(pair, "&&") {
        precedence = 2
        width = 2
      }
      when string_eq(pair, "==") || string_eq(pair, "!=") {
        precedence = 3
        width = 2
      }
      when c == 60 || c == 62 {
        precedence = 4
        when string_eq(pair, "<=") || string_eq(pair, ">=") {
          width = 2
        }
      }
      when c == 43 || c == 45 {
        precedence = 5
      }
      when c == 42 || c == 47 || c == 37 {
        precedence = 6
      }
      when c == 97 && string_eq(sxflowword(text, i), "and") { precedence = 2
        width = 3 }
      when c == 111 && string_eq(sxflowword(text, i), "or") { precedence = 1
        width = 2 }
      when precedence == 0 || precedence < minimum {
        running = 0
      } otherwise {
        op = sxeslice(text, i, i + width)
        when c == 97 && width == 3 { op = "&&" }
        when c == 111 && width == 2 { op = "||" }
        hold right = sxeparse(text, i + width, env, precedence + 1, level + 1, state)
        hold rightkind = sxesegment(right, 1)
        when string_eq(kind, "s") && string_eq(rightkind, "s") && (c == 43 || precedence == 3 || precedence == 4) {
          when c == 43 {
            code = concat("sx_cat(", code)
            code = concat(code, ",")
            code = concat(code, sxecode(right))
            code = concat(code, ")")
          } otherwise {
            code = concat("(sx_cmp(", code)
            code = concat(code, ",")
            code = concat(code, sxecode(right))
            code = concat(code, ") ")
            code = concat(code, op)
            code = concat(code, " 0.0)")
            kind = "n"
          }
          i = sxepos(right)
        } otherwise {
          when string_eq(kind, "n") == 0 || string_eq(sxesegment(right, 1), "n") == 0 {
            give sxerecord(i, "e", "numeric operator requires numeric operands")
          }
          i = sxepos(right)
          when c == 37 {
            code = concat("sx_mod(", code)
            code = concat(code, ",")
            code = concat(code, sxecode(right))
            code = concat(code, ")")
          } otherwise {
            code = concat("(", code)
            code = concat(code, " ")
            code = concat(code, op)
            code = concat(code, " ")
            code = concat(code, sxecode(right))
            code = concat(code, ")")
          }
          kind = "n"
        }
      }
    }
  }
  }
  give sxerecord(i, kind, code)
}

// Check value references against the current binding table before lowering.
// Calls use a different namespace; field labels/selectors are not bindings.
make sxcheckrefs(text: str, bindings: str, functions: str) -> str {
  hold cached_size_text = len(text)
  hold i = sxflowspace(text, 0)
  hold word = sxflowword(text, i)
  when string_eq(word, "hold") {
    while i < cached_size_text && sx_index(text, i) != 61 {
      i = i + 1
    }
    i = i + 1
  } otherwise {
    when string_eq(word, "show") || string_eq(word, "give") || string_eq(word, "when") || string_eq(word, "while") {
      i = i + len(word)
    } otherwise {
      when string_eq(word, "for") {
        i = sxflowspace(text, i + 3)
        hold binder = sxflowword(text, i)
        i = sxflowspace(text, i + len(binder))
        hold inword = sxflowword(text, i)
        i = i + len(inword)
      }
    }
  }
  hold builtins = "|concat=|len=|sx_index=|index=|chr=|read_file=|write_file=|http_get=|arg=|arg_count=|string_eq=|push=|numstr=|read_line=|read_n=|write_out=|flush_out=|gc=|exit=|gc_live=|gc_runs=|read_dir=|path_kind=|path_size=|path_real=|run_command=|getenv=|sx_getenv=|spawn=|child_send=|child_recv=|child_line=|child_close=|make_dir=|make_link=|remove_path=|sx_read_dir=|sx_path_kind=|sx_path_size=|sx_path_real=|sx_run_command=|sx_spawn=|sx_child_send=|sx_child_recv=|sx_child_line=|sx_child_close=|sx_make_dir=|sx_make_link=|sx_remove_path=|write_bytes=|bytes_f64=|read_bytes=|bit_and=|bit_or=|bit_xor=|bit_not=|shl=|shr=|sx_write_bytes=|sx_bytes_f64=|sx_read_bytes=|sx_bit_and=|sx_bit_or=|sx_bit_xor=|sx_bit_not=|sx_shl=|sx_shr=|sx_cat=|sx_len=|sx_idx=|sx_chr=|sx_read=|sx_write=|sx_http=|sx_arg=|sx_argc=|sx_eq=|sx_numstr=|sx_read_line=|sx_read_n=|sx_write_out=|sx_flush_out=|sx_gc_run=|sx_gc_live=|sx_gc_count=|sx_exit=|sx_mod=|sx_lget=|sx_llen=|sx_lpush=|"
  hold callnames = concat(functions, builtins)
  hold prev = 0
  hold braces = 0
  while i < cached_size_text {
    hold c = sx_index(text, i)
    when c == 34 {
      i = i + 1
      hold quote = 1
      while i < cached_size_text && quote == 1 {
        hold q = sx_index(text, i)
        i = i + 1
        when q == 92 && i < cached_size_text {
          i = i + 1
        } otherwise {
          when q == 34 {
            quote = 0
          }
        }
      }
      prev = 34
    } otherwise {
      when c == 47 && i + 1 < cached_size_text && sx_index(text, i + 1) == 47 {
        while i < cached_size_text && sx_index(text, i) != 10 {
          i = i + 1
        }
      } otherwise {
        when (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
          word = sxflowword(text, i)
          i = i + len(word)
          hold next = sxflowspace(text, i)
          hold after = 0
          when next < cached_size_text {
            after = sx_index(text, next)
          }
          hold ignore = 0
          when prev == 46 || (braces > 0 && after == 58) || after == 123 {
            ignore = 1
          }
          when string_eq(word, "true") || string_eq(word, "false") || string_eq(word, "and") || string_eq(word, "or") || string_eq(word, "not") {
            ignore = 1
          }
          when ignore == 0 {
            hold key = concat("|", word)
            hold table = bindings
            when after == 40 {
              key = concat(key, "=")
              table = callnames
            } otherwise {
              key = concat(key, "|")
            }
            hold found = 0
            hold t = 0
            while t + len(key) <= len(table) && found == 0 {
              hold k = 0
              hold match = 1
              while k < len(key) && match == 1 {
                when sx_index(key, k) != sx_index(table, t + k) {
                  match = 0
                }
                k = k + 1
              }
              when match == 1 {
                found = 1
              }
              t = t + 1
            }
            when found == 0 {
              hold message = "undefined name: "
              when after == 40 {
                message = "unknown function: "
              }
              give concat(message, word)
            }
          }
          prev = 65
        } otherwise {
          when c == 123 {
            braces = braces + 1
          }
          when c == 125 {
            braces = braces - 1
          }
          when c != 32 && c != 9 && c != 10 && c != 13 {
            when c == 46 {
              when prev == 65 || prev == 93 || prev == 41 {
                prev = 46
              } otherwise {
                prev = 0
              }
            } otherwise {
              prev = c
            }
          }
          i = i + 1
        }
      }
    }
  }
  give ""
}

// Conservative structural return proof. Loops may execute zero times;
// only give, a returning suffix, or exhaustive returning branches prove it.
// These helpers read source only; expression/type checking remains separate.
// Lower bounded identifier interpolation before the ordinary expression walk.
// state appends event 1 for a hole, event 2 for a malformed hole.
// Programs without a marker use the byte-preserving fast path.
make sxinterpolate(text: str, private: str, state: list) -> str {
  hold cached_size_text = len(text)
  hold marker = concat(chr(36), chr(123))
  when sxecontains(text, marker) == 0 {
    give text
  }
  hold out = ""
  hold at = 0
  while at < cached_size_text {
    hold c = sx_index(text, at)
    when c == 47 && at + 1 < cached_size_text && sx_index(text, at + 1) == 47 {
      while at < cached_size_text && sx_index(text, at) != 10 {
        out = concat(out, chr(sx_index(text, at)))
        at = at + 1
      }
    } otherwise {
      when c == 34 {
        at = at + 1
        hold fragment = chr(34)
        hold expression = ""
        hold holes = 0
        hold quoted = 1
        while at < cached_size_text && quoted == 1 {
          c = sx_index(text, at)
          when c == 92 && at + 1 < cached_size_text {
            hold escaped = sx_index(text, at + 1)
            when escaped == 36 && at + 2 < cached_size_text && sx_index(text, at + 2) == 123 {
              // A single escaped dollar protects a literal marker.
              fragment = concat(fragment, marker)
              at = at + 3
            } otherwise {
              fragment = concat(fragment, chr(c))
              fragment = concat(fragment, chr(escaped))
              at = at + 2
            }
          } otherwise {
            when c == 34 {
              fragment = concat(fragment, chr(34))
              when holes > 0 {
                expression = concat("concat(", expression)
                expression = concat(expression, ",")
                expression = concat(expression, fragment)
                expression = concat(expression, ")")
              } otherwise {
                expression = fragment
              }
              out = concat(out, expression)
              at = at + 1
              quoted = 0
            } otherwise {
              when c == 36 && at + 1 < cached_size_text && sx_index(text, at + 1) == 123 && holes < 16 {
                hold start = at + 2
                hold name = sxflowword(text, start)
                hold stop = start + len(name)
                hold valid = 0
                when len(name) > 0 {
                  hold first = sx_index(name, 0)
                  when (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95 {
                    when stop < cached_size_text && sx_index(text, stop) == 125 {
                      valid = 1
                    }
                  }
                }
                when valid == 1 {
                  fragment = concat(fragment, chr(34))
                  when holes == 0 {
                    expression = fragment
                  } otherwise {
                    expression = concat("concat(", expression)
                    expression = concat(expression, ",")
                    expression = concat(expression, fragment)
                    expression = concat(expression, ")")
                  }
                  expression = concat("concat(", expression)
                  expression = concat(expression, ",")
                  expression = concat(expression, private)
                  expression = concat(expression, "(")
                  expression = concat(expression, name)
                  expression = concat(expression, "))")
                  fragment = chr(34)
                  holes = holes + 1
                  push(state, 1)
                  at = stop + 1
                } otherwise {
                  push(state, 2)
                  fragment = concat(fragment, chr(c))
                  at = at + 1
                }
              } otherwise {
                when c == 36 && at + 1 < cached_size_text && sx_index(text, at + 1) == 123 {
                  push(state, 2)
                }
                fragment = concat(fragment, chr(c))
                at = at + 1
              }
            }
          }
        }
        when quoted == 1 {
          push(state, 2)
          out = concat(out, fragment)
        }
      } otherwise {
        out = concat(out, chr(c))
        at = at + 1
      }
    }
  }
  give out
}
// Struct function signature codec: scalar kinds stay one byte; a named
// struct parameter is uName; so identity and argument boundaries survive.
make sxfpkget(kinds: str, wanted: num) -> str {
  hold cached_size_kinds = len(kinds)
  hold at = 0
  hold count = 0
  while at < cached_size_kinds {
    hold kind = chr(sx_index(kinds, at))
    at = at + 1
    when string_eq(kind, "u") {
      while at < cached_size_kinds && sx_index(kinds, at) != 59 {
        kind = concat(kind, chr(sx_index(kinds, at)))
        at = at + 1
      }
      at = at + 1
    }
    when count == wanted {
      give kind
    }
    count = count + 1
  }
  give ""
}
make sxfpkcount(kinds: str) -> num {
  hold cached_size_kinds = len(kinds)
  hold at = 0
  hold count = 0
  while at < cached_size_kinds {
    hold c = sx_index(kinds, at)
    at = at + 1
    when c == 117 {
      while at < cached_size_kinds && sx_index(kinds, at) != 59 {
        at = at + 1
      }
      at = at + 1
    }
    count = count + 1
  }
  give count
}
// Discover concrete declaration identities, not layouts or path aliases.
make sxfstructnames(text: str) -> str {
  hold cached_size_text = len(text)
  hold names = "|"
  hold at = 0
  while at < cached_size_text {
    at = sxflowspace(text, at)
    when at < cached_size_text {
      when sx_index(text, at) == 34 {
        at = at + 1
        hold quoted = 1
        while at < cached_size_text && quoted == 1 {
          hold c = sx_index(text, at)
          at = at + 1
          when c == 92 {
            at = at + 1
          }
          when c == 34 {
            quoted = 0
          }
        }
      } otherwise {
        hold word = sxflowword(text, at)
        at = at + len(word)
        when string_eq(word, "struct") {
          at = sxflowspace(text, at)
          hold name = sxflowword(text, at)
          at = sxflowspace(text, at + len(name))
          when at < cached_size_text && sx_index(text, at) == 123 {
            names = concat(names, name)
            names = concat(names, "|")
          }
        }
        when len(word) == 0 {
          at = at + 1
        }
      }
    }
  }
  give names
}
// Check expressions involving a struct binding or struct signature. Avoid
// routing unrelated historical emitter syntax through the checked parser.
make sxfneedscheck(text: str, returns: str, params: str, structs: str) -> num {
  hold cached_size_text = len(text)
  hold at = 0
  hold quoted = 0
  while at < cached_size_text {
    hold c = sx_index(text, at)
    when quoted == 1 {
      at = at + 1
      when c == 92 {
        at = at + 1
      }
      when c == 34 {
        quoted = 0
      }
    } otherwise {
      when c == 34 {
        quoted = 1
        at = at + 1
      } otherwise {
        hold word = sxflowword(text, at)
        when len(word) > 0 {
          when len(sxelookup(structs, word, "=")) > 0 {
            give 1
          }
          hold next = sxflowspace(text, at + len(word))
          when next < cached_size_text && sx_index(text, next) == 40 {
            hold result = sxelookup(returns, word, "=")
            when len(result) > 1 && sx_index(result, 0) == 117 {
              give 1
            }
            when sxecontains(sxelookup(params, word, "="), "u") == 1 {
              give 1
            }
          }
          at = at + len(word)
        } otherwise {
          at = at + 1
        }
      }
    }
  }
  give 0
}
make sxfenv(decls: str, strings: str, lists: str, structs: str, returns: str, params: str, fields: str, private: str) -> str {
  hold env = concat(decls, chr(1))
  env = concat(env, strings)
  env = concat(env, chr(1))
  env = concat(env, lists)
  env = concat(env, chr(1))
  env = concat(env, structs)
  env = concat(env, chr(1))
  env = concat(env, returns)
  env = concat(env, chr(1))
  env = concat(env, params)
  env = concat(env, chr(1))
  env = concat(env, private)
  env = concat(env, chr(1))
  env = concat(env, fields)
  give env
}
make sxflowspace(text: str, at: num) -> num {
  hold cached_size_text = len(text)
  hold i = at
  hold n = cached_size_text
  hold run = 1
  while i < n && run == 1 {
    hold c = sx_index(text, i)
    when c == 32 || c == 9 || c == 10 || c == 13 {
      i = i + 1
    } otherwise {
      when c == 47 && i + 1 < n && sx_index(text, i + 1) == 47 {
        while i < n && sx_index(text, i) != 10 {
          i = i + 1
        }
      } otherwise {
        run = 0
      }
    }
  }
  give i
}
make sxflowword(text: str, at: num) -> str {
  hold cached_size_text = len(text)
  hold i = at
  hold word = ""
  hold run = 1
  while i < cached_size_text && run == 1 {
    hold c = sx_index(text, i)
    when (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      word = concat(word, chr(c))
      i = i + 1
    } otherwise {
      run = 0
    }
  }
  give word
}
// Skip an expression/ordinary statement, respecting literal braces/quotes.
// mode 1 locates the opening brace of a control body; mode 0 its line end.
make sxflowskip(text: str, at: num, mode: num) -> num {
  hold cached_size_text = len(text)
  hold i = at
  hold n = cached_size_text
  hold quote = 0
  hold nesting = 0
  hold run = 1
  while i < n && run == 1 {
    hold c = sx_index(text, i)
    when quote == 1 {
      i = i + 1
      when c == 92 && i < n {
        i = i + 1
      } otherwise {
        when c == 34 {
          quote = 0
        }
      }
    } otherwise {
      when c == 34 {
        quote = 1
        i = i + 1
      } otherwise {
        when c == 47 && i + 1 < n && sx_index(text, i + 1) == 47 {
          while i < n && sx_index(text, i) != 10 {
            i = i + 1
          }
        } otherwise {
          when (mode == 1 && c == 123 && nesting == 0) || (mode == 0 && nesting == 0 && (c == 10 || c == 13 || c == 125)) {
            run = 0
          } otherwise {
            when c == 40 || c == 91 || c == 123 {
              nesting = nesting + 1
            }
            when c == 41 || c == 93 || c == 125 {
              nesting = nesting - 1
            }
            i = i + 1
          }
        }
      }
    }
  }
  give i
}
// Result: position after closing brace, proven-return flag.
make sxflowblock(text: str, at: num, level: num) -> list {
  hold cached_size_text = len(text)
  hold limit = cached_size_text
  when level > 128 {
    give [limit, 0]
  }
  hold i = sxflowspace(text, at)
  when i >= cached_size_text || sx_index(text, i) != 123 {
    give [limit, 0]
  }
  i = i + 1
  hold proven = 0
  hold run = 1
  while i < cached_size_text && run == 1 {
    i = sxflowspace(text, i)
    when i >= cached_size_text {
      give [i, 0]
    }
    when sx_index(text, i) == 125 {
      i = i + 1
      run = 0
    } otherwise {
      hold word = sxflowword(text, i)
      i = i + len(word)
      when string_eq(word, "when") {
        i = sxflowskip(text, i, 1)
        hold branch = sxflowblock(text, i, level + 1)
        i = branch[0]
        hold all = branch[1]
        hold finalelse = 0
        hold tails = 1
        while tails == 1 {
          hold next = sxflowspace(text, i)
          hold tail = sxflowword(text, next)
          hold iselif = string_eq(tail, "elif")
          hold iselse = string_eq(tail, "else")
          when string_eq(tail, "otherwise") {
            iselse = 1
          }
          when iselif == 1 || iselse == 1 {
            i = sxflowspace(text, next + len(tail))
            when iselse == 1 {
              hold after = sxflowword(text, i)
              when string_eq(after, "if") || string_eq(after, "when") {
                i = i + len(after)
              } otherwise {
                finalelse = 1
              }
            }
            i = sxflowskip(text, i, 1)
            hold arm = sxflowblock(text, i, level + 1)
            i = arm[0]
            hold armreturns = arm[1]
            when armreturns == 0 {
              all = 0
            }
            when finalelse == 1 {
              tails = 0
            }
          } otherwise {
            tails = 0
          }
        }
        when all == 1 && finalelse == 1 {
          proven = 1
        }
      } otherwise {
        when string_eq(word, "while") || string_eq(word, "for") {
          i = sxflowskip(text, i, 1)
          hold loop = sxflowblock(text, i, level + 1)
          i = loop[0]
        } otherwise {
          when string_eq(word, "give") {
            proven = 1
          }
          i = sxflowskip(text, i, 0)
        }
      }
    }
  }
  when run == 1 {
    give [i, 0]
  }
  give [i, proven]
}

// raw_index(source, from, n) -> str: the text inside `[ ]`, copied verbatim
// from `from` to the closing ']' ("" = cannot lower; callers refuse clearly).
make tbl_has(table: str, name: str) -> num {
  hold cached_size_table = len(table)
  hold thkey = concat(concat("|", name), "|")
  hold thi = 0
  hold thkl = len(thkey)
  hold thtl = cached_size_table
  hold thfound = 0
  while thi + thkl <= thtl && thfound == 0 {
    hold thmt = 1
    hold thj = 0
    while thj < thkl {
      when sx_index(table, thi + thj) == sx_index(thkey, thj) {
        hold thj = thj + 1
      } otherwise {
        hold thmt = 0
        hold thj = thkl
      }
    }
    when thmt == 1 {
      hold thfound = 1
    }
    hold thi = thi + 1
  }
  give thfound
}

// ---------------------------------------------------------------------------
// str_operand: is this expression text a string? It answers 1 for a quoted
make str_operand(text: str, sdecls: str) -> num {
  hold cached_size_text = len(text)
  // the operand scans leave the spacing of the source on either side, and a
  // table lookup is by exact name: trim spaces and tabs first
  hold sob = 0
  hold soe = cached_size_text
  hold sorun = 1
  while sorun == 1 {
    when sob >= soe {
      hold sorun = 0
    } otherwise {
      hold socd = sx_index(text, sob)
      when socd == 32 || socd == 9 {
        hold sob = sob + 1
      } otherwise {
        hold sorun = 0
      }
    }
  }
  hold sorun = 1
  while sorun == 1 {
    when soe <= sob {
      hold sorun = 0
    } otherwise {
      hold socd = sx_index(text, soe - 1)
      when socd == 32 || socd == 9 {
        hold soe = soe - 1
      } otherwise {
        hold sorun = 0
      }
    }
  }
  hold sot = ""
  hold soi = sob
  while soi < soe {
    hold sot = concat(sot, chr(sx_index(text, soi)))
    hold soi = soi + 1
  }
  hold son = len(sot)
  when son == 0 {
    give 0
  }
  when sx_index(sot, 0) == 34 {
    give 1
  }
  // the head is the text before the first '(', or the whole text
  hold sohead = ""
  hold soi = 0
  hold sopar = 0 - 1
  while soi < son {
    hold socd = sx_index(sot, soi)
    when sopar < 0 {
      when socd == 40 {
        hold sopar = soi
      } otherwise {
        hold sohead = concat(sohead, chr(socd))
      }
    }
    hold soi = soi + 1
  }
  when sopar < 0 {
    give tbl_has(sdecls, sohead)
  }
  when string_eq(sohead, "concat") || string_eq(sohead, "chr") || string_eq(sohead, "read_file") || string_eq(sohead, "numstr") || string_eq(sohead, "arg") || string_eq(sohead, "read_line") || string_eq(sohead, "read_n") || string_eq(sohead, "http_get") || string_eq(sohead, "getenv") {
    give 1
  }
  when string_eq(sohead, "sx_cat") || string_eq(sohead, "sx_chr") || string_eq(sohead, "sx_read") || string_eq(sohead, "sx_numstr") || string_eq(sohead, "sx_arg") || string_eq(sohead, "sx_read_line") || string_eq(sohead, "sx_read_n") || string_eq(sohead, "sx_http") || string_eq(sohead, "sx_getenv") {
    give 1
  }
  give 0
}

// idx_lower: lower `[ ]` text into C. len(NAME)->sx_llen/sx_len, NAME[IDX]->
// sx_lget/sx_idx (IDX lowered recursively), `%`->sx_mod(chain, atom) with the
make idx_chain_start(out: str) -> num {
  hold cached_size_out = len(out)
  hold ls = 0
  hold dep = 0
  hold i = cached_size_out - 1
  hold done = 0
  while i >= 0 && done == 0 {
    hold c = sx_index(out, i)
    when c == 41 {
      hold dep = dep + 1
    }
    when c == 40 && dep == 0 {
      hold ls = i + 1
      hold done = 1
    }
    when c == 40 && dep > 0 {
      hold dep = dep - 1
    }
    when dep == 0 && c == 44 {
      hold ls = i + 1
      hold done = 1
    }
    when dep == 0 && (c == 43 || c == 45) {
      hold q = i - 1
      while q >= 0 && (sx_index(out, q) == 32 || sx_index(out, q) == 9) {
        hold q = q - 1
      }
      when q >= 0 {
        hold pc = sx_index(out, q)
        when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 || pc == 41 || pc == 93 {
          hold ls = i + 1
          hold done = 1
        }
      }
    }
    hold i = i - 1
  }
  give ls
}

// idx_atom_end(text, from): the end of the factor starting at or after
// `from` (spaces and one sign skipped): a number, a name with any
make idx_atom_end(text: str, from: num) -> num {
  hold cached_size_text = len(text)
  hold n = cached_size_text
  hold j = from
  while j < n && (sx_index(text, j) == 32 || sx_index(text, j) == 9) {
    hold j = j + 1
  }
  when j < n && (sx_index(text, j) == 43 || sx_index(text, j) == 45) {
    hold j = j + 1
  }
  hold start = j
  hold dep = 0
  hold used = 0
  hold run = 1
  while j < n && run == 1 {
    hold c = sx_index(text, j)
    when c == 40 || c == 91 {
      hold dep = dep + 1
      hold used = 1
      hold j = j + 1
    } otherwise {
      when (c == 41 || c == 93) && dep == 0 {
        hold run = 0
      } otherwise {
        when (c == 41 || c == 93) && dep > 0 {
          hold dep = dep - 1
          hold j = j + 1
        } otherwise {
          when dep == 0 && j > start && (c == 43 || c == 45 || c == 42 || c == 47 || c == 37) {
            hold run = 0
          } otherwise {
            when c != 32 && c != 9 {
              hold used = 1
            }
            hold j = j + 1
          }
        }
      }
    }
  }
  when used == 0 || dep != 0 {
    give 0 - 1
  }
  give j
}

// idx_sub: bytes [a, z) of s.
make idx_sub(s: str, a: num, z: num) -> str {
  hold cached_size_s = len(s)
  hold out = ""
  hold i = a
  while i < z && i < cached_size_s {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

// `fnret`/`fnpk` are the checked function tables (|name=kind| and
// |name=paramkinds|): an index may call a typed function that returns a
// number, so they have to travel with every recursive descent.
make idx_lower(text: str, ldecls: str, sdecls: str, fnret: str, fnpk: str) -> str {
  hold cached_size_text = len(text)
  hold ixlout = ""
  hold ixli = 0
  hold ixln = cached_size_text
  hold ixlbad = 0
  while ixli < ixln && ixlbad == 0 {
    hold ixlnext = ixli + 1
    hold ixlcd = sx_index(text, ixli)
    hold ixlid = 0
    when ixlcd == 34 || ixlcd == 44 || ixlcd == 91 || ixlcd == 93 {
      // a quote, a comma and a stray bracket stay refused
      hold ixlbad = 1
    }
    when ixlcd == 37 {
      // `%` -> sx_mod(chain, atom); see idx_chain_start / idx_atom_end.
      hold ixzls = idx_chain_start(ixlout)
      hold ixzj = idx_atom_end(text, ixli + 1)
      hold ixzas = ixli + 1
      while ixzas < ixln && (sx_index(text, ixzas) == 32 || sx_index(text, ixzas) == 9) {
        hold ixzas = ixzas + 1
      }
      hold ixzlow = ""
      when ixzj > 0 {
        hold ixzlow = idx_lower(idx_sub(text, ixzas, ixzj), ldecls, sdecls, fnret, fnpk)
      }
      when ixzj <= 0 || len(ixzlow) == 0 || ixzls >= len(ixlout) {
        hold ixlbad = 1
      } otherwise {
        hold ixlout = concat(concat(concat(concat(idx_sub(ixlout, 0, ixzls), "sx_mod("), idx_sub(ixlout, ixzls, len(ixlout))), ","), concat(ixzlow, ")"))
        hold ixlnext = ixzj
      }
    }
    when (ixlcd >= 97 && ixlcd <= 122) || (ixlcd >= 65 && ixlcd <= 90) || ixlcd == 95 {
      hold ixlid = 1
      // ---- the identifier itself ----
      hold ixlnm = ""
      hold ixlj = ixli
      hold ixlrun = 1
      while ixlrun == 1 {
        when ixlj >= ixln {
          hold ixlrun = 0
        } otherwise {
          hold ixlc2 = sx_index(text, ixlj)
          when (ixlc2 >= 97 && ixlc2 <= 122) || (ixlc2 >= 65 && ixlc2 <= 90) || (ixlc2 >= 48 && ixlc2 <= 57) || ixlc2 == 95 {
            hold ixlnm = concat(ixlnm, chr(ixlc2))
            hold ixlj = ixlj + 1
          } otherwise {
            hold ixlrun = 0
          }
        }
      }
      // ---- spaces between the name and a '(' or a '[' ----
      hold ixlk = ixlj
      hold ixlrun = 1
      while ixlrun == 1 {
        when ixlk >= ixln {
          hold ixlrun = 0
        } otherwise {
          hold ixlc2 = sx_index(text, ixlk)
          when ixlc2 == 32 || ixlc2 == 9 {
            hold ixlk = ixlk + 1
          } otherwise {
            hold ixlrun = 0
          }
        }
      }
      hold ixlpost = 0
      when ixlk < ixln {
        hold ixlpost = sx_index(text, ixlk)
      }
      // ---- a call: len(NAME), or a checked call to a typed function
      // that returns a number (`xs[offset()]`, `xs[pick(i, 1)]`) ----
      when ixlpost == 40 {
        hold ixlarg = ""
        hold ixlj = ixlk + 1
        hold ixlrun = 1
        while ixlrun == 1 {
          when ixlj >= ixln {
            hold ixlrun = 0
          } otherwise {
            hold ixlc2 = sx_index(text, ixlj)
            when ixlc2 == 32 || ixlc2 == 9 {
              hold ixlj = ixlj + 1
            } otherwise {
              hold ixlrun = 0
            }
          }
        }
        hold ixlrun = 1
        while ixlrun == 1 {
          when ixlj >= ixln {
            hold ixlrun = 0
          } otherwise {
            hold ixlc2 = sx_index(text, ixlj)
            when (ixlc2 >= 97 && ixlc2 <= 122) || (ixlc2 >= 65 && ixlc2 <= 90) || (ixlc2 >= 48 && ixlc2 <= 57) || ixlc2 == 95 {
              hold ixlarg = concat(ixlarg, chr(ixlc2))
              hold ixlj = ixlj + 1
            } otherwise {
              hold ixlrun = 0
            }
          }
        }
        hold ixlrun = 1
        while ixlrun == 1 {
          when ixlj >= ixln {
            hold ixlrun = 0
          } otherwise {
            hold ixlc2 = sx_index(text, ixlj)
            when ixlc2 == 32 || ixlc2 == 9 {
              hold ixlj = ixlj + 1
            } otherwise {
              hold ixlrun = 0
            }
          }
        }
        hold ixlclo = 0
        when ixlj < ixln {
          when sx_index(text, ixlj) == 41 {
            hold ixlclo = 1
          }
        }
        hold ixlislen = 0
        when string_eq(ixlnm, "len") == 1 {
          when ixlclo == 1 && len(ixlarg) > 0 {
            hold ixlislen = 1
          }
        }
        when ixlislen == 1 {
          when tbl_has(ldecls, ixlarg) == 1 {
            hold ixlout = concat(ixlout, "sx_llen(")
            hold ixlout = concat(ixlout, ixlarg)
            hold ixlout = concat(ixlout, ")")
          } otherwise {
            when tbl_has(sdecls, ixlarg) == 1 {
              hold ixlout = concat(ixlout, "sx_len(")
              hold ixlout = concat(ixlout, ixlarg)
              hold ixlout = concat(ixlout, ")")
            } otherwise {
              hold ixlbad = 1
            }
          }
          hold ixlnext = ixlj + 1
        } otherwise {
          // Not len(): the name must be a function this program declared with
          // a `-> num` return. Everything else -- a string-returning call, a
          // list-returning call, an unknown name -- keeps the old refusal, so
          // an index is still a checked numeric expression.
          hold ixlrk = sxelookup(fnret, ixlnm, "=")
          when string_eq(ixlrk, "n") == 0 {
            hold ixlbad = 1
          } otherwise {
            // the ')' that closes THIS call, counting nested ( ) and [ ]
            hold ixlcdep = 0
            hold ixlce = 0 - 1
            hold ixlcj = ixlk
            while ixlcj < ixln && ixlce < 0 {
              hold ixlc3 = sx_index(text, ixlcj)
              when ixlc3 == 40 {
                hold ixlcdep = ixlcdep + 1
              }
              when ixlc3 == 41 {
                hold ixlcdep = ixlcdep - 1
                when ixlcdep == 0 {
                  hold ixlce = ixlcj
                }
              }
              hold ixlcj = ixlcj + 1
            }
            when ixlce < 0 {
              hold ixlbad = 1
            } otherwise {
              // split the argument text at top-level commas and lower each
              // piece as its own index expression
              hold ixlargs = ""
              hold ixlac = 0
              hold ixlcur = ""
              hold ixlany = 0
              hold ixladep = 0
              hold ixlai = ixlk + 1
              while ixlai < ixlce && ixlbad == 0 {
                hold ixlc4 = sx_index(text, ixlai)
                when ixlc4 == 40 || ixlc4 == 91 {
                  hold ixladep = ixladep + 1
                }
                when ixlc4 == 41 || ixlc4 == 93 {
                  hold ixladep = ixladep - 1
                }
                when ixlc4 == 44 && ixladep == 0 {
                  hold ixllw = idx_lower(ixlcur, ldecls, sdecls, fnret, fnpk)
                  when len(ixllw) == 0 {
                    hold ixlbad = 1
                  } otherwise {
                    when ixlac > 0 {
                      hold ixlargs = concat(ixlargs, ",")
                    }
                    hold ixlargs = concat(ixlargs, ixllw)
                    hold ixlac = ixlac + 1
                    hold ixlcur = ""
                  }
                } otherwise {
                  hold ixlcur = concat(ixlcur, chr(ixlc4))
                  when ixlc4 != 32 && ixlc4 != 9 {
                    hold ixlany = 1
                  }
                }
                hold ixlai = ixlai + 1
              }
              when ixlbad == 0 && ixlany == 1 {
                hold ixllw2 = idx_lower(ixlcur, ldecls, sdecls, fnret, fnpk)
                when len(ixllw2) == 0 {
                  hold ixlbad = 1
                } otherwise {
                  when ixlac > 0 {
                    hold ixlargs = concat(ixlargs, ",")
                  }
                  hold ixlargs = concat(ixlargs, ixllw2)
                  hold ixlac = ixlac + 1
                }
              }
              // arity and parameter kinds: every lowered index piece is a
              // number, so every declared parameter has to be one too
              hold ixlps = sxelookup(fnpk, ixlnm, "=")
              when ixlac != sxfpkcount(ixlps) {
                hold ixlbad = 1
              }
              hold ixlpi = 0
              while ixlpi < ixlac {
                when string_eq(sxfpkget(ixlps, ixlpi), "n") == 0 {
                  hold ixlbad = 1
                }
                hold ixlpi = ixlpi + 1
              }
              when ixlbad == 0 {
                hold ixlout = concat(ixlout, ixlnm)
                hold ixlout = concat(ixlout, "(")
                hold ixlout = concat(ixlout, ixlargs)
                hold ixlout = concat(ixlout, ")")
                hold ixlnext = ixlce + 1
              }
            }
          }
        }
      }
      // ---- a nested index: NAME[IDX] ----
      when ixlpost == 91 {
        hold ixldep = 0
        hold ixlj = ixlk
        hold ixlend = 0 - 1
        while ixlj < ixln && ixlend < 0 {
          hold ixlc2 = sx_index(text, ixlj)
          when ixlc2 == 91 {
            hold ixldep = ixldep + 1
          }
          when ixlc2 == 93 {
            hold ixldep = ixldep - 1
            when ixldep == 0 {
              hold ixlend = ixlj
            }
          }
          hold ixlj = ixlj + 1
        }
        when ixlend < 0 {
          hold ixlbad = 1
        } otherwise {
          hold ixlsub = ""
          hold ixlj = ixlk + 1
          while ixlj < ixlend {
            hold ixlsub = concat(ixlsub, chr(sx_index(text, ixlj)))
            hold ixlj = ixlj + 1
          }
          hold ixllow = idx_lower(ixlsub, ldecls, sdecls, fnret, fnpk)
          when len(ixlsub) == 0 || len(ixllow) == 0 {
            hold ixlbad = 1
          } otherwise {
            when tbl_has(ldecls, ixlnm) == 1 {
              hold ixlout = concat(ixlout, "sx_lget(")
              hold ixlout = concat(ixlout, ixlnm)
              hold ixlout = concat(ixlout, ",")
              hold ixlout = concat(ixlout, ixllow)
              hold ixlout = concat(ixlout, ")")
            } otherwise {
              when tbl_has(sdecls, ixlnm) == 1 {
                hold ixlout = concat(ixlout, "sx_idx(")
                hold ixlout = concat(ixlout, ixlnm)
                hold ixlout = concat(ixlout, ",")
                hold ixlout = concat(ixlout, ixllow)
                hold ixlout = concat(ixlout, ")")
              } otherwise {
                hold ixlbad = 1
              }
            }
            hold ixlnext = ixlend + 1
          }
        }
      }
      // ---- a plain name, or the head of a dotted field chain ----
      when ixlpost != 40 && ixlpost != 91 {
        hold ixlout = concat(ixlout, ixlnm)
        hold ixlnext = ixlj
      }
    }
    when ixlid == 0 && ixlcd != 37 {
      when (ixlcd >= 48 && ixlcd <= 57) || ixlcd == 46 || ixlcd == 43 || ixlcd == 45 || ixlcd == 42 || ixlcd == 47 || ixlcd == 40 || ixlcd == 41 || ixlcd == 32 || ixlcd == 9 {
        hold ixlout = concat(ixlout, chr(ixlcd))
      } otherwise {
        hold ixlbad = 1
      }
    }
    hold ixli = ixlnext
  }
  when ixlbad == 1 {
    give ""
  }
  give ixlout
}



make raw_index(source: str, from: num, n: num) -> str {
  hold rixout = ""
  hold rixi = from
  hold rixrun = 1
  hold rixbal = 0
  hold rixbrk = 0
  hold rixfirst = 0
  hold rixlast = 0
  hold rixdot = 0
  hold rixseen = 0
  hold rixok = 1
  while rixrun == 1 {
    when rixi >= n {
      hold rixrun = 0
      hold rixok = 0
    } otherwise {
      hold rixcd = sx_index(source, rixi)
      hold rixend = 0
      when rixcd == 93 {
        when rixbrk > 0 {
          // a ']' that closes a nested index is part of the expression
          hold rixbrk = rixbrk - 1
        } otherwise {
          hold rixend = 1
        }
      }
      when rixend == 1 {
        hold rixrun = 0
      } otherwise {
        hold rixallow = 0
        when rixcd == 32 || rixcd == 9 {
          hold rixallow = 1
        }
        when rixcd >= 48 && rixcd <= 57 {
          hold rixallow = 1
        }
        when rixcd >= 97 && rixcd <= 122 {
          hold rixallow = 1
        }
        when rixcd >= 65 && rixcd <= 90 {
          hold rixallow = 1
        }
        when rixcd == 95 {
          hold rixallow = 1
        }
        when rixcd == 43 || rixcd == 45 || rixcd == 42 || rixcd == 47 || rixcd == 37 {
          hold rixallow = 1
        }
        when rixcd == 40 || rixcd == 41 || rixcd == 46 {
          hold rixallow = 1
        }
        when rixcd == 91 || rixcd == 93 {
          // a nested index: raw_index copies it verbatim (so the caller's
          // position arithmetic stays right) and idx_lower lowers it
          hold rixallow = 1
          when rixcd == 91 {
            hold rixbrk = rixbrk + 1
          }
        }
        when rixallow == 1 {
          hold rixout = concat(rixout, chr(rixcd))
          hold rixi = rixi + 1
          when rixcd == 32 || rixcd == 9 {
            hold rixdot = 0
          } otherwise {
            hold rixseen = 1
            when rixfirst == 0 {
              hold rixfirst = rixcd
            }
            hold rixlast = rixcd
            when rixcd == 40 {
              hold rixbal = rixbal + 1
            }
            when rixcd == 41 {
              hold rixbal = rixbal - 1
            }
            when rixcd == 46 {
              hold rixdot = rixdot + 1
            } otherwise {
              hold rixdot = 0
            }
          }
        } otherwise {
          hold rixrun = 0
          hold rixok = 0
        }
      }
    }
  }
  when rixseen == 0 {
    hold rixok = 0
  }
  when rixbal != 0 {
    hold rixok = 0
  }
  when rixbrk != 0 {
    hold rixok = 0
  }
  when rixdot >= 2 {
    hold rixok = 0
  }
  when rixfirst == 42 || rixfirst == 47 || rixfirst == 41 || rixfirst == 46 || rixfirst == 91 {
    hold rixok = 0
  }
  when rixlast == 43 || rixlast == 45 || rixlast == 42 || rixlast == 47 || rixlast == 40 || rixlast == 46 || rixlast == 91 {
    hold rixok = 0
  }
  when rixok == 0 {
    give ""
  }
  give rixout
}

// Seed-profile checked calls reuse the expression parser and current lexical
// environment, including original source spellings of the runtime builtins.
// C blocks must not expire the language's flat main bindings. Hoist only
// declarations made in nested main blocks, never initializers or loop state.
// Function bodies are separate and keep their lexical local scopes.
make sx_hoist_main(text: str, bindings: str, structs: str) -> str {
  hold declarations = ""
  hold seen = "|"
  hold output = ""
  hold chunk = ""
  hold depth = 0
  hold words = sxsource_pack(text)
  hold size = words[0]
  hold i = 0
  while i < size {
    hold end = i
    hold line = ""
    while end < size && sxsource_get(words, end) != 10 {
      line = concat(line, chr(sxsource_get(words, end)))
      end = end + 1
    }
    hold replacement = line
    when depth > 0 {
      hold begin = sxflowspace(line, 0)
      hold typ = sxflowword(line, begin)
      hold at = sxflowspace(line, begin + len(typ))
      while at < len(line) && sx_index(line, at) == 42 { at = sxflowspace(line, at + 1) }
      hold name = sxflowword(line, at)
      hold after = sxflowspace(line, at + len(name))
      hold tag = ""
      hold declared = 0
      // Never scan the complete binding table for braces, calls, assignments,
      // loop headers or empty names. Only real C declarations can be hoisted.
      when len(name) > 0 && after < len(line) && (sx_index(line, after) == 61 || sx_index(line, after) == 59) {
        when string_eq(typ, "double") || string_eq(typ, "char") || string_eq(typ, "sx_list") {
          declared = tbl_has(bindings, name)
        } otherwise {
          tag = sxelookup(structs, name, "=")
          when len(tag) > 0 && string_eq(typ, tag) { declared = 1 }
        }
      }
      when len(name) > 0 && declared == 1 && after < len(line) && (sx_index(line, after) == 61 || sx_index(line, after) == 59) && (string_eq(typ, "double") || string_eq(typ, "char") || string_eq(typ, "sx_list") || (len(tag) > 0 && string_eq(typ, tag))) {
        when tbl_has(seen, name) == 0 {
          declarations = concat(declarations, sxeslice(line, begin, after))
          declarations = concat(declarations, ";\n")
          seen = concat(seen, concat(name, "|"))
        }
        replacement = ""
        when sx_index(line, after) == 61 {
          replacement = concat(sxeslice(line, 0, begin), sxeslice(line, at, len(line)))
        }
      }
    }
    // Count syntactic braces only, never braces inside C quoted data.
    hold j = 0
    hold quoted = 0
    while j < len(line) {
      hold c = sx_index(line, j)
      when quoted != 0 {
        when c == 92 { j = j + 1 } otherwise {
          when c == quoted { quoted = 0 }
        }
      } otherwise {
        when c == 34 || c == 39 { quoted = c } otherwise {
          when c == 123 { depth = depth + 1 }
          when c == 125 { depth = depth - 1 }
        }
      }
      j = j + 1
    }
    chunk = concat(chunk, concat(replacement, "\n"))
    when len(chunk) > 1024 { output = concat(output, chunk)
      chunk = "" }
    i = end + 1
  }
  give concat(declarations, concat(output, chunk))
}

make sxseed_has_comparison(text: str) -> num {
  hold i = 0
  hold quoted = 0
  while i < len(text) {
    hold c = sx_index(text, i)
    when quoted == 1 {
      when c == 92 { i = i + 1 } otherwise { when c == 34 { quoted = 0 } }
    } otherwise {
      when c == 34 { quoted = 1 } otherwise {
        when c == 60 || c == 62 {
          give 1
        }
        when (c == 61 || c == 33) && i + 1 < len(text) && sx_index(text, i + 1) == 61 {
          give 1
        }
      }
    }
    i = i + 1
  }
  give 0
}

make sxseed_env(decls: str, strings: str, lists: str, structs: str, returns: str, params: str, fields: str, private: str) -> str {
  returns = concat(returns, "|run_command=n|getenv=s|len=n|index=n|concat=s|chr=s|numstr=s|sx_index=n|push=l|string_eq=n|arg=s|arg_count=n|read_file=s|write_file=n|read_line=s|read_n=s|write_out=n|flush_out=n|gc=n|gc_live=n|gc_runs=n|exit=n|http_get=s|read_dir=s|path_kind=n|path_size=n|path_real=s|")
  params = concat(params, "|run_command=s|getenv=s|len=a|index=an|concat=sv|chr=n|numstr=n|sx_index=sn|push=ln|string_eq=ss|arg=n|arg_count=|read_file=s|write_file=ss|read_line=|read_n=n|write_out=s|flush_out=|gc=|gc_live=|gc_runs=|exit=n|http_get=s|read_dir=s|path_kind=s|path_size=s|path_real=s|")
  returns = concat(returns, "|sx_cat=s|sx_len=n|sx_idx=n|sx_chr=s|sx_read=s|sx_write=n|sx_http=s|sx_arg=s|sx_argc=n|sx_eq=n|sx_cmp=n|sx_numstr=s|sx_read_line=s|sx_read_n=s|sx_write_out=n|sx_flush_out=n|sx_gc_run=n|sx_gc_live=n|sx_gc_count=n|sx_exit=n|sx_mod=n|sx_lget=n|sx_llen=n|sx_lpush=l|spawn=n|sx_spawn=n|child_send=n|sx_child_send=n|child_recv=s|sx_child_recv=s|child_line=s|sx_child_line=s|child_close=n|sx_child_close=n|make_dir=n|sx_make_dir=n|make_link=n|sx_make_link=n|remove_path=n|sx_remove_path=n|read_bytes=n|sx_read_bytes=n|write_bytes=n|sx_write_bytes=n|bytes_f64=l|sx_bytes_f64=l|bit_and=n|sx_bit_and=n|bit_or=n|sx_bit_or=n|bit_xor=n|sx_bit_xor=n|bit_not=n|sx_bit_not=n|shl=n|sx_shl=n|shr=n|sx_shr=n|sx_getenv=s|sx_read_dir=s|sx_path_kind=n|sx_path_size=n|sx_path_real=s|")
  params = concat(params, "|sx_cat=sv|sx_len=a|sx_idx=sn|sx_chr=n|sx_read=s|sx_write=ss|sx_http=s|sx_arg=n|sx_argc=|sx_eq=ss|sx_cmp=ss|sx_numstr=n|sx_read_line=|sx_read_n=n|sx_write_out=s|sx_flush_out=|sx_gc_run=|sx_gc_live=|sx_gc_count=|sx_exit=n|sx_mod=nn|sx_lget=ln|sx_llen=l|sx_lpush=ln|spawn=s|sx_spawn=s|child_send=ns|sx_child_send=ns|child_recv=nn|sx_child_recv=nn|child_line=n|sx_child_line=n|child_close=n|sx_child_close=n|make_dir=s|sx_make_dir=s|make_link=ss|sx_make_link=ss|remove_path=s|sx_remove_path=s|read_bytes=sl|sx_read_bytes=sl|write_bytes=sl|sx_write_bytes=sl|bytes_f64=ln|sx_bytes_f64=ln|bit_and=nn|sx_bit_and=nn|bit_or=nn|sx_bit_or=nn|bit_xor=nn|sx_bit_xor=nn|bit_not=n|sx_bit_not=n|shl=nn|sx_shl=nn|shr=nn|sx_shr=nn|sx_getenv=s|sx_read_dir=s|sx_path_kind=s|sx_path_size=s|sx_path_real=s|")
  give sxfenv(decls, strings, lists, structs, returns, params, fields, private)
}
// Validate complete iteration headers before the permissive C lowering.
make sxseed_for(text: str, env: str) -> str {
  hold size = len(text)
  hold start = sxflowspace(text, 0)
  when string_eq(sxflowword(text, start), "for") == 0 { give ""
  }
  hold p = sxflowspace(text, start + 3)
  hold name = sxflowword(text, p)
  when len(name) == 0 { give "seed-min for: invalid binder"
  }
  when sx_index(name, 0) >= 48 && sx_index(name, 0) <= 57 { give "seed-min for: invalid binder"
  }
  when sxseed_csv_has("true,false,and,or,not,for,in,hold,show,make,give,when,elif,else,otherwise,if,while,break,continue,struct,use", name) == 1 { give "seed-min for: binder cannot be a language keyword"
  }
  p = sxflowspace(text, p + len(name))
  when string_eq(sxflowword(text, p), "in") == 0 { give "seed-min for: expected in"
  }
  p = sxflowspace(text, p + 2)
  hold i = p
  hold depth = 0
  hold quote = 0
  hold range = -1
  hold body = size
  hold operator = 0
  while i < size && body == size {
    hold c = sx_index(text, i)
    when quote == 1 {
      when c == 92 { i = i + 1 } otherwise { when c == 34 { quote = 0 } }
    } otherwise {
      when c == 34 { quote = 1 } otherwise {
        when c == 40 || c == 91 { depth = depth + 1 }
        when c == 41 || c == 93 { depth = depth - 1 }
        when depth == 0 {
          when c == 123 { body = i }
          when c == 43 || c == 45 || c == 42 || c == 47 || c == 37 { operator = 1 }
          when c == 46 && i + 1 < size && sx_index(text, i + 1) == 46 {
            when range >= 0 || (i + 2 < size && sx_index(text, i + 2) == 46) { give "seed-min for: malformed range operator"
            }
            range = i
            i = i + 1
          }
        }
      }
    }
    i = i + 1
  }
  when body - p >= 65536 { give "seed-min for: 64 KiB lowering limit"
  }
  hold expression = sxseed_slice(text, p, body)
  hold state = []
  hold binder_kind = "n"
  when range >= 0 {
    hold left = sxseed_slice(text, p, range)
    hold right = sxseed_slice(text, range + 2, body)
    hold lo = sxeparse(left, 0, env, 0, 0, state)
    hold hi = sxeparse(right, 0, env, 0, 0, state)
    when string_eq(sxesegment(lo, 1), "n") == 0 || sxflowspace(left, sxepos(lo)) != len(left) { give "seed-min for: range start must be a complete numeric expression"
    }
    when string_eq(sxesegment(hi, 1), "n") == 0 || sxflowspace(right, sxepos(hi)) != len(right) { give "seed-min for: range end must be a complete numeric expression"
    }
  } otherwise {
    when operator == 1 { give "seed-min for: use a string/list value or call, not an unbound operator expression"
    }
    hold value = sxeparse(expression, 0, env, 0, 0, state)
    hold kind = sxesegment(value, 1)
    when (string_eq(kind, "s") == 0 && string_eq(kind, "l") == 0) || sxflowspace(expression, sxepos(value)) != len(expression) { give "seed-min for: expected a complete string/list iteration value"
    }
    when string_eq(kind, "s") { binder_kind = "s" }
  }
  when len(sxeenvlookup(env, 0, name, "|")) > 0 {
    hold prior = sxeparse(name, 0, env, 0, 0, state)
    when string_eq(sxesegment(prior, 1), binder_kind) == 0 { give "seed-min for: binder type conflicts with existing binding"
    }
  }
  give ""
}
// Preserve the seed's generic-argument and literal-agreement contract before
// mangling discards the source type arguments. Fields are constrained only when
// the template's field count equals its type-argument count, as in the seed ABI.
make sxseed_generic_info(text: str, templates: str) -> str {
  hold i = 0
  hold size = len(text)
  hold previous = ""
  hold error = ""
  hold types = "|"
  while i < size {
    i = gxskip(text, i)
    when i < size {
      when sx_index(text, i) == 34 {
        i = i + 1
        hold quoted = 1
        while i < size && quoted == 1 {
          hold c = sx_index(text, i)
          i = i + 1
          when c == 92 { i = i + 1 } otherwise { when c == 34 { quoted = 0 } }
        }
      } otherwise {
        hold word = sxflowword(text, i)
        when len(word) > 0 {
          hold next = gxskip(text, i + len(word))
          hold rec = sxelookup(templates, word, ":")
          when len(rec) > 0 && string_eq(previous, "struct") == 0 && next < size {
            when sx_index(text, next) == 123 {
              hold example = "num"
              hold argument = 1
              while argument < sx_index(rec, 0) - 48 {
                example = concat(example, ",num")
                argument = argument + 1
              }
              error = concat(word, concat(" is a generic struct: write ", concat(word, concat("<", concat(example, "> { ... }")))))
            }
            when sx_index(text, next) == 60 {
              hold parsed = gxargs(text, next, templates, 0)
              hold code = sxesegment(parsed, 1)
              hold count = sxesegment(parsed, 2)
              when len(code) == 0 {
                hold bad_at = next + 1
                hold bad_name = ""
                while bad_at < size && len(bad_name) == 0 && sx_index(text, bad_at) != 123 {
                  bad_at = gxskip(text, bad_at)
                  hold candidate = sxflowword(text, bad_at)
                  when len(candidate) > 0 {
                    when len(gxkind(candidate)) == 0 && len(sxelookup(templates, candidate, ":")) == 0 { bad_name = candidate }
                    bad_at = bad_at + len(candidate)
                  } otherwise { bad_at = bad_at + 1 }
                }
                error = concat("a type argument must be num, str, list or an instantiation of a generic struct (got '", concat(bad_name, "')"))
              } otherwise {
                when string_eq(count, sxeslice(rec, 0, 1)) == 0 {
                  hold plural = " type arguments, got "
                  when sx_index(rec, 0) == 49 { plural = " type argument, got " }
                  error = concat(word, concat(" takes ", concat(sxeslice(rec, 0, 1), concat(plural, count))))
                } otherwise {
                  hold fields = sxeslice(rec, 2, len(rec))
                  hold field_count = 1
                  hold k = 0
                  while k < len(fields) {
                    when sx_index(fields, k) == 44 { field_count = field_count + 1 }
                    k = k + 1
                  }
                  when field_count == sx_index(rec, 0) - 48 {
                    hold mangled = concat(word, concat("__", code))
                    hold arg = next + 1
                    hold field = 0
                    hold done = 0
                    while done < field_count {
                      arg = gxskip(text, arg)
                      hold name = sxflowword(text, arg)
                      hold after = gxskip(text, arg + len(name))
                      hold kind = gxkind(name)
                      when after < size && sx_index(text, after) == 60 {
                        hold nested = gxargs(text, after, templates, 0)
                        kind = concat(name, concat("__", sxesegment(nested, 1)))
                        after = sxepos(nested)
                      }
                      hold field_name = sxflowword(fields, field)
                      types = concat(types, concat(mangled, concat(".", concat(field_name, concat("=", concat(kind, "|"))))))
                      field = field + len(field_name) + 1
                      arg = gxskip(text, after) + 1
                      done = done + 1
                    }
                  }
                }
              }
            }
          }
          previous = word
          i = i + len(word)
        } otherwise { i = i + 1 }
      }
    }
  }
  give concat(error, concat(chr(1), types))
}
make sxseed_generic_literal(types: str, owner: str, field: str, kind: num, concrete: str) -> str {
  hold expected = sxelookup(types, concat(owner, concat(".", field)), "=")
  when len(expected) == 0 { give ""
  }
  when string_eq(expected, "n") && kind == 0 { give ""
  }
  when string_eq(expected, "s") && kind == 1 { give ""
  }
  when string_eq(expected, "l") && kind == 3 { give ""
  }
  when len(expected) > 1 && kind == 2 && string_eq(expected, concrete) { give ""
  }
  hold wanted = expected
  when string_eq(expected, "n") { wanted = "num" }
  when string_eq(expected, "s") { wanted = "str" }
  when string_eq(expected, "l") { wanted = "list" }
  hold actual = "num"
  when kind == 1 { actual = "str" }
  when kind == 3 { actual = "list" }
  when kind == 2 {
    actual = concat("a ", concrete)
    wanted = concat("a ", wanted)
  }
  hold reason = concat(owner, concat(" field '", concat(field, concat("' is ", concat(wanted, concat(" (its type argument says so), the literal gives ", actual))))))
  give reason
}

// The seed C ABI reserves _sx_gen_ for monomorphised function symbols.
// Rename registered specialisations only, never string contents, struct names,
// unrelated user identifiers or the default mini-compiler profile's symbols.
make sxseed_c_symbols(text: str, registered: str) -> str {
  hold size = len(text)
  hold i = 0
  hold copied = 0
  hold out = ""
  while i < size {
    hold c = sx_index(text, i)
    when c == 34 || c == 39 {
      hold quote = c
      i = i + 1
      hold quoted = 1
      while i < size && quoted == 1 {
        c = sx_index(text, i)
        i = i + 1
        when c == 92 { i = i + 1 } otherwise { when c == quote { quoted = 0 } }
      }
    } otherwise {
      when c == 47 && i + 1 < size && sx_index(text, i + 1) == 47 {
        while i < size && sx_index(text, i) != 10 { i = i + 1 }
      } otherwise {
        when c == 47 && i + 1 < size && sx_index(text, i + 1) == 42 {
          i = i + 2
          hold comment = 1
          while i + 1 < size && comment == 1 {
            when sx_index(text, i) == 42 && sx_index(text, i + 1) == 47 { comment = 0 }
            i = i + 1
          }
          i = i + 1
        } otherwise {
          hold word = sxflowword(text, i)
          when len(word) > 0 {
            when sxecontains(word, "__") && sxecontains(registered, concat(chr(1), concat(word, chr(1)))) {
              out = concat(out, sxseed_slice(text, copied, i))
              out = concat(out, concat("_sx_gen_", word))
              copied = i + len(word)
            }
            i = i + len(word)
          } otherwise { i = i + 1 }
        }
      }
    }
  }
  give concat(out, sxseed_slice(text, copied, size))
}

make sxseed_has_plus(text: str) -> num {
  hold i = 0
  hold size = len(text)
  hold quoted = 0
  while i < size {
    hold c = sx_index(text, i)
    when quoted == 1 {
      when c == 92 { i = i + 1 } otherwise { when c == 34 { quoted = 0 } }
    } otherwise {
      when c == 43 { give 1
      }
      when c == 34 { quoted = 1 }
    }
    i = i + 1
  }
  give 0
}

make sxseed_calls(text: str, env: str, checked: num, declared: str) -> str {
  hold cached_size_text = len(text)
  hold i = sxflowspace(text, 0)
  when string_eq(sxflowword(text, i), "make") == 1 { give ""
  }
  when string_eq(sxflowword(text, i), "show") == 1 {
    hold show_state = []
    hold show_value = sxeparse(text, i + 4, env, 0, 0, show_state)
    when string_eq(sxesegment(show_value, 1), "e") { give sxecode(show_value)
    }
    hold show_end = sxflowspace(text, sxepos(show_value))
    when show_end < cached_size_text && sx_index(text, show_end) != 125 { give "incomplete or trailing show expression"
    }
  }
  hold first = sxflowword(text, i)
  when string_eq(first, "for") { checked = 1 }
  when string_eq(first, "when") || string_eq(first, "while") || string_eq(first, "elif") || string_eq(first, "if") {
    hold condition_state = []
    hold condition_value = sxeparse(text, i + len(first), env, 0, 0, condition_state)
    when string_eq(sxesegment(condition_value, 1), "n") == 0 { give "condition must be numeric"
    }
    hold condition_end = sxflowspace(text, sxepos(condition_value))
    when condition_end < cached_size_text && sx_index(text, condition_end) != 123 { give "incomplete condition expression"
    }
  }
  hold size = cached_size_text
  hold returns = ""
  while i < size {
    hold c = sx_index(text, i)
    when c == 34 {
      i = i + 1
      hold quote = 1
      while i < size && quote == 1 {
        hold qc = sx_index(text, i)
        i = i + 1
        when qc == 92 { i = i + 1 } otherwise {
          when qc == 34 { quote = 0 }
        }
      }
    } otherwise {
      hold name = sxflowword(text, i)
      when len(name) > 0 {
        when len(name) >= 9 && string_eq(sxseed_slice(name, 0, 9), "_sx_iter_") { give "_sx_iter_ prefix is reserved for seed iteration temporaries"
        }
        hold next = sxflowspace(text, i + len(name))
        when checked == 1 && next < size && sx_index(text, next) == 40 && sxseed_csv_has("numstr,sx_numstr,read_line,sx_read_line,read_n,sx_read_n,write_out,sx_write_out,flush_out,sx_flush_out,exit,sx_exit,run_command,sx_run_command,getenv,sx_getenv,read_dir,sx_read_dir,path_kind,sx_path_kind,path_size,sx_path_size,path_real,sx_path_real,spawn,sx_spawn,child_send,sx_child_send,child_recv,sx_child_recv,child_line,sx_child_line,child_close,sx_child_close,make_dir,sx_make_dir,make_link,sx_make_link,remove_path,sx_remove_path,write_bytes,sx_write_bytes,read_bytes,sx_read_bytes,bytes_f64,sx_bytes_f64,bit_and,sx_bit_and,bit_or,sx_bit_or,bit_xor,sx_bit_xor,bit_not,sx_bit_not,shl,sx_shl,shr,sx_shr,sx_cat,sx_mod,sx_lget,sx_llen,sx_lpush", name) {
          give "seed-min for/producer call names an unknown or unsupported function"
        }
        when next < size && sx_index(text, next) == 40 && len(sxelookup(declared, name, "=")) == 0 && sxseed_csv_has("numstr,sx_numstr,read_line,sx_read_line,read_n,sx_read_n,write_out,sx_write_out,flush_out,sx_flush_out,exit,sx_exit,run_command,sx_run_command,getenv,sx_getenv,read_dir,sx_read_dir,path_kind,sx_path_kind,path_size,sx_path_size,path_real,sx_path_real,spawn,sx_spawn,child_send,sx_child_send,child_recv,sx_child_recv,child_line,sx_child_line,child_close,sx_child_close,make_dir,sx_make_dir,make_link,sx_make_link,remove_path,sx_remove_path,write_bytes,sx_write_bytes,read_bytes,sx_read_bytes,bytes_f64,sx_bytes_f64,bit_and,sx_bit_and,bit_or,sx_bit_or,bit_xor,sx_bit_xor,bit_not,sx_bit_not,shl,sx_shl,shr,sx_shr,sx_cat,sx_mod,sx_lget,sx_llen,sx_lpush", name) {
          give "seed-min call names an unknown function or builtin"
        }
        when next < size && sx_index(text, next) == 40 && len(sxeenvlookup(env, 4, name, "=")) > 0 {
          hold state = []
          hold value = sxeparse(text, i, env, 0, 0, state)
          when string_eq(sxesegment(value, 1), "e") == 1 { give sxecode(value)
          }
        }
        i = i + len(name)
      } otherwise { i = i + 1 }
    }
  }
  give ""
}

// compiler_min.sa - pure Sayanox mini-compiler (generation 1 source).
//

struct CompilerPaths { input, output }
struct CompilerSourceSize<T> { bytes }

// ---------------- command line ----------------
hold in_path = "selfhost/mini_in.sa"
hold out_path = "selfhost/mini_out.c"
hold na = arg_count()
hold seed_profile = 0
when na >= 4 { when sx_eq(arg(3), "seed-profile") { hold seed_profile = 1 } }
when na >= 2 {
  hold in_path = arg(1)
}
when na >= 3 {
  hold out_path = arg(2)
}

// Concrete typed compiler state: exercised by every bootstrap generation.
hold compiler_paths: CompilerPaths = CompilerPaths { input: in_path, output: out_path }

// ---------------- compiler state ----------------
hold source = read_file(compiler_paths.input)
hold source_bytes = len(source)
hold compiler_source_size = CompilerSourceSize<num> { bytes: source_bytes }
hold n = compiler_source_size.bytes
// ---------------- struct field logic values (item 8) ----------------
// `Name { x: a and b }` on gen2: a field value that is an and/or/not expression
hold lgsrc = concat(source, "\n")
hold lgsn = len(lgsrc)
hold lgout = ""
hold lgchunk = ""
hold lgline_start = 0
hold lgln = ""
hold lgp = 0
hold lgcount = 0
hold lgch = 0
hold lgnew = ""
hold lgpre = ""
hold lgll = 0
hold lgq = 0
hold lgrun = 1
hold lgw = ""
hold lgj = 0
hold lgbad = 0
hold lgob = -1
hold lgcb = -1
hold lgq2 = 0
hold lgfound = 0
hold lgk = 0
hold lgwd = ""
hold lgci = 0
hold lgcc = 0
hold lgtxt = ""
hold lgtl = 0
hold lgi = 0
hold lgi2 = 0
hold lgft = ""
hold lgbody = ""
hold lgind = ""
hold lgval = ""
hold lgfn = ""
hold lgdig = ""
hold lgv = 0
hold lgdr = 1
hold lgcol = -1
hold lgfl = 0
hold lgs0 = 0
hold lge0 = 0
hold lgvk = 0
hold lglab = ""
hold lgfq = 0
hold lgfe = 0
hold lgstop = 0
hold lgin = 0
hold lgesc = 0
while lgp < lgsn {
  hold lgch = sx_index(lgsrc, lgp)
  hold lgp = lgp + 1
  when lgch == 10 {
    hold lgln = sxseed_slice(lgsrc, lgline_start, lgp - 1)
    hold lgline_start = lgp
    hold lgnew = concat(lgln, "\n")
    hold lgll = len(lgln)
    hold lgbad = 0
    hold lgob = -1
    hold lgcb = -1
    hold lgfound = 0
    // indentation, then the first word of the line
    hold lgq = 0
    hold lgrun = 1
    while lgrun == 1 {
      when lgq >= lgll {
        hold lgrun = 0
      } otherwise {
        when sx_index(lgln, lgq) == 32 {
          hold lgq = lgq + 1
        } otherwise {
          hold lgrun = 0
        }
      }
    }
    hold lgw = ""
    hold lgj = lgq
    hold lgrun = 1
    while lgrun == 1 {
      when lgj >= lgll {
        hold lgrun = 0
      } otherwise {
        hold lgch = sx_index(lgln, lgj)
        when (lgch >= 97 && lgch <= 122) || (lgch >= 65 && lgch <= 90) || (lgch >= 48 && lgch <= 57) || lgch == 95 {
          hold lgw = concat(lgw, chr(lgch))
          hold lgj = lgj + 1
        } otherwise {
          hold lgrun = 0
        }
      }
    }
    // the first brace and its closing brace; a quote or a nested brace disqualifies the line
    hold lgq2 = 0
    hold lgin = 0
    hold lgesc = 0
    while lgq2 < lgll {
      hold lgch = sx_index(lgln, lgq2)
      when lgesc == 1 {
        hold lgesc = 0
      } otherwise {
        when lgin == 1 && lgch == 92 {
          hold lgesc = 1
        }
        when lgch == 34 {
          hold lgin = 1 - lgin
        }
        when lgin == 0 && lgch == 123 {
          when lgob == -1 {
            hold lgob = lgq2
          } otherwise {
            when lgcb == -1 {
              hold lgbad = 1
            }
          }
        }
        when lgin == 0 && lgch == 125 && lgob >= 0 && lgcb == -1 {
          hold lgcb = lgq2
        }
      }
      hold lgq2 = lgq2 + 1
    }
    when lgin == 1 {
      hold lgbad = 1
    }
    when sx_eq(lgw, "hold") && lgob >= 0 && lgcb > lgob && lgbad == 0 {
      hold lgfound = 1
    }
    // does the literal contain an and/or/not word at all?
    when lgfound == 1 {
      hold lgtxt = ""
      hold lgi = lgob + 1
      while lgi < lgcb {
        hold lgtxt = concat(lgtxt, chr(sx_index(lgln, lgi)))
        hold lgi = lgi + 1
      }
      hold lgk = 0
      hold lgwd = ""
      hold lgci = 0
      hold lgin = 0
      hold lgesc = 0
      hold lgtl = len(lgtxt)
      while lgci <= lgtl {
        hold lgcc = 0
        when lgci < lgtl {
          hold lgcc = sx_index(lgtxt, lgci)
        }
        when lgesc == 1 {
          hold lgesc = 0
          hold lgwd = ""
        } otherwise {
          when lgin == 1 && lgcc == 92 {
            hold lgesc = 1
          }
          when lgcc == 34 {
            hold lgin = 1 - lgin
            hold lgwd = ""
          } otherwise {
            when lgin == 1 {
              hold lgwd = ""
            } otherwise {
              when (lgcc >= 97 && lgcc <= 122) || (lgcc >= 65 && lgcc <= 90) || (lgcc >= 48 && lgcc <= 57) || lgcc == 95 {
                hold lgwd = concat(lgwd, chr(lgcc))
              } otherwise {
                when sx_eq(lgwd, "and") || sx_eq(lgwd, "or") || sx_eq(lgwd, "not") {
                  hold lgk = 1
                }
                hold lgwd = ""
              }
            }
          }
        }
        hold lgci = lgci + 1
      }

      when lgk == 0 {
        hold lgfound = 0
      }
    }
    when lgfound == 1 {
      hold lgpre = ""
      hold lgind = ""
      hold lgi = 0
      while lgi < lgq {
        hold lgind = concat(lgind, chr(sx_index(lgln, lgi)))
        hold lgi = lgi + 1
      }
      // the text up to and including '{'
      hold lgnew = ""
      hold lgi = 0
      while lgi <= lgob {
        hold lgnew = concat(lgnew, chr(sx_index(lgln, lgi)))
        hold lgi = lgi + 1
      }
      // the fields, split at top-level commas
      hold lgft = ""
      hold lgbody = ""
      hold lgi = lgob + 1
      hold lgfq = 0
      hold lgfe = 0
      while lgi <= lgcb {
        hold lgch = 125
        when lgi < lgcb {
          hold lgch = sx_index(lgln, lgi)
        }
        when lgfe == 1 {
          hold lgfe = 0
        } otherwise {
          when lgfq == 1 && lgch == 92 {
            hold lgfe = 1
          }
          when lgch == 34 {
            hold lgfq = 1 - lgfq
          }
        }
        when (lgch == 44 && lgfq == 0) || lgi == lgcb {
          // ---- one field: optional label, then the value ----
          hold lgcol = -1
          hold lgfl = len(lgft)
          hold lgi2 = 0
          hold lgstop = 0
          while lgi2 < lgfl {
            when lgstop == 0 {
              hold lgcc = sx_index(lgft, lgi2)
              when lgcc == 58 {
                hold lgcol = lgi2
                hold lgstop = 1
              } otherwise {
                when (lgcc >= 97 && lgcc <= 122) || (lgcc >= 65 && lgcc <= 90) || (lgcc >= 48 && lgcc <= 57) || lgcc == 95 || lgcc == 32 {
                } otherwise {
                  hold lgstop = 1
                }
              }
            }
            hold lgi2 = lgi2 + 1
          }
          hold lgs0 = 0
          when lgcol >= 0 {
            hold lgs0 = lgcol + 1
          }
          hold lgvk = lgs0
          hold lgrun = 1
          while lgrun == 1 {
            when lgvk >= lgfl {
              hold lgrun = 0
            } otherwise {
              when sx_index(lgft, lgvk) == 32 {
                hold lgvk = lgvk + 1
              } otherwise {
                hold lgrun = 0
              }
            }
          }
          hold lge0 = lgfl
          hold lgrun = 1
          while lgrun == 1 {
            when lge0 <= lgvk {
              hold lgrun = 0
            } otherwise {
              when sx_index(lgft, lge0 - 1) == 32 {
                hold lge0 = lge0 - 1
              } otherwise {
                hold lgrun = 0
              }
            }
          }
          hold lgval = ""
          hold lgi2 = lgvk
          while lgi2 < lge0 {
            hold lgval = concat(lgval, chr(sx_index(lgft, lgi2)))
            hold lgi2 = lgi2 + 1
          }
          hold lgtxt = lgval
          hold lgk = 0
          hold lgwd = ""
          hold lgci = 0
          hold lgin = 0
          hold lgesc = 0
          hold lgtl = len(lgtxt)
          while lgci <= lgtl {
            hold lgcc = 0
            when lgci < lgtl {
              hold lgcc = sx_index(lgtxt, lgci)
            }
            when lgesc == 1 {
              hold lgesc = 0
              hold lgwd = ""
            } otherwise {
              when lgin == 1 && lgcc == 92 {
                hold lgesc = 1
              }
              when lgcc == 34 {
                hold lgin = 1 - lgin
                hold lgwd = ""
              } otherwise {
                when lgin == 1 {
                  hold lgwd = ""
                } otherwise {
                  when (lgcc >= 97 && lgcc <= 122) || (lgcc >= 65 && lgcc <= 90) || (lgcc >= 48 && lgcc <= 57) || lgcc == 95 {
                    hold lgwd = concat(lgwd, chr(lgcc))
                  } otherwise {
                    when sx_eq(lgwd, "and") || sx_eq(lgwd, "or") || sx_eq(lgwd, "not") {
                      hold lgk = 1
                    }
                    hold lgwd = ""
                  }
                }
              }
            }
            hold lgci = lgci + 1
          }

          when lgk == 1 {
            hold lgcount = lgcount + 1
            // the name sxlgN, N in decimal
            hold lgdig = ""
            hold lgv = lgcount
            hold lgdr = 1
            while lgdr == 1 {
              hold lgdig = concat(chr(48 + lgv % 10), lgdig)
              hold lgv = (lgv - lgv % 10) / 10
              when lgv < 1 {
                hold lgdr = 0
              }
            }
            hold lgfn = concat("sxlg", lgdig)
            hold lgpre = concat(lgpre, concat(lgind, concat("hold ", concat(lgfn, concat(" = ", concat(lgval, "\n"))))))
            hold lglab = ""
            when lgcol >= 0 {
              hold lgi2 = 0
              while lgi2 <= lgcol {
                hold lglab = concat(lglab, chr(sx_index(lgft, lgi2)))
                hold lgi2 = lgi2 + 1
              }
              hold lglab = concat(lglab, " ")
            }
            hold lgbody = concat(lgbody, concat(lglab, lgfn))
          } otherwise {
            hold lgbody = concat(lgbody, lgft)
          }
          hold lgft = ""
          when lgi < lgcb {
            hold lgbody = concat(lgbody, ",")
          }
        } otherwise {
          hold lgft = concat(lgft, chr(lgch))
        }
        hold lgi = lgi + 1
      }
      hold lgnew = concat(lgnew, lgbody)
      // the text after '}' (the '}' itself is at lgcb)
      hold lgi = lgcb
      while lgi < lgll {
        hold lgnew = concat(lgnew, chr(sx_index(lgln, lgi)))
        hold lgi = lgi + 1
      }
      hold lgnew = concat(concat(lgpre, lgnew), "\n")
    }
    hold lgchunk = concat(lgchunk, lgnew)
    when len(lgchunk) >= 4096 {
      hold lgout = concat(lgout, lgchunk)
      hold lgchunk = ""
    }
    hold lgln = ""
  }
}
hold lgout = concat(lgout, lgchunk)
// Generic struct templates are collected first, then every instantiation is
// rewritten to its mangled concrete name before the walker runs (gxscan,
hold gsdefs = gxscan(lgout)
hold seed_generic_error = ""
hold seed_generic_types = "|"
when seed_profile == 1 && len(gsdefs) > 1 {
  hold info = sxseed_generic_info(lgout, gsdefs)
  seed_generic_error = sxesegment(info, 0)
  seed_generic_types = sxesegment(info, 1)
}
hold gxsdefs = ""
hold source = lgout
when len(gsdefs) > 1 {
  hold gxrec = gxpass(lgout, gsdefs)
  hold gxsdefs = sxesegment(gxrec, 0)
  hold source = sxesegment(gxrec, 1)
  when seed_profile == 0 {
    seed_generic_types = sxesegment(gxrec, 2)
    seed_generic_error = sxesegment(gxrec, 3)
  }
}
hold n = len(source)
hold pos = 0

// =====================================================================
hold body = ""
hold obody = ""
hold decls = "|"
hold sdecls = "|"
hold depth = 0
hold running = 1
hold instate = []
hold inprivate = "__sx_inline_"
hold inready = 0
hold holds = 0
hold shows = 0
hold whiles = 0
hold whens = 0
hold rt = 0
hold fns = ""
hold in_fn = 0
hold saved_body = ""
hold fn_base = 0
hold fn_name = ""
hold fn_params = ""
hold gquoted = 0
hold gqc = 0
hold gexpr = ""
hold ldecls = "|"
// Immutable scope records: parent, then lengths of the four name tables.
// Only function bodies use lexical block tracking; legacy top-level compiler
// programs retain their existing flat declaration contract.
hold scope_marks = []
hold scope_head = -1
// the instantiations gxpass found, before any declaration the walker appends
hold sdefs = gxsdefs
hold gxtpl = 0
hold typedefs = ""
hold stname = ""
hold sfields = ""
hold sf = ""
hold sfind2 = 0
hold lt = 0
hold lk = 0
hold lelems = ""
hold nels = 0
hold el = ""
hold ix = ""
hold lr = 0
hold lfind = 0
hold ec = 0
hold donef = 0
hold walking = 0
hold sfields2 = ""
