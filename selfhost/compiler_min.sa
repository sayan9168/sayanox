            hold opnd = nm3
            // ---- a call as the right operand of a chain ----
            // `1 + len(xs)`, `2 * len(s)`, `"a" + concat("b", "c")` and
            hold ocnx = 0
            hold ocp = pos
            hold ocsk = 1
            while ocsk == 1 {
              when ocp >= n {
                hold ocsk = 0
              } otherwise {
                hold ocx = sxsource_get(source_words, ocp)
                when ocx == 32 || ocx == 9 || ocx == 13 {
                  hold ocp = ocp + 1
                } otherwise {
                  hold ocnx = ocx
                  hold ocsk = 0
                }
              }
            }
            when ocnx == 40 {
              hold pos = ocp + 1
              hold ocarg = ""
              hold ocdepth = 1
              hold ocq = 0
              hold ocrun = 1
              while ocrun == 1 {
                when pos >= n {
                  hold ocrun = 0
                } otherwise {
                  hold ocx = sxsource_get(source_words, pos)
                  when ocq == 1 {
                    hold ocarg = concat(ocarg, chr(ocx))
                    hold pos = pos + 1
                    when ocx == 92 {
                      when pos < n {
