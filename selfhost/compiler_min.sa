// =====================================================================
// main scan loop
// =====================================================================

// =====================================================================
// use "file.sa" expansion (max depth 8, real statements only)
hold exd = 0
hold exlast = -1
hold exdl = 0
hold exdl = len(compiler_paths.input)
while exd < exdl {
  hold excd = 0
  hold excd = sx_index(compiler_paths.input, exd)
  when excd == 47 {
    hold exlast = exd
  }
  hold exd = exd + 1
}
when exlast >= 0 {
  hold exd = 0
  while exd <= exlast {
    hold exdir = concat(exdir, chr(sx_index(compiler_paths.input, exd)))
    hold exd = exd + 1
  }
}

hold exround = 0
hold exmore = 1
while exmore == 1 {
  hold exmore = 0
  hold exround = exround + 1
  hold exs = ""
  hold exch = ""
  hold exm = ""
  hold exchl = 0
  hold exml = 0
  hold exi = 0
  hold exst = 1
  hold exq = 0
  hold excm = 0
  while exi < n {
    // flush the pending chunk (two-level: exch -> exm -> exs).  A single
    // flat accumulator copies everything appended so far on every flush,
    when exchl >= 128 {
      hold exm = concat(exm, exch)
      hold exch = ""
      hold exchl = 0
      hold exml = len(exm)
      when exml > 8192 {
        hold exs = concat(exs, exm)
        hold exm = ""
        hold exml = 0
      }
    }
    hold exc = sx_index(source, exi)
    when exq == 1 {
      // inside a string literal: copy verbatim, honour backslash escapes
      hold exch = concat(exch, chr(exc))
      hold exchl = exchl + 1
      hold exi = exi + 1
      when exc == 92 {
        when exi < n {
          hold exch = concat(exch, chr(sx_index(source, exi)))
          hold exchl = exchl + 1
          hold exi = exi + 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 0
        }
      }
    } otherwise {
      when excm == 1 {
        // inside a // comment: copy to end of line
        hold exch = concat(exch, chr(exc))
        hold exchl = exchl + 1
        hold exi = exi + 1
        when exc == 10 {
          hold excm = 0
          hold exst = 1
        }
      } otherwise {
        when exc == 34 {
          hold exq = 1
          hold exst = 0
          hold exch = concat(exch, chr(exc))
          hold exchl = exchl + 1
          hold exi = exi + 1
        } otherwise {
          when exst == 1 && exc >= 97 && exc <= 122 {
            // statement word: read it whole
            hold exw = ""
            hold exj = exi
            hold exrun = 1
            while exrun == 1 {
              when exj >= n {
                hold exrun = 0
              } otherwise {
                hold exc2 = sx_index(source, exj)
                when (exc2 >= 97 && exc2 <= 122) || (exc2 >= 65 && exc2 <= 90) || (exc2 >= 48 && exc2 <= 57) || exc2 == 95 {
                  hold exw = concat(exw, chr(exc2))
                  hold exj = exj + 1
                } otherwise {
                  hold exrun = 0
                }
              }
            }
            when sx_eq(exw, "use") {
              // blanks, then expect a quoted path
              hold exk = exj
              hold exrun = 1
              while exrun == 1 {
                when exk >= n {
                  hold exrun = 0
                } otherwise {
                  hold exc2 = sx_index(source, exk)
                  when exc2 == 32 || exc2 == 9 || exc2 == 13 {
                    hold exk = exk + 1
                  } otherwise {
                    hold exrun = 0
                  }
                }
              }
              hold exc2 = 0
              when exk < n {
                hold exc2 = sx_index(source, exk)
              }
              when exc2 == 34 {
                hold exk = exk + 1
                hold exup = ""
                hold exrun = 1
                while exrun == 1 {
                  when exk >= n {
                    hold exrun = 0
                  } otherwise {
                    hold exc2 = sx_index(source, exk)
                    when exc2 == 34 {
                      hold exrun = 0
                    } otherwise {
                      hold exup = concat(exup, chr(exc2))
                      hold exk = exk + 1
                    }
                  }
                }
                when exk < n {
                  hold exk = exk + 1
                }
                when exround <= 8 {
                  hold exsrc = read_file(exup)
                  hold exsl = len(exsrc)
                  when exsl == 0 {
                    hold exdl = len(exdir)
                    when exdl > 0 {
                      hold exsrc = read_file(concat(exdir, exup))
                      hold exsl = len(exsrc)
                    }
                  }
                  when exsl == 0 {
                    hold exmissing = 1
                    hold exmissp = exup
                  } otherwise {
                    // flush, then splice the whole file at once
                    when exchl > 0 {
                      hold exm = concat(exm, exch)
                      hold exch = ""
                      hold exchl = 0
                      hold exml = len(exm)
                    }
                    when exml > 0 {
                      hold exs = concat(exs, exm)
                      hold exm = ""
                      hold exml = 0
                    }
                    hold exs = concat(exs, exsrc)
                    hold exmore = 1
                    hold exst = 1
                  }
                  hold exi = exk
                } otherwise {
                  // deeper than 8: keep the text and report it below
                  hold exdeep = 1
                  hold exst = 0
                  hold exch = concat(exch, chr(exc))
                  hold exchl = exchl + 1
                  hold exi = exi + 1
                }
              } otherwise {
                // `use` not followed by a quoted path: report it rather
                // than letting `use foo.sa` turn into garbage identifiers
                hold exbad5 = 1
                hold exst = 0
                hold exch = concat(exch, chr(exc))
                hold exchl = exchl + 1
                hold exi = exi + 1
              }
            } otherwise {
              hold exst = 0
              hold exch = concat(exch, chr(exc))
              hold exchl = exchl + 1
              hold exi = exi + 1
            }
          } otherwise {
            when exc == 47 {
              hold exc2 = 0
              when exi + 1 < n {
                hold exc2 = sx_index(source, exi + 1)
              }
              when exc2 == 47 {
                hold excm = 1
              }
            }
            when exc == 123 || exc == 125 || exc == 10 {
              hold exst = 1
            } otherwise {
              when exc == 32 || exc == 9 || exc == 13 {
              } otherwise {
                hold exst = 0
              }
            }
            hold exch = concat(exch, chr(exc))
            hold exchl = exchl + 1
            hold exi = exi + 1
          }
        }
      }
    }
  }
  // flush the tail chunk (both levels)
  when exchl > 0 {
    hold exm = concat(exm, exch)
    hold exch = ""
    hold exchl = 0
    hold exml = len(exm)
  }
  when exml > 0 {
    hold exs = concat(exs, exm)
    hold exm = ""
    hold exml = 0
  }
  when exmore == 1 {
    hold source = exs
    hold n = len(source)
  }
}

when seed_profile == 1 { hold source = sxseed_normalize(source)
  hold n = len(source) }

// Expand after textual use splicing, so imported strings see the same rules.
hold interpprivate = "_sx_interp"
while sxecontains(source, interpprivate) == 1 {
  hold interpprivate = concat(interpprivate, "x")
}
hold interpstate = []
hold source = sxinterpolate(source, interpprivate, interpstate)
hold n = len(source)
hold interpactive = 0
hold interpbad = 0
hold interpi = 0
while interpi < len(interpstate) {
  hold interpevent = interpstate[interpi]
  when interpevent == 1 {
    hold interpactive = 1
  } otherwise {
    hold interpbad = 1
  }
  hold interpi = interpi + 1
}
when interpbad == 1 {
  hold exerr = concat(exerr, "#error sayanox-min: interpolation requires a closed identifier hole; maximum 16 holes per string\n")
}

// ---- malformed number literals (`1.2.3`) are rejected up front ----------
// Every number reader below accepts `.digits` once more each time it sees
hold nqp = 0
hold nqc = 0
hold nqn = 0
hold nqk = 0
hold nqf = 0
while nqp < n {
  hold nqc = sx_index(source,nqp)
  hold nqn = 0
  when nqp + 1 < n {
    hold nqn = sx_index(source,nqp + 1)
  }
  when nqc == 34 {
    // a string literal: skip to the closing quote, honouring backslashes
    hold nqp = nqp + 1
    hold nqk = 1
    while nqk == 1 {
      when nqp >= n {
        hold nqk = 0
      } otherwise {
        hold nqc = sx_index(source,nqp)
        when nqc == 92 {
          hold nqp = nqp + 2
        } otherwise {
          hold nqp = nqp + 1
          when nqc == 34 {
            hold nqk = 0
          }
        }
      }
    }
  } otherwise {
    when nqc == 47 && nqn == 47 {
      // a line comment: skip to the end of the line
      hold nqk = 1
      while nqk == 1 {
        when nqp >= n {
          hold nqk = 0
        } otherwise {
          hold nqc = sx_index(source,nqp)
          when nqc == 10 {
            hold nqk = 0
          } otherwise {
            hold nqp = nqp + 1
          }
        }
      }
    } otherwise {
      when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || nqc == 95 {
        // an identifier, digits included
        hold nqk = 1
        while nqk == 1 {
          when nqp >= n {
            hold nqk = 0
          } otherwise {
            hold nqc = sx_index(source,nqp)
            when (nqc >= 97 && nqc <= 122) || (nqc >= 65 && nqc <= 90) || (nqc >= 48 && nqc <= 57) || nqc == 95 {
              hold nqp = nqp + 1
            } otherwise {
              hold nqk = 0
            }
          }
        }
      } otherwise {
        when nqc >= 48 && nqc <= 57 {
          // a number: digits, then at most one `.digits`
          hold nqf = 0
          hold nqk = 1
          while nqk == 1 {
            when nqp >= n {
              hold nqk = 0
            } otherwise {
              hold nqc = sx_index(source,nqp)
              hold nqn = 0
              when nqp + 1 < n {
                hold nqn = sx_index(source,nqp + 1)
              }
              when nqc >= 48 && nqc <= 57 {
                hold nqp = nqp + 1
              } otherwise {
                when nqc == 46 && nqn >= 48 && nqn <= 57 {
                  when nqf == 1 {
                    when perr == 0 {
                      hold permsg = "malformed number literal (a number has at most one '.', as in 2.5)"
                    }
                    hold perr = 1
                  }
                  hold nqf = 1
                  hold nqp = nqp + 1
                } otherwise {
                  hold nqk = 0
                }
              }
            }
          }
        } otherwise {
          hold nqp = nqp + 1
        }
      }
    }
  }
}
// =====================================================================
// function signature table (full language)
hold fnstructkind = ""
hold ppsignature = ""
hold ppstructkind = ""
hold ppstructname = ""
hold structresultkind = ""
hold sfreturn = ""
hold sfenv = ""
hold sfkind = ""
hold sfexpected = ""
hold sfvalue = ""
hold ppordinal = 0
hold fsstructnames = sxfstructnames(source)
hold fsstructactive = 0
hold fsret = "|"
hold fsptx = "|"
hold fspk = "|"
when interpactive == 1 {
  hold fsret = concat(fsret, interpprivate)
  hold fsret = concat(fsret, "=s|")
  hold fspk = concat(fspk, interpprivate)
  hold fspk = concat(fspk, "=v|")
}
hold seed_function_total = 0
hold seed_params = ""
hold fsi = 0
hold fsstart = 1
hold fsstr = 0
hold fscm = 0
hold fsw = ""
hold fsj = 0
hold fsnx = 0
hold fsp = 0
hold fsname = ""
hold fsrun = 0
hold fsc3 = 0
hold fstx = ""
hold fspks = ""
hold fspfirst = 0
hold fsprun = 0
hold fspn = ""
hold fspk2 = 0
hold fsstructparam = ""
hold fsstructreturn = ""
hold fstype = ""
hold fsret2 = 0
hold fsc4 = 0
hold fshave = 0
hold fsrk = ""
hold fsrkl = 0
hold fsrl = 0
hold fsri = 0
hold fsok = 0
hold fsrj = 0
hold fsra = 0
hold fsrb = 0
hold fsc2 = 0
hold fsc = 0
hold fsnc = 0
while fsi < n {
  hold fsc = sx_index(source, fsi)
  when fsstr == 1 {
    // inside a string literal
    when fsc == 92 {
      hold fsi = fsi + 2
    } otherwise {
      when fsc == 34 {
        hold fsstr = 0
      }
      hold fsi = fsi + 1
    }
  } otherwise {
    when fscm == 1 {
      // inside a // comment
      when fsc == 10 {
        hold fscm = 0
        hold fsstart = 1
      }
      hold fsi = fsi + 1
    } otherwise {
      // a // comment: a quote inside one is not a string delimiter, so the
      // scanner has to know about comments the way the real lexer does
      hold fsnc = 0
      when fsi + 1 < n {
        hold fsnc = sx_index(source, fsi + 1)
      }
      when fsc == 47 && fsnc == 47 {
        hold fscm = 1
        hold fsstart = 0
        hold fsi = fsi + 2
      } otherwise {
        when fsc == 34 {
        hold fsstr = 1
        hold fsstart = 0
        hold fsi = fsi + 1
      } otherwise {
        when fsstart == 1 && fsc == 109 && fsi + 4 <= n {
          hold fsw = ""
          hold fsj = 0
          while fsj < 4 {
            hold fsw = concat(fsw, chr(sx_index(source, fsi + fsj)))
            hold fsj = fsj + 1
          }
          hold fsnx = 0
          when fsi + 4 < n {
            hold fsnx = sx_index(source, fsi + 4)
          }
          when sx_eq(fsw, "make") && (fsnx == 32 || fsnx == 9 || fsnx == 40) {
            // ---- parse `make NAME ( params ) -> TYPE` ----
            // typed signature check: every parameter and the return, or none
            hold fsxnp = 0
            hold fsxnt = 0
            hold fsxrt = 0
            hold fsp = fsi + 4
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsname = ""
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                  hold fsname = concat(fsname, chr(fsc3))
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsrun = 1
            while fsrun == 1 {
              when fsp >= n {
                hold fsrun = 0
              } otherwise {
                hold fsc3 = sx_index(source, fsp)
                when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 {
                  hold fsp = fsp + 1
                } otherwise {
                  hold fsrun = 0
                }
              }
            }
            hold fsc3 = 0
            when fsp < n {
              hold fsc3 = sx_index(source, fsp)
            }
            when seed_profile == 1 && (fsc3 == 40 || fsc3 == 60) && len(fsname) > 0 {
              seed_function_total = seed_function_total + 1
              when seed_function_total > 512 {
                perr = 1
                permsg = "function/specialization limit is 512"
              }
            }
            when fsc3 == 40 && sx_eq(fsname, "") == 0 {
              hold fsp = fsp + 1
              hold fstx = ""
              hold fspks = ""
              hold fspfirst = 1
              seed_params = ""
              hold fsprun = 1
              while fsprun == 1 {
                hold fsc3 = 0
                when fsp < n {
                  hold fsc3 = sx_index(source, fsp)
                }
                when fsp >= n {
                  hold fsprun = 0
                } otherwise {
                  when fsc3 == 41 {
                    hold fsp = fsp + 1
                    hold fsprun = 0
                  } otherwise {
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 || fsc3 == 10 || fsc3 == 44 {
                      hold fsp = fsp + 1
                    } otherwise {
                      when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || fsc3 == 95 {
                        hold fspn = ""
                        hold fsxnp = fsxnp + 1
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                              hold fspn = concat(fspn, chr(fsc3))
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fsrun = 1
                        while fsrun == 1 {
                          when fsp >= n {
                            hold fsrun = 0
                          } otherwise {
                            hold fsc3 = sx_index(source, fsp)
                            when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                              hold fsp = fsp + 1
                            } otherwise {
                              hold fsrun = 0
                            }
                          }
                        }
                        hold fsstructparam = ""
                        hold fspk2 = 110
                        hold fsc3 = 0
                        when fsp < n {
                          hold fsc3 = sx_index(source, fsp)
                        }
                        when fsc3 == 58 {
                          hold fsxnt = fsxnt + 1
                          hold fsp = fsp + 1
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          hold fsstructparam = ""
                          hold fstype = ""
                          hold fsrun = 1
                          while fsrun == 1 {
                            when fsp >= n {
                              hold fsrun = 0
                            } otherwise {
                              hold fsc3 = sx_index(source, fsp)
                              when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                                hold fstype = concat(fstype, chr(fsc3))
                                hold fsp = fsp + 1
                              } otherwise {
                                hold fsrun = 0
                              }
                            }
                          }
                          when sxecontains(fsstructnames, concat(concat("|", fstype), "|")) == 1 {
                            hold fsstructparam = fstype
                            hold fsstructactive = 1
                          }
                          when len(fsstructparam) == 0 && string_eq(fstype, "str") == 0 && string_eq(fstype, "string") == 0 && string_eq(fstype, "list") == 0 && string_eq(fstype, "num") == 0 && string_eq(fstype, "number") == 0 && string_eq(fstype, "bool") == 0 && string_eq(fstype, "double") == 0 {
                            hold exerr = concat(exerr, "#error sayanox-min: unknown function parameter type\n")
                          }
                          when sx_eq(fstype, "str") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "string") {
                            hold fspk2 = 115
                          }
                          when sx_eq(fstype, "list") {
                            hold fspk2 = 108
                          }
                          when sx_eq(fstype, "num") || sx_eq(fstype, "number") || sx_eq(fstype, "bool") || sx_eq(fstype, "double") {
                            hold fspk2 = 110
                          }
                        }
                        when fspfirst == 0 {
                          hold fstx = concat(fstx, ", ")
                        }
                        when fspk2 == 115 {
                          hold fstx = concat(fstx, "char *")
                        } otherwise {
                          when fspk2 == 108 {
                            hold fstx = concat(fstx, "sx_list *")
                          } otherwise {
                            when len(fsstructparam) > 0 {
                              hold fstx = concat(fstx, fsstructparam)
                              hold fstx = concat(fstx, " ")
                            } otherwise {
                              hold fstx = concat(fstx, "double ")
                            }
                          }
                        }
                        when seed_profile == 1 && sxseed_csv_has(seed_params, fspn) == 1 {
                          perr = 1
                          permsg = "duplicate function parameter"
                        }
                        seed_params = concat(seed_params, concat(fspn, ","))
                        hold fstx = concat(fstx, fspn)
                        when len(fsstructparam) > 0 {
                          hold fspks = concat(fspks, "u")
                          hold fspks = concat(fspks, fsstructparam)
                          hold fspks = concat(fspks, ";")
                        } otherwise {
                          hold fspks = concat(fspks, chr(fspk2))
                        }
                        hold fspfirst = 0
                      } otherwise {
                        hold fsp = fsp + 1
                      }
                    }
                  }
                }
              }
              // optional `-> TYPE`
              hold fsrun = 1
              while fsrun == 1 {
                when fsp >= n {
                  hold fsrun = 0
                } otherwise {
                  hold fsc3 = sx_index(source, fsp)
                  when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                    hold fsp = fsp + 1
                  } otherwise {
                    hold fsrun = 0
                  }
                }
              }
              hold fsstructreturn = ""
              hold fsret2 = 110
              hold fsc3 = 0
              hold fsc4 = 0
              when fsp < n {
                hold fsc3 = sx_index(source, fsp)
              }
              when fsp + 1 < n {
                hold fsc4 = sx_index(source, fsp + 1)
              }
              when fsc3 == 45 && fsc4 == 62 {
                hold fsp = fsp + 2
                hold fsxrt = 1
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when fsc3 == 32 || fsc3 == 9 || fsc3 == 13 {
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                hold fstype = ""
                hold fsrun = 1
                while fsrun == 1 {
                  when fsp >= n {
                    hold fsrun = 0
                  } otherwise {
                    hold fsc3 = sx_index(source, fsp)
                    when (fsc3 >= 97 && fsc3 <= 122) || (fsc3 >= 65 && fsc3 <= 90) || (fsc3 >= 48 && fsc3 <= 57) || fsc3 == 95 {
                      hold fstype = concat(fstype, chr(fsc3))
                      hold fsp = fsp + 1
                    } otherwise {
                      hold fsrun = 0
                    }
                  }
                }
                when sxecontains(fsstructnames, concat(concat("|", fstype), "|")) == 1 {
                  hold fsstructreturn = fstype
                  hold fsstructactive = 1
                }
                when len(fsstructreturn) == 0 && string_eq(fstype, "str") == 0 && string_eq(fstype, "string") == 0 && string_eq(fstype, "list") == 0 && string_eq(fstype, "num") == 0 && string_eq(fstype, "number") == 0 && string_eq(fstype, "bool") == 0 && string_eq(fstype, "double") == 0 {
                  hold exerr = concat(exerr, "#error sayanox-min: unknown function return type\n")
                }
                when sx_eq(fstype, "str") || sx_eq(fstype, "string") {
                  hold fsret2 = 115
                }
                when sx_eq(fstype, "list") {
                  hold fsret2 = 108
                }
              }
              when fsxnt > 0 || fsxrt == 1 {
                when fsxnt != fsxnp {
                  hold exerr = concat(exerr, "#error sayanox-min: a typed make needs a type on every parameter (a: num)")
                  hold exerr = concat(exerr, nl)
                  show "min: a typed make needs a type on every parameter (a: num)"
                }
                when fsxrt == 0 {
                  hold exerr = concat(exerr, "#error sayanox-min: a typed make needs a return type (-> num)")
                  hold exerr = concat(exerr, nl)
                  show "min: a typed make needs a return type (-> num)"
                }
              }
              // record it once (a later redefinition keeps the first)
              hold fsrk = concat("|", fsname)
              hold fsrk = concat(fsrk, "=")
              hold fsrkl = len(fsrk)
              hold fsrl = len(fsret)
              hold fsri = 0
              hold fshave = 0
              while fsri + fsrkl <= fsrl {
                hold fsok = 1
                hold fsrj = 0
                while fsrj < fsrkl {
                  hold fsra = sx_index(fsret, fsri + fsrj)
                  hold fsrb = sx_index(fsrk, fsrj)
                  when fsra == fsrb {
                    hold fsrj = fsrj + 1
                  } otherwise {
                    hold fsok = 0
                    hold fsrj = fsrkl
                  }
                }
                when fsok == 1 {
                  hold fshave = 1
                  hold fsri = fsrl
                } otherwise {
                  hold fsri = fsri + 1
                }
              }
              when seed_profile == 1 && fshave == 1 {
                perr = 1
                when seed_profile == 1 {
                  permsg = concat("duplicate function name: ", fsname)
                } otherwise {
                permsg = concat("duplicate function definition: ", fsname)
                }
              }
              when fshave == 0 {
                hold fsret = concat(fsret, fsname)
                hold fsret = concat(fsret, "=")
                when len(fsstructreturn) > 0 {
                  hold fsret = concat(fsret, "u")
                  hold fsret = concat(fsret, fsstructreturn)
                } otherwise {
                  hold fsret = concat(fsret, chr(fsret2))
                }
                hold fsret = concat(fsret, "|")
                hold fsptx = concat(fsptx, fsname)
                hold fsptx = concat(fsptx, "=")
                hold fsptx = concat(fsptx, fstx)
                hold fsptx = concat(fsptx, "|")
                hold fspk = concat(fspk, fsname)
                hold fspk = concat(fspk, "=")
                hold fspk = concat(fspk, fspks)
                hold fspk = concat(fspk, "|")
              }
              hold fsi = fsp
              hold fsstart = 0
            } otherwise {
              hold fsstart = 0
              hold fsi = fsi + 1
            }
          } otherwise {
            when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
              hold fsstart = 1
            } otherwise {
              when fsc == 32 || fsc == 9 || fsc == 13 {
              } otherwise {
                hold fsstart = 0
              }
            }
            hold fsi = fsi + 1
          }
        } otherwise {
          when fsc == 10 || fsc == 123 || fsc == 125 || fsc == 59 {
            hold fsstart = 1
          } otherwise {
            when fsc == 32 || fsc == 9 || fsc == 13 {
            } otherwise {
              hold fsstart = 0
            }
          }
          hold fsi = fsi + 1
        }
      }
      }
    }
  }
}
// =====================================================================
// generic function table (full language)
hold fgtab = chr(1)
hold fgnames = chr(1)
hold fgcur = ""
// Scratch names shared by the generic pre-pass, the phase-0 splat and the
// phase-1.5 monomorphiser.  They are declared here, at the top of the
hold fgseen = 0
hold fgts = 0
hold fgtl = 0
hold fgtc = 0
hold fgreti = 0
hold giat = 0
hold gkc = 0
hold gpw = ""
hold zwAt = 0
hold fbgen = 0
hold fgty = ""
hold fgname = ""
hold fgpn = ""
hold fgbody = ""
hold fgallt = 0
hold fgntot = 0
hold fgretT = 0
hold fgi = 0
hold fgstart = 1
hold fgstr = 0
hold fgcm = 0
hold fgw = ""
hold fgj = 0
hold fgnx = 0
hold fgp = 0
hold fgrun = 0
hold fgc = 0
hold fgnm = ""
hold fgpn1 = ""
hold fgtype = ""
hold fgfirst = 0
hold fgprun = 0
hold fgdep = 0
hold fgbd = 0
hold fgq = 0
while fgi < n {
  hold fgc = sx_index(source, fgi)
  when fgstr == 1 {
    when fgc == 92 {
      hold fgi = fgi + 2
    } otherwise {
      when fgc == 34 {
        hold fgstr = 0
      }
      hold fgi = fgi + 1
    }
  } otherwise {
    when fgcm == 1 {
      when fgc == 10 {
        hold fgcm = 0
        hold fgstart = 1
      }
      hold fgi = fgi + 1
    } otherwise {
      when fgc == 34 {
        hold fgstr = 1
        hold fgstart = 0
        hold fgi = fgi + 1
      } otherwise {
        when fgstart == 1 && fgc == 109 && fgi + 4 <= n {
          hold fgw = ""
          hold fgj = 0
          while fgj < 4 {
            hold fgw = concat(fgw, chr(sx_index(source, fgi + fgj)))
            hold fgj = fgj + 1
          }
          hold fgnx = 0
          when fgi + 4 < n {
            hold fgnx = sx_index(source, fgi + 4)
          }
          hold fgok = 0
          when sx_eq(fgw, "make") && (fgnx == 32 || fgnx == 9) {
            hold fgok = 1
          }
          when fgok == 1 {
            hold fgp = fgi + 4
            hold fgrun = 1
            while fgrun == 1 {
              when fgp >= n {
                hold fgrun = 0
              } otherwise {
                hold fgc = sx_index(source, fgp)
                when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                  hold fgp = fgp + 1
                } otherwise {
                  hold fgrun = 0
                }
              }
            }
            hold fgnm = ""
            hold fgrun = 1
            while fgrun == 1 {
              when fgp >= n {
                hold fgrun = 0
              } otherwise {
                hold fgc = sx_index(source, fgp)
                when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || (fgc >= 48 && fgc <= 57) || fgc == 95 {
                  hold fgnm = concat(fgnm, chr(fgc))
                  hold fgp = fgp + 1
                } otherwise {
                  hold fgrun = 0
                }
              }
            }
            hold fgc = 0
            when fgp < n {
              hold fgc = sx_index(source, fgp)
            }
            hold fgbgen = 0
            hold fgty2 = ""
            // One type parameter used to be the whole story (`make NAME<T>`);
            // now the list is comma separated, so `make pair<A, B>(a: A, b: B)`
            hold fgtys = ""
            hold fgnty = 0
            when fgc == 60 {
              hold fgp = fgp + 1
              hold fgtrun = 1
              while fgtrun == 1 {
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgthis = ""
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when (fgc >= 65 && fgc <= 90) || (fgc >= 97 && fgc <= 122) || fgc == 95 {
                      hold fgthis = concat(fgthis, chr(fgc))
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                when sx_eq(fgthis, "") == 0 {
                  when seed_profile == 1 && sxseed_csv_has(fgtys, fgthis) == 1 {
                    perr = 1
                    permsg = "duplicate generic type parameter"
                  }
                  when fgnty > 0 {
                    hold fgtys = concat(fgtys, ",")
                  }
                  hold fgtys = concat(fgtys, fgthis)
                  hold fgnty = fgnty + 1
                  when seed_profile == 1 && fgnty > 8 {
                    perr = 1
                    permsg = "seed-min generic type parameter limit is 8"
                  }
                }
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgc = 0
                when fgp < n {
                  hold fgc = sx_index(source, fgp)
                }
                when fgc == 44 {
                  hold fgp = fgp + 1
                } otherwise {
                  when fgc == 62 {
                    hold fgp = fgp + 1
                  }
                  hold fgtrun = 0
                }
              }
              when fgnty > 0 {
                hold fgty2 = fgtys
                hold fgbgen = 1
              }
            }
            when fgbgen == 1 && sx_eq(fgnm, "") == 0 {
              // params: NAME : TYPE, comma separated
              hold fgrun = 1
              while fgrun == 1 {
                when fgp >= n {
                  hold fgrun = 0
                } otherwise {
                  hold fgc = sx_index(source, fgp)
                  when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                    hold fgp = fgp + 1
                  } otherwise {
                    hold fgrun = 0
                  }
                }
              }
              hold fgc = 0
              when fgp < n {
                hold fgc = sx_index(source, fgp)
              }
              when fgc == 40 {
                hold fgp = fgp + 1
                hold fgpn1 = ""
                hold fgpidx = ""
                hold fgntot = 0
                hold fgallt = 1
                hold fgfirst = 1
                hold fgprun = 1
                while fgprun == 1 {
                  hold fgc = 0
                  when fgp < n {
                    hold fgc = sx_index(source, fgp)
                  }
                  when fgp >= n {
                    hold fgprun = 0
                  } otherwise {
                    when fgc == 41 {
                      hold fgp = fgp + 1
                      hold fgprun = 0
                    } otherwise {
                      when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 || fgc == 44 {
                        hold fgp = fgp + 1
                      } otherwise {
                        when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || fgc == 95 {
                          hold fgpn = ""
                          hold fgrun = 1
                          while fgrun == 1 {
                            when fgp >= n {
                              hold fgrun = 0
                            } otherwise {
                              hold fgc = sx_index(source, fgp)
                              when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) || (fgc >= 48 && fgc <= 57) || fgc == 95 {
                                hold fgpn = concat(fgpn, chr(fgc))
                                hold fgp = fgp + 1
                              } otherwise {
                                hold fgrun = 0
                              }
                            }
                          }
                          hold fgrun = 1
                          while fgrun == 1 {
                            when fgp >= n {
                              hold fgrun = 0
                            } otherwise {
                              hold fgc = sx_index(source, fgp)
                              when fgc == 32 || fgc == 9 {
                                hold fgp = fgp + 1
                              } otherwise {
                                hold fgrun = 0
                              }
                            }
                          }
                          hold fgtype = ""
                          hold fgc = 0
                          when fgp < n {
                            hold fgc = sx_index(source, fgp)
                          }
                          when fgc == 58 {
                            hold fgp = fgp + 1
                            hold fgrun = 1
                            while fgrun == 1 {
                              when fgp >= n {
                                hold fgrun = 0
                              } otherwise {
                                hold fgc = sx_index(source, fgp)
                                when fgc == 32 || fgc == 9 {
                                  hold fgp = fgp + 1
                                } otherwise {
                                  hold fgrun = 0
                                }
                              }
                            }
                            hold fgrun = 1
                            while fgrun == 1 {
                              when fgp >= n {
                                hold fgrun = 0
                              } otherwise {
                                hold fgc = sx_index(source, fgp)
                                when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) {
                                  hold fgtype = concat(fgtype, chr(fgc))
                                  hold fgp = fgp + 1
                                } otherwise {
                                  hold fgrun = 0
                                }
                              }
                            }
                          }
                          when fgfirst == 0 {
                            hold fgpn1 = concat(fgpn1, ",")
                          }
                          hold fgpn1 = concat(fgpn1, fgpn)
                          hold fgfirst = 0
                          hold fgntot = fgntot + 1
                          // every parameter must name one of the type
                          // parameters; remember which one, as an index
                          hold fgidx = 0 - 1
                          hold fgseen = 0
                          hold fgcur = ""
                          hold fgts = 0
                          hold fgtl = len(fgtys)
                          while fgts <= fgtl {
                            hold fgtc = 0
                            when fgts < fgtl {
                              hold fgtc = sx_index(fgtys, fgts)
                            }
                            when fgtc == 44 || fgts == fgtl {
                              when sx_eq(fgcur, fgtype) {
                                hold fgidx = fgseen
                              }
                              hold fgcur = ""
                              hold fgseen = fgseen + 1
                            } otherwise {
                              hold fgcur = concat(fgcur, chr(fgtc))
                            }
                            hold fgts = fgts + 1
                          }
                          when fgidx < 0 {
                            hold fgallt = 0
                          } otherwise {
                            hold fgpidx = concat(fgpidx, chr(48 + fgidx))
                          }
                        } otherwise {
                          hold fgp = fgp + 1
                        }
                      }
                    }
                  }
                }
                // optional `-> TYPE`
                hold fgretT = 0
                hold fgrun = 1
                while fgrun == 1 {
                  when fgp >= n {
                    hold fgrun = 0
                  } otherwise {
                    hold fgc = sx_index(source, fgp)
                    when fgc == 32 || fgc == 9 || fgc == 13 {
                      hold fgp = fgp + 1
                    } otherwise {
                      hold fgrun = 0
                    }
                  }
                }
                hold fgc = 0
                hold fgc2 = 0
                when fgp < n {
                  hold fgc = sx_index(source, fgp)
                }
                when fgp + 1 < n {
                  hold fgc2 = sx_index(source, fgp + 1)
                }
                when fgc == 45 && fgc2 == 62 {
                  hold fgp = fgp + 2
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgc == 32 || fgc == 9 {
                        hold fgp = fgp + 1
                      } otherwise {
                        hold fgrun = 0
                      }
                    }
                  }
                  hold fgtype = ""
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when (fgc >= 97 && fgc <= 122) || (fgc >= 65 && fgc <= 90) {
                        hold fgtype = concat(fgtype, chr(fgc))
                        hold fgp = fgp + 1
                      } otherwise {
                        hold fgrun = 0
                      }
                    }
                  }
                  // the return type must name one of the type parameters too
                  hold fgreti = 0 - 1
                  hold fgseen = 0
                  hold fgcur = ""
                  hold fgts = 0
                  hold fgtl = len(fgtys)
                  while fgts <= fgtl {
                    hold fgtc = 0
                    when fgts < fgtl {
                      hold fgtc = sx_index(fgtys, fgts)
                    }
                    when fgtc == 44 || fgts == fgtl {
                      when sx_eq(fgcur, fgtype) {
                        hold fgreti = fgseen
                      }
                      hold fgcur = ""
                      hold fgseen = fgseen + 1
                    } otherwise {
                      hold fgcur = concat(fgcur, chr(fgtc))
                    }
                    hold fgts = fgts + 1
                  }
                  when fgreti >= 0 {
                    hold fgretT = 1
                  }
                }
                when seed_profile == 1 && fgallt == 1 {
                  hold seed_ti = 0
                  while seed_ti < fgnty {
                    hold seed_used = 0
                    hold seed_pi = 0
                    while seed_pi < len(fgpidx) {
                      when sx_index(fgpidx, seed_pi) - 48 == seed_ti { seed_used = 1 }
                      seed_pi = seed_pi + 1
                    }
                    when seed_used == 0 {
                      perr = 1
                      permsg = "generic type parameter cannot be inferred from arguments"
                    }
                    seed_ti = seed_ti + 1
                  }
                }
                // a generic: every parameter and the return are T
                when fgallt == 1 && fgntot > 0 && fgretT == 1 {
                  // capture the body text up to the matching `}`
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgc == 32 || fgc == 9 || fgc == 13 || fgc == 10 {
                        hold fgp = fgp + 1
                      } otherwise {
                        when fgc == 123 {
                          hold fgp = fgp + 1
                        }
                        hold fgrun = 0
                      }
                    }
                  }
                  hold fgbd = 1
                  hold fgq = 0
                  hold fgb2 = 0
                  hold fgbody = ""
                  hold fgrun = 1
                  while fgrun == 1 {
                    when fgp >= n {
                      hold fgrun = 0
                    } otherwise {
                      hold fgc = sx_index(source, fgp)
                      when fgq == 1 {
                        hold fgbody = concat(fgbody, chr(fgc))
                        hold fgp = fgp + 1
                        when fgc == 92 {
                          when fgp < n {
                            hold fgbody = concat(fgbody, chr(sx_index(source, fgp)))
                            hold fgp = fgp + 1
                          }
                        } otherwise {
                          when fgc == 34 {
                            hold fgq = 0
                          }
                        }
                      } otherwise {
                        when fgc == 34 {
                          hold fgq = 1
                          hold fgbody = concat(fgbody, chr(fgc))
                          hold fgp = fgp + 1
                        } otherwise {
                          when fgc == 123 {
                            hold fgbd = fgbd + 1
                          }
                          when fgc == 125 {
                            hold fgbd = fgbd - 1
                          }
                          when fgbd == 0 && fgc == 125 {
                            hold fgrun = 0
                          } otherwise {
                            hold fgbody = concat(fgbody, chr(fgc))
                          }
                          hold fgp = fgp + 1
                        }
                      }
                    }
                  }
                  //   fgnames  <1>NAME<1>NTYPES<1>TIDX<1>RETIDX<1>
                  //   fgtab    <1>NAME<1>TYPES<1>PARAMS<1>TIDX<1>RETIDX<1>BODY<1>
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, fgnm)
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, chr(48 + fgnty))
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, fgpidx)
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgnames = concat(fgnames, chr(48 + fgreti))
                  hold fgnames = concat(fgnames, chr(1))
                  hold fgtab = concat(fgtab, fgnm)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgty2)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgpn1)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgpidx)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, chr(48 + fgreti))
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgtab = concat(fgtab, fgbody)
                  hold fgtab = concat(fgtab, chr(1))
                  hold fgi = fgp
                } otherwise {
                  hold fgi = fgi + 1
                }
                hold fgstart = 0
              } otherwise {
                hold fgstart = 0
                hold fgi = fgi + 1
              }
            } otherwise {
              when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
                hold fgstart = 1
              } otherwise {
                when fgc == 32 || fgc == 9 || fgc == 13 {
                } otherwise {
                  hold fgstart = 0
                }
              }
              hold fgi = fgi + 1
            }
          } otherwise {
            when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
              hold fgstart = 1
            } otherwise {
              when fgc == 32 || fgc == 9 || fgc == 13 {
              } otherwise {
                hold fgstart = 0
              }
            }
            hold fgi = fgi + 1
          }
        } otherwise {
          when fgc == 10 || fgc == 123 || fgc == 125 || fgc == 59 {
            hold fgstart = 1
          } otherwise {
            when fgc == 32 || fgc == 9 || fgc == 13 {
            } otherwise {
              hold fgstart = 0
            }
          }
          hold fgi = fgi + 1
        }
      }
    }
  }
}

hold source_words = sxsource_pack(source)

while running == 1 {

  // ---- phase 0: splice pending generic specialisations ----
  // Requests come from the statement pass (phase 1.5) and from the
  // specialisation bodies generated below (a generic calling another one).
  when len(gmore) > 0 {
    hold gwant = concat(gwant, gmore)
    hold gmore = ""
  }
  // A `make NAME<T>` call asks for a monomorphised copy; the text is
  // inserted right here, at a statement boundary, so the ordinary
  when len(gwant) > 0 && in_fn == 0 {
    hold gwtxt = ""
    hold gwi = 1
    hold gwlen = len(gwant)
    while gwi < gwlen {
      // Requests from nested bodies may have both a trailing and a leading
      // delimiter. Empty separators are not function names or kind strings.
      hold gwskip = 1
      while gwi < gwlen && gwskip == 1 {
        when sx_index(gwant, gwi) == 1 {
          hold gwi = gwi + 1
        } otherwise {
          hold gwskip = 0
        }
      }
      hold gwnm = ""
      hold gwrun = 1
      while gwrun == 1 {
        when gwi >= gwlen {
          hold gwrun = 0
        } otherwise {
          hold gwc = sx_index(gwant, gwi)
          when gwc == 1 {
            hold gwi = gwi + 1
            hold gwrun = 0
          } otherwise {
            hold gwnm = concat(gwnm, chr(gwc))
            hold gwi = gwi + 1
          }
        }
      }
      // the request carries one kind character per type parameter
      hold gwks = ""
      hold gwrun = 1
      while gwrun == 1 {
        when gwi >= gwlen {
          hold gwrun = 0
        } otherwise {
          hold gwc = sx_index(gwant, gwi)
          when gwc == 1 {
            hold gwi = gwi + 1
            hold gwrun = 0
          } otherwise {
            hold gwks = concat(gwks, chr(gwc))
            hold gwi = gwi + 1
          }
        }
      }
      // look the generic up:
      //   fgtab <1>name<1>TYPES<1>params<1>TIDX<1>RETIDX<1>body<1>
      hold gkey = concat(chr(1), gwnm)
      hold gkey = concat(gkey, chr(1))
      hold gkl = len(gkey)
      hold gtl = len(fgtab)
      hold gti = 0
      hold gtf = 0
      hold gtstop = 0
      when len(gwnm) == 0 {
        hold gtstop = 1
      }
      while gti + gkl <= gtl && gtstop == 0 {
        hold gtok = 1
        hold gtj = 0
        while gtj < gkl {
          hold gta = sx_index(fgtab, gti + gtj)
          hold gtb = sx_index(gkey, gtj)
          when gta == gtb {
            hold gtj = gtj + 1
          } otherwise {
            hold gtok = 0
            hold gtj = gkl
          }
        }
        when gtok == 1 {
          hold gtf = 1
          hold gtstop = 1
          hold gti = gti + gkl
        } otherwise {
          // fgtab has six fields per record. Only its first field is a
          // function name; a parameter/body token must never match a lookup.
          hold gtfields = 0
          hold gti = gti + 1
          while gti < gtl && gtfields < 6 {
            when sx_index(fgtab, gti) == 1 {
              hold gtfields = gtfields + 1
            }
            hold gti = gti + 1
          }
          when gtfields == 6 {
            hold gti = gti - 1
          }
        }
      }
      when gtf == 1 {
        // read T, params, body
        hold gtyp = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gtyp = concat(gtyp, chr(gtc))
            }
          }
        }
        hold gprm = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gprm = concat(gprm, chr(gtc))
            }
          }
        }
        hold gpid = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gpid = concat(gpid, chr(gtc))
            }
          }
        }
        hold gret = 0
        when gti < gtl {
          hold gret = sx_index(fgtab, gti) - 48
          hold gti = gti + 2
        }
        hold gbdy = ""
        hold grun = 1
        while grun == 1 {
          when gti >= gtl {
            hold grun = 0
          } otherwise {
            hold gtc = sx_index(fgtab, gti)
            hold gti = gti + 1
            when gtc == 1 {
              hold grun = 0
            } otherwise {
              hold gbdy = concat(gbdy, chr(gtc))
            }
          }
        }
        // `gkindof(j)` is spelt out inline: the kind character the j'th type
        // parameter got from this call, defaulting to the first one when the
        hold gklen = len(gwks)
        hold gk0 = 110
        when gklen > 0 {
          hold gk0 = sx_index(gwks, 0)
        }
        hold gretk = gk0
        when gret >= 0 && gret < gklen {
          hold gretk = sx_index(gwks, gret)
        }
        // concrete type word for the RETURN of this specialisation
        hold gtw = "num"
        hold gtC = "double "
        when gretk == 115 {
          hold gtw = "str"
          hold gtC = "char * "
        }
        when gretk == 108 {
          hold gtw = "list"
          hold gtC = "sx_list * "
        }
        hold gspec = concat(gwnm, "__")
        hold gspec = concat(gspec, gwks)
        // emit every specialisation exactly once: `gdefs` is the registry of
        // definitions that have already been generated
        hold gdone = 0
        hold grb = concat(chr(1), gspec)
        hold grb = concat(grb, chr(1))
        hold grbl = len(grb)
        hold grl = len(gdefs)
        hold gri = 0
        while gri + grbl <= grl {
          hold grok = 1
          hold grj = 0
          while grj < grbl {
            hold gra = sx_index(gdefs, gri + grj)
            hold grc = sx_index(grb, grj)
            when gra == grc {
              hold grj = grj + 1
            } otherwise {
              hold grok = 0
              hold grj = grbl
            }
          }
          when grok == 1 {
            hold gdone = 1
            hold gri = grl
          } otherwise {
            hold gri = gri + 1
          }
        }
        when gdone == 0 {
        when seed_profile == 1 {
          seed_function_total = seed_function_total + 1
          when seed_function_total > 512 {
            perr = 1
            permsg = "function/specialization limit is 512"
          }
        }
        hold gpkinds = ""
        hold gpc = ""       // C param list for the prototype
        hold gpc2 = ""      // Sayanox param list for the definition
        hold gp1 = 1
        hold gpi = 0
        hold gpni = 0
        hold gprm = concat(gprm, ",")
        hold gpl = len(gprm)
        while gpi < gpl {
          hold gpn2 = ""
          hold grun = 1
          while grun == 1 {
            when gpi >= gpl {
              hold grun = 0
            } otherwise {
              hold gtc = sx_index(gprm, gpi)
              when gtc == 44 {
                hold gpi = gpi + 1
                hold grun = 0
              } otherwise {
                hold gpn2 = concat(gpn2, chr(gtc))
                hold gpi = gpi + 1
              }
            }
          }
          when sx_eq(gpn2, "") == 0 {
            // this parameter's own type: TIDX[gpni] says which type
            // parameter it uses, and that one got kind gwks[TIDX[gpni]]
            hold gkc = gk0
            when gpni < len(gpid) {
              hold gkj = sx_index(gpid, gpni) - 48
              when gkj >= 0 && gkj < gklen {
                hold gkc = sx_index(gwks, gkj)
              }
            }
            hold gpkinds = concat(gpkinds, chr(gkc))
            hold gpw = "num"
            hold gpC = "double "
            when gkc == 115 {
              hold gpw = "str"
              hold gpC = "char * "
            }
            when gkc == 108 {
              hold gpw = "list"
              hold gpC = "sx_list * "
            }
            when gp1 == 0 {
              hold gpc = concat(gpc, ", ")
              hold gpc2 = concat(gpc2, ", ")
            }
            hold gpc = concat(gpc, gpC)
            hold gpc = concat(gpc, gpn2)
            hold gpc2 = concat(gpc2, gpn2)
            hold gpc2 = concat(gpc2, ": ")
            hold gpc2 = concat(gpc2, gpw)
            hold gp1 = 0
            hold gpni = gpni + 1
          }
        }
        // body with whole-word `T` replaced by the concrete type word
        hold gnew = ""
        hold gbi = 0
        hold gbl = len(gbdy)
        while gbi < gbl {
          hold gbc = sx_index(gbdy, gbi)
          hold gopaque = 0
          when gbc == 34 {
            hold gopaque = 1
            hold gnew = concat(gnew, chr(gbc))
            hold gbi = gbi + 1
            hold gquoted = 1
            while gbi < gbl && gquoted == 1 {
              hold gqc = sx_index(gbdy, gbi)
              hold gnew = concat(gnew, chr(gqc))
              hold gbi = gbi + 1
              when gqc == 92 && gbi < gbl {
                hold gnew = concat(gnew, chr(sx_index(gbdy, gbi)))
                hold gbi = gbi + 1
              } otherwise { when gqc == 34 { hold gquoted = 0 } }
            }
          }
          when gbc == 47 && gbi + 1 < gbl && sx_index(gbdy, gbi + 1) == 47 {
            hold gopaque = 1
            while gbi < gbl && sx_index(gbdy, gbi) != 10 {
              hold gnew = concat(gnew, chr(sx_index(gbdy, gbi)))
              hold gbi = gbi + 1
            }
          }
          when gopaque == 0 {
          hold gwordstart = gbi
          when (gbc >= 97 && gbc <= 122) || (gbc >= 65 && gbc <= 90) || gbc == 95 {
            hold gwd = ""
            hold grun = 1
            while grun == 1 {
              when gbi >= gbl {
                hold grun = 0
              } otherwise {
                hold gbc = sx_index(gbdy, gbi)
                when (gbc >= 97 && gbc <= 122) || (gbc >= 65 && gbc <= 90) || (gbc >= 48 && gbc <= 57) || gbc == 95 {
                  hold gwd = concat(gwd, chr(gbc))
                  hold gbi = gbi + 1
                } otherwise {
                  hold grun = 0
                }
              }
            }
            // which type parameter (if any) does this word name?
            hold gwi2 = 0 - 1
            hold gseen = 0
            hold gcur2 = ""
            hold gts2 = 0
            hold gtl2 = len(gtyp)
            while gts2 <= gtl2 {
              hold gtc2 = 0
              when gts2 < gtl2 {
                hold gtc2 = sx_index(gtyp, gts2)
              }
              when gtc2 == 44 || gts2 == gtl2 {
                when sx_eq(gcur2, gwd) {
                  hold gwi2 = gseen
                }
                hold gcur2 = ""
                hold gseen = gseen + 1
              } otherwise {
                hold gcur2 = concat(gcur2, chr(gtc2))
              }
              hold gts2 = gts2 + 1
            }
            // Substitute type annotations, not ordinary identifiers such as
            // `hold T = 7` / `show T`. Quoted text/comments were copied above.
            when seed_profile == 1 && gwi2 >= 0 {
              hold gprev = gwordstart - 1
              while gprev >= 0 && (sx_index(gbdy, gprev) == 32 || sx_index(gbdy, gprev) == 9 || sx_index(gbdy, gprev) == 10 || sx_index(gbdy, gprev) == 13) { hold gprev = gprev - 1 }
              when gprev < 0 { hold gwi2 = -1 } otherwise {
                when sx_index(gbdy, gprev) != 58 && sx_index(gbdy, gprev) != 60 { hold gwi2 = -1 }
              }
            }
            when gwi2 >= 0 {
              hold gkc = gk0
              when gwi2 < gklen {
                hold gkc = sx_index(gwks, gwi2)
              }
              hold gpw = "num"
              when gkc == 115 {
                hold gpw = "str"
              }
              when gkc == 108 {
                hold gpw = "list"
              }
              hold gnew = concat(gnew, gpw)
            } otherwise {
              // a call to another generic function in the same body: use this
              // specialisation's kind (T is the same type all through)
              hold gihit = 0
              hold ginl = concat(chr(1), gwd)
              hold ginl = concat(ginl, chr(1))
              hold ginll = len(ginl)
              hold gint = len(fgnames)
              hold gini = 0
              while gini + ginll <= gint {
                hold giok = 1
                hold gij = 0
                while gij < ginll {
                  hold gia = sx_index(fgnames, gini + gij)
                  hold gib = sx_index(ginl, gij)
                  when gia == gib {
                    hold gij = gij + 1
                  } otherwise {
                    hold giok = 0
                    hold gij = ginll
                  }
                }
                when giok == 1 {
                  hold gihit = 1
                  hold giat = gini + ginll
                  hold gini = gint
                } otherwise {
                  hold gini = gini + 1
                }
              }
              when gihit == 1 {
                // a generic calling a generic: the callee needs its own
                // kind suffix, one character per *its* type parameters.
                hold gnty2 = 1
                when giat < len(fgnames) {
                  hold gnty2 = sx_index(fgnames, giat) - 48
                }
                hold gsuf = ""
                hold gsc = 0
                while gsc < gnty2 {
                  when gsc < gklen {
                    hold gsuf = concat(gsuf, chr(sx_index(gwks, gsc)))
                  } otherwise {
                    hold gsuf = concat(gsuf, chr(gk0))
                  }
                  hold gsc = gsc + 1
                }
                hold gnew = concat(gnew, gwd)
                hold gnew = concat(gnew, "__")
                hold gnew = concat(gnew, gsuf)
                hold gmore = concat(gmore, chr(1))
                hold gmore = concat(gmore, gwd)
                hold gmore = concat(gmore, chr(1))
                hold gmore = concat(gmore, gsuf)
                hold gmore = concat(gmore, chr(1))
                // The callee's copy is not emitted yet, so its result kind
                // has to be recorded here as well: a `hold v: T = callee(..)`
                hold gqxi = giat + 2
                hold seed_pending_signature = ""
                hold gqxrun = 1
                while gqxrun == 1 {
                  when gqxi >= len(fgnames) {
                    hold gqxrun = 0
                  } otherwise {
                    hold gqxc = sx_index(fgnames, gqxi)
                    when gqxc == 1 {
                      hold gqxrun = 0
                    } otherwise {
                      hold seed_pending_index = gqxc - 48
                      when seed_pending_index >= 0 && seed_pending_index < len(gsuf) {
                        seed_pending_signature = concat(seed_pending_signature, chr(sx_index(gsuf, seed_pending_index)))
                      }
                      hold gqxi = gqxi + 1
                    }
                  }
                }
                // Typed full-profile value checking needs pending callees too:
                // their specialised definition may be emitted after the caller.
                fspk = concat(fspk, concat(concat(concat(gwd, "__"), gsuf), "="))
                fspk = concat(fspk, concat(seed_pending_signature, "|"))
                hold gqxri = 0
                when gqxi + 1 < len(fgnames) {
                  hold gqxri = sx_index(fgnames, gqxi + 1) - 48
                }
                hold gqxrk = 110
                when gqxri >= 0 {
                  when gqxri < len(gsuf) {
                    hold gqxrk = sx_index(gsuf, gqxri)
                  }
                }
                hold fsret = concat(fsret, gwd)
                hold fsret = concat(fsret, "__")
                hold fsret = concat(fsret, gsuf)
                hold fsret = concat(fsret, "=")
                hold fsret = concat(fsret, chr(gqxrk))
                hold fsret = concat(fsret, "|")
              } otherwise {
                hold gnew = concat(gnew, gwd)
              }
            }
          } otherwise {
            hold gnew = concat(gnew, chr(gbc))
            hold gbi = gbi + 1
          }
          }
        }
        // definition + prototype + signature tables for the specialised name
        hold gwtxt = concat(gwtxt, "make ")
        hold gwtxt = concat(gwtxt, gspec)
        hold gwtxt = concat(gwtxt, "(")
        hold gwtxt = concat(gwtxt, gpc2)
        hold gwtxt = concat(gwtxt, ") -> ")
        hold gwtxt = concat(gwtxt, gtw)
        hold gwtxt = concat(gwtxt, " {")
        hold gwtxt = concat(gwtxt, gnew)
        hold gwtxt = concat(gwtxt, "}")
        hold gwtxt = concat(gwtxt, nl)
        hold gproto = concat(gproto, "static ")
        hold gproto = concat(gproto, gtC)
        hold gproto = concat(gproto, " ")
        hold gproto = concat(gproto, gspec)
        hold gproto = concat(gproto, "(")
        hold gproto = concat(gproto, gpc)
        hold gproto = concat(gproto, ");")
        hold gproto = concat(gproto, nl)
        hold fsret = concat(fsret, gspec)
        hold fsret = concat(fsret, "=")
        hold fsret = concat(fsret, chr(gretk))
        hold fsret = concat(fsret, "|")
        hold fspk = concat(fspk, gspec)
        hold fspk = concat(fspk, "=")
        hold fspk = concat(fspk, gpkinds)
        hold fspk = concat(fspk, "|")
        hold fsptx = concat(fsptx, gspec)
        hold fsptx = concat(fsptx, "=")
        hold fsptx = concat(fsptx, gpc)
        hold fsptx = concat(fsptx, "|")
        hold gdefs = concat(gdefs, chr(1))
        hold gdefs = concat(gdefs, gspec)
        hold gdefs = concat(gdefs, chr(1))
        }
      }
    }
    hold gwant = ""
    // Balanced slices keep many-specialization input from repeatedly copying
    // every source prefix one character at a time (quadratic per splice).
    hold gsrc = concat(sxseed_slice(source, 0, pos), gwtxt)
    hold gsrc = concat(gsrc, sxseed_slice(source, pos, n))
    hold source = gsrc
    hold source_words = sxsource_pack(source)
    hold n = len(source)
  }

  // ---- phase 1: skip blanks and // comments ----
  hold skipw = 1
  while skipw == 1 {
    when pos >= n {
      hold skipw = 0
      hold running = 0
    } otherwise {
      hold c = sxsource_get(source_words,pos)
      hold isspace = 0
      when c == 32 || c == 9 || c == 13 || c == 10 {
        hold isspace = 1
      }
      when isspace == 1 {
        hold pos = pos + 1
      } otherwise {
        when c == 47 {
          hold c2 = 0
          when pos + 1 < n {
            hold c2 = sxsource_get(source_words,pos + 1)
          }
          when c2 == 47 {
            // line comment: run to the end of the line
            hold pos = pos + 2
            hold skipc = 1
            while skipc == 1 {
              when pos >= n {
                hold skipc = 0
                hold running = 0
              } otherwise {
                hold c3 = sxsource_get(source_words,pos)
                when c3 == 10 {
                  hold skipc = 0
                } otherwise {
                  hold pos = pos + 1
                }
              }
            }
          } otherwise {
            hold pos = pos + 1
          }
        } otherwise {
          hold skipw = 0
        }
      }
    }
  }

  // ---- phase 1.5: monomorphise the generic calls of this statement -------
  // `make NAME<T>` is compiled by generating one specialised copy per call.
  when running == 1 && (seed_profile == 1 || len(fgnames) > 1) {
    hold zwEnd = pos
    while zwEnd < n && sxsource_get(source_words, zwEnd) != 10 {
      hold zwEnd = zwEnd + 1
    }
    hold zwT = ""
    hold zwI = pos
    while zwI < zwEnd {
      hold zwT = concat(zwT, chr(sxsource_get(source_words, zwI)))
      hold zwI = zwI + 1
    }
    hold zwL = len(zwT)
    hold zwOut = ""
    hold zwHit = 0
    hold zwI = 0
    while zwI < zwL {
      hold zwC = sx_index(zwT, zwI)
      when zwC == 34 {
        // a string literal: copy it verbatim, escapes kept
        hold zwOut = concat(zwOut, chr(zwC))
        hold zwI = zwI + 1
        hold zwRun = 1
        while zwRun == 1 {
          when zwI >= zwL {
            hold zwRun = 0
          } otherwise {
            hold zwC = sx_index(zwT, zwI)
            hold zwOut = concat(zwOut, chr(zwC))
            hold zwI = zwI + 1
            when zwC == 92 {
              when zwI < zwL {
                hold zwOut = concat(zwOut, chr(sx_index(zwT, zwI)))
                hold zwI = zwI + 1
              }
            } otherwise {
              when zwC == 34 {
                hold zwRun = 0
              }
            }
          }
        }
      } otherwise {
        when (zwC >= 97 && zwC <= 122) || (zwC >= 65 && zwC <= 90) || zwC == 95 {
          // an identifier: collect it
          hold zwStart = zwI
          hold zwW = ""
          hold zwRun = 1
          while zwRun == 1 {
            when zwI >= zwL {
              hold zwRun = 0
            } otherwise {
              hold zwC = sx_index(zwT, zwI)
              when (zwC >= 97 && zwC <= 122) || (zwC >= 65 && zwC <= 90) || (zwC >= 48 && zwC <= 57) || zwC == 95 {
                hold zwW = concat(zwW, chr(zwC))
                hold zwI = zwI + 1
              } otherwise {
                hold zwRun = 0
              }
            }
          }
          hold zwS = zwI
          hold zwRun = 1
          while zwRun == 1 {
            when zwS >= zwL {
              hold zwRun = 0
            } otherwise {
              hold zwC = sx_index(zwT, zwS)
              when zwC == 32 || zwC == 9 || zwC == 13 {
                hold zwS = zwS + 1
              } otherwise {
                hold zwRun = 0
              }
            }
          }
          hold zwMatch = 0
          when zwS < zwL {
            when sx_index(zwT, zwS) == 40 {
              // is the word a declared generic?
              hold zwKey = concat(chr(1), zwW)
              hold zwKey = concat(zwKey, chr(1))
              hold zwKl = len(zwKey)
              hold zwLl = len(fgnames)
              hold zwAt = 0
              hold zwLi = 0
              while zwLi + zwKl <= zwLl {
                hold zwOk = 1
                hold zwJ = 0
                while zwJ < zwKl {
                  hold zwA = sx_index(fgnames, zwLi + zwJ)
                  hold zwB = sx_index(zwKey, zwJ)
                  when zwA == zwB {
                    hold zwJ = zwJ + 1
                  } otherwise {
                    hold zwOk = 0
                    hold zwJ = zwKl
                  }
                }
                when zwOk == 1 {
                  hold zwMatch = 1
                  hold zwAt = zwLi + zwKl
                  hold zwLi = zwLl
                } otherwise {
                  hold zwLi = zwLi + 1
                }
              }
            }
          }
          when zwMatch == 0 {
            hold zwOut = concat(zwOut, zwW)
          } otherwise {
            // The kind of every type parameter, not just the first.
            // TIDX[p] says which type parameter value parameter p uses, so
            hold zwNl = len(fgnames)
            hold zwNt = 1
            hold zwTidx = ""
            hold zwRi = 0
            when zwAt < zwNl {
              hold zwNt = sx_index(fgnames, zwAt) - 48
            }
            hold zwAi = zwAt + 2
            hold zwArun = 1
            while zwArun == 1 {
              when zwAi >= zwNl {
                hold zwArun = 0
              } otherwise {
                hold zwAc = sx_index(fgnames, zwAi)
                when zwAc == 1 {
                  hold zwArun = 0
                } otherwise {
                  hold zwTidx = concat(zwTidx, chr(zwAc))
                  hold zwAi = zwAi + 1
                }
              }
            }
            when zwAi + 1 < zwNl {
              hold zwRi = sx_index(fgnames, zwAi + 1) - 48
            }
            hold zwAKinds = ""
            hold zwNP = len(zwTidx)
            when seed_profile == 1 && sxseed_arity(zwT, zwS) != zwNP {
              perr = 1
              permsg = "generic call argument count mismatch"
            }
            hold zwP = 0
            while zwP < zwNP {
              // walk to the start of argument zwP: skip zwP depth-0 commas
              hold zwKk = zwS + 1
              hold zwSkip = zwP
              while zwSkip > 0 {
                hold zwD = 0
                hold zwQ = 0
                hold zwSrch = 1
                while zwSrch == 1 {
                  when zwKk >= zwL {
                    hold zwSrch = 0
                  } otherwise {
                    hold zwKc = sx_index(zwT, zwKk)
                    when zwQ == 1 {
                      when zwKc == 92 {
                        hold zwKk = zwKk + 1
                      } otherwise {
                        when zwKc == 34 {
                          hold zwQ = 0
                        }
                      }
                      hold zwKk = zwKk + 1
                    } otherwise {
                      when zwKc == 34 {
                        hold zwQ = 1
                        hold zwKk = zwKk + 1
                      } otherwise {
                        when zwKc == 40 || zwKc == 91 || zwKc == 123 {
                          hold zwD = zwD + 1
                          hold zwKk = zwKk + 1
                        } otherwise {
                          when zwKc == 41 || zwKc == 93 || zwKc == 125 {
                            when zwD == 0 {
                              hold zwSrch = 0
                            } otherwise {
                              hold zwD = zwD - 1
                              hold zwKk = zwKk + 1
                            }
                          } otherwise {
                            when zwKc == 44 {
                              when zwD == 0 {
                                hold zwSrch = 0
                                hold zwKk = zwKk + 1
                              } otherwise {
                                hold zwKk = zwKk + 1
                              }
                            } otherwise {
                              hold zwKk = zwKk + 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
                hold zwSkip = zwSkip - 1
              }
              hold zwArgstart = zwKk
              hold zwKind = 110
              hold zwKdone = 0
              hold zwKgo = 0
              hold zwKlev = 0
              while zwKdone == 0 {
                hold zwKgo = 0
                hold zwKskip = 1
                while zwKskip == 1 {
                  when zwKk >= zwL {
                    hold zwKskip = 0
                  } otherwise {
                    hold zwKc = sx_index(zwT, zwKk)
                    when zwKc == 32 || zwKc == 9 || zwKc == 13 {
                      hold zwKk = zwKk + 1
                    } otherwise {
                      hold zwKskip = 0
                    }
                  }
                }
                when zwKk >= zwL {
                  hold zwKind = 110
                  hold zwKdone = 1
                } otherwise {
                  hold zwKc = sx_index(zwT, zwKk)
                  when zwKc == 34 {
                    hold zwKind = 115
                    hold zwKdone = 1
                  }
                  when zwKc == 91 {
                    hold zwKind = 108
                    hold zwKdone = 1
                  }
                  when (zwKc >= 97 && zwKc <= 122) || (zwKc >= 65 && zwKc <= 90) || zwKc == 95 {
                    hold zwKw = ""
                    hold zwKrun = 1
                    while zwKrun == 1 {
                      when zwKk >= zwL {
                        hold zwKrun = 0
                      } otherwise {
                        hold zwKc = sx_index(zwT, zwKk)
                        when (zwKc >= 97 && zwKc <= 122) || (zwKc >= 65 && zwKc <= 90) || (zwKc >= 48 && zwKc <= 57) || zwKc == 95 {
                          hold zwKw = concat(zwKw, chr(zwKc))
                          hold zwKk = zwKk + 1
                        } otherwise {
                          hold zwKrun = 0
                        }
                      }
                    }
                    hold zwKs = zwKk
                    hold zwKrun = 1
                    while zwKrun == 1 {
                      when zwKs >= zwL {
                        hold zwKrun = 0
                      } otherwise {
                        hold zwKc = sx_index(zwT, zwKs)
                        when zwKc == 32 || zwKc == 9 || zwKc == 13 {
                          hold zwKs = zwKs + 1
                        } otherwise {
                          hold zwKrun = 0
                        }
                      }
                    }
                    hold zwKiscall = 0
                    when zwKs < zwL {
                      when sx_index(zwT, zwKs) == 40 {
                        hold zwKiscall = 1
                      }
                    }
                    // a declared function has a known return kind
                    hold zwKbk = 0
                    hold zwFkey = concat("|", zwKw)
                    hold zwFkey = concat(zwFkey, "=")
                    hold zwFkl = len(zwFkey)
                    hold zwFl = len(fsret)
                    hold zwFi = 0
                    while zwFi + zwFkl + 1 <= zwFl {
                      hold zwFok = 1
                      hold zwFj = 0
                      while zwFj < zwFkl {
                        hold zwFa = sx_index(fsret, zwFi + zwFj)
                        hold zwFb = sx_index(zwFkey, zwFj)
                        when zwFa == zwFb {
                          hold zwFj = zwFj + 1
                        } otherwise {
                          hold zwFok = 0
                          hold zwFj = zwFkl
                        }
                      }
                      when zwFok == 1 {
                        hold zwFk = sx_index(fsret, zwFi + zwFkl)
                        when zwFk == 115 {
                          hold zwKbk = 115
                        }
                        when zwFk == 108 {
                          hold zwKbk = 108
                        }
                        hold zwFi = zwFl
                      } otherwise {
                        hold zwFi = zwFi + 1
                      }
                    }
                    // is the word itself a generic?  its kind must come from
                    // the call's own argument, never from a return annotation
                    hold zwKgn = 0
                    hold zwGkey = concat(chr(1), zwKw)
                    hold zwGkey = concat(zwGkey, chr(1))
                    hold zwGkl = len(zwGkey)
                    hold zwGl = len(fgnames)
                    hold zwGi = 0
                    while zwGi + zwGkl <= zwGl {
                      hold zwGok = 1
                      hold zwGj = 0
                      while zwGj < zwGkl {
                        hold zwGa = sx_index(fgnames, zwGi + zwGj)
                        hold zwGb = sx_index(zwGkey, zwGj)
                        when zwGa == zwGb {
                          hold zwGj = zwGj + 1
                        } otherwise {
                          hold zwGok = 0
                          hold zwGj = zwGkl
                        }
                      }
                      when zwGok == 1 {
                        hold zwKgn = 1
                        hold zwGi = zwGl
                      } otherwise {
                        hold zwGi = zwGi + 1
                      }
                    }
                    when zwKgn == 1 {
                      hold zwKbk = 0
                    }
                    when zwKiscall == 1 {
                      // the builtins' kinds are fixed
                      when sx_eq(zwKw, "concat") || sx_eq(zwKw, "chr") || sx_eq(zwKw, "read_file") || sx_eq(zwKw, "http_get") || sx_eq(zwKw, "arg") || sx_eq(zwKw, "read_line") || sx_eq(zwKw, "read_n") || sx_eq(zwKw, "numstr") || sx_eq(zwKw, "sx_cat") || sx_eq(zwKw, "sx_chr") || sx_eq(zwKw, "sx_read") || sx_eq(zwKw, "sx_arg") || sx_eq(zwKw, "sx_read_line") || sx_eq(zwKw, "sx_read_n") || sx_eq(zwKw, "sx_numstr") || sx_eq(zwKw, "read_dir") || sx_eq(zwKw, "path_real") || sx_eq(zwKw, "sx_read_dir") || sx_eq(zwKw, "sx_path_real") || sx_eq(zwKw, "child_recv") || sx_eq(zwKw, "child_line") || sx_eq(zwKw, "sx_child_recv") || sx_eq(zwKw, "sx_child_line") || sx_eq(zwKw, "getenv") || sx_eq(zwKw, "sx_getenv") {
                        hold zwKbk = 115
                      }
                      when sx_eq(zwKw, "push") || sx_eq(zwKw, "sx_lpush") {
                        hold zwKbk = 108
                      }
                      when sx_eq(zwKw, "len") || sx_eq(zwKw, "index") || sx_eq(zwKw, "sx_index") || sx_eq(zwKw, "arg_count") || sx_eq(zwKw, "string_eq") || sx_eq(zwKw, "write_file") || sx_eq(zwKw, "write_out") || sx_eq(zwKw, "flush_out") || sx_eq(zwKw, "gc") || sx_eq(zwKw, "gc_live") || sx_eq(zwKw, "gc_runs") || sx_eq(zwKw, "sx_len") || sx_eq(zwKw, "sx_idx") || sx_eq(zwKw, "sx_argc") || sx_eq(zwKw, "sx_eq") || sx_eq(zwKw, "sx_write") || sx_eq(zwKw, "sx_write_out") || sx_eq(zwKw, "sx_flush_out") || sx_eq(zwKw, "sx_gc_run") || sx_eq(zwKw, "sx_gc_live") || sx_eq(zwKw, "sx_gc_count") || sx_eq(zwKw, "exit") || sx_eq(zwKw, "sx_exit") || sx_eq(zwKw, "path_kind") || sx_eq(zwKw, "path_size") || sx_eq(zwKw, "sx_path_kind") || sx_eq(zwKw, "sx_path_size") {
                        hold zwKbk = 110
                      }
                      when zwKbk != 0 {
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      } otherwise {
                        // a generic (or any other call): look at the first
                        // argument of *this* call
                        hold zwKk = zwKs + 1
                        hold zwKlev = zwKlev + 1
                        hold zwKgo = 1
                        when zwKlev >= 12 {
                          hold zwKind = 110
                          hold zwKdone = 1
                        }
                        }
                    } otherwise {
                      when zwKbk != 0 {
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      } otherwise {
                        // a variable: its declared kind, else a number
                        hold zwKbk = 0
                        hold zwVkey = concat("|", zwKw)
                        hold zwVkey = concat(zwVkey, "|")
                        hold zwVkl = len(zwVkey)
                        hold zwVl = len(sdecls)
                        hold zwVi = 0
                        while zwVi + zwVkl <= zwVl {
                          hold zwVok = 1
                          hold zwVj = 0
                          while zwVj < zwVkl {
                            hold zwVa = sx_index(sdecls, zwVi + zwVj)
                            hold zwVb = sx_index(zwVkey, zwVj)
                            when zwVa == zwVb {
                              hold zwVj = zwVj + 1
                            } otherwise {
                              hold zwVok = 0
                              hold zwVj = zwVkl
                            }
                          }
                          when zwVok == 1 {
                            hold zwKbk = 115
                            hold zwVi = zwVl
                          } otherwise {
                            hold zwVi = zwVi + 1
                          }
                        }
                        hold zwVl = len(ldecls)
                        hold zwVi = 0
                        while zwVi + zwVkl <= zwVl {
                          hold zwVok = 1
                          hold zwVj = 0
                          while zwVj < zwVkl {
                            hold zwVa = sx_index(ldecls, zwVi + zwVj)
                            hold zwVb = sx_index(zwVkey, zwVj)
                            when zwVa == zwVb {
                              hold zwVj = zwVj + 1
                            } otherwise {
                              hold zwVok = 0
                              hold zwVj = zwVkl
                            }
                          }
                          when zwVok == 1 {
                            hold zwKbk = 108
                            hold zwVi = zwVl
                          } otherwise {
                            hold zwVi = zwVi + 1
                          }
                        }
                        when zwKbk == 0 {
                          hold zwKbk = 110
                        }
                        hold zwKind = zwKbk
                        hold zwKdone = 1
                      }
                    }
                  }
                  when zwKdone == 0 && zwKgo == 0 {
                    // a number, a parenthesized expression, ...: a number
                    hold zwKind = 110
                    hold zwKdone = 1
                  }
                }
              }
              // Refine the coarse first-token classification when the
              // typed expression parser can resolve the whole argument.
              hold zenv = concat(decls, chr(1))
              hold zenv = concat(zenv, sdecls)
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, ldecls)
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, svars)
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, fsret)
              hold zenv = concat(zenv, "|len=n|concat=s|sx_index=n|index=n|chr=s|numstr=s|push=l|string_eq=n|")
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, fspk)
              hold zenv = concat(zenv, "|len=a|concat=sv|sx_index=sn|index=an|chr=n|numstr=n|push=ln|string_eq=ss|")
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, inprivate)
              hold zenv = concat(zenv, chr(1))
              hold zenv = concat(zenv, ftypes)
              hold zstate = []
              hold zvalue = sxeparse(zwT, zwArgstart, zenv, 0, 0, zstate)
              hold zkind = sxesegment(zvalue, 1)
              hold zend = sxflowspace(zwT, sxepos(zvalue))
              hold zcomplete = 0
              when zend < len(zwT) {
                hold zchar = sx_index(zwT, zend)
                when zchar == 44 || zchar == 41 {
                  hold zcomplete = 1
                }
              }
              when zcomplete == 1 && (string_eq(zkind, "n") || string_eq(zkind, "s") || string_eq(zkind, "l")) {
                hold zwKind = sx_index(zkind, 0)
              }
              hold zwAKinds = concat(zwAKinds, chr(zwKind))
              hold zwP = zwP + 1
            }
            hold zwKinds = ""
            hold zwTj = 0
            while zwTj < zwNt {
              hold zwTk = 0
              hold zwFound = 0
              hold zwTp = 0
              while zwTp < zwNP {
                hold zwTv = sx_index(zwTidx, zwTp) - 48
                when zwTv == zwTj {
                  when zwFound == 0 {
                    hold zwTk = zwTp
                    hold zwFound = 1
                  }
                }
                hold zwTp = zwTp + 1
              }
              hold zwKc2 = 110
              when zwTk < len(zwAKinds) {
                hold zwKc2 = sx_index(zwAKinds, zwTk)
              }
              when seed_profile == 1 {
                hold seed_ai = 0
                while seed_ai < zwNP {
                  when sx_index(zwTidx, seed_ai) - 48 == zwTj && sx_index(zwAKinds, seed_ai) != zwKc2 {
                    perr = 1
                    permsg = "generic call type parameter conflict"
                  }
                  seed_ai = seed_ai + 1
                }
              }
              hold zwKinds = concat(zwKinds, chr(zwKc2))
              hold zwTj = zwTj + 1
            }
            hold zwRk = 110
            when zwRi < len(zwKinds) {
              hold zwRk = sx_index(zwKinds, zwRi)
            }
            hold zwOut = concat(zwOut, zwW)
            hold zwOut = concat(zwOut, "__")
            hold zwOut = concat(zwOut, zwKinds)
            hold zwHit = 1
            // request the specialised copy and remember its result kind
            hold gmore = concat(gmore, chr(1))
            hold gmore = concat(gmore, zwW)
            hold gmore = concat(gmore, chr(1))
            hold gmore = concat(gmore, zwKinds)
            hold gmore = concat(gmore, chr(1))
            hold fsret = concat(fsret, zwW)
            hold fsret = concat(fsret, "__")
            hold fsret = concat(fsret, zwKinds)
            hold fsret = concat(fsret, "=")
            hold fsret = concat(fsret, chr(zwRk))
            hold fsret = concat(fsret, "|")
            hold fspk = concat(fspk, zwW)
            hold fspk = concat(fspk, "__")
            hold fspk = concat(fspk, zwKinds)
            hold fspk = concat(fspk, "=")
            hold inp = 0
            while inp < len(zwTidx) {
              hold intype = sx_index(zwTidx, inp) - 48
              hold fspk = concat(fspk, chr(sx_index(zwKinds, intype)))
              hold inp = inp + 1
            }
            hold fspk = concat(fspk, "|")
          }
        } otherwise {
          hold zwOut = concat(zwOut, chr(zwC))
          hold zwI = zwI + 1
        }
      }
    }
    when seed_profile == 1 {
      hold seed_call_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
      hold seed_for_error = sxseed_for(zwOut, seed_call_env)
      when len(seed_for_error) > 0 && perr == 0 { perr = 1
        permsg = seed_for_error }
      hold seed_call_error = sxseed_calls(zwOut, seed_call_env, in_fn * flowtyped, fsret)
      when len(seed_call_error) > 0 && perr == 0 {
        perr = 1
        permsg = concat("call type error: ", seed_call_error)
      }
    }
    when zwHit == 1 {
      hold zwSrc = concat(sxseed_slice(source, 0, pos), zwOut)
      hold zwSrc = concat(zwSrc, sxseed_slice(source, zwEnd, n))
      hold source = zwSrc
      hold source_words = sxsource_pack(source)
      hold n = len(source)
    }
  }

  // ---- phase 2: one statement ----
  when running == 1 {
    hold c = sxsource_get(source_words,pos)
    // per-statement assignment state: `NAME = EXPR`, `NAME.f = EXPR` and
    // `NAME[i] = EXPR` reuse the hold parser (act 1) with asmode = 1
    hold instart = len(body)
    hold refstart = pos
    hold asmode = 0
    hold liset = 0
    hold lidx = ""

    // dispatch on the first character; act is 0 for "not a statement"
    hold act = 0
    when c == 104 {
      hold act = 1
    }
    when c == 115 {
      hold kw = ""
      hold ki = 0
      while ki < 6 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sxsource_get(source_words, pos + ki)))
        }
        hold ki = ki + 1
      }
      hold act = 2
      when sx_eq(kw, "struct") {
        hold act = 7
      }
    }
    when c == 119 {
      hold act = 3
    }
    when c == 125 {
      hold act = 4
    }
    // make
    when c == 109 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sxsource_get(source_words, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "make") {
        hold act = 5
        // `make NAME<T>(...)` is a generic: act 15 skips the definition
        // (specialisations are spliced in on demand)
        hold mkg = pos + 4
        hold mknm = ""
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sxsource_get(source_words, mkg)
            when mkc == 32 || mkc == 9 {
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sxsource_get(source_words, mkg)
            when (mkc >= 97 && mkc <= 122) || (mkc >= 65 && mkc <= 90) || (mkc >= 48 && mkc <= 57) || mkc == 95 {
              hold mknm = concat(mknm, chr(mkc))
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkrun = 1
        while mkrun == 1 {
          when mkg >= n {
            hold mkrun = 0
          } otherwise {
            hold mkc = sxsource_get(source_words, mkg)
            when mkc == 32 || mkc == 9 {
              hold mkg = mkg + 1
            } otherwise {
              hold mkrun = 0
            }
          }
        }
        hold mkc = 0
        when mkg < n {
          hold mkc = sxsource_get(source_words, mkg)
        }
        when mkc == 60 {
          hold act = 15
          hold gskipnm = mknm
        }
      }

    }
    // give
    when c == 103 {
      hold kw = ""
      hold ki = 0
      while ki < 4 {
        when pos + ki < n {
          hold kw = concat(kw, chr(sxsource_get(source_words, pos + ki)))
        }
        hold ki = ki + 1
      }
      when sx_eq(kw, "give") {
        hold act = 6
      }
    }

    // ---- statement pre-checks (run before the per-statement blocks) ----
    //  * a statement word must be a WHOLE keyword: `hello = 1` is not `hold`
    hold bpush = 0
    hold pmode = 0
    hold pbad = 0
    hold atype = ""
    hold checked_value = 0
    hold fully_checked_value = 0
    hold fully_checked_kind = ""
    hold value_compare_code = ""
    hold value_compare_end = 0
    hold cmpop = 0
    when (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 {
      hold uword = ""
      hold pp = pos
      hold prun = 1
      while prun == 1 {
        when pp >= n {
          hold prun = 0
        } otherwise {
          hold pc = sxsource_get(source_words, pp)
          when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
            hold uword = concat(uword, chr(pc))
            hold pp = pp + 1
          } otherwise {
            hold prun = 0
          }
        }
      }
      hold pok2 = 0
      when sx_eq(uword, "hold") || sx_eq(uword, "show") || sx_eq(uword, "when") || sx_eq(uword, "while") {
        hold pok2 = 1
      }
      when sx_eq(uword, "make") || sx_eq(uword, "give") || sx_eq(uword, "struct") {
        hold pok2 = 1
      }
      when sx_eq(uword, "push") {
        hold pok2 = 2
      }
      // full-language statements: for / break / continue
      when sx_eq(uword, "for") {
        hold pok2 = 3
      }
      when sx_eq(uword, "break") || sx_eq(uword, "continue") {
        hold pok2 = 4
      }
      when pok2 == 2 {
        // bare push(NAME, EXPR)
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sxsource_get(source_words, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pc = 0
        when pp < n {
          hold pc = sxsource_get(source_words, pp)
        }
        hold pnm = ""
        when pc == 40 {
          hold pp = pp + 1
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold pc = 0
          when pp < n {
            hold pc = sxsource_get(source_words, pp)
          }
          when pc != 44 {
            hold pnm = ""
          }
        }
        when sx_eq(pnm, "") {
          hold pmsg = "push statement: expected push(list, value) with a list variable name first, e.g. push(xs, 4)"
          hold pbad = 1
        } otherwise {
          hold psrc = ldecls
          hold pkey = concat("|", pnm)
          hold pkey = concat(pkey, "|")
          hold pfound = 0
          hold pi2 = 0
          hold pa2 = len(psrc)
          hold pb2 = len(pkey)
          while pi2 + pb2 <= pa2 {
            hold pok2 = 1
            hold pj2 = 0
            while pj2 < pb2 {
              hold pa3 = sx_index(psrc, pi2 + pj2)
              hold pb3 = sx_index(pkey, pj2)
              when pa3 == pb3 {
                hold pj2 = pj2 + 1
              } otherwise {
                hold pok2 = 0
                hold pj2 = pb2
              }
            }
            when pok2 == 1 {
              hold pfound = 1
              hold pi2 = pa2
            } otherwise {
              hold pi2 = pi2 + 1
            }
          }
          when pfound == 1 {
            hold act = 1
            hold bpush = 1
            hold nm = pnm
          } otherwise {
            hold pmsg = concat("push statement: '", pnm)
            hold pmsg = concat(pmsg, "' is not a list; hold it as a list first, e.g. hold xs = []")
            hold pbad = 1
          }
        }
      }
      // (pok2 doubles as scratch in the push search above; a push error
      // has already set pbad, and its message must win)
      when pok2 == 0 && pbad == 0 {
        // an assignment statement: NAME = EXPR, NAME.field = EXPR,
        // NAME[i] = EXPR, or a compound `+= -= *= /= %=`
        hold ap = pp
        hold aok = 0
        hold arun = 1
        while arun == 1 {
          when ap >= n {
            hold arun = 0
          } otherwise {
            hold ac1 = sxsource_get(source_words, ap)
            when ac1 == 32 || ac1 == 9 || ac1 == 13 {
              hold ap = ap + 1
            } otherwise {
              when ac1 == 61 {
                hold ac2 = 0
                when ap + 1 < n {
                  hold ac2 = sxsource_get(source_words, ap + 1)
                }
                when ac2 == 61 {
                  hold arun = 0
                } otherwise {
                  hold aok = 1
                  hold arun = 0
                }
              } otherwise {
                when ac1 == 43 || ac1 == 45 || ac1 == 42 || ac1 == 47 || ac1 == 37 {
                  hold ac2 = 0
                  when ap + 1 < n {
                    hold ac2 = sxsource_get(source_words, ap + 1)
                  }
                  when ac2 == 61 {
                    hold aok = 1
                  }
                  hold arun = 0
                } otherwise {
                  when ac1 == 46 {
                    hold ap = ap + 1
                    hold arun2 = 1
                    while arun2 == 1 {
                      when ap >= n {
                        hold arun2 = 0
                      } otherwise {
                        hold ac2 = sxsource_get(source_words, ap)
                        when (ac2 >= 97 && ac2 <= 122) || (ac2 >= 65 && ac2 <= 90) || (ac2 >= 48 && ac2 <= 57) || ac2 == 95 {
                          hold ap = ap + 1
                        } otherwise {
                          hold arun2 = 0
                        }
                      }
                    }
                  } otherwise {
                    when ac1 == 91 {
                      hold abd = 0
                      hold arun2 = 1
                      while arun2 == 1 {
                        when ap >= n {
                          hold arun2 = 0
                        } otherwise {
                          hold ac2 = sxsource_get(source_words, ap)
                          when ac2 == 91 {
                            hold abd = abd + 1
                          }
                          when ac2 == 93 {
                            hold abd = abd - 1
                          }
                          hold ap = ap + 1
                          when abd == 0 {
                            hold arun2 = 0
                          }
                        }
                      }
                    } otherwise {
                      hold arun = 0
                    }
                  }
                }
              }
            }
          }
        }
        when aok == 1 {
          hold act = 1
          hold asmode = 1
        } otherwise {
          hold pmsg = concat("unknown statement '", uword)
          hold pmsg = concat(pmsg, "' (statements are hold show when while make give struct, for, while and push(xs, v))")
          hold pbad = 1
        }
      }
      when pbad == 1 {
        // skip the rest of the line; the first such error is reported
        hold act = 9
        hold prun = 1
        while prun == 1 {
          when pos >= n {
            hold prun = 0
          } otherwise {
            hold pc = sxsource_get(source_words, pos)
            when pc == 10 {
              hold prun = 0
            } otherwise {
              hold pos = pos + 1
            }
          }
        }
      }
      // for NAME in A..B { ... }  ->  act 10 (full language)
      when pok2 == 3 && pbad == 0 {
        hold act = 10
        hold pos = pp
      }
      // break / continue -> act 11 / act 12
      when pok2 == 4 && pbad == 0 {
        when sx_eq(uword, "break") {
          hold act = 11
        } otherwise {
          hold act = 12
        }
        hold pos = pp
      }
    }
    when act == 1 || act == 2 {
      when bpush == 0 {
        hold pp = pos + 4
        // an assignment statement keeps the name at pos (no `hold` keyword);
        // a repeated `hold` of an existing name compiles as an assignment
        when act == 1 && asmode == 1 {
          hold pp = pos
        }
        hold prun = 1
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sxsource_get(source_words, pp)
            when pc == 32 || pc == 9 || pc == 13 {
              hold pp = pp + 1
            } otherwise {
              hold prun = 0
            }
          }
        }
        hold pnm = ""
        when act == 1 {
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                hold pnm = concat(pnm, chr(pc))
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
          // optional `: TYPE` annotation (full language)
          hold pc = 0
          when pp < n {
            hold pc = sxsource_get(source_words, pp)
          }
          when pc == 58 {
            hold pp = pp + 1
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sxsource_get(source_words, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold aword = ""
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sxsource_get(source_words, pp)
                when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 {
                  hold aword = concat(aword, chr(pc))
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
            hold atype = aword
            hold prun = 1
            while prun == 1 {
              when pp >= n {
                hold prun = 0
              } otherwise {
                hold pc = sxsource_get(source_words, pp)
                when pc == 32 || pc == 9 || pc == 13 {
                  hold pp = pp + 1
                } otherwise {
                  hold prun = 0
                }
              }
            }
          }
          when pp < n {
            hold pc = sxsource_get(source_words, pp)
            when pc == 61 {
              hold pp = pp + 1
            } otherwise {
              // compound assignment: NAME += EXPR (also -= *= /= %=)
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sxsource_get(source_words, pp + 1)
              }
              when pc2 == 61 {
                when pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
                  hold cmpop = pc
                  hold pp = pp + 2
                }
              }
            }
          }
          hold prun = 1
          while prun == 1 {
            when pp >= n {
              hold prun = 0
            } otherwise {
              hold pc = sxsource_get(source_words, pp)
              when pc == 32 || pc == 9 || pc == 13 {
                hold pp = pp + 1
              } otherwise {
                hold prun = 0
              }
            }
          }
        }
        // the expression text up to the end of the line (or a // comment);
        // a `(` that does not directly follow a name is a grouping paren
        hold pexpr = ""
        hold phas = 0
        hold pq = 0
        hold pprev = 0
        hold prun = 1
        // a list literal ([a, (a - 1)]) is not a grouping paren expression:
        // its first non-blank character decides (plist), not the parens inside it
        hold pseen = 0
        hold plist = 0
        hold pbracket = 0
        // Braces opened by a struct literal in this value: a '(' inside
        // `Size { bytes: (2 + 3) * 4 }` groups a FIELD value, so it must not
        // route the whole statement through the parenthesized-expression
        // rewrite (which has never accepted a '{').
        hold pbrace = 0
        hold pcalldepth = 0
        while prun == 1 {
          when pp >= n {
            hold prun = 0
          } otherwise {
            hold pc = sxsource_get(source_words, pp)
            when pq == 1 {
              hold pexpr = concat(pexpr, chr(pc))
              hold pp = pp + 1
              when pc == 92 {
                when pp < n {
                  hold pexpr = concat(pexpr, chr(sxsource_get(source_words, pp)))
                  hold pp = pp + 1
                }
              } otherwise {
                when pc == 34 {
                  hold pq = 0
                  hold pprev = 34
                }
              }
            } otherwise {
              hold pc2 = 0
              when pp + 1 < n {
                hold pc2 = sxsource_get(source_words, pp + 1)
              }
              when pc == 10 || pc == 13 || (pc == 47 && pc2 == 47) {
                hold prun = 0
              } otherwise {
                when pc != 32 && pc != 9 && pseen == 0 {
                  hold pseen = 1
                  when pc == 91 {
                    hold plist = 1
                  }
                }
                when pc == 91 {
                  hold pbracket = pbracket + 1
                }
                when pc == 93 {
                  hold pbracket = pbracket - 1
                }
                when pc == 123 {
                  hold pbrace = pbrace + 1
                }
                when pc == 125 {
                  hold pbrace = pbrace - 1
                }
                when pc == 40 {
                  when pcalldepth > 0 {
                    hold pcalldepth = pcalldepth + 1
                  } otherwise {
                    when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || (pprev >= 48 && pprev <= 57) || pprev == 95 {
                      hold pcalldepth = 1
                    } otherwise {
                      when plist == 0 && pbracket == 0 && pbrace == 0 {
                        hold phas = 1
                      }
                    }
                  }
                }
                when pc == 41 && pcalldepth > 0 {
                  hold pcalldepth = pcalldepth - 1
                }
                when pc == 34 {
                  hold pq = 1
                }
                when pc != 32 && pc != 9 {
                  hold pprev = pc
                }
                hold pexpr = concat(pexpr, chr(pc))
                hold pp = pp + 1
              }
            }
          }
        }
        // a bare and / or / not outside quotes makes this a value-position
        // logic expression: route it through the shared condition rewrite (act 8)
        when phas == 0 {
          hold pwi = 0
          hold pwl = len(pexpr)
          hold pwq = 0
          while pwi < pwl {
            hold pwc = sx_index(pexpr, pwi)
            when pwq == 1 {
              when pwc == 92 && pwi + 1 < pwl {
                hold pwi = pwi + 2
              } otherwise {
                when pwc == 34 { hold pwq = 0 }
                hold pwi = pwi + 1
              }
            } otherwise {
              when pwc == 34 {
                hold pwq = 1
                hold pwi = pwi + 1
              } otherwise {
                when (pwc >= 97 && pwc <= 122) || (pwc >= 65 && pwc <= 90) || pwc == 95 {
                  hold pww = ""
                  hold pwj = pwi
                  hold pwr = 1
                  while pwr == 1 {
                    when pwj >= pwl {
                      hold pwr = 0
                    } otherwise {
                      hold pwd = sx_index(pexpr, pwj)
                      when (pwd >= 97 && pwd <= 122) || (pwd >= 65 && pwd <= 90) || (pwd >= 48 && pwd <= 57) || pwd == 95 {
                        hold pww = concat(pww, chr(pwd))
                        hold pwj = pwj + 1
                      } otherwise {
                        hold pwr = 0
                      }
                    }
                  }
                  when sx_eq(pww, "and") || sx_eq(pww, "or") || sx_eq(pww, "not") {
                    hold phas = 1
                  }
                  hold pwi = pwj
                } otherwise {
                  hold pwi = pwi + 1
                }
              }
            }
          }
        }
        // A complete numeric string comparison is also a value, not a
        // string-returning call followed by stray comparison tokens.
        when sxseed_has_comparison(pexpr) == 1 {
          hold pv_private = inprivate
          when inready == 0 {
            when len(condition_private) == 0 {
              condition_private = inprivate
              while sxecontains(source, condition_private) { condition_private = concat(condition_private, "x") }
            }
            pv_private = condition_private
          }
          hold pv_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, pv_private)
          hold pv_state = []
          hold pv_first = len(instate)
          hold pv_serial = 0
          while pv_serial < pv_first { push(pv_state, 0)
            pv_serial = pv_serial + 1 }
          hold pv_value = sxeparse(pexpr, 0, pv_env, 0, 0, pv_state)
          when sxflowspace(pexpr, sxepos(pv_value)) == len(pexpr) {
            when sx_eq(sxesegment(pv_value, 1), "n") { phas = 1
              checked_value = 1 }
            when sx_eq(sxesegment(pv_value, 1), "s") && sxecontains(sxecode(pv_value), "sx_cmp(") {
              fully_checked_value = 1
              fully_checked_kind = "s"
              value_compare_code = sxecode(pv_value)
              value_compare_end = pp
              rt = 1
              when len(pv_state) > pv_first || sxecontains(value_compare_code, concat(pv_private, "list(")) {
                inprivate = pv_private
                when inready == 0 {
                  inready = 1
                  fsret = concat(fsret, concat(inprivate, "list=l|"))
                }
                lt = 1
                hold pv_decls = ""
                pv_serial = pv_first
                while pv_serial < len(pv_state) {
                  push(instate, 0)
                  pv_decls = concat(pv_decls, concat("  double ", concat(inprivate, concat(sxedigits(pv_serial), ";\n"))))
                  pv_serial = pv_serial + 1
                }
                when in_fn == 1 { condition_fn_decls = concat(condition_fn_decls, pv_decls) } otherwise { condition_main_decls = concat(condition_main_decls, pv_decls) }
              }
            }
          }
        }
        when phas == 1 {
          hold pmode = act
          hold act = 8
          hold pos = pp
          // trim trailing blanks -> ctrim / cl (the rewrite input)
          hold cl = len(pexpr)
          hold trim = 1
          while trim == 1 {
            when cl <= 0 {
              hold trim = 0
            } otherwise {
              hold pc = sx_index(pexpr, cl - 1)
              when pc == 32 || pc == 9 {
                hold cl = cl - 1
              } otherwise {
                hold trim = 0
              }
            }
          }
          hold ctrim = ""
          hold ci = 0
          while ci < cl {
            hold ctrim = concat(ctrim, chr(sx_index(pexpr, ci)))
            hold ci = ci + 1
          }
          // validate: numbers, numeric names, make-function calls,
          // + - * / %, comparisons, && ||, and balanced parens only
          hold pstk = ""
          hold pprev = 0
          hold pv = 0
          while pv < cl && checked_value == 0 {
            hold pc = sx_index(ctrim, pv)
            hold pc2 = 0
            when pv + 1 < cl {
              hold pc2 = sx_index(ctrim, pv + 1)
            }
            hold pstep = 1
            hold pknown = 0
            when pc == 32 || pc == 9 || pc == 43 || pc == 45 || pc == 42 || pc == 47 || pc == 37 {
              hold pknown = 1
            }
            when (pc >= 48 && pc <= 57) || (pc == 46 && pc2 >= 48 && pc2 <= 57) {
              hold pknown = 1
              hold pv2 = pv
              hold pdot = 0
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when pc3 >= 48 && pc3 <= 57 {
                    hold pv2 = pv2 + 1
                  } otherwise {
                    when pc3 == 46 && pdot == 0 {
                      hold pdot = 1
                      hold pv2 = pv2 + 1
                    } otherwise {
                      hold prun = 0
                    }
                  }
                }
              }
              hold pc3 = 0
              when pv2 < cl {
                hold pc3 = sx_index(ctrim, pv2)
              }
              when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || pc3 == 95 || pc3 == 46 {
                hold pmsg = "malformed number literal"
                hold pbad = 1
              }
              hold pstep = pv2 - pv
              hold pc = 48
            }
            when (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || pc == 95 {
              hold pknown = 1
              hold pw = ""
              hold pv2 = pv
              hold prun = 1
              while prun == 1 {
                when pv2 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv2)
                  when (pc3 >= 97 && pc3 <= 122) || (pc3 >= 65 && pc3 <= 90) || (pc3 >= 48 && pc3 <= 57) || pc3 == 95 {
                    hold pw = concat(pw, chr(pc3))
                    hold pv2 = pv2 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pstep = pv2 - pv
              hold pv3 = pv2
              hold prun = 1
              while prun == 1 {
                when pv3 >= cl {
                  hold prun = 0
                } otherwise {
                  hold pc3 = sx_index(ctrim, pv3)
                  when pc3 == 32 || pc3 == 9 {
                    hold pv3 = pv3 + 1
                  } otherwise {
                    hold prun = 0
                  }
                }
              }
              hold pc3 = 0
              when pv3 < cl {
                hold pc3 = sx_index(ctrim, pv3)
              }
              hold pkwd = 0
              when sx_eq(pw, "and") || sx_eq(pw, "or") || sx_eq(pw, "not") {
                hold pkwd = 1
              }
              when pkwd == 1 {
              } otherwise {
              when pc3 == 40 {
                hold pok2 = 0
                hold pnumb = 0
                hold pcheckednumeric = 0
                when sxseed_csv_has("arg_count,gc,gc_live,gc_runs,flush_out,write_file,write_out,exit,path_kind,path_size,spawn,child_send,child_close,make_dir,make_link,remove_path,write_bytes,read_bytes,bit_and,bit_or,bit_xor,bit_not,shl,shr,run_command", pw) == 1 {
                  hold pcheckednumeric = 1
                }
                when pcheckednumeric == 1 || sx_eq(pw, "len") || sx_eq(pw, "sx_index") || sx_eq(pw, "string_eq") {
                  // Locate the complete numeric call. New grouped numeric builtins
                  // receive checked signature validation below; keep the existing
                  // len/sx_index/string_eq path unchanged.
                  hold pnumb = 1
                  hold pnumd = 0
                  hold pnume = pv3
                  hold pnumdone = 0
                  while pnumdone == 0 && pnume < cl {
                    hold pnumch = sx_index(ctrim, pnume)
                    when pnumch == 40 {
                      hold pnumd = pnumd + 1
                    }
                    when pnumch == 41 {
                      hold pnumd = pnumd - 1
                      when pnumd == 0 {
                        hold pnumdone = 1
                      }
                    }
                    hold pnume = pnume + 1
                  }
                  hold pstep = pnume - pv
                }
                when sx_eq(pw, "concat") || sx_eq(pw, "chr") || sx_eq(pw, "index") || sx_eq(pw, "push") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "read_file") || sx_eq(pw, "http_get") || sx_eq(pw, "write_file") || sx_eq(pw, "arg") || sx_eq(pw, "arg_count") || sx_eq(pw, "getenv") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_cat") || sx_eq(pw, "sx_len") || sx_eq(pw, "sx_chr") || sx_eq(pw, "sx_idx") || sx_eq(pw, "sx_eq") {
                  hold pok2 = 1
                }
                when sx_eq(pw, "sx_read") || sx_eq(pw, "sx_write") || sx_eq(pw, "sx_arg") || sx_eq(pw, "sx_argc") {
                  hold pok2 = 1
                }
                when pcheckednumeric == 1 {
                  // Reuse checked call signatures: permitting a numeric return
                  // must not bypass the builtin arity or argument-kind contract.
                  hold pzenv = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, inprivate)
                  hold pzstate = []
                  hold pzvalue = sxeparse(ctrim, pv, pzenv, 100, 0, pzstate)
                  when sx_eq(sxesegment(pzvalue, 1), "n") == 0 {
                    hold pbad = 1
                    hold pmsg = concat("checked numeric builtin call: ", sxecode(pzvalue))
                  } otherwise {
                    hold pstep = sxepos(pzvalue) - pv
                  }
                  hold pok2 = 0
                }
                when pok2 == 1 {
                  hold pmsg = concat("builtin '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold its result in a variable first")
                  hold pbad = 1
                } otherwise {
                  hold psrc = fns
                  hold pkey = concat("static double ", pw)
                  hold pkey = concat(pkey, "(")
                  hold pfound = 0
                  hold pi2 = 0
                  hold pa2 = len(psrc)
                  hold pb2 = len(pkey)
                  while pi2 + pb2 <= pa2 {
                    hold pok2 = 1
                    hold pj2 = 0
                    while pj2 < pb2 {
                      hold pa3 = sx_index(psrc, pi2 + pj2)
                      hold pb3 = sx_index(pkey, pj2)
                      when pa3 == pb3 {
                        hold pj2 = pj2 + 1
                      } otherwise {
                        hold pok2 = 0
                        hold pj2 = pb2
                      }
                    }
                    when pok2 == 1 {
                      hold pfound = 1
                      hold pi2 = pa2
                    } otherwise {
                      hold pi2 = pi2 + 1
                    }
                  }
                  when in_fn == 1 {
                    when sx_eq(pw, fn_name) {
                      hold pfound = 1
                    }
                  }
                  when pfound == 0 && pnumb == 0 {
                    hold pmsg = concat("unknown function '", pw)
                    hold pmsg = concat(pmsg, "' in a parenthesized expression (define it with make first)")
                    hold pbad = 1
                  }
                }
              } otherwise {
                when pc3 == 46 || pc3 == 91 {
                  hold pmsg = concat("a field access or index on '", pw)
                  hold pmsg = concat(pmsg, "' inside a parenthesized expression is not supported by this compiler; hold the value in a variable first")
                  hold pbad = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "|")
                hold psrc = sdecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                hold pok2 = pfound
                hold psrc = ldecls
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                hold pkey = concat("|", pw)
                hold pkey = concat(pkey, "=")
                hold psrc = svars
                hold pfound = 0
                hold pi2 = 0
                hold pa2 = len(psrc)
                hold pb2 = len(pkey)
                while pi2 + pb2 <= pa2 {
                  hold pok2 = 1
                  hold pj2 = 0
                  while pj2 < pb2 {
                    hold pa3 = sx_index(psrc, pi2 + pj2)
                    hold pb3 = sx_index(pkey, pj2)
                    when pa3 == pb3 {
                      hold pj2 = pj2 + 1
                    } otherwise {
                      hold pok2 = 0
                      hold pj2 = pb2
                    }
                  }
                  when pok2 == 1 {
                    hold pfound = 1
                    hold pi2 = pa2
                  } otherwise {
                    hold pi2 = pi2 + 1
                  }
                }
                when pfound == 1 {
                  hold pok2 = 1
                }
                when pok2 == 1 {
                  hold pmsg = concat("'", pw)
                  hold pmsg = concat(pmsg, "' is a string, list or struct; a parenthesized expression must be numeric")
                  hold pbad = 1
                }
              }
              }
              hold pc = 97
            }
            when pc == 40 {
              hold pknown = 1
              when (pprev >= 97 && pprev <= 122) || (pprev >= 65 && pprev <= 90) || pprev == 95 {
                hold pstk = concat(pstk, "c")
              } otherwise {
                when pprev == 48 || pprev == 41 {
                  hold pmsg = "a '(' directly after a value; write an operator between them"
                  hold pbad = 1
                }
                hold pstk = concat(pstk, "g")
              }
            }
            when pc == 41 {
              hold pknown = 1
              hold pstl = len(pstk)
              when pstl == 0 {
                hold pmsg = "unbalanced ')' in a parenthesized expression"
                hold pbad = 1
              } otherwise {
                hold pw = ""
                hold pv2 = 0
                while pv2 < pstl - 1 {
                  hold pw = concat(pw, chr(sx_index(pstk, pv2)))
                  hold pv2 = pv2 + 1
                }
                hold pstk = pw
              }
            }
            when pc == 44 {
              hold pknown = 1
              hold pstl = len(pstk)
              hold pc3 = 0
              when pstl > 0 {
                hold pc3 = sx_index(pstk, pstl - 1)
              }
              when pc3 != 99 {
                hold pmsg = "a ',' outside a function call in a parenthesized expression"
                hold pbad = 1
              }
            }
            when pc == 61 || pc == 33 || pc == 38 || pc == 124 {
              hold pknown = 1
              hold pc3 = 61
              when pc == 38 || pc == 124 {
                hold pc3 = pc
              }
              when pc2 == pc3 {
                hold pstep = 2
              } otherwise {
                hold pmsg = "unsupported operator in a parenthesized expression (use == != < <= > >= && ||)"
                hold pbad = 1
              }
            }
            when pc == 60 || pc == 62 {
              hold pknown = 1
              when pc2 == 61 {
                hold pstep = 2
              }
            }
            when pknown == 0 {
              hold pmsg = concat("unexpected '", chr(pc))
              hold pmsg = concat(pmsg, "' in a parenthesized expression (strings, lists, fields and struct literals are not supported inside parentheses by this compiler)")
              hold pbad = 1
            }
            when pc != 32 && pc != 9 {
              hold pprev = pc
            }
            hold pv = pv + pstep
            // the first problem found is the one reported
            when pbad == 1 && perr == 0 {
              hold perr = 1
              hold permsg = pmsg
            }
          }
          when sx_eq(pstk, "") {
          } otherwise {
            hold pmsg = "unbalanced '(' in a parenthesized expression"
            hold pbad = 1
          }
        }
      }
    }
    when pbad == 1 {
      when perr == 0 {
        hold permsg = pmsg
      }
      hold perr = 1
    }


    // Check references while the active lexical binding tables are available.
    // Do not hoist expressions or change their evaluation/allocation timing.
    when act == 1 || act == 2 || act == 3 || act == 6 || act == 8 || act == 10 {
      hold reftext = ""
      hold refi = refstart
      hold refnest = 0
      hold refquote = 0
      hold refrun = 1
      while refi < n && refrun == 1 {
        hold refc = sxsource_get(source_words, refi)
        when refquote == 1 {
          hold reftext = concat(reftext, chr(refc))
          hold refi = refi + 1
          when refc == 92 && refi < n {
            hold reftext = concat(reftext, chr(sxsource_get(source_words, refi)))
            hold refi = refi + 1
          } otherwise {
            when refc == 34 {
              hold refquote = 0
            }
          }
        } otherwise {
          when refc == 34 {
            hold refquote = 1
          }
          when refc == 47 && refi + 1 < n && sxsource_get(source_words, refi + 1) == 47 {
            while refi < n && sxsource_get(source_words, refi) != 10 {
              hold refi = refi + 1
            }
            hold refc = 10
          }
          when refnest == 0 && (refc == 10 || refc == 13 || refc == 125 || ((act == 3 || act == 10) && refc == 123)) {
            hold refrun = 0
          } otherwise {
            when refquote == 0 {
              when refc == 40 || refc == 91 || refc == 123 {
                hold refnest = refnest + 1
              }
              when refc == 41 || refc == 93 || refc == 125 {
                hold refnest = refnest - 1
              }
            }
            hold reftext = concat(reftext, chr(refc))
            hold refi = refi + 1
          }
        }
      }
      // String iteration binders live in sdecls, not always in decls.
      hold refbindings = concat(decls, sdecls)
      hold refbindings = concat(refbindings, ldecls)
      hold referror = sxcheckrefs(reftext, refbindings, fsret)
      when len(referror) > 0 && perr == 0 {
        hold perr = 1
        hold permsg = referror
      }
    }

    // ================= hold NAME = RHS =================
    when act == 1 {
      hold declk = -1
      hold declt = ""
      // bare push(xs, v): nm is already set and pos sits on `push`
      when bpush == 0 {
        when asmode == 0 {
          hold pos = pos + 4
        }
        // blank skip
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // name
        hold nm = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sxsource_get(source_words,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm = concat(nm, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        // assignment target: an optional `.field` / `[index]` chain is
        // copied verbatim (a pure-min struct field or list element)
        hold sufx = ""
        hold srun = 1
        while srun == 1 {
          hold srun = 0
          when pos < n {
            hold sc = sxsource_get(source_words, pos)
            when sc == 46 {
              hold srun2 = 1
              while srun2 == 1 {
                when pos >= n {
                  hold srun2 = 0
                } otherwise {
                  hold sc = sxsource_get(source_words, pos)
                  when (sc >= 97 && sc <= 122) || (sc >= 65 && sc <= 90) || (sc >= 48 && sc <= 57) || sc == 95 || sc == 46 {
                    hold sufx = concat(sufx, chr(sc))
                    hold pos = pos + 1
                  } otherwise {
                    hold srun2 = 0
                  }
                }
              }
              hold srun = 1
            } otherwise {
              when sc == 91 {
                // `NAME[i] = v` becomes `NAME = sx_lset(NAME, i, v)`
                hold pos = pos + 1
                hold sbd = 0
                hold srun2 = 1
                while srun2 == 1 {
                  when pos >= n {
                    hold srun2 = 0
                  } otherwise {
                    hold sc = sxsource_get(source_words, pos)
                    when sc == 91 {
                      hold sbd = sbd + 1
                    }
                    when sc == 93 {
                      when sbd == 0 {
                        hold srun2 = 0
                      }
                      hold sbd = sbd - 1
                    }
                    when srun2 == 1 {
                      hold lidx = concat(lidx, chr(sc))
                      hold pos = pos + 1
                    }
                  }
                }
                when pos < n {
                  hold pos = pos + 1
                }
                hold liset = 1
                hold srun = 1
              }
            }
          }
        }
        // optional `: TYPE` annotation (full language): the declared kind
        // is checked against the value's kind below
        hold pc = 0
        when pos < n {
          hold pc = sxsource_get(source_words,pos)
        }
        when pc == 58 {
          hold pos = pos + 1
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold declt = ""
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when (cs >= 97 && cs <= 122) || (cs >= 65 && cs <= 90) || (cs >= 48 && cs <= 57) || cs == 95 {
                hold declt = concat(declt, chr(cs))
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
          hold dtok2 = 0
          when sx_eq(declt, "str") || sx_eq(declt, "string") {
            hold declk = 1
            hold dtok2 = 1
          }
          when sx_eq(declt, "list") {
            hold declk = 2
            hold dtok2 = 1
          }
          when sx_eq(declt, "num") || sx_eq(declt, "number") || sx_eq(declt, "bool") || sx_eq(declt, "double") {
            hold declk = 0
            hold dtok2 = 1
          }
          when dtok2 == 0 {
            // a struct type name
            hold declk = 3
          }
          hold sk = 1
          while sk == 1 {
            when pos >= n {
              hold sk = 0
            } otherwise {
              hold cs = sxsource_get(source_words,pos)
              when cs == 32 || cs == 9 || cs == 13 {
                hold pos = pos + 1
              } otherwise {
                hold sk = 0
              }
            }
          }
        }
        // blanks then '=' (or a compound operator: `+= -= *= /= %=`)
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              when cs == 61 {
                hold pos = pos + 1
              } otherwise {
                hold cs2 = 0
                when pos + 1 < n {
                  hold cs2 = sxsource_get(source_words,pos + 1)
                }
                when cs2 == 61 {
                  when cs == 43 || cs == 45 || cs == 42 || cs == 47 || cs == 37 {
                    hold cmpop = cs
                    hold pos = pos + 2
                  }
                }
              }
              hold sk = 0
            }
          }
        }
        // blanks after the assignment operator
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        // a compound assignment always targets an existing variable, and
        // the operator itself decides the kind (num vs str) so the shared
        // compound emit below can build `x = x op EXPR`
        when cmpop != 0 {
          hold found2 = 0
          hold k2 = concat("|", nm)
          hold k2 = concat(k2, "|")
          hold d2i = 0
          hold d2l = len(decls)
          hold k2l = len(k2)
          while d2i + k2l <= d2l {
            hold ok2 = 1
            hold j2 = 0
            while j2 < k2l {
              hold aa2 = sx_index(decls, d2i + j2)
              hold bb2 = sx_index(k2, j2)
              when aa2 == bb2 {
                hold j2 = j2 + 1
              } otherwise {
                hold ok2 = 0
                hold j2 = k2l
              }
            }
            when ok2 == 1 {
              hold found2 = 1
              hold d2i = d2l
            } otherwise {
              hold d2i = d2i + 1
            }
          }
          when found2 == 0 {
            hold nerrscop = 1
            when sx_eq(scopmsg, "") {
              hold scopmsg = concat("compound assignment to undeclared '", nm)
              hold scopmsg = concat(scopmsg, "'; declare it with hold first")
            }
          }
        }
        // blanks
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
      }

      // ---------- right hand side ----------
      hold rhs = ""
      hold rk = 0
      hold c1 = 0
      when pos < n {
        hold c1 = sxsource_get(source_words,pos)
      }


      // Numeric/string comparison values also belong in field/element stores.
      // Keep the existing checked LHS parser and lower just its scalar RHS.
      when bpush == 0 && (len(sufx) > 0 || liset == 1) {
        hold store_end = pos
        hold store_text = ""
        hold store_quote = 0
        hold store_braces = 0
        hold store_run = 1
        while store_end < n && store_run == 1 {
          hold store_char = sxsource_get(source_words, store_end)
          when store_quote == 1 {
            store_text = concat(store_text, chr(store_char))
            store_end = store_end + 1
            when store_char == 92 && store_end < n {
              store_text = concat(store_text, chr(sxsource_get(source_words, store_end)))
              store_end = store_end + 1
            } otherwise { when store_char == 34 { store_quote = 0 } }
          } otherwise {
            when store_char == 10 || store_char == 13 || (store_char == 125 && store_braces == 0) || (store_char == 47 && store_end + 1 < n && sxsource_get(source_words, store_end + 1) == 47) {
              store_run = 0
            } otherwise {
              when store_char == 34 { store_quote = 1 }
              when store_char == 123 { store_braces = store_braces + 1 }
              when store_char == 125 { store_braces = store_braces - 1 }
              store_text = concat(store_text, chr(store_char))
              store_end = store_end + 1
            }
          }
        }
        when sxseed_has_comparison(store_text) {
          hold store_private = inprivate
          when inready == 0 {
            when len(condition_private) == 0 {
              condition_private = inprivate
              while sxecontains(source, condition_private) { condition_private = concat(condition_private, "x") }
            }
            store_private = condition_private
          }
          hold store_first = len(instate)
          hold store_env = sxseed_env(decls, sdecls, ldecls, svars, fsret, fspk, ftypes, store_private)
          hold store_value = sxeparse(store_text, 0, store_env, 0, 0, instate)
          hold store_kind = sxesegment(store_value, 1)
          when (sx_eq(store_kind, "n") || sx_eq(store_kind, "s")) && sxflowspace(store_text, sxepos(store_value)) == len(store_text) {
            rhs = sxecode(store_value)
            rk = 0
            when sx_eq(store_kind, "s") { rk = 1 }
            pos = store_end
            c1 = 0
            fully_checked_value = 1
            fully_checked_kind = store_kind
            rt = 1
            when len(instate) > store_first || sxecontains(rhs, concat(store_private, "list(")) {
              inprivate = store_private
              when inready == 0 {
                inready = 1
                fsret = concat(fsret, concat(inprivate, "list=l|"))
              }
              lt = 1
              while store_first < len(instate) {
                body = concat(body, concat("  double ", concat(inprivate, concat(sxedigits(store_first), ";\n"))))
                store_first = store_first + 1
              }
            }
          }
        }
      }

      // RHS: string literal
      when c1 == 34 {
        hold pos = pos + 1
        hold rhs = q
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cq = sxsource_get(source_words,pos)
            when cq == 34 {
              hold pos = pos + 1
              hold rhs = concat(rhs, q)
              hold rn = 0
            } otherwise {
              when cq == 92 {
                // backslash escapes the next char: keep BOTH, so \"
                // does not terminate the literal
                hold rhs = concat(rhs, bs)
                hold pos = pos + 1
                when pos < n {
                  hold cq2 = sxsource_get(source_words,pos)
                  hold rhs = concat(rhs, chr(cq2))
                  hold pos = pos + 1
                }
              } otherwise {
                hold rhs = concat(rhs, chr(cq))
                hold pos = pos + 1
              }
            }
          }
        }
        hold rk = 1
        hold rt = 1
      }


      // list literal [e, e, ...]
      when c1 == 91 {
        hold pos = pos + 1
        hold lelems = ""
        hold nels = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sxsource_get(source_words,pos)
          when cs != 93 {
            hold lr = 1
            while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sxsource_get(source_words,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              hold el = ""
              hold ec = 0
              when pos < n {
                hold ec = sxsource_get(source_words,pos)
              }
              when (ec >= 48 && ec <= 57) || ec == 45 {
                when ec == 45 {
                  hold el = "-"
                  hold pos = pos + 1
                }
                hold rn = 1
                while rn == 1 {
                  when pos >= n {
                    hold rn = 0
                  } otherwise {
                    hold cd = sxsource_get(source_words,pos)
                    // a `.` followed by a digit continues the number (2.5)
                    hold cdn = 0
                    when pos + 1 < n {
                      hold cdn = sxsource_get(source_words,pos + 1)
                    }
                    when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                      hold el = concat(el, chr(cd))
                      hold pos = pos + 1
                    } otherwise {
                      hold rn = 0
                    }
                  }
                }
              } otherwise {
                when (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) {
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sxsource_get(source_words,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold el = concat(el, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                }
              }
              // list elements are numbers: a string, list or struct variable
              // (or anything that is not a number or a name) is a clear error
              // instead of invalid C such as sx_llit(1,(double)(p))
              hold lbad = 0
              // an element may be an expression (a + 1, 2 * x, (a - 1)): gather
              // the text up to a top-level , or ] ; [ " { } are not allowed in it
              hold exd = 0
              hold exr = 1
              while exr == 1 {
                when pos >= n {
                  hold exr = 0
                } otherwise {
                  hold exc = sxsource_get(source_words,pos)
                  when (exc == 44 || exc == 93) && exd == 0 {
                    hold exr = 0
                  } otherwise {
                    when exc == 10 {
                      hold exr = 0
                    } otherwise {
                      when exc == 91 || exc == 34 || exc == 123 || exc == 125 {
                        hold lbad = 1
                      }
                      when exc == 40 {
                        hold exd = exd + 1
                      }
                      when exc == 41 {
                        hold exd = exd - 1
                      }
                      hold el = concat(el, chr(exc))
                      hold pos = pos + 1
                    }
                  }
                }
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "|")
              hold psrc = concat(sdecls, ldecls)
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              hold pexpr = concat("|", el)
              hold pexpr = concat(pexpr, "=")
              hold psrc = svars
              hold pkey = pexpr
              hold pfound = 0
              hold pi2 = 0
              hold pa2 = len(psrc)
              hold pb2 = len(pkey)
              while pi2 + pb2 <= pa2 {
                hold pok2 = 1
                hold pj2 = 0
                while pj2 < pb2 {
                  hold pa3 = sx_index(psrc, pi2 + pj2)
                  hold pb3 = sx_index(pkey, pj2)
                  when pa3 == pb3 {
                    hold pj2 = pj2 + 1
                  } otherwise {
                    hold pok2 = 0
                    hold pj2 = pb2
                  }
                }
                when pok2 == 1 {
                  hold pfound = 1
                  hold pi2 = pa2
                } otherwise {
                  hold pi2 = pi2 + 1
                }
              }
              when pfound == 1 {
                hold lbad = 1
              }
              when sx_eq(el, "") {
                hold lbad = 1
              }
              when lbad == 1 {
                when perr == 0 {
                  hold permsg = "list elements must be numbers or numeric variables (a list cannot hold a string, list or struct)"
                }
                hold perr = 1
              }
              when nels > 0 {
                hold lelems = concat(lelems, ",")
              }
              hold lelems = concat(lelems, "(double)(")
              hold lelems = concat(lelems, el)
              hold lelems = concat(lelems, ")")
              hold nels = nels + 1
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sxsource_get(source_words,pos)
                  when cs == 32 || cs == 9 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos < n {
                hold cs = sxsource_get(source_words,pos)
                when cs == 44 {
                  hold pos = pos + 1
                } otherwise {
                  hold lr = 0
                }
              } otherwise {
                hold lr = 0
              }
            }
          }
        }
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        when pos < n {
          hold cs = sxsource_get(source_words,pos)
          when cs == 93 {
            hold pos = pos + 1
          }
        }
        // the element count in decimal (chr(48 + nels) broke at 10 elements)
        hold lnum = nels
        hold lcount = ""
        when lnum == 0 {
          hold lcount = "0"
        }
        while lnum > 0 {
          hold ldig = lnum % 10
          hold ltmp = chr(48 + ldig)
          hold lcount = concat(ltmp, lcount)
          hold lnum = lnum - ldig
          hold lnum = lnum / 10
        }
        hold rhs = "sx_llit("
        hold rhs = concat(rhs, lcount)
        when nels > 0 {
          hold rhs = concat(rhs, ",")
          hold rhs = concat(rhs, lelems)
        }
        hold rhs = concat(rhs, ")")
        hold rk = 2
        hold lt = 1
      }

      // RHS: number
      when (c1 >= 48 && c1 <= 57) || c1 == 45 {
        hold numtxt = ""
        when c1 == 45 {
          hold numtxt = "-"
          hold pos = pos + 1
        }
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cd = sxsource_get(source_words,pos)
            // a `.` followed by a digit continues the number (2.5)
            hold cdn = 0
            when pos + 1 < n {
              hold cdn = sxsource_get(source_words,pos + 1)
            }
            when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
              hold numtxt = concat(numtxt, chr(cd))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold rhs = numtxt
        hold rk = 0
      }

      // RHS: name, name + number, or call(...)
      when (c1 >= 97 && c1 <= 122) || (c1 >= 65 && c1 <= 90) || c1 == 95 {
        hold fieldbaseat = pos
        hold nm2 = ""
        hold rn = 1
        while rn == 1 {
          when pos >= n {
            hold rn = 0
          } otherwise {
            hold cn = sxsource_get(source_words,pos)
            when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
              hold nm2 = concat(nm2, chr(cn))
              hold pos = pos + 1
            } otherwise {
              hold rn = 0
            }
          }
        }
        hold iscall = 0
        hold sk = 1
        while sk == 1 {
          when pos >= n {
            hold sk = 0
          } otherwise {
            hold cs = sxsource_get(source_words,pos)
            when cs == 32 || cs == 9 || cs == 13 || cs == 10 {
              hold pos = pos + 1
            } otherwise {
              hold sk = 0
            }
          }
        }
        hold c2 = 0
        when pos < n {
          hold c2 = sxsource_get(source_words,pos)
        }
        when c2 == 40 {
          hold iscall = 1
        }

        // ---- struct literal Name { vals } ----
        when c2 == 123 {
          // is nm2 a known struct?
          hold sfind2 = 0
          hold di = 0
          hold dl = len(sdefs)
          hold kl = len(nm2)
          while di < dl {
            hold ok = 1
            hold j = 0
            while j < kl {
              when di + j >= dl {
                hold ok = 0
                hold j = kl
              } otherwise {
                hold aa = sx_index(sdefs, di + j)
                hold bb = sx_index(nm2, j)
                when aa == bb {
                  hold j = j + 1
                } otherwise {
                  hold ok = 0
                  hold j = kl
                }
              }
            }
            when ok == 1 {
              when di + kl < dl {
                hold aa = sx_index(sdefs, di + kl)
                when aa == 58 {
                  hold sfind2 = 1
                  hold sfpos = di
                  hold di = dl
                } otherwise {
                  hold di = di + 1
                }
              } otherwise {
                hold di = di + 1
              }
            } otherwise {
              hold di = di + 1
            }
          }
          when sfind2 == 1 {
            hold pos = pos + 1
            hold lelems = ""
            hold nels = 0
            // Field names are walked in sdefs order (fpos..): each value must
            // be given in declaration order, a label (if present) must name
            hold fpos = sfpos + kl + 1
            hold fnf = 1
            hold fscan = fpos
            hold fsn = len(sdefs)
            hold frun = 1
            while frun == 1 {
              when fscan >= fsn {
                hold frun = 0
              } otherwise {
                hold fc = sx_index(sdefs, fscan)
                when fc == 59 {
                  hold frun = 0
                } otherwise {
                  when fc == 44 {
                    hold fnf = fnf + 1
                  }
                  hold fscan = fscan + 1
                }
              }
            }
            hold lr = 1
            while lr == 1 {
              // The walk re-enters itself for nested struct literals: each
              // `Name { ... }` value pushes this level's state on nstack and
              hold lr = 1
              while lr == 1 {
              hold sk = 1
              while sk == 1 {
                when pos >= n {
                  hold sk = 0
                } otherwise {
                  hold cs = sxsource_get(source_words,pos)
                  when cs == 32 || cs == 9 || cs == 13 || cs == 10 || cs == 44 {
                    hold pos = pos + 1
                  } otherwise {
                    hold sk = 0
                  }
                }
              }
              when pos >= n {
                hold lr = 0
              } otherwise {
                hold cs = sxsource_get(source_words,pos)
                hold savep2 = pos
                when cs == 125 {
                  hold pos = pos + 1
                  hold lr = 0
                } otherwise {
                  // ---- optional field label ----
                  hold lb = ""
                  hold rn = 1
                  while rn == 1 {
                    when pos >= n {
                      hold rn = 0
                    } otherwise {
                      hold cn = sxsource_get(source_words,pos)
                      when (cn >= 97 && cn <= 122) || (cn >= 65 && cn <= 90) || (cn >= 48 && cn <= 57) || cn == 95 {
                        hold lb = concat(lb, chr(cn))
                        hold pos = pos + 1
                      } otherwise {
                        hold rn = 0
                      }
                    }
                  }
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sxsource_get(source_words,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold lbl = 0
                  when pos < n {
                    hold cs2 = sxsource_get(source_words,pos)
                    when cs2 == 58 {
                      hold pos = pos + 1
                      hold lbl = 1
                    }
                  }
                  when lbl == 0 {
                    // no label: what was read is the value itself
                    hold pos = savep2
                  }
                  // ---- the field this value has to fill ----
                  hold fname = ""
                  hold fkx = 0
                  hold fscan = fpos
                  hold frun = 1
                  while frun == 1 {
                    when fscan >= fsn {
                      hold frun = 0
                    } otherwise {
                      hold fc = sx_index(sdefs, fscan)
                      when fc == 44 || fc == 59 {
                        when fkx == nels {
                          hold frun = 0
                        } otherwise {
                          hold fkx = fkx + 1
                          hold fscan = fscan + 1
                        }
                      } otherwise {
                        when fkx == nels {
                          hold fname = concat(fname, chr(fc))
                        }
                        hold fscan = fscan + 1
                      }
                    }
                  }
                  when lbl == 1 {
                    when seed_profile == 1 {
                      hold named_fields_end = fpos
                      while named_fields_end < fsn && sx_index(sdefs, named_fields_end) != 59 { named_fields_end = named_fields_end + 1 }
                      hold named_fields = sxseed_slice(sdefs, fpos, named_fields_end)
                      when sxseed_csv_has(named_fields, lb) == 0 { hold exbad7 = 1 }
                      hold fname = lb
                    } otherwise {
                      hold lsame = sx_eq(lb, fname)
                      when lsame == 0 { hold exbad7 = 1 }
                    }
                  }
                  when seed_profile == 1 && sxseed_designator(lelems, fname) { hold exbad7 = 1 }
                  // ---- value: number, string literal or a name ----
                  hold el = ""
                  hold ety = 0
                  hold nmsvty = ""
                  hold isnest = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs2 = sxsource_get(source_words,pos)
                      when cs2 == 32 || cs2 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold ec = 0
                  when pos < n {
                    hold ec = sxsource_get(source_words,pos)
                  }
                  // A concrete list field is an sx_list pointer, never an
                  // inline numeric value.  Reuse the checked expression parser
                  // for both `[ ... ]` and a list-valued name/field path; that
                  // gives list literals the same numeric-element checking and
                  // left-to-right evaluation temporaries as ordinary lists.
                  hold fllist = 0
                  hold flexpr = 0
                  when ec == 91 || (ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90) || (ec >= 48 && ec <= 57) || ec == 40 || ec == 45 || ec == 34 {
                    hold flenv = concat(decls, chr(1))
                    hold flenv = concat(flenv, sdecls)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, ldecls)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, svars)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, fsret)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, fspk)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, inprivate)
                    hold flenv = concat(flenv, chr(1))
                    hold flenv = concat(flenv, ftypes)
                    hold flserial = len(instate)
                    hold flvalue = sxeparse(source, pos, flenv, 0, 0, instate)
                    hold flkind = sxesegment(flvalue, 1)
                    when sx_eq(flkind, "l") == 1 {
                      hold fllist = 1
                      hold ety = 3
                      hold el = sxecode(flvalue)
                      hold pos = sxepos(flvalue)
                      hold lt = 1
                      when inready == 0 {
                        while sxecontains(source, inprivate) == 1 {
                          hold inprivate = concat(inprivate, "x")
                        }
                        hold inready = 1
                        hold fsret = concat(fsret, inprivate)
                        hold fsret = concat(fsret, "list=l|")
                      }
                      // sxeparse records one temporary per literal element.
                      // Emit them in this scope before the containing struct
                      // declaration, then let later inline lowering continue
                      // from the next serial rather than redeclaring them.
                      hold flserialend = len(instate)
                      while flserial < flserialend {
                        hold body = concat(body, "  double ")
                        hold body = concat(body, inprivate)
                        hold body = concat(body, sxedigits(flserial))
                        hold body = concat(body, ";")
                        hold body = concat(body, nl)
                        hold flserial = flserial + 1
                      }
                    }
                    // ---- an EXPRESSION-valued field: `Size { bytes: len(s) + 1 }`
                    // The simple forms above (a number, a quoted string, a
                    // name, a nested literal) are left exactly as they were:
                    // the checked parser is only taken when it consumed more
                    // than the simple form AND the extra text starts with an
                    // operator or a call's '(' -- so `a.v` and `xs[0]` keep
                    // their existing refusals rather than changing meaning.
                    when fllist == 0 {
                      // NOTE: every sibling block below needs its OWN loop
                      // and character names. Reusing one name across two
                      // sibling blocks makes gen2 emit an assignment without
                      // a declaration, and gen2.c then fails to compile.
                      hold flse = pos
                      when ec >= 97 && ec <= 122 || ec >= 65 && ec <= 90 {
                        hold flruna = 1
                        while flruna == 1 {
                          when flse >= n {
                            hold flruna = 0
                          } otherwise {
                            hold flca = sxsource_get(source_words, flse)
                            when (flca >= 97 && flca <= 122) || (flca >= 65 && flca <= 90) || (flca >= 48 && flca <= 57) || flca == 95 {
                              hold flse = flse + 1
                            } otherwise {
                              hold flruna = 0
                            }
                          }
                        }
                      }
                      when (ec >= 48 && ec <= 57) || ec == 45 {
                        when ec == 45 {
                          hold flse = flse + 1
                        }
                        hold flrunb = 1
                        while flrunb == 1 {
                          when flse >= n {
                            hold flrunb = 0
                          } otherwise {
                            hold flcb = sxsource_get(source_words, flse)
                            hold flcb2 = 0
                            when flse + 1 < n {
                              hold flcb2 = sxsource_get(source_words, flse + 1)
                            }
                            when (flcb >= 48 && flcb <= 57) || (flcb == 46 && flcb2 >= 48 && flcb2 <= 57) {
                              hold flse = flse + 1
                            } otherwise {
                              hold flrunb = 0
                            }
                          }
                        }
                      }
                      when ec == 34 {
                        hold flse = flse + 1
                        hold flrunc = 1
                        while flrunc == 1 {
                          when flse >= n {
                            hold flrunc = 0
                          } otherwise {
                            hold flcc = sxsource_get(source_words, flse)
                            when flcc == 92 {
                              hold flse = flse + 2
                            } otherwise {
                              hold flse = flse + 1
                              when flcc == 34 {
                                hold flrunc = 0
                              }
                            }
                          }
                        }
                      }
                      hold flsp = flse
                      hold flrund = 1
                      while flrund == 1 {
                        when flsp >= n {
                          hold flrund = 0
                        } otherwise {
                          hold flcd = sxsource_get(source_words, flsp)
                          when flcd == 32 || flcd == 9 {
                            hold flsp = flsp + 1
                          } otherwise {
                            hold flrund = 0
                          }
                        }
                      }
                      hold flnc = 0
                      when flsp < n {
                        hold flnc = sxsource_get(source_words, flsp)
                      }
                      hold flmore = 0
                      when flnc == 43 || flnc == 45 || flnc == 42 || flnc == 47 || flnc == 37 || flnc == 40 {
                        hold flmore = 1
                      }
                      when ec == 40 {
                        hold flmore = 1
                      }
                      // The seed accepted field/index expressions in literals;
                      // retain the later mini-compiler profile's refusal.
                      when seed_profile == 1 && (flnc == 46 || flnc == 91) {
                        hold flmore = 1
                      }
                      when flmore == 1 {
                        when sx_eq(flkind, "n") == 1 || sx_eq(flkind, "s") == 1 {
                          hold flexpr = 1
                          // the lowered code may call sx_len/sx_cat/...; the
                          // full runtime preamble has to be emitted for it
                          hold rt = 1
                          hold ety = 0
                          when sx_eq(flkind, "s") == 1 {
                            hold ety = 1
                          }
                          hold el = sxecode(flvalue)
                          hold pos = sxepos(flvalue)
                          // a list literal inside the expression records
                          // temporaries; declare them before this statement
                          hold flserialend2 = len(instate)
                          while flserial < flserialend2 {
                            hold body = concat(body, "  double ")
                            hold body = concat(body, inprivate)
                            hold body = concat(body, sxedigits(flserial))
                            hold body = concat(body, ";")
                            hold body = concat(body, nl)
                            hold flserial = flserial + 1
                          }
                        }
                      }
                    }
                  }
                  when ((ec >= 48 && ec <= 57) || ec == 45) && flexpr == 0 {
                    when ec == 45 {
                      hold el = "-"
                      hold pos = pos + 1
                    }
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sxsource_get(source_words,pos)
                        // a `.` followed by a digit continues the number (2.5)
                        hold cdn = 0
                        when pos + 1 < n {
                          hold cdn = sxsource_get(source_words,pos + 1)
                        }
                        when (cd >= 48 && cd <= 57) || (cd == 46 && cdn >= 48 && cdn <= 57) {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                  }
                  // string literal value (escapes kept)
                  when ec == 34 && flexpr == 0 {
                    hold ety = 1
                    hold pos = pos + 1
                    hold el = q
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sxsource_get(source_words,pos)
                        when cd == 34 {
                          hold pos = pos + 1
                          hold el = concat(el, q)
                          hold rn = 0
                        } otherwise {
                          when cd == 92 {
                            hold el = concat(el, bs)
                            hold pos = pos + 1
                            when pos < n {
                              hold cd2 = sxsource_get(source_words,pos)
                              hold el = concat(el, chr(cd2))
                              hold pos = pos + 1
                            }
                          } otherwise {
                            hold el = concat(el, chr(cd))
                            hold pos = pos + 1
                          }
                        }
                      }
                    }
                  }
                  // name value: a name tracked as a string is a string
                  when ((ec >= 97 && ec <= 122) || (ec >= 65 && ec <= 90)) && fllist == 0 && flexpr == 0 {
                    hold el = ""
                    hold rn = 1
                    while rn == 1 {
                      when pos >= n {
                        hold rn = 0
                      } otherwise {
                        hold cd = sxsource_get(source_words,pos)
                        when (cd >= 97 && cd <= 122) || (cd >= 65 && cd <= 90) || (cd >= 48 && cd <= 57) || cd == 95 {
                          hold el = concat(el, chr(cd))
                          hold pos = pos + 1
                        } otherwise {
                          hold rn = 0
                        }
                      }
                    }
                    hold ety = 0
                    hold nkey = concat("|", el)
                    hold nkey = concat(nkey, "|")
                    hold ndi = 0
                    hold ndl = len(sdecls)
                    hold nkl = len(nkey)
                    while ndi + nkl <= ndl {
                      hold nok = 1
                      hold nj = 0
                      while nj < nkl {
                        hold naa = sx_index(sdecls, ndi + nj)
                        hold nbb = sx_index(nkey, nj)
                        when naa == nbb {
                          hold nj = nj + 1
                        } otherwise {
                          hold nok = 0
                          hold nj = nkl
                        }
                      }
                      when nok == 1 {
                        hold ety = 1
                        hold ndi = ndl
                      } otherwise {
                        hold ndi = ndi + 1
                      }
                    }
                    // a name tracked as a struct makes this field a struct
                    // field of that struct's type: `hold o = Outer { i }` is
                    // the same field kind a nested literal would record, and
                    // the C it emits is the ordinary struct copy `(Outer){i}`
                    hold nsvkey = concat("|", el)
                    hold nsvkey = concat(nsvkey, "=")
                    hold nsvkl = len(nsvkey)
                    hold nsvl = len(svars)
                    hold nsvi = 0
                    while nsvi + nsvkl <= nsvl {
                      hold nsvok = 1
                      hold nsvj = 0
                      while nsvj < nsvkl {
                        hold nsvaa = sx_index(svars, nsvi + nsvj)
                        hold nsvbb = sx_index(nsvkey, nsvj)
                        when nsvaa == nsvbb {
                          hold nsvj = nsvj + 1
                        } otherwise {
                          hold nsvok = 0
                          hold nsvj = nsvkl
                        }
                      }
                      when nsvok == 1 {
                        hold nsvq = nsvi + nsvkl
                        hold nsvrun = 1
                        while nsvrun == 1 {
                          when nsvq >= nsvl {
                            hold nsvrun = 0
                          } otherwise {
                            hold nsvc = sx_index(svars, nsvq)
                            when nsvc == 124 {
                              hold nsvrun = 0
                            } otherwise {
                              hold nmsvty = concat(nmsvty, chr(nsvc))
                              hold nsvq = nsvq + 1
                            }
                          }
                        }
                        hold nsvi = nsvl
                      } otherwise {
                        hold nsvi = nsvi + 1
                      }
                    }
                  }
                  // ---- nested struct literal value: Name { ... } ----
                  // When the value is a known struct name followed by '{',
                  hold etyname = ""
                  when len(nmsvty) > 0 {
                    hold ety = 2
                    hold etyname = nmsvty
                  }
                  hold pushed = 0
                  hold sk = 1
                  while sk == 1 {
                    when pos >= n {
                      hold sk = 0
                    } otherwise {
                      hold cs3 = sxsource_get(source_words,pos)
                      when cs3 == 32 || cs3 == 9 {
                        hold pos = pos + 1
                      } otherwise {
                        hold sk = 0
                      }
                    }
                  }
                  hold cs3 = 0
                  when pos < n {
                    hold cs3 = sxsource_get(source_words,pos)
                  }
                  when cs3 == 123 {
                    // is el a known struct?
                    hold sfind2 = 0
                    hold di = 0
                    hold dl = len(sdefs)
                    hold kl = len(el)
                    while di < dl {
                      hold ok = 1
                      hold j = 0
                      while j < kl {
                        when di + j >= dl {
                          hold ok = 0
                          hold j = kl
                        } otherwise {
                          hold aa = sx_index(sdefs, di + j)
                          hold bb = sx_index(el, j)
                          when aa == bb {
                            hold j = j + 1
                          } otherwise {
                            hold ok = 0
                            hold j = kl
                          }
                        }
                      }
                      when ok == 1 {
                        when di + kl < dl {
                          hold aa = sx_index(sdefs, di + kl)
                          when aa == 58 {
                            hold sfind2 = 1
                            hold sfposin = di
                            hold di = dl
                          } otherwise {
                            hold di = di + 1
                          }
                        } otherwise {
                          hold di = di + 1
                        }
                      } otherwise {
                        hold di = di + 1
                      }
                    }
                    hold doskip = 0
                    when sfind2 == 1 {
                      // dependency order: the nested struct must be declared
                      // before the struct that nests it (typedef order)
                      hold klnm2 = len(nm2)
                        hold sfposcur = fpos - klnm2 - 1
                      when sfposin > sfposcur {
                        hold nerrfwd = 1
                        hold nfwdin = el
                        hold nfwdout = nm2
                        hold doskip = 1
                      }
                    } otherwise {
                      // Name { with an unknown struct name: clear error,
                      // skip the balanced span so the outer walk stays in
                      // sync and no follow-up errors are reported
                      hold nerrunk = 1
                      hold nunknm = el
                      hold doskip = 1
                    }
                    when doskip == 1 {
                      hold isnest = 1
                      hold nst = 1
                      hold ins = 0
                      hold pos = pos + 1
                      while nst > 0 {
                        when pos >= n {
                          hold nst = 0
                        } otherwise {
                          hold cd3 = sxsource_get(source_words,pos)
                          when ins == 1 {
                            when cd3 == 92 {
                              hold pos = pos + 1
                            } otherwise {
                              when cd3 == 34 {
                                hold ins = 0
                              }
                            }
                          } otherwise {
                            when cd3 == 34 {
                              hold ins = 1
                            } otherwise {
                              when cd3 == 123 {
                                hold nst = nst + 1
                              } otherwise {
                                when cd3 == 125 {
                                  hold nst = nst - 1
                                }
                              }
                            }
                          }
                          hold pos = pos + 1
                        }
                      }
                    } otherwise {
                      // push this level's frame (nm2, lelems, nels) and
                      // re-enter the walk for the inner struct
                      hold pushed = 1
                      hold dtext = ""
                      hold dd = nels
                      when dd == 0 {
                        hold dtext = "0"
                      }
                      hold drun = 1
                      while drun == 1 {
                        when dd <= 0 {
                          hold drun = 0
                        } otherwise {
                          hold drem = dd % 10
                          hold dtext = concat(chr(48 + drem), dtext)
                          hold dd = dd - drem
                          hold dd = dd / 10
                        }
                      }
                      when seed_profile == 1 {
                        when nels > 0 { hold lelems = concat(lelems, ",") }
                        hold lelems = concat(lelems, concat(".", concat(fname, "=")))
                      }
                      hold nstack = concat(nstack, nm2)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, lelems)
                      hold nstack = concat(nstack, nsep)
                      hold nstack = concat(nstack, dtext)
                      hold nstack = concat(nstack, nsep)
                      hold nm2 = el
                      hold el = ""
                      hold lelems = ""
                      hold nels = 0
                      hold klnm2 = len(nm2)
                      hold fpos = sfposin + klnm2 + 1
                      hold fnf = 1
                      hold fscan = fpos
                      hold fsn = len(sdefs)
                      hold frun = 1
                      while frun == 1 {
                        when fscan >= fsn {
                          hold frun = 0
                        } otherwise {
                          hold fc = sx_index(sdefs, fscan)
                          when fc == 59 {
                            hold frun = 0
                          } otherwise {
                            when fc == 44 {
                              hold fnf = fnf + 1
                            }
                            hold fscan = fscan + 1
                          }
                        }
                      }
                      hold pos = pos + 1
                    }
                  }
                  when pushed == 0 {
                  // ---- record the field type: the first literal wins ----
                  hold fkey = concat("|", nm2)
                  hold fkey = concat(fkey, ".")
                  hold fkey = concat(fkey, fname)
                  hold fkey = concat(fkey, "=")
                  hold fk2 = len(fkey)
                  hold fl2 = len(ftypes)
                  hold fprv = -1
                  hold fpname = ""
                  hold fsp = 0
                  while fsp + fk2 < fl2 {
                    hold feq = 1
                    hold fj = 0
                    while fj < fk2 {
                      hold faa = sx_index(ftypes, fsp + fj)
                      hold fbb = sx_index(fkey, fj)
                      when faa == fbb {
                        hold fj = fj + 1
                      } otherwise {
                        hold feq = 0
                        hold fj = fk2
                      }
                    }
                    when feq == 1 {
                      hold fpk = sx_index(ftypes, fsp + fk2)
                      when fpk == 49 {
                        hold fprv = 1
                      } otherwise {
                        when fpk == 50 {
                          hold fprv = 2
                          hold fsq = fsp + fk2 + 2
                          hold frq = 1
                          while frq == 1 {
                            when fsq >= fl2 {
                              hold frq = 0
                            } otherwise {
                              hold fcq = sx_index(ftypes, fsq)
                              when fcq == 124 {
                                hold frq = 0
                              } otherwise {
                                hold fpname = concat(fpname, chr(fcq))
                                hold fsq = fsq + 1
                              }
                            }
                          }
                        } otherwise {
                          when fpk == 51 {
                            hold fprv = 3
                          } otherwise {
                            hold fprv = 0
                          }
                        }
                      }
                      hold fsp = fl2
                    } otherwise {
                      hold fsp = fsp + 1
                    }
                  }
                  hold fnamelen = len(fname)
                  when (fnamelen > 0) && (isnest == 0) {
                    when len(seed_generic_error) == 0 {
                      seed_generic_error = sxseed_generic_literal(seed_generic_types, nm2, fname, ety, etyname)
                    }
                    when fprv == -1 {
                      hold ftypes = concat(ftypes, fkey)
                      when ety == 2 {
                        hold ftypes = concat(ftypes, "2:")
                        hold ftypes = concat(ftypes, etyname)
                        hold ftypes = concat(ftypes, "|")
                      } otherwise {
                        when ety == 3 {
                          hold ftypes = concat(ftypes, "3|")
                        } otherwise {
                          when ety == 1 {
                            hold ftypes = concat(ftypes, "1|")
                          } otherwise {
                            hold ftypes = concat(ftypes, "0|")
                          }
                        }
                      }
                    } otherwise {
                      when fprv != ety {
                        hold exbad6 = 1
                      }
                      when ety == 2 {
                        when fprv == 2 {
                          hold sames = sx_eq(fpname, etyname)
                          when sames == 0 {
                            hold exbad6 = 1
                          }
                        }
                      }
                    }
                    when ety == 1 {
                      // `varname.field` reads as a string from now on
                      // (only for the struct the variable itself is)
                      when sx_eq(nstack, "") == 1 {
                        hold sfnew = concat("|", nm)
                        hold sfnew = concat(sfnew, ".")
                        hold sfnew = concat(sfnew, fname)
                        hold sfnew = concat(sfnew, "|")
                        hold sflds = concat(sflds, sfnew)
                      }
                    }
                  }
                  when nels > 0 {
                    hold lelems = concat(lelems, ",")
                  }
                  when seed_profile == 1 { hold lelems = concat(lelems, concat(".", concat(fname, "="))) }
                  hold lelems = concat(lelems, el)
                  hold nels = nels + 1
                  // progress guard: a value must consume at least one char
                  when pos == savep2 {
                    hold exbad = 1
                    hold pos = pos + 1
                  }
                  }
                }
              }
              }
              when nels != fnf {
                hold exbad8 = 1
              }
              // text of the literal at this level
              hold lvtxt = "(("
              hold lvtxt = concat(lvtxt, nm2)
              hold lvtxt = concat(lvtxt, "){")
              hold lvtxt = concat(lvtxt, lelems)
              hold lvtxt = concat(lvtxt, "})")
              when sx_eq(nstack, "") == 0 {
                // this level was nested in another literal: pop the outer
                // frame, record the field type, append this level's text as
                // the value, and continue the outer walk
                hold slen = len(nstack)
                hold pi = slen - 1
                hold p2 = pi - 1
                hold p2stop = -1
                hold dt = ""
                while p2 >= 0 {
                  hold chdv = sx_index(nstack, p2)
                  when chdv >= 48 {
                    when chdv <= 57 {
                      hold dt = concat(chr(chdv), dt)
                      hold p2 = p2 - 1
                    } otherwise {
                      hold p2stop = p2
                      hold p2 = -1
                    }
                  } otherwise {
                    hold p2stop = p2
                    hold p2 = -1
                  }
                }
                hold o_nels = 0
                hold di2 = 0
                hold dl2 = len(dt)
                while di2 < dl2 {
                  hold chdv = sx_index(dt, di2)
                  hold chdv = chdv - 48
                  hold o_nels = o_nels * 10 + chdv
                  hold di2 = di2 + 1
                }
                hold p3 = p2stop - 1
                hold lt2 = ""
                hold p3stop = -1
                while p3 >= 0 {
                  hold chdv = sx_index(nstack, p3)
                  when chdv == 1 {
                    hold p3stop = p3
                    hold p3 = -1
                  } otherwise {
                    hold lt2 = concat(chr(chdv), lt2)
                    hold p3 = p3 - 1
                  }
                }
                hold p4 = p3stop - 1
                hold nt2 = ""
                hold p4stop = -1
                while p4 >= 0 {
                  hold chdv = sx_index(nstack, p4)
                  when chdv == 1 {
                    hold p4stop = p4
                    hold p4 = -1
                  } otherwise {
                    hold nt2 = concat(chr(chdv), nt2)
                    hold p4 = p4 - 1
                  }
                }
                // truncate the popped frame from the stack: keep everything
                // up to (and including) the separator that preceded it
                hold nn = ""
                hold di2 = 0
                while di2 <= p4stop {
                  hold nn = concat(nn, chr(sx_index(nstack, di2)))
                  hold di2 = di2 + 1
                }
                hold nstack = nn
                hold el = lvtxt
                hold ety = 2
                hold etyname = nm2
                hold nm2 = nt2
                hold lelems = lt2
                hold nels = o_nels
                // restore this level's field walk state
                hold sfind2 = 0
                hold di = 0
                hold dl = len(sdefs)
                hold kl = len(nm2)
                while di < dl {
                  hold ok = 1
                  hold j = 0
                  while j < kl {
                    when di + j >= dl {
                      hold ok = 0
                      hold j = kl
                    } otherwise {
                      hold aa = sx_index(sdefs, di + j)
                      hold bb = sx_index(nm2, j)
                      when aa == bb {
                        hold j = j + 1
                      } otherwise {
                        hold ok = 0
                        hold j = kl
                      }
                    }
                  }
                  when ok == 1 {
                    when di + kl < dl {
                      hold aa = sx_index(sdefs, di + kl)
                      when aa == 58 {
                        hold sfind2 = 1
                        hold sfposin = di
                        hold di = dl
                      } otherwise {
                        hold di = di + 1
                      }
                    } otherwise {
                      hold di = di + 1
                    }
                  } otherwise {
                    hold di = di + 1
                  }
                }
                when sfind2 == 1 {
                  hold fpos = sfposin + kl + 1
                } otherwise {
                  hold fpos = len(sdefs)
                }
                hold fnf = 1
                hold fscan = fpos
                hold fsn = len(sdefs)
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 59 {
                      hold frun = 0
                    } otherwise {
                      when fc == 44 {
                        hold fnf = fnf + 1
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                // the field this value fills (index nels)
                hold fname = ""
                hold fkx = 0
                hold fscan = fpos
                hold frun = 1
                while frun == 1 {
                  when fscan >= fsn {
                    hold frun = 0
                  } otherwise {
                    hold fc = sx_index(sdefs, fscan)
                    when fc == 44 || fc == 59 {
                      when fkx == nels {
                        hold frun = 0
                      } otherwise {
                        hold fkx = fkx + 1
                        hold fscan = fscan + 1
                      }
                    } otherwise {
                      when fkx == nels {
                        hold fname = concat(fname, chr(fc))
                      }
                      hold fscan = fscan + 1
                    }
                  }
                }
                when seed_profile == 1 { hold fname = sxseed_pending_field(lelems) }
                when len(seed_generic_error) == 0 {
                  seed_generic_error = sxseed_generic_literal(seed_generic_types, nm2, fname, 2, etyname)
                }
                // record |nm2.fname=2:etyname| (the first literal wins)
                hold fkey = concat("|", nm2)
                hold fkey = concat(fkey, ".")
                hold fkey = concat(fkey, fname)
                hold fkey = concat(fkey, "=")
                hold fk2 = len(fkey)
                hold fl2 = len(ftypes)
                hold fprv = -1
                hold fpname = ""
                hold fsp = 0
                while fsp + fk2 < fl2 {
                  hold feq = 1
                  hold fj = 0
                  while fj < fk2 {
                    hold faa = sx_index(ftypes, fsp + fj)
                    hold fbb = sx_index(fkey, fj)
                    when faa == fbb {
                      hold fj = fj + 1
                    } otherwise {
                      hold feq = 0
                      hold fj = fk2
                    }
                  }
                  when feq == 1 {
                    hold fpk = sx_index(ftypes, fsp + fk2)
                    when fpk == 49 {
                      hold fprv = 1
                    } otherwise {
                      when fpk == 50 {
                        hold fprv = 2
                        hold fsq = fsp + fk2 + 2
                        hold frq = 1
                        while frq == 1 {
                          when fsq >= fl2 {
                            hold frq = 0
                          } otherwise {
                            hold fcq = sx_index(ftypes, fsq)
                            when fcq == 124 {
                              hold frq = 0
                            } otherwise {
                              hold fpname = concat(fpname, chr(fcq))
                              hold fsq = fsq + 1
                            }
                          }
                        }
                      } otherwise {
                        when fpk == 51 {
                          hold fprv = 3
                        } otherwise {
                          hold fprv = 0
                        }
                      }
                    }
                    hold fsp = fl2
                  } otherwise {
                    hold fsp = fsp + 1
                  }
                }
                when fprv == -1 {
                  hold ftypes = concat(ftypes, fkey)
                  hold ftypes = concat(ftypes, "2:")
                  hold ftypes = concat(ftypes, etyname)
                  hold ftypes = concat(ftypes, "|")
                } otherwise {
                  when fprv != 2 {
                    hold exbad6 = 1
                  }
                  hold sames = sx_eq(fpname, etyname)
                  when sames == 0 {
                    hold exbad6 = 1
                  }
                }
                when nels > 0 && seed_profile == 0 {
                  hold lelems = concat(lelems, ",")
                }
                hold lelems = concat(lelems, el)
                hold nels = nels + 1
                hold lr = 1
              } otherwise {
                hold rhs = lvtxt
                hold rk = 3
                hold stname = nm2
                hold iscall = 2
              }
            }
          }
        }

        // ---- call(...) ----
        when iscall == 1 {
          hold pos = pos + 1
          hold argv_txt = ""
          hold inq = 0
          hold pdepth = 0
hold argbracket = 0
          hold rn = 1
          while rn == 1 {
            when pos >= n {
              hold rn = 0
            } otherwise {
              hold cn = sxsource_get(source_words,pos)
              when cn == 41 && inq == 0 && pdepth == 0 {
                hold rn = 0
              } otherwise {
                hold pos = pos + 1
                when inq == 1 {
                  hold argv_txt = concat(argv_txt, chr(cn))
                  when cn == 34 {
                    hold inq = 0
                  }
                  when cn == 92 {
                    when pos < n {
                      hold cq = sxsource_get(source_words,pos)
                      hold argv_txt = concat(argv_txt, chr(cq))
                      hold pos = pos + 1
                    }
                  }
                } otherwise {
                  when cn == 91 {
                    hold argbracket = argbracket + 1
                  }
                  when cn == 93 {
                    hold argbracket = argbracket - 1
                  }
                  when cn == 40 {
                    hold pdepth = pdepth + 1
                  }
                  when cn == 41 {
                    hold pdepth = pdepth - 1
                  }
                  when cn == 34 {
                    hold inq = 1
                    hold argv_txt = concat(argv_txt, chr(cn))
                  } otherwise {
                    when (cn == 32 || cn == 9) && argbracket == 0 {
                    } otherwise {
                      hold argv_txt = concat(argv_txt, chr(cn))
                    }
                  }
                }
              }
            }
          }
          hold pos = pos + 1
          // which builtin?
          // ---- '%' inside builtin-call argument text: sx_mod(L, R) ----
          hold axo = ""
          hold axi = 0
          hold axbracket = 0
          hold axn = len(argv_txt)
          hold axc = 0
          hold axq = 0
          hold axal = 0
          hold axrun = 0
          hold axd = 0
          hold axbd = 0
          hold axe = 0
          hold axri = 0
          hold axnb = 0
          hold axf = 0
          hold axg = 0
          hold axL = ""
          hold axR = ""
          hold axj = 0
          hold axP = ""
          while axi < axn {
            hold axc = sx_index(argv_txt, axi)
            when axc == 34 {
              // string literal: copy verbatim, escapes kept
              hold axo = concat(axo, chr(34))
              hold axi = axi + 1
              hold axq = 1
              while axq == 1 && axi < axn {
                hold axc = sx_index(argv_txt, axi)
                hold axo = concat(axo, chr(axc))
                hold axi = axi + 1
                when axc == 92 && axi < axn {
                  hold axo = concat(axo, chr(sx_index(argv_txt, axi)))
                  hold axi = axi + 1
                } otherwise {
                  when axc == 34 {
                    hold axq = 0
                  }
                }
              }
            } otherwise {
              when axc == 91 {
                hold axbracket = axbracket + 1
              }
              when axc == 93 {
                hold axbracket = axbracket - 1
              }
              when axc == 37 && axbracket == 0 {
                // left operand: scan back over the chain already in axo
                hold axal = len(axo)
                hold axrun = 1
                while axrun == 1 {
                  hold axrun = 0
                  when axal > 0 {
                    hold axd = sx_index(axo, axal - 1)
                    when axd == 41 || axd == 93 {
                      // skip a balanced (..) or [..] group, then keep going
                      hold axbd = 1
                      hold axal = axal - 1
                      while axbd > 0 {
                        when axal <= 0 {
                          hold axbd = 0
                        } otherwise {
                          hold axe = sx_index(axo, axal - 1)
                          when axe == 41 || axe == 93 {
                            hold axbd = axbd + 1
                          }
                          when axe == 40 || axe == 91 {
                            hold axbd = axbd - 1
                          }
                          hold axal = axal - 1
                        }
                      }
                      hold axrun = 1
                    } otherwise {
                      when (axd >= 97 && axd <= 122) || (axd >= 65 && axd <= 90) || (axd >= 48 && axd <= 57) || axd == 95 || axd == 46 || axd == 42 || axd == 47 {
                        hold axal = axal - 1
                        hold axrun = 1
                      }
                    }
                  }
                }
                // right operand: the next atom in argv_txt
                hold axri = axi + 1
                hold axnb = 1
                while axnb == 1 && axri < axn {
                  hold axnb = 0
                  hold axf = sx_index(argv_txt, axri)
                  when (axf >= 97 && axf <= 122) || (axf >= 65 && axf <= 90) || (axf >= 48 && axf <= 57) || axf == 95 || axf == 46 {
                    hold axri = axri + 1
                    hold axnb = 1
                  } otherwise {
                    when axf == 40 || axf == 91 {
                      hold axbd = 1
                      hold axri = axri + 1
                      while axbd > 0 && axri < axn {
                        hold axg = sx_index(argv_txt, axri)
                        when axg == 40 || axg == 91 {
                          hold axbd = axbd + 1
                        }
                        when axg == 41 || axg == 93 {
                          hold axbd = axbd - 1
                        }
                        hold axri = axri + 1
                      }
                      hold axnb = 1
                    }
                  }
                }
                // rebuild: the left chain is replaced by sx_mod(L, R)
                hold axL = ""
                hold axj = axal
                while axj < len(axo) {
                  hold axL = concat(axL, chr(sx_index(axo, axj)))
                  hold axj = axj + 1
                }
                hold axR = ""
                hold axj = axi + 1
                while axj < axri {
                  hold axR = concat(axR, chr(sx_index(argv_txt, axj)))
                  hold axj = axj + 1
                }
                hold axP = ""
                hold axj = 0
                while axj < axal {
                  hold axP = concat(axP, chr(sx_index(axo, axj)))
                  hold axj = axj + 1
                }
                hold axo = axP
                hold axo = concat(axo, "sx_mod(")
                hold axo = concat(axo, axL)
                hold axo = concat(axo, ",")
                hold axo = concat(axo, axR)
                hold axo = concat(axo, ")")
                hold axi = axri
              } otherwise {
                hold axo = concat(axo, chr(axc))
                hold axi = axi + 1
              }
            }
          }
          hold argv_txt = axo
          // Normalize builtin identifiers inside argument text for nested calls.
          hold argv_c = ""
          hold ai = 0
          hold al = len(argv_txt)
          hold arun = 1
          hold argv_q = 0
          while arun == 1 {
            when ai >= al {
              hold arun = 0
            } otherwise {
              hold ac = sx_index(argv_txt,ai)
              when argv_q == 1 {
                hold argv_c = concat(argv_c, chr(ac))
                when ac == 34 {
                  hold argv_q = 0
                }
                hold ai = ai + 1
              } otherwise {
              hold islet = 0
              when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || ac == 95 {
                hold islet = 1
              }
              when islet == 1 {
                hold atok = ""
                hold tokrun = 1
                while tokrun == 1 {
                  when ai >= al {
                    hold tokrun = 0
                  } otherwise {
                    hold ac = sx_index(argv_txt,ai)
                    when (ac >= 97 && ac <= 122) || (ac >= 65 && ac <= 90) || (ac >= 48 && ac <= 57) || ac == 95 {
                      hold atok = concat(atok, chr(ac))
                      hold ai = ai + 1
                    } otherwise {
                      hold tokrun = 0
                    }
                  }
                }
                // Only rewrite a builtin word when it is really a call: a
                // variable named `index`, `len`, `arg`, ... inside argument
                hold amap = 0
                hold acall = 0
                hold aix = ai
                hold ask = 1
                while ask == 1 {
                  when aix >= al {
                    hold ask = 0
                  } otherwise {
                    hold acx = sx_index(argv_txt, aix)
                    when acx == 32 || acx == 9 || acx == 13 {
                      hold aix = aix + 1
                    } otherwise {
                      hold ask = 0
                    }
                  }
                }
                when aix < al {
                  when sx_index(argv_txt, aix) == 40 {
                    hold acall = 1
                  }
                }
                when acall == 1 {
                  when sx_eq(atok, "concat") {
                    hold argv_c = concat(argv_c, "sx_cat")
                    hold amap = 1
                  }
                  when sx_eq(atok, "len") {
                    hold argv_c = concat(argv_c, "sx_len")
                    hold amap = 1
                  }
                  when sx_eq(atok, "sx_index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "index") {
                    hold argv_c = concat(argv_c, "sx_idx")
                    hold amap = 1
                  }
                  when sx_eq(atok, "chr") {
                    hold argv_c = concat(argv_c, "sx_chr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_file") {
                    hold argv_c = concat(argv_c, "sx_read")
                    hold amap = 1
                  }
                  when sx_eq(atok, "http_get") {
                    hold argv_c = concat(argv_c, "sx_http")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_file") {
                    hold argv_c = concat(argv_c, "sx_write")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg") {
                    hold argv_c = concat(argv_c, "sx_arg")
                    hold amap = 1
                  }
                  when sx_eq(atok, "arg_count") {
                    hold argv_c = concat(argv_c, "sx_argc")
                    hold amap = 1
                  }
                  when sx_eq(atok, "string_eq") {
                    hold argv_c = concat(argv_c, "sx_eq")
                    hold amap = 1
                  }
                  when sx_eq(atok, "push") {
                    hold argv_c = concat(argv_c, "sx_lpush")
                    hold amap = 1
                  }
                  when sx_eq(atok, "numstr") {
                    hold argv_c = concat(argv_c, "sx_numstr")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_line") {
                    hold argv_c = concat(argv_c, "sx_read_line")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_n") {
                    hold argv_c = concat(argv_c, "sx_read_n")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_dir") {
                    hold argv_c = concat(argv_c, "sx_read_dir")
                    hold amap = 1
                  }
                  when sx_eq(atok, "path_kind") {
                    hold argv_c = concat(argv_c, "sx_path_kind")
                    hold amap = 1
                  }
                  when sx_eq(atok, "path_size") {
                    hold argv_c = concat(argv_c, "sx_path_size")
                    hold amap = 1
                  }
                  when sx_eq(atok, "path_real") {
                    hold argv_c = concat(argv_c, "sx_path_real")
                    hold amap = 1
                  }
                  when sx_eq(atok, "run_command") {
                    hold argv_c = concat(argv_c, "sx_run_command")
                    hold amap = 1
                  }
                  when sx_eq(atok, "getenv") {
                    hold argv_c = concat(argv_c, "sx_getenv")
                    hold amap = 1
                  }
                  when sx_eq(atok, "spawn") {
                    hold argv_c = concat(argv_c, "sx_spawn")
                    hold amap = 1
                  }
                  when sx_eq(atok, "child_send") {
                    hold argv_c = concat(argv_c, "sx_child_send")
                    hold amap = 1
                  }
                  when sx_eq(atok, "child_recv") {
                    hold argv_c = concat(argv_c, "sx_child_recv")
                    hold amap = 1
                  }
                  when sx_eq(atok, "child_line") {
                    hold argv_c = concat(argv_c, "sx_child_line")
                    hold amap = 1
                  }
                  when sx_eq(atok, "child_close") {
                    hold argv_c = concat(argv_c, "sx_child_close")
                    hold amap = 1
                  }
                  when sx_eq(atok, "make_dir") {
                    hold argv_c = concat(argv_c, "sx_make_dir")
                    hold amap = 1
                  }
                  when sx_eq(atok, "make_link") {
                    hold argv_c = concat(argv_c, "sx_make_link")
                    hold amap = 1
                  }
                  when sx_eq(atok, "remove_path") {
                    hold argv_c = concat(argv_c, "sx_remove_path")
                    hold amap = 1
                  }
                  when sx_eq(atok, "write_bytes") {
                    hold argv_c = concat(argv_c, "sx_write_bytes")
                    hold amap = 1
                  }
                  when sx_eq(atok, "bytes_f64") {
                    hold argv_c = concat(argv_c, "sx_bytes_f64")
                    hold amap = 1
                  }
                  when sx_eq(atok, "read_bytes") {
                    hold argv_c = concat(argv_c, "sx_read_bytes")
                    hold amap = 1
                  }
                  when sx_eq(atok, "bit_and") {
                    hold argv_c = concat(argv_c, "sx_bit_and")
                    hold amap = 1
                  }
                  when sx_eq(atok, "bit_or") {
                    hold argv_c = concat(argv_c, "sx_bit_or")
                    hold amap = 1
                  }
                  when sx_eq(atok, "bit_xor") {
                    hold argv_c = concat(argv_c, "sx_bit_xor")
                    hold amap = 1
                  }
                  when sx_eq(atok, "bit_not") {
