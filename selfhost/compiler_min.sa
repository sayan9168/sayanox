          }
          when sx_eq(nm2, "write_bytes") || sx_eq(nm2, "sx_write_bytes") {
            hold fk = 34
          }
          when sx_eq(nm2, "bytes_f64") || sx_eq(nm2, "sx_bytes_f64") {
            hold fk = 35
          }
          when sx_eq(nm2, "read_bytes") || sx_eq(nm2, "sx_read_bytes") {
            hold fk = 42
          }
          when sx_eq(nm2, "bit_and") || sx_eq(nm2, "sx_bit_and") {
            hold fk = 36
          }
          when sx_eq(nm2, "bit_or") || sx_eq(nm2, "sx_bit_or") {
