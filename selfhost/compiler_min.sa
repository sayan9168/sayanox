              hold opnd = concat(opnd, ocarg)
              hold opnd = concat(opnd, ")")
              when ocstr == 1 {
                hold opfldstr = 1
                hold rt = 1
              }
              when oclist == 1 {
                hold lt = 1
              }
            }
            // postfix field chain .a.b (resolved like the statement bases)
            hold chn = 0

            hold chfields = ""
            hold chrun = 1
            while chrun == 1 {
              hold chrun = 0
              hold sk = 1
              while sk == 1 {
                when pos >= n {
