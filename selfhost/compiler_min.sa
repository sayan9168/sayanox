                      }
                      when ocx == 41 {
                        hold ocdepth = ocdepth - 1
                      }
                      when ocdepth == 0 {
                        hold pos = pos + 1
                        hold ocrun = 0
                      } otherwise {
                        hold ocarg = concat(ocarg, chr(ocx))
                        hold pos = pos + 1
                      }
                    }
                  }
                }
              }
              hold ocmap = ""
              hold ocstr = 0
              hold oclist = 0
              when sx_eq(nm3, "concat") || sx_eq(nm3, "sx_cat") {
                hold ocmap = "sx_cat"
                hold ocstr = 1
              }
              when sx_eq(nm3, "chr") || sx_eq(nm3, "sx_chr") {
