// stdlib/uword.sa -- word boundaries (Unicode UAX #29, prefix `uwb_`).
//
// Dependencies: import stdlib/utf8.sa and stdlib/uwidth.sa BEFORE this module.
// Like money.sa over decimal.sa this module names its dependencies' functions
// without importing them, because the module loader does not dedupe a diamond
// and a second import would declare every u8_ function twice.
//
// Why this exists. Grapheme clusters (stdlib/ugraph.sa) are the right unit for a
// reader and the wrong unit for a tokenizer: "don't" is three clusters and one
// word, "3.14" is four clusters and one number, a URL is one cluster run and
// still one word, and CJK text has no spaces at all, so only the standard's
// rules can say where a word ends. This module answers that with the same shape
// as the rest of the text layer: boundary offsets you can slice with.
//
// The rules implemented are WB1-WB999 of UAX #29 for Unicode 17.0.0:
//
//   WB3    CR x LF
//   WB3a/b nothing joins to or from Newline, CR or LF (except WB3)
//   WB3c   ZWJ x Extended_Pictographic
//   WB3d   WSegSpace x WSegSpace
//   WB4    Extend, Format and ZWJ attach to what precedes them, and the rules
//          below look past them on both sides -- which is why the engine keeps a
//          previous/next significant index per position instead of reformatting
//   WB5    AHLetter x AHLetter
//   WB6/7  AHLetter x (MidLetter|MidNumLet|Single_Quote) AHLetter, both sides
//   WB7a   Hebrew_Letter x Single_Quote
//   WB7b/c Hebrew_Letter x Double_Quote Hebrew_Letter, both sides
//   WB8-10 Numeric x Numeric, AHLetter x Numeric, Numeric x AHLetter
//   WB11/12 Numeric x (MidNum|MidNumLet|Single_Quote) Numeric, both sides
//   WB13   Katakana x Katakana
//   WB13a/b ExtendNumLet joins to AHLetter, Numeric and Katakana either way
//   WB15/16 regional indicators pair up, so four flags are two words
//   WB999  everywhere else
//
// Failure contract matches stdlib/ugraph.sa and stdlib/utext.sa: malformed UTF-8
// or text over uwb_max_cps() code points gives [] from a list function, -1 from
// a count and "" from a text function. uwb_count("") is 0 and valid.
//
// The tables below are generated from the Unicode 17.0.0 Character Database
// files themselves -- WordBreakProperty.txt and emoji/emoji-data.txt for
// Extended_Pictographic (WB3c) -- compressed to inclusive ranges, with adjacent
// ranges of one class merged, and searched by bisection. The gate does not take
// them on trust: the fixture reads those two data files, sorts and merges them
// itself and compares every element of both tables.
//
// Verification: selfhost/stdlib_uword_test.sa runs all 1944 cases of the
// official Unicode 17.0.0 WordBreakTest.txt, whose boundary marks are the
// expectation, and the table/API layer is checked against the same data files.

// Word_Break classes. Other is 0 so an untabulated scalar is Other.
make uwb_cls_other() -> num {
  give 0
}
make uwb_cls_cr() -> num {
  give 1
}
make uwb_cls_lf() -> num {
  give 2
}
make uwb_cls_newline() -> num {
  give 3
}
make uwb_cls_extend() -> num {
  give 4
}
make uwb_cls_zwj() -> num {
  give 5
}
make uwb_cls_ri() -> num {
  give 6
}
make uwb_cls_format() -> num {
  give 7
}
make uwb_cls_katakana() -> num {
  give 8
}
make uwb_cls_hebrew() -> num {
  give 9
}
make uwb_cls_aletter() -> num {
  give 10
}
make uwb_cls_single_quote() -> num {
  give 11
}
make uwb_cls_double_quote() -> num {
  give 12
}
make uwb_cls_midnumlet() -> num {
  give 13
}
make uwb_cls_midletter() -> num {
  give 14
}
make uwb_cls_midnum() -> num {
  give 15
}
make uwb_cls_numeric() -> num {
  give 16
}
make uwb_cls_extendnumlet() -> num {
  give 17
}
make uwb_cls_wsegspace() -> num {
  give 18
}

make uwb_class_count() -> num {
  give 19
}

// Text over this many code points is refused, the same shape as the rest of the
// text layer; the engine allocates three parallel scratch lists per call.
make uwb_max_cps() -> num {
  give 4096
}

