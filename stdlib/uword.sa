// The Word_Break class of one code point: 0-18, or -1 for a non-scalar.
make uwb_class(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold tbl = uwb_wb_ranges()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = tbl[mid * 3]
    hold b = tbl[mid * 3 + 1]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > b {
        lo = mid + 1
      } otherwise {
        give tbl[mid * 3 + 2]
      }
    }
  }
  give 0
}

// Extended_Pictographic, the property WB3c needs, or -1 for a non-scalar.
make uwb_is_extpict(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  give uw_in_ranges(uwb_extpict_ranges(), cp)
}

// WB4: Extend, Format and ZWJ are skipped when the rules look at context.
make uwb_is_ignorable(c: num) -> num {
  when c == 4 {
    give 1
  }
  when c == 5 {
    give 1
  }
  when c == 7 {
    give 1
  }
  give 0
}

make uwb_is_ahletter(c: num) -> num {
  when c == 9 {
    give 1
  }
  when c == 10 {
    give 1
  }
  give 0
}

make uwb_is_newline(c: num) -> num {
  when c == 1 {
    give 1
  }
  when c == 2 {
    give 1
  }
  when c == 3 {
    give 1
  }
  give 0
}

make uwb_is_quote_mid(c: num) -> num {
  when c == 11 {
    give 1
  }
  when c == 13 {
    give 1
  }
  when c == 14 {
    give 1
  }
  give 0
}

make uwb_is_num_mid(c: num) -> num {
  when c == 11 {
    give 1
  }
  when c == 13 {
    give 1
  }
  when c == 15 {
    give 1
  }
  give 0
}

// Boundary offsets over a code-point list: 0, the end of every word, and n.
// Every index is a code-point offset, so the caller can slice the list.
make uwb_breaks_cp(cps: list) -> list {
  hold n = len(cps)
  when n > uwb_max_cps() {
    give []
  }
  when n == 0 {
    give [0]
  }
  // The three scratch lists are built with push only, because the bounded
  // native backend has no list element assignment.
  hold kinds = []
  hold i = 0
  while i < n {
    hold c = uwb_class(cps[i])
    when c < 0 {
      give []
    }
    kinds = push(kinds, c)
    i = i + 1
  }
  // WB4 context: the previous and next position that is not Extend/Format/ZWJ.
  hold prev = []
  hold last = 0 - 1
  i = 0
  while i < n {
    prev = push(prev, last)
    when uwb_is_ignorable(kinds[i]) == 0 {
      last = i
    }
    i = i + 1
  }
  // Walking backwards gives the next significant index in reverse position
  // order, so one more pass flips it.
  hold back = []
  hold nxt = 0 - 1
  i = n - 1
  while i >= 0 {
    back = push(back, nxt)
    when uwb_is_ignorable(kinds[i]) == 0 {
      nxt = i
    }
    i = i - 1
  }
  hold next = []
  i = n - 1
  while i >= 0 {
    next = push(next, back[i])
    i = i - 1
  }
  hold out = [0]
  i = 1
  while i < n {
    hold a = kinds[i - 1]
    hold b = kinds[i]
    hold left = prev[i]
    hold la = 0 - 1
    when left >= 0 {
      la = kinds[left]
    }
    hold left2 = 0 - 1
    when left >= 0 {
      left2 = prev[left]
    }
    hold la2 = 0 - 1
    when left2 >= 0 {
      la2 = kinds[left2]
    }
    hold right = next[i]
    hold rb = 0 - 1
    when right >= 0 {
      rb = kinds[right]
    }
    hold right2 = 0 - 1
    when right >= 0 {
      right2 = next[right]
    }
    hold rb2 = 0 - 1
    when right2 >= 0 {
      rb2 = kinds[right2]
    }
    hold joined = 0
    // WB3a/WB3b first: nothing joins to or from Newline, CR or LF, and WB3 is
    // the one exception to it.
    when uwb_is_newline(a) == 1 or uwb_is_newline(b) == 1 {
      joined = 0
    }
    // WB3
    when a == 1 and b == 2 {
      joined = 1
    }
    // WB3c and WB3d
    when a == 5 and uwb_is_extpict(cps[i]) == 1 {
      joined = 1
    }
    when a == 18 and b == 18 {
      joined = 1
    }
    // WB4: what follows an ignorable attaches to it.
    when uwb_is_ignorable(b) == 1 and uwb_is_newline(a) == 0 {
      joined = 1
    }
    // WB5-WB16 apply to the significant context on both sides.
    when uwb_is_newline(a) == 0 and uwb_is_newline(b) == 0 and uwb_is_ignorable(b) == 0 {
      when la >= 0 {
        // WB5
        when uwb_is_ahletter(la) == 1 and uwb_is_ahletter(b) == 1 {
          joined = 1
        }
        // WB6
        when uwb_is_ahletter(la) == 1 and uwb_is_quote_mid(b) == 1 and uwb_is_ahletter(rb) == 1 {
          joined = 1
        }
        // WB7
        when uwb_is_ahletter(la2) == 1 and uwb_is_quote_mid(la) == 1 and uwb_is_ahletter(b) == 1 {
          joined = 1
        }
        // WB7a
        when la == 9 and b == 11 {
          joined = 1
        }
        // WB7b
        when la == 9 and b == 12 and rb == 9 {
          joined = 1
        }
        // WB7c
        when la2 == 9 and la == 12 and b == 9 {
          joined = 1
        }
        // WB8, WB9, WB10
        when la == 16 and b == 16 {
          joined = 1
        }
        when uwb_is_ahletter(la) == 1 and b == 16 {
          joined = 1
        }
        when la == 16 and uwb_is_ahletter(b) == 1 {
          joined = 1
        }
        // WB11
        when la2 == 16 and uwb_is_num_mid(la) == 1 and b == 16 {
          joined = 1
        }
        // WB12
        when la == 16 and uwb_is_num_mid(b) == 1 and rb == 16 {
          joined = 1
        }
        // WB13
        when la == 8 and b == 8 {
          joined = 1
        }
        // WB13a
        when b == 17 {
          when uwb_is_ahletter(la) == 1 or la == 16 or la == 8 or la == 17 {
            joined = 1
          }
        }
        // WB13b
        when la == 17 {
          when uwb_is_ahletter(b) == 1 or b == 16 or b == 8 or b == 17 {
            joined = 1
          }
        }
        // WB15/16: only every other regional indicator joins, counting from the
        // start of the run, so four flags are two words and three are two.
        when la == 6 and b == 6 {
          hold run = 0
          hold k = left
          while k >= 0 and kinds[k] == 6 {
            run = run + 1
            k = prev[k]
          }
          when run % 2 == 1 {
            joined = 1
          } otherwise {
            joined = 0
          }
        }
      }
    }
    when joined == 0 {
      out = push(out, i)
    }
    i = i + 1
  }
  out = push(out, n)
  give out
}

// The number of words in a code-point list, or -1 for a non-scalar or over-long
// input.
make uwb_count_cp(cps: list) -> num {
  hold b = uwb_breaks_cp(cps)
  when len(b) == 0 {
    give 0 - 1
  }
  give len(b) - 1
}

// Byte offset of every code-point index, plus the total, for the string API.
make uwb_offsets(s: str) -> list {
  hold out = [0]
  hold at = 0
  hold bytes = len(s)
  while at < bytes {
    hold span = u8_span(s, at)
    when span < 1 {
      give []
    }
    at = at + span
    out = push(out, at)
  }
  give out
}

// Boundary offsets over a string, in bytes: 0, the end of every word, len(s).
make uwb_breaks(s: str) -> list {
  when u8_len(s) < 0 {
    give []
  }
  hold bytes = len(s)
  when bytes == 0 {
    give [0]
  }
  hold cps = u8_to_list(s)
  when len(cps) == 0 {
    give []
  }
  hold marks = uwb_breaks_cp(cps)
  when len(marks) == 0 {
    give []
  }
  hold offs = uwb_offsets(s)
  when len(offs) == 0 {
    give []
  }
  hold out = []
  hold i = 0
  while i < len(marks) {
    out = push(out, offs[marks[i]])
    i = i + 1
  }
  give out
}

// The number of words in a string, or -1 for malformed or over-long text.
make uwb_count(s: str) -> num {
  hold b = uwb_breaks(s)
  when len(b) == 0 {
    give 0 - 1
  }
  give len(b) - 1
}

// The words of a string as a list of code-point lists would need nested lists,
// which the language does not have, so the string API hands out byte spans:
// uwb_word_start(s, k) and uwb_word_end(s, k) are the k-th word's bounds.
make uwb_word_start(s: str, k: num) -> num {
  hold b = uwb_breaks(s)
  when k < 0 or k >= len(b) - 1 {
    give 0 - 1
  }
  give b[k]
}

make uwb_word_end(s: str, k: num) -> num {
  hold b = uwb_breaks(s)
  when k < 0 or k >= len(b) - 1 {
    give 0 - 1
  }
  give b[k + 1]
}

// The bytes between two offsets, the same contract as ug_slice.
make uwb_slice(s: str, start: num, end: num) -> str {
  hold bytes = len(s)
  when start < 0 or end < start or end > bytes {
    give ""
  }
  hold out = ""
  hold i = start
  while i < end {
    out = concat(out, chr(sx_index(s, i)))
    i = i + 1
  }
  give out
}

// The first n words of a string, "" on malformed input.
make uwb_take(s: str, n: num) -> str {
  hold b = uwb_breaks(s)
  when len(b) == 0 {
    give ""
  }
  when n <= 0 {
    give ""
  }
  when n > len(b) - 1 {
    give s
  }
  give uwb_slice(s, 0, b[n])
}

// The string without its first n words, "" when n leaves nothing behind.
make uwb_drop(s: str, n: num) -> str {
  hold b = uwb_breaks(s)
  when len(b) == 0 {
    give ""
  }
  when n <= 0 {
    give s
  }
  when n > len(b) - 1 {
    give ""
  }
  give uwb_slice(s, b[n], len(s))
}
