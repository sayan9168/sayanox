// <<< GENERATED TABLES END

// Canonical combining class of one code point: 0 for a starter, the class
// value for a mark, or -1 for a non-scalar. The table is [lo, hi, ccc]
// triples sorted by lo, so bisection finds the class in about nine steps.
make un_ccc(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold tbl = un_ccc_ranges()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = tbl[mid * 3]
    hold b = tbl[mid * 3 + 1]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > b {
        lo = mid + 1
      } otherwise {
        give tbl[mid * 3 + 2]
      }
    }
  }
  give 0
}

// 1 when cp is on the Full_Composition_Exclusion list, so it decomposes but
// never recomposes. -1 for a non-scalar.
make un_excluded(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  give un_in_ranges(un_excluded_ranges(), cp)
}

// Hangul syllable decomposition, or [] when cp is not a syllable. The block
// AC00..D7A3 is arithmetic: S = AC00 + ((L - 1100) * 21 + (V - 1161)) * 28
// + (T - 11A7), and a zero trailing offset means there is no T.
make un_hangul_decomp(cp: num) -> list {
  when cp < 44032 {
    give []
  }
  when cp > 55203 {
    give []
  }
  hold s = cp - 44032
  hold l = 4352 + u8_div(s, 588)
  hold rest = s % 588
  hold v = 4449 + u8_div(rest, 28)
  hold t = 4519 + (rest % 28)
  when t == 4519 {
    give [l, v]
  }
  give [l, v, t]
}

// Direct canonical decomposition of one code point: [] when it has none,
// otherwise one or two code points. Hangul syllables give their Jamo. This
// is one step only; un_nfd_list expands recursively. [] for a non-scalar.
make un_decomp(cp: num) -> list {
  when u8_cp_valid(cp) == 0 {
    give []
  }
  hold hd = un_hangul_decomp(cp)
  when len(hd) > 0 {
    give hd
  }
  hold tbl = un_decomp_triples()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = tbl[mid * 3]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > a {
        lo = mid + 1
      } otherwise {
        hold d1 = tbl[mid * 3 + 1]
        hold d2 = tbl[mid * 3 + 2]
        when d2 == 0 {
          give [d1]
        }
        give [d1, d2]
      }
    }
  }
  give []
}

// Compatibility decomposition of one code point, given the two generated
// tables the caller already holds. The public wrapper below fetches them; the
// NFKD path fetches them once per string instead of once per code point,
// because an index of 11499 numbers is not something to rebuild per lookup.
make un_compat_from(idx: list, pool: list, cp: num) -> list {
  when u8_cp_valid(cp) == 0 {
    give []
  }
  hold n = len(idx)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = idx[mid * 3]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > a {
        lo = mid + 1
      } otherwise {
        hold start = idx[mid * 3 + 1]
        hold count = idx[mid * 3 + 2]
        hold out = []
        hold i = 0
        while i < count {
          out = push(out, pool[start + i])
          i = i + 1
        }
        give out
      }
    }
  }
  give []
}

// Compatibility decomposition of one code point: [] when it has none. The
// table holds only the tagged mappings (<font>, <compat>, <noBreak>, <wide>,
// ...); canonical ones are already in un_decomp, and a code point never has
// both. [] for a non-scalar.
make un_compat(cp: num) -> list {
  give un_compat_from(un_compat_index(), un_compat_pool(), cp)
}

// Composite of a starter `a` and a following `b`, or -1 when the pair does
// not compose. Hangul L+V and LV+T are arithmetic; everything else is the
// primary-composite table of [a, b, composite] triples sorted by (a, b).
make un_compose_pair(a: num, b: num) -> num {
  when u8_cp_valid(a) == 0 {
    give 0 - 1
  }
  when u8_cp_valid(b) == 0 {
    give 0 - 1
  }
  when a >= 4352 {
    when a <= 4370 {
      when b >= 4449 {
        when b <= 4469 {
          hold lv = 44032 + (a - 4352) * 588 + (b - 4449) * 28
          give lv
        }
      }
    }
  }
  when a >= 44032 {
    when a <= 55203 {
      hold off = (a - 44032) % 28
      when off == 0 {
        when b >= 4520 {
          when b <= 4546 {
            give a + (b - 4519)
          }
        }
      }
    }
  }
  hold tbl = un_pair_triples()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold ta = tbl[mid * 3]
    hold tb = tbl[mid * 3 + 1]
    hold less = 0
    hold greater = 0
    when a < ta {
      less = 1
    } otherwise {
      when a > ta {
        greater = 1
      } otherwise {
        when b < tb {
          less = 1
        } otherwise {
          when b > tb {
            greater = 1
          }
        }
      }
    }
    when less == 1 {
      hi = mid - 1
    } otherwise {
      when greater == 1 {
        lo = mid + 1
      } otherwise {
        give tbl[mid * 3 + 2]
      }
    }
  }
  give 0 - 1
}

// Append the full decomposition of cp to `out`, recursively. The depth cap
// is far above the deepest real chain (3) and stops a corrupt table looping.
make un_expand(cp: num, depth: num, out: list) -> list {
  when depth > 8 {
    give push(out, cp)
  }
  hold d = un_decomp(cp)
  when len(d) == 0 {
    give push(out, cp)
  }
  hold i = 0
  hold acc = out
  while i < len(d) {
    acc = un_expand(d[i], depth + 1, acc)
    i = i + 1
  }
  give acc
}

// Append the full compatibility decomposition of cp to `out`, recursively,
// carrying the generated tables down. The compatibility mapping wins when
// both exist; Hangul still decomposes arithmetically through un_decomp. The
// depth cap matches un_expand.
make un_expand_compat_from(idx: list, pool: list, cp: num, depth: num, out: list) -> list {
  when depth > 8 {
    give push(out, cp)
  }
  hold d = un_compat_from(idx, pool, cp)
  when len(d) == 0 {
    d = un_decomp(cp)
  }
  when len(d) == 0 {
    give push(out, cp)
  }
  hold i = 0
  hold acc = out
  while i < len(d) {
    acc = un_expand_compat_from(idx, pool, d[i], depth + 1, acc)
    i = i + 1
  }
  give acc
}

// Is every element of `cps` a scalar value? The empty list is valid.
make un_valid_list(cps: list) -> num {
  hold i = 0
  while i < len(cps) {
    when u8_cp_valid(cps[i]) == 0 {
      give 0
    }
    i = i + 1
  }
  give 1
}

// Stable canonical ordering of one run of non-starters: sort by combining
// class ascending, keeping equal classes in their original order. A run
// that is already ordered is copied straight through; otherwise each class
// value 1..254 is swept in order and its members pushed, which is stable
// because the sweep itself walks the run in order.
make un_order_run(run: list) -> num {
  hold n = len(run)
  hold ordered = 1
  hold i = 1
  while i < n {
    hold prev = un_ccc(run[i - 1])
    hold cur = un_ccc(run[i])
    when cur < prev {
      ordered = 0
    }
    i = i + 1
  }
  give ordered
}

make un_ordered(run: list) -> list {
  hold sorted = un_order_run(run)
  when sorted == 1 {
    hold out = []
    hold i = 0
    while i < len(run) {
      out = push(out, run[i])
      i = i + 1
    }
    give out
  }
  hold out = []
  hold v = 1
  while v <= 254 {
    hold i = 0
    while i < len(run) {
      when un_ccc(run[i]) == v {
        out = push(out, run[i])
      }
      i = i + 1
    }
    v = v + 1
  }
  give out
}

// Canonically order every run of non-starters in a flattened sequence. NFD
// and NFKD share this step; only the expansion before it differs, so the
// ordering is written once.
make un_order_marks(flat: list) -> list {
  hold out = []
  hold run = []
  hold j = 0
  while j < len(flat) {
    hold cp = flat[j]
    when un_ccc(cp) == 0 {
      hold ordered = un_ordered(run)
      hold k = 0
      while k < len(ordered) {
        out = push(out, ordered[k])
        k = k + 1
      }
      run = []
      out = push(out, cp)
    } otherwise {
      run = push(run, cp)
    }
    j = j + 1
  }
  hold tail = un_ordered(run)
  hold m = 0
  while m < len(tail) {
    out = push(out, tail[m])
    m = m + 1
  }
  give out
}

// NFD sequence for a list of scalars: fully decompose every element, then
// order each run of marks. [] when any element is not a scalar.
make un_nfd_list(cps: list) -> list {
  when un_valid_list(cps) == 0 {
    give []
  }
  hold flat = []
  hold i = 0
  while i < len(cps) {
    flat = un_expand(cps[i], 0, flat)
    i = i + 1
  }
  give un_order_marks(flat)
}

// NFKD sequence for a list of scalars: the same ordering over compatibility
// expansions, so a ligature, a fullwidth letter or a superscript digit is
// folded to its compatibility equivalent before the marks are ordered.
make un_nfkd_list(cps: list) -> list {
  when un_valid_list(cps) == 0 {
    give []
  }
  hold idx = un_compat_index()
  hold pool = un_compat_pool()
  hold flat = []
  hold i = 0
  while i < len(cps) {
    flat = un_expand_compat_from(idx, pool, cps[i], 0, flat)
    i = i + 1
  }
  give un_order_marks(flat)
}

// Flush a pending starter and its marks onto `out`.
make un_flush(out: list, starter: num, pending: list) -> list {
  when starter < 0 {
    give out
  }
  hold acc = push(out, starter)
  hold i = 0
  while i < len(pending) {
    acc = push(acc, pending[i])
    i = i + 1
  }
  give acc
}

// Canonically compose a sequence that is already in NFD or NFKD order, so
// NFC and NFKC share one composition rule. The starter is held back instead
// of pushed, so a following mark can still compose with it without any
// in-place list edit. `pending` holds the marks that did NOT compose; the run
// is canonically ordered, so the last pending mark carries the largest class
// and decides blocking for the next character -- a mark whose class is not
// greater than that is blocked, and so is a starter once anything is pending.
make un_compose_marks(seq: list) -> list {
  hold out = []
  hold starter = 0 - 1
  hold pending = []
  hold i = 0
  while i < len(seq) {
    hold cp = seq[i]
    hold c = un_ccc(cp)
    when starter < 0 {
      when c == 0 {
        starter = cp
      } otherwise {
        out = push(out, cp)
      }
    } otherwise {
      hold blocked = 0
      when len(pending) > 0 {
        hold last = un_ccc(pending[len(pending) - 1])
        when last >= c {
          blocked = 1
        }
      }
      hold comp = 0 - 1
      when blocked == 0 {
        comp = un_compose_pair(starter, cp)
      }
      when comp >= 0 {
        starter = comp
      } otherwise {
        when c == 0 {
          out = un_flush(out, starter, pending)
          pending = []
          starter = cp
        } otherwise {
          pending = push(pending, cp)
        }
      }
    }
    i = i + 1
  }
  out = un_flush(out, starter, pending)
  give out
}

// NFC sequence for a list of scalars. [] for a non-scalar element.
make un_nfc_list(cps: list) -> list {
  when un_valid_list(cps) == 0 {
    give []
  }
  give un_compose_marks(un_nfd_list(cps))
}

// NFKC sequence: NFKD (which folds compatibility characters) followed by the
// same canonical composition NFC uses. Not a second algorithm, the same one
// over a wider decomposition.
make un_nfkc_list(cps: list) -> list {
  when un_valid_list(cps) == 0 {
    give []
  }
  give un_compose_marks(un_nfkd_list(cps))
}

// 1 when two scalar lists are identical, else 0.
make un_lists_equal(a: list, b: list) -> num {
  when len(a) != len(b) {
    give 0
  }
  hold i = 0
  while i < len(a) {
    when a[i] != b[i] {
      give 0
    }
    i = i + 1
  }
  give 1
}

// NFD of a string, or "" for malformed or over-long input.
make un_nfd(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  hold cps = u8_to_list(s)
  hold out = un_nfd_list(cps)
  give u8_from(out)
}

// NFC of a string, or "" for malformed or over-long input.
make un_nfc(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  hold cps = u8_to_list(s)
  hold out = un_nfc_list(cps)
  give u8_from(out)
}

// 1 when s is already in NFC, 0 when it is not, -1 for malformed input.
make un_is_nfc(s: str) -> num {
  when u8_len(s) < 0 {
    give 0 - 1
  }
  hold cps = u8_to_list(s)
  hold norm = un_nfc_list(cps)
  give un_lists_equal(cps, norm)
}

// 1 when s is already in NFD, 0 when it is not, -1 for malformed input.
make un_is_nfd(s: str) -> num {
  when u8_len(s) < 0 {
    give 0 - 1
  }
  hold cps = u8_to_list(s)
  hold norm = un_nfd_list(cps)
  give un_lists_equal(cps, norm)
}

// 1 when a and b are canonically equivalent (same NFD), 0 when they are
// not, -1 when either input is malformed or over-long.
make un_equal(a: str, b: str) -> num {
  when u8_len(a) < 0 {
    give 0 - 1
  }
  when u8_len(b) < 0 {
    give 0 - 1
  }
  hold na = un_nfd_list(u8_to_list(a))
  hold nb = un_nfd_list(u8_to_list(b))
  give un_lists_equal(na, nb)
}

// NFKD of a string, or "" for malformed or over-long input.
make un_nfkd(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  hold out = un_nfkd_list(u8_to_list(s))
  give u8_from(out)
}

// NFKC of a string, or "" for malformed or over-long input.
make un_nfkc(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  hold out = un_nfkc_list(u8_to_list(s))
  give u8_from(out)
}

// 1 when s is already in NFKD, 0 when it is not, -1 for malformed input.
make un_is_nfkd(s: str) -> num {
  when u8_len(s) < 0 {
    give 0 - 1
  }
  hold cps = u8_to_list(s)
  give un_lists_equal(cps, un_nfkd_list(cps))
}

// 1 when s is already in NFKC, 0 when it is not, -1 for malformed input.
make un_is_nfkc(s: str) -> num {
  when u8_len(s) < 0 {
    give 0 - 1
  }
  hold cps = u8_to_list(s)
  give un_lists_equal(cps, un_nfkc_list(cps))
}

// 1 when a and b are compatibility equivalent (same NFKD), 0 when they are
// not, -1 when either input is malformed or over-long. This is the stronger
// test -- it folds ligatures, fullwidth forms and superscripts -- and it is
// still not a caseless comparison; that lives in stdlib/ucase.sa.
make un_compat_equal(a: str, b: str) -> num {
  when u8_len(a) < 0 {
    give 0 - 1
  }
  when u8_len(b) < 0 {
    give 0 - 1
  }
  hold na = un_nfkd_list(u8_to_list(a))
  hold nb = un_nfkd_list(u8_to_list(b))
  give un_lists_equal(na, nb)
}
