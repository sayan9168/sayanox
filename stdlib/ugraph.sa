// <<< GENERATED TABLES END

// Class of one code point, or -1 for a non-scalar (negative, above U+10FFFF, or
// a surrogate), matching uw_cp_width's contract. The Hangul syllable block is
// arithmetic: AC00..D7A3 is LV when the offset is a multiple of 28 and LVT
// otherwise, which keeps 798 ranges out of the table.
make ug_class(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  when cp >= 44032 {
    when cp <= 55203 {
      hold off = (cp - 44032) % 28
      when off == 0 {
        give 10
      }
      give 11
    }
  }
  hold tbl = ug_gcb_ranges()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 3) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = tbl[mid * 3]
    hold b = tbl[mid * 3 + 1]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > b {
        lo = mid + 1
      } otherwise {
        give tbl[mid * 3 + 2]
      }
    }
  }
  give 0
}

make ug_is_extpict(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  give uw_in_ranges(ug_extpict_ranges(), cp)
}

// The InCB value used by GB9c: 0 none, 1 linker, 2 consonant, 3 extend.
make ug_incb(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold l = uw_in_ranges(ug_incb_linker_ranges(), cp)
  when l == 1 {
    give 1
  }
  hold c = uw_in_ranges(ug_incb_consonant_ranges(), cp)
  when c == 1 {
    give 2
  }
  hold e = uw_in_ranges(ug_incb_extend_ranges(), cp)
  when e == 1 {
    give 3
  }
  give 0
}

// Walk state carried between boundaries. `ri` counts consecutive regional
// indicators immediately before the boundary. `pict` is 1 when the run before
// the boundary matches Extended_Pictographic Extend* (so GB11 can fire after a
// ZWJ). `incb` is the GB9c state: 0 none, 1 seen a consonant, 2 seen the linker
// after that consonant.
make ug_state_ri(st: list) -> num {
  give st[0]
}
make ug_state_pict(st: list) -> num {
  give st[1]
}
make ug_state_incb(st: list) -> num {
  give st[2]
}

make ug_state_new() -> list {
  give [0, 0, 0]
}

// Advance the walk state over one code point of class cls.
make ug_state_step(st: list, cp: num, cls: num) -> list {
  hold ri = 0
  when cls == 6 {
    ri = st[0] + 1
  }
  // GB11 needs "ExtPict Extend*" to survive the ZWJ that follows it, so both
  // Extend and ZWJ carry the flag forward; anything else clears it.
  hold pict = 0
  hold extp = ug_is_extpict(cp)
  when extp == 1 {
    pict = 1
  } otherwise {
    when cls == 4 {
      pict = st[1]
    } otherwise {
      when cls == 5 {
        pict = st[1]
      }
    }
  }
  // GB9c chain: 0 none, 1 consonant seen, 2 linker seen after that consonant.
  hold iv = ug_incb(cp)
  hold prev = st[2]
  hold incb = 0
  when iv == 1 {
    when prev >= 1 {
      incb = 2
    }
  } otherwise {
    when iv == 2 {
      incb = 1
    } otherwise {
      when iv == 3 {
        incb = prev
      }
    }
  }
  give [ri, pict, incb]
}

// Is there NO break between the code point of class `left` (with `st` describing
// everything up to and including it) and a following code point `right_cp` of
// class `right`? Rules are tested in UAX #29 order.
make ug_join(st: list, left: num, right: num, right_cp: num) -> num {
  // GB3: CR x LF. Tested first because GB4/GB5 would otherwise break it.
  when left == 2 {
    when right == 3 {
      give 1
    }
  }
  // GB4 and GB5: (Control | CR | LF) breaks on both sides.
  when left == 1 {
    give 0
  }
  when left == 2 {
    give 0
  }
  when left == 3 {
    give 0
  }
  when right == 1 {
    give 0
  }
  when right == 2 {
    give 0
  }
  when right == 3 {
    give 0
  }
  // GB6: L x (L | V | LV | LVT).
  when left == 7 {
    when right == 7 {
      give 1
    }
    when right == 8 {
      give 1
    }
    when right == 10 {
      give 1
    }
    when right == 11 {
      give 1
    }
  }
  // GB7: (LV | V) x (V | T), written one left class at a time.
  when left == 10 {
    when right == 8 {
      give 1
    }
    when right == 9 {
      give 1
    }
  }
  when left == 8 {
    when right == 8 {
      give 1
    }
    when right == 9 {
      give 1
    }
  }
  // GB8: (LVT | T) x T.
  when left == 11 {
    when right == 9 {
      give 1
    }
  }
  when left == 9 {
    when right == 9 {
      give 1
    }
  }
  // GB9: x (Extend | ZWJ).
  when right == 4 {
    give 1
  }
  when right == 5 {
    give 1
  }
  // GB9a: x SpacingMark.
  when right == 13 {
    give 1
  }
  // GB9b: Prepend x.
  when left == 12 {
    give 1
  }
  // GB9c: Consonant [Extend Linker]* Linker [Extend Linker]* x Consonant.
  // st[2] == 2 means exactly that prefix has been seen, so only the right-hand
  // consonant still has to be checked.
  when st[2] == 2 {
    hold iv = ug_incb(right_cp)
    when iv == 2 {
      give 1
    }
  }
  // GB11: ExtPict Extend* ZWJ x ExtPict. st[1] carries the ExtPict flag across
  // both the Extend run and the ZWJ, which is why left == 5 alone is not enough.
  when left == 5 {
    when st[1] == 1 {
      hold ep = ug_is_extpict(right_cp)
      when ep == 1 {
        give 1
      }
    }
  }
  // GB12/GB13: a run of indicators pairs up, so join only on an odd count.
  when left == 6 {
    when right == 6 {
      hold odd = st[0] % 2
      when odd == 1 {
        give 1
      }
      give 0
    }
  }
  // GB999: everywhere else, break.
  give 0
}

// Byte offsets of every cluster boundary, including 0 and len(s). A malformed
// or over-long input gives []. The list has ug_count(s) + 1 entries.
make ug_breaks(s: str) -> list {
  hold n = u8_len(s)
  when n < 0 {
    give []
  }
  hold bytes = len(s)
  hold out = [0]
  when bytes == 0 {
    give [0]
  }
  hold at = 0
  hold span = u8_span(s, 0)
  when span < 1 {
    give []
  }
  hold cp = u8_decode_at(s, 0)
  hold cls = ug_class(cp)
  when cls < 0 {
    give []
  }
  hold st = ug_state_step(ug_state_new(), cp, cls)
  at = span
  while at < bytes {
    hold sp2 = u8_span(s, at)
    when sp2 < 1 {
      give []
    }
    hold cp2 = u8_decode_at(s, at)
    hold cls2 = ug_class(cp2)
    when cls2 < 0 {
      give []
    }
    hold keep = ug_join(st, cls, cls2, cp2)
    when keep == 0 {
      out = push(out, at)
    }
    st = ug_state_step(st, cp2, cls2)
    cls = cls2
    at = at + sp2
  }
  out = push(out, bytes)
  give out
}

// Number of user-perceived characters, or -1 for malformed/over-long text.
make ug_count(s: str) -> num {
  hold b = ug_breaks(s)
  when len(b) == 0 {
    give 0 - 1
  }
  give len(b) - 1
}

// The bytes of s between two byte offsets.
make ug_bytes_between(s: str, from: num, to: num) -> str {
  hold out = ""
  hold i = from
  while i < to {
    hold piece = chr(sx_index(s, i))
    out = concat(out, piece)
    i = i + 1
  }
  give out
}

// The i-th cluster as text. Out of range or malformed gives "".
make ug_at(s: str, i: num) -> str {
  hold b = ug_breaks(s)
  when len(b) == 0 {
    give ""
  }
  when i < 0 {
    give ""
  }
  when i >= len(b) - 1 {
    give ""
  }
  give ug_bytes_between(s, b[i], b[i + 1])
}

// Clusters [first, last), clamped to the text; last <= first gives "".
make ug_slice(s: str, first: num, last: num) -> str {
  hold b = ug_breaks(s)
  when len(b) == 0 {
    give ""
  }
  hold n = len(b) - 1
  hold a = first
  hold z = last
  when a < 0 {
    a = 0
  }
  when z > n {
    z = n
  }
  when a >= z {
    give ""
  }
  give ug_bytes_between(s, b[a], b[z])
}

make ug_take(s: str, count: num) -> str {
  hold n = ug_count(s)
  when n < 0 {
    give ""
  }
  give ug_slice(s, 0, count)
}

make ug_drop(s: str, count: num) -> str {
  hold n = ug_count(s)
  when n < 0 {
    give ""
  }
  give ug_slice(s, count, n)
}

// Reverse by cluster, so a combining mark stays with its base and a flag stays
// a flag. Code-point reversal (ut_reverse) does neither.
make ug_reverse(s: str) -> str {
  hold b = ug_breaks(s)
  when len(b) == 0 {
    give ""
  }
  hold i = len(b) - 2
  hold out = ""
  while i >= 0 {
    hold piece = ug_bytes_between(s, b[i], b[i + 1])
    out = concat(out, piece)
    i = i - 1
  }
  give out
}

// Columns for one cluster: the width of its first code point. Combining marks
// contribute 0 and an emoji ZWJ sequence is one glyph, so the base decides.
make ug_cluster_width(s: str) -> num {
  when len(s) == 0 {
    give 0
  }
  hold cp = u8_decode_at(s, 0)
  give uw_cp_width(cp)
}

// Display width measured a cluster at a time. This is the function to use for
// layout: uw_str_width sums code points and over-counts ZWJ sequences.
make ug_width(s: str) -> num {
  hold b = ug_breaks(s)
  when len(b) == 0 {
    give 0 - 1
  }
  hold i = 0
  hold total = 0
  while i < len(b) - 1 {
    hold cp = u8_decode_at(s, b[i])
    hold w = uw_cp_width(cp)
    when w < 0 {
      give 0 - 1
    }
    total = total + w
    i = i + 1
  }
  give total
}

// Truncate to at most `count` clusters, appending `suffix` when cut. The suffix
// counts against the cluster budget; a longer suffix gives "".
make ug_truncate(s: str, count: num, suffix: str) -> str {
  hold n = ug_count(s)
  when n < 0 {
    give ""
  }
  when count < 0 {
    give ""
  }
  when n <= count {
    give s
  }
  hold sw = ug_count(suffix)
  when sw < 0 {
    give ""
  }
  when sw > count {
    give ""
  }
  hold head = ug_slice(s, 0, count - sw)
  give concat(head, suffix)
}
