// Tiny portable standard library (pure-min, all three backends).
//
// Only numeric helpers live here.  String-returning user functions and
// list/string function parameters are not in the native-AOT subset, so a
// library that has to run everywhere stays numeric; string work uses the
// builtins (concat/len/chr/read_file/write_file/arg).
//
// Use it with a plain file splice:
//   use "stdlib/tiny.sa"

make min2(a, b) {
  when a < b {
    give a
  }
  give b
}

make max2(a, b) {
  when a > b {
    give a
  }
  give b
}

make absv(n) {
  when n < 0 {
    give 0 - n
  }
  give n
}

make sum_to(n) {
  when n <= 0 {
    give 0
  }
  give n + sum_to(n - 1)
}

make pow_int(base, exp) {
  when exp <= 0 {
    give 1
  }
  give base * pow_int(base, exp - 1)
}

make is_even(n) {
  when n % 2 == 0 {
    give 1
  }
  give 0
}

make gcd(a, b) {
  when b == 0 {
    give a
  }
  give gcd(b, a % b)
}

// Added with the 2026-10-08 expansion. Every helper is numeric and uses only
// the native-AOT subset (no `hold` inside a body, at most 6 parameters).

make clamp(x, lo, hi) {
  when x < lo {
    give lo
  }
  when x > hi {
    give hi
  }
  give x
}

make sign(n) {
  when n > 0 {
    give 1
  }
  when n < 0 {
    give 0 - 1
  }
  give 0
}

make is_odd(n) {
  when absv(n) % 2 == 1 {
    give 1
  }
  give 0
}

make lcm(a, b) {
  when a == 0 {
    give 0
  }
  when b == 0 {
    give 0
  }
  give absv(a / gcd(a, b) * b)
}

make fact(n) {
  when n <= 1 {
    give 1
  }
  give n * fact(n - 1)
}

make fib(n) {
  when n < 2 {
    give n
  }
  give fib(n - 1) + fib(n - 2)
}

// no_factor_from(n, d): 1 when no d' >= d with d'*d <= n divides n
make no_factor_from(n, d) {
  when d * d > n {
    give 1
  }
  when n % d == 0 {
    give 0
  }
  give no_factor_from(n, d + 1)
}

make is_prime(n) {
  when n < 2 {
    give 0
  }
  give no_factor_from(n, 2)
}
