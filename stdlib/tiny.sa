// Tiny portable standard library (pure-min, all three backends).
//
// Only numeric helpers live here.  String/list parameters and string returns
// need the full-language typed parameter (`make f(s: str) -> str`), which the
// native-AOT subset does not model and seed-min does not read, so a library
// that has to run on all three backends stays numeric; string work uses the
// builtins (concat/len/chr/sx_index/read_file/write_file/arg).
//
// The string, list and file helpers live next door and are gen2-only:
//   use "stdlib/str_util.sa"    s_len s_at s_join s_prefix s_suffix s_reverse
//                               s_repeat s_count s_contains s_eq s_upper
//                               s_lower s_starts s_ends
//   use "stdlib/list_util.sa"   l_len l_get l_sum l_max l_min l_count
//                               l_contains l_reverse l_range
//   use "stdlib/file_util.sa"   f_read f_write f_size f_exists f_lines
//
// Use any of them with a plain file splice:
//   use "stdlib/tiny.sa"

make min2(a, b) {
  when a < b {
    give a
  }
  give b
}

make max2(a, b) {
  when a > b {
    give a
  }
  give b
}

make absv(n) {
  when n < 0 {
    give 0 - n
  }
  give n
}

make sum_to(n) {
  when n <= 0 {
    give 0
  }
  give n + sum_to(n - 1)
}

make pow_int(base, exp) {
  when exp <= 0 {
    give 1
  }
  give base * pow_int(base, exp - 1)
}

make is_even(n) {
  when n % 2 == 0 {
    give 1
  }
  give 0
}

make gcd(a, b) {
  when b == 0 {
    give a
  }
  give gcd(b, a % b)
}

// Added with the 2026-10-08 expansion. Every helper is numeric and uses only
// the native-AOT subset (no `hold` inside a body, at most 6 parameters).

make clamp(x, lo, hi) {
  when x < lo {
    give lo
  }
  when x > hi {
    give hi
  }
  give x
}

make sign(n) {
  when n > 0 {
    give 1
  }
  when n < 0 {
    give 0 - 1
  }
  give 0
}

make is_odd(n) {
  when absv(n) % 2 == 1 {
    give 1
  }
  give 0
}

make lcm(a, b) {
  when a == 0 {
    give 0
  }
  when b == 0 {
    give 0
  }
  give absv(a / gcd(a, b) * b)
}

make fact(n) {
  when n <= 1 {
    give 1
  }
  give n * fact(n - 1)
}

make fib(n) {
  when n < 2 {
    give n
  }
  give fib(n - 1) + fib(n - 2)
}

// no_factor_from(n, d): 1 when no d' >= d with d'*d <= n divides n
make no_factor_from(n, d) {
  when d * d > n {
    give 1
  }
  when n % d == 0 {
    give 0
  }
  give no_factor_from(n, d + 1)
}

make is_prime(n) {
  when n < 2 {
    give 0
  }
  give no_factor_from(n, 2)
}

// Added with the 2026-10-08 expansion.  Still numeric only and still inside
// the native-AOT subset (no `hold` inside a body, at most 6 parameters), so
// every helper below runs on seed-min, gen2 and native alike.

make sum_range(a, b) {
  when a > b {
    give 0
  }
  give a + sum_range(a + 1, b)
}

make sum_sq(n) {
  when n <= 0 {
    give 0
  }
  give n * n + sum_sq(n - 1)
}

make count_digits(n) {
  when n < 0 {
    give count_digits(0 - n)
  }
  when n < 10 {
    give 1
  }
  give 1 + count_digits((n - n % 10) / 10)
}

make digit_sum(n) {
  when n < 0 {
    give digit_sum(0 - n)
  }
  when n < 10 {
    give n
  }
  give n % 10 + digit_sum((n - n % 10) / 10)
}

make trunc10(n) {
  give (n - n % 10) / 10
}

// helper order matters: a call needs the callee defined above it, because a
// user function gets no forward prototype in the C output.
make rev_num(n, acc) {
  when n <= 0 {
    give acc
  }
  give rev_num(trunc10(n), acc * 10 + n % 10)
}

make reverse_num(n) {
  give rev_num(n, 0)
}

make has_sq_from(n, i) {
  when i * i > n {
    give 0
  }
  when i * i == n {
    give 1
  }
  give has_sq_from(n, i + 1)
}

make is_square(n) {
  when n < 0 {
    give 0
  }
  give has_sq_from(n, 0)
}

make between(x, lo, hi) {
  when x < lo {
    give 0
  }
  when x > hi {
    give 0
  }
  give 1
}

// Added with the 2026-10-10 growth pass (still numeric, still native-subset:
// no `hold` in a body, at most 6 parameters, helpers defined before use).

make tri(n) {
  when n <= 0 {
    give 0
  }
  give n * (n + 1) / 2
}

make min3(a, b, c) {
  give min2(min2(a, b), c)
}

make max3(a, b, c) {
  give max2(max2(a, b), c)
}

// ceil_div(a, b): ceiling of a / b for a >= 0 and b > 0
make ceil_div(a, b) {
  give (a + b - 1 - (a + b - 1) % b) / b
}

make pow_mod(b, e, m) {
  when e <= 0 {
    give 1 % m
  }
  give b * pow_mod(b, e - 1, m) % m
}

// collatz_steps(n): steps for n to reach 1 under the 3n+1 rule (n >= 1)
make collatz_steps(n) {
  when n <= 1 {
    give 0
  }
  when n % 2 == 0 {
    give 1 + collatz_steps(n / 2)
  }
  give 1 + collatz_steps(3 * n + 1)
}

// div_floor(n, p): floor(n / p) for n >= 0 and p > 0
make div_floor(n, p) {
  give (n - n % p) / p
}

// digit_at(n, k): the k-th decimal digit of n >= 0, counting from 0
make digit_at(n, k) {
  give div_floor(n, pow_int(10, k)) - 10 * div_floor(n, pow_int(10, k + 1))
}

make is_palindrome(n) {
  when n < 0 {
    give 0
  }
  when reverse_num(n) == n {
    give 1
  }
  give 0
}

make isqrt_from(n, i) {
  when (i + 1) * (i + 1) > n {
    give i
  }
  give isqrt_from(n, i + 1)
}

// isqrt(n): floor of the square root, for n >= 0
make isqrt(n) {
  when n <= 0 {
    give 0
  }
  give isqrt_from(n, 0)
}
