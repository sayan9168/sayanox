// <<< GENERATED TABLES END

// Index in uc_special() of the record for cp, or -1. Records are variable
// length, so this is a linear walk over about a hundred entries; it only runs
// for code points that reach the special table at all.
make uc_special_at(cp: num) -> num {
  hold tbl = uc_special()
  hold n = len(tbl)
  hold i = 0
  while i < n {
    when tbl[i] == cp {
      give i
    }
    hold nl = tbl[i + 1]
    i = i + 2 + nl
    hold nu = tbl[i]
    i = i + 1 + nu
    hold nt = tbl[i]
    i = i + 1 + nt
  }
  give 0 - 1
}

// 1 when cp has an unconditional SpecialCasing entry, 0 when not, -1 for a
// non-scalar.
make uc_is_special(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold at = uc_special_at(cp)
  when at < 0 {
    give 0
  }
  give 1
}

// Map one code point through the simple case table. `slot` is 0 lower, 1 upper
// or 2 title. A slot with no mapping (delta 0) and a code point outside every
// group both give cp back, so the caller never has to test.
make uc_simple(cp: num, slot: num) -> num {
  hold tbl = uc_case_groups()
  hold at = uc_find(tbl, cp, 5)
  when at < 0 {
    give cp
  }
  hold du = tbl[at * 5 + 2]
  hold dl = tbl[at * 5 + 3]
  hold dt = tbl[at * 5 + 4]
  when slot == 0 {
    when dl == 0 {
      give cp
    }
    give cp + dl
  }
  when slot == 2 {
    when dt != 0 {
      give cp + dt
    }
  }
  when du == 0 {
    give cp
  }
  give cp + du
}

// Append the full mapping of cp for `slot` to `out`, preferring the special
// table and falling back to the simple one. One code point in, one to three
// code points out.
make uc_map_one(cp: num, slot: num, out: list) -> list {
  hold at = uc_special_at(cp)
  when at < 0 {
    give push(out, uc_simple(cp, slot))
  }
  hold tbl = uc_special()
  hold i = at + 1
  when slot == 1 {
    hold nl1 = tbl[at + 1]
    i = at + 2 + nl1
  }
  when slot == 2 {
    hold nl2 = tbl[at + 1]
    hold nu2 = tbl[at + 2 + nl2]
    i = at + 2 + nl2 + 1 + nu2
  }
  hold cnt = tbl[i]
  hold acc = out
  hold k = 0
  while k < cnt {
    acc = push(acc, tbl[i + 1 + k])
    k = k + 1
  }
  give acc
}

// Is every element of `cps` a scalar value? The empty list is valid.
make uc_valid_list(cps: list) -> num {
  hold i = 0
  while i < len(cps) {
    when u8_cp_valid(cps[i]) == 0 {
      give 0
    }
    i = i + 1
  }
  give 1
}

// 1 when two scalar lists are identical, else 0.
make uc_lists_eq(a: list, b: list) -> num {
  when len(a) != len(b) {
    give 0
  }
  hold i = 0
  while i < len(a) {
    when a[i] != b[i] {
      give 0
    }
    i = i + 1
  }
  give 1
}

// 1 when cp is Cased (it has at least one case mapping), 0 when it is
// caseless, -1 for a non-scalar.
make uc_cased(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold at = uc_find(uc_case_groups(), cp, 5)
  when at < 0 {
    give 0
  }
  give 1
}

// 1 when cp is Case_Ignorable -- General_Category Mn, Me, Cf, Lm or Sk -- else
// 0, or -1 for a non-scalar. This is the UAX #44 set a caseless comparison
// needs, read from the UCD and kept separate from stdlib/ugraph.sa so that
// importing both modules cannot form a diamond.
make uc_case_ignorable(cp: num) -> num {
  when u8_cp_valid(cp) == 0 {
    give 0 - 1
  }
  hold tbl = uc_ignorable_ranges()
  hold n = len(tbl)
  hold lo = 0
  hold hi = u8_div(n, 2) - 1
  while lo <= hi {
    hold mid = u8_div(lo + hi, 2)
    hold a = tbl[mid * 2]
    hold b = tbl[mid * 2 + 1]
    when cp < a {
      hi = mid - 1
    } otherwise {
      when cp > b {
        lo = mid + 1
      } otherwise {
        give 1
      }
    }
  }
  give 0
}

// Full uppercase of a scalar list; [] when any element is not a scalar.
make uc_upper_list(cps: list) -> list {
  when uc_valid_list(cps) == 0 {
    give []
  }
  hold out = []
  hold i = 0
  while i < len(cps) {
    out = uc_map_one(cps[i], 1, out)
    i = i + 1
  }
  give out
}

// Full lowercase of a scalar list; [] when any element is not a scalar.
make uc_lower_list(cps: list) -> list {
  when uc_valid_list(cps) == 0 {
    give []
  }
  hold out = []
  hold i = 0
  while i < len(cps) {
    out = uc_map_one(cps[i], 0, out)
    i = i + 1
  }
  give out
}

// Full titlecase of a scalar list, one code point at a time. Titlecasing a
// whole sentence is a locale-sensitive job this module does not do; every code
// point is mapped as the UCD data says and nothing is context-dependent.
make uc_title_list(cps: list) -> list {
  when uc_valid_list(cps) == 0 {
    give []
  }
  hold out = []
  hold i = 0
  while i < len(cps) {
    out = uc_map_one(cps[i], 2, out)
    i = i + 1
  }
  give out
}

// Case fold of a scalar list: the simple fold where it is the whole story and
// the full (multi-code-point) fold where it is not, so "ß" folds to "ss".
make uc_fold_list(cps: list) -> list {
  when uc_valid_list(cps) == 0 {
    give []
  }
  hold multi = uc_fold_multi()
  hold mn = len(multi)
  hold groups = uc_fold_groups()
  hold out = []
  hold i = 0
  while i < len(cps) {
    hold cp = cps[i]
    hold at = 0 - 1
    hold k = 0
    while k < mn {
      when multi[k] == cp {
        at = k
      }
      when at >= 0 {
        k = mn
      } otherwise {
        hold cnt = multi[k + 1]
        k = k + 2 + cnt
      }
    }
    when at >= 0 {
      hold n = multi[at + 1]
      hold j = 0
      while j < n {
        out = push(out, multi[at + 2 + j])
        j = j + 1
      }
    } otherwise {
      hold g = uc_find(groups, cp, 3)
      when g < 0 {
        out = push(out, cp)
      } otherwise {
        out = push(out, cp + groups[g * 3 + 2])
      }
    }
    i = i + 1
  }
  give out
}

// Uppercase of a string, or "" for malformed or over-long input.
make uc_upper(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  give u8_from(uc_upper_list(u8_to_list(s)))
}

// Lowercase of a string, or "" for malformed or over-long input.
make uc_lower(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  give u8_from(uc_lower_list(u8_to_list(s)))
}

// Titlecase of a string, or "" for malformed or over-long input.
make uc_title(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  give u8_from(uc_title_list(u8_to_list(s)))
}

// Case-folded form of a string, or "" for malformed or over-long input.
make uc_fold(s: str) -> str {
  when u8_len(s) < 0 {
    give ""
  }
  give u8_from(uc_fold_list(u8_to_list(s)))
}

// 1 when the folded forms are identical, 0 when not, -1 when either input is
// malformed or over-long. The caseless comparison: "Straße" and "STRASSE"
// answer 1. Includes U+0000 in the malformed test on purpose: a list may carry
// it, but a Sayanox string cannot, so a string that holds one is not well
// formed input for this comparison.
make uc_fold_equal(a: str, b: str) -> num {
  when u8_len(a) < 0 {
    give 0 - 1
  }
  when u8_len(b) < 0 {
    give 0 - 1
  }
  give uc_lists_eq(uc_fold_list(u8_to_list(a)), uc_fold_list(u8_to_list(b)))
}
