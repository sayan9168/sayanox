// stdlib/csv.sa -- RFC 4180-style CSV row codec for byte strings (prefix csv_).
//
// Portable across seed-min, gen2 and native_aot (make test-stdlib-csv).
// The dialect refuses string-valued list elements, so a parsed row is a
// PACKED string instead: each field is stored as its decimal byte length, a
// colon, and the raw bytes. That is the same representation stdlib/cli.sa
// uses for argv. csv_parse_row returns the packed form; csv_ok, csv_count,
// csv_at, csv_push and csv_write_row are the operations on it.
//
// Quote characters are always chr(34), CR chr(13) and LF chr(10). The default
// delimiter is comma chr(44); the _d helpers take the delimiter byte so TSV,
// semicolon and pipe files use the same quoting rules (see csv_delim_ok).
// Strings are byte strings, exactly like the rest of the stdlib: a UTF-8 rune
// is several bytes and stays several bytes.
//
// Authoring rules honoured here (see docs/STDLIB.md): every helper is defined
// before its first caller, every accumulation goes through a hold, and no
// comment contains an unbalanced quote character.

// ---- packed-row primitives ------------------------------------------------

make csv_istr(n: num) -> str {
  when n == 0 {
    give "0"
  }
  hold v = n
  hold out = ""
  while v > 0 {
    hold d = v % 10
    hold out = concat(chr(48 + d), out)
    hold v = (v - d) / 10
  }
  give out
}

make csv_sub(s: str, a: num, b: num) -> str {
  hold out = ""
  hold i = a
  while i < b {
    hold out = concat(out, chr(sx_index(s, i)))
    hold i = i + 1
  }
  give out
}

make csv_empty() -> str {
  give ""
}

make csv_push(packed: str, field: str) -> str {
  give concat(packed, concat(csv_istr(len(field)), concat(":", field)))
}

// Returns a two-number list: the byte offset of the field and one past it.
make csv_read_rec(packed: str, pos: num) -> list {
  hold n = len(packed)
  hold i = pos
  hold ln = 0
  hold rd = 1
  while rd == 1 {
    when i >= n {
      hold rd = 0
    } otherwise {
      when sx_index(packed, i) == 58 {
        hold rd = 0
      } otherwise {
        hold ln = ln * 10 + (sx_index(packed, i) - 48)
        hold i = i + 1
      }
    }
  }
  hold res = []
  hold res = push(res, i + 1)
  hold res = push(res, i + 1 + ln)
  give res
}

// An error from csv_parse_row is the single byte chr(33), which no valid
// packed row can start with (a valid row starts with a decimal digit).
make csv_ok(packed: str) -> num {
  when len(packed) == 0 {
    give 1
  }
  when sx_index(packed, 0) == 33 {
    give 0
  }
  give 1
}

make csv_count(packed: str) -> num {
  when csv_ok(packed) == 0 {
    give 0
  }
  hold n = len(packed)
  hold pos = 0
  hold cnt = 0
  while pos < n {
    hold r = csv_read_rec(packed, pos)
    hold pos = r[1]
    hold cnt = cnt + 1
  }
  give cnt
}

make csv_at(packed: str, idx: num) -> str {
  when csv_ok(packed) == 0 {
    give ""
  }
  when idx >= csv_count(packed) {
    give ""
  }
  hold n = len(packed)
  hold pos = 0
  hold cur = 0
  while pos < n {
    hold r = csv_read_rec(packed, pos)
    when cur == idx {
      give csv_sub(packed, r[0], r[1])
    }
    hold pos = r[1]
    hold cur = cur + 1
  }
  give ""
}

// ---- dialects -------------------------------------------------------------
//
// The comma API below is the default dialect (delimiter byte 44). The _d
// helpers take the delimiter byte explicitly so the same RFC 4180 quoting
// rules serve TSV (9), semicolon (59), pipe (124) and other single-byte
// separators. A delimiter must be TAB or a printable ASCII byte other than
// the double quote, CR or LF: the quote character cannot separate fields,
// and CR/LF are the record terminators. Space is refused because a leading
// or trailing space is significant field data in this codec.

make csv_delim_ok(d: num) -> num {
  when d == 9 {
    give 1
  }
  when d < 33 {
    give 0
  }
  when d > 126 {
    give 0
  }
  when d == 34 {
    give 0
  }
  give 1
}

// ---- writing --------------------------------------------------------------

make csv_needs_quote_d(s: str, d: num) -> num {
  hold i = 0
  hold n = len(s)
  while i < n {
    hold c = sx_index(s, i)
    when c == d {
      give 1
    }
    when c == 34 {
      give 1
    }
    when c == 13 {
      give 1
    }
    when c == 10 {
      give 1
    }
    hold i = i + 1
  }
  give 0
}

make csv_needs_quote(s: str) -> num {
  give csv_needs_quote_d(s, 44)
}

make csv_quote(s: str) -> str {
  hold q = chr(34)
  hold out = q
  hold i = 0
  while i < len(s) {
    hold c = sx_index(s, i)
    when c == 34 {
      hold out = concat(out, concat(q, q))
    } otherwise {
      hold out = concat(out, chr(c))
    }
    hold i = i + 1
  }
  give concat(out, q)
}

make csv_write_row_d(packed: str, d: num) -> str {
  when csv_delim_ok(d) == 0 {
    give ""
  }
  when csv_ok(packed) == 0 {
    give ""
  }
  hold sep = chr(d)
  hold out = ""
  hold n = csv_count(packed)
  hold k = 0
  while k < n {
    when k > 0 {
      hold out = concat(out, sep)
    }
    hold f = csv_at(packed, k)
    when csv_needs_quote_d(f, d) == 1 {
      hold out = concat(out, csv_quote(f))
    } otherwise {
      hold out = concat(out, f)
    }
    hold k = k + 1
  }
  give out
}

make csv_write_row(packed: str) -> str {
  give csv_write_row_d(packed, 44)
}

// ---- reading --------------------------------------------------------------
//
// csv_parse_row accepts one record without a trailing newline. A quoted field
// may contain commas, CR, LF and doubled quote characters. A quote inside an
// unquoted field, an unclosed quoted field, or any byte other than a comma
// after a closing quote makes the row invalid, and the result is the error
// marker that csv_ok rejects. An empty line is one empty field; a trailing
// comma also produces one final empty field.

make csv_parse_row_d(line: str, delim: num) -> str {
  when csv_delim_ok(delim) == 0 {
    give "!"
  }
  hold n = len(line)
  hold i = 0
  hold out = ""
  hold bad = 0
  when n == 0 {
    hold out = csv_push(out, "")
  }
  while i < n {
    hold field = ""
    hold c = sx_index(line, i)
    when c == 34 {
      hold i = i + 1
      hold closed = 0
      hold run = 1
      while run == 1 {
        when i >= n {
          hold run = 0
        } otherwise {
          hold d = sx_index(line, i)
          when d == 34 {
            when i + 1 < n {
              hold e = sx_index(line, i + 1)
              when e == 34 {
                hold field = concat(field, chr(34))
                hold i = i + 2
              } otherwise {
                hold closed = 1
                hold run = 0
                hold i = i + 1
              }
            } otherwise {
              hold closed = 1
              hold run = 0
              hold i = i + 1
            }
          } otherwise {
            hold field = concat(field, chr(d))
            hold i = i + 1
          }
        }
      }
      when closed == 0 {
        hold bad = 1
      }
      when i < n {
        hold d = sx_index(line, i)
        when d != delim {
          hold bad = 1
        }
      }
      when bad == 1 {
        hold i = n
      }
    } otherwise {
      hold run = 1
      while run == 1 {
        when i >= n {
          hold run = 0
        } otherwise {
          hold d = sx_index(line, i)
          when d == delim {
            hold run = 0
          } otherwise {
            when d == 34 {
              hold bad = 1
            }
            hold field = concat(field, chr(d))
            hold i = i + 1
          }
        }
      }
    }
    hold out = csv_push(out, field)
    when i < n {
      hold d = sx_index(line, i)
      when d == delim {
        hold i = i + 1
        when i == n {
          hold out = csv_push(out, "")
        }
      }
    }
  }
  when bad == 1 {
    give "!"
  }
  give out
}

make csv_parse_row(line: str) -> str {
  give csv_parse_row_d(line, 44)
}

make csv_is_valid_row_d(line: str, delim: num) -> num {
  give csv_ok(csv_parse_row_d(line, delim))
}

make csv_is_valid_row(line: str) -> num {
  give csv_is_valid_row_d(line, 44)
}

// ---- dialect sniffing -----------------------------------------------------
//
// csv_sniff answers which single-byte delimiter a sample of text was written
// with, or -1 when no candidate is supported well enough to say. The candidate
// set is comma 44, TAB 9, semicolon 59 and pipe 124, which is exactly the set
// the _d helpers accept; csv_sniff_list takes a caller-supplied candidate list
// and uses the caller's order to break ties.
//
// The rule is mechanical, not statistical, so a wrong guess is reproducible:
//   1. A sample is split into lines at LF, a trailing CR is dropped and empty
//      lines are ignored. At most the first 4096 bytes and the first 64
//      non-empty lines of the sample are looked at, and a caller-supplied
//      bound larger than the sample is clamped to the sample.
//   2. A candidate matches when every line holds the same number of unquoted
//      separator bytes, at least one, and every line is a valid row under
//      csv_is_valid_row_d for that delimiter. A byte counts as unquoted when
//      it sits outside a quoted field: a field is quoted when it begins with
//      chr(34), and a doubled quote inside such a field is an escaped quote.
//   3. The winner is the matching candidate with the most unquoted separators
//      per line; a tie keeps the earlier candidate.
//
// One line holding one separator already matches, so a sample should carry more
// than one row. Nothing here looks at file names, header words or data types.

// Unquoted occurrences of d in one CSV line. Returns the separator count, which
// is one less than the field count for a well-formed row.
make csv_sep_count(line: str, d: num) -> num {
  hold n = len(line)
  hold i = 0
  hold cnt = 0
  hold quoted = 0
  hold fresh = 1
  while i < n {
    hold c = sx_index(line, i)
    hold extra = 0
    when quoted == 0 {
      when c == d {
        hold cnt = cnt + 1
        hold fresh = 1
      } otherwise {
        when fresh == 1 {
          when c == 34 {
            hold quoted = 1
          }
        }
        hold fresh = 0
      }
    } otherwise {
      when c == 34 {
        hold nxt = 0
        when i + 1 < n {
          hold nxt = sx_index(line, i + 1)
        }
        when nxt == 34 {
          hold extra = 1
        } otherwise {
          hold quoted = 0
        }
      }
    }
    hold i = i + 1
    when extra == 1 {
      hold i = i + 1
    }
  }
  give cnt
}

// One line of a sample, cut at [a, b) with a trailing CR dropped. The empty
// string when the range is empty, which is how a blank line stays blank.
make csv_line_cut(sample: str, a: num, b: num) -> str {
  hold n = len(sample)
  hold last = b
  when last > n {
    hold last = n
  }
  when last > a {
    when sx_index(sample, last - 1) == 13 {
      hold last = last - 1
    }
  }
  give csv_sub(sample, a, last)
}

// The first line of a sample: up to the first LF, without a trailing CR. The
// empty string when the sample starts with a line break or is empty.
make csv_first_line(sample: str) -> str {
  hold n = len(sample)
  hold end = 0
  hold run = 1
  while run == 1 {
    when end >= n {
      hold run = 0
    } otherwise {
      when sx_index(sample, end) == 10 {
        hold run = 0
      } otherwise {
        hold end = end + 1
      }
    }
  }
  give csv_line_cut(sample, 0, end)
}

// Number of non-empty lines that agree with the first line's separator count
// under d, or -1 when any line disagrees or fails to parse. Returns -1 when the
// agreeing count is zero or the separator count is zero, because a sample with
// no separator byte says nothing about a dialect.
make csv_sniff_lines(sample: str, bound: num, d: num) -> num {
  hold i = 0
  hold stop = bound
  hold n = len(sample)
  when stop > n {
    hold stop = n
  }
  hold seen = 0
  hold rows = 0
  hold want = 0 - 1
  hold bad = 0
  while i < stop {
    hold eol = i
    hold scan = 1
    while scan == 1 {
      when eol >= stop {
        hold scan = 0
      } otherwise {
        when sx_index(sample, eol) == 10 {
          hold scan = 0
        } otherwise {
          hold eol = eol + 1
        }
      }
    }
    hold line = csv_line_cut(sample, i, eol)
    hold i = eol + 1
    when len(line) > 0 {
      hold seen = seen + 1
      hold cnt = csv_sep_count(line, d)
      when want < 0 {
        hold want = cnt
      }
      when cnt != want {
        hold bad = 1
      }
      when csv_is_valid_row_d(line, d) == 0 {
        hold bad = 1
      }
      when bad == 1 {
        hold stop = i
      }
      when bad == 0 {
        hold rows = rows + 1
        when seen == 64 {
          hold stop = i
        }
      }
    }
  }
  when bad == 1 {
    give 0 - 1
  }
  when want < 1 {
    give 0 - 1
  }
  give rows
}

// The delimiter byte a sample was written with, or -1. The candidate list is
// tried in order and an illegal delimiter candidate is skipped rather than
// guessed around.
make csv_sniff_list(sample: str, cands: list) -> num {
  hold bound = len(sample)
  when bound > 4096 {
    hold bound = 4096
  }
  hold head = csv_first_line(sample)
  hold best = 0 - 1
  hold best_seps = 0
  hold k = 0
  while k < len(cands) {
    hold d = cands[k]
    when csv_delim_ok(d) == 1 {
      hold rows = csv_sniff_lines(sample, bound, d)
      when rows > 0 {
        hold seps = csv_sep_count(head, d)
        when seps > best_seps {
          hold best_seps = seps
          hold best = d
        }
      }
    }
    hold k = k + 1
  }
  give best
}

make csv_sniff(sample: str) -> num {
  hold cands = [44, 9, 59, 124]
  give csv_sniff_list(sample, cands)
}

// One-step convenience: sniff the sample, then parse a whole line with the
// delimiter that was found. The empty string when the dialect is unknown or
// the row does not parse, so a caller never has to pass -1 to csv_parse_row_d.
make csv_parse_row_sniff(line: str, sample: str) -> str {
  hold cands = [44, 9, 59, 124]
  hold d = csv_sniff_list(sample, cands)
  when d < 0 {
    give ""
  }
  give csv_parse_row_d(line, d)
}
