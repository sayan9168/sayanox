// stdlib/ini.sa -- INI and TOML-lite configuration text, read into a packed
// table and written back out (prefix ini_).
//
// Import stdlib/csv.sa and stdlib/csv_table.sa before this module. A parsed
// document is a csv_table.sa table whose three columns are section, key and
// value, in document order, behind a header row -- so every table operation the
// CSV layer already has (ct_row, ct_cell, ct_filter_eq, ct_select, ct_write)
// works on a configuration file, and ini_write is the inverse direction.
//
// A configuration file is small and it is read whole: input is capped at
// ini_max_bytes() (65536) bytes, and the csv_table.sa caps still apply (1024
// total rows = 1 header + 1023 member rows, 262144 bytes). Malformed input is
// refused, never repaired: ini_parse gives the single byte chr(33), which no
// valid table starts with, and the lookups answer the empty string or -1 for a
// table that is not a table.
//
// The rules, each one pinned by selfhost/stdlib_ini_test.sa:
//
//   1. A line ends at chr(10); a trailing chr(13) is dropped, so LF and CRLF
//      files parse identically.
//   2. An empty line is skipped, and so is a line whose first non-space byte is
//      chr(59) or chr(35). No other line is a comment, and there is no inline
//      comment: a semicolon inside a value is data.
//   3. A line whose first non-space byte is chr(91) is a section header, named
//      by the bytes up to the first chr(93) with spaces trimmed. Only spaces may
//      follow the closing bracket, and a header with no name in it is refused:
//      the default section is spelled by writing its members before any header,
//      never by an empty one. ini_set and ini_drop_section accept the empty
//      name for that section, and ini_write omits its header line.
//   4. Any other non-empty line is a member. The first chr(61) splits key from
//      value; the key loses its spaces, the value its leading and trailing
//      ones. An empty key is refused, and so is a line with no chr(61).
//   5. A value that begins and ends with chr(34) has those two bytes removed
//      and the escape pairs backslash backslash, backslash quote, backslash n,
//      backslash r and backslash t decoded. Any other backslash inside such a
//      value is refused, and so is a backslash that has no byte after it. A
//      value that only starts with a quote is ordinary data, exactly as an
//      unquoted value is, so a quote byte in the middle of a value costs
//      nothing and needs no doubling.
//   6. Members written before any section header belong to the section whose
//      name is the empty string, ini_default_section().
//   7. A repeated key inside one section and a repeated section header are both
//      refused, so ini_parse never has to choose between two spellings of one
//      setting and ini_write can never merge them by accident.
//   8. Sections are enumerated in order of first appearance, with the default
//      section first: ini_section_at(table, 0) is the empty string and
//      ini_section_count counts it even when no member names it, because
//      ini_write gives it the head of the file. That holds of a table carrying
//      the header row ini_new gives it -- the one thing that tells an ini table
//      from any other csv_table -- and a table that came from somewhere else, a
//      ct_filter_eq result say, is enumerated from its member rows alone.
//   9. ini_write quotes a value exactly when ini_needs_quote says the raw bytes
//      would not survive rules 1 to 7, which is why a value may begin with a
//      comment marker unquoted: a written member line begins with its key.

make ini_max_bytes() -> num {
  give 65536
}

make ini_default_section() -> str {
  give ""
}

make ini_is_default(s: str) -> num {
  give len(s) == 0
}

// Divide-and-conquer byte slice: O(span log span) instead of quadratic per-byte
// concat on long lines, values, or packed rows.
make ini_slice(s: str, a: num, b: num) -> str {
  hold n = len(s)
  hold lo = a
  hold hi = b
  when lo < 0 {
    hold lo = 0
  }
  when hi > n {
    hold hi = n
  }
  when lo >= hi {
    give ""
  }
  hold span = hi - lo
  when span <= 16 {
    hold out = ""
    hold i = lo
    while i < hi {
      hold out = concat(out, chr(sx_index(s, i)))
      hold i = i + 1
    }
    give out
  }
  hold half = (span - span % 2) / 2
  hold mid = lo + half
  give concat(ini_slice(s, lo, mid), ini_slice(s, mid, hi))
}

make ini_has_header(table: str) -> num {
  when ct_valid(table) == 0 {
    give 0
  }
  when ct_row_count(table) < 1 {
    give 0
  }
  give string_eq(csv_at(ct_row(table, 0), 0), "section")
}

make ini_pair(status: num, value: str) -> str {
  hold out = ""
  hold out = csv_push(out, csv_istr(status))
  hold out = csv_push(out, value)
  give out
}

make ini_pair_ok(p: str) -> num {
  when len(p) == 0 {
    give 0
  }
  when string_eq(csv_at(p, 0), "1") == 1 {
    give 1
  }
  give 0
}

make ini_pair_value(p: str) -> str {
  give csv_at(p, 1)
}

make ini_cut(s: str, a: num, b: num) -> str {
  hold n = len(s)
  hold from = a
  hold to = b
  when from < 0 {
    hold from = 0
  }
  when to > n {
    hold to = n
  }
  when to > from {
    when sx_index(s, to - 1) == 13 {
      hold to = to - 1
    }
  }
  give ini_slice(s, from, to)
}

make ini_at(s: str, i: num) -> num {
  when i < 0 {
    give 0 - 1
  }
  when i >= len(s) {
    give 0 - 1
  }
  give sx_index(s, i)
}

make ini_is_space(c: num) -> num {
  when c == 32 {
    give 1
  }
  when c == 9 {
    give 1
  }
  give 0
}

make ini_skip_ws(s: str, a: num, b: num) -> num {
  hold i = a
  hold go = 1
  while go == 1 {
    when i >= b {
      hold go = 0
    } otherwise {
      when ini_is_space(sx_index(s, i)) == 0 {
        hold go = 0
      } otherwise {
        hold i = i + 1
      }
    }
  }
  give i
}

make ini_trim_end(s: str, a: num, b: num) -> num {
  hold hi = b
  hold go = 1
  while go == 1 {
    when hi <= a {
      hold go = 0
    } otherwise {
      when ini_is_space(sx_index(s, hi - 1)) == 0 {
        hold go = 0
      } otherwise {
        hold hi = hi - 1
      }
    }
  }
  when hi > a {
    when sx_index(s, hi - 1) == 13 {
      hold hi = hi - 1
    }
  }
  give hi
}

make ini_trim(s: str) -> str {
  hold n = len(s)
  hold a = ini_skip_ws(s, 0, n)
  hold b = ini_trim_end(s, a, n)
  give ini_slice(s, a, b)
}

make ini_ltrim(s: str) -> str {
  hold n = len(s)
  hold a = ini_skip_ws(s, 0, n)
  give ini_slice(s, a, n)
}

make ini_eol(s: str, pos: num) -> num {
  hold n = len(s)
  hold i = pos
  hold go = 1
  while go == 1 {
    when i >= n {
      hold go = 0
    } otherwise {
      when sx_index(s, i) == 10 {
        hold go = 0
      } otherwise {
        hold i = i + 1
      }
    }
  }
  give i
}

make ini_first_byte(s: str, want: num) -> num {
  hold n = len(s)
  hold i = 0
  while i < n {
    when sx_index(s, i) == want {
      give i
    }
    hold i = i + 1
  }
  give 0 - 1
}

make ini_find_in_span(s: str, a: num, b: num, want: num) -> num {
  hold i = a
  while i < b {
    when sx_index(s, i) == want {
      give i
    }
    hold i = i + 1
  }
  give 0 - 1
}

make ini_decode_span(s: str, a: num, b: num) -> str {
  hold span = b - a
  hold quoted = 0
  when span >= 2 {
    when sx_index(s, a) == 34 {
      when sx_index(s, b - 1) == 34 {
        hold quoted = 1
      }
    }
  }
  when quoted == 0 {
    give ini_pair(1, ini_slice(s, a, b))
  }
  hold m = b - 1
  hold acc = ""
  hold chunk = ""
  hold i = a + 1
  hold bad = 0
  hold go = 1
  while go == 1 {
    when i >= m {
      hold go = 0
    } otherwise {
      hold c = sx_index(s, i)
      when c == 34 {
        hold bad = 1
      } otherwise {
        when c != 92 {
          hold chunk = concat(chunk, chr(c))
          hold i = i + 1
        } otherwise {
          hold moved = 0
          when i + 1 < m {
            hold e = sx_index(s, i + 1)
            when e == 92 {
              hold chunk = concat(chunk, chr(92))
              hold moved = 1
            }
            when moved == 0 {
              when e == 34 {
                hold chunk = concat(chunk, chr(34))
                hold moved = 1
              }
            }
            when moved == 0 {
              when e == 110 {
                hold chunk = concat(chunk, chr(10))
                hold moved = 1
              }
            }
            when moved == 0 {
              when e == 114 {
                hold chunk = concat(chunk, chr(13))
                hold moved = 1
              }
            }
            when moved == 0 {
              when e == 116 {
                hold chunk = concat(chunk, chr(9))
                hold moved = 1
              }
            }
          }
          when moved == 0 {
            hold bad = 1
          } otherwise {
            hold i = i + 2
          }
        }
      }
      when len(chunk) >= 64 {
        hold acc = concat(acc, chunk)
        hold chunk = ""
      }
      when bad == 1 {
        hold go = 0
      }
    }
  }
  when bad == 1 {
    give ini_pair(0, "")
  }
  give ini_pair(1, concat(acc, chunk))
}

make ini_decode(raw: str) -> str {
  give ini_decode_span(raw, 0, len(raw))
}

make ini_span_ok(s: str, a: num, b: num) -> num {
  hold i = a
  while i < b {
    hold c = sx_index(s, i)
    when c == 61 {
      give 0
    }
    when c == 10 {
      give 0
    }
    when c == 13 {
      give 0
    }
    when c == 91 {
      give 0
    }
    when c == 93 {
      give 0
    }
    hold i = i + 1
  }
  give 1
}

make ini_key_ok(s: str) -> num {
  when len(s) == 0 {
    give 0
  }
  give ini_span_ok(s, 0, len(s))
}

make ini_section_ok(s: str) -> num {
  give ini_span_ok(s, 0, len(s))
}

make ini_header(line: str) -> str {
  hold n = len(line)
  hold close = ini_find_in_span(line, 1, n, 93)
  when close < 1 {
    give ini_pair(0, "")
  }
  hold ra = ini_skip_ws(line, close + 1, n)
  hold rb = ini_trim_end(line, ra, n)
  when rb > ra {
    give ini_pair(0, "")
  }
  hold na = ini_skip_ws(line, 1, close)
  hold nb = ini_trim_end(line, na, close)
  when nb <= na {
    give ini_pair(0, "")
  }
  when ini_span_ok(line, na, nb) == 0 {
    give ini_pair(0, "")
  }
  give ini_pair(1, ini_slice(line, na, nb))
}

make ini_needs_quote(s: str) -> num {
  hold n = len(s)
  when n == 0 {
    give 1
  }
  when ini_is_space(sx_index(s, 0)) == 1 {
    give 1
  }
  when ini_is_space(sx_index(s, n - 1)) == 1 {
    give 1
  }
  hold i = 0
  while i < n {
    hold c = sx_index(s, i)
    when c == 34 {
      give 1
    }
    when c == 92 {
      give 1
    }
    when c == 10 {
      give 1
    }
    when c == 13 {
      give 1
    }
    hold i = i + 1
  }
  give 0
}

make ini_quote(s: str) -> str {
  when ini_needs_quote(s) == 0 {
    give s
  }
  hold q = chr(34)
  hold b = chr(92)
  hold out = q
  hold chunk = ""
  hold n = len(s)
  hold i = 0
  while i < n {
    hold c = sx_index(s, i)
    when c == 92 {
      hold chunk = concat(chunk, concat(b, b))
    } otherwise {
      when c == 34 {
        hold chunk = concat(chunk, concat(b, q))
      } otherwise {
        when c == 10 {
          hold chunk = concat(chunk, concat(b, chr(110)))
        } otherwise {
          when c == 13 {
            hold chunk = concat(chunk, concat(b, chr(114)))
          } otherwise {
            when c == 9 {
              hold chunk = concat(chunk, concat(b, chr(116)))
            } otherwise {
              hold chunk = concat(chunk, chr(c))
            }
          }
        }
      }
    }
    when len(chunk) >= 64 {
      hold out = concat(out, chunk)
      hold chunk = ""
    }
    hold i = i + 1
  }
  give concat(concat(out, chunk), q)
}

make ini_insert_at(table: str, at: num, row: str) -> str {
  when ct_valid(table) == 0 {
    give "!"
  }
  when ct_row_valid(row) == 0 {
    give "!"
  }
  hold total = ct_row_count(table)
  when total < 1 {
    give "!"
  }
  when ct_index_valid(at) == 0 {
    give "!"
  }
  when at > total - 1 {
    give "!"
  }
  hold out = ""
  hold chunk = ""
  hold k = 0
  while k <= total {
    hold src = k
    when k > at {
      hold src = k - 1
    }
    hold piece = ct_row(table, src)
    when k == at + 1 {
      hold piece = row
    }
    hold chunk = csv_push(chunk, piece)
    when len(chunk) >= 2048 {
      hold out = concat(out, chunk)
      hold chunk = ""
    }
    when len(out) + len(chunk) > 262144 {
      give "!"
    }
    hold k = k + 1
  }
  hold out = concat(out, chunk)
  when csv_count(out) > 1024 {
    give "!"
  }
  give out
}

make ini_header_row() -> str {
  hold row = ""
  hold row = csv_push(row, "section")
  hold row = csv_push(row, "key")
  hold row = csv_push(row, "value")
  give row
}

make ini_new() -> str {
  give ct_append("", ini_header_row())
}

make ini_count(table: str) -> num {
  hold rows = ct_row_count(table)
  when rows < 1 {
    give 0 - 1
  }
  give rows - 1
}

make ini_find_section(table: str, section: str) -> num {
  hold rows = ini_count(table)
  when ini_is_default(section) == 1 {
    when ini_has_header(table) == 1 {
      give 0
    }
  }
  when rows <= 0 {
    give 0 - 1
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    hold slen = c0[1] - c0[0]
    when slen == len(section) {
      when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
        give i
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give 0 - 1
}

make ini_find(table: str, section: str, key: str) -> num {
  hold rows = ini_count(table)
  when rows <= 0 {
    give 0 - 1
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] - c0[0] == len(section) {
      hold c1 = ct_frame(table, c0[1])
      when c1[1] - c1[0] == len(key) {
        when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
          when string_eq(ini_slice(table, c1[0], c1[1]), key) == 1 {
            give i
          }
        }
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give 0 - 1
}

make ini_has(table: str, section: str, key: str) -> num {
  when ct_valid(table) == 0 {
    give 0 - 1
  }
  hold at = ini_find(table, section, key)
  when at < 0 {
    give 0
  }
  give 1
}

make ini_value(table: str, section: str, key: str) -> str {
  when ct_valid(table) == 0 {
    give ""
  }
  hold rows = ini_count(table)
  when rows <= 0 {
    give ""
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] - c0[0] == len(section) {
      hold c1 = ct_frame(table, c0[1])
      when c1[1] - c1[0] == len(key) {
        when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
          when string_eq(ini_slice(table, c1[0], c1[1]), key) == 1 {
            hold c2 = ct_frame(table, c1[1])
            give ini_slice(table, c2[0], c2[1])
          }
        }
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give ""
}

// ---- O(N log N) pure-min span hashing and merge-sort duplicate detector ----
// Each record in recs is 5 numbers: [hash, sa, sb, ka, kb].
// Hash stays under 2^26 (67108864) so h * 131 + c < 2^34 is exact in both C
// IEEE-754 double and 64-bit native integer arithmetic.

make ini_hash_span(s: str, a: num, b: num, seed: num) -> num {
  hold h = seed
  hold i = a
  while i < b {
    hold h = (h * 131 + sx_index(s, i) + 1) % 67108864
    hold i = i + 1
  }
  give h
}

make ini_rec_cmp(s: str, recs: list, bi: num, bj: num) -> num {
  hold hi = recs[bi]
  hold hj = recs[bj]
  when hi < hj {
    give 0 - 1
  }
  when hi > hj {
    give 1
  }
  hold sa1 = recs[bi + 1]
  hold sb1 = recs[bi + 2]
  hold sa2 = recs[bj + 1]
  hold sb2 = recs[bj + 2]
  hold sl1 = sb1 - sa1
  hold sl2 = sb2 - sa2
  when sl1 < sl2 {
    give 0 - 1
  }
  when sl1 > sl2 {
    give 1
  }
  hold k = 0
  while k < sl1 {
    hold c1 = sx_index(s, sa1 + k)
    hold c2 = sx_index(s, sa2 + k)
    when c1 < c2 {
      give 0 - 1
    }
    when c1 > c2 {
      give 1
    }
    hold k = k + 1
  }
  hold ka1 = recs[bi + 3]
  hold kb1 = recs[bi + 4]
  hold ka2 = recs[bj + 3]
  hold kb2 = recs[bj + 4]
  hold kl1 = kb1 - ka1
  hold kl2 = kb2 - ka2
  when kl1 < kl2 {
    give 0 - 1
  }
  when kl1 > kl2 {
    give 1
  }
  hold m = 0
  while m < kl1 {
    hold d1 = sx_index(s, ka1 + m)
    hold d2 = sx_index(s, ka2 + m)
    when d1 < d2 {
      give 0 - 1
    }
    when d1 > d2 {
      give 1
    }
    hold m = m + 1
  }
  give 0
}

make ini_push_rec5(dst: list, src: list, base: num) -> list {
  hold out = push(dst, src[base])
  hold out = push(out, src[base + 1])
  hold out = push(out, src[base + 2])
  hold out = push(out, src[base + 3])
  hold out = push(out, src[base + 4])
  give out
}

// Returns 1 if any two 5-tuples in recs have identical (section, key) bytes in s.
make ini_has_dup_5(s: str, recs: list) -> num {
  hold count = len(recs) / 5
  when count <= 1 {
    give 0
  }
  hold cur = recs
  hold width = 1
  while width < count {
    hold nxt = []
    hold left = 0
    while left < count {
      hold mid = left + width
      when mid > count {
        hold mid = count
      }
      hold right = mid + width
      when right > count {
        hold right = count
      }
      hold i = left
      hold j = mid
      while i < mid {
        when j >= right {
          hold nxt = ini_push_rec5(nxt, cur, i * 5)
          hold i = i + 1
        } otherwise {
          hold cmp = ini_rec_cmp(s, cur, i * 5, j * 5)
          when cmp == 0 {
            give 1
          }
          when cmp < 0 {
            hold nxt = ini_push_rec5(nxt, cur, i * 5)
            hold i = i + 1
          } otherwise {
            hold nxt = ini_push_rec5(nxt, cur, j * 5)
            hold j = j + 1
          }
        }
      }
      while j < right {
        hold nxt = ini_push_rec5(nxt, cur, j * 5)
        hold j = j + 1
      }
      hold left = right
    }
    hold cur = nxt
    hold width = width * 2
  }
  give 0
}

// Parse configuration text into a packed table in O(N log N) time.
// The error marker is chr(33).
make ini_parse(text: str) -> str {
  when len(text) > ini_max_bytes() {
    give "!"
  }
  hold out = ini_new()
  hold mid_buf = ""
  hold chunk_buf = ""
  hold total_bytes = len(out)
  hold member_count = 0
  hold sec_str = ""
  hold sec_a = 0
  hold sec_b = 0
  hold sec_hash = 5381
  hold secs = []
  hold keys = []
  hold n = len(text)
  hold pos = 0
  hold bad = 0
  hold go = 1
  while go == 1 {
    hold lstart = pos
    hold stop = ini_eol(text, lstart)
    hold lend = stop
    when lend > lstart {
      when sx_index(text, lend - 1) == 13 {
        hold lend = lend - 1
      }
    }
    hold pos = stop + 1
    hold a = ini_skip_ws(text, lstart, lend)
    hold skip = 0
    when a >= lend {
      hold skip = 1
    } otherwise {
      hold c0 = sx_index(text, a)
      when c0 == 59 {
        hold skip = 1
      }
      when c0 == 35 {
        hold skip = 1
      }
    }
    when skip == 0 {
      hold c = sx_index(text, a)
      when c == 91 {
        hold close = ini_find_in_span(text, a + 1, lend, 93)
        when close < a + 1 {
          hold bad = 1
        } otherwise {
          hold ra = ini_skip_ws(text, close + 1, lend)
          hold rb = ini_trim_end(text, ra, lend)
          when rb > ra {
            hold bad = 1
          } otherwise {
            hold na = ini_skip_ws(text, a + 1, close)
            hold nb = ini_trim_end(text, na, close)
            when nb <= na {
              hold bad = 1
            } otherwise {
              when ini_span_ok(text, na, nb) == 0 {
                hold bad = 1
              } otherwise {
                hold sh = ini_hash_span(text, na, nb, 5381)
                hold secs = push(secs, sh)
                hold secs = push(secs, na)
                hold secs = push(secs, nb)
                hold secs = push(secs, 0)
                hold secs = push(secs, 0)
                hold sec_a = na
                hold sec_b = nb
                hold sec_hash = sh
                hold sec_str = ini_slice(text, na, nb)
              }
            }
          }
        }
      } otherwise {
        hold eq = ini_find_in_span(text, a, lend, 61)
        when eq < 0 {
          hold bad = 1
        } otherwise {
          hold ka = ini_skip_ws(text, a, eq)
          hold kb = ini_trim_end(text, ka, eq)
          when kb <= ka {
            hold bad = 1
          } otherwise {
            when ini_span_ok(text, ka, kb) == 0 {
              hold bad = 1
            } otherwise {
              hold va = ini_skip_ws(text, eq + 1, lend)
              hold vb = ini_trim_end(text, va, lend)
              hold got = ini_decode_span(text, va, vb)
              when ini_pair_ok(got) == 0 {
                hold bad = 1
              } otherwise {
                hold member_count = member_count + 1
                when member_count > 1023 {
                  hold bad = 1
                } otherwise {
                  hold kh = ini_hash_span(text, ka, kb, (sec_hash * 131 + 257) % 67108864)
                  hold keys = push(keys, kh)
                  hold keys = push(keys, sec_a)
                  hold keys = push(keys, sec_b)
                  hold keys = push(keys, ka)
                  hold keys = push(keys, kb)
                  hold key_str = ini_slice(text, ka, kb)
                  hold val_str = ini_pair_value(got)
                  hold row = ""
                  hold row = csv_push(row, sec_str)
                  hold row = csv_push(row, key_str)
                  hold row = csv_push(row, val_str)
                  hold framed = csv_push("", row)
                  hold total_bytes = total_bytes + len(framed)
                  when total_bytes > 262144 {
                    hold bad = 1
                  } otherwise {
                    hold chunk_buf = concat(chunk_buf, framed)
                    when len(chunk_buf) >= 1024 {
                      hold mid_buf = concat(mid_buf, chunk_buf)
                      hold chunk_buf = ""
                      when len(mid_buf) >= 16384 {
                        hold out = concat(out, mid_buf)
                        hold mid_buf = ""
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    when pos > n {
      hold go = 0
    }
    when bad == 1 {
      hold go = 0
    }
  }
  when bad == 1 {
    give "!"
  }
  when ini_has_dup_5(text, secs) == 1 {
    give "!"
  }
  when ini_has_dup_5(text, keys) == 1 {
    give "!"
  }
  give concat(out, concat(mid_buf, chunk_buf))
}

make ini_valid(text: str) -> num {
  hold t = ini_parse(text)
  when len(t) == 0 {
    give 0
  }
  when sx_index(t, 0) == 33 {
    give 0
  }
  give 1
}

make ini_get_text(text: str, section: str, key: str) -> str {
  give ini_value(ini_parse(text), section, key)
}

make ini_section_count(table: str) -> num {
  hold rows = ini_count(table)
  when rows < 0 {
    give 0
  }
  hold count = ini_has_header(table)
  when rows == 0 {
    give count
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold seen = []
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] > c0[0] {
      hold sh = ini_hash_span(table, c0[0], c0[1], 5381)
      hold seen = push(seen, sh)
      hold seen = push(seen, c0[0])
      hold seen = push(seen, c0[1])
      hold seen = push(seen, 0)
      hold seen = push(seen, 0)
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  hold m = len(seen) / 5
  when m == 0 {
    give count
  }
  // Sort 5-tuples so identical section spans sit adjacent, then count runs.
  hold cur = seen
  hold width = 1
  while width < m {
    hold nxt = []
    hold left = 0
    while left < m {
      hold mid = left + width
      when mid > m {
        hold mid = m
      }
      hold right = mid + width
      when right > m {
        hold right = m
      }
      hold x = left
      hold y = mid
      while x < mid {
        when y >= right {
          hold nxt = ini_push_rec5(nxt, cur, x * 5)
          hold x = x + 1
        } otherwise {
          when ini_rec_cmp(table, cur, x * 5, y * 5) <= 0 {
            hold nxt = ini_push_rec5(nxt, cur, x * 5)
            hold x = x + 1
          } otherwise {
            hold nxt = ini_push_rec5(nxt, cur, y * 5)
            hold y = y + 1
          }
        }
      }
      while y < right {
        hold nxt = ini_push_rec5(nxt, cur, y * 5)
        hold y = y + 1
      }
      hold left = right
    }
    hold cur = nxt
    hold width = width * 2
  }
  hold distinct = 1
  hold k = 1
  while k < m {
    when ini_rec_cmp(table, cur, (k - 1) * 5, k * 5) != 0 {
      hold distinct = distinct + 1
    }
    hold k = k + 1
  }
  give count + distinct
}

make ini_section_at(table: str, i: num) -> str {
  hold rows = ini_count(table)
  when i == 0 {
    when ini_has_header(table) == 1 {
      give ""
    }
  }
  when rows <= 0 {
    give ""
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold k = 0
  hold seen = ini_has_header(table)
  while k < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] > c0[0] {
      hold sec = ini_slice(table, c0[0], c0[1])
      when ini_find_section(table, sec) == k {
        when seen == i {
          give sec
        }
        hold seen = seen + 1
      }
    }
    hold pos = rf[1]
    hold k = k + 1
  }
  give ""
}

make ini_key_count(table: str, section: str) -> num {
  hold rows = ini_count(table)
  when rows <= 0 {
    give 0
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  hold count = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] - c0[0] == len(section) {
      when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
        hold count = count + 1
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give count
}

make ini_key_at(table: str, section: str, i: num) -> str {
  hold rows = ini_count(table)
  when rows <= 0 {
    give ""
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold k = 0
  hold seen = 0
  while k < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    when c0[1] - c0[0] == len(section) {
      when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
        hold c1 = ct_frame(table, c0[1])
        when seen == i {
          give ini_slice(table, c1[0], c1[1])
        }
        hold seen = seen + 1
      }
    }
    hold pos = rf[1]
    hold k = k + 1
  }
  give ""
}

make ini_set(table: str, section: str, key: str, value: str) -> str {
  when ct_valid(table) == 0 {
    give "!"
  }
  when ini_section_ok(section) == 0 {
    give "!"
  }
  when ini_key_ok(key) == 0 {
    give "!"
  }
  hold at = ini_find(table, section, key)
  when at >= 0 {
    give ct_set(table, at + 1, 2, value)
  }
  hold row = ""
  hold row = csv_push(row, section)
  hold row = csv_push(row, key)
  hold row = csv_push(row, value)
  when ini_is_default(section) == 1 {
    give ini_insert_at(table, 0, row)
  }
  give ct_append(table, row)
}

make ini_unset(table: str, section: str, key: str) -> str {
  when ct_valid(table) == 0 {
    give "!"
  }
  hold out = ini_new()
  hold chunk = ""
  hold rows = ini_count(table)
  when rows <= 0 {
    give out
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    hold c1 = ct_frame(table, c0[1])
    hold keep = 1
    when c0[1] - c0[0] == len(section) {
      when c1[1] - c1[0] == len(key) {
        when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
          when string_eq(ini_slice(table, c1[0], c1[1]), key) == 1 {
            hold keep = 0
          }
        }
      }
    }
    when keep == 1 {
      hold chunk = concat(chunk, ini_slice(table, pos, rf[1]))
      when len(chunk) >= 2048 {
        hold out = concat(out, chunk)
        hold chunk = ""
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give concat(out, chunk)
}

make ini_drop_section(table: str, section: str) -> str {
  when ct_valid(table) == 0 {
    give "!"
  }
  hold out = ini_new()
  hold chunk = ""
  hold rows = ini_count(table)
  when rows <= 0 {
    give out
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold i = 0
  while i < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    hold match = 0
    when c0[1] - c0[0] == len(section) {
      when string_eq(ini_slice(table, c0[0], c0[1]), section) == 1 {
        hold match = 1
      }
    }
    when match == 0 {
      hold chunk = concat(chunk, ini_slice(table, pos, rf[1]))
      when len(chunk) >= 2048 {
        hold out = concat(out, chunk)
        hold chunk = ""
      }
    }
    hold pos = rf[1]
    hold i = i + 1
  }
  give concat(out, chunk)
}

make ini_empty(table: str) -> num {
  when ini_count(table) == 0 {
    give 1
  }
  give 0
}

// Sort 2-tuples [min_row, row_idx] lexicographically for O(R log R) section-order
// serialization in ini_write.
make ini_sort_pairs(pairs: list) -> list {
  hold count = len(pairs) / 2
  when count <= 1 {
    give pairs
  }
  hold cur = pairs
  hold width = 1
  while width < count {
    hold nxt = []
    hold left = 0
    while left < count {
      hold mid = left + width
      when mid > count {
        hold mid = count
      }
      hold right = mid + width
      when right > count {
        hold right = count
      }
      hold i = left
      hold j = mid
      while i < mid {
        when j >= right {
          hold nxt = push(nxt, cur[i * 2])
          hold nxt = push(nxt, cur[i * 2 + 1])
          hold i = i + 1
        } otherwise {
          hold a0 = cur[i * 2]
          hold b0 = cur[j * 2]
          hold take_left = 0
          when a0 < b0 {
            hold take_left = 1
          }
          when a0 == b0 {
            when cur[i * 2 + 1] <= cur[j * 2 + 1] {
              hold take_left = 1
            }
          }
          when take_left == 1 {
            hold nxt = push(nxt, cur[i * 2])
            hold nxt = push(nxt, cur[i * 2 + 1])
            hold i = i + 1
          } otherwise {
            hold nxt = push(nxt, cur[j * 2])
            hold nxt = push(nxt, cur[j * 2 + 1])
            hold j = j + 1
          }
        }
      }
      while j < right {
        hold nxt = push(nxt, cur[j * 2])
        hold nxt = push(nxt, cur[j * 2 + 1])
        hold j = j + 1
      }
      hold left = right
    }
    hold cur = nxt
    hold width = width * 2
  }
  give cur
}

make ini_sec5_cmp(s: str, recs: list, bi: num, bj: num) -> num {
  hold hi = recs[bi]
  hold hj = recs[bj]
  when hi < hj {
    give 0 - 1
  }
  when hi > hj {
    give 1
  }
  hold sa1 = recs[bi + 1]
  hold sb1 = recs[bi + 2]
  hold sa2 = recs[bj + 1]
  hold sb2 = recs[bj + 2]
  hold sl1 = sb1 - sa1
  hold sl2 = sb2 - sa2
  when sl1 < sl2 {
    give 0 - 1
  }
  when sl1 > sl2 {
    give 1
  }
  hold k = 0
  while k < sl1 {
    hold c1 = sx_index(s, sa1 + k)
    hold c2 = sx_index(s, sa2 + k)
    when c1 < c2 {
      give 0 - 1
    }
    when c1 > c2 {
      give 1
    }
    hold k = k + 1
  }
  give 0
}

// Canonical configuration text in O(R log R) time.
make ini_write(table: str) -> str {
  when ct_valid(table) == 0 {
    give "!"
  }
  hold rows = ini_count(table)
  when rows <= 0 {
    give ""
  }
  hold hdr = ct_frame(table, 0)
  hold pos = hdr[1]
  hold cells = []
  hold def_rows = []
  hold sec_recs = []
  hold r = 0
  while r < rows {
    hold rf = ct_frame(table, pos)
    hold c0 = ct_frame(table, rf[0])
    hold c1 = ct_frame(table, c0[1])
    hold c2 = ct_frame(table, c1[1])
    hold cells = push(cells, c0[0])
    hold cells = push(cells, c0[1])
    hold cells = push(cells, c1[0])
    hold cells = push(cells, c1[1])
    hold cells = push(cells, c2[0])
    hold cells = push(cells, c2[1])
    when c0[1] == c0[0] {
      hold def_rows = push(def_rows, r)
    } otherwise {
      hold sh = ini_hash_span(table, c0[0], c0[1], 5381)
      hold sec_recs = push(sec_recs, sh)
      hold sec_recs = push(sec_recs, c0[0])
      hold sec_recs = push(sec_recs, c0[1])
      hold sec_recs = push(sec_recs, 0)
      hold sec_recs = push(sec_recs, r)
    }
    hold pos = rf[1]
    hold r = r + 1
  }
  hold out = ""
  hold mid_buf = ""
  hold chunk = ""
  hold d = 0
  while d < len(def_rows) {
    hold dr = def_rows[d]
    hold cb = dr * 6
    hold key = ini_slice(table, cells[cb + 2], cells[cb + 3])
    hold val = ini_slice(table, cells[cb + 4], cells[cb + 5])
    hold line = concat(key, concat(" = ", concat(ini_quote(val), chr(10))))
    hold chunk = concat(chunk, line)
    when len(chunk) >= 1024 {
      hold mid_buf = concat(mid_buf, chunk)
      hold chunk = ""
      when len(mid_buf) >= 16384 {
        hold out = concat(out, mid_buf)
        hold mid_buf = ""
      }
    }
    hold d = d + 1
  }
  hold m = len(sec_recs) / 5
  when m == 0 {
    give concat(out, concat(mid_buf, chunk))
  }
  // Stable merge sort sec_recs by (hash, section_bytes), preserving row order r
  // stored at slot +4 because <= picks left first.
  hold cur = sec_recs
  hold width = 1
  while width < m {
    hold nxt = []
    hold left = 0
    while left < m {
      hold mid = left + width
      when mid > m {
        hold mid = m
      }
      hold right = mid + width
      when right > m {
        hold right = m
      }
      hold x = left
      hold y = mid
      while x < mid {
        when y >= right {
          hold nxt = ini_push_rec5(nxt, cur, x * 5)
          hold x = x + 1
        } otherwise {
          when ini_sec5_cmp(table, cur, x * 5, y * 5) <= 0 {
            hold nxt = ini_push_rec5(nxt, cur, x * 5)
            hold x = x + 1
          } otherwise {
            hold nxt = ini_push_rec5(nxt, cur, y * 5)
            hold y = y + 1
          }
        }
      }
      while y < right {
        hold nxt = ini_push_rec5(nxt, cur, y * 5)
        hold y = y + 1
      }
      hold left = right
    }
    hold cur = nxt
    hold width = width * 2
  }
  hold pairs = []
  hold min_r = cur[4]
  hold pairs = push(pairs, min_r)
  hold pairs = push(pairs, cur[4])
  hold idx = 1
  while idx < m {
    when ini_sec5_cmp(table, cur, (idx - 1) * 5, idx * 5) != 0 {
      hold min_r = cur[idx * 5 + 4]
    }
    hold pairs = push(pairs, min_r)
    hold pairs = push(pairs, cur[idx * 5 + 4])
    hold idx = idx + 1
  }
  hold sorted_pairs = ini_sort_pairs(pairs)
  hold prev_grp = 0 - 1
  hold p = 0
  while p < m {
    hold grp = sorted_pairs[p * 2]
    hold row_idx = sorted_pairs[p * 2 + 1]
    hold cb2 = row_idx * 6
    when grp != prev_grp {
      hold sec_name = ini_slice(table, cells[cb2], cells[cb2 + 1])
      hold chunk = concat(chunk, concat(chr(91), concat(sec_name, concat(chr(93), chr(10)))))
      hold prev_grp = grp
    }
    hold kstr = ini_slice(table, cells[cb2 + 2], cells[cb2 + 3])
    hold vstr = ini_slice(table, cells[cb2 + 4], cells[cb2 + 5])
    hold chunk = concat(chunk, concat(kstr, concat(" = ", concat(ini_quote(vstr), chr(10)))))
    when len(chunk) >= 1024 {
      hold mid_buf = concat(mid_buf, chunk)
      hold chunk = ""
      when len(mid_buf) >= 16384 {
        hold out = concat(out, mid_buf)
        hold mid_buf = ""
      }
    }
    hold p = p + 1
  }
  give concat(out, concat(mid_buf, chunk))
}

make ini_round_trips(text: str) -> num {
  hold t = ini_parse(text)
  when string_eq(t, "!") == 1 {
    give 0
  }
  hold back = ini_parse(ini_write(t))
  when string_eq(back, t) == 1 {
    give 1
  }
  give 0
}
