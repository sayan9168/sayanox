#   od -An -tu2 -v -j 16 expr.elf  -> 2                  (ET_EXEC)
#   od -An -tu2 -v -j 18 expr.elf  -> 3                  (EM_386)
#   od -An -tu2 -v -j 44 expr.elf  -> 2                  (two program headers)
#   od -An -tu4 -v -j 24 expr.elf  -> 134512842          (0x080480ca)
